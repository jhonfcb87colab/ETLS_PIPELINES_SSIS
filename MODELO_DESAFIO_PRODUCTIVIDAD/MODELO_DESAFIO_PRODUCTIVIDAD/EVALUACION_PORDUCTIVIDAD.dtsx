                          UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">DECLARE @TABLE_FECHAS TABLE (NUMERO_DIA INT)

DECLARE @NUMERODIAS INT = CONVERT(INT,?);
DECLARE @COUNTER INT = 1
WHILE @COUNTER&lt;=@NUMERODIAS
BEGIN
	INSERT INTO @TABLE_FECHAS
	SELECT 
	(YEAR(DATEADD(DAY,-@COUNTER,GETDATE()))*100+MONTH(DATEADD(DAY,-@COUNTER,GETDATE())))*100+DAY(DATEADD(DAY,-@COUNTER,GETDATE())) NUMERO_DIA
	SET @COUNTER = @COUNTER + 1;
END;

SELECT [DIA_PRODUCTIVIDAD]
      ,[#ROW_ID_SE]
      ,[ID_AUXILIAR1_VEHICULO]
      ,[NOMBRE_EMPLEADO_AUXILIAR1]
      ,[ID_AUXILIAR2_VEHICULO]
      ,[NOMBRE_EMPLEADO_AUXILIAR2]
      ,[ID_COURIER_CONDUCTOR]
      ,[NOMBRE_EMPLEADO_COURIER_CONDUCTOR]
      ,[NUMERO_GUIA]
      ,[FECHA_HORA_MOVIMIENTO_SZU]
      ,[ID_PROCESO]
      ,[NUMERO_MOVIMI]
      ,[CONSECUT_MOVIMI]
      ,[ID_CIUDAD_ORG]
      ,[NOMBRE_CIUDAD]
      ,[ID_REGIONAL]
      ,[NOMBRE_REGIONAL]
      ,[ID_ZONA_URBA]
      ,[ID_CIUDAD_ZONA_URBA]
      ,[ID_TIPO_ZONA_URBA]
      ,[NOMBRE_ZONA_URBA]
      ,[ID_TIPO_LOGISTICA]
      ,[NUMERO_PIEZAS]
      ,[FECHA_ENTREGA_VERIFICADA]
      ,[CONSECUT_MOVIMI_EV]
      ,[NUMERO_MOVIMI_EV]
      ,[ID_PROCESO_EV]
      ,[TIPO_PRUEBA_ENTREGA]
      ,[TIPO_PRUEBA_ENTREGA_GENERADA]
      ,[CUMPLE_PRODUCTIVIDAD]
      ,[FECHA_GENERACION_REP]
	,FECHA_HORA_MOVIMIENTO_DEVOL	
	,NUMERO_MOVIMI_DEVOL	
	,CONSECUT_MOVIMI_DEVOL	
	,ID_PROCESO_DEVOL	
	,ID_CONCEPTO_DEVOL	
	,NOMBRE_CONCEPTO_DEVOL	
	,ASIGNADAS_DIVISION_INTERNA	
	,GUIA_SERVIENTREGA	
	,ASIGNADAS_ALIADO
,FECHA_HORA_MOVIMIENTO_RE
,NUMERO_MOVIMI_RE
,CONSECUT_MOVIMI_RE
,ID_PROCESO_RE
,ID_CONCEPTO_RE
,NOMBRE_CONCEPTO_RE
,NUM_PZA_RE
,NUM_PZA_DEVOLU
  FROM TMP_BORRAR_LOCAL.DBO.CONSOLIDADO_PRODUCTIVIDAD_BI_EZU /*_DEV*/ (NOLOCK)
WHERE [DIA_PRODUCTIVIDAD] IN(SELECT NUMERO_DIA FROM @TABLE_FECHAS GROUP BY NUMERO_DIA)</property>
