              <DTS:Variables />
              <DTS:ObjectData>
                <SQLTask:SqlTaskData
                  SQLTask:Connection="{6111693E-23AE-4FFC-AA52-9BB2BF97640C}"
                  SQLTask:SqlStatementSource="&#xA;DECLARE @NUMERO_DIAS INT = CONVERT(INT,?);&#xA;DECLARE @TABLE_FECHAS TABLE (NUMERO_DIA INT)&#xA;DECLARE @COUNTER INT = 1&#xA;WHILE @COUNTER&lt;=@NUMERO_DIAS&#xA;BEGIN&#xA; INSERT INTO @TABLE_FECHAS&#xA; SELECT &#xA; (YEAR(DATEADD(DAY,-@COUNTER,GETDATE()))*100+MONTH(DATEADD(DAY,-@COUNTER,GETDATE())))*100+DAY(DATEADD(DAY,-@COUNTER,GETDATE())) NUMERO_DIA&#xA; SET @COUNTER = @COUNTER + 1;&#xA;END&#xA;--SELECT * FROM @TABLE_FECHAS&#xA;DELETE [FAC].[MECI_CONSOLIDADO_PRODUCTIVIDAD_BI_EZU]&#xA;WHERE [DIA_PRODUCTIVIDAD] IN(SELECT NUMERO_DIA FROM @TABLE_FECHAS GROUP BY NUMERO_DIA)&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
                  <SQLTask:ParameterBinding
                    SQLTask:ParameterName="0"
                    SQLTask:DtsVariableName="User::DIAS_ATR"
                    SQLTask:ParameterDirection="Input"
                    SQLTask:DataType="129"
                    SQLTask:ParameterSize="4" />
                </SQLTask:SqlTaskData>
              </DTS:ObjectData>
            </DTS:Executable>
