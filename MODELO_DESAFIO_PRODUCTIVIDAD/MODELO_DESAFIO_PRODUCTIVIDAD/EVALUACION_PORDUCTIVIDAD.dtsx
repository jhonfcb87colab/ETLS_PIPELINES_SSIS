	,ID_PROCESO_EV	
	,TIPO_PRUEBA_ENTREGA	
	,TIPO_PRUEBA_ENTREGA_GENERADA	
	,CUMPLE_PRODUCTIVIDAD	
	,FECHA_GENERACION_REP	
	,FECHA_HORA_MOVIMIENTO_DEVOL	
	,NUMERO_MOVIMI_DEVOL	
	,CONSECUT_MOVIMI_DEVOL	
	,ID_PROCESO_DEVOL	
	,ID_CONCEPTO_DEVOL	
	,NOMBRE_CONCEPTO_DEVOL	
