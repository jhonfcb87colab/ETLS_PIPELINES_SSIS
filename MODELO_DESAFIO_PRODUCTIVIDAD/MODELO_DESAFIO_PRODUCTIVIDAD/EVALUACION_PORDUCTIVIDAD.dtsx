  <DTS:Property
    DTS:Name="PackageFormatVersion">8</DTS:Property>
  <DTS:Variables>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{265831D7-906B-41DE-AD76-789DA7941BC0}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="(DT_WSTR, 2) @[$Project::DIAS_ATR]"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="DIAS_ATR">
      <DTS:VariableValue
        DTS:DataType="8">15</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{485D23B3-776A-4116-BCCA-9DD2D34904F2}"
      DTS:IncludeInDebugDump="6789"
      DTS:Namespace="User"
      DTS:ObjectName="FECHA_EJECUCION_01">
      <DTS:VariableValue
        DTS:DataType="3">0</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{FB09D354-7765-4963-892B-1E4BB4DFAEFB}"
      DTS:IncludeInDebugDump="6789"
      DTS:Namespace="User"
      DTS:ObjectName="FECHA_EJECUCION_02">
      <DTS:VariableValue
        DTS:DataType="3">0</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{3DB21463-B6FF-4072-95A2-DCE93409BBE3}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot;&#xA;USE Mece_Logistico;&#xA;&#xA;DECLARE @FEC_INI&#x9;DATETIME&#x9;= CONVERT(DATETIME,'&quot;+ (DT_WSTR, 10) @[User::FECHA_EJECUCION_01] +&quot;');  &#xA;------DECLARE @FEC_INI&#x9;DATETIME&#x9;= CONVERT(DATETIME,'2025-05-10');  &#xA;DECLARE @FEC_FIN&#x9;DATETIME&#x9;= DATEADD(DAY,1,@FEC_INI);&#xA;&#xA;DROP TABLE IF EXISTS #TABLA_TEMPORAL_FE_MIN_FR_MAX;&#xA;SELECT @FEC_INI AS FEC_INI,@FEC_FIN AS FEC_FIN INTO #TABLA_TEMPORAL_FE_MIN_FR_MAX;&#xA;&#xA;&#xA;DROP TABLE IF EXISTS #TABLA_TEMPORAL_PRODUCTIVIDAD_PASO_01&#xA;DROP TABLE IF EXISTS #GUIAS_EVALUAR_PRODUCTIVIDAD_PASO2;&#xA;DROP TABLE IF EXISTS #GUIAS_EVALUAR_PRODUCTIVIDAD_PASO_03;&#xA;DROP TABLE IF EXISTS #GUIAS_EVALUAR_PRODUCTIVIDAD_EMPLEADO_PASO_04;&#xA;DROP TABLE IF EXISTS #GUIAS_EVALUAR_PRODUCTIVIDAD_CIUDAD_PASO_05;&#xA;DROP TABLE IF EXISTS #GUIAS_EVALUAR_PRODUCTIVIDAD_NOMBREZONA_PASO_06;&#xA;DROP TABLE IF EXISTS #CONSOLIDADO_PRODUCTIVIDAD_FINAL_POR_DIA_BI;&#xA;DROP TABLE IF EXISTS #GUIAS_EVALUAR_PRODUCTIVIDAD_PASO_03_DEVOLU;&#xA;DROP TABLE IF EXISTS #GUIAS_EVALUAR_PRODUCTIVIDAD_PASO_03_REPO_ENTREGADO;&#xA;DROP TABLE IF EXISTS #TEMP_PROCESO_ITEM_CONCEPTO;&#xA;DROP TABLE IF EXISTS #BASE_FINAL_DESAFIO_PRODUCTIVIDAD;&#xA;&#xA;SELECT &#xA;ID_EMPLEADO&#xA;,CONCAT(NOMBRE_EMPLEADO,' ',APELLIDO_EMPLEADO) AS NOMBRE_EMPLEADO&#xA;INTO #GUIAS_EVALUAR_PRODUCTIVIDAD_EMPLEADO_PASO_04&#xA;FROM PARAMETROS..EMPLEADOS (NOLOCK)&#xA;&#xA;SELECT CD.ID_CIUDAD,CD.NOMBRE_CIUDAD,CD.ID_REGIONAL,RG.NOMBRE_REGIONAL &#xA;INTO #GUIAS_EVALUAR_PRODUCTIVIDAD_CIUDAD_PASO_05&#xA;FROM PARAMETROS..CIUDADES CD (NOLOCK)&#xA;INNER JOIN PARAMETROS..REGIONALES_PAIS RG (NOLOCK) &#xA;ON CD.ID_REGIONAL=RG.ID_REGIONAL&#xA;&#xA;SELECT &#xA;ID_PAIS&#x9;&#xA;,ID_CIUDAD&#x9;&#xA;,ID_TIPO_ZONA_URBA&#x9;&#xA;,ID_ZONA_URBA&#x9;&#xA;,NOMBRE_ZONA_URBA&#x9;&#xA;,CATEGORIA_ZONA_URBA&#xA;INTO #GUIAS_EVALUAR_PRODUCTIVIDAD_NOMBREZONA_PASO_06&#xA;FROM PARAMETROS.DBO.ZONASURBANAS (NOLOCK) WHERE ID_PAIS=1&#xA;&#xA;SELECT &#xA;ID_PROCESO&#x9;&#xA;,ID_CONCEPTO&#x9;&#xA;,NOMBRE_CONCEPTO&#xA;INTO #TEMP_PROCESO_ITEM_CONCEPTO&#xA;FROM PARAMETROS..ITEM_CONCEPTO (NOLOCK)&#xA;&#xA;/*************************************************************************************************/&#xA;/*&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;GUIAS CON SALIDA A ZONA URBANA&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;*/&#xA;/*************************************************************************************************/&#xA;;WITH CTE AS (&#xA;SELECT &#xA;ROW_NUMBER ( )   OVER ( PARTITION BY SEG.[NUMERO_GUIA] order by SEG.FECHA_HORA_MOVIMIENTO desc )  #ROW_ID_SE&#xA;,DOC.ID_AUXILIAR1_VEHICULO&#xA;,DOC.ID_AUXILIAR2_VEHICULO&#xA;,DOC.ID_COURIER_CONDUCTOR&#xA;,SEG.NUMERO_GUIA &#xA;,SEG.FECHA_HORA_MOVIMIENTO&#xA;,SEG.ID_PROCESO&#xA;,SEG.NUMERO_MOVIMI&#xA;,SEG.CONSECUT_MOVIMI&#xA;,DOC.ID_CIUDAD_DIVISION_ORIGEN&#xA;,DOC.ID_CIUDAD_ZONA_URBA&#xA;,DOC.ID_ZONA_URBA&#xA;,DOC.ID_TIPO_ZONA_URBA&#xA;,DOC.ID_TIPO_LOGISTICA&#xA;,SEG.NUMERO_PIEZAS&#xA;FROM Mece_Logistico.DBO.SEGUIMIENTO_ENVIO SEG (NOLOCK)&#xA;INNER JOIN  MECE_LOGISTICO.DBO.DOCUMENTOS DOC WITH (NOLOCK) &#xA;ON SEG.ID_PROCESO=DOC.ID_PROCESO &#xA;AND SEG.NUMERO_MOVIMI=DOC.NUMERO_MOVIMI &#xA;AND SEG.CONSECUT_MOVIMI=DOC.CONSECUT_MOVIMI&#xA;WHERE &#xA;SEG.ID_PROCESO=9 &#xA;AND SEG.ID_CONCEPTO NOT IN (2,4,7,8,9,10)----(7,8,9,10)----SE DESCARTA TODAS LAS SALIDA A EMPRESARIO SATELITE&#xA;--AND FECHA_HORA_MOVIMIENTO BETWEEN /*@FEC_INI AND @FEC_FIN   ---*/'2024-12-02' AND '2024-12-03'&#xA;AND (FECHA_HORA_MOVIMIENTO &gt;= (SELECT FEC_INI FROM #TABLA_TEMPORAL_FE_MIN_FR_MAX GROUP BY FEC_INI) &#xA;AND FECHA_HORA_MOVIMIENTO &lt; (SELECT FEC_FIN FROM #TABLA_TEMPORAL_FE_MIN_FR_MAX GROUP BY FEC_FIN) )&#xA;--AND DOC.ID_CIUDAD_DIVISION_ORIGEN = 10&#xA;AND LEFT(SEG.[NUMERO_GUIA],1) NOT IN (5) ---SE TOMARA GUIAS DIFERENTES A 5 GUIAS INTERNAS&#xA;)&#xA;SELECT &#xA;* &#xA;INTO #TABLA_TEMPORAL_PRODUCTIVIDAD_PASO_01&#xA;FROM CTE WHERE #ROW_ID_SE=1&#xA;&#xA;--SELECT * FROM #TABLA_TEMPORAL_PRODUCTIVIDAD_PASO_01&#xA;&#xA;SELECT NUMERO_GUIA &#xA;INTO #GUIAS_EVALUAR_PRODUCTIVIDAD_PASO2&#xA;FROM #TABLA_TEMPORAL_PRODUCTIVIDAD_PASO_01&#xA;GROUP BY NUMERO_GUIA&#xA;&#xA;--SELECT * FROM #GUIAS_EVALUAR_PRODUCTIVIDAD_PASO2&#xA;&#xA;&#xA;/*************************************************************************************************/&#xA;/*&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;GUIAS CON ENTREGA VERIFICADA&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;*/&#xA;/*************************************************************************************************/&#xA;;WITH CTE AS (&#xA;SELECT &#xA;ROW_NUMBER ( )   OVER ( PARTITION BY TMP.[NUMERO_GUIA] order by SEG.FECHA_HORA_MOVIMIENTO desc )  #ROW_ID_SE&#xA;,SEG.NUMERO_GUIA&#xA;,SEG.FECHA_HORA_MOVIMIENTO &#xA;,SEG.NUMERO_MOVIMI&#xA;,SEG.CONSECUT_MOVIMI&#xA;,SEG.ID_PROCESO&#xA;FROM MECE_LOGISTICO.DBO.SEGUIMIENTO_ENVIO SEG (NOLOCK)&#xA;INNER JOIN #TABLA_TEMPORAL_PRODUCTIVIDAD_PASO_01 TMP &#xA;ON (TMP.NUMERO_GUIA=SEG.NUMERO_GUIA AND SEG.NUMERO_MOVIMI=TMP.NUMERO_MOVIMI) &#xA;--INNER JOIN #GUIAS_EVALUAR_PRODUCTIVIDAD_PASO2 TMP ON TMP.NUMERO_GUIA=SEG.NUMERO_GUIA&#xA;WHERE SEG.ID_PROCESO=11 &#xA;AND (SEG.FECHA_HORA_MOVIMIENTO &gt;= @FEC_INI /*AND SEG.FECHA_HORA_MOVIMIENTO &lt; DATEADD(HOUR,7,@FEC_FIN)*/)   --DATEADD('HOUR',4,@FEC_FIN)&#xA;)&#xA;SELECT CT.* &#xA;INTO #GUIAS_EVALUAR_PRODUCTIVIDAD_PASO_03 &#xA;FROM CTE CT &#xA;WHERE CT.#ROW_ID_SE=1&#xA;&#xA;--SELECT * FROM #GUIAS_EVALUAR_PRODUCTIVIDAD_PASO_03&#xA;&#xA;/*************************************************************************************************/&#xA;/*&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;GUIAS CON DEVOLUCION O REVERSION&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;*/&#xA;/*************************************************************************************************/&#xA;;WITH CTE AS (&#xA;SELECT &#xA;ROW_NUMBER ( )   OVER ( PARTITION BY SEG.[NUMERO_GUIA] order by SEG.FECHA_HORA_MOVIMIENTO desc )  #ROW_ID_SE&#xA;,SEG.NUMERO_GUIA&#xA;,SEG.FECHA_HORA_MOVIMIENTO &#xA;,SEG.NUMERO_MOVIMI&#xA;,SEG.CONSECUT_MOVIMI&#xA;,SEG.ID_PROCESO&#xA;,SEG.ID_CONCEPTO&#xA;,IT_PR_CP.NOMBRE_CONCEPTO&#xA;,SEG.NUMERO_PIEZAS AS NUM_PZA_DEVOLU&#xA;FROM MECE_LOGISTICO.DBO.SEGUIMIENTO_ENVIO SEG (NOLOCK)&#xA;INNER JOIN #TABLA_TEMPORAL_PRODUCTIVIDAD_PASO_01 TMP &#xA;ON (TMP.NUMERO_GUIA=SEG.NUMERO_GUIA AND SEG.NUMERO_MOVIMI=TMP.NUMERO_MOVIMI) &#xA;LEFT JOIN #TEMP_PROCESO_ITEM_CONCEPTO IT_PR_CP &#xA;ON (IT_PR_CP.ID_PROCESO=SEG.ID_PROCESO AND IT_PR_CP.ID_CONCEPTO=SEG.ID_CONCEPTO)&#xA;WHERE SEG.ID_PROCESO IN(10,15) -----------TODOS LOS ENVIOS CON DEVOLUCION(10) Y REVERSION PROCESO OPERATIVO(15) CON NUMERO DE MANIFIESTOS COINCIDA CON LA SALIDA A ZONA URBANA &#xA;)&#xA;SELECT CT.* &#xA;INTO #GUIAS_EVALUAR_PRODUCTIVIDAD_PASO_03_DEVOLU &#xA;FROM CTE CT &#xA;WHERE CT.#ROW_ID_SE=1&#xA;&#xA;&#xA;/*************************************************************************************************/&#xA;/*&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;GUIAS CON REPORTADO ENTREGADO&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;*/&#xA;/*************************************************************************************************/&#xA;;WITH CTE AS (&#xA;SELECT &#xA;ROW_NUMBER ( )   OVER ( PARTITION BY SEG.[NUMERO_GUIA] order by SEG.FECHA_HORA_MOVIMIENTO desc )  #ROW_ID_SE&#xA;,SEG.NUMERO_GUIA&#xA;,SEG.FECHA_HORA_MOVIMIENTO &#xA;,SEG.NUMERO_MOVIMI&#xA;,SEG.CONSECUT_MOVIMI&#xA;,SEG.ID_PROCESO&#xA;,SEG.ID_CONCEPTO&#xA;,IT_PR_CP.NOMBRE_CONCEPTO&#xA;,SEG.NUMERO_PIEZAS AS NUM_PZA_RE&#xA;FROM MECE_LOGISTICO.DBO.SEGUIMIENTO_ENVIO SEG (NOLOCK)&#xA;INNER JOIN #TABLA_TEMPORAL_PRODUCTIVIDAD_PASO_01 TMP &#xA;ON (TMP.NUMERO_GUIA=SEG.NUMERO_GUIA AND SEG.NUMERO_MOVIMI=TMP.NUMERO_MOVIMI) &#xA;LEFT JOIN #TEMP_PROCESO_ITEM_CONCEPTO IT_PR_CP &#xA;ON (IT_PR_CP.ID_PROCESO=SEG.ID_PROCESO AND IT_PR_CP.ID_CONCEPTO=SEG.ID_CONCEPTO)&#xA;WHERE SEG.ID_PROCESO IN(24) -----------TODOS LOS ENVIOS CON DEVOLUCION(10) Y REVERSION PROCESO OPERATIVO(15) CON NUMERO DE MANIFIESTOS COINCIDA CON LA SALIDA A ZONA URBANA &#xA;)&#xA;SELECT CT.* &#xA;INTO #GUIAS_EVALUAR_PRODUCTIVIDAD_PASO_03_REPO_ENTREGADO &#xA;FROM CTE CT &#xA;WHERE CT.#ROW_ID_SE=1&#xA;&#xA;&#xA;&#xA;--SELECT * FROM #GUIAS_EVALUAR_PRODUCTIVIDAD_PASO2&#xA;--SELECT * FROM #GUIAS_EVALUAR_PRODUCTIVIDAD_PASO_03_DEVOLU&#xA;&#xA;&#xA;&#xA;&#xA;/*************************************************************************************************/&#xA;/*&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;ARMAR BASE DE LA CONSULTA&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;*/&#xA;/*************************************************************************************************/&#xA;SELECT &#xA;(YEAR(TBL_00.FECHA_HORA_MOVIMIENTO)*100+MONTH(TBL_00.FECHA_HORA_MOVIMIENTO))*100+DAY(TBL_00.FECHA_HORA_MOVIMIENTO) DIA_PRODUCTIVIDAD&#xA;,TBL_00.#ROW_ID_SE&#x9;&#xA;,TBL_00.ID_AUXILIAR1_VEHICULO&#x9;&#xA;,ISNULL(EMPL01.NOMBRE_EMPLEADO,'NO DISPONIBLE') AS NOMBRE_EMPLEADO_AUXILIAR1&#xA;,TBL_00.ID_AUXILIAR2_VEHICULO&#xA;,ISNULL(EMPL02.NOMBRE_EMPLEADO,'NO DISPONIBLE') AS NOMBRE_EMPLEADO_AUXILIAR2&#xA;,TBL_00.ID_COURIER_CONDUCTOR&#xA;,ISNULL(EMPL03.NOMBRE_EMPLEADO,'NO DISPONIBLE') AS NOMBRE_EMPLEADO_COURIER_CONDUCTOR&#xA;,TBL_00.NUMERO_GUIA&#x9;&#xA;,TBL_00.FECHA_HORA_MOVIMIENTO&#x9;AS FECHA_HORA_MOVIMIENTO_SZU&#xA;,TBL_00.ID_PROCESO&#x9;&#xA;,TBL_00.NUMERO_MOVIMI&#x9;&#xA;,TBL_00.CONSECUT_MOVIMI&#x9;&#xA;,TBL_00.ID_CIUDAD_DIVISION_ORIGEN&#x9;AS ID_CIUDAD_ORG&#xA;,CIUD.NOMBRE_CIUDAD&#xA;,CIUD.ID_REGIONAL&#xA;,CIUD.NOMBRE_REGIONAL&#xA;,TBL_00.ID_ZONA_URBA&#xA;,TBL_00.ID_CIUDAD_ZONA_URBA&#xA;,TBL_00.ID_TIPO_ZONA_URBA&#xA;,ZURB.NOMBRE_ZONA_URBA&#xA;,TBL_00.ID_TIPO_LOGISTICA&#x9;&#xA;,TBL_00.NUMERO_PIEZAS&#xA;------------------------------------------&#xA;,TBL_01.FECHA_HORA_MOVIMIENTO as FECHA_ENTREGA_VERIFICADA&#xA;,TBL_01.CONSECUT_MOVIMI AS CONSECUT_MOVIMI_EV&#xA;,TBL_01.NUMERO_MOVIMI AS NUMERO_MOVIMI_EV&#xA;,TBL_01.ID_PROCESO AS ID_PROCESO_EV&#xA;,PRB.TIPO_PRUEBA_ENTREGA&#xA;,CASE WHEN PRB.TIPO_PRUEBA_ENTREGA=2 THEN 'VIRTUAL'&#xA;&#x9;WHEN PRB.TIPO_PRUEBA_ENTREGA=1 THEN 'FISICA'&#xA;&#x9;ELSE 'NO DISPONIBLE' END AS TIPO_PRUEBA_ENTREGA_GENERADA&#xA;&#x9;,CASE WHEN TBL_00.NUMERO_MOVIMI=TBL_01.NUMERO_MOVIMI AND TBL_01.FECHA_HORA_MOVIMIENTO &lt; DATEADD(HOUR,7,(SELECT FEC_FIN FROM #TABLA_TEMPORAL_FE_MIN_FR_MAX GROUP BY FEC_FIN)) &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;THEN 'SI' ELSE 'NO' END AS CUMPLE_PRODUCTIVIDAD&#xA;&#x9;,GETDATE() FECHA_GENERACION_REP&#xA;-------------------------------------------------------------INFORMACION DEVOLUCION &#xA;&#x9;,DEVOLU.FECHA_HORA_MOVIMIENTO AS FECHA_HORA_MOVIMIENTO_DEVOL&#x9;&#xA;&#x9;,DEVOLU.NUMERO_MOVIMI AS NUMERO_MOVIMI_DEVOL  &#x9;&#xA;&#x9;,DEVOLU.CONSECUT_MOVIMI AS CONSECUT_MOVIMI_DEVOL&#x9;&#xA;&#x9;,DEVOLU.ID_PROCESO AS ID_PROCESO_DEVOL&#x9;&#xA;&#x9;,DEVOLU.ID_CONCEPTO&#x9;AS ID_CONCEPTO_DEVOL&#xA;&#x9;,CASE WHEN DEVOLU.ID_PROCESO = 15 THEN CONCAT('REVERSION: ',DEVOLU.NOMBRE_CONCEPTO) ELSE DEVOLU.NOMBRE_CONCEPTO END AS NOMBRE_CONCEPTO_DEVOL&#xA;&#x9;,DEVOLU.NUM_PZA_DEVOLU&#xA;&#xA;&#x9;,RE.FECHA_HORA_MOVIMIENTO AS FECHA_HORA_MOVIMIENTO_RE&#x9;&#xA;&#x9;,RE.NUMERO_MOVIMI AS NUMERO_MOVIMI_RE  &#x9;&#xA;&#x9;,RE.CONSECUT_MOVIMI AS CONSECUT_MOVIMI_RE&#x9;&#xA;&#x9;,RE.ID_PROCESO AS ID_PROCESO_RE&#x9;&#xA;&#x9;,RE.ID_CONCEPTO&#x9;AS ID_CONCEPTO_RE&#xA;&#x9;,RE.NOMBRE_CONCEPTO AS NOMBRE_CONCEPTO_RE&#xA;&#x9;,RE.NUM_PZA_RE&#xA;&#xA;&#x9;INTO #CONSOLIDADO_PRODUCTIVIDAD_FINAL_POR_DIA_BI&#xA;&#xA;FROM #TABLA_TEMPORAL_PRODUCTIVIDAD_PASO_01 TBL_00&#xA;LEFT JOIN #GUIAS_EVALUAR_PRODUCTIVIDAD_PASO_03 TBL_01&#xA;ON (TBL_00.NUMERO_GUIA=TBL_01.NUMERO_GUIA AND TBL_00.NUMERO_MOVIMI=TBL_01.NUMERO_MOVIMI)&#xA;LEFT JOIN #GUIAS_EVALUAR_PRODUCTIVIDAD_PASO_03_DEVOLU DEVOLU &#xA;ON  (DEVOLU.NUMERO_GUIA=TBL_00.NUMERO_GUIA AND TBL_00.NUMERO_MOVIMI=DEVOLU.NUMERO_MOVIMI)&#xA;LEFT JOIN #GUIAS_EVALUAR_PRODUCTIVIDAD_PASO_03_REPO_ENTREGADO RE&#xA;ON  (RE.NUMERO_GUIA=TBL_00.NUMERO_GUIA AND TBL_00.NUMERO_MOVIMI=RE.NUMERO_MOVIMI)&#xA;LEFT JOIN [tmp_borrar_local].[dbo].[PRUEBAS_ENTREGA_BI] PRB ON PRB.NUMERO_GUIA=TBL_00.NUMERO_GUIA&#xA;LEFT JOIN #GUIAS_EVALUAR_PRODUCTIVIDAD_EMPLEADO_PASO_04 EMPL01 ON EMPL01.ID_EMPLEADO=TBL_00.ID_AUXILIAR1_VEHICULO&#xA;LEFT JOIN #GUIAS_EVALUAR_PRODUCTIVIDAD_EMPLEADO_PASO_04 EMPL02 ON EMPL02.ID_EMPLEADO=TBL_00.ID_AUXILIAR2_VEHICULO&#xA;LEFT JOIN #GUIAS_EVALUAR_PRODUCTIVIDAD_EMPLEADO_PASO_04 EMPL03 ON EMPL03.ID_EMPLEADO=TBL_00.ID_COURIER_CONDUCTOR&#xA;INNER JOIN #GUIAS_EVALUAR_PRODUCTIVIDAD_CIUDAD_PASO_05 CIUD ON CIUD.ID_CIUDAD=TBL_00.ID_CIUDAD_DIVISION_ORIGEN&#xA;LEFT JOIN #GUIAS_EVALUAR_PRODUCTIVIDAD_NOMBREZONA_PASO_06 ZURB &#xA;&#x9;&#x9;&#x9;ON (ZURB.ID_CIUDAD=TBL_00.ID_CIUDAD_ZONA_URBA &#xA;&#x9;&#x9;&#x9;AND ZURB.ID_ZONA_URBA=TBL_00.ID_ZONA_URBA &#xA;&#x9;&#x9;&#x9;AND ZURB.ID_TIPO_ZONA_URBA=TBL_00.ID_TIPO_ZONA_URBA)&#xA;&#xA;/*&#xA;LEFT JOIN #GUIAS_EVALUAR_PRODUCTIVIDAD_PASO_03 TBL_01&#xA;ON (TBL_00.NUMERO_GUIA=TBL_01.NUMERO_GUIA AND TBL_00.NUMERO_MOVIMI=TBL_01.NUMERO_MOVIMI)&#xA;LEFT JOIN [tmp_borrar_local].[dbo].[PRUEBAS_ENTREGA_BI] PRB ON PRB.NUMERO_GUIA=TBL_00.NUMERO_GUIA&#xA;LEFT JOIN #GUIAS_EVALUAR_PRODUCTIVIDAD_EMPLEADO_PASO_04 EMPL01 ON EMPL01.ID_EMPLEADO=TBL_00.ID_AUXILIAR1_VEHICULO&#xA;LEFT JOIN #GUIAS_EVALUAR_PRODUCTIVIDAD_EMPLEADO_PASO_04 EMPL02 ON EMPL02.ID_EMPLEADO=TBL_00.ID_AUXILIAR2_VEHICULO&#xA;LEFT JOIN #GUIAS_EVALUAR_PRODUCTIVIDAD_EMPLEADO_PASO_04 EMPL03 ON EMPL03.ID_EMPLEADO=TBL_00.ID_COURIER_CONDUCTOR&#xA;INNER JOIN #GUIAS_EVALUAR_PRODUCTIVIDAD_CIUDAD_PASO_05 CIUD ON CIUD.ID_CIUDAD=TBL_00.ID_CIUDAD_DIVISION_ORIGEN&#xA;LEFT JOIN #GUIAS_EVALUAR_PRODUCTIVIDAD_NOMBREZONA_PASO_06 ZURB &#xA;&#x9;&#x9;&#x9;ON (ZURB.ID_CIUDAD=TBL_00.ID_CIUDAD_ZONA_URBA &#xA;&#x9;&#x9;&#x9;AND ZURB.ID_ZONA_URBA=TBL_00.ID_ZONA_URBA &#xA;&#x9;&#x9;&#x9;AND ZURB.ID_TIPO_ZONA_URBA=TBL_00.ID_TIPO_ZONA_URBA)&#xA;----WHERE TBL_00.NUMERO_MOVIMI=TBL_01.NUMERO_MOVIMI AND TBL_00.ID_AUXILIAR1_VEHICULO='80825271'&#xA;*/&#xA;&#xA;----SELECT NUMERO_GUIA,COUNT(1) TT&#xA;----FROM #CONSOLIDADO_PRODUCTIVIDAD_FINAL_POR_DIA_BI&#xA;----GROUP BY NUMERO_GUIA&#xA;----having COUNT(1)&gt;1&#xA;&#xA;&#xA;&#xA;SELECT &#xA;&#x9;TEMP.DIA_PRODUCTIVIDAD&#x9;&#xA;&#x9;,TEMP.#ROW_ID_SE&#x9;&#xA;&#x9;,TEMP.ID_AUXILIAR1_VEHICULO&#x9;&#xA;&#x9;,TEMP.NOMBRE_EMPLEADO_AUXILIAR1&#x9;&#xA;&#x9;,TEMP.ID_AUXILIAR2_VEHICULO&#x9;&#xA;&#x9;,TEMP.NOMBRE_EMPLEADO_AUXILIAR2&#x9;&#xA;&#x9;,TEMP.ID_COURIER_CONDUCTOR&#x9;&#xA;&#x9;,TEMP.NOMBRE_EMPLEADO_COURIER_CONDUCTOR&#x9;&#xA;&#x9;,TEMP.NUMERO_GUIA&#x9;&#xA;&#x9;,TEMP.FECHA_HORA_MOVIMIENTO_SZU&#x9;&#xA;&#x9;,TEMP.ID_PROCESO&#x9;&#xA;&#x9;,TEMP.NUMERO_MOVIMI&#x9;&#xA;&#x9;,TEMP.CONSECUT_MOVIMI&#x9;&#xA;&#x9;,TEMP.ID_CIUDAD_ORG&#x9;&#xA;&#x9;,TEMP.NOMBRE_CIUDAD&#x9;&#xA;&#x9;,TEMP.ID_REGIONAL&#x9;&#xA;&#x9;,TEMP.NOMBRE_REGIONAL&#x9;&#xA;&#x9;,TEMP.ID_ZONA_URBA&#x9;&#xA;&#x9;,TEMP.ID_CIUDAD_ZONA_URBA&#x9;&#xA;&#x9;,TEMP.ID_TIPO_ZONA_URBA&#x9;&#xA;&#x9;,TEMP.NOMBRE_ZONA_URBA&#x9;&#xA;&#x9;,TEMP.ID_TIPO_LOGISTICA&#x9;&#xA;&#x9;,TEMP.NUMERO_PIEZAS&#x9;&#xA;&#x9;,TEMP.FECHA_ENTREGA_VERIFICADA&#x9;&#xA;&#x9;,TEMP.CONSECUT_MOVIMI_EV&#x9;&#xA;&#x9;,TEMP.NUMERO_MOVIMI_EV&#x9;&#xA;&#x9;,TEMP.ID_PROCESO_EV&#x9;&#xA;&#x9;,TEMP.TIPO_PRUEBA_ENTREGA&#x9;&#xA;&#x9;,TEMP.TIPO_PRUEBA_ENTREGA_GENERADA&#x9;&#xA;&#x9;,TEMP.CUMPLE_PRODUCTIVIDAD&#x9;&#xA;&#x9;,TEMP.FECHA_GENERACION_REP&#xA;&#x9;--------------------------&#xA;&#x9;,TEMP.FECHA_HORA_MOVIMIENTO_DEVOL&#x9;&#xA;&#x9;,TEMP.NUMERO_MOVIMI_DEVOL&#x9;&#xA;&#x9;,TEMP.CONSECUT_MOVIMI_DEVOL&#x9;&#xA;&#x9;,TEMP.ID_PROCESO_DEVOL&#x9;&#xA;&#x9;,TEMP.ID_CONCEPTO_DEVOL&#x9;&#xA;&#x9;,TEMP.NOMBRE_CONCEPTO_DEVOL&#xA;&#x9;,ASIGNADAS_DIVISION_INTERNA = CASE WHEN ISNULL(GUI.ID_DIVISION_PROV,0)&lt;1 THEN 0 ELSE 1 END&#xA;&#x9;,GUIA_SERVIENTREGA = CASE WHEN GUI.ID_CLIENTE = '860512330'  THEN 1 ELSE 0 END&#xA;&#x9;,ASIGNADAS_ALIADO = CASE WHEN TEMP.ID_TIPO_ZONA_URBA IN (12,13)  THEN 1 ELSE 0 END&#xA;&#x9;,TEMP.NUM_PZA_DEVOLU&#xA;&#x9;----------------------------------&#xA;&#x9;,FECHA_HORA_MOVIMIENTO_RE&#x9;&#xA;&#x9;,NUMERO_MOVIMI_RE&#x9;&#xA;&#x9;,CONSECUT_MOVIMI_RE&#x9;&#xA;&#x9;,ID_PROCESO_RE&#x9;&#xA;&#x9;,ID_CONCEPTO_RE&#x9;&#xA;&#x9;,NOMBRE_CONCEPTO_RE&#x9;&#xA;&#x9;,NUM_PZA_RE&#xA;&#x9;,TIPO_CLIENTE = CASE WHEN GUI.ID_CLIENTE IS NULL AND ISNULL(GUI.ID_CANAL,'0')&lt;&gt;'0' THEN 'CONTADOS'&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN GUI.ID_CLIENTE IS NOT NULL AND ISNULL(GUI.ID_CANAL,'0')='0' THEN 'CREDITO'&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;ELSE 'OTROS'&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;END&#xA;&#x9;INTO #BASE_FINAL_DESAFIO_PRODUCTIVIDAD &#xA;&#xA;FROM #CONSOLIDADO_PRODUCTIVIDAD_FINAL_POR_DIA_BI TEMP&#xA;LEFT JOIN Mece_Logistico..GUIAS GUI (NOLOCK) &#xA;ON GUI.NUMERO_GUIA=TEMP.NUMERO_GUIA&#xA;WHERE 1=1&#xA;&#xA;/**/&#xA;DELETE FROM  TMP_BORRAR_LOCAL.DBO.CONSOLIDADO_PRODUCTIVIDAD_BI_DEV&#xA;WHERE DIA_PRODUCTIVIDAD IN (SELECT DIA_PRODUCTIVIDAD FROM #CONSOLIDADO_PRODUCTIVIDAD_FINAL_POR_DIA_BI GROUP BY DIA_PRODUCTIVIDAD)&#xA;&#xA;;WITH CTE AS(&#xA;SELECT &#xA;&#x9;ROW#CTE = ROW_NUMBER() OVER(PARTITION BY NUMERO_GUIA ORDER BY FECHA_HORA_MOVIMIENTO_SZU DESC)&#xA;&#x9;,DIA_PRODUCTIVIDAD&#x9;&#xA;&#x9;,#ROW_ID_SE&#x9;&#xA;&#x9;,ID_AUXILIAR1_VEHICULO&#x9;&#xA;&#x9;,NOMBRE_EMPLEADO_AUXILIAR1&#x9;&#xA;&#x9;,ID_AUXILIAR2_VEHICULO&#x9;&#xA;&#x9;,NOMBRE_EMPLEADO_AUXILIAR2&#x9;&#xA;&#x9;,ID_COURIER_CONDUCTOR&#x9;&#xA;&#x9;,NOMBRE_EMPLEADO_COURIER_CONDUCTOR&#x9;&#xA;&#x9;,NUMERO_GUIA&#x9;&#xA;&#x9;,FECHA_HORA_MOVIMIENTO_SZU&#x9;&#xA;&#x9;,ID_PROCESO&#x9;&#xA;&#x9;,NUMERO_MOVIMI&#x9;&#xA;&#x9;,CONSECUT_MOVIMI&#x9;&#xA;&#x9;,ID_CIUDAD_ORG&#x9;&#xA;&#x9;,NOMBRE_CIUDAD&#x9;&#xA;&#x9;,ID_REGIONAL&#x9;&#xA;&#x9;,NOMBRE_REGIONAL&#x9;&#xA;&#x9;,ID_ZONA_URBA&#x9;&#xA;&#x9;,ID_CIUDAD_ZONA_URBA&#x9;&#xA;&#x9;,ID_TIPO_ZONA_URBA&#x9;&#xA;&#x9;,NOMBRE_ZONA_URBA&#x9;&#xA;&#x9;,ID_TIPO_LOGISTICA&#x9;&#xA;&#x9;,NUMERO_PIEZAS&#x9;&#xA;&#x9;,FECHA_ENTREGA_VERIFICADA&#x9;&#xA;&#x9;,CONSECUT_MOVIMI_EV&#x9;&#xA;&#x9;,NUMERO_MOVIMI_EV&#x9;&#xA;&#x9;,ID_PROCESO_EV&#x9;&#xA;&#x9;,TIPO_PRUEBA_ENTREGA&#x9;&#xA;&#x9;,TIPO_PRUEBA_ENTREGA_GENERADA&#x9;&#xA;&#x9;,CUMPLE_PRODUCTIVIDAD&#x9;&#xA;&#x9;,FECHA_GENERACION_REP&#x9;&#xA;&#x9;,FECHA_HORA_MOVIMIENTO_DEVOL&#x9;&#xA;&#x9;,NUMERO_MOVIMI_DEVOL&#x9;&#xA;&#x9;,CONSECUT_MOVIMI_DEVOL&#x9;&#xA;&#x9;,ID_PROCESO_DEVOL&#x9;&#xA;&#x9;,ID_CONCEPTO_DEVOL&#x9;&#xA;&#x9;,NOMBRE_CONCEPTO_DEVOL&#x9;&#xA;&#x9;,ASIGNADAS_DIVISION_INTERNA&#x9;&#xA;&#x9;,GUIA_SERVIENTREGA&#x9;&#xA;&#x9;,ASIGNADAS_ALIADO&#xA;&#x9;,NUM_PZA_DEVOLU&#xA;&#x9;,FECHA_HORA_MOVIMIENTO_RE&#x9;&#xA;&#x9;,NUMERO_MOVIMI_RE&#x9;&#xA;&#x9;,CONSECUT_MOVIMI_RE&#x9;&#xA;&#x9;,ID_PROCESO_RE&#x9;&#xA;&#x9;,ID_CONCEPTO_RE&#x9;&#xA;&#x9;,NOMBRE_CONCEPTO_RE&#x9;&#xA;&#x9;,NUM_PZA_RE&#xA;&#x9;,TIPO_CLIENTE&#xA;FROM #BASE_FINAL_DESAFIO_PRODUCTIVIDAD&#xA;)&#xA;/*&#xA;--ALTER TABLE TMP_BORRAR_LOCAL.DBO.CONSOLIDADO_PRODUCTIVIDAD_BI ADD TIPO_CLIENTE VARCHAR(30) NULL&#xA;&#xA;SELECT * FROM TMP_BORRAR_LOCAL.DBO.CONSOLIDADO_PRODUCTIVIDAD_BI &#xA;*/&#xA;INSERT INTO TMP_BORRAR_LOCAL.DBO.CONSOLIDADO_PRODUCTIVIDAD_BI  /*_DEV*/&#xA;(&#xA;DIA_PRODUCTIVIDAD&#x9;&#xA;&#x9;,#ROW_ID_SE&#x9;&#xA;&#x9;,ID_AUXILIAR1_VEHICULO&#x9;&#xA;&#x9;,NOMBRE_EMPLEADO_AUXILIAR1&#x9;&#xA;&#x9;,ID_AUXILIAR2_VEHICULO&#x9;&#xA;&#x9;,NOMBRE_EMPLEADO_AUXILIAR2&#x9;&#xA;&#x9;,ID_COURIER_CONDUCTOR&#x9;&#xA;&#x9;,NOMBRE_EMPLEADO_COURIER_CONDUCTOR&#x9;&#xA;&#x9;,NUMERO_GUIA&#x9;&#xA;&#x9;,FECHA_HORA_MOVIMIENTO_SZU&#x9;&#xA;&#x9;,ID_PROCESO&#x9;&#xA;&#x9;,NUMERO_MOVIMI&#x9;&#xA;&#x9;,CONSECUT_MOVIMI&#x9;&#xA;&#x9;,ID_CIUDAD_ORG&#x9;&#xA;&#x9;,NOMBRE_CIUDAD&#x9;&#xA;&#x9;,ID_REGIONAL&#x9;&#xA;&#x9;,NOMBRE_REGIONAL&#x9;&#xA;&#x9;,ID_ZONA_URBA&#x9;&#xA;&#x9;,ID_CIUDAD_ZONA_URBA&#x9;&#xA;&#x9;,ID_TIPO_ZONA_URBA&#x9;&#xA;&#x9;,NOMBRE_ZONA_URBA&#x9;&#xA;&#x9;,ID_TIPO_LOGISTICA&#x9;&#xA;&#x9;,NUMERO_PIEZAS&#x9;&#xA;&#x9;,FECHA_ENTREGA_VERIFICADA&#x9;&#xA;&#x9;,CONSECUT_MOVIMI_EV&#x9;&#xA;&#x9;,NUMERO_MOVIMI_EV&#x9;&#xA;&#x9;,ID_PROCESO_EV&#x9;&#xA;&#x9;,TIPO_PRUEBA_ENTREGA&#x9;&#xA;&#x9;,TIPO_PRUEBA_ENTREGA_GENERADA&#x9;&#xA;&#x9;,CUMPLE_PRODUCTIVIDAD&#x9;&#xA;&#x9;,FECHA_GENERACION_REP&#xA;&#x9;,FECHA_HORA_MOVIMIENTO_DEVOL&#x9;&#xA;&#x9;,NUMERO_MOVIMI_DEVOL&#x9;&#xA;&#x9;,CONSECUT_MOVIMI_DEVOL&#x9;&#xA;&#x9;,ID_PROCESO_DEVOL&#x9;&#xA;&#x9;,ID_CONCEPTO_DEVOL&#x9;&#xA;&#x9;,NOMBRE_CONCEPTO_DEVOL&#x9;&#xA;&#x9;,ASIGNADAS_DIVISION_INTERNA&#x9;&#xA;&#x9;,GUIA_SERVIENTREGA&#x9;&#xA;&#x9;,ASIGNADAS_ALIADO&#xA;&#x9;,NUM_PZA_DEVOLU&#xA;&#x9;,FECHA_HORA_MOVIMIENTO_RE&#x9;&#xA;&#x9;,NUMERO_MOVIMI_RE&#x9;&#xA;&#x9;,CONSECUT_MOVIMI_RE&#x9;&#xA;&#x9;,ID_PROCESO_RE&#x9;&#xA;&#x9;,ID_CONCEPTO_RE&#x9;&#xA;&#x9;,NOMBRE_CONCEPTO_RE&#x9;&#xA;&#x9;,NUM_PZA_RE&#xA;&#x9;,TIPO_CLIENTE&#xA;)&#xA;SELECT&#xA;&#x9;DIA_PRODUCTIVIDAD&#x9;&#xA;&#x9;,#ROW_ID_SE&#x9;&#xA;&#x9;,ID_AUXILIAR1_VEHICULO&#x9;&#xA;&#x9;,NOMBRE_EMPLEADO_AUXILIAR1&#x9;&#xA;&#x9;,ID_AUXILIAR2_VEHICULO&#x9;&#xA;&#x9;,NOMBRE_EMPLEADO_AUXILIAR2&#x9;&#xA;&#x9;,ID_COURIER_CONDUCTOR&#x9;&#xA;&#x9;,NOMBRE_EMPLEADO_COURIER_CONDUCTOR&#x9;&#xA;&#x9;,NUMERO_GUIA&#x9;&#xA;&#x9;,FECHA_HORA_MOVIMIENTO_SZU&#x9;&#xA;&#x9;,ID_PROCESO&#x9;&#xA;&#x9;,NUMERO_MOVIMI&#x9;&#xA;&#x9;,CONSECUT_MOVIMI&#x9;&#xA;&#x9;,ID_CIUDAD_ORG&#x9;&#xA;&#x9;,NOMBRE_CIUDAD&#x9;&#xA;&#x9;,ID_REGIONAL&#x9;&#xA;&#x9;,NOMBRE_REGIONAL&#x9;&#xA;&#x9;,ID_ZONA_URBA&#x9;&#xA;&#x9;,ID_CIUDAD_ZONA_URBA&#x9;&#xA;&#x9;,ID_TIPO_ZONA_URBA&#x9;&#xA;&#x9;,NOMBRE_ZONA_URBA&#x9;&#xA;&#x9;,ID_TIPO_LOGISTICA&#x9;&#xA;&#x9;,NUMERO_PIEZAS&#x9;&#xA;&#x9;,FECHA_ENTREGA_VERIFICADA&#x9;&#xA;&#x9;,CONSECUT_MOVIMI_EV&#x9;&#xA;&#x9;,NUMERO_MOVIMI_EV&#x9;&#xA;&#x9;,ID_PROCESO_EV&#x9;&#xA;&#x9;,TIPO_PRUEBA_ENTREGA&#x9;&#xA;&#x9;,TIPO_PRUEBA_ENTREGA_GENERADA&#x9;&#xA;&#x9;,CUMPLE_PRODUCTIVIDAD&#x9;&#xA;&#x9;,FECHA_GENERACION_REP&#x9;&#xA;&#x9;,FECHA_HORA_MOVIMIENTO_DEVOL&#x9;&#xA;&#x9;,NUMERO_MOVIMI_DEVOL&#x9;&#xA;&#x9;,CONSECUT_MOVIMI_DEVOL&#x9;&#xA;&#x9;,ID_PROCESO_DEVOL&#x9;&#xA;&#x9;,ID_CONCEPTO_DEVOL&#x9;&#xA;&#x9;,NOMBRE_CONCEPTO_DEVOL&#x9;&#xA;&#x9;,ASIGNADAS_DIVISION_INTERNA&#x9;&#xA;&#x9;,GUIA_SERVIENTREGA&#x9;&#xA;&#x9;,ASIGNADAS_ALIADO&#xA;&#x9;,NUM_PZA_DEVOLU&#xA;&#x9;,FECHA_HORA_MOVIMIENTO_RE&#x9;&#xA;&#x9;,NUMERO_MOVIMI_RE&#x9;&#xA;&#x9;,CONSECUT_MOVIMI_RE&#x9;&#xA;&#x9;,ID_PROCESO_RE&#x9;&#xA;&#x9;,ID_CONCEPTO_RE&#x9;&#xA;&#x9;,NOMBRE_CONCEPTO_RE&#x9;&#xA;&#x9;,NUM_PZA_RE&#xA;&#x9;,TIPO_CLIENTE&#xA;&#x9;------INTO TMP_BORRAR_LOCAL.DBO.CONSOLIDADO_PRODUCTIVIDAD_BI_DEV&#xA;FROM CTE WHERE ROW#CTE=1&#xA;--AND ID_AUXILIAR1_VEHICULO='80825271'&#xA;--AND CUMPLE_PRODUCTIVIDAD='SI'&#xA; /*&#xA; 80825271&#xA;1090481938&#xA;1000871020&#xA; */&#xA;&#xA;-- SELECT COUNT(1) FROM TMP_BORRAR_LOCAL.DBO.CONSOLIDADO_PRODUCTIVIDAD_BI  WHERE DIA_PRODUCTIVIDAD=20241202&#xA; --129918&#xA; --129917&#xA; --SELECT * FROM TMP_BORRAR_LOCAL.DBO.CONSOLIDADO_PRODUCTIVIDAD_BI WHERE ID_AUXILIAR1_VEHICULO='1151957982'&#xA; --SELECT * FROM PARAMETROS..EMPLEADOS (NOLOCK) WHERE NOMBRE_EMPLEADO like '%FELIPE%' AND APELLIDO_EMPLEADO LIKE '%QUIÑONES%'&#xA; --SELECT * FROM TMP_BORRAR_LOCAL.DBO.CONSOLIDADO_PRODUCTIVIDAD_BI WHERE DIA_PRODUCTIVIDAD=20241202&#xA;&#xA;&#xA; --SELECT DISTINCT ID_TIPO_ZONA_URBA,NOMBRE_ZONA_URBA FROM TMP_BORRAR_LOCAL.DBO.CONSOLIDADO_PRODUCTIVIDAD_BI WHERE ID_TIPO_ZONA_URBA=13&#xA; --SELECT * FROM TIPOSZONASURBANAS&#xA;&#xA;&#xA; --select NUMERO_GUIA,ID_DIVISION_PROV,ID_ESTADOENVIO,ID_ESTADOGUIA,ID_CLIENTE FROM Mece_Logistico..GUIAS WITH (NOLOCK) WHERE NUMERO_GUIA IN(2243647726,2255177955)&#xA;&#xA;--SELECT * FROM Mece_Logistico..ESTADOSGUIA&#xA;--SELECT * FROM Mece_Logistico..ESTADOSENVIO&#xA;--SELECT * FROM PARAMETROS..CLIENTES WHERE ID_CLIENTE='800100159'&#xA;&#xA;--SELECT * FROM TMP_BORRAR_LOCAL.DBO.CONSOLIDADO_PRODUCTIVIDAD_BI &#xA;----&#xA;&#xA;----&quot;"
