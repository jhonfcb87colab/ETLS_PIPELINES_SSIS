            <SQLTask:SqlTaskData
              SQLTask:Connection="{0209F5F2-ACE2-4A59-B382-8A6ACD287785}"
              SQLTask:SqlStatementSource="TRUNCATE TABLE TMP_BORRAR_LOCAL.DBO.CONSOLIDADO_PRODUCTIVIDAD_BI_EZU     /*_DEV*/&#xA;&#xA;&#xA;------TRUNCATE TABLE TMP_BORRAR_LOCAL.DBO.CONSOLIDADO_PRODUCTIVIDAD_BI_DEV&#xA;&#xA;&#xA;&#xA;/*&#xA;--SELECT DISTINCT DIA_PRODUCTIVIDAD FROM #BASE_FINAL_DESAFIO_PRODUCTIVIDAD&#xA;&#xA;DECLARE @DDLETE INT = ((YEAR(DATEADD(mm,-5,DATEADD(mm,DATEDIFF(mm,0,GETDATE()),0)))*100)+MONTH(DATEADD(mm,-5,DATEADD(mm,DATEDIFF(mm,0,GETDATE()),0))))*100+DAY(DATEADD(mm,-5,DATEADD(mm,DATEDIFF(mm,0,GETDATE()),0)))&#xA;--select @DDLETE &#xA;DELETE FROM  TMP_BORRAR_LOCAL.DBO.CONSOLIDADO_PRODUCTIVIDAD_BI&#xA;WHERE DIA_PRODUCTIVIDAD &lt; @DDLETE &#xA;*/" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
