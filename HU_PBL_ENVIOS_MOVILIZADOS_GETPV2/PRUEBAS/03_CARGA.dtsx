                  description="OLE DB Source"
                  name="PESOS A AJUSTAR POR ERRORES DE DIGITACION"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">WITH CTE AS(
SELECT [NUMERO_GUIA]
   FROM [tmp_borrar_local].[dbo].[DRW_TMP_COSTOS_POR_TRAYECTO_BI] (NOLOCK)
  WHERE SUBSTRING(CAST(numero_guia AS NVARCHAR(15)), 1, 5)= SUBSTRING(CAST(PESO_FISICO_GUIA AS NVARCHAR(15)), 1, 5)
 AND ID_PROCESO&lt;&gt;14
 GROUP BY [NUMERO_GUIA]
 )
 SELECT CT.NUMERO_GUIA
 ,G_ANT_PESO_FISICO_GUIA =  CASE WHEN FG.PESO_FISICO_GUIA IS NULL OR FG.PESO_FISICO_GUIA=0 THEN NULL
								ELSE FG.PESO_FISICO_GUIA
								END
 ,GUI.PESO_FISICO_GUIA AS GUI_PESO_FISICO_GUIA
 ,GUI.PESO_FISICO_OPERA AS GUI_PESO_FISICO_OPERA
 FROM CTE CT 
 LEFT JOIN Mece_Logistico.[dbo].[GUIAS_INF_ANTICIPADA] FG (NOLOCK)
 ON FG.NUMERO_GUIA=CT.NUMERO_GUIA
 LEFT JOIN Mece_Logistico.[dbo].[GUIAS] GUI (NOLOCK)
 ON GUI.NUMERO_GUIA=CT.NUMERO_GUIA</property>
                    <property
