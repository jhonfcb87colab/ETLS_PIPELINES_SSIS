          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{F23E2E5D-51C2-489D-BF93-33ABA46592D1}"
              SQLTask:SqlStatementSource="/*&#xA;SELECT  &#xA;TMPCRR.NUMERO_GUIA&#xA;,TMPCRR.G_ANT_PESO_FISICO_GUIA&#xA;,TMPBS.PESO_FISICO_GUIA&#xA;FROM [TMP].[COSTO_DARWIN_PESOS_CORREGIR] TMPCRR (NOLOCK)&#xA;INNER JOIN [TMP].[COSTO_DARWIN_BASE_OPERACION_MES] TMPBS (NOLOCK)&#xA;ON TMPCRR.NUMERO_GUIA=TMPBS.NUMERO_GUIA&#xA;*/&#xA;UPDATE TMPBS &#xA;SET&#xA;TMPBS.PESO_FISICO_GUIA=convert(int,convert(float,TMPCRR.G_ANT_PESO_FISICO_GUIA))&#xA;/*SELECT  &#xA;TMPCRR.NUMERO_GUIA&#xA;,TMPCRR.G_ANT_PESO_FISICO_GUIA&#xA;,TMPBS.PESO_FISICO_GUIA*/&#xA;FROM [TMP].[COSTO_DARWIN_PESOS_CORREGIR] TMPCRR (NOLOCK)&#xA;INNER JOIN [TMP].[COSTO_DARWIN_BASE_OPERACION_MES] TMPBS (NOLOCK)&#xA;ON TMPCRR.NUMERO_GUIA=TMPBS.NUMERO_GUIA&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
