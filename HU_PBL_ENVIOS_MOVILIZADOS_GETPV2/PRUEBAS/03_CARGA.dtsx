              SQLTask:SqlStatementSource="USE SIG_COLOMBIA_DW&#xA;&#xA;UPDATE TMP SET&#xA;TMP.NUMERO_PIEZAS=1&#xA;FROM TMP.COSTO_DARWIN_BASE_OPERACION_MES TMP&#xA;WHERE NUMERO_PIEZAS=0&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
