    <DTS:Executable
      DTS:refId="Package\PREPARACION DATA BASE OPERACION COSTOS POR TRAYECTO"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{116C56A5-5429-4820-AC46-CC300F35EA7E}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="PREPARACION DATA BASE OPERACION COSTOS POR TRAYECTO"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{A3A65FF9-9058-4FB8-AA1A-7AABA464327A}"
          SQLTask:SqlStatementSource="&#xA;----DECLARE @PERIODO_EJECUCION INT = 202503;&#xA;DECLARE @PERIODO_EJECUCION INT = ?;&#xA;DECLARE @FECH_INI INT = @PERIODO_EJECUCION*100+1;&#xA;DECLARE @FECH_INI_DT DATETIME = convert(datetime,convert(varchar,@FECH_INI));&#xA;DECLARE @FECH_FIN_DT DATETIME = DATEADD(MONTH,1,@FECH_INI_DT);&#xA;PRINT(CONCAT('FECHA_INICIAL: ',CONVERT(varchar,@FECH_INI_DT,23),'   FECHA FINAL: ',CONVERT(varchar,@FECH_FIN_DT,23)))&#xA;&#xA;DROP TABLE IF EXISTS #TMP_TABLA;&#xA;DROP TABLE IF EXISTS #TMP_TABLA_FACTURADO;&#xA;&#xA;&#xA;UPDATE TMPGUI SET &#xA;TMPGUI.VALOR_COMISION_RECAUDO_EFECTY=GCE.VALOR_COMISION_EFECTY&#xA;FROM TMP_BORRAR_LOCAL.DBO.INFORMACION_GUIAS_RED_OPERATIVA TMPGUI  &#xA;INNER JOIN [tmp_borrar_local].[dbo].[GUIA_RECAUDO_INFORMACION_EFECTY] GCE (NOLOCK) ON GCE.NUMERO_GUIA=TMPGUI.NUMERO_GUIA&#xA;&#xA;&#xA;&#xA;/*&#xA;IF OBJECT_ID('tempdb..#TMP_TABLA') IS NOT NULL &#xA;    DROP TABLE #TMP_TABLA&#xA;&#xA;IF OBJECT_ID('tempdb..#TMP_TABLA_FACTURADO') IS NOT NULL &#xA;    DROP TABLE #TMP_TABLA_FACTURADO&#xA;*/&#xA;&#xA;SELECT DISTINCT &#xA;----top 1000&#xA;DupRank = ROW_NUMBER() OVER (&#xA;PARTITION BY TMPTOT.NUMERO_GUIA,TMPTOT.ID_PROCESO,TMPDOC.PLACA_VEHICULO_DOCU,CIU.NOMBRE_CIUDAD,TMPTOT.FECHA_HORA_MOVIMIENTO&#xA;ORDER BY (SELECT NULL)),&#xA;DupRank2 = ROW_NUMBER() OVER (&#xA;PARTITION BY TMPTOT.NUMERO_GUIA,TMPTOT.ID_PROCESO,TMPDOC.PLACA_VEHICULO_DOCU,CIU.NOMBRE_CIUDAD&#xA;ORDER BY (SELECT NULL)),&#xA;TMPTOT.NUMERO_GUIA as NUMERO_GUIA,&#xA;LTRIM(RTRIM(TMPGUI.TIPO_CANAL)) AS CANAL,&#xA;LTRIM(RTRIM(TMPGUI.NOMBRE_PRODUCTO)) AS NOMBRE_PRODUCTO,&#xA;LTRIM(RTRIM(TMPGUI.MEDIO_DE_PAGO)) AS MEDIO_DE_PAGO,&#xA;LTRIM(RTRIM(CAST(TMPGUI.VALOR_RECAUDO AS INT))) AS VALOR_RECAUDO,&#xA;LTRIM(RTRIM(CAST(TMPGUI.VALOR_ENVIO AS INT))) AS VALOR_ENVIO,&#xA;CASE WHEN (TMPTOT.ID_PROCESO=6 or TMPTOT.ID_PROCESO=5) &#xA; THEN LTRIM(RTRIM(CAST(ISNULL(TMPGUI.VALOR_COMISION_VENTA_CDS,0) AS BIGINT))) ELSE 0 END&#xA; AS VALOR_COMISION_VENTA_CDS,&#xA;CASE WHEN TMPTOT.ID_PROCESO=24&#xA; THEN LTRIM(RTRIM(CAST(ISNULL(TMPGUI.VALOR_COMISION_RECAUDO_EFECTY,0) AS BIGINT))) ELSE 0 END&#xA; AS VALOR_COMISION_RECAUDO_EFECTY,&#xA;LTRIM(RTRIM(TMPGUI.NOMBRE_ESTADOENVIO)) AS NOMBRE_ESTADOENVIO,&#xA;LTRIM(RTRIM(TMPTOT.ID_PROCESO)) AS ID_PROCESO,&#xA;LTRIM(RTRIM(PRO.NOMBRE_PROCESO_LOG)) AS NOMBRE_PROCESO_LOG,&#xA;LTRIM(RTRIM(CASE &#xA; WHEN TMPDOC.CODIGO_ACTUAL_CDS &lt;&gt; '' THEN TMPDOC.CODIGO_ACTUAL_CDS&#xA; ELSE TMPDOC.PLACA_VEHICULO_DOCU&#xA;END)) AS PLACA_VEHICULO_DOCU,&#xA;--TMPDOC.PLACA_VEHICULO_DOCU,&#xA;--TMPDOC.CODIGO_ACTUAL_CDS,&#xA;LTRIM(RTRIM(TMPDOC.TOTAL_AUXILIARES)) AS TOTAL_AUXILIARES,&#xA;LTRIM(RTRIM(CASE WHEN TMPDOC.CODIGO_ACTUAL_CDS &lt;&gt; '' THEN 'CDS'&#xA; ELSE&#xA;   CASE WHEN TMPDOC.PLACA_VEHICULO_DOCU LIKE '%A PIE%' THEN 'COURIER A PIE' &#xA;   WHEN TMPDOC.PLACA_VEHICULO_DOCU LIKE '%APIE%' THEN 'COURIER A PIE' &#xA;   WHEN TMPDOC.PLACA_VEHICULO_DOCU LIKE '%A P-E%' THEN 'COURIER A PIE'&#xA;   WHEN TMPDOC.PLACA_VEHICULO_DOCU LIKE '%AP-E%' THEN 'COURIER A PIE'&#xA;   WHEN TMPDOC.PLACA_VEHICULO_DOCU LIKE 'HK%' THEN 'SERVICIO AEREO'&#xA;   WHEN TMPDOC.PLACA_VEHICULO_DOCU LIKE '%ECOBIC%' THEN 'COURIER CICLA'&#xA;   WHEN TMPDOC.PLACA_VEHICULO_DOCU LIKE '%-%' THEN 'MOTO'&#xA;   WHEN ISNUMERIC(TMPDOC.PLACA_VEHICULO_DOCU) = 1 THEN 'CDS'&#xA;   ELSE 'CARRO'--'SIN DEFINIR'&#xA; END&#xA;END)) AS IDENTIFICACION_MOTO_CARRO_CURRIER_AEREO,&#xA;LTRIM(RTRIM(CASE WHEN RTRIM(LTRIM(TMPDOC.CODIGO_ACTUAL_CDS)) &lt;&gt; '' THEN 'CDS'&#xA; ELSE&#xA;  CASE &#xA;   WHEN VEH.ID_PROPIETARIO = 1 THEN 'INSOURCING'&#xA;   WHEN VEH.ID_PROPIETARIO = 2 THEN 'COSOURCING'&#xA;   WHEN VEH.ID_PROPIETARIO = 3 AND TMPDOC.PLACA_VEHICULO_DOCU LIKE '%PIE%' THEN 'INSOURCING COURIER A PIE'&#xA;   WHEN VEH.ID_PROPIETARIO = 3 then 'OUTSOURCING FLETE FIJO'&#xA;   WHEN VEH.ID_PROPIETARIO = 4 then 'OUTSOURCING CONDUCTOR PXP'&#xA;   WHEN VEH.ID_PROPIETARIO = 5 then 'OUTSOURCING AUXILIAR PXP'&#xA;   WHEN VEH.ID_PROPIETARIO = 6 then 'ULTIMA MILLA'&#xA;   WHEN VEH.ID_PROPIETARIO = 7 then 'INSOURCING COURIER A PIE'&#xA;   WHEN VEH.ID_PROPIETARIO = 8 then 'INSOURCING COURIER MOTO'&#xA;   WHEN VEH.ID_PROPIETARIO = 9 then 'INSOURCING COURIER CICLA'&#xA;   WHEN VEH.ID_PROPIETARIO = 10 then 'COSTO EMPRESARIO SATELITE'&#xA;   WHEN VEH.ID_PROPIETARIO = 11 then 'COSTO AEREO'&#xA;   WHEN VEH.ID_PROPIETARIO = 12 then 'AFOROS'&#xA;   WHEN VEH.ID_PROPIETARIO = 13 then 'ESPECIAL'&#xA;   WHEN VEH.ID_PROPIETARIO = 14 then 'INSOURCING COURIER MOTO CARRO'&#xA;   WHEN VEH.ID_PROPIETARIO IS NULL THEN&#xA;    CASE WHEN ISNUMERIC(TMPDOC.PLACA_VEHICULO_DOCU)=1 THEN 'COSTO EMPRESARIO SATELITE'-- 10&#xA;      WHEN TMPDOC.PLACA_VEHICULO_DOCU LIKE '%A PIE%' THEN 'INSOURCING COURIER A PIE' --7&#xA;     WHEN TMPDOC.PLACA_VEHICULO_DOCU LIKE '%APIE%' THEN   'INSOURCING COURIER A PIE'  --7&#xA;     WHEN TMPDOC.PLACA_VEHICULO_DOCU LIKE '%A P═E%' THEN  'INSOURCING COURIER A PIE'  --7&#xA;     WHEN TMPDOC.PLACA_VEHICULO_DOCU LIKE '%AP═E%' THEN   'INSOURCING COURIER A PIE'  --7&#xA;     WHEN TMPDOC.PLACA_VEHICULO_DOCU LIKE 'HK%' THEN 'COSTO AEREO' --11&#xA;     WHEN TMPDOC.PLACA_VEHICULO_DOCU LIKE '%ECOBIC%' THEN 'INSOURCING COURIER CICLA' --9&#xA;     WHEN TMPDOC.PLACA_VEHICULO_DOCU LIKE '%-%' THEN 'INSOURCING COURIER MOTO' --8&#xA;     WHEN TMPDOC.PLACA_VEHICULO_DOCU LIKE '%CLICOH%' THEN 'OUTSOURCING PXP CLICOH' --16&#xA;     WHEN TMPDOC.PLACA_VEHICULO_DOCU LIKE '%LODYTR%' THEN 'OUTSOURCING PXP LODYTRANS' --15&#xA;     WHEN TMPDOC.PLACA_VEHICULO_DOCU LIKE '%CONSOLIDADOR%' THEN 'OUTSOURCING PXP AFORADORES EXTERNOS' --17&#xA;     ELSE 'OUTSOURCING FLETE FIJO'--'CARRO'&#xA;    END --COSTO EMPRESARIO SATELITE&#xA;  END &#xA; END)) AS PROPIETARIO_VEHICULO,&#xA;LTRIM(RTRIM(CASE WHEN RTRIM(LTRIM(TMPDOC.CODIGO_ACTUAL_CDS)) &lt;&gt; '' THEN 0 --CDS &#xA; ELSE&#xA;  CASE &#xA;   WHEN VEH.ID_PROPIETARIO = 1 THEN 1&#xA;   WHEN VEH.ID_PROPIETARIO = 2 THEN 2&#xA;   WHEN VEH.ID_PROPIETARIO = 3 then 3&#xA;   WHEN VEH.ID_PROPIETARIO = 4 then 4&#xA;   WHEN VEH.ID_PROPIETARIO = 5 then 5&#xA;   WHEN VEH.ID_PROPIETARIO = 6 then 6 &#xA;   WHEN VEH.ID_PROPIETARIO = 7 then 7 &#xA;   WHEN VEH.ID_PROPIETARIO = 8 then 8 &#xA;   WHEN VEH.ID_PROPIETARIO = 9 then 9 &#xA;   WHEN VEH.ID_PROPIETARIO = 10 then 10&#xA;   WHEN VEH.ID_PROPIETARIO = 11 then 11&#xA;   WHEN VEH.ID_PROPIETARIO = 12 then 12&#xA;   WHEN VEH.ID_PROPIETARIO = 13 then 13&#xA;   WHEN VEH.ID_PROPIETARIO = 14 then 14&#xA;   WHEN VEH.ID_PROPIETARIO IS NULL THEN&#xA;    CASE WHEN ISNUMERIC(TMPDOC.PLACA_VEHICULO_DOCU)=1 THEN 10&#xA;      WHEN TMPDOC.PLACA_VEHICULO_DOCU LIKE '%A PIE%' THEN 7 &#xA;     WHEN TMPDOC.PLACA_VEHICULO_DOCU LIKE '%APIE%' THEN 7&#xA;     WHEN TMPDOC.PLACA_VEHICULO_DOCU LIKE '%A P═E%' THEN 7&#xA;     WHEN TMPDOC.PLACA_VEHICULO_DOCU LIKE '%AP═E%' THEN 7&#xA;     WHEN TMPDOC.PLACA_VEHICULO_DOCU LIKE 'HK%' THEN 11&#xA;     WHEN TMPDOC.PLACA_VEHICULO_DOCU LIKE '%ECOBIC%' THEN 9 &#xA;     WHEN TMPDOC.PLACA_VEHICULO_DOCU LIKE '%-%' THEN 8 &#xA;     WHEN TMPDOC.PLACA_VEHICULO_DOCU LIKE '%CLICOH%' THEN 16&#xA;     WHEN TMPDOC.PLACA_VEHICULO_DOCU LIKE '%LODYTR%' THEN 15&#xA;     WHEN TMPDOC.PLACA_VEHICULO_DOCU LIKE '%CONSOLIDADOR%' THEN 17&#xA;     WHEN ISNUMERIC(TMPDOC.PLACA_VEHICULO_DOCU) = 1 THEN 0--CDS &#xA;     ELSE 3--'CARRO'&#xA;    END --COSTO EMPRESARIO SATELITE&#xA;  END &#xA; END)) AS MODELOS_DE_CONTRATACION_FLOTA,&#xA;TMPTOT.ID_CIUDAD AS ID_CIUDAD,&#xA;LTRIM(RTRIM(CIU.NOMBRE_CIUDAD)) AS NOMBRE_CIUDAD,&#xA;TMPTOT.FECHA_HORA_MOVIMIENTO AS FECHA_HORA_MOVIMIENTO,&#xA;LTRIM(RTRIM(TMPTOT.TOTAL_GUIAS_RECOLECCION)) AS TOTAL_GUIAS_RECOLECCION,&#xA;LTRIM(RTRIM(TMPTOT.TOTAL_GUIAS_DISTRIBUCION))AS TOTAL_GUIAS_DISTRIBUCION,&#xA;LTRIM(RTRIM(TMPTOT.TOTAL_GUIAS_DEVOLUCIONES)) AS TOTAL_DEVOLUCIONES,&#xA;/*&#xA;LTRIM(RTRIM(ISNULL(CAST(CASE WHEN TMPGUI.PESO_FISICO_OPERA &gt; 0&#xA; THEN TMPGUI.PESO_FISICO_OPERA&#xA; ELSE TMPGUI.PESO_FISICO_GUIA&#xA;END AS INT),1))) AS PESO_FISICO_GUIA,&#xA;*/&#xA;TMPGUI.PESO_FISICO_GUIA,&#xA;LTRIM(RTRIM(ISNULL(CAST(CASE WHEN TMPGUI.PESO_VOLU_OPERA &gt; 0&#xA; THEN TMPGUI.PESO_VOLU_OPERA&#xA; ELSE TMPGUI.PESO_VOLU_GUIA&#xA;END AS INT),1))) AS PESO_VOLU_GUIA,&#xA;LTRIM(RTRIM(CAST(TMPTOT.PESO_FISICO_OPERA_RECOLECCION AS INT))) AS PESO_FISICO_OPERA_RECOLECCION,&#xA;LTRIM(RTRIM(CAST(TMPTOT.PESO_FISICO_OPERA_DISTRIBUCION AS INT))) AS PESO_FISICO_OPERA_DISTRIBUCION,&#xA;LTRIM(RTRIM(CAST(TMPTOT.PESO_FISICO_OPERA_DEVOLUCION AS INT))) AS PESO_FISICO_OPERA_DEVOLUCION,&#xA;LTRIM(RTRIM(CAST(TMPTOT.PESO_VOLU_OPERA_DISTRIBUCION AS INT))) AS PESO_VOLU_OPERA_RECOLECCION,&#xA;LTRIM(RTRIM(CAST(TMPTOT.PESO_VOLU_OPERA_DISTRIBUCION AS INT))) AS PESO_VOLU_OPERA_DISTRIBUCION,&#xA;LTRIM(RTRIM(CAST(TMPTOT.PESO_VOLU_OPERA_DEVOLUCION AS INT))) AS PESO_VOLUO_OPERA_DEVOLUCION,&#xA;LTRIM(RTRIM(CAST(TMPTOT.TOTAL_PIEZAS_RECOLECCION AS INT))) AS TOTAL_PIEZAS_OPERA_RECOLECCION,&#xA;LTRIM(RTRIM(CAST(TMPTOT.TOTAL_PIEZAS_DISTRIBUCION AS INT))) AS TOTAL_PIEZAS_OPERA_DISTRIBUCION,&#xA;LTRIM(RTRIM(CAST(TMPTOT.TOTAL_PIEZAS_DEVOLUCIONES AS INT))) AS TOTAL_PIEZAS_OPERA_DEVOLUCION,&#xA;LTRIM(RTRIM(ISNULL(TMPCRO.MOVIMIENTOS_CROSS,0))) AS MOVIMIENTOS_CROSS,&#xA;LTRIM(RTRIM(TMPDOC.LLAVE_ORIGEN_DESTINO)) AS LLAVE_ORIGEN_DESTINO,&#xA;LTRIM(RTRIM(TMPGUI.NOMBRE_TIPOTRAY)) AS NOMBRE_TIPOTRAY,&#xA;LTRIM(RTRIM(TMPGUI.NOMBRE_CLIENTE)) AS NOMBRE_CLIENTE_CDS,&#xA;LTRIM(RTRIM(TMPGUI.DANE_ORIGEN_DESTINO)) AS DANE_ORIGEN_DESTINO,&#xA;LTRIM(RTRIM(TMPGUI.NOMBRE_ORIGEN_DESTINO)) AS NOMBRE_ORIGEN_DESTINO,&#xA;--CASE WHEN TMPTOT.ID_PROCESO = 9&#xA;-- THEN ISNULL(ZON.NOMBRE_ZONA_URBA,'')&#xA;-- ELSE ''@@Sofia2025*&#xA;--END &#xA;'' AS NOMBRE_ZONA_DISTRIBUCION,&#xA;LTRIM(RTRIM(CASE WHEN TMPTOT.ID_PROCESO = 12&#xA; THEN 'NACIONAL'&#xA; ELSE 'URBANO'&#xA;END)) AS TIPO_OPERACION_VEHICULO,&#xA;LTRIM(RTRIM(CASE WHEN TMPTOT.ID_PROCESO = 12&#xA; THEN '0'&#xA; ELSE '65'&#xA;END)) AS KM_INSOURCING,&#xA;LTRIM(RTRIM(ISNULL(TMPGUI.NOMBRE_CLASE_TIPO_CANAL,''))) AS TIPO_CANAL,&#xA;CASE WHEN TMPTOT.ID_PROCESO=24 THEN LTRIM(RTRIM(ISNULL(PPD.[CODIGO_CDS_PPES_DISTRIBUCION],''))) ELSE '' END&#xA; AS [CODIGO_CDS_PPES_DISTRIBUCION],&#xA;CASE WHEN TMPTOT.ID_PROCESO=24 THEN LTRIM(RTRIM(CAST(ISNULL(PPD.[COMISION_DISTRIBUCION_EMPRESARIO],0) AS BIGINT))) ELSE 0 END&#xA; AS [COMISION_DISTRIBUCION_EMPRESARIO],&#xA;CASE WHEN TMPTOT.ID_PROCESO=24 THEN LTRIM(RTRIM(ISNULL(PPD.[MODO_ENTREGA_EMPRESARIO],''))) ELSE '' END&#xA; AS [MODO_ENTREGA_EMPRESARIO],&#xA;CASE WHEN TMPTOT.ID_PROCESO=2 THEN LTRIM(RTRIM(ISNULL(PPR.[CODIGO_CDS_PPES_RECOLECCION],''))) ELSE '' END&#xA; AS [CODIGO_CDS_PPES_RECOLECCION],&#xA;CASE WHEN TMPTOT.ID_PROCESO=2 THEN LTRIM(RTRIM(CAST(ISNULL(PPR.[COMISION_RECOLECCION_EMPRESARIO],0) AS BIGINT))) ELSE 0 END&#xA; AS [COMISION_RECOLECCION_EMPRESARIO],&#xA;RE.ID_REGIONAL AS ID_REGIONAL,&#xA;RE.NOMBRE_REGIONAL AS NOMBRE_REGIONAL,&#xA;ISNULL(DOC.ID_COURIER_CONDUCTOR,'')as ID_COURIER_CONDUCTOR,&#xA;ISNULL(DOC.ID_AUXILIAR1_VEHICULO,'') as ID_AUXILIAR1_VEHICULO,&#xA;ISNULL(DOC.ID_AUXILIAR2_VEHICULO,'')as ID_AUXILIAR2_VEHICULO,&#xA;CASE WHEN TMPTOT.ID_PROCESO=24 THEN ISNULL(DOC.NOMBRE_ZONA_URBA,'')  ELSE '' END   &#xA; AS NOMBRE_ZONA_URBA,&#xA;TMPGUI.ID_PRODUCTO as ID_PRODUCTO,&#xA;--CAST(PESO_VOLU_GUIA AS INT) AS PESO_VOLU_GUIA,&#xA;TMPGUI.NUMERO_PIEZAS AS NUMERO_PIEZAS,&#xA;CAST(TMPGUI.VALOR_FACTURADO AS INT) AS VALOR_FACTURADO&#xA;,TMPGUI.FECHA_FACTURADO&#xA;,TMPGUI.FECHA_ENVIO&#xA;--INTO TMP_BORRAR_LOCAL.DBO.TMP_TABLA_20240716_Juino_V2&#xA;INTO #TMP_TABLA&#xA;FROM TMP_BORRAR_LOCAL.DBO.INFORMACION_DOCUMENTOS_TOTALIZADOS_RED_OPERATIVA TMPTOT (NOLOCK)&#xA;INNER JOIN TMP_BORRAR_LOCAL.DBO.INFORMACION_GUIAS_RED_OPERATIVA TMPGUI (NOLOCK) ON TMPGUI.NUMERO_GUIA = TMPTOT.NUMERO_GUIA&#xA;INNER JOIN TMP_BORRAR_LOCAL.DBO.INFORMACION_DOCUMENTOS_RED_OPERATIVA TMPDOC (NOLOCK) ON TMPDOC.NUMERO_GUIA = TMPTOT.NUMERO_GUIA AND TMPDOC.ID_PROCESO = TMPTOT.ID_PROCESO AND TMPDOC.PLACA_VEHICULO_DOCU = TMPTOT.PLACA_VEHICULO_DOCU AND TMPDOC.FECHA_HORA_MOVIMIENTO = TMPTOT.FECHA_HORA_MOVIMIENTO&#xA;LEFT JOIN PARAMETROS.DBO.PROCESOS PRO (NOLOCK) ON PRO.ID_PROCESO = TMPTOT.ID_PROCESO&#xA;LEFT JOIN PARAMETROS.DBO.CIUDADES CIU (NOLOCK) ON CIU.ID_PAIS = 1 AND CIU.ID_CIUDAD = TMPTOT.ID_CIUDAD&#xA;LEFT JOIN PARAMETROS.dbo.REGIONALES_PAIS RE (NOLOCK) ON RE.ID_PAIS = 1 AND RE.ID_REGIONAL=CIU.ID_REGIONAL&#xA;&#xA;LEFT JOIN TMP_BORRAR_LOCAL.DBO.DOCUMENTOS_RED_OPERATIVA DOC (NOLOCK) ON DOC.ID_PROCESO = TMPTOT.ID_PROCESO AND DOC.PLACA_VEHICULO_DOCU = TMPTOT.PLACA_VEHICULO_DOCU AND DOC.FECHA_HORA_MOVIMI = TMPTOT.FECHA_HORA_MOVIMIENTO&#xA;LEFT JOIN PARAMETROS.DBO.ZONASURBANAS ZON (NOLOCK) ON ZON.ID_PAIS = DOC.ID_PAIS_ZONA_URBA AND ZON.ID_CIUDAD = DOC.ID_CIUDAD_ZONA_URBA AND ZON.ID_TIPO_ZONA_URBA = DOC.ID_TIPO_ZONA_URBA AND ZON.ID_ZONA_URBA = DOC.ID_ZONA_URBA&#xA;&#xA;LEFT JOIN PARAMETROS.DBO.VEHICULOS VEH (NOLOCK) ON VEH.ID_PAIS = 1 AND VEH.PLACA_VEHICULO = TMPTOT.PLACA_VEHICULO_DOCU AND TMPDOC.PLACA_VEHICULO_DOCU NOT LIKE 'HK%'&#xA;LEFT JOIN TMP_BORRAR_LOCAL.DBO.MOVIMIENTOS_CROSS_RED_OPERATIVA TMPCRO (NOLOCK) ON TMPCRO.NUMERO_GUIA = TMPTOT.NUMERO_GUIA&#xA;LEFT JOIN TMP_BORRAR_LOCAL.[dbo].[PPES_COMISION_DISTRIBUCION] PPD (NOLOCK) ON PPD.NUMERO_GUIA = TMPGUI.NUMERO_GUIA&#xA;LEFT JOIN TMP_BORRAR_LOCAL. [dbo].[PPES_COMISION_RECOLECCION] PPR (NOLOCK) ON PPR.NUMERO_GUIA = TMPGUI.NUMERO_GUIA&#xA;where --TMPGUI.NOMBRE_PRODUCTO IN('DOCUMENTO UNITARIO','MERCANCIA PREMIER','MERCANCIA INDUSTRIAL','LOGISTICA DE INVERSA')&#xA;--AND &#xA;LEN(TMPTOT.NUMERO_GUIA)&gt;7&#xA;AND TMPTOT.FECHA_HORA_MOVIMIENTO BETWEEN @FECH_INI_DT AND @FECH_FIN_DT&#xA;--AND TMPDOC.PLACA_VEHICULO_DOCU LIKE 'HK%'&#xA;--and TMPTOT.NUMERO_GUIA in(2013638709) --&#xA;--and TMPTOT.NUMERO_GUIA in(216540222)--216540222) --and --2099137821&#xA;--and TMPTOT.ID_PROCESO=9&#xA;ORDER BY NUMERO_GUIA, FECHA_HORA_MOVIMIENTO&#xA;OPTION(RECOMPILE)&#xA;&#xA;&#xA;&#xA;&#xA;DELETE  FROM #TMP_TABLA WHERE DupRank&gt;1&#xA;DELETE from #TMP_TABLA WHERE ID_PROCESO=2 and COMISION_RECOLECCION_EMPRESARIO=0&#xA;DELETE from #TMP_TABLA where ID_PROCESO=2  and DupRank2&gt;1&#xA;DELETE FROM #TMP_TABLA WHERE ID_PROCESO=14 --Se quita el proceso 14 que solo se tiene en cuenta para el cross&#xA;&#xA;--TMP_TABLA_20250305&#xA;--TRUNCATE TABLE TMP_BORRAR_LOCAL.DBO.TMP_TABLA_20250421&#xA;&#xA;--INSERT INTO TMP_BORRAR_LOCAL.DBO.TMP_TABLA_20250619&#xA;TRUNCATE TABLE [tmp_borrar_local].[dbo].[DRW_TMP_COSTOS_POR_TRAYECTO_BI];&#xA;INSERT INTO [tmp_borrar_local].[dbo].[DRW_TMP_COSTOS_POR_TRAYECTO_BI]&#xA;SELECT &#xA;PERIODO_EJECUCION = @PERIODO_EJECUCION, &#xA;NUMERO_GUIA, CANAL, NOMBRE_PRODUCTO, MEDIO_DE_PAGO, VALOR_RECAUDO &#xA;,VALOR_ENVIO,VALOR_COMISION_VENTA_CDS,VALOR_COMISION_RECAUDO_EFECTY, NOMBRE_ESTADOENVIO, ID_PROCESO, NOMBRE_PROCESO_LOG, PLACA_VEHICULO_DOCU, TOTAL_AUXILIARES, IDENTIFICACION_MOTO_CARRO_CURRIER_AEREO &#xA;,PROPIETARIO_VEHICULO,MODELOS_DE_CONTRATACION_FLOTA, ID_CIUDAD, NOMBRE_CIUDAD, FECHA_HORA_MOVIMIENTO, TOTAL_GUIAS_RECOLECCION, TOTAL_GUIAS_DISTRIBUCION &#xA;,TOTAL_DEVOLUCIONES, &#xA;PESO_FISICO_GUIA,&#xA;PESO_VOLU_GUIA,&#xA;PESO_FISICO_OPERA_RECOLECCION, &#xA;PESO_FISICO_OPERA_DISTRIBUCION, &#xA;PESO_FISICO_OPERA_DEVOLUCION, &#xA;PESO_VOLU_OPERA_RECOLECCION,&#xA;PESO_VOLU_OPERA_DISTRIBUCION,&#xA;PESO_VOLUO_OPERA_DEVOLUCION,&#xA;TOTAL_PIEZAS_OPERA_RECOLECCION,&#xA;TOTAL_PIEZAS_OPERA_DISTRIBUCION,&#xA;TOTAL_PIEZAS_OPERA_DEVOLUCION,&#xA;MOVIMIENTOS_CROSS&#xA;,LLAVE_ORIGEN_DESTINO, NOMBRE_TIPOTRAY, NOMBRE_CLIENTE_CDS, DANE_ORIGEN_DESTINO,NOMBRE_ORIGEN_DESTINO, NOMBRE_ZONA_DISTRIBUCION, TIPO_OPERACION_VEHICULO &#xA;,KM_INSOURCING, TIPO_CANAL, CODIGO_CDS_PPES_DISTRIBUCION, COMISION_DISTRIBUCION_EMPRESARIO, MODO_ENTREGA_EMPRESARIO, CODIGO_CDS_PPES_RECOLECCION&#xA;,COMISION_RECOLECCION_EMPRESARIO, ID_REGIONAL, NOMBRE_REGIONAL, ID_AUXILIAR1_VEHICULO, ID_AUXILIAR2_VEHICULO, ID_COURIER_CONDUCTOR, NOMBRE_ZONA_URBA, ID_PRODUCTO&#xA;--,PESO_VOLU_GUIA&#xA;,NUMERO_PIEZAS,VALOR_FACTURADO,FECHA_FACTURADO&#xA;,FECHA_ENVIO&#xA;,DIRECCION_ORG = CONVERT(VARCHAR(400),'') &#xA;,DIRECCION_DEST = CONVERT(VARCHAR(400),'')&#xA;--INTO [tmp_borrar_local].[dbo].[DRW_TMP_COSTOS_POR_TRAYECTO_BI]&#xA;FROM #TMP_TABLA&#xA;OPTION(RECOMPILE)&#xA;&#xA;&#xA;select top 0 &#xA;* into #TMP_TABLA_FACTURADO&#xA;from [tmp_borrar_local].[dbo].[DRW_TMP_COSTOS_POR_TRAYECTO_BI]&#xA;&#xA;&#xA;INSERT INTO #TMP_TABLA_FACTURADO --INTO TMP_BORRAR_LOCAL.DBO.TMP_TABLA_20250421 --&#xA;SELECT &#xA;PERIODO_EJECUCION = @PERIODO_EJECUCION,&#xA;MIFG.NUMERO_GUIA, 'CORPORATIVO' AS CANAL, MIFG.NOMBRE_PRODUCTO AS NOMBRE_PRODUCTO, 'NO DISPONIBLE' AS MEDIO_DE_PAGO, 0 AS VALOR_RECAUDO &#xA;,CAST((FLETE + SOBRE_FLETE-DESCUENTO) AS INT) AS VALOR_ENVIO, 0 AS VALOR_COMISION_VENTA_CDS, 0 AS VALOR_COMISION_RECAUDO_EFECTY&#xA;,E.NOMBRE_ESTADOENVIO AS NOMBRE_ESTADOENVIO, 0 AS ID_PROCESO, '' AS NOMBRE_PROCESO_LOG, '' AS PLACA_VEHICULO_DOCU, 0 AS TOTAL_AUXILIARES, '' AS IDENTIFICACION_MOTO_CARRO_CURRIER_AEREO &#xA;,'' AS PROPIETARIO_VEHICULO,0 AS MODELOS_DE_CONTRATACION_FLOTA, 0 AS ID_CIUDAD, '' AS NOMBRE_CIUDAD, '' AS FECHA_HORA_MOVIMIENTO, 0 AS TOTAL_GUIAS_RECOLECCION, 0 AS TOTAL_GUIAS_DISTRIBUCION &#xA;,0 AS TOTAL_DEVOLUCIONES&#xA;, MIFG.PESO_FISICO_OPERA AS PESO_FISICO_GUIA&#xA;,MIFG.PESO_VOLU_OPERA AS PESO_VOLU_GUIA&#xA;, 0 AS PESO_FISICO_OPERA_RECOLECCION&#xA;, 0 AS PESO_FISICO_OPERA_DISTRIBUCION&#xA;, 0 AS PESO_FISICO_OPERA_DEVOLUCION&#xA;, 0 AS PESO_VOLU_OPERA_RECOLECCION&#xA;, 0 AS PESO_VOLU_OPERA_DISTRIBUCION&#xA;, 0 AS PESO_VOLUO_OPERA_DEVOLUCION&#xA;, 0 AS TOTAL_PIEZAS_OPERA_RECOLECCION&#xA;, 0 AS TOTAL_PIEZAS_OPERA_DISTRIBUCION&#xA;, 0 AS TOTAL_PIEZAS_OPERA_DEVOLUCION&#xA;, 0 AS MOVIMIENTOS_CROSS&#xA;,'' AS LLAVE_ORIGEN_DESTINO, MIFG.NOMBRE_TIPOTRAY AS NOMBRE_TIPOTRAY, C.RAZON_SOCIAL_CORTA AS NOMBRE_CLIENTE_CDS&#xA;,ISNULL(RTRIM(CIUO.CODIGO_DANE),'') + ' - ' + ISNULL(RTRIM(CIUD.CODIGO_DANE),ISNULL(RTRIM(CIUO.CODIGO_DANE),'')) AS DANE_ORIGEN_DESTINO&#xA;,ISNULL(RTRIM(CIUD.NOMBRE_CIUDAD),'') + ' - ' + ISNULL(RTRIM(CIUD.NOMBRE_CIUDAD),ISNULL(RTRIM(CIUD.NOMBRE_CIUDAD),'')) AS NOMBRE_ORIGEN_DESTINO&#xA;, '' AS NOMBRE_ZONA_DISTRIBUCION,'' AS TIPO_OPERACION_VEHICULO &#xA;,0 AS KM_INSOURCING, '' AS TIPO_CANAL, '' AS CODIGO_CDS_PPES_DISTRIBUCION, 0 AS COMISION_DISTRIBUCION_EMPRESARIO, '' AS MODO_ENTREGA_EMPRESARIO, '' AS CODIGO_CDS_PPES_RECOLECCION&#xA;,0 AS COMISION_RECOLECCION_EMPRESARIO, '' AS ID_REGIONAL, '' AS NOMBRE_REGIONAL, '' AS ID_AUXILIAR1_VEHICULO, '' AS ID_AUXILIAR2_VEHICULO,'' AS ID_COURIER_CONDUCTOR, '' AS NOMBRE_ZONA_URBA, &#xA;MIFG.ID_PRODUCTO AS ID_PRODUCTO ,--CAST(MIFG.PESO_VOLU_OPERA AS INT) AS PESO_VOLU_GUIA,&#xA;MIFG.NUMERO_PIEZAS AS NUMERO_PIEZAS,&#xA;CAST((FLETE + SOBRE_FLETE-DESCUENTO) AS INT) AS VALOR_FACTURADO,MIFG.FECHA_FACTURACION, NULL--MIFG.FECHA_ENVIO&#xA;,DIRECCION_ORG = CONVERT(VARCHAR(400),'') &#xA;,DIRECCION_DEST = CONVERT(VARCHAR(400),'')&#xA;FROM [tmp_borrar_LOCAL].[dbo].[MERF_INGRESO_FACTURADO] MIFG (NOLOCK)&#xA;INNER JOIN PARAMETROS.DBO.CLIENTES C  (NOLOCK) ON C.ID_PAIS=1 AND C.ID_CLIENTE=MIFG.ID_CLIENTE&#xA;INNER JOIN PARAMETROS.DBO.CIUDADES CIUO (NOLOCK) ON CIUO.ID_PAIS=1 AND CIUO.ID_CIUDAD=MIFG.ID_CIUDAD_ORIGEN&#xA;INNER JOIN PARAMETROS.DBO.CIUDADES CIUD (NOLOCK) ON CIUD.ID_PAIS=1 AND CIUD.ID_CIUDAD=MIFG.ID_CIUDAD_DESTINO&#xA;INNER JOIN Mece_Logistico.DBO.GUIAS G (NOLOCK) ON G.NUMERO_GUIA=MIFG.NUMERO_GUIA&#xA;INNER JOIN PARAMETROS.DBO.ESTADOSENVIO E (NOLOCK) ON  E.ID_ESTADOENVIO=G.ID_ESTADOENVIO&#xA;LEFT JOIN TMP_BORRAR_LOCAL.DBO.INFORMACION_GUIAS_RED_OPERATIVA TMPGUI (NOLOCK) ON TMPGUI.NUMERO_GUIA = MIFG.NUMERO_GUIA&#xA;WHERE TMPGUI.NUMERO_GUIA IS NULL AND MIFG.FECHA_FACTURACION &gt;=@FECH_INI_DT AND MIFG.FECHA_FACTURACION&lt;@FECH_FIN_DT&#xA;and MIFG.ID_FACTURADO=10&#xA;--AND MIFG.NOMBRE_PRODUCTO IN('DOCUMENTO UNITARIO','MERCANCIA PREMIER','MERCANCIA INDUSTRIAL','LOGISTICA DE INVERSA')&#xA;OPTION(RECOMPILE)&#xA;&#xA;UPDATE TMP_G SET TMP_G.FECHA_ENVIO=MIFG.FECHA_ENVIO&#xA;FROM #TMP_TABLA_FACTURADO TMP_G&#xA;INNER JOIN [tmp_borrar_LOCAL].[dbo].[MERF_INGRESO_FACTURADO] MIFG (NOLOCK) ON MIFG.NUMERO_GUIA=TMP_G.NUMERO_GUIA&#xA;WHERE MIFG.FECHA_FACTURACION &gt;=@FECH_INI_DT AND MIFG.FECHA_FACTURACION&lt;@FECH_FIN_DT&#xA;OPTION(RECOMPILE)&#xA;&#xA;INSERT INTO [tmp_borrar_local].[dbo].[DRW_TMP_COSTOS_POR_TRAYECTO_BI] &#xA;SELECT * FROM #TMP_TABLA_FACTURADO&#xA;OPTION(RECOMPILE)&#xA;&#xA;--select top 1000 * from TMP_BORRAR_LOCAL.DBO.TMP_TABLA_20250619 (nolock)&#xA;--where MEDIO_DE_PAGO='COD'--numero_guia=2201555949&#xA;--and VALOR_COMISION_VENTA_CDS&gt;0&#xA;--SELECT * FROM TMP_BORRAR_LOCAL.DBO.TMP_TABLA_20250421 (nolock)&#xA;--where DANE_ORIGEN_DESTINO  like '86571000 - 1%'&#xA;&#xA;&#xA;--select * from PARAMETROS.dbo.CIUDADES (NOLOCK)&#xA;--WHERE NOMBRE_CIUDAD LIKE '%CURILLO%'&#xA;&#xA;&#xA;--SELECT * FROM #TMP_TABLA_FACTURADO&#xA;--SELECT * FROM TMP_BORRAR_LOCAL.DBO.TMP_TABLA_20250421&#xA;--where NUMERO_GUIA=218656728&#xA;--WHERE PROPIETARIO_VEHICULO IS NULL&#xA;&#xA;&#xA;--CURRIER CICLA&quot;,&quot;INSOURCING CURRIER CICLA&quot;,&#xA;--           &quot;CURRIER A PIE&quot;,&quot;INSOURCING CURRIER A PIE&quot;,&#xA;--                &quot;INSOURCING CURRIER MOTO&#xA;&#xA;&#xA;--1 = 'INSOURCING'&#xA;--2 = 'COSOURCING'&#xA;--3 = 'OUTSOURCING FLETE FIJO'&#xA;--4 = 'OUTSOURCING CONDUCTOR PXP'&#xA;--5 = 'OUTSOURCING AUXILIAR PXP'&#xA;--6 = 'ULTIMA MILLA' &#xA;--7 ='INSOURCING CURRIER A PIE'&#xA;--8 ='INSOURCING CURRIER MOTO'&#xA;--9 ='INSOURCING CURRIER CICLA'&#xA;--10 ='COSTO EMPRESARIO SATELITE'&#xA;--11 = 'COSTO AEREO'&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::PERIODO_EJECUCION"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
