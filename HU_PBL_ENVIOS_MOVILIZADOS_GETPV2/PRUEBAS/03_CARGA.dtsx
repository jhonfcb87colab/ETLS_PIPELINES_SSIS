                <component
                  refId="Package\EXTRACCION\TRANSPORTE CONSULTA REDOPE MOV A FAC\SCRIPT RESULTANTE"
                  componentClassID="Microsoft.OLEDBSource"
                  contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                  description="OLE DB Source"
                  name="SCRIPT RESULTANTE"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT ---top 100 
PERIODO_EJECUCION
,NUMERO_GUIA
,CANAL
,NOMBRE_PRODUCTO
,MEDIO_DE_PAGO
,VALOR_RECAUDO
,VALOR_ENVIO
,NOMBRE_ESTADOENVIO
,ID_PROCESO
,NOMBRE_PROCESO_LOG
,PLACA_VEHICULO_DOCU
,TOTAL_AUXILIARES
,IDENTIFICACION_MOTO_CARRO_CURRIER_AEREO
,PROPIETARIO_VEHICULO
,MODELOS_DE_CONTRATACION_FLOTA
,ID_CIUDAD
,NOMBRE_CIUDAD
,FECHA_HORA_MOVIMIENTO
,TOTAL_GUIAS_RECOLECCION
,TOTAL_GUIAS_DISTRIBUCION
,TOTAL_DEVOLUCIONES
,PESO_FISICO_GUIA
,PESO_FISICO_OPERA_RECOLECCION
,PESO_FISICO_OPERA_DISTRIBUCION
,PESO_FISICO_OPERA_DEVOLUCION
,PESO_VOLU_OPERA_RECOLECCION
,PESO_VOLU_OPERA_DISTRIBUCION
,PESO_VOLUO_OPERA_DEVOLUCION
,TOTAL_PIEZAS_OPERA_RECOLECCION
,TOTAL_PIEZAS_OPERA_DISTRIBUCION
,TOTAL_PIEZAS_OPERA_DEVOLUCION
,MOVIMIENTOS_CROSS
,LLAVE_ORIGEN_DESTINO
,NOMBRE_TIPOTRAY
,NOMBRE_CLIENTE_CDS
,DANE_ORIGEN_DESTINO
,NOMBRE_ORIGEN_DESTINO
,NOMBRE_ZONA_DISTRIBUCION
,TIPO_OPERACION_VEHICULO
,KM_INSOURCING
,TIPO_CANAL
,CODIGO_CDS_PPES_DISTRIBUCION
,COMISION_DISTRIBUCION_EMPRESARIO
,MODO_ENTREGA_EMPRESARIO
,CODIGO_CDS_PPES_RECOLECCION
,COMISION_RECOLECCION_EMPRESARIO
,ID_REGIONAL
,NOMBRE_REGIONAL
,ID_AUXILIAR1_VEHICULO
,ID_AUXILIAR2_VEHICULO
,ID_COURIER_CONDUCTOR
,NOMBRE_ZONA_URBA
,ID_PRODUCTO
,PESO_VOLU_GUIA
,NUMERO_PIEZAS
,VALOR_FACTURADO
,ID_PRODUCTO_CST = CASE WHEN ID_PRODUCTO IN(1,52,24,65,55,11) THEN 1
						WHEN ID_PRODUCTO IN(2,6,59) THEN ID_PRODUCTO
						ELSE 2
						END	
--,FECHA_FACTURACION	
,FECHA_FACTURADO as FECHA_FACTURACION
,FECHA_ENVIO
,VALOR_COMISION_RECAUDO_EFECTY
,VALOR_COMISION_VENTA_CDS
,VALOR_ENVIO AS VALOR_LIQUIDADO
,VLT_RURAL_ORIG =   CASE 
							WHEN		DIRECCION_ORG  COLLATE Latin1_General_CI_AI LIKE '%vereda%'
									OR  DIRECCION_ORG  COLLATE Latin1_General_CI_AI LIKE '%vrd%'
									OR	DIRECCION_ORG  COLLATE Latin1_General_CI_AI LIKE '%vda%'    --- nueva
									OR	DIRECCION_ORG  COLLATE Latin1_General_CI_AI LIKE '%corregimiento%'
									OR	DIRECCION_ORG  COLLATE Latin1_General_CI_AI LIKE '%corr.%'    --- nueva
									OR	DIRECCION_ORG  COLLATE Latin1_General_CI_AI LIKE '%km%'
									OR	DIRECCION_ORG  COLLATE Latin1_General_CI_AI LIKE '%k m%'
									OR	DIRECCION_ORG  COLLATE Latin1_General_CI_AI LIKE '%kil_me%'
									OR	DIRECCION_ORG  COLLATE Latin1_General_CI_AI LIKE '%inspecci_n%'
									OR	DIRECCION_ORG  COLLATE Latin1_General_CI_AI LIKE '% v_a %'    --- modificado por tomar palabra BOLIVIA 
									OR	DIRECCION_ORG  COLLATE Latin1_General_CI_AI LIKE '%caser_o%'
									OR	DIRECCION_ORG  COLLATE Latin1_General_CI_AI LIKE '%paraje%'
									OR	DIRECCION_ORG  COLLATE Latin1_General_CI_AI LIKE '%finca%'
									OR	DIRECCION_ORG  COLLATE Latin1_General_CI_AI LIKE '%hacienda%'
									OR	DIRECCION_ORG  COLLATE Latin1_General_CI_AI LIKE '%parcela%'
									OR	DIRECCION_ORG  COLLATE Latin1_General_CI_AI LIKE '%predio%'
									OR	DIRECCION_ORG  COLLATE Latin1_General_CI_AI LIKE '%granja%'
									OR	DIRECCION_ORG  COLLATE Latin1_General_CI_AI LIKE '%resguardo%'
									OR	DIRECCION_ORG  COLLATE Latin1_General_CI_AI LIKE '%sector_rural%'
								THEN CONVERT(SMALLINT,  1) ELSE CONVERT(SMALLINT,  0)
							END 
,VLT_RURAL_DEST    =  CASE 
							WHEN		DIRECCION_DEST COLLATE Latin1_General_CI_AI LIKE '%vereda%'
									OR  DIRECCION_DEST COLLATE Latin1_General_CI_AI LIKE '%vrd%'
									OR	DIRECCION_DEST COLLATE Latin1_General_CI_AI LIKE '%vda%'    --- nueva
									OR	DIRECCION_DEST COLLATE Latin1_General_CI_AI LIKE '%corregimiento%'
									OR	DIRECCION_DEST COLLATE Latin1_General_CI_AI LIKE '%corr.%'    --- nueva
									OR	DIRECCION_DEST COLLATE Latin1_General_CI_AI LIKE '%km%'
									OR	DIRECCION_DEST COLLATE Latin1_General_CI_AI LIKE '%k m%'
									OR	DIRECCION_DEST COLLATE Latin1_General_CI_AI LIKE '%kil_me%'
									OR	DIRECCION_DEST COLLATE Latin1_General_CI_AI LIKE '%inspecci_n%'
									OR	DIRECCION_DEST COLLATE Latin1_General_CI_AI LIKE '% v_a %'    --- modificado por tomar palabra BOLIVIA 
									OR	DIRECCION_DEST COLLATE Latin1_General_CI_AI LIKE '%caser_o%'
									OR	DIRECCION_DEST COLLATE Latin1_General_CI_AI LIKE '%paraje%'
									OR	DIRECCION_DEST COLLATE Latin1_General_CI_AI LIKE '%finca%'
									OR	DIRECCION_DEST COLLATE Latin1_General_CI_AI LIKE '%hacienda%'
									OR	DIRECCION_DEST COLLATE Latin1_General_CI_AI LIKE '%parcela%'
									OR	DIRECCION_DEST COLLATE Latin1_General_CI_AI LIKE '%predio%'
									OR	DIRECCION_DEST COLLATE Latin1_General_CI_AI LIKE '%granja%'
									OR	DIRECCION_DEST COLLATE Latin1_General_CI_AI LIKE '%resguardo%'
									OR	DIRECCION_DEST COLLATE Latin1_General_CI_AI LIKE '%sector_rural%'
								THEN CONVERT(SMALLINT,  1) ELSE CONVERT(SMALLINT,  0)
							END 
FROM [tmp_borrar_local].[dbo].[DRW_TMP_COSTOS_POR_TRAYECTO_BI] (NOLOCK)
where ID_PROCESO&lt;&gt;14</property>
