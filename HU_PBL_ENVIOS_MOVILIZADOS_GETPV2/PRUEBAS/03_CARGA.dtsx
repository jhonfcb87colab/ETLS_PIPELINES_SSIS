    <DTS:Executable
      DTS:refId="Package\OBTENER TARIFAS LIQUIDACION PAGO PXP Y AFORADORES"
      DTS:CreationName="STOCK:SEQUENCE"
      DTS:Description="Sequence Container"
      DTS:Disabled="True"
      DTS:DTSID="{E8200A02-0100-420C-9294-B17CD2D45CFE}"
      DTS:ExecutableType="STOCK:SEQUENCE"
      DTS:LocaleID="-1"
      DTS:ObjectName="OBTENER TARIFAS LIQUIDACION PAGO PXP Y AFORADORES">
      <DTS:Variables />
      <DTS:Executables>
        <DTS:Executable
          DTS:refId="Package\OBTENER TARIFAS LIQUIDACION PAGO PXP Y AFORADORES\PREPARACION MANIFIESTOS DE LIQUIDACION PAGO PXP Y AFORADORES"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{03867485-EEF7-44A7-9517-6F0D1599768B}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="PREPARACION MANIFIESTOS DE LIQUIDACION PAGO PXP Y AFORADORES"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{542E6FD8-C0E9-4E1E-B7CB-5A76CEFD2FB3}"
              SQLTask:SqlStatementSource="&#xA;SET NOCOUNT ON;&#xA;&#xA;-- 1. Crear tabla temporal estructurada e indexada para búsqueda rápida&#xA;DROP TABLE IF EXISTS #GUIAS_PROCESOS_LIQUIDACION_PAGO_PRODUCTIVIDAD_TERCEROS_PS01;&#xA;&#xA;CREATE TABLE #GUIAS_PROCESOS_LIQUIDACION_PAGO_PRODUCTIVIDAD_TERCEROS_PS01 (&#xA;    ID INT IDENTITY(1,1) PRIMARY KEY,&#xA;    NUMERO_GUIA NUMERIC(20,0) NOT NULL,&#xA;    ID_PROCESO INT NOT NULL,&#xA;    FECHA_HORA_MOVIMIENTO DATE NOT NULL&#xA;);&#xA;&#xA;-- Insertar los datos base&#xA;INSERT INTO #GUIAS_PROCESOS_LIQUIDACION_PAGO_PRODUCTIVIDAD_TERCEROS_PS01 (NUMERO_GUIA, ID_PROCESO, FECHA_HORA_MOVIMIENTO)&#xA;SELECT &#xA;    NUMERO_GUIA,&#xA;    ID_PROCESO,&#xA;    CONVERT(DATE, FECHA_HORA_MOVIMIENTO)&#xA;FROM [tmp_borrar_local].[dbo].[DRW_TMP_COSTOS_POR_TRAYECTO_BI] WITH (NOLOCK)&#xA;WHERE ID_PROCESO IN (6, 9);&#xA;&#xA;-- Crear un índice compuesto en la temporal para acelerar el JOIN&#xA;CREATE NONCLUSTERED INDEX IX_TMP_PS01 &#xA;ON #GUIAS_PROCESOS_LIQUIDACION_PAGO_PRODUCTIVIDAD_TERCEROS_PS01 (NUMERO_GUIA, ID_PROCESO, FECHA_HORA_MOVIMIENTO);&#xA;&#xA;-- 2. Limpiar tabla destino&#xA;TRUNCATE TABLE [tmp_borrar_local].[dbo].[DRW_TMP_COSTOS_POR_TRAYECTO_BI_GUIAS_PROCESOS_MANIFISTOS_LIQUIDACION_PAGO_PRODUCTIVIDAD];&#xA;&#xA;-- 3. Bucle de inserción por Lotes basado en ID numérico (Evita borrar/volver a hacer JOINs)&#xA;DECLARE @LOTE INT = 1000; -- Incrementado a 50k para mejor rendimiento E/S&#xA;DECLARE @MIN_ID INT = 1;&#xA;DECLARE @MAX_ID_LOTE INT;&#xA;DECLARE @MAX_ID_TOTAL INT = (SELECT ISNULL(MAX(ID), 0) FROM #GUIAS_PROCESOS_LIQUIDACION_PAGO_PRODUCTIVIDAD_TERCEROS_PS01);&#xA;&#xA;WHILE @MIN_ID &lt;= @MAX_ID_TOTAL&#xA;BEGIN&#xA;    SET @MAX_ID_LOTE = @MIN_ID + @LOTE - 1;&#xA;&#xA;    INSERT INTO [tmp_borrar_local].[dbo].[DRW_TMP_COSTOS_POR_TRAYECTO_BI_GUIAS_PROCESOS_MANIFISTOS_LIQUIDACION_PAGO_PRODUCTIVIDAD]&#xA;    (&#xA;        NUMERO_GUIA,&#xA;        ID_PROCESO,&#xA;        CONSECUT_MOVIMI,&#xA;        NUMERO_MOVIMI&#xA;    )&#xA;    SELECT &#xA;        PS01.NUMERO_GUIA,&#xA;        SE.ID_PROCESO,&#xA;        SE.CONSECUT_MOVIMI,&#xA;        SE.NUMERO_MOVIMI&#xA;    FROM #GUIAS_PROCESOS_LIQUIDACION_PAGO_PRODUCTIVIDAD_TERCEROS_PS01 PS01 WITH (NOLOCK)&#xA;    INNER JOIN Mece_Logistico.DBO.SEGUIMIENTO_ENVIO SE WITH (NOLOCK)&#xA;        ON PS01.NUMERO_GUIA = SE.NUMERO_GUIA&#xA;        AND PS01.ID_PROCESO = SE.ID_PROCESO&#xA;        ---AND SE.FECHA_HORA_MOVIMIENTO=CONVERT(DATE,PS01.FECHA_HORA_MOVIMIENTO)&#xA;&#x9;&#x9;AND SE.FECHA_HORA_MOVIMIENTO &gt;= CAST(PS01.FECHA_HORA_MOVIMIENTO AS DATETIME)&#xA;        AND SE.FECHA_HORA_MOVIMIENTO &lt; DATEADD(DAY, 1, CAST(PS01.FECHA_HORA_MOVIMIENTO AS DATETIME))&#xA;    WHERE PS01.ID BETWEEN @MIN_ID AND @MAX_ID_LOTE&#xA;&#x9;----WHERE PS01.ID BETWEEN 1 AND 1000&#xA;&#x9;OPTION(RECOMPILE);&#xA;&#xA;&#x9;PRINT(CONCAT('INSERTCION REALIZADA DESDE - ',@MIN_ID,' / HASTA - ',@MAX_ID_LOTE))&#xA;&#xA;    SET @MIN_ID = @MAX_ID_LOTE + 1;&#xA;END;&#xA;&#xA;---12:02min&#xA;&#xA;;WITH CET AS (&#xA;SELECT &#xA;NUMERO_GUIA&#xA;,ID_PROCESO&#xA;,CONSECUT_MOVIMI&#xA;,NUMERO_MOVIMI&#xA;,ROWID = ROW_NUMBER() OVER(PARTITION  BY &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;NUMERO_GUIA&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;,ID_PROCESO&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;,CONSECUT_MOVIMI&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;,NUMERO_MOVIMI ORDER BY CONSECUT_MOVIMI DESC)&#xA;FROM [tmp_borrar_local].[dbo].[DRW_TMP_COSTOS_POR_TRAYECTO_BI_GUIAS_PROCESOS_MANIFISTOS_LIQUIDACION_PAGO_PRODUCTIVIDAD]&#xA;)--------SELECT * FROM CET WHERE ROWID &gt; 1&#xA;DELETE CET WHERE ROWID &gt; 1&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
