          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{F23E2E5D-51C2-489D-BF93-33ABA46592D1}"
              SQLTask:SqlStatementSource="UPDATE T01 SET T01.NOMBRE_CLIENTE_CDS='800194600-CORPORACION COLOMBIANA DE INVESTIGACION AGROPECUARIA - AGROSAVIA'   FROM SIG_COLOMBIA_DW.TMP.COSTO_DARWIN_BASE_OPERACION_MES&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;T01 WHERE NOMBRE_CLIENTE_CDS LIKE '%CORPORACION COLOMBIANA%DE%INVESTIGACION%AGROPECUARIA%' &#xA;&#xA;&#xA;UPDATE T01 SET T01.NOMBRE_CLIENTE_CDS='2970299-RADIANCE SEA HONG KONG LIMITED - TEMU'   FROM SIG_COLOMBIA_DW.TMP.COSTO_DARWIN_BASE_OPERACION_MES&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;    T01 WHERE NOMBRE_CLIENTE_CDS LIKE '%RADIANCE%TEMU%' &#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\EXTRACCION\AJUSTES ERROR DIGITACION DE PESOS"
