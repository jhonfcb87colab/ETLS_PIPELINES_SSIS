                <component
                  refId="Package\OBTENER TARIFAS LIQUIDACION PAGO PXP Y AFORADORES\TRANSPORTE BI COSTO_DARWIN_BASE_LIQUIDACIONES PXP AFORO\MANIFIESTOS Y LIQUIDACIONES"
                  componentClassID="Microsoft.OLEDBSource"
                  contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                  description="OLE DB Source"
                  name="MANIFIESTOS Y LIQUIDACIONES"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">;WITH CTE AS( 
SELECT  ---TOP 100
SEG.CONSECUTIVO_SEGUIMIENTO,
SEG.ID_PROCESO,
SEG.NUMERO_MOVIMI,
SEG.CONSECUT_MOVIMI,
SEG.NUMERO_GUIA,
SEG.FECHA_MANIFESTADO
--SEG.NUMERO_PIEZAS,
--SER.CONSECUTIVO_TIPO_SERVICIO,		-- 1-Recoleccion, 2-Distribución, 3-Transporte, 4-Otros (peaje), 5-Servicios adicionales
--SER.CONSECUTIVO_SERVICIO,
FROM Mece_Logistico.DBO.SEGUIMIENTO_ENVIO_LIQUIDACION_PAGO_PRODUCTIVIDAD_TERCEROS SEG  (NOLOCK)
INNER JOIN [tmp_borrar_local].[dbo].[DRW_TMP_COSTOS_POR_TRAYECTO_BI_GUIAS_PROCESOS_MANIFISTOS_LIQUIDACION_PAGO_PRODUCTIVIDAD] TMP (NOLOCK) 
ON 	TMP.NUMERO_GUIA=SEG.NUMERO_GUIA
AND TMP.ID_PROCESO=SEG.ID_PROCESO
AND TMP.CONSECUT_MOVIMI=SEG.CONSECUT_MOVIMI
AND TMP.NUMERO_MOVIMI=SEG.NUMERO_MOVIMI
)
SELECT 
SEG.CONSECUTIVO_SEGUIMIENTO,
SEG.ID_PROCESO,
SEG.NUMERO_MOVIMI,
SEG.CONSECUT_MOVIMI,
SEG.NUMERO_GUIA,
MAX(SEG.FECHA_MANIFESTADO) AS FECHA_MOVIMIENTO,
SUM(SER.VALOR_TARIFA_SERVICIO) AS VALOR_PRODUCTIVIDAD_TERCERO
FROM CTE SEG
INNER JOIN Mece_Logistico.DBO.SERVICIOS_SEGUIMIENTO_ENVIO_LIQUIDACION_PAGO_PRODUCTIVIDAD_TERCEROS SER (NOLOCK) 
ON SEG.CONSECUTIVO_SEGUIMIENTO = SER.CONSECUTIVO_SEGUIMIENTO
GROUP BY SEG.ID_PROCESO,SEG.NUMERO_MOVIMI,SEG.CONSECUT_MOVIMI,SEG.NUMERO_GUIA,SEG.CONSECUTIVO_SEGUIMIENTO</property>
