    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{5DAE1BC1-09AE-431B-AD87-2E03324AD764}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot;&#xA;DECLARE @FECHA_I DATETIME, @FECHA_INI DATETIME, @FECHA_FIN DATETIME, @FECHA_MANUAL DATETIME&#xA;&#xA;SET @FECHA_MANUAL = '2017-04-01 00:00:00.000' --SE CAMBIA LA FECHA DEL 01/09/2016 POR 01/04/2017, YA QUE EL CAMBIO APLICA SOLO DESDE ABRIL 2017 &#xA;SET @FECHA_I =       '&quot;+ @[User::STR_FECHA_INI] +&quot;'; &#xA;SET @FECHA_FIN =  '&quot;+ @[User::STR_FECHA_FIN]    +&quot;';&#xA;&#xA;--SET @FECHA_I = CONVERT(DATETIME,CONVERT(CHAR(11),?)) ;&#xA;--SET @FECHA_FIN = CONVERT(DATETIME,CONVERT(CHAR(11),?))  ;&#xA;&#xA;IF @FECHA_I &gt;= @FECHA_MANUAL&#xA;&#x9;BEGIN&#xA;&#x9;&#x9;SET @FECHA_INI = @FECHA_I&#xA;&#x9;END&#xA;ELSE&#xA;&#x9;BEGIN&#xA;&#x9;&#x9;SET @FECHA_INI = @FECHA_MANUAL&#xA;&#x9;END&#xA;&#xA;&#xA;;WITH SEGUIMI_ENVIO AS (&#xA;&#x9;SELECT&#x9;MIN(FECHA_HORA_MOVIMIENTO) AS FECHA_HORA_MOVIMIENTO, NUMERO_GUIA&#xA;&#x9;FROM MECE_LOGISTICO.DBO.SEGUIMIENTO_ENVIO  WITH (NOLOCK)&#xA;&#x9;WHERE FECHA_HORA_MOVIMIENTO &gt;=  @FECHA_INI &#x9;&#x9;&#xA;&#x9;&#x9;AND FECHA_HORA_MOVIMIENTO &lt;  @FECHA_FIN&#x9;&#x9;&#xA;&#x9;&#x9;AND ID_PROCESO IN (5,6) &#xA;&#x9;GROUP BY NUMERO_GUIA&#xA;)&#xA;&#xA;SELECT --CONVERT(NUMERIC,CONVERT(DATETIME,CONVERT(CHAR(11),GUIAS.FECHA_ENVIO)))AS TIMEID,&#xA;&#x9;&#x9;--GUIAS.FECHA_ENVIO, --AS FECHA, --CONVERT(DATETIME,CONVERT(CHAR(11),GUIAS.FECHA_ENVIO))AS FECHA,&#xA;&#x9;&#x9;SE_FECH.FECHA_HORA_MOVIMIENTO,&#xA;&#x9;&#x9;GUIAS.ID_PAIS_ORIGEN, --ISNULL(GUIAS.ID_PAIS_ORIGEN,0) AS ID_PAIS_ORIGEN,&#xA;&#x9;&#x9;GUIAS.ID_CIUDAD_ORIGEN, --ISNULL(GUIAS.ID_CIUDAD_ORIGEN,0) AS ID_CIUDAD_ORIGEN,&#xA;&#x9;&#x9;GUIAS.ID_PAIS_DESTINO, --ISNULL(GUIAS.ID_PAIS_DESTINO,0) AS ID_PAIS_DESTINO,&#xA;&#x9;&#x9;GUIAS.ID_CIUDAD_DESTINO, --ISNULL(GUIAS.ID_CIUDAD_DESTINO,0) AS ID_CIUDAD_DESTINO,&#xA;&#x9;&#x9;GUIAS.ID_TIPOGUIA, --ISNULL(GUIAS.ID_TIPOGUIA,0) AS ID_TIPOGUIA,&#xA;&#x9;&#x9;GUIAS.ID_CLIENTE, --ISNULL(GUIAS.ID_CLIENTE,0) AS ID_CLIENTE,&#xA;&#x9;&#x9;GUIAS.ID_ESTADOENVIO, --ISNULL(GUIAS.ID_ESTADOENVIO,0) AS ID_ESTADOENVIO,&#xA;&#x9;&#x9;GUIAS.ID_DOCU_ULT_MOVI, --ISNULL(GUIAS.ID_DOCU_ULT_MOVI,0) AS   ID_PROCESO,&#xA;&#x9;&#x9;GUIAS.ID_MEDTRANS, --ISNULL(GUIAS.ID_MEDTRANS,0) AS ID_MEDTRANS,&#xA;&#x9;&#x9;GUIAS.ID_PRODUCTO, --ISNULL(GUIAS.ID_PRODUCTO,0) AS ID_PRODUCTO,&#xA;&#x9;&#x9;GUIAS.ID_SUBPRODUCTO, --ISNULL(GUIAS.ID_SUBPRODUCTO,0) AS ID_SUBPRODUCTO,&#xA;&#x9;&#x9;GUIAS.ID_ESTADOGUIA, --ISNULL(GUIAS.ID_ESTADOGUIA,0) AS ID_ESTADOGUIA,&#xA;&#x9;&#x9;GUIAS.ID_TIEMPO AS ID_TIEMPO_ENTREGA, --ISNULL(GUIAS.ID_TIEMPO,0) AS ID_TIEMPO_ENTREGA,&#xA;&#x9;&#x9;GUIAS.ID_REQUIERE_EMBALAJE AS ID_REQ_EMBALAJE, --ISNULL(GUIAS.ID_REQUIERE_EMBALAJE,0) AS ID_REQ_EMBALAJE,&#xA;&#x9;&#x9;GUIAS.NUMERO_GUIA, --COUNT(DISTINCT GUIAS.NUMERO_GUIA) AS CANTIDAD_GUIAS,&#xA;&#x9;&#x9;GUIAS.NUMERO_PIEZAS, --SUM(CASE WHEN ISNULL(GUIAS.NUMERO_PIEZAS,0) = 0 THEN 1 ELSE GUIAS.NUMERO_PIEZAS END) AS CANTIDAD_PIEZAS,&#xA;&#x9;&#x9;GUIAS.FECHA_ENTREGA, --ISNULL(DATEDIFF(MI,GUIAS.FECHA_ENTREGA,GUIAS.FECHA_MODIFICACION),0) AS TIEMPO_DIGITALIZACION,&#xA;&#x9;&#x9;GUIAS.FECHA_MODIFICACION&#xA;&#x9;&#x9;--ISNULL((DATEDIFF(HH,FECHA_ENVIO,FECHA_ENTREGA)),0) AS TIEMPO_PROMESA_H&#xA;FROM &#x9;MECE_LOGISTICO.DBO.GUIAS GUIAS WITH (NOLOCK, INDEX(UK_GUIA)  )&#xA;&#x9;&#x9;INNER JOIN&#x9;SEGUIMI_ENVIO AS SE_FECH  &#xA;&#x9;&#x9;&#x9;ON SE_FECH.NUMERO_GUIA = GUIAS.NUMERO_GUIA --SE.NUMERO_GUIA = SE_FECH.NUMERO_GUIA&#xA;&#x9;&#x9;WHERE GUIAS.ID_DOCU_ULT_MOVI &gt;= 4 -- ID_PROCESO&#xA;OPTION (RECOMPILE)&#xA;&quot;"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="DG">
      <DTS:VariableValue
        DTS:DataType="8">
DECLARE @FECHA_I DATETIME, @FECHA_INI DATETIME, @FECHA_FIN DATETIME, @FECHA_MANUAL DATETIME

SET @FECHA_MANUAL = '2017-04-01 00:00:00.000' --SE CAMBIA LA FECHA DEL 01/09/2016 POR 01/04/2017, YA QUE EL CAMBIO APLICA SOLO DESDE ABRIL 2017 
SET @FECHA_I =       '20260907'; 
SET @FECHA_FIN =  '20260918';

--SET @FECHA_I = CONVERT(DATETIME,CONVERT(CHAR(11),?)) ;
--SET @FECHA_FIN = CONVERT(DATETIME,CONVERT(CHAR(11),?))  ;

IF @FECHA_I &gt;= @FECHA_MANUAL
	BEGIN
		SET @FECHA_INI = @FECHA_I
	END
ELSE
	BEGIN
		SET @FECHA_INI = @FECHA_MANUAL
	END


;WITH SEGUIMI_ENVIO AS (
	SELECT	MIN(FECHA_HORA_MOVIMIENTO) AS FECHA_HORA_MOVIMIENTO, NUMERO_GUIA
	FROM MECE_LOGISTICO.DBO.SEGUIMIENTO_ENVIO  WITH (NOLOCK)
	WHERE FECHA_HORA_MOVIMIENTO &gt;=  @FECHA_INI 		
		AND FECHA_HORA_MOVIMIENTO &lt;  @FECHA_FIN		
		AND ID_PROCESO IN (5,6) 
	GROUP BY NUMERO_GUIA
)

SELECT --CONVERT(NUMERIC,CONVERT(DATETIME,CONVERT(CHAR(11),GUIAS.FECHA_ENVIO)))AS TIMEID,
		--GUIAS.FECHA_ENVIO, --AS FECHA, --CONVERT(DATETIME,CONVERT(CHAR(11),GUIAS.FECHA_ENVIO))AS FECHA,
		SE_FECH.FECHA_HORA_MOVIMIENTO,
		GUIAS.ID_PAIS_ORIGEN, --ISNULL(GUIAS.ID_PAIS_ORIGEN,0) AS ID_PAIS_ORIGEN,
		GUIAS.ID_CIUDAD_ORIGEN, --ISNULL(GUIAS.ID_CIUDAD_ORIGEN,0) AS ID_CIUDAD_ORIGEN,
		GUIAS.ID_PAIS_DESTINO, --ISNULL(GUIAS.ID_PAIS_DESTINO,0) AS ID_PAIS_DESTINO,
		GUIAS.ID_CIUDAD_DESTINO, --ISNULL(GUIAS.ID_CIUDAD_DESTINO,0) AS ID_CIUDAD_DESTINO,
		GUIAS.ID_TIPOGUIA, --ISNULL(GUIAS.ID_TIPOGUIA,0) AS ID_TIPOGUIA,
		GUIAS.ID_CLIENTE, --ISNULL(GUIAS.ID_CLIENTE,0) AS ID_CLIENTE,
		GUIAS.ID_ESTADOENVIO, --ISNULL(GUIAS.ID_ESTADOENVIO,0) AS ID_ESTADOENVIO,
		GUIAS.ID_DOCU_ULT_MOVI, --ISNULL(GUIAS.ID_DOCU_ULT_MOVI,0) AS   ID_PROCESO,
		GUIAS.ID_MEDTRANS, --ISNULL(GUIAS.ID_MEDTRANS,0) AS ID_MEDTRANS,
		GUIAS.ID_PRODUCTO, --ISNULL(GUIAS.ID_PRODUCTO,0) AS ID_PRODUCTO,
		GUIAS.ID_SUBPRODUCTO, --ISNULL(GUIAS.ID_SUBPRODUCTO,0) AS ID_SUBPRODUCTO,
		GUIAS.ID_ESTADOGUIA, --ISNULL(GUIAS.ID_ESTADOGUIA,0) AS ID_ESTADOGUIA,
		GUIAS.ID_TIEMPO AS ID_TIEMPO_ENTREGA, --ISNULL(GUIAS.ID_TIEMPO,0) AS ID_TIEMPO_ENTREGA,
		GUIAS.ID_REQUIERE_EMBALAJE AS ID_REQ_EMBALAJE, --ISNULL(GUIAS.ID_REQUIERE_EMBALAJE,0) AS ID_REQ_EMBALAJE,
		GUIAS.NUMERO_GUIA, --COUNT(DISTINCT GUIAS.NUMERO_GUIA) AS CANTIDAD_GUIAS,
		GUIAS.NUMERO_PIEZAS, --SUM(CASE WHEN ISNULL(GUIAS.NUMERO_PIEZAS,0) = 0 THEN 1 ELSE GUIAS.NUMERO_PIEZAS END) AS CANTIDAD_PIEZAS,
		GUIAS.FECHA_ENTREGA, --ISNULL(DATEDIFF(MI,GUIAS.FECHA_ENTREGA,GUIAS.FECHA_MODIFICACION),0) AS TIEMPO_DIGITALIZACION,
		GUIAS.FECHA_MODIFICACION
		--ISNULL((DATEDIFF(HH,FECHA_ENVIO,FECHA_ENTREGA)),0) AS TIEMPO_PROMESA_H
FROM 	MECE_LOGISTICO.DBO.GUIAS GUIAS WITH (NOLOCK, INDEX(UK_GUIA)  )
		INNER JOIN	SEGUIMI_ENVIO AS SE_FECH  
			ON SE_FECH.NUMERO_GUIA = GUIAS.NUMERO_GUIA --SE.NUMERO_GUIA = SE_FECH.NUMERO_GUIA
		WHERE GUIAS.ID_DOCU_ULT_MOVI &gt;= 4 -- ID_PROCESO
OPTION (RECOMPILE)
</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{EB9AE67E-CEF8-4F14-826D-13D0A1AAB869}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot;&#xA;DECLARE @FECHA_I DATETIME, @FECHA_INI DATETIME, @FECHA_FIN DATETIME, @FECHA_MANUAL DATETIME&#xA;&#xA;SET @FECHA_MANUAL = '2017-04-01 00:00:00.000' --SE CAMBIA LA FECHA DEL 01/09/2016 POR 01/04/2017, YA QUE EL CAMBIO APLICA SOLO DESDE ABRIL 2017 &#xA;SET @FECHA_I =       '&quot;+ @[User::STR_FECHA_INI] +&quot;'; &#xA;SET @FECHA_FIN =  '&quot;+ @[User::STR_FECHA_FIN]    +&quot;';&#xA;&#xA;&#xA;--SET @FECHA_I = CONVERT(DATETIME,CONVERT(CHAR(11),?)) ;&#xA;--SET @FECHA_FIN = CONVERT(DATETIME,CONVERT(CHAR(11),?))  ;&#xA;&#xA;IF @FECHA_I &gt;= @FECHA_MANUAL&#xA;&#x9;BEGIN&#xA;&#x9;&#x9;SET @FECHA_INI = @FECHA_I&#xA;&#x9;END&#xA;ELSE&#xA;&#x9;BEGIN&#xA;&#x9;&#x9;SET @FECHA_INI = @FECHA_MANUAL&#xA;&#x9;END&#xA;&#xA;&#xA;;WITH SEGUIMI_ENVIO AS (&#xA;&#x9;SELECT&#x9;MIN(FECHA_HORA_MOVIMIENTO) AS FECHA_HORA_MOVIMIENTO, NUMERO_GUIA&#xA;&#x9;FROM MECE_LOGISTICO.DBO.SEGUIMIENTO_ENVIO  WITH (NOLOCK)&#xA;&#x9;WHERE FECHA_HORA_MOVIMIENTO &gt;=  @FECHA_INI &#x9;&#x9;&#xA;&#x9;&#x9;AND FECHA_HORA_MOVIMIENTO &lt;  @FECHA_FIN&#x9;&#x9;&#xA;&#x9;&#x9;AND ID_PROCESO IN (5,6) &#xA;&#x9;GROUP BY NUMERO_GUIA&#xA;)&#xA;&#xA;SELECT --CONVERT(NUMERIC,CONVERT(DATETIME,CONVERT(CHAR(11),GUIAS.FECHA_ENVIO)))AS TIMEID,&#xA;&#x9;&#x9;--GUIAS.FECHA_ENVIO, --AS FECHA, --CONVERT(DATETIME,CONVERT(CHAR(11),GUIAS.FECHA_ENVIO))AS FECHA,&#xA;&#x9;&#x9;SE_FECH.FECHA_HORA_MOVIMIENTO,&#xA;&#x9;&#x9;GUIAS.ID_PAIS_ORIGEN, --ISNULL(GUIAS.ID_PAIS_ORIGEN,0) AS ID_PAIS_ORIGEN,&#xA;&#x9;&#x9;GUIAS.ID_CIUDAD_ORIGEN, --ISNULL(GUIAS.ID_CIUDAD_ORIGEN,0) AS ID_CIUDAD_ORIGEN,&#xA;&#x9;&#x9;GUIAS.ID_PAIS_DESTINO, --ISNULL(GUIAS.ID_PAIS_DESTINO,0) AS ID_PAIS_DESTINO,&#xA;&#x9;&#x9;GUIAS.ID_CIUDAD_DESTINO, --ISNULL(GUIAS.ID_CIUDAD_DESTINO,0) AS ID_CIUDAD_DESTINO,&#xA;&#x9;&#x9;GUIAS.ID_TIPOGUIA, --ISNULL(GUIAS.ID_TIPOGUIA,0) AS ID_TIPOGUIA,&#xA;&#x9;&#x9;GUIAS.ID_CLIENTE, --ISNULL(GUIAS.ID_CLIENTE,0) AS ID_CLIENTE,&#xA;&#x9;&#x9;GUIAS.ID_ESTADOENVIO, --ISNULL(GUIAS.ID_ESTADOENVIO,0) AS ID_ESTADOENVIO,&#xA;&#x9;&#x9;GUIAS.ID_DOCU_ULT_MOVI, --ISNULL(GUIAS.ID_DOCU_ULT_MOVI,0) AS   ID_PROCESO,&#xA;&#x9;&#x9;GUIAS.ID_MEDTRANS, --ISNULL(GUIAS.ID_MEDTRANS,0) AS ID_MEDTRANS,&#xA;&#x9;&#x9;GUIAS.ID_PRODUCTO, --ISNULL(GUIAS.ID_PRODUCTO,0) AS ID_PRODUCTO,&#xA;&#x9;&#x9;GUIAS.ID_SUBPRODUCTO, --ISNULL(GUIAS.ID_SUBPRODUCTO,0) AS ID_SUBPRODUCTO,&#xA;&#x9;&#x9;GUIAS.ID_ESTADOGUIA, --ISNULL(GUIAS.ID_ESTADOGUIA,0) AS ID_ESTADOGUIA,&#xA;&#x9;&#x9;GUIAS.ID_TIEMPO AS ID_TIEMPO_ENTREGA, --ISNULL(GUIAS.ID_TIEMPO,0) AS ID_TIEMPO_ENTREGA,&#xA;&#x9;&#x9;GUIAS.ID_REQUIERE_EMBALAJE AS ID_REQ_EMBALAJE, --ISNULL(GUIAS.ID_REQUIERE_EMBALAJE,0) AS ID_REQ_EMBALAJE,&#xA;&#x9;&#x9;GUIAS.NUMERO_GUIA, --COUNT(DISTINCT GUIAS.NUMERO_GUIA) AS CANTIDAD_GUIAS,&#xA;&#x9;&#x9;GUIAS.NUMERO_PIEZAS, --SUM(CASE WHEN ISNULL(GUIAS.NUMERO_PIEZAS,0) = 0 THEN 1 ELSE GUIAS.NUMERO_PIEZAS END) AS CANTIDAD_PIEZAS,&#xA;&#x9;&#x9;GUIAS.FECHA_ENTREGA, --ISNULL(DATEDIFF(MI,GUIAS.FECHA_ENTREGA,GUIAS.FECHA_MODIFICACION),0) AS TIEMPO_DIGITALIZACION,&#xA;&#x9;&#x9;GUIAS.FECHA_MODIFICACION&#xA;&#x9;&#x9;--ISNULL((DATEDIFF(HH,FECHA_ENVIO,FECHA_ENTREGA)),0) AS TIEMPO_PROMESA_H&#xA;FROM &#x9;MECE_LOGISTICO.DBO.GUIAS GUIAS WITH (NOLOCK )&#xA;&#x9;&#x9;INNER JOIN&#x9;SEGUIMI_ENVIO AS SE_FECH  &#xA;&#x9;&#x9;&#x9;ON SE_FECH.NUMERO_GUIA = GUIAS.NUMERO_GUIA --SE.NUMERO_GUIA = SE_FECH.NUMERO_GUIA&#xA;&#x9;&#x9;WHERE GUIAS.ID_DOCU_ULT_MOVI &gt;= 4 -- ID_PROCESO&#xA;OPTION ( RECOMPILE )&#xA;&quot;"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="MCP">
      <DTS:VariableValue
        DTS:DataType="8">
DECLARE @FECHA_I DATETIME, @FECHA_INI DATETIME, @FECHA_FIN DATETIME, @FECHA_MANUAL DATETIME

SET @FECHA_MANUAL = '2017-04-01 00:00:00.000' --SE CAMBIA LA FECHA DEL 01/09/2016 POR 01/04/2017, YA QUE EL CAMBIO APLICA SOLO DESDE ABRIL 2017 
SET @FECHA_I =       '20260907'; 
SET @FECHA_FIN =  '20260918';


--SET @FECHA_I = CONVERT(DATETIME,CONVERT(CHAR(11),?)) ;
--SET @FECHA_FIN = CONVERT(DATETIME,CONVERT(CHAR(11),?))  ;

IF @FECHA_I &gt;= @FECHA_MANUAL
	BEGIN
		SET @FECHA_INI = @FECHA_I
	END
ELSE
	BEGIN
		SET @FECHA_INI = @FECHA_MANUAL
	END


;WITH SEGUIMI_ENVIO AS (
	SELECT	MIN(FECHA_HORA_MOVIMIENTO) AS FECHA_HORA_MOVIMIENTO, NUMERO_GUIA
	FROM MECE_LOGISTICO.DBO.SEGUIMIENTO_ENVIO  WITH (NOLOCK)
	WHERE FECHA_HORA_MOVIMIENTO &gt;=  @FECHA_INI 		
		AND FECHA_HORA_MOVIMIENTO &lt;  @FECHA_FIN		
		AND ID_PROCESO IN (5,6) 
	GROUP BY NUMERO_GUIA
)

SELECT --CONVERT(NUMERIC,CONVERT(DATETIME,CONVERT(CHAR(11),GUIAS.FECHA_ENVIO)))AS TIMEID,
		--GUIAS.FECHA_ENVIO, --AS FECHA, --CONVERT(DATETIME,CONVERT(CHAR(11),GUIAS.FECHA_ENVIO))AS FECHA,
		SE_FECH.FECHA_HORA_MOVIMIENTO,
		GUIAS.ID_PAIS_ORIGEN, --ISNULL(GUIAS.ID_PAIS_ORIGEN,0) AS ID_PAIS_ORIGEN,
		GUIAS.ID_CIUDAD_ORIGEN, --ISNULL(GUIAS.ID_CIUDAD_ORIGEN,0) AS ID_CIUDAD_ORIGEN,
		GUIAS.ID_PAIS_DESTINO, --ISNULL(GUIAS.ID_PAIS_DESTINO,0) AS ID_PAIS_DESTINO,
		GUIAS.ID_CIUDAD_DESTINO, --ISNULL(GUIAS.ID_CIUDAD_DESTINO,0) AS ID_CIUDAD_DESTINO,
		GUIAS.ID_TIPOGUIA, --ISNULL(GUIAS.ID_TIPOGUIA,0) AS ID_TIPOGUIA,
		GUIAS.ID_CLIENTE, --ISNULL(GUIAS.ID_CLIENTE,0) AS ID_CLIENTE,
		GUIAS.ID_ESTADOENVIO, --ISNULL(GUIAS.ID_ESTADOENVIO,0) AS ID_ESTADOENVIO,
		GUIAS.ID_DOCU_ULT_MOVI, --ISNULL(GUIAS.ID_DOCU_ULT_MOVI,0) AS   ID_PROCESO,
		GUIAS.ID_MEDTRANS, --ISNULL(GUIAS.ID_MEDTRANS,0) AS ID_MEDTRANS,
		GUIAS.ID_PRODUCTO, --ISNULL(GUIAS.ID_PRODUCTO,0) AS ID_PRODUCTO,
		GUIAS.ID_SUBPRODUCTO, --ISNULL(GUIAS.ID_SUBPRODUCTO,0) AS ID_SUBPRODUCTO,
		GUIAS.ID_ESTADOGUIA, --ISNULL(GUIAS.ID_ESTADOGUIA,0) AS ID_ESTADOGUIA,
		GUIAS.ID_TIEMPO AS ID_TIEMPO_ENTREGA, --ISNULL(GUIAS.ID_TIEMPO,0) AS ID_TIEMPO_ENTREGA,
		GUIAS.ID_REQUIERE_EMBALAJE AS ID_REQ_EMBALAJE, --ISNULL(GUIAS.ID_REQUIERE_EMBALAJE,0) AS ID_REQ_EMBALAJE,
		GUIAS.NUMERO_GUIA, --COUNT(DISTINCT GUIAS.NUMERO_GUIA) AS CANTIDAD_GUIAS,
		GUIAS.NUMERO_PIEZAS, --SUM(CASE WHEN ISNULL(GUIAS.NUMERO_PIEZAS,0) = 0 THEN 1 ELSE GUIAS.NUMERO_PIEZAS END) AS CANTIDAD_PIEZAS,
		GUIAS.FECHA_ENTREGA, --ISNULL(DATEDIFF(MI,GUIAS.FECHA_ENTREGA,GUIAS.FECHA_MODIFICACION),0) AS TIEMPO_DIGITALIZACION,
		GUIAS.FECHA_MODIFICACION
		--ISNULL((DATEDIFF(HH,FECHA_ENVIO,FECHA_ENTREGA)),0) AS TIEMPO_PROMESA_H
FROM 	MECE_LOGISTICO.DBO.GUIAS GUIAS WITH (NOLOCK )
		INNER JOIN	SEGUIMI_ENVIO AS SE_FECH  
			ON SE_FECH.NUMERO_GUIA = GUIAS.NUMERO_GUIA --SE.NUMERO_GUIA = SE_FECH.NUMERO_GUIA
		WHERE GUIAS.ID_DOCU_ULT_MOVI &gt;= 4 -- ID_PROCESO
OPTION ( RECOMPILE )
</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{ECDD90FB-C0DC-47AE-8264-00CB18D05C88}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="(DT_DATE)@[$Project::FULL_FACH_FIN]  ==  (DT_DATE) &quot;1900-01-01&quot; ? &#xA;((DT_WSTR,4)YEAR(DATEADD(&quot;DD&quot;,  1  , GETDATE()))+&quot;&quot;&#xA;+RIGHT(&quot;0&quot;+(DT_WSTR,2)MONTH(DATEADD(&quot;DD&quot;,  1  ,GETDATE() )),2)+&quot;&quot;&#xA;+RIGHT(&quot;0&quot;+(DT_WSTR,2)DAY(DATEADD(&quot;DD&quot;,  1  ,GETDATE() )),2))&#xA;&#xA;:  (DT_STR, 4, 1252) YEAR( (DT_DATE)@[$Project::FULL_FACH_FIN] ) + RIGHT(&quot;0&quot; + (DT_STR, 2, 1252) MONTH(  (DT_DATE)@[$Project::FULL_FACH_FIN]   ), 2)  +  RIGHT(&quot;0&quot; + (DT_STR, 2, 1252) DAY(   (DT_DATE)@[$Project::FULL_FACH_FIN]   ), 2)"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="STR_FECHA_FIN">
      <DTS:VariableValue
        DTS:DataType="8">20260918</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{32D7EBB7-74F3-4F0B-9E6D-B21F7387BA5C}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="(DT_DATE)@[$Project::FULL_FACH_INI]    == (DT_DATE) &quot;1900-01-01&quot; ? &#xA;((DT_WSTR,4)YEAR(DATEADD(&quot;DD&quot;, -@[$Project::DiaIni], GETDATE()))+&quot;&quot;&#xA;+RIGHT(&quot;0&quot;+(DT_WSTR,2)MONTH(DATEADD(&quot;DD&quot;,-@[$Project::DiaIni],GETDATE() )),2)+&quot;&quot;&#xA;+RIGHT(&quot;0&quot;+(DT_WSTR,2)DAY(DATEADD(&quot;DD&quot;, -@[$Project::DiaIni],GETDATE() )),2))&#xA;&#xA;:  (DT_STR, 4, 1252) YEAR( (DT_DATE) @[$Project::FULL_FACH_INI] ) + RIGHT(&quot;0&quot; + (DT_STR, 2, 1252) MONTH(  (DT_DATE) @[$Project::FULL_FACH_INI]   ), 2)  +  RIGHT(&quot;0&quot; + (DT_STR, 2, 1252) DAY(   (DT_DATE) @[$Project::FULL_FACH_INI]   ), 2)"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="STR_FECHA_INI">
      <DTS:VariableValue
        DTS:DataType="8">20260907</DTS:VariableValue>
    </DTS:Variable>
  </DTS:Variables>
  <DTS:Executables>
    <DTS:Executable
      DTS:refId="Package\CONSULTAS A USAR"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:Disabled="True"
      DTS:DTSID="{14de2ea2-3f42-4512-86b1-a3d62ffe316c}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="CONSULTAS A USAR"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="1">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{4F729CB6-2753-4B35-BAA4-C83F6B9DBA42}"
          SQLTask:SqlStatementSource="&#xA;--CONEXIÓIN A DESARRROLLO BI&#xA;USE SIG_COLOMBIA_DW;&#xA;&#xA;TRUNCATE TABLE [TMP].[ENVIOS_MOV_SOURCE_DG];&#xA;TRUNCATE TABLE [TMP].[ENVIOS_MOV_SOURCE_CILS];&#xA;&#xA;--- Valida el numero de registros&#xA;SELECT COUNT(1) FROM [TMP].[ENVIOS_MOV_SOURCE_DG]&#xA;SELECT COUNT(1) FROM [TMP].[ENVIOS_MOV_SOURCE_CILS]&#xA;&#xA;&#xA;--- VALIDAR NUMERO DE PIEZAS &#xA;SELECT SUM(NUMERO_PIEZAS) CANT_PIEZ FROM [TMP].[ENVIOS_MOV_SOURCE_DG]&#xA;SELECT SUM(NUMERO_PIEZAS) CANT_PIEZ FROM [TMP].[ENVIOS_MOV_SOURCE_CILS]&#xA;&#xA;&#xA;--- Valida diferencias entre piezas y guias&#xA;SELECT 'DG' AS TBL,   CONVERT(DATE, FECHA_HORA_MOVIMIENTO) AS FHM, SUM(NUMERO_PIEZAS) CANT_PIEZ, COUNT(NUMERO_GUIA) AS CANT_GUIAS &#xA;FROM [TMP].[ENVIOS_MOV_SOURCE_DG] GROUP BY CONVERT(DATE, FECHA_HORA_MOVIMIENTO) -- ORDER BY 2  &#xA;UNION&#xA;SELECT 'MUCIPIOS' AS TBL, CONVERT(DATE, FECHA_HORA_MOVIMIENTO) AS FHM, SUM(NUMERO_PIEZAS) CANT_PIEZ, COUNT(NUMERO_GUIA) AS TT &#xA;FROM [TMP].[ENVIOS_MOV_SOURCE_CILS] GROUP BY CONVERT(DATE, FECHA_HORA_MOVIMIENTO) ORDER BY 2&#xA;&#xA;&#xA;&#xA;&#xA;-- MUESTRA DATOS DE DIFERENCIA ENTRE NUMERO DE GUIAS, PIEZAS &#xA;SELECT  DG.FECHA_HORA_MOVIMIENTO AS DG_FECHA_HORA_MOVIMIENTO,  CL.FECHA_HORA_MOVIMIENTO AS MCP_FECHA_HORA_MOVIMIENTO,&#xA;CL.NUMERO_GUIA AS MCP_NUMERO_GUIA, DG.NUMERO_GUIA AS DG_NUMERO_GUIA, &#xA;DG.NUMERO_PIEZAS AS DG_NUMERO_PIEZAS, CL.NUMERO_PIEZAS AS MCP_NUMERO_PIEZAS &#xA;FROM  [TMP].[ENVIOS_MOV_SOURCE_CILS] CL  WITH(NOLOCK) &#xA;LEFT JOIN      [TMP].[ENVIOS_MOV_SOURCE_DG] DG  WITH(NOLOCK)&#xA;ON CL.NUMERO_GUIA = DG.NUMERO_GUIA &#xA;WHERE  LEN(CL.NUMERO_GUIA) &gt; 7  AND&#xA;--DG.FECHA_HORA_MOVIMIENTO &gt;=  CONVERT(DATETIME, '2025-10-01') AND DG.FECHA_HORA_MOVIMIENTO &lt; CONVERT(DATETIME, '2025-10-02') AND&#xA; -- DG.NUMERO_PIEZAS &lt;&gt; CL.NUMERO_PIEZAS   -- AND   --&#xA; DG.NUMERO_GUIA IS NULL&#xA;ORDER BY  1 &#xA;&#xA;---------------------&#xA;-- El siguiente es para consultar las guias del paso anterior &#xA;-- tanto en DG como en  CILS (municipios)&#xA;-- SERV-DBMCP&#xA;-- LSTSSDGN&#xA;&#xA;&#xA;----------------- CONEXIÓN A PRODUCCIÓN ----------------------------&#xA;--Siguiente es para consultar las guias del paso anterior en los servidores DG y MUNICIPIOS&#xA;select NUMERO_GUIA, ID_PROCESO, NUMERO_MOVIMI, CONSECUT_MOVIMI from .SEGUIMIENTO_ENVIO as se&#xA;where ID_PROCESO IN (5,6)  AND NUMERO_GUIA = 2241378159&#xA;order by FECHA_HORA_MOVIMIENTO&#xA;&#xA; &#xA;------------OTRAS CONSULTAS----------------------&#xA;--- TOMA LAS GUIAS QUE NO SE HAN MIGRADO A DG&#xA;SELECT distinct CLS.NUMERO_GUIA AS CLS_NUMERO_GUIA, DG.NUMERO_GUIA AS DG_NUMERO_GUIA , CLS.NUMERO_PIEZAS AS CLS_NUMERO_PIEZAS, DG.NUMERO_PIEZAS AS DG_NUMERO_PIEZAS&#xA;, CONCAT(',''', CONVERT(VARCHAR(25), CLS.NUMERO_GUIA) , '''') &#xA;FROM [TMP].[ENVIOS_MOV_SOURCE_CILS] AS CLS &#xA;LEFT JOIN [TMP].[ENVIOS_MOV_SOURCE_DG] AS DG ON CLS.NUMERO_GUIA = DG.NUMERO_GUIA&#xA;WHERE LEN(CLs.NUMERO_GUIA) &gt; 7  AND DG.NUMERO_GUIA IS NULL&#xA;ORDER BY 3 DESC&#xA;&#xA;&#xA;&#xA;--- MUSETRA diferencias entre piezas &#xA;SELECT CLS.NUMERO_GUIA, CLS.NUMERO_PIEZAS AS CLS_NUMERO_PIEZAS,DG.NUMERO_PIEZAS AS DG_NUMERO_PIEZAS&#xA;FROM [TMP].[ENVIOS_MOV_SOURCE_CILS] AS CLS &#xA;LEFT JOIN [TMP].[ENVIOS_MOV_SOURCE_DG] AS DG ON CLS.NUMERO_GUIA = DG.NUMERO_GUIA&#xA;WHERE CLS.NUMERO_PIEZAS &lt;&gt; DG.NUMERO_PIEZAS&#xA;&#xA;-- GUIAS CON REPORTE EN PIEZAS DISTINTAS&#xA;SELECT  SUM( CLS.NUMERO_PIEZAS) AS CLS_NUMERO_PIEZAS, SUM(DG.NUMERO_PIEZAS) AS DG_NUMERO_PIEZAS&#xA;FROM [TMP].[ENVIOS_MOV_SOURCE_CILS] AS CLS &#xA;LEFT JOIN [TMP].[ENVIOS_MOV_SOURCE_DG] AS DG ON CLS.NUMERO_GUIA = DG.NUMERO_GUIA&#xA;WHERE CLS.NUMERO_PIEZAS &lt;&gt; DG.NUMERO_PIEZAS&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
