      DTS:DTSID="{51361974-65C6-4DA7-8F4E-27FA4826F762}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="EST_VALIDA_TBL_tempdb"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="1">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{A5058BCF-F4DA-41C5-99AF-FFC63E378DF9}"
          SQLTask:SqlStatementSource="USE tempdb; &#xA;&#xA;IF OBJECT_ID(N'dbo.BI_ENVIOS_MOV_CREACION_TABLA', N'P') IS NULL&#xA;BEGIN&#xA;    EXEC(N'&#xA;&#x9;&#x9;CREATE PROCEDURE dbo.BI_ENVIOS_MOV_CREACION_TABLA &#xA;&#x9;&#x9;AS&#xA;&#x9;&#x9;BEGIN&#xA;&#xA;&#x9;&#x9;IF OBJECT_ID(''tempdb.dbo.GUIAS_ENVIOS_MOV'') IS NOT NULL &#xA;&#x9;&#x9;&#x9;DROP TABLE tempdb.dbo.GUIAS_ENVIOS_MOV;&#xA;&#xA;&#x9;&#x9;&#x9;CREATE TABLE [dbo].[GUIAS_ENVIOS_MOV](&#xA;&#x9;&#x9;&#x9;&#x9;[FECHA_HORA_MOVIMIENTO] [datetime] NULL,&#xA;&#x9;&#x9;&#x9;&#x9;[ID_PAIS_ORIGEN] [smallint] NULL,&#xA;&#x9;&#x9;&#x9;&#x9;[ID_CIUDAD_ORIGEN] [int] NULL,&#xA;&#x9;&#x9;&#x9;&#x9;[ID_PAIS_DESTINO] [smallint] NULL,&#xA;&#x9;&#x9;&#x9;&#x9;[ID_CIUDAD_DESTINO] [int] NULL,&#xA;&#x9;&#x9;&#x9;&#x9;[ID_TIPOGUIA] [tinyint] NOT NULL,&#xA;&#x9;&#x9;&#x9;&#x9;[ID_CLIENTE] [char](20) NULL,&#xA;&#x9;&#x9;&#x9;&#x9;[ID_ESTADOENVIO] [tinyint] NULL,&#xA;&#x9;&#x9;&#x9;&#x9;[ID_DOCU_ULT_MOVI] [smallint] NULL,&#xA;&#x9;&#x9;&#x9;&#x9;[ID_MEDTRANS] [tinyint] NULL,&#xA;&#x9;&#x9;&#x9;&#x9;[ID_PRODUCTO] [smallint] NULL,&#xA;&#x9;&#x9;&#x9;&#x9;[ID_SUBPRODUCTO] [smallint] NULL,&#xA;&#x9;&#x9;&#x9;&#x9;[ID_ESTADOGUIA] [tinyint] NULL,&#xA;&#x9;&#x9;&#x9;&#x9;[ID_TIEMPO_ENTREGA] [tinyint] NULL,&#xA;&#x9;&#x9;&#x9;&#x9;[ID_REQ_EMBALAJE] [tinyint] NULL,&#xA;&#x9;&#x9;&#x9;&#x9;[NUMERO_GUIA] [numeric](20, 0) NOT NULL,&#xA;&#x9;&#x9;&#x9;&#x9;[NUMERO_PIEZAS] [smallint] NULL,&#xA;&#x9;&#x9;&#x9;&#x9;[FECHA_ENTREGA] [datetime] NULL,&#xA;&#x9;&#x9;&#x9;&#x9;[FECHA_MODIFICACION] [datetime] NULL&#xA;&#x9;&#x9;&#x9;);&#xA;&#xA;&#xA;&#x9;&#x9;IF OBJECT_ID(''tempdb.[dbo].[CODIGOS_POSTALES_NACIONALES]'') IS NOT NULL &#xA;&#x9;&#x9;&#x9;DROP TABLE tempdb.[dbo].[CODIGOS_POSTALES_NACIONALES];&#xA;&#xA;&#x9;&#x9;&#x9;CREATE TABLE tempdb.[dbo].[CODIGOS_POSTALES_NACIONALES](&#xA;&#x9;&#x9;&#x9;&#x9;[CODIGO_DEPARTAMENTO] [varchar](2) NULL,&#xA;&#x9;&#x9;&#x9;&#x9;[NOMBRE_DEPARTAMENTO] [varchar](50) NULL,&#xA;&#x9;&#x9;&#x9;&#x9;[CODIGO_MUNICIPIO] [varchar](8) NULL,&#xA;&#x9;&#x9;&#x9;&#x9;[NOMBRE_MUNICIPIO] [varchar](50) NULL,&#xA;&#x9;&#x9;&#x9;&#x9;[ZONA_POSTAL] [varchar](8) NULL,&#xA;&#x9;&#x9;&#x9;&#x9;[CODIGO_POSTAL] [varchar](9) NULL,&#xA;&#x9;&#x9;&#x9;&#x9;[LIMITE_NORTE] [varchar](200) NULL,&#xA;&#x9;&#x9;&#x9;&#x9;[LIMITE_SUR] [varchar](200) NULL,&#xA;&#x9;&#x9;&#x9;&#x9;[LIMITE_ESTE] [varchar](200) NULL,&#xA;&#x9;&#x9;&#x9;&#x9;[LIMITE_OESTE] [varchar](200) NULL,&#xA;&#x9;&#x9;&#x9;&#x9;[TIPO] [varchar](15) NULL,&#xA;&#x9;&#x9;&#x9;&#x9;[BARRIOS_CONTENIDOS_EN_EL_CODIGO_POSTAL] [nvarchar](255) NULL,&#xA;&#x9;&#x9;&#x9;&#x9;[VEREDAS_CONTENIDAS_EN_EL_CODIGO_POSTAL] [nvarchar](255) NULL&#xA;&#x9;&#x9;&#x9;); &#xA;&#xA;&#x9;&#x9;END;&#xA;    ');&#xA;&#xA;&#xA;END;&#xA;&#xA; EXEC dbo.BI_ENVIOS_MOV_CREACION_TABLA ;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
