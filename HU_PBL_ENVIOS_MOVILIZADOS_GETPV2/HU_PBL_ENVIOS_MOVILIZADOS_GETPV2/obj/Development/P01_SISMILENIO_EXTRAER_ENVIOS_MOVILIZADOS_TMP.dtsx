        <DTS:Executable
          DTS:refId="Package\Contenedor de secuencias\ACTUALIZAR ID_TIPO_GUIA_FORMATO_IMPRESION"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Tarea Ejecutar SQL"
          DTS:DTSID="{649877cb-5017-4212-87a1-08eb72e42dff}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="ACTUALIZAR ID_TIPO_GUIA_FORMATO_IMPRESION"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="1">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{1A253EB5-4DE4-4327-87B8-C48B5E79D3EE}"
              SQLTask:SqlStatementSource="use SIG_COL_LOGISTICA_DW;&#xA;WITH CTE AS (&#xA;SELECT &#xA;ROW_NUMBER ( )   OVER ( PARTITION BY EV.[NUMERO_GUIA] order by IMPRE.[ID_TIPO_FORMATO_IMPRESION] desc )  ROWid  &#xA;,EV.[NUMERO_GUIA]&#xA;      ,IMPRE.[ID_TIPO_FORMATO_IMPRESION]&#xA;  FROM [SIG_COL_LOGISTICA_DW].[TMP].[GUIAMA_ENV_MOV_TIPO_GUIA_IMPRESION] IMPRE WITH(NOLOCK)&#xA;  RIGHT JOIN [TMP].[ENVIOS_MOV] EV WITH(NOLOCK) ON EV.NUMERO_GUIA=IMPRE.NUMERO_GUIA&#xA;  )&#xA;  ---SELECT TMP.NUMERO_GUIA,&#xA;  UPDATE TMP SET&#xA;  ID_TIPO_FORMATO_IMPRESION=ISNULL(C.ID_TIPO_FORMATO_IMPRESION,-888)&#xA;  FROM [SIG_COL_LOGISTICA_DW].[TMP].[ENVIOS_MOV] TMP WITH(NOLOCK)&#xA;  LEFT JOIN   CTE C &#xA;  ON TMP.NUMERO_GUIA = C.NUMERO_GUIA&#xA;  WHERE C.ROWid=1" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Contenedor de secuencias\CAPRTURA TIPO IMPRESION SISCLINET"
          DTS:CreationName="Microsoft.Pipeline"
          DTS:Description="Data Flow Task"
          DTS:DTSID="{82991996-6c13-4e72-af5a-5d409df552f9}"
          DTS:ExecutableType="Microsoft.Pipeline"
          DTS:LocaleID="-1"
          DTS:ObjectName="CAPRTURA TIPO IMPRESION SISCLINET"
          DTS:TaskContact="Performs high-performance data extraction, transformation and loading;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1">
          <DTS:Variables />
          <DTS:ObjectData>
            <pipeline
              version="1">
              <components>
                <component
                  refId="Package\Contenedor de secuencias\CAPRTURA TIPO IMPRESION SISCLINET\DATOS SISCLINET"
                  componentClassID="Microsoft.OLEDBSource"
                  contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                  description="OLE DB Source"
                  name="DATOS SISCLINET"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=15.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">WITH CTW01 AS
(SELECT EV.NUMERO_GUIA FROM SIG_COL_LOGISTICA_DW.TMP.ENVIOS_MOV EV WITH (NOLOCK) GROUP BY EV.NUMERO_GUIA),
CTE02 AS (
		SELECT 
		ROW_NUMBER ( )   OVER ( PARTITION BY SCN.[Num_Guia] order by SCN.[fecha_reimpresion] desc )  ROWid, 
			  SCN.[Num_Guia]
			  ,SCN.[Id_formato_impresion]
			  ,SCN.[Id_formato_reimpresion]
			  ,SCN.[fecha_reimpresion]
		  FROM [SIG_COLOMBIA_DW].[SCN].[SERT_ENVIO] SCN WITH(NOLOCK)
                                       
		  INNER JOIN CTW01 GTEMP
		  ON GTEMP.NUMERO_GUIA=SCN.Num_Guia
)
SELECT 
	Num_Guia AS NUMERO_GUIA
	,ID_TIPO_FORMATO_IMPRESION =
	CASE 
	WHEN Id_formato_reimpresion IS NULL AND Id_formato_impresion IS NULL THEN 0
	WHEN fecha_reimpresion IS NULL THEN Id_formato_impresion
	WHEN Id_formato_impresion IS NULL THEN Id_formato_reimpresion
	WHEN Id_formato_reimpresion IS NULL THEN Id_formato_impresion
	ELSE Id_formato_reimpresion END
	--,Id_formato_impresion	
	--,Id_formato_reimpresion	
	--,fecha_reimpresion
FROM CTE02 WHERE ROWid=1













