            <component
              refId="Package\TRANSFORMACION DATA ZONA GEO\OLE DB Source"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
              description="OLE DB Source"
              name="OLE DB Source"
              usesDispositions="true"
              validateExternalMetadata="False"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=15.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT 	MIN(FECHA_HORA_MOVIMIENTO) AS FECHA,
		ID_PAIS_ORIGEN, --ISNULL(GUIAS.ID_PAIS_ORIGEN,0) AS ID_PAIS_ORIGEN,
		ID_CIUDAD_ORIGEN, --ISNULL(GUIAS.ID_CIUDAD_ORIGEN,0) AS ID_CIUDAD_ORIGEN,
		ID_PAIS_DESTINO, --ISNULL(GUIAS.ID_PAIS_DESTINO,0) AS ID_PAIS_DESTINO,
		G_ID_CIUDAD_DESTINO, 
		ID_CIUDAD_DESTINO, --ISNULL(GUIAS.ID_CIUDAD_DESTINO,0) AS ID_CIUDAD_DESTINO,
		ID_TIPOGUIA, --ISNULL(GUIAS.ID_TIPOGUIA,0) AS ID_TIPOGUIA,
		ID_CLIENTE, --ISNULL(GUIAS.ID_CLIENTE,0) AS ID_CLIENTE,
		ID_ESTADOENVIO, --ISNULL(GUIAS.ID_ESTADOENVIO,0) AS ID_ESTADOENVIO,
		ID_DOCU_ULT_MOVI, --ISNULL(GUIAS.ID_DOCU_ULT_MOVI,0) AS   ID_PROCESO,
		ID_MEDTRANS, --ISNULL(GUIAS.ID_MEDTRANS,0) AS ID_MEDTRANS,
		ID_PRODUCTO, --ISNULL(GUIAS.ID_PRODUCTO,0) AS ID_PRODUCTO,
		ID_SUBPRODUCTO, --ISNULL(GUIAS.ID_SUBPRODUCTO,0) AS ID_SUBPRODUCTO,
		ID_ESTADOGUIA, --ISNULL(GUIAS.ID_ESTADOGUIA,0) AS ID_ESTADOGUIA,
		ID_TIEMPO_ENTREGA, --ISNULL(GUIAS.ID_TIEMPO,0) AS ID_TIEMPO_ENTREGA,
		ID_REQ_EMBALAJE, --ISNULL(GUIAS.ID_REQUIERE_EMBALAJE,0) AS ID_REQ_EMBALAJE,
		NUMERO_GUIA, --COUNT(DISTINCT GUIAS.NUMERO_GUIA) AS CANTIDAD_GUIAS,
		NUMERO_PIEZAS, --SUM(CASE WHEN ISNULL(GUIAS.NUMERO_PIEZAS,0) = 0 THEN 1 ELSE GUIAS.NUMERO_PIEZAS END) AS CANTIDAD_PIEZAS,
		FECHA_ENTREGA, --ISNULL(DATEDIFF(MI,GUIAS.FECHA_ENTREGA,GUIAS.FECHA_MODIFICACION),0) AS TIEMPO_DIGITALIZACION,
		FECHA_MODIFICACION
		--ISNULL((DATEDIFF(HH,FECHA_ENVIO,FECHA_ENTREGA)),0) AS TIEMPO_PROMESA_H 
		,CONVERT( VARCHAR(15), IIF([SIG_COLOMBIA_DW].dbo.ObtenerCodigo_zona(ID_PRODUCTO,ISNULL(CODIGOS_ZONA_REMITE,'')) = ''
			, 'NO DISPONIBLE', [SIG_COLOMBIA_DW].dbo.ObtenerCodigo_zona(ID_PRODUCTO,ISNULL(CODIGOS_ZONA_REMITE,'')) 
		 )) as ID_CODIGO_ZONA_ORIG
		,CONVERT( VARCHAR(15), IIF([SIG_COLOMBIA_DW].dbo.ObtenerCodigo_zona(ID_PRODUCTO,ISNULL(ID_CODIGO_ZONA_DEST,'')) = ''
			, 'NO DISPONIBLE', [SIG_COLOMBIA_DW].dbo.ObtenerCodigo_zona(ID_PRODUCTO,ISNULL(ID_CODIGO_ZONA_DEST,'')) 
		 )) as ID_CODIGO_ZONA_DEST
		 ,VLT_RURAL_ORIG
		 ,VLT_RURAL_DEST
		 ,GU_ID_TIPO_TRAYECTO
		--,CODIGOS_ZONA_REMITE
		--,CODIGOS_ZONA_DESTINO

FROM  [TMP].[ENVIOS_MOV_SOURCE]  WHIT(NOLOCK)
WHERE	
		 (	(LEFT(NUMERO_GUIA,1) IN (1,2,5,7,9) AND LEN(NUMERO_GUIA) &gt;= 9) 
				OR (LEFT(NUMERO_GUIA,1) IN (3,4) AND LEN(NUMERO_GUIA) &gt;= 8) 
			)
GROUP BY ID_PAIS_ORIGEN, 
		ID_CIUDAD_ORIGEN,
		ID_PAIS_DESTINO, 
		G_ID_CIUDAD_DESTINO,    -- cam
		ID_CIUDAD_DESTINO,
		ID_TIPOGUIA,
		ID_CLIENTE, 
		ID_ESTADOENVIO,
		ID_DOCU_ULT_MOVI,
		ID_MEDTRANS,
		ID_PRODUCTO,
		ID_SUBPRODUCTO,
		ID_ESTADOGUIA, 
		ID_TIEMPO_ENTREGA,
		ID_REQ_EMBALAJE,
		NUMERO_GUIA,
		NUMERO_PIEZAS,
		FECHA_ENTREGA,
		FECHA_MODIFICACION
		,CODIGOS_ZONA_REMITE      -- ID_CODIGO_ZONA_ORIG
		,ID_CODIGO_ZONA_DEST
		,VLT_RURAL_ORIG
		,VLT_RURAL_DEST
		,GU_ID_TIPO_TRAYECTO
		--,CODIGOS_ZONA_REMITE
		--,CODIGOS_ZONA_DESTINO</property>
