    <DTS:Executable
      DTS:refId="Package\DATOS EXTRACCION DG"
      DTS:CreationName="Microsoft.Pipeline"
      DTS:DelayValidation="True"
      DTS:Description="Data Flow Task"
      DTS:DTSID="{9B4363EC-D477-4B5C-BD94-658E65C8B35A}"
      DTS:ExecutableType="Microsoft.Pipeline"
      DTS:LocaleID="-1"
      DTS:ObjectName="DATOS EXTRACCION DG"
      DTS:TaskContact="Performs high-performance data extraction, transformation and loading;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1">
      <DTS:Variables />
      <DTS:ObjectData>
        <pipeline
          defaultBufferMaxRows="100000"
          defaultBufferSize="10480000"
          version="1">
          <components>
            <component
              refId="Package\DATOS EXTRACCION DG\CONSULTA DG"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
              description="OLE DB Source"
              name="CONSULTA DG"
              usesDispositions="true"
              validateExternalMetadata="False"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=15.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">/** Se validad campos de zona origen y destino, se tiene en cuenta que presente devolución **/
    SELECT 		
		G.FECHA_HORA_MOVIMIENTO,
		G.ID_PAIS_ORIGEN, 
		G.ID_CIUDAD_ORIGEN, 
		G.ID_PAIS_DESTINO,
		G.ID_CIUDAD_DESTINO AS G_ID_CIUDAD_DESTINO,
	-- Condición para ID CIUDAD DESTINO - modificación
		--IIF(SC.APLICA_REMITENTE_DESTINATARIO IN (1, 2),SC.APLICA_REMITENTE_DESTINATARIO, 0 )  APLICA_REMITENTE_DESTINATARIO,
		CASE 
			WHEN SC.APLICA_REMITENTE_DESTINATARIO = 1 THEN  COALESCE( C.ID_CIUDAD_NUEVO, G.ID_CIUDAD_ORIGEN)
			WHEN SC.APLICA_REMITENTE_DESTINATARIO = 2 THEN  C.ID_CIUDAD_NUEVO
			ELSE G.ID_CIUDAD_DESTINO
		END AS ID_CIUDAD_DESTINO,
		G.ID_TIPOGUIA, 
		G.ID_CLIENTE,  
		G.ID_ESTADOENVIO, 
		G.ID_DOCU_ULT_MOVI,
		G.ID_MEDTRANS, 
		G.ID_PRODUCTO, 
		G.ID_SUBPRODUCTO,
		G.ID_ESTADOGUIA, 
		G.ID_TIEMPO_ENTREGA, 
		G.ID_REQ_EMBALAJE, 
		G.NUMERO_GUIA, 
		G.NUMERO_PIEZAS, 
		G.FECHA_ENTREGA, 
		G.FECHA_MODIFICACION,
		COALESCE( CDG.CAPA_REMITE, ANT.CODIGOS_ZONA_REMITE) AS CODIGOS_ZONA_REMITE,
		VLT_RURAL_DEST,
		VLT_RURAL_ORIG,
		-- Condición para codigos zona destino
		CASE 
			WHEN SC.APLICA_REMITENTE_DESTINATARIO = 1 THEN COALESCE( COALESCE( COALESCE(LC.CODIGO_ZONA_CONFIRMA, A.CODIGO_ZONA_CONFIRMA), ANT.CODIGOS_ZONA_REMITE), CDG.CAPA_REMITE)
			WHEN SC.APLICA_REMITENTE_DESTINATARIO = 2 THEN COALESCE( COALESCE(LC.CODIGO_ZONA_CONFIRMA, A.CODIGO_ZONA_CONFIRMA), CDG.CAPA_DESTINA)
			ELSE  COALESCE( CDG.CAPA_DESTINA  , ANT.CODIGOS_ZONA_DESTINO )
		END AS CODIGOS_ZONA_DESTINO,
		CASE 
			WHEN SC.APLICA_REMITENTE_DESTINATARIO = 1 THEN COALESCE( COALESCE( COALESCE(LC.CODIGO_ZONA_CONFIRMA, A.CODIGO_ZONA_CONFIRMA), ANT.CODIGOS_ZONA_REMITE), CDG.CAPA_REMITE)
			WHEN SC.APLICA_REMITENTE_DESTINATARIO = 2 THEN COALESCE( COALESCE(LC.CODIGO_ZONA_CONFIRMA, A.CODIGO_ZONA_CONFIRMA), CDG.CAPA_DESTINA)
			ELSE COALESCE( CDG.CAPA_DESTINA  ,  ANT.CODIGO_ZONA )
		END AS CODIGOS_ZONA,
		TT.ID_TIPOTRAY AS GU_ID_TIPO_TRAYECTO

    FROM TEMPDB.DBO.GUIAS_ENVIOS_MOV  G
	LEFT JOIN Mece_Logistico.DBO.COORDENADAS_DIRECCIONES_GUIA AS CDG  WITH(NOLOCK)
		ON G.NUMERO_GUIA = CDG.NUMERO_GUIA -- AND G.ID_CIUDAD_DESTINO =  CDG.ID_CIUDAD_DESTINO AND G.ID_CIUDAD_ORIGEN = CDG.ID_CIUDAD_REMITE
	LEFT JOIN MECE_LOGISTICO.DBO.GUIAS_INF_ANTICIPADA ANT WITH(NOLOCK)
        ON G.NUMERO_GUIA = ANT.NUMERO_GUIA AND G.ID_CIUDAD_DESTINO = ANT.ID_CIUDAD_DESTINO
 OUTER APPLY (
				SELECT TOP 1 * 
				FROM MECE_LOGISTICO.DBO.CONFIRMACIONES C1 WITH(NOLOCK)
				WHERE C1.NUMERO_GUIA = G.NUMERO_GUIA
				ORDER BY C1.NUMERO_CONFIRMACION DESC
			) AS C	-- ON C.NUMERO_GUIA = G.NUMERO_GUIA 
    LEFT JOIN PARAMETROS..SOLUCIONESCONFIRMACIONES SC
        ON C.ID_SOLUCION = SC.ID_SOLUCION AND SC.ID_EST_SOLUCION = 1
    LEFT JOIN MECE_LOGISTICO.DBO.GUIAS_INF_ADICIONAL A WITH(NOLOCK)
        ON G.NUMERO_GUIA = A.NUMERO_GUIA
 OUTER APPLY (
				SELECT TOP 1 * 
				FROM Seguridad..LOG_GEO_CONFIRMACIONES AS LC1   (nolock)
				WHERE LC1.NUMERO_GUIA  = G.NUMERO_GUIA 
				ORDER BY LC1.FECHA_REGISTRO DESC
			) AS LC
INNER JOIN 	PARAMETROS.[dbo].RED_OPERATIVA_CONSOLIDADA_TRAYECTOS RO WITH(NOLOCK)
ON 
	G.ID_CIUDAD_ORIGEN = RO.ID_CIUDAD_ORIGEN
AND
	G.ID_CIUDAD_DESTINO = RO.ID_CIUDAD_DESTINO
INNER JOIN
    PARAMETROS.[dbo].TIPOTRAYECTO TT WITH(NOLOCK)
ON
    RO.ID_TIPOTRAY = TT.ID_TIPOTRAY
WHERE
    G.ID_PAIS_ORIGEN = 1
AND
    G.ID_PAIS_DESTINO = 1

;</property>
