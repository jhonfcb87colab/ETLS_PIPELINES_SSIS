                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=15.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">;WITH CTE01 AS (
			SELECT EVMO.NUMERO_GUIA
			FROM SIG_COL_LOGISTICA_DW.TMP.ENVIOS_MOV EVMO WITH (NOLOCK) GROUP BY EVMO.NUMERO_GUIA
)
SELECT 
EV.NUMERO_GUIA,
I.DocumentRetailTypeId AS ID_TIPO_FORMATO_IMPRESION
FROM CTE01 EV WITH (NOLOCK)
INNER JOIN SIG_COLOMBIA_DW.[RTW].[GUIDE] G WITH(NOLOCK) ON EV.NUMERO_GUIA=G.NUMBER
--INNER JOIN SIG_COLOMBIA_DW.[RTW].[Shipping] S WITH(NOLOCK) ON s.guideid=G.Id
INNER JOIN SIG_COLOMBIA_DW.[RTW].[InvoiceDetail] ID WITH(NOLOCK) ON G.InvoiceDetailId=ID.ID-----InvoiceId
INNER JOIN SIG_COLOMBIA_DW.[RTW].Invoice I WITH(NOLOCK) ON I.Id=ID.InvoiceId
where I.DocumentRetailTypeId is not null




/*
;WITH CTE01 AS (
			SELECT EVMO.NUMERO_GUIA
			FROM SIG_COL_LOGISTICA_DW.TMP.ENVIOS_MOV EVMO WITH (NOLOCK) GROUP BY EVMO.NUMERO_GUIA
)
SELECT 
EV.NUMERO_GUIA,
I.DocumentRetailTypeId AS ID_TIPO_FORMATO_IMPRESION
FROM CTE01 EV WITH (NOLOCK)
INNER JOIN SIG_COLOMBIA_DW.[RTW].[GUIDE] G WITH(NOLOCK) ON EV.NUMERO_GUIA=G.NUMBER
INNER JOIN SIG_COLOMBIA_DW.[RTW].[Shipping] S WITH(NOLOCK) ON s.guideid=G.Id
INNER JOIN SIG_COLOMBIA_DW.[RTW].[InvoiceDetail] ID WITH(NOLOCK) ON G.InvoiceDetailId=ID.InvoiceId
INNER JOIN SIG_COLOMBIA_DW.[RTW].Invoice I WITH(NOLOCK) ON I.Id=ID.InvoiceId
where I.DocumentRetailTypeId is not null
*/
/*
SELECT 
EV.NUMERO_GUIA,
I.DocumentRetailTypeId AS ID_TIPO_FORMATO_IMPRESION
FROM SIG_COL_LOGISTICA_DW.TMP.ENVIOS_MOV EV WITH (NOLOCK)
INNER JOIN SIG_COLOMBIA_DW.[RTW].[GUIDE] G WITH(NOLOCK) ON EV.NUMERO_GUIA=G.NUMBER
