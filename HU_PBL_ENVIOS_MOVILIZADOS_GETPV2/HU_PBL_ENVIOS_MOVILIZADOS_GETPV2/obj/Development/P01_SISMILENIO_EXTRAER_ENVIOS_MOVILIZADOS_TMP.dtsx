INNER JOIN SIG_COLOMBIA_DW.[RTW].[InvoiceDetail] ID WITH(NOLOCK) ON G.InvoiceDetailId=ID.InvoiceId
INNER JOIN SIG_COLOMBIA_DW.[RTW].Invoice I WITH(NOLOCK) ON I.Id=ID.InvoiceId
*/</property>
