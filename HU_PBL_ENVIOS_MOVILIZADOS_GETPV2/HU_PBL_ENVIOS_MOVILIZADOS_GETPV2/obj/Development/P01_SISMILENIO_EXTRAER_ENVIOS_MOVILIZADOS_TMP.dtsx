      DTS:ObjectName="FechaIni">
      <DTS:VariableValue
        DTS:DataType="7">9/7/2026</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{5F41CD7B-64AA-421D-BC49-3AA13472DF9B}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="(DT_WSTR, 10)&#xA;( &#xA;&#x9;(&#xA;&#x9;&#x9;(&#xA;&#x9;&#x9;&#x9;(  YEAR( @[User::FechaFin] )*100 )   &#xA;&#x9;&#x9;&#x9;+&#xA;&#x9;&#x9;&#x9;(  MONTH( @[User::FechaFin] )  )&#xA;&#x9;&#x9;)*100&#xA;&#x9;)+ DAY( @[User::FechaFin] )&#xA;)"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="STR_FechaFin">
      <DTS:VariableValue
        DTS:DataType="8">20260918</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{6FE5AFCA-D489-4AC4-A186-335BB5875F0F}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="(DT_WSTR, 10)&#xA;( &#xA;&#x9;(&#xA;&#x9;&#x9;(&#xA;&#x9;&#x9;&#x9;(  YEAR( @[User::FechaIni]  )*100 )   &#xA;&#x9;&#x9;&#x9;+&#xA;&#x9;&#x9;&#x9;(  MONTH( @[User::FechaIni] )  )&#xA;&#x9;&#x9;)*100&#xA;&#x9;)+ DAY( @[User::FechaIni] )&#xA;)"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="STR_FechaIni">
      <DTS:VariableValue
        DTS:DataType="8">20260907</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{3C875B53-70C4-4393-8CA4-5F784C52EA1B}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot;/* Creación de tabla en base temporal */&#xA;DROP TABLE IF EXISTS TEMPDB.DBO.GUIAS_ENVIOS_MOV;&#xA;&#xA;SELECT --CONVERT(NUMERIC,CONVERT(DATETIME,CONVERT(CHAR(11),GUIAS.FECHA_ENVIO)))AS TIMEID,&#xA;&#x9;&#x9;--GUIAS.FECHA_ENVIO, --AS FECHA, --CONVERT(DATETIME,CONVERT(CHAR(11),GUIAS.FECHA_ENVIO))AS FECHA,&#xA;&#x9;&#x9;SE_FECH.FECHA_HORA_MOVIMIENTO,&#xA;&#x9;&#x9;GUIAS.ID_PAIS_ORIGEN, --ISNULL(GUIAS.ID_PAIS_ORIGEN,0) AS ID_PAIS_ORIGEN,&#xA;&#x9;&#x9;GUIAS.ID_CIUDAD_ORIGEN, --ISNULL(GUIAS.ID_CIUDAD_ORIGEN,0) AS ID_CIUDAD_ORIGEN,&#xA;&#x9;&#x9;GUIAS.ID_PAIS_DESTINO, --ISNULL(GUIAS.ID_PAIS_DESTINO,0) AS ID_PAIS_DESTINO,&#xA;&#x9;&#x9;GUIAS.ID_CIUDAD_DESTINO, --ISNULL(GUIAS.ID_CIUDAD_DESTINO,0) AS ID_CIUDAD_DESTINO,&#xA;&#x9;&#x9;GUIAS.ID_TIPOGUIA, --ISNULL(GUIAS.ID_TIPOGUIA,0) AS ID_TIPOGUIA,&#xA;&#x9;&#x9;GUIAS.ID_CLIENTE, --ISNULL(GUIAS.ID_CLIENTE,0) AS ID_CLIENTE,&#xA;&#x9;&#x9;GUIAS.ID_ESTADOENVIO, --ISNULL(GUIAS.ID_ESTADOENVIO,0) AS ID_ESTADOENVIO,&#xA;&#x9;&#x9;GUIAS.ID_DOCU_ULT_MOVI, --ISNULL(GUIAS.ID_DOCU_ULT_MOVI,0) AS   ID_PROCESO,&#xA;&#x9;&#x9;GUIAS.ID_MEDTRANS, --ISNULL(GUIAS.ID_MEDTRANS,0) AS ID_MEDTRANS,&#xA;&#x9;&#x9;GUIAS.ID_PRODUCTO, --ISNULL(GUIAS.ID_PRODUCTO,0) AS ID_PRODUCTO,&#xA;&#x9;&#x9;GUIAS.ID_SUBPRODUCTO, --ISNULL(GUIAS.ID_SUBPRODUCTO,0) AS ID_SUBPRODUCTO,&#xA;&#x9;&#x9;GUIAS.ID_ESTADOGUIA, --ISNULL(GUIAS.ID_ESTADOGUIA,0) AS ID_ESTADOGUIA,&#xA;&#x9;&#x9;GUIAS.ID_TIEMPO AS ID_TIEMPO_ENTREGA, --ISNULL(GUIAS.ID_TIEMPO,0) AS ID_TIEMPO_ENTREGA,&#xA;&#x9;&#x9;GUIAS.ID_REQUIERE_EMBALAJE AS ID_REQ_EMBALAJE, --ISNULL(GUIAS.ID_REQUIERE_EMBALAJE,0) AS ID_REQ_EMBALAJE,&#xA;&#x9;&#x9;GUIAS.NUMERO_GUIA, --COUNT(DISTINCT GUIAS.NUMERO_GUIA) AS CANTIDAD_GUIAS,&#xA;&#x9;&#x9;GUIAS.NUMERO_PIEZAS, --SUM(CASE WHEN ISNULL(GUIAS.NUMERO_PIEZAS,0) = 0 THEN 1 ELSE GUIAS.NUMERO_PIEZAS END) AS CANTIDAD_PIEZAS,&#xA;&#x9;&#x9;GUIAS.FECHA_ENTREGA, --ISNULL(DATEDIFF(MI,GUIAS.FECHA_ENTREGA,GUIAS.FECHA_MODIFICACION),0) AS TIEMPO_DIGITALIZACION,&#xA;&#x9;&#x9;GUIAS.FECHA_MODIFICACION,&#xA;&#x9;&#x9;CONVERT(SMALLINT, NULL) AS VLT_RURAL_DEST,&#xA;&#x9;&#x9;CONVERT(SMALLINT, NULL) AS VLT_RURAL_ORIG&#xA;&#x9;&#x9;--ISNULL((DATEDIFF(HH,FECHA_ENVIO,FECHA_ENTREGA)),0) AS TIEMPO_PROMESA_H&#xA;&#x9;INTO TEMPDB.DBO.GUIAS_ENVIOS_MOV&#xA;FROM &#x9;MECE_LOGISTICO.DBO.GUIAS GUIAS WITH (NOLOCK, INDEX(UK_GUIA)  )&#xA;&#x9;&#x9;INNER JOIN&#x9;Mece_Logistico.dbo.SEGUIMIENTO_ENVIO AS SE_FECH   &#x9;ON SE_FECH.NUMERO_GUIA = GUIAS.NUMERO_GUIA --SE.NUMERO_GUIA = SE_FECH.NUMERO_GUIA&#xA;&#x9;&#x9;WHERE 1 = 0&#xA;;&#xA;&#xA;CREATE NONCLUSTERED INDEX [XI_GUIAS_ENVIOS_MOV_6M_NUMG] ON TEMPDB.DBO.GUIAS_ENVIOS_MOV ( NUMERO_GUIA );&#xA;&#xA;GO&#xA;&#xA;DECLARE @FECHA_I DATETIME, @FECHA_INI DATETIME, @FECHA_FIN DATETIME, @FECHA_MANUAL DATETIME&#xA; &#xA;SET @FECHA_MANUAL = '2017-04-01 00:00:00.000' --SE CAMBIA LA FECHA DEL 01/09/2016 POR 01/04/2017, YA QUE EL CAMBIO APLICA SOLO DESDE ABRIL 2017 &#xA;--SET @FECHA_I =    '2025-08-05'; &#xA;--SET @FECHA_FIN =  '2025-08-12';&#xA;&#xA;&#xA;SET @FECHA_I = CONVERT(DATETIME,CONVERT(CHAR(11), '&quot;+ @[User::STR_FechaIni]   +&quot;' )) ;&#xA;SET @FECHA_FIN = CONVERT(DATETIME,CONVERT(CHAR(11), '&quot;+ @[User::STR_FechaFin]  +&quot;' ))  ;&#xA; &#xA;IF @FECHA_I &gt;= @FECHA_MANUAL&#xA;&#x9;BEGIN&#xA;&#x9;&#x9;SET @FECHA_INI = @FECHA_I&#xA;&#x9;END&#xA;ELSE&#xA;&#x9;BEGIN&#xA;&#x9;&#x9;SET @FECHA_INI = @FECHA_MANUAL&#xA;&#x9;END&#xA;; &#xA;&#xA;;WITH SEGUIMI_ENVIO AS (&#xA;&#x9;SELECT&#x9;MIN(FECHA_HORA_MOVIMIENTO) AS FECHA_HORA_MOVIMIENTO, NUMERO_GUIA&#xA;&#x9;FROM MECE_LOGISTICO.DBO.SEGUIMIENTO_ENVIO  WITH (NOLOCK) &#xA;&#x9;WHERE FECHA_HORA_MOVIMIENTO &gt;=  @FECHA_INI &#x9;&#x9;&#xA;&#x9;&#x9;AND FECHA_HORA_MOVIMIENTO &lt;  @FECHA_FIN&#x9;&#x9;&#xA;&#x9;&#x9;AND ID_PROCESO IN (5,6) &#xA;&#x9;&#x9;AND LEN(NUMERO_GUIA) &gt; 8&#xA;&#x9;GROUP BY NUMERO_GUIA&#xA;)&#xA;INSERT INTO TEMPDB.DBO.GUIAS_ENVIOS_MOV &#xA;SELECT --CONVERT(NUMERIC,CONVERT(DATETIME,CONVERT(CHAR(11),GUIAS.FECHA_ENVIO)))AS TIMEID,&#xA;&#x9;&#x9;--GUIAS.FECHA_ENVIO, --AS FECHA, --CONVERT(DATETIME,CONVERT(CHAR(11),GUIAS.FECHA_ENVIO))AS FECHA,&#xA;&#x9;&#x9;SE_FECH.FECHA_HORA_MOVIMIENTO,&#xA;&#x9;&#x9;GUIAS.ID_PAIS_ORIGEN, --ISNULL(GUIAS.ID_PAIS_ORIGEN,0) AS ID_PAIS_ORIGEN,&#xA;&#x9;&#x9;GUIAS.ID_CIUDAD_ORIGEN, --ISNULL(GUIAS.ID_CIUDAD_ORIGEN,0) AS ID_CIUDAD_ORIGEN,&#xA;&#x9;&#x9;GUIAS.ID_PAIS_DESTINO, --ISNULL(GUIAS.ID_PAIS_DESTINO,0) AS ID_PAIS_DESTINO,&#xA;&#x9;&#x9;GUIAS.ID_CIUDAD_DESTINO, --ISNULL(GUIAS.ID_CIUDAD_DESTINO,0) AS ID_CIUDAD_DESTINO,&#xA;&#x9;&#x9;GUIAS.ID_TIPOGUIA, --ISNULL(GUIAS.ID_TIPOGUIA,0) AS ID_TIPOGUIA,&#xA;&#x9;&#x9;GUIAS.ID_CLIENTE, --ISNULL(GUIAS.ID_CLIENTE,0) AS ID_CLIENTE,&#xA;&#x9;&#x9;GUIAS.ID_ESTADOENVIO, --ISNULL(GUIAS.ID_ESTADOENVIO,0) AS ID_ESTADOENVIO,&#xA;&#x9;&#x9;GUIAS.ID_DOCU_ULT_MOVI, --ISNULL(GUIAS.ID_DOCU_ULT_MOVI,0) AS   ID_PROCESO,&#xA;&#x9;&#x9;GUIAS.ID_MEDTRANS, --ISNULL(GUIAS.ID_MEDTRANS,0) AS ID_MEDTRANS,&#xA;&#x9;&#x9;GUIAS.ID_PRODUCTO, --ISNULL(GUIAS.ID_PRODUCTO,0) AS ID_PRODUCTO,&#xA;&#x9;&#x9;GUIAS.ID_SUBPRODUCTO, --ISNULL(GUIAS.ID_SUBPRODUCTO,0) AS ID_SUBPRODUCTO,&#xA;&#x9;&#x9;GUIAS.ID_ESTADOGUIA, --ISNULL(GUIAS.ID_ESTADOGUIA,0) AS ID_ESTADOGUIA,&#xA;&#x9;&#x9;GUIAS.ID_TIEMPO AS ID_TIEMPO_ENTREGA, --ISNULL(GUIAS.ID_TIEMPO,0) AS ID_TIEMPO_ENTREGA,&#xA;&#x9;&#x9;GUIAS.ID_REQUIERE_EMBALAJE AS ID_REQ_EMBALAJE, --ISNULL(GUIAS.ID_REQUIERE_EMBALAJE,0) AS ID_REQ_EMBALAJE,&#xA;&#x9;&#x9;GUIAS.NUMERO_GUIA, --COUNT(DISTINCT GUIAS.NUMERO_GUIA) AS CANTIDAD_GUIAS,&#xA;&#x9;&#x9;GUIAS.NUMERO_PIEZAS, --SUM(CASE WHEN ISNULL(GUIAS.NUMERO_PIEZAS,0) = 0 THEN 1 ELSE GUIAS.NUMERO_PIEZAS END) AS CANTIDAD_PIEZAS,&#xA;&#x9;&#x9;GUIAS.FECHA_ENTREGA, --ISNULL(DATEDIFF(MI,GUIAS.FECHA_ENTREGA,GUIAS.FECHA_MODIFICACION),0) AS TIEMPO_DIGITALIZACION,&#xA;&#x9;&#x9;GUIAS.FECHA_MODIFICACION,&#x9;&#x9;&#xA;&#x9;&#x9;CASE &#xA;            WHEN GUIAS.DIRECCION_DESTINA_GUIA COLLATE Latin1_General_CI_AI LIKE '%vereda%'&#xA;&#x9;&#x9;&#x9;  OR GUIAS.DIRECCION_DESTINA_GUIA COLLATE Latin1_General_CI_AI LIKE '%vrd%'&#xA;&#x9;&#x9;&#x9;  OR GUIAS.DIRECCION_DESTINA_GUIA COLLATE Latin1_General_CI_AI LIKE '%vda%'    --- nueva&#xA;              OR GUIAS.DIRECCION_DESTINA_GUIA COLLATE Latin1_General_CI_AI LIKE '%corregimiento%'&#xA;&#x9;&#x9;&#x9;  OR GUIAS.DIRECCION_DESTINA_GUIA COLLATE Latin1_General_CI_AI LIKE '%corr.%'    --- nueva&#xA;              OR GUIAS.DIRECCION_DESTINA_GUIA COLLATE Latin1_General_CI_AI LIKE '%km%'&#xA;&#x9;&#x9;&#x9;  OR GUIAS.DIRECCION_DESTINA_GUIA COLLATE Latin1_General_CI_AI LIKE '%k m%'&#xA;              OR GUIAS.DIRECCION_DESTINA_GUIA COLLATE Latin1_General_CI_AI LIKE '%kil_me%'&#xA;&#x9;&#x9;&#x9;  OR GUIAS.DIRECCION_DESTINA_GUIA COLLATE Latin1_General_CI_AI LIKE '%inspecci_n%'&#xA;&#x9;&#x9;&#x9;  OR GUIAS.DIRECCION_DESTINA_GUIA COLLATE Latin1_General_CI_AI LIKE '% v_a %'    --- modificado por tomar palabra BOLIVIA &#xA;&#x9;&#x9;&#x9;  OR GUIAS.DIRECCION_DESTINA_GUIA COLLATE Latin1_General_CI_AI LIKE '%caser_o%'&#xA;&#x9;&#x9;&#x9;  OR GUIAS.DIRECCION_DESTINA_GUIA COLLATE Latin1_General_CI_AI LIKE '%paraje%'&#xA;&#x9;&#x9;&#x9;  OR GUIAS.DIRECCION_DESTINA_GUIA COLLATE Latin1_General_CI_AI LIKE '%finca%'&#xA;&#x9;&#x9;&#x9;  OR GUIAS.DIRECCION_DESTINA_GUIA COLLATE Latin1_General_CI_AI LIKE '%hacienda%'&#xA;&#x9;&#x9;&#x9;  OR GUIAS.DIRECCION_DESTINA_GUIA COLLATE Latin1_General_CI_AI LIKE '%parcela%'&#xA;&#x9;&#x9;&#x9;  OR GUIAS.DIRECCION_DESTINA_GUIA COLLATE Latin1_General_CI_AI LIKE '%predio%'&#xA;&#x9;&#x9;&#x9;  OR GUIAS.DIRECCION_DESTINA_GUIA COLLATE Latin1_General_CI_AI LIKE '%granja%'&#xA;&#x9;&#x9;&#x9;  OR GUIAS.DIRECCION_DESTINA_GUIA COLLATE Latin1_General_CI_AI LIKE '%resguardo%'&#xA;&#x9;&#x9;&#x9;  OR GUIAS.DIRECCION_DESTINA_GUIA COLLATE Latin1_General_CI_AI LIKE '%sector_rural%'&#xA;            THEN CONVERT(SMALLINT,  1) ELSE CONVERT(SMALLINT,  0)&#xA;        END AS VLT_RURAL_DEST,&#xA;&#x9;&#x9;CASE &#xA;            WHEN GUIAS.DIRECCION_REMITE_GUIA  COLLATE Latin1_General_CI_AI LIKE '%vereda%'&#xA;&#x9;&#x9;&#x9;OR GUIAS.DIRECCION_REMITE_GUIA  COLLATE Latin1_General_CI_AI LIKE '%vrd%'&#xA;&#x9;&#x9;&#x9;OR GUIAS.DIRECCION_REMITE_GUIA  COLLATE Latin1_General_CI_AI LIKE '%vda%'    --- nueva&#xA;              OR GUIAS.DIRECCION_REMITE_GUIA  COLLATE Latin1_General_CI_AI LIKE '%corregimiento%'&#xA;&#x9;&#x9;&#x9;  OR GUIAS.DIRECCION_REMITE_GUIA  COLLATE Latin1_General_CI_AI LIKE '%corr.%'    --- nueva&#xA;              OR GUIAS.DIRECCION_REMITE_GUIA  COLLATE Latin1_General_CI_AI LIKE '%km%'&#xA;&#x9;&#x9;&#x9;  OR GUIAS.DIRECCION_REMITE_GUIA  COLLATE Latin1_General_CI_AI LIKE '%k m%'&#xA;              OR GUIAS.DIRECCION_REMITE_GUIA  COLLATE Latin1_General_CI_AI LIKE '%kil_me%'&#xA;&#x9;&#x9;&#x9;  OR GUIAS.DIRECCION_REMITE_GUIA  COLLATE Latin1_General_CI_AI LIKE '%inspecci_n%'&#xA;&#x9;&#x9;&#x9;  OR GUIAS.DIRECCION_REMITE_GUIA  COLLATE Latin1_General_CI_AI LIKE '% v_a %'    --- modificado por tomar palabra BOLIVIA &#xA;&#x9;&#x9;&#x9;  OR GUIAS.DIRECCION_REMITE_GUIA  COLLATE Latin1_General_CI_AI LIKE '%caser_o%'&#xA;&#x9;&#x9;&#x9;  OR GUIAS.DIRECCION_REMITE_GUIA  COLLATE Latin1_General_CI_AI LIKE '%paraje%'&#xA;&#x9;&#x9;&#x9;  OR GUIAS.DIRECCION_REMITE_GUIA  COLLATE Latin1_General_CI_AI LIKE '%finca%'&#xA;&#x9;&#x9;&#x9;  OR GUIAS.DIRECCION_REMITE_GUIA  COLLATE Latin1_General_CI_AI LIKE '%hacienda%'&#xA;&#x9;&#x9;&#x9;  OR GUIAS.DIRECCION_REMITE_GUIA  COLLATE Latin1_General_CI_AI LIKE '%parcela%'&#xA;&#x9;&#x9;&#x9;  OR GUIAS.DIRECCION_REMITE_GUIA  COLLATE Latin1_General_CI_AI LIKE '%predio%'&#xA;&#x9;&#x9;&#x9;  OR GUIAS.DIRECCION_REMITE_GUIA  COLLATE Latin1_General_CI_AI LIKE '%granja%'&#xA;&#x9;&#x9;&#x9;  OR GUIAS.DIRECCION_REMITE_GUIA  COLLATE Latin1_General_CI_AI LIKE '%resguardo%'&#xA;&#x9;&#x9;&#x9;  OR GUIAS.DIRECCION_REMITE_GUIA  COLLATE Latin1_General_CI_AI LIKE '%sector_rural%'&#xA;            THEN CONVERT(SMALLINT,  1) ELSE CONVERT(SMALLINT,  0)&#xA;        END AS VLT_RURAL_ORIG&#xA;&#x9;&#x9;--ISNULL((DATEDIFF(HH,FECHA_ENVIO,FECHA_ENTREGA)),0) AS TIEMPO_PROMESA_H&#xA;FROM &#x9;MECE_LOGISTICO.DBO.GUIAS GUIAS WITH (NOLOCK, INDEX(UK_GUIA)  )&#xA;&#x9;&#x9;INNER JOIN&#x9;SEGUIMI_ENVIO AS SE_FECH   &#x9;ON SE_FECH.NUMERO_GUIA = GUIAS.NUMERO_GUIA --SE.NUMERO_GUIA = SE_FECH.NUMERO_GUIA&#xA;&#x9;&#x9;WHERE GUIAS.ID_DOCU_ULT_MOVI &gt;= 4 -- ID_PROCESO&#xA; OPTION (RECOMPILE) ; &#xA;&quot;"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="TSQL_EXTRAER_INFO">
      <DTS:VariableValue
        DTS:DataType="8">/* Creación de tabla en base temporal */
DROP TABLE IF EXISTS TEMPDB.DBO.GUIAS_ENVIOS_MOV;

SELECT --CONVERT(NUMERIC,CONVERT(DATETIME,CONVERT(CHAR(11),GUIAS.FECHA_ENVIO)))AS TIMEID,
		--GUIAS.FECHA_ENVIO, --AS FECHA, --CONVERT(DATETIME,CONVERT(CHAR(11),GUIAS.FECHA_ENVIO))AS FECHA,
		SE_FECH.FECHA_HORA_MOVIMIENTO,
		GUIAS.ID_PAIS_ORIGEN, --ISNULL(GUIAS.ID_PAIS_ORIGEN,0) AS ID_PAIS_ORIGEN,
		GUIAS.ID_CIUDAD_ORIGEN, --ISNULL(GUIAS.ID_CIUDAD_ORIGEN,0) AS ID_CIUDAD_ORIGEN,
		GUIAS.ID_PAIS_DESTINO, --ISNULL(GUIAS.ID_PAIS_DESTINO,0) AS ID_PAIS_DESTINO,
		GUIAS.ID_CIUDAD_DESTINO, --ISNULL(GUIAS.ID_CIUDAD_DESTINO,0) AS ID_CIUDAD_DESTINO,
		GUIAS.ID_TIPOGUIA, --ISNULL(GUIAS.ID_TIPOGUIA,0) AS ID_TIPOGUIA,
		GUIAS.ID_CLIENTE, --ISNULL(GUIAS.ID_CLIENTE,0) AS ID_CLIENTE,
		GUIAS.ID_ESTADOENVIO, --ISNULL(GUIAS.ID_ESTADOENVIO,0) AS ID_ESTADOENVIO,
		GUIAS.ID_DOCU_ULT_MOVI, --ISNULL(GUIAS.ID_DOCU_ULT_MOVI,0) AS   ID_PROCESO,
		GUIAS.ID_MEDTRANS, --ISNULL(GUIAS.ID_MEDTRANS,0) AS ID_MEDTRANS,
		GUIAS.ID_PRODUCTO, --ISNULL(GUIAS.ID_PRODUCTO,0) AS ID_PRODUCTO,
		GUIAS.ID_SUBPRODUCTO, --ISNULL(GUIAS.ID_SUBPRODUCTO,0) AS ID_SUBPRODUCTO,
		GUIAS.ID_ESTADOGUIA, --ISNULL(GUIAS.ID_ESTADOGUIA,0) AS ID_ESTADOGUIA,
		GUIAS.ID_TIEMPO AS ID_TIEMPO_ENTREGA, --ISNULL(GUIAS.ID_TIEMPO,0) AS ID_TIEMPO_ENTREGA,
		GUIAS.ID_REQUIERE_EMBALAJE AS ID_REQ_EMBALAJE, --ISNULL(GUIAS.ID_REQUIERE_EMBALAJE,0) AS ID_REQ_EMBALAJE,
		GUIAS.NUMERO_GUIA, --COUNT(DISTINCT GUIAS.NUMERO_GUIA) AS CANTIDAD_GUIAS,
		GUIAS.NUMERO_PIEZAS, --SUM(CASE WHEN ISNULL(GUIAS.NUMERO_PIEZAS,0) = 0 THEN 1 ELSE GUIAS.NUMERO_PIEZAS END) AS CANTIDAD_PIEZAS,
		GUIAS.FECHA_ENTREGA, --ISNULL(DATEDIFF(MI,GUIAS.FECHA_ENTREGA,GUIAS.FECHA_MODIFICACION),0) AS TIEMPO_DIGITALIZACION,
		GUIAS.FECHA_MODIFICACION,
		CONVERT(SMALLINT, NULL) AS VLT_RURAL_DEST,
		CONVERT(SMALLINT, NULL) AS VLT_RURAL_ORIG
		--ISNULL((DATEDIFF(HH,FECHA_ENVIO,FECHA_ENTREGA)),0) AS TIEMPO_PROMESA_H
	INTO TEMPDB.DBO.GUIAS_ENVIOS_MOV
FROM 	MECE_LOGISTICO.DBO.GUIAS GUIAS WITH (NOLOCK, INDEX(UK_GUIA)  )
		INNER JOIN	Mece_Logistico.dbo.SEGUIMIENTO_ENVIO AS SE_FECH   	ON SE_FECH.NUMERO_GUIA = GUIAS.NUMERO_GUIA --SE.NUMERO_GUIA = SE_FECH.NUMERO_GUIA
		WHERE 1 = 0
;

CREATE NONCLUSTERED INDEX [XI_GUIAS_ENVIOS_MOV_6M_NUMG] ON TEMPDB.DBO.GUIAS_ENVIOS_MOV ( NUMERO_GUIA );

GO

DECLARE @FECHA_I DATETIME, @FECHA_INI DATETIME, @FECHA_FIN DATETIME, @FECHA_MANUAL DATETIME
 
SET @FECHA_MANUAL = '2017-04-01 00:00:00.000' --SE CAMBIA LA FECHA DEL 01/09/2016 POR 01/04/2017, YA QUE EL CAMBIO APLICA SOLO DESDE ABRIL 2017 
--SET @FECHA_I =    '2025-08-05'; 
--SET @FECHA_FIN =  '2025-08-12';


SET @FECHA_I = CONVERT(DATETIME,CONVERT(CHAR(11), '20260907' )) ;
SET @FECHA_FIN = CONVERT(DATETIME,CONVERT(CHAR(11), '20260918' ))  ;
 
IF @FECHA_I &gt;= @FECHA_MANUAL
	BEGIN
		SET @FECHA_INI = @FECHA_I
	END
ELSE
	BEGIN
		SET @FECHA_INI = @FECHA_MANUAL
	END
; 

;WITH SEGUIMI_ENVIO AS (
	SELECT	MIN(FECHA_HORA_MOVIMIENTO) AS FECHA_HORA_MOVIMIENTO, NUMERO_GUIA
	FROM MECE_LOGISTICO.DBO.SEGUIMIENTO_ENVIO  WITH (NOLOCK) 
	WHERE FECHA_HORA_MOVIMIENTO &gt;=  @FECHA_INI 		
		AND FECHA_HORA_MOVIMIENTO &lt;  @FECHA_FIN		
		AND ID_PROCESO IN (5,6) 
		AND LEN(NUMERO_GUIA) &gt; 8
	GROUP BY NUMERO_GUIA
)
INSERT INTO TEMPDB.DBO.GUIAS_ENVIOS_MOV 
SELECT --CONVERT(NUMERIC,CONVERT(DATETIME,CONVERT(CHAR(11),GUIAS.FECHA_ENVIO)))AS TIMEID,
		--GUIAS.FECHA_ENVIO, --AS FECHA, --CONVERT(DATETIME,CONVERT(CHAR(11),GUIAS.FECHA_ENVIO))AS FECHA,
		SE_FECH.FECHA_HORA_MOVIMIENTO,
		GUIAS.ID_PAIS_ORIGEN, --ISNULL(GUIAS.ID_PAIS_ORIGEN,0) AS ID_PAIS_ORIGEN,
		GUIAS.ID_CIUDAD_ORIGEN, --ISNULL(GUIAS.ID_CIUDAD_ORIGEN,0) AS ID_CIUDAD_ORIGEN,
		GUIAS.ID_PAIS_DESTINO, --ISNULL(GUIAS.ID_PAIS_DESTINO,0) AS ID_PAIS_DESTINO,
		GUIAS.ID_CIUDAD_DESTINO, --ISNULL(GUIAS.ID_CIUDAD_DESTINO,0) AS ID_CIUDAD_DESTINO,
		GUIAS.ID_TIPOGUIA, --ISNULL(GUIAS.ID_TIPOGUIA,0) AS ID_TIPOGUIA,
		GUIAS.ID_CLIENTE, --ISNULL(GUIAS.ID_CLIENTE,0) AS ID_CLIENTE,
		GUIAS.ID_ESTADOENVIO, --ISNULL(GUIAS.ID_ESTADOENVIO,0) AS ID_ESTADOENVIO,
		GUIAS.ID_DOCU_ULT_MOVI, --ISNULL(GUIAS.ID_DOCU_ULT_MOVI,0) AS   ID_PROCESO,
		GUIAS.ID_MEDTRANS, --ISNULL(GUIAS.ID_MEDTRANS,0) AS ID_MEDTRANS,
		GUIAS.ID_PRODUCTO, --ISNULL(GUIAS.ID_PRODUCTO,0) AS ID_PRODUCTO,
		GUIAS.ID_SUBPRODUCTO, --ISNULL(GUIAS.ID_SUBPRODUCTO,0) AS ID_SUBPRODUCTO,
		GUIAS.ID_ESTADOGUIA, --ISNULL(GUIAS.ID_ESTADOGUIA,0) AS ID_ESTADOGUIA,
		GUIAS.ID_TIEMPO AS ID_TIEMPO_ENTREGA, --ISNULL(GUIAS.ID_TIEMPO,0) AS ID_TIEMPO_ENTREGA,
		GUIAS.ID_REQUIERE_EMBALAJE AS ID_REQ_EMBALAJE, --ISNULL(GUIAS.ID_REQUIERE_EMBALAJE,0) AS ID_REQ_EMBALAJE,
		GUIAS.NUMERO_GUIA, --COUNT(DISTINCT GUIAS.NUMERO_GUIA) AS CANTIDAD_GUIAS,
		GUIAS.NUMERO_PIEZAS, --SUM(CASE WHEN ISNULL(GUIAS.NUMERO_PIEZAS,0) = 0 THEN 1 ELSE GUIAS.NUMERO_PIEZAS END) AS CANTIDAD_PIEZAS,
		GUIAS.FECHA_ENTREGA, --ISNULL(DATEDIFF(MI,GUIAS.FECHA_ENTREGA,GUIAS.FECHA_MODIFICACION),0) AS TIEMPO_DIGITALIZACION,
		GUIAS.FECHA_MODIFICACION,		
		CASE 
            WHEN GUIAS.DIRECCION_DESTINA_GUIA COLLATE Latin1_General_CI_AI LIKE '%vereda%'
			  OR GUIAS.DIRECCION_DESTINA_GUIA COLLATE Latin1_General_CI_AI LIKE '%vrd%'
			  OR GUIAS.DIRECCION_DESTINA_GUIA COLLATE Latin1_General_CI_AI LIKE '%vda%'    --- nueva
              OR GUIAS.DIRECCION_DESTINA_GUIA COLLATE Latin1_General_CI_AI LIKE '%corregimiento%'
			  OR GUIAS.DIRECCION_DESTINA_GUIA COLLATE Latin1_General_CI_AI LIKE '%corr.%'    --- nueva
              OR GUIAS.DIRECCION_DESTINA_GUIA COLLATE Latin1_General_CI_AI LIKE '%km%'
			  OR GUIAS.DIRECCION_DESTINA_GUIA COLLATE Latin1_General_CI_AI LIKE '%k m%'
              OR GUIAS.DIRECCION_DESTINA_GUIA COLLATE Latin1_General_CI_AI LIKE '%kil_me%'
			  OR GUIAS.DIRECCION_DESTINA_GUIA COLLATE Latin1_General_CI_AI LIKE '%inspecci_n%'
			  OR GUIAS.DIRECCION_DESTINA_GUIA COLLATE Latin1_General_CI_AI LIKE '% v_a %'    --- modificado por tomar palabra BOLIVIA 
			  OR GUIAS.DIRECCION_DESTINA_GUIA COLLATE Latin1_General_CI_AI LIKE '%caser_o%'
			  OR GUIAS.DIRECCION_DESTINA_GUIA COLLATE Latin1_General_CI_AI LIKE '%paraje%'
			  OR GUIAS.DIRECCION_DESTINA_GUIA COLLATE Latin1_General_CI_AI LIKE '%finca%'
			  OR GUIAS.DIRECCION_DESTINA_GUIA COLLATE Latin1_General_CI_AI LIKE '%hacienda%'
			  OR GUIAS.DIRECCION_DESTINA_GUIA COLLATE Latin1_General_CI_AI LIKE '%parcela%'
			  OR GUIAS.DIRECCION_DESTINA_GUIA COLLATE Latin1_General_CI_AI LIKE '%predio%'
			  OR GUIAS.DIRECCION_DESTINA_GUIA COLLATE Latin1_General_CI_AI LIKE '%granja%'
			  OR GUIAS.DIRECCION_DESTINA_GUIA COLLATE Latin1_General_CI_AI LIKE '%resguardo%'
			  OR GUIAS.DIRECCION_DESTINA_GUIA COLLATE Latin1_General_CI_AI LIKE '%sector_rural%'
            THEN CONVERT(SMALLINT,  1) ELSE CONVERT(SMALLINT,  0)
        END AS VLT_RURAL_DEST,
		CASE 
            WHEN GUIAS.DIRECCION_REMITE_GUIA  COLLATE Latin1_General_CI_AI LIKE '%vereda%'
			OR GUIAS.DIRECCION_REMITE_GUIA  COLLATE Latin1_General_CI_AI LIKE '%vrd%'
			OR GUIAS.DIRECCION_REMITE_GUIA  COLLATE Latin1_General_CI_AI LIKE '%vda%'    --- nueva
              OR GUIAS.DIRECCION_REMITE_GUIA  COLLATE Latin1_General_CI_AI LIKE '%corregimiento%'
			  OR GUIAS.DIRECCION_REMITE_GUIA  COLLATE Latin1_General_CI_AI LIKE '%corr.%'    --- nueva
              OR GUIAS.DIRECCION_REMITE_GUIA  COLLATE Latin1_General_CI_AI LIKE '%km%'
			  OR GUIAS.DIRECCION_REMITE_GUIA  COLLATE Latin1_General_CI_AI LIKE '%k m%'
              OR GUIAS.DIRECCION_REMITE_GUIA  COLLATE Latin1_General_CI_AI LIKE '%kil_me%'
			  OR GUIAS.DIRECCION_REMITE_GUIA  COLLATE Latin1_General_CI_AI LIKE '%inspecci_n%'
			  OR GUIAS.DIRECCION_REMITE_GUIA  COLLATE Latin1_General_CI_AI LIKE '% v_a %'    --- modificado por tomar palabra BOLIVIA 
			  OR GUIAS.DIRECCION_REMITE_GUIA  COLLATE Latin1_General_CI_AI LIKE '%caser_o%'
			  OR GUIAS.DIRECCION_REMITE_GUIA  COLLATE Latin1_General_CI_AI LIKE '%paraje%'
			  OR GUIAS.DIRECCION_REMITE_GUIA  COLLATE Latin1_General_CI_AI LIKE '%finca%'
			  OR GUIAS.DIRECCION_REMITE_GUIA  COLLATE Latin1_General_CI_AI LIKE '%hacienda%'
			  OR GUIAS.DIRECCION_REMITE_GUIA  COLLATE Latin1_General_CI_AI LIKE '%parcela%'
			  OR GUIAS.DIRECCION_REMITE_GUIA  COLLATE Latin1_General_CI_AI LIKE '%predio%'
			  OR GUIAS.DIRECCION_REMITE_GUIA  COLLATE Latin1_General_CI_AI LIKE '%granja%'
			  OR GUIAS.DIRECCION_REMITE_GUIA  COLLATE Latin1_General_CI_AI LIKE '%resguardo%'
			  OR GUIAS.DIRECCION_REMITE_GUIA  COLLATE Latin1_General_CI_AI LIKE '%sector_rural%'
            THEN CONVERT(SMALLINT,  1) ELSE CONVERT(SMALLINT,  0)
        END AS VLT_RURAL_ORIG
		--ISNULL((DATEDIFF(HH,FECHA_ENVIO,FECHA_ENTREGA)),0) AS TIEMPO_PROMESA_H
FROM 	MECE_LOGISTICO.DBO.GUIAS GUIAS WITH (NOLOCK, INDEX(UK_GUIA)  )
		INNER JOIN	SEGUIMI_ENVIO AS SE_FECH   	ON SE_FECH.NUMERO_GUIA = GUIAS.NUMERO_GUIA --SE.NUMERO_GUIA = SE_FECH.NUMERO_GUIA
		WHERE GUIAS.ID_DOCU_ULT_MOVI &gt;= 4 -- ID_PROCESO
 OPTION (RECOMPILE) ; 
</DTS:VariableValue>
    </DTS:Variable>
  </DTS:Variables>
