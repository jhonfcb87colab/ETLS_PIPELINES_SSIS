                  <DataType>WChar</DataType>
                  <DataSize>32</DataSize>
                  <NullProcessing>UnknownMember</NullProcessing>
                  <Source xsi:type="ColumnBinding" dwd:design-time-name="bdb8a709-c853-4d2c-859c-5292c8f1c868">
                    <TableID>FAC_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2</TableID>
                    <ColumnID>ID_GEOGRAFIA_CONCEPTO</ColumnID>
                  </Source>
                </KeyColumn>
              </KeyColumns>
              <Type>Granularity</Type>
            </Attribute>
            <Attribute dwd:design-time-name="9543e400-c8ae-4115-b09e-fbaa82c03e63">
              <AttributeID>Nombre Concepto</AttributeID>
              <KeyColumns>
                <KeyColumn dwd:design-time-name="d1d79d90-307d-41f2-839e-c9387831077a">
                  <DataType>WChar</DataType>
                  <DataSize>18</DataSize>
                  <Source xsi:type="ColumnBinding" dwd:design-time-name="679fd2b1-bd7e-4d8a-908e-c4ddad28615c">
                    <TableID>DIM_GEOGRAFIA_CONCEPTO</TableID>
                    <ColumnID>CONCEPTO</ColumnID>
                  </Source>
                </KeyColumn>
              </KeyColumns>
            </Attribute>
          </Attributes>
        </Dimension>
      </Dimensions>
      <Partitions />
      <ProactiveCaching dwd:design-time-name="9a470016-263d-495e-b789-69676270a5aa">
        <SilenceInterval>-PT1S</SilenceInterval>
        <Latency>-PT1S</Latency>
        <SilenceOverrideInterval>-PT1S</SilenceOverrideInterval>
        <ForceRebuildInterval>-PT1S</ForceRebuildInterval>
        <Source xsi:type="ProactiveCachingInheritedBinding" dwd:design-time-name="4f9e6a4f-57f2-4f7b-90ac-12b49003eecb" />
      </ProactiveCaching>
    </MeasureGroup>
  </MeasureGroups>
  <Source dwd:design-time-name="f354f857-8077-484a-99f4-e4f992ecdbc4">
    <DataSourceViewID>SIG_COL_LOGISTICA_DW</DataSourceViewID>
  </Source>
  <MdxScripts>
    <MdxScript dwd:design-time-name="38c8750b-365a-4298-87dd-9efd63e2fbf8">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>2021-02-08T20:17:09.146667Z</CreatedTimestamp>
      <LastSchemaUpdate>2026-06-09T13:26:07.263333Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>
									/*
									The CALCULATE command controls the aggregation of leaf cells in the cube.
									If the CALCULATE command is deleted or modified, the data within the cube is affected.
									You should edit this command only if you manually specify how the cube is aggregated.
									*/
									CALCULATE;      
									CREATE MEMBER CURRENTCUBE.[Measures].[Promedio_Env_X_Guias]
									AS [Measures].[Cant Piezas]/[Measures].[Cant Guias],
									VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Envios_Movilizados';      
									CREATE MEMBER CURRENTCUBE.[Measures].[Guias en Tiempo de Promesa]
									AS [Measures].[Tiempo Promesa Cumple Horas],
									FORMAT_STRING = "Standard",
									VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Envios_Movilizados';      
									CREATE MEMBER CURRENTCUBE.[Measures].[Guias en Tiempo de Promesa %]
									AS [Measures].[Guias en Tiempo de Promesa]/[Measures].[Cant Guias],
									FORMAT_STRING = "Percent",
									VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Envios_Movilizados';      

									CREATE MEMBER CURRENTCUBE.[Measures].[Promedio Tiempo Entrega (Hrs)]
									AS [Measures].[Tiempo En Entrega]/60/[Measures].[Cant Guias],
									FORMAT_STRING = "#,#.00",
									VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Envios_Movilizados';      
									CREATE MEMBER CURRENTCUBE.[Measures].[Eficiencia en Tiempo Entrega]
									AS /*13/06/2017 Cambio "Promedio Tiempo Oferta (Hrs) - CRC" por "Promedio Tiempo Oferta (Hrs) - REDOP", para que no sume 12 hrs. Avalado por Aldemar Sanchez*/
									Iif((([Measures].[Promedio Tiempo Oferta (Hrs) - REDOP])/[Measures].[Promedio Tiempo Entrega (Hrs)])&lt;=1, (([Measures].[Promedio Tiempo Oferta (Hrs) - REDOP])/[Measures].[Promedio Tiempo Entrega (Hrs)]),1),
									FORMAT_STRING = "Percent",
									VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Envios_Movilizados';      
									CREATE MEMBER CURRENTCUBE.[Measures].[Promedio Tiempo Oferta (Hrs) - CRC]
									AS ([Measures].[Tiempo En Oferta]+([Measures].[Cant Guias]*12))/[Measures].[Cant Guias],
									FORMAT_STRING = "#,#.00",
									VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Envios_Movilizados';      
									CREATE MEMBER CURRENTCUBE.[Measures].[Promedio Tiempo Oferta (Hrs) - REDOP]
									AS [Measures].[Tiempo En Oferta]/[Measures].[Cant Guias],
									FORMAT_STRING = "#,#.00",
									VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Envios_Movilizados';      

									CREATE MEMBER CURRENTCUBE.[Measures].[Cantidad Clientes]
									AS measures.Cantidad_Clientes,
									FORMAT_STRING = "#.##0,00;-#.##0,00",
									VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Envios_Movilizados';      
									CREATE MEMBER CURRENTCUBE.[Measures].[Guias Entr Tiempo de Promesa]
									AS ([TIEMPO_PROMESA_CUMPLE].[TIEMPO PROMESA CUMPLE H].&amp;[1.],[Measures].[Cant Guias TProm]),
									FORMAT_STRING = "Standard",
									VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Guias_Entreg_Tiempo_Promesa';      
									CREATE MEMBER CURRENTCUBE.[Measures].[Guias Entr Tiempo de Promesa %]
									AS [Measures].[Guias Entr Tiempo de Promesa]/[Measures].[Cant Guias TProm],
									VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Guias_Entreg_Tiempo_Promesa';      
									CREATE MEMBER CURRENTCUBE.[TIEMPO].[Year].Vig_Anterior
									AS ParallelPeriod([TIEMPO].[TIEMPO].[YEAR], 1, [TIEMPO].[TIEMPO].CurrentMember),
									VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Envios_Movilizados';      
									CREATE MEMBER CURRENTCUBE.[TIEMPO].[Year].Vig_Actual
									AS [TIEMPO].[TIEMPO].CurrentMember,
									VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Envios_Movilizados';      
									CREATE MEMBER CURRENTCUBE.[Measures].[%_Variacion_Relativa]
 AS CASE
									WHEN IsEmpty((ParallelPeriod([TIEMPO].[TIEMPO].[YEAR],1),[Measures].[Cant Piezas])) = TRUE THEN 0
									ELSE
									(([Measures].[Cant Piezas]-(ParallelPeriod([TIEMPO].[TIEMPO].[YEAR],1),[Measures].[Cant Piezas]))/(ParallelPeriod([TIEMPO].[TIEMPO].[YEAR],1),[Measures].[Cant Piezas]))+0
									END, 
FORMAT_STRING = "Percent", 
NON_EMPTY_BEHAVIOR = { [Cant Piezas] }, 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Envios_Movilizados';      
									CREATE MEMBER CURRENTCUBE.[Measures].[Variacion_Absoluta]
									AS [Measures].[Cant Piezas]-(ParallelPeriod([TIEMPO].[TIEMPO].[YEAR],1),[Measures].[Cant Piezas]),
									VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Envios_Movilizados';      
									CREATE MEMBER CURRENTCUBE.[Measures].[%_VR_Actual]
									AS ((SUM([TIEMPO].[TIEMPO].CurrentMember,[Measures].[Cant Piezas]) -
									SUM(ParallelPeriod([TIEMPO].[TIEMPO].[YEAR], 1, [TIEMPO].[TIEMPO].CurrentMember),[Measures].[Cant Piezas])
									)
									/
									SUM(ParallelPeriod([TIEMPO].[TIEMPO].[YEAR], 1, [TIEMPO].[TIEMPO].CurrentMember),[Measures].[Cant Piezas]))+0,
									FORMAT_STRING = "Percent",
									VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Envios_Movilizados';      
									CREATE MEMBER CURRENTCUBE.[Measures].[Riesgo_Actual]
									AS iif([Measures].[Cant Piezas] &lt; 0  ,  " Sin Informacion ",
									iif([Measures].[%_VR_Actual] &lt;= -1,    " Retirado        ",
									iif([Measures].[%_VR_Actual] &lt; -0.8,   " Retirado        ",
									iif([Measures].[%_VR_Actual] &lt; -0.25,  " Riesgo          ",
									iif([Measures].[%_VR_Actual] &lt; -0.1,   " Alerta          ",
									iif([Measures].[%_VR_Actual] &lt; -0.0001," Estable         ",
									iif([Measures].[%_VR_Actual] &gt; 0,      " Crecimiento     ",
									iif([Measures].[%_VR_Actual] = 0, " No Aplica       "
									, "                 "
									)))))))),
									VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Envios_Movilizados';      
									CREATE MEMBER CURRENTCUBE.[Measures].[Riesgo]
									AS iif([Measures].[Cant Piezas] &lt; 0  ,  " Sin Informacion ",
									iif([Measures].[%_Variacion_Relativa] &lt;= -1,    " Retirado        ",
									iif([Measures].[%_Variacion_Relativa] &lt; -0.8,   " Retirado        ",
									iif([Measures].[%_Variacion_Relativa] &lt; -0.25,  " Riesgo          ",
									iif([Measures].[%_Variacion_Relativa] &lt; -0.1,   " Alerta          ",
									iif([Measures].[%_Variacion_Relativa] &lt; -0.0001," Estable         ",
									iif([Measures].[%_Variacion_Relativa] &gt; 0,      " Crecimiento     ",
									iif([Measures].[%_Variacion_Relativa] = 0, " No Aplica       "
									, "                 "
									)))))))),
									VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Envios_Movilizados';      
									CREATE MEMBER CURRENTCUBE.[Measures].[Riesgo_Actual_num]
									AS iif([Measures].[Cant Piezas] = 0 or [Measures].[Cant Piezas] = null,  0,
									iif([Measures].[%_VR_Actual] &gt; 0.00001 , 6,
									iif([Measures].[%_VR_Actual] &gt; -0.1, 5,
									iif([Measures].[%_VR_Actual] &gt; -0.25,4,
									iif([Measures].[%_VR_Actual] &gt; -0.8, 3,
									iif([Measures].[%_VR_Actual] &gt; -1,   2,
									1
									)))))),
									VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Envios_Movilizados';      
									CREATE MEMBER CURRENTCUBE.[Measures].[Riesgo_Num]
									AS iif([Measures].[Cant Piezas] = 0 or [Measures].[Cant Piezas] = null,  0,
									iif([Measures].[%_Variacion_Relativa] &gt; 0.00001 , 6,
									iif([Measures].[%_Variacion_Relativa] &gt; -0.1, 5,
									iif([Measures].[%_Variacion_Relativa] &gt; -0.25,4,
									iif([Measures].[%_Variacion_Relativa] &gt; -0.8, 3,
									iif([Measures].[%_Variacion_Relativa] &gt; -1,   2,
									1
									)))))),
									VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Envios_Movilizados';      
									CREATE MEMBER CURRENTCUBE.[Measures].[Cant_Clientes_Retiro]
									AS iif([Measures].[Riesgo_Num] = 1 or [Measures].[Riesgo_Num] = 2, 1, 0),
									VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Envios_Movilizados';      
									CREATE MEMBER CURRENTCUBE.[Measures].[Cant_Clientes_Riesgo]
									AS iif([Measures].[Riesgo_Num] = 3 , 1, 0),
									VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Envios_Movilizados';      
									CREATE MEMBER CURRENTCUBE.[Measures].[Cant_Clientes_Alerta]
									AS iif([Measures].[Riesgo_Num] = 4 , 1, 0),
									VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Envios_Movilizados';      
									CREATE MEMBER CURRENTCUBE.[Measures].[Cant_Clientes_Estable]
									AS iif([Measures].[Riesgo_Num] = 5, 1, 0),
									VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Envios_Movilizados';      
									CREATE MEMBER CURRENTCUBE.[Measures].[Cant_Clientes_Crecimiento]
									AS iif([Measures].[Riesgo_Num] = 6, 1, 0),
									VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Envios_Movilizados';      
									CREATE MEMBER CURRENTCUBE.[Measures].[Cant_Clientes_Crecimiento_Actual]
									AS iif(SUM(ParallelPeriod([TIEMPO].[TIEMPO].[YEAR], 1, [TIEMPO].[TIEMPO].CurrentMember),[Measures].[Cant Piezas])&gt; 0,
									iif(SUM([TIEMPO].[TIEMPO].CurrentMember,[Measures].[Cant Piezas])&gt; 0,
									iif([Measures].[Riesgo_Actual_num] = 6 ,1,0),0),0),
									VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Envios_Movilizados';      
									CREATE MEMBER CURRENTCUBE.[Measures].[Cant_Clientes_Alerta_Actual]
									AS iif([Measures].[Riesgo_Actual_num] = 4 , 1, 0),
									VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Envios_Movilizados';      
									CREATE MEMBER CURRENTCUBE.[Measures].[Cant_Clientes_Desvinculado_Actual]
									AS iif(SUM([TIEMPO].[TIEMPO].CurrentMember,[Measures].[Cant Piezas]) = 0,
									iif(SUM(ParallelPeriod([TIEMPO].[TIEMPO].[YEAR], 1, [TIEMPO].[TIEMPO].CurrentMember),[Measures].[Cant Piezas]) &gt; 0, 1, 0),0),
									VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Envios_Movilizados';      
									CREATE MEMBER CURRENTCUBE.[Measures].[Cant_Clientes_Estable_Actual]
									AS iif([Measures].[Cant Piezas] &gt; 0,
									iif([Measures].[Riesgo_Actual_num] = 5, 1, 0),0),
									VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Envios_Movilizados';      
									CREATE MEMBER CURRENTCUBE.[Measures].[Cant_Clientes_Nuevo_Actual]
									AS iif(SUM([TIEMPO].[TIEMPO].CurrentMember,[Measures].[Cant Piezas]) &gt;0,
									iif(SUM(ParallelPeriod([TIEMPO].[TIEMPO].[YEAR], 1, [TIEMPO].[TIEMPO].CurrentMember),[Measures].[Cant Piezas]) = 0, 1, 0),0),
									VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Envios_Movilizados';      
									CREATE MEMBER CURRENTCUBE.[Measures].[Cant_Clientes_Retiro_Actual]
									AS iif([Measures].[Riesgo_Actual_num] = 2, 1, 0),
									VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Envios_Movilizados';      
									CREATE MEMBER CURRENTCUBE.[Measures].[Cant_Clientes_Riesgo_Actual]
									AS iif([Measures].[Riesgo_Actual_num] = 3 , 1, 0),
									VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Envios_Movilizados';      
									CREATE MEMBER CURRENTCUBE.[Measures].[Total_Clientes_Alerta]
									AS Sum({[CLIENTE_CON_MOVIMIENTO].[Nombre Cliente].Members}, [Measures].[Cant_clientes_alerta_Actual]),
									VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Envios_Movilizados';      
									CREATE MEMBER CURRENTCUBE.[Measures].[Total_Clientes_Crecimiento]
									AS Sum({[CLIENTE_CON_MOVIMIENTO].[Nombre Cliente].Members}, [Measures].[Cant_clientes_crecimiento_Actual]),
									VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Envios_Movilizados';      
									CREATE MEMBER CURRENTCUBE.[Measures].[Total_Clientes_Desvinculados]
									AS Sum({[CLIENTE_CON_MOVIMIENTO].[Nombre Cliente].Members}, [Measures].[Cant_clientes_desvinculado_Actual]),
									VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Envios_Movilizados';      
									CREATE MEMBER CURRENTCUBE.[Measures].[Total_Clientes_Estable]
									AS Sum({[CLIENTE_CON_MOVIMIENTO].[Nombre Cliente].Members}, [Measures].[Cant_clientes_estable_Actual]),
									VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Envios_Movilizados';      
									CREATE MEMBER CURRENTCUBE.[Measures].[Total_Clientes_Nuevos]
									AS Sum({[CLIENTE_CON_MOVIMIENTO].[Nombre Cliente].Members}, [Measures].[Cant_clientes_nuevo_Actual]),
									VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Envios_Movilizados';      
									CREATE MEMBER CURRENTCUBE.[Measures].[Total_Clientes_Retiro]
									AS Sum({[CLIENTE_CON_MOVIMIENTO].[Nombre Cliente].Members}, [Measures].[Cant_clientes_retiro_Actual]),
									VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Envios_Movilizados';      
									CREATE MEMBER CURRENTCUBE.[Measures].[Total_Clientes_Riesgo]
									AS Sum({[CLIENTE_CON_MOVIMIENTO].[Nombre Cliente].Members}, [Measures].[Cant_clientes_riesgo_Actual]),
									VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Envios_Movilizados';      
									CREATE MEMBER CURRENTCUBE.[Measures].[%_VR Contado]
									AS CASE
									WHEN IsEmpty((ParallelPeriod([TIEMPO].[TIEMPO].[YEAR],1),[Measures].[CANT PIEZAS - CONTADOS])) = TRUE THEN 0
									ELSE
									(([Measures].[CANT PIEZAS - CONTADOS]-(ParallelPeriod([TIEMPO].[TIEMPO].[YEAR],1),[Measures].[CANT PIEZAS - CONTADOS]))/(ParallelPeriod([TIEMPO].[TIEMPO].[YEAR],1),[Measures].[CANT PIEZAS - CONTADOS]))+0
									END,
									FORMAT_STRING = "Percent",
									NON_EMPTY_BEHAVIOR = { [CANT PIEZAS - CONTADOS] },
									VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Envios_Movilizados_Contados';      

									CREATE MEMBER CURRENTCUBE.[Measures].[Cant_Ciudades_Origen]
									AS measures.Cantidad_Ciudades_Origen,
									VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Envios_Movilizados';      

									CREATE MEMBER CURRENTCUBE.[Measures].[Cant_Ciudades_Destino]
									AS measures.Cantidad_Ciudades_Destino,
									VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Envios_Movilizados';      

									CREATE MEMBER CURRENTCUBE.[Measures].Tiempo_promedio_Guia_Transm
									AS [Measures].[Tiempo Transmision]/[Measures].[Cant Guia],
									VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Envios_Movilizados_Contados';      

									CREATE MEMBER CURRENTCUBE.[Measures].Cant_CDS
									AS Measures.Cantidad_CDS,
									VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Envios_Movilizados_Contados';      

									/* -------------------------------------------------------- */

									CREATE MEMBER CURRENTCUBE.[Measures].Guias_Movilizadas_SIN_Facturar
									AS [Measures].[Cant Guias Movilizadas]-[Measures].[Cant Guias Facturadas],
									VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Guias_Movilizadas_SIN_Facturar';      

									CREATE MEMBER CURRENTCUBE.[Measures].Participacion_Guias_SIN_Facturar
									AS iif( [Measures].[Cant Guias Movilizadas] = null or [Measures].[Cant Guias Movilizadas] = 0 , null ,
									[Measures].[Guias_Movilizadas_SIN_Facturar] / [Measures].[Cant Guias Movilizadas] ),
									FORMAT_STRING = "Percent",
									VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Guias_Movilizadas_SIN_Facturar';      

									CREATE MEMBER CURRENTCUBE.[Measures].Impacto
									AS [Measures].[Guias_Movilizadas_SIN_Facturar]*[Measures].[Participacion_Guias_SIN_Facturar],
									VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Guias_Movilizadas_SIN_Facturar';      


									/* -------------------------------------------------------- */

									CREATE MEMBER CURRENTCUBE.[Measures].[Porcentaje Aprobacion]
									AS [Measures].[Cantidad Aprobada]/[Measures].[Cantidad Solicitada],
									VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Provision_Guias';      

									CREATE MEMBER CURRENTCUBE.[Measures].[Tiempo Promedio Atencion (hrs)]
									AS [Measures].[Tiempo Atencion]/60/[Measures].[Cantidad Solic],
									FORMAT_STRING = "#,#.00",
									VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Provision_Guias';      

									CREATE MEMBER CURRENTCUBE.[Measures].[Cantidad Stock]
									AS [Measures].[Cantidad Aprobada]-(ParallelPeriod([TIEMPO].[TIEMPO].[MONTH],1),[Measures].[Cant Guias]),
									FORMAT_STRING = "#,#.00",
									VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Provision_Guias';      

									CREATE MEMBER CURRENTCUBE.[Measures].[Porcentaje Stock]
									AS ([Measures].[Cantidad Aprobada]-[Measures].[Cant Guias])/[Measures].[Cantidad Aprobada],
									FORMAT_STRING = "Percent",
									VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Provision_Guias';      

									Create Set CurrentCube.[Tipo Guias para provision]
									As {
									[TIPO GUIA].[Nombre Tipoguia].&amp;[2],  -- GUIA CONTADO PREIMPRESA
									[TIPO GUIA].[Nombre Tipoguia].&amp;[1],  -- GUIA CREDITO PREIMPRESA
									[TIPO GUIA].[Nombre Tipoguia].&amp;[3],  -- REMESA TERRESTRE DE CARGA PREIMPRESA
									[TIPO GUIA].[Nombre Tipoguia].&amp;[22], -- GUIA CREDITO VIRTUAL STICKER
									[TIPO GUIA].[Nombre Tipoguia].&amp;[4],  -- GUIA VALORES PREIMPRESA
									[TIPO GUIA].[Nombre Tipoguia].&amp;[6],  -- GUIA INTERNA
									[TIPO GUIA].[Nombre Tipoguia].&amp;[21], -- STICKER CONTADO
									[TIPO GUIA].[Nombre Tipoguia].&amp;[10], -- FACTURA (CRED)
									[TIPO GUIA].[Nombre Tipoguia].&amp;[38], -- GUIA CREDITO PREIMPRESA PQR
									[TIPO GUIA].[Nombre Tipoguia].&amp;[12], -- REMISION DIAN
									[TIPO GUIA].[Nombre Tipoguia].&amp;[5],  -- FACTURA EMP-EMBALAJE - BOGOTA
									[TIPO GUIA].[Nombre Tipoguia].&amp;[9],  -- GUIA INTERNACIONAL MIAMI
									[TIPO GUIA].[Nombre Tipoguia].&amp;[11], -- FACTURA CREDITO (IVA)
									[TIPO GUIA].[Nombre Tipoguia].&amp;[8],  -- FACTURA EMP-EMBALAJE - BUCARAMANGA
									[TIPO GUIA].[Nombre Tipoguia].&amp;[7],  -- FACTURA EMP-EMBALAJE - MEDELLIN
									[TIPO GUIA].[Nombre Tipoguia].&amp;[28], -- GUIA INTERNACIONAL PERU
									[TIPO GUIA].[Nombre Tipoguia].&amp;[25], -- GUIA INTERNACIONAL PANAMA
									[TIPO GUIA].[Nombre Tipoguia].&amp;[24], -- FACTURA DE VENTA COMERCIALIZADORA
									[TIPO GUIA].[Nombre Tipoguia].&amp;[37]  -- GUIA CREDITO PREIMPRESA DIAN
									}
									,
									Display_Folder = 'Filtros';      
									CREATE MEMBER CURRENTCUBE.[Measures].[RED OPE Promedio Oferta Hrs]
									AS [Measures].[Tiempo Oferta RED OPE Hrs] / [Measures].[Cant Guias TProm RED],
									FORMAT_STRING = "#,#.00",
									VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Guias_Entreg_Tiempo_Promesa_RED';      
									CREATE MEMBER CURRENTCUBE.[Measures].[RED OPE Promedio Ejecutado Hrs]
									AS [Measures].[Tiempo Ejecutado Hrs] / [Measures].[Cant Guias TProm RED],
									FORMAT_STRING = "#,#.00",
									VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Guias_Entreg_Tiempo_Promesa_RED';      
									CREATE MEMBER CURRENTCUBE.[Measures].[RED OPE Guias Cumpliendo]
									AS ([Measures].[Cant Guias TProm RED],[CUMPLE TIEMPO PROMESA].[CUMPLE].&amp;[SI] ) / [Measures].[Cant Guias TProm RED],
									FORMAT_STRING = "Percent",
									NON_EMPTY_BEHAVIOR = { [Cant Guias TProm RED] },
									VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Guias_Entreg_Tiempo_Promesa_RED';   
CREATE MEMBER CURRENTCUBE.[Measures].[RED OPE Guias Cumpliendo Depurada]
 AS ([Measures].[Cant Guias TProm RED_V2], [CUMPLE TIEMPO PROMESA DEPURADA].[CUMPLE].&amp;[SI] ) /[Measures].[Cant Guias TProm RED_V2], 
FORMAT_STRING = "Percent", 
NON_EMPTY_BEHAVIOR = { [Cant Guias TProm RED_V2] }, 
VISIBLE = 1  ;   
CREATE MEMBER CURRENTCUBE.[Measures].[RED OPE Guias Cumpliendo Acida]
 AS ([Measures].[Cant Guias TProm RED_V2], [CUMPLE TIEMPO PROMESA ACIDA].[CUMPLE].&amp;[SI]  ) /[Measures].[Cant Guias TProm RED_V2], 
FORMAT_STRING = "Percent", 
NON_EMPTY_BEHAVIOR = { [Cant Guias TProm RED_V2] }, 
VISIBLE = 1;   
CREATE MEMBER CURRENTCUBE.[Measures].[RED OPE Responsabilidad Cliente]
 AS ([Measures].[Cant Guias TProm RED_V2],[RESPONSABLE].[ID RESPONSABLE].&amp;[C] ) / [Measures].[Cant Guias TProm RED_V2], 
FORMAT_STRING = "Percent", 
NON_EMPTY_BEHAVIOR = { [Cant Guias TProm RED_V2] }, 
VISIBLE = 1;   
CREATE MEMBER CURRENTCUBE.[Measures].[RED OPE Responsabilidad Externa]
 AS ([Measures].[Cant Guias TProm RED_V2],[RESPONSABLE].[ID RESPONSABLE].&amp;[E] ) /[Measures].[Cant Guias TProm RED_V2], 
FORMAT_STRING = "Percent", 
NON_EMPTY_BEHAVIOR = { [Cant Guias TProm RED_V2] }, 
VISIBLE = 1;   
CREATE MEMBER CURRENTCUBE.[Measures].[RED OPE Responsabilidad Servientrega]
 AS ([Measures].[Cant Guias TProm RED_V2],[RESPONSABLE].[ID RESPONSABLE].&amp;[S] ) / [Measures].[Cant Guias TProm RED_V2], 
FORMAT_STRING = "Percent", 
NON_EMPTY_BEHAVIOR = { [Cant Guias TProm RED_V2] }, 
VISIBLE = 1; </Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
