            <xs:element name="PQR_EMPLEADOS_REGISTRO" msprop:IsLogical="True" msprop:FriendlyName="PQR_EMPLEADOS_REGISTRO" msprop:DbTableName="PQR_EMPLEADOS_REGISTRO" msprop:TableType="View" msprop:Description="PQR_EMPLEADOS_REGISTRO" msprop:QueryDefinition="SELECT DISTINCT &#xD;&#xA;                         C.LOGIN_EMPLEADO_REGISTRO, CASE WHEN C.LOGIN_EMPLEADO_REGISTRO = 'USRINTERNET' THEN 'USRINTERNET' ELSE ISNULL(E.NOMBRE_EMPLEADO, &#xD;&#xA;                         'NO') + ' ' + ISNULL(E.APELLIDO_EMPLEADO, 'DISPONIBLE') END AS NOMBRE_EMPLEADO&#xD;&#xA;FROM            FAC.PQR_COMPENSACIONES AS C LEFT OUTER JOIN&#xD;&#xA;                         DIM.EMPLEADOS AS E ON LTRIM(RTRIM(C.LOGIN_EMPLEADO_REGISTRO)) = LTRIM(RTRIM(E.LOGIN_EMPLEADO))" msprop:QueryBuilder="SpecificQueryBuilder">
