            <xs:element name="PQR_GEOGRAFIA" msprop:IsLogical="True" msprop:FriendlyName="PQR_GEOGRAFIA" msprop:DbTableName="PQR_GEOGRAFIA" msprop:TableType="View" msprop:Description="PQR_GEOGRAFIA" msprop:QueryDefinition="SELECT        C.ID_PAIS, P.NOMBRE_PAIS, C.ID_REGIONAL, R.NOMBRE_REGIONAL, C.ID_DEPARTAMENTO, D.NOMBRE_DEPARTAMENTO, C.ID_CIUDAD, &#xD;&#xA;                         C.NOMBRE_CIUDAD&#xD;&#xA;FROM            DIM.CIUDADES AS C INNER JOIN&#xD;&#xA;                         DIM.PAISES AS P ON P.ID_PAIS = C.ID_PAIS INNER JOIN&#xD;&#xA;                         DIM.REGIONALES_PAIS AS R ON R.ID_REGIONAL = C.ID_REGIONAL INNER JOIN&#xD;&#xA;                         DIM.DEPARTAMENTOS AS D ON D.ID_DEPARTAMENTO = C.ID_DEPARTAMENTO" msprop:QueryBuilder="SpecificQueryBuilder">
