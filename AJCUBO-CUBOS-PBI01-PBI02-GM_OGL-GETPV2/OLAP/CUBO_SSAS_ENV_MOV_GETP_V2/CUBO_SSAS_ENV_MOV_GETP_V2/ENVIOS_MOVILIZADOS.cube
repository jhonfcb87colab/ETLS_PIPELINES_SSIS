        <Dimension xsi:type="RegularMeasureGroupDimension" dwd:design-time-name="4ec5dba9-0021-4a8c-b67c-e81535987de3">
          <CubeDimensionID>VW PRUEBAS ENTREGA</CubeDimensionID>
          <Attributes>
            <Attribute dwd:design-time-name="723da42c-d614-49e7-abfb-f91ba8e22336">
              <AttributeID>ID TIPO ENTREGA</AttributeID>
              <KeyColumns>
                <KeyColumn dwd:design-time-name="268dd59f-8fb3-4c50-a254-dd4d40d58cbd">
                  <DataType>Integer</DataType>
                  <Source xsi:type="ColumnBinding" dwd:design-time-name="570f0882-2736-4674-a7d1-a0587fecd75b">
                    <TableID>FAC_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2</TableID>
                    <ColumnID>ID_TIPO_ENTREGA</ColumnID>
                  </Source>
                </KeyColumn>
              </KeyColumns>
              <Type>Granularity</Type>
            </Attribute>
            <Attribute dwd:design-time-name="fbb7f665-dd29-4f59-9514-a4511fa48c3a">
              <AttributeID>NOMBRE TIPO ENTREGA</AttributeID>
              <KeyColumns>
                <KeyColumn dwd:design-time-name="ccb23208-ec86-402e-bfc2-0a6b7b14d7a0">
                  <DataType>WChar</DataType>
                  <DataSize>15</DataSize>
                  <Source xsi:type="ColumnBinding" dwd:design-time-name="b52831a8-aeef-409d-a42d-42280379ab95">
                    <TableID>DIM_VW_PRUEBAS_ENTREGA</TableID>
                    <ColumnID>NOMBRE_TIPO_ENTREGA</ColumnID>
                  </Source>
                </KeyColumn>
              </KeyColumns>
