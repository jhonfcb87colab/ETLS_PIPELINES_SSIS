                  <DataType>WChar</DataType>
                  <DataSize>2</DataSize>
                  <NullProcessing>UnknownMember</NullProcessing>
                  <Source xsi:type="ColumnBinding" dwd:design-time-name="45acd0cc-5d5d-41de-9f5f-b49c798fd4a1">
