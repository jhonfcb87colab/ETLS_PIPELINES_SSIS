              <AttributeID>Nombre Concepto</AttributeID>
              <KeyColumns>
                <KeyColumn dwd:design-time-name="ba913ce2-d9aa-4699-89ee-978f64e663f5">
                  <DataType>WChar</DataType>
                  <DataSize>18</DataSize>
                  <Source xsi:type="ColumnBinding" dwd:design-time-name="604efc62-bb4b-475c-a551-92800836884c">
                    <TableID>DIM_GEOGRAFIA_CONCEPTO</TableID>
