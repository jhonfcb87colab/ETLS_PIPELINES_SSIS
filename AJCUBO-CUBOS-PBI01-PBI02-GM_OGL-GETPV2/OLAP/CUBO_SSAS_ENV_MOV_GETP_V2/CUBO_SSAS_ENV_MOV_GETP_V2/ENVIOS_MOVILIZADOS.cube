                <KeyColumn dwd:design-time-name="0a0b86c1-9298-487d-9802-50799a3efbb6">
                  <DataType>WChar</DataType>
                  <DataSize>32</DataSize>
                  <NullProcessing>UnknownMember</NullProcessing>
                  <Source xsi:type="ColumnBinding" dwd:design-time-name="4286b70c-4402-4b42-8c52-bfcfb26615b6">
                    <TableID>FAC_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2</TableID>
