  <MdxScripts>
    <MdxScript>
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>2026-11-12T21:59:50.2Z</CreatedTimestamp>
      <LastSchemaUpdate>2026-11-18T21:23:47.296667Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>/*
The CALCULATE command controls the aggregation of leaf cells in the cube.
If the CALCULATE command is deleted or modified, the data within the cube is affected.
You should edit this command only if you manually specify how the cube is aggregated.
*/
CALCULATE;            
CREATE MEMBER CURRENTCUBE.[Measures].[Eficiencia Recoleccion Guia Asignada]
 AS ([GM RECOLECCION ASIGNADA EZU HOY].[GM MARCA].&amp;[SI],[Measures].[Cantidad Solicitudes])/([GM RECOLECCION ASIGNADA].[GM MARCA].&amp;[SI],[Measures].[Cantidad Solicitudes]), 
FORMAT_STRING = "Percent", 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'EFICIENCIA EN RECOLECCION';             
CREATE MEMBER CURRENTCUBE.[Measures].[Porc Eficiencia Recoleccion]
 AS ([GM RECOLECCION ESTADOS].[GRUPO EFECTIVIDAD].&amp;[2],[Measures].[Cantidad Solicitudes])/[Measures].[Cantidad Solicitudes], 
FORMAT_STRING = "Percent", 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'EFICIENCIA EN RECOLECCION';           
CREATE MEMBER CURRENTCUBE.[Measures].[Efectividad 6 am a 3 pm]
 AS (
([GM ZONA URBANA].[Descripcion Tipo Zona Urba].&amp;[CARGA],[GM HORA DISTRIBUCION].[HORA REPORTE].&amp;[6],[Measures].[Cantidad Guias])
+
([GM ZONA URBANA].[Descripcion Tipo Zona Urba].&amp;[CARGA],[GM HORA DISTRIBUCION].[HORA REPORTE].&amp;[7],[Measures].[Cantidad Guias])
+
([GM ZONA URBANA].[Descripcion Tipo Zona Urba].&amp;[CARGA],[GM HORA DISTRIBUCION].[HORA REPORTE].&amp;[8],[Measures].[Cantidad Guias])
+
([GM ZONA URBANA].[Descripcion Tipo Zona Urba].&amp;[CARGA],[GM HORA DISTRIBUCION].[HORA REPORTE].&amp;[9],[Measures].[Cantidad Guias])
+
([GM ZONA URBANA].[Descripcion Tipo Zona Urba].&amp;[CARGA],[GM HORA DISTRIBUCION].[HORA REPORTE].&amp;[10],[Measures].[Cantidad Guias])
+
([GM ZONA URBANA].[Descripcion Tipo Zona Urba].&amp;[CARGA],[GM HORA DISTRIBUCION].[HORA REPORTE].&amp;[11],[Measures].[Cantidad Guias])
+
([GM ZONA URBANA].[Descripcion Tipo Zona Urba].&amp;[CARGA],[GM HORA DISTRIBUCION].[HORA REPORTE].&amp;[12],[Measures].[Cantidad Guias])
+
([GM ZONA URBANA].[Descripcion Tipo Zona Urba].&amp;[CARGA],[GM HORA DISTRIBUCION].[HORA REPORTE].&amp;[13],[Measures].[Cantidad Guias])
+
([GM ZONA URBANA].[Descripcion Tipo Zona Urba].&amp;[CARGA],[GM HORA DISTRIBUCION].[HORA REPORTE].&amp;[14],[Measures].[Cantidad Guias])
)
/ 
([GM ZONA URBANA].[Descripcion Tipo Zona Urba].&amp;[CARGA],[Measures].[Cantidad Guias])

/*Aggregate({[GM HORA DISTRIBUCION].[HORA REPORTE].&amp;[6],[GM HORA DISTRIBUCION].[HORA REPORTE].&amp;[7],[GM HORA DISTRIBUCION].[HORA REPORTE].&amp;[8],[GM HORA DISTRIBUCION].[HORA REPORTE].&amp;[9],[GM HORA DISTRIBUCION].[HORA REPORTE].&amp;[10],[GM HORA DISTRIBUCION].[HORA REPORTE].&amp;[11],[GM HORA DISTRIBUCION].[HORA REPORTE].&amp;[12],[GM HORA DISTRIBUCION].[HORA REPORTE].&amp;[13],[GM HORA DISTRIBUCION].[HORA REPORTE].&amp;[14],[GM HORA DISTRIBUCION].[HORA REPORTE].&amp;[15]},[Measures].[Cantidad Guias]) 

/ ([Measures].[Cantidad Guias])*/, 
FORMAT_STRING = "Percent", 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'OPORTUNIDAD REGISTRO GESTION EN LINEA';         
CREATE MEMBER CURRENTCUBE.[Measures].[Efectividad 6 a 6]
 AS (
([GM ZONA URBANA].[Descripcion Tipo Zona Urba].&amp;[CARGA],[GM HORA DISTRIBUCION].[GRUPO GESTION EN LINEA].&amp;[1],[Measures].[Cantidad Guias])
+
([GM ZONA URBANA].[Descripcion Tipo Zona Urba].&amp;[CARGA],[GM HORA DISTRIBUCION].[GRUPO GESTION EN LINEA].&amp;[2],[Measures].[Cantidad Guias])
+
([GM ZONA URBANA].[Descripcion Tipo Zona Urba].&amp;[CARGA],[GM HORA DISTRIBUCION].[GRUPO GESTION EN LINEA].&amp;[3],[Measures].[Cantidad Guias])
+
([GM ZONA URBANA].[Descripcion Tipo Zona Urba].&amp;[CARGA],[GM HORA DISTRIBUCION].[GRUPO GESTION EN LINEA].&amp;[4],[Measures].[Cantidad Guias])
+
([GM ZONA URBANA].[Descripcion Tipo Zona Urba].&amp;[CARGA],[GM HORA DISTRIBUCION].[GRUPO GESTION EN LINEA].&amp;[5],[Measures].[Cantidad Guias])
+
([GM ZONA URBANA].[Descripcion Tipo Zona Urba].&amp;[CARGA],[GM HORA DISTRIBUCION].[GRUPO GESTION EN LINEA].&amp;[6],[Measures].[Cantidad Guias])
+
([GM ZONA URBANA].[Descripcion Tipo Zona Urba].&amp;[CARGA],[GM HORA DISTRIBUCION].[GRUPO GESTION EN LINEA].&amp;[7],[Measures].[Cantidad Guias])
)
/ 
([GM ZONA URBANA].[Descripcion Tipo Zona Urba].&amp;[CARGA],[Measures].[Cantidad Guias]), 
FORMAT_STRING = "Percent", 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'OPORTUNIDAD REGISTRO GESTION EN LINEA';         
CREATE MEMBER CURRENTCUBE.[Measures].[Efectividad 6 a 2]
 AS (
([GM ZONA URBANA].[Descripcion Tipo Zona Urba].&amp;[CARGA],[GM HORA DISTRIBUCION].[HORA REPORTE].&amp;[6],[Measures].[Cantidad Guias])
+
([GM ZONA URBANA].[Descripcion Tipo Zona Urba].&amp;[CARGA],[GM HORA DISTRIBUCION].[HORA REPORTE].&amp;[7],[Measures].[Cantidad Guias])
+
([GM ZONA URBANA].[Descripcion Tipo Zona Urba].&amp;[CARGA],[GM HORA DISTRIBUCION].[HORA REPORTE].&amp;[8],[Measures].[Cantidad Guias])
+
([GM ZONA URBANA].[Descripcion Tipo Zona Urba].&amp;[CARGA],[GM HORA DISTRIBUCION].[HORA REPORTE].&amp;[9],[Measures].[Cantidad Guias])
+
([GM ZONA URBANA].[Descripcion Tipo Zona Urba].&amp;[CARGA],[GM HORA DISTRIBUCION].[HORA REPORTE].&amp;[10],[Measures].[Cantidad Guias])
+
([GM ZONA URBANA].[Descripcion Tipo Zona Urba].&amp;[CARGA],[GM HORA DISTRIBUCION].[HORA REPORTE].&amp;[11],[Measures].[Cantidad Guias])
+
([GM ZONA URBANA].[Descripcion Tipo Zona Urba].&amp;[CARGA],[GM HORA DISTRIBUCION].[HORA REPORTE].&amp;[12],[Measures].[Cantidad Guias])
+
([GM ZONA URBANA].[Descripcion Tipo Zona Urba].&amp;[CARGA],[GM HORA DISTRIBUCION].[HORA REPORTE].&amp;[13],[Measures].[Cantidad Guias])
/*+
([GM ZONA URBANA].[Descripcion Tipo Zona Urba].&amp;[CARGA],[GM HORA DISTRIBUCION].[HORA REPORTE].&amp;[14],[Measures].[Cantidad Guias])*/
)
/ 
([GM ZONA URBANA].[Descripcion Tipo Zona Urba].&amp;[CARGA],[Measures].[Cantidad Guias]), 
FORMAT_STRING = "Percent", 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'OPORTUNIDAD REGISTRO GESTION EN LINEA';  
CREATE MEMBER CURRENTCUBE.[Measures].[Efectividad 0 a 24]
 AS (
  ([GM HORA DISTRIBUCION].[GRUPO GESTION EN LINEA].&amp;[1],[Measures].[Cantidad Guias])
+ ([GM HORA DISTRIBUCION].[GRUPO GESTION EN LINEA].&amp;[2],[Measures].[Cantidad Guias])
+ ([GM HORA DISTRIBUCION].[GRUPO GESTION EN LINEA].&amp;[3],[Measures].[Cantidad Guias])
+ ([GM HORA DISTRIBUCION].[GRUPO GESTION EN LINEA].&amp;[4],[Measures].[Cantidad Guias])
+ ([GM HORA DISTRIBUCION].[GRUPO GESTION EN LINEA].&amp;[5],[Measures].[Cantidad Guias])
+ ([GM HORA DISTRIBUCION].[GRUPO GESTION EN LINEA].&amp;[6],[Measures].[Cantidad Guias])
+ ([GM HORA DISTRIBUCION].[GRUPO GESTION EN LINEA].&amp;[7],[Measures].[Cantidad Guias])
+ ([GM HORA DISTRIBUCION].[GRUPO GESTION EN LINEA].&amp;[8],[Measures].[Cantidad Guias])
+ ([GM HORA DISTRIBUCION].[GRUPO GESTION EN LINEA].&amp;[9],[Measures].[Cantidad Guias])
+ ([GM HORA DISTRIBUCION].[GRUPO GESTION EN LINEA].&amp;[10],[Measures].[Cantidad Guias])
+ ([GM HORA DISTRIBUCION].[GRUPO GESTION EN LINEA].&amp;[11],[Measures].[Cantidad Guias])
