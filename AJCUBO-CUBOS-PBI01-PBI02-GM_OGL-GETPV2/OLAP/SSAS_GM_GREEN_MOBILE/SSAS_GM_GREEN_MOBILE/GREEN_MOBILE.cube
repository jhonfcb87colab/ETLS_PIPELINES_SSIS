/ 
([Measures].[Cantidad Guias]), 
FORMAT_STRING = "Percent", 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'OPORTUNIDAD REGISTRO GESTION EN LINEA'  ; </Text>
