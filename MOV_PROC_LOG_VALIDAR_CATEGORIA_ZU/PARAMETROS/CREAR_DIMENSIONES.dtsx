                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT		[MET].[NOMBRE_MEDTRANS] AS [MEDIO_TRANSPORTE],
			[MT].[NOMBRE_MODTRANS] AS [MODO_TRANSPORTE],
			[TV].[NOMBRE_TIPO_VEHI] AS [TIPO_VEHICULO],
			[V].[PLACA_VEHICULO],
			[ET].[NOMBRE_EMPRETRANSP] AS [EMPRESA_TRANSPORTADORA],
			[T].[NOMBRE_TERCERO] AS [TERCERO],
			[V].[CAPACIDAD_PESO_VEHICULO],
			[V].[CAPACIDAD_VOLU_VEHICULO]
FROM		[PAR].[VEHICULOS] [V] WITH (NOLOCK)
			LEFT JOIN	[PAR].[EMPRESA_TRANSPORTADORA] [ET] WITH (NOLOCK)
					ON	[ET].[ID_EMPRETRANSP] = [V].[ID_EMPRETRANSP]
			LEFT JOIN	[PAR].[TIPOSVEHICULOS] [TV] WITH (NOLOCK)
					ON	[TV].[ID_TIPO_VEHI] = [V].[ID_TIPO_VEHI]
			LEFT JOIN	[PAR].[MODOTRANSPORTE] [MT] WITH (NOLOCK)
					ON	[MT].[ID_MODTRANS] = [TV].[ID_MODTRANS]
			LEFT JOIN	[PAR].[MEDIOTRANSPORTE] MET WITH (NOLOCK)
					ON	[MET].[ID_MEDTRANS] = [MT].[ID_MEDTRANS]
			LEFT JOIN	[PAR].[TERCEROS] [T] WITH (NOLOCK)
					ON	[T].[ID_TERCERO] = [V].[ID_TERCERO]
WHERE		[V].[ID_PAIS] = 1</property>
                    <property
                      dataType="System.String"
                      description="The variable that contains the SQL command to be executed."
                      name="SqlCommandVariable"></property>
                    <property
                      dataType="System.Int32"
                      description="Specifies the column code page to use when code page information is unavailable from the data source."
                      name="DefaultCodePage">1252</property>
                    <property
                      dataType="System.Boolean"
