                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT		[CP].[ID_CATEGPROD] AS [ID_CATEGORIA],
			[P].[ID_PRODUCTO],
			[SP].[ID_SUBPRODUCTO],
			[CP].[NOMBRE_CATEGPROD] AS [CATEGORIA],
			[P].[NOMBRE_PRODUCTO] AS [PRODUCTO],
			[SP].[NOMBRE_SUBPRODUCTO] AS [SUBPRODUCTO]
FROM		[PAR].[CATEGORIA_PRODUCTO] [CP] WITH (NOLOCK)
			INNER JOIN	[PAR].[PRODUCTOS] [P] WITH (NOLOCK)
					ON	[P].[ID_CATEGPROD] = [CP].[ID_CATEGPROD]
			INNER JOIN	[PAR].[SUBPRODUCTOS] [SP] WITH (NOLOCK)
					ON	[SP].[ID_PRODUCTO] = [P].[ID_PRODUCTO]</property>
