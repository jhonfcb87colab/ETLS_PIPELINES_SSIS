                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT		[D].[ID_DIVISION],
			[D].[NOMBRE_DIVISION] AS [DIVISION],
			[TD].[ID_TIPO_DIVISION],
			[TD].[NOMBRE_TIPO_DIVISION] AS [TIPO_DIVISION],
			[C].[ID_CIUDAD],
			[C].[NOMBRE_CIUDAD],
			[DEP].[ID_DEPARTAMENTO],
			[DEP].[NOMBRE_DEPARTAMENTO] AS [DEPARTAMENTO],
			[R].[ID_REGIONAL],
			[R].[NOMBRE_REGIONAL] AS [REGIONAL]
FROM		[PAR].[DIVISIONES] [D] WITH (NOLOCK)
			LEFT JOIN	[PAR].[TIPOSDIVISION] [TD] WITH (NOLOCK)
					ON	[TD].[ID_TIPO_DIVISION] = [D].[ID_TIPO_DIVISION]
			LEFT JOIN	[PAR].[CIUDADES] [C] WITH (NOLOCK)
					ON	[C].[ID_CIUDAD] = [D].[ID_CIUDAD]
			LEFT JOIN	[PAR].[DEPARTAMENTOS] [DEP] WITH (NOLOCK)
					ON	[DEP].[ID_DEPARTAMENTO] = [C].[ID_DEPARTAMENTO]
			LEFT JOIN	[PAR].[REGIONALES_PAIS] [R] WITH (NOLOCK)
					ON	[R].[ID_REGIONAL] = [C].[ID_REGIONAL]</property>
