                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT		[C].[ID_CLIENTE],
			[C].[NOMBRE_CLIENTE] AS [NOMBRE],
			[C].[APELLIDO_CLIENTE] AS [APELLIDO],
			[C].[RAZON_SOCIAL_CORTA],
			[T].[NOMBRE_TIPO_CLIE] AS [TIPO_CLIENTE]
FROM		[PAR].[CLIENTES] [C] WITH (NOLOCK)			
			LEFT JOIN	[PAR].[TIPOSCLIENTES] [T] WITH (NOLOCK)
					ON	[T].[ID_TIPO_CLIENTE] = [C].[ID_TIPO_CLIENTE]
WHERE		[C].[ID_ESTADO_CLIENTE] = 1</property>
                    <property
                      dataType="System.String"
                      description="The variable that contains the SQL command to be executed."
                      name="SqlCommandVariable"></property>
