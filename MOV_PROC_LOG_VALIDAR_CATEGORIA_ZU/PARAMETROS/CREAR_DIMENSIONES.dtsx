                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT		RTRIM( CAST( [P].[ID_PROCESO] AS varchar ) ) + '-' + RTRIM( CAST( [I].[ID_CONCEPTO] AS varchar ) ) AS [ID],
			[P].[ID_PROCESO],
			[I].[ID_CONCEPTO],
			[P].[NOMBRE_PROCESO_LOG] AS [PROCESO_LOGISTICO],
			[I].[NOMBRE_CONCEPTO] AS [CONCEPTO]
FROM		[PAR].[ITEM_CONCEPTO] [I] WITH (NOLOCK)
			LEFT JOIN	[PAR].[PROCESOS] [P] WITH (NOLOCK)
					ON	[P].[ID_PROCESO] = [I].[ID_PROCESO]
UNION
SELECT		RTRIM( CAST( [P].[ID_PROCESO] AS varchar ) ) AS [ID],
			[P].[ID_PROCESO],
			NULL AS [ID_CONCEPTO],
			[P].[NOMBRE_PROCESO_LOG] AS [PROCESO_LOGISTICO],
			NULL AS [CONCEPTO]
FROM		[PAR].[PROCESOS] [P] WITH (NOLOCK)</property>
