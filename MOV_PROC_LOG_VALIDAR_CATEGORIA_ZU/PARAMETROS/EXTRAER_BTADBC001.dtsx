                        <property
                          dataType="System.String"
                          description="The SQL command to be executed."
                          name="SqlCommand"
                          UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">WITH DIV_GEO AS (
 SELECT 
  ROW_NUMBER() OVER(PARTITION BY ID_PAIS,ID_CIUDAD,ID_DIVISION ORDER BY LOGIN_CREATED ASC) AS #ROW
 ,ID_DIVISIONGEOREFERENCIADA, ID_PAIS, ID_CIUDAD, ID_DIVISION, 
  LATITUDE, LONGITUDE, LOGIN_CREATED, LOGIN_UPDATED, DATE_CREATED, DATE_UPDATED
 FROM [dbo].[DIVISIONES_GEORREFERENCIADAS] WITH (NOLOCK)
  )
  SELECT     ID_DIVISIONGEOREFERENCIADA, ID_PAIS, ID_CIUDAD, ID_DIVISION, 
  LATITUDE, LONGITUDE, LOGIN_CREATED, LOGIN_UPDATED, DATE_CREATED, DATE_UPDATED
FROM DIV_GEO WITH (NOLOCK)
WHERE #ROW = 1</property>
