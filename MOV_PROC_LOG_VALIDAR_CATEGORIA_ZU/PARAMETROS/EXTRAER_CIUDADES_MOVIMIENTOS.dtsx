              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT 	C.ID_PAIS,
	C.ID_CIUDAD,
	C.NOMBRE_CIUDAD + ' (' + CONVERT(CHAR(2),C.ID_REGIONAL) + '-' + CONVERT(CHAR(4),C.ID_CIUDAD) + ')'AS NOMBRE_CIUDAD,
	C.INDIC_CIUDAD,
	C.CODIGO_DANE,
	C.ID_CABE_REGIONAL,
	C.ID_RECOLECCION_INTERNET,
	C.ID_REGIONAL,	
	R.NOMBRE_REGIONAL,
	C.ID_DEPARTAMENTO,
	C.ID_GRUPOCOMIS,
	C.ID_CATEGOPERA,
	C.ID_CATEGCOMERCIAL,
	C.ID_CLASIF_DANE,
	C.ABREV_CIUDAD,
	C.ID_EST_CIUDAD
FROM DIM.CIUDADES AS C WITH(NOLOCK)
INNER JOIN DIM.REGIONALES_PAIS AS R WITH(NOLOCK) ON
C.ID_REGIONAL = R.ID_REGIONAL</property>
