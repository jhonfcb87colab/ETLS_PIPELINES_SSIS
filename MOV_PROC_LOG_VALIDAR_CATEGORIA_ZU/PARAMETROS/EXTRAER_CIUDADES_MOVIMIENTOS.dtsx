        <SQLTask:SqlTaskData
          SQLTask:Connection="{DBC61B30-6ACE-4BDA-8800-08CAAA8FC029}"
          SQLTask:BypassPrepare="False"
          SQLTask:SqlStatementSource="MERGE [SIG_COL_LOGISTICA_DW].[DIM].[CIUDADES_MOVIMIENTOS] AS CM&#xA;USING (SELECT CODIGO_DANE,POBLACION FROM [SIG_COL_LOGISTICA_DW].[TMP].[POBLACION_CIUDADES]) AS PC&#xA;ON CONVERT(INT,PC.CODIGO_DANE) = CONVERT(INT,SUBSTRING(CM.[CODIGO_DANE],4,5))&#xA;WHEN MATCHED THEN&#xA;UPDATE SET CM.POBLACION = PC.POBLACION;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
