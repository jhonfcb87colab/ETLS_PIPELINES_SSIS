      <DTS:Variables />
      <DTS:Executables>
        <DTS:Executable
          DTS:refId="Package\CATEGORIA ZONA URBANA\CARGA INCREMENTAL DIM CATEGORIA ZONA URBANA"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{164F9071-B997-40DD-B595-C37B4099312A}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="CARGA INCREMENTAL DIM CATEGORIA ZONA URBANA"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="3">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{31827A4F-F50A-440E-AF10-C379306890BB}"
              SQLTask:SqlStatementSource="DROP TABLE IF EXISTS #SIG_COL_LOGISTICA_DW_DIM_CATEGORIA_ZONA_URBANA;&#xA;;WITH CTE AS (&#xA;SELECT  &#xA;ROWID = ROW_NUMBER() OVER(PARTITION BY right( '0000' +  CONVERT(varchar,ZU.Id_ciudad),4) +&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;CONVERT(varchar,ZU.ID_TIPO_Zona_urba) +&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;right( '000' +  CONVERT(varchar,ZU.ID_Zona_Urba),3)&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;ORDER BY FECHA_MODIFICACION DESC)&#xA;,right( '0000' +  CONVERT(varchar,ZU.Id_ciudad),4) +&#xA;CONVERT(varchar,ZU.ID_TIPO_Zona_urba) +&#xA;right( '000' +  CONVERT(varchar,ZU.ID_Zona_Urba),3) AS CLAVE_DIMENSION&#xA;,ISNULL(CTZU.Id_Categoria,0) AS ID_CATEGORIA_ZONA_URBA&#xA;,ISNULL(CTZU.Nombre_Categoria,'NINGUNA') AS NOMBRE_CATEGORIA_ZONA_URBA&#xA;FROM SIG_COLOMBIA_DW.PAR.ZONASURBANAS ZU WITH(NOLOCK)&#xA;LEFT JOIN  SIG_COLOMBIA_DW.[PAR].[CATERGORIA_ZONA_URBANA] CTZU WITH(NOLOCK)&#xA;ON CTZU.Id_Categoria=ZU.CATEGORIA_ZONA_URBA&#xA;--WHERE ZU.ID_EST_ZONA_URBA=1&#xA;)&#xA;SELECT &#xA;CLAVE_DIMENSION&#x9;&#xA;,ID_CATEGORIA_ZONA_URBA&#x9;&#xA;,NOMBRE_CATEGORIA_ZONA_URBA&#xA;INTO #SIG_COL_LOGISTICA_DW_DIM_CATEGORIA_ZONA_URBANA&#xA;FROM CTE WHERE ROWID = 1 ORDER BY 1 &#xA;&#xA;&#xA;&#xA;MERGE &#xA;[SIG_COL_LOGISTICA_DW].[DIM].[CATEGORIA_ZONA_URBANA] AS target  -- TABLA OBJETIVO (TABLA PARA INSERTAR DATOS)&#xA;USING &#x9;#SIG_COL_LOGISTICA_DW_DIM_CATEGORIA_ZONA_URBANA AS source ---TABLA FUENTE (TABLA TEMPORAL)&#xA;&#x9;ON target.CLAVE_DIMENSION = source.CLAVE_DIMENSION&#x9;&#x9;------COLUMNAS LLAVE&#xA;WHEN MATCHED &#xA;&#x9;&#x9;THEN        &#xA;&#x9;UPDATE SET &#xA;&#x9;target.CLAVE_DIMENSION = source.CLAVE_DIMENSION, &#xA;&#x9;target.ID_CATEGORIA_ZONA_URBA = source.ID_CATEGORIA_ZONA_URBA,&#xA;&#x9;target.NOMBRE_CATEGORIA_ZONA_URBA = source.NOMBRE_CATEGORIA_ZONA_URBA&#xA;WHEN NOT MATCHED THEN    &#xA;&#x9;INSERT (CLAVE_DIMENSION, ID_CATEGORIA_ZONA_URBA, NOMBRE_CATEGORIA_ZONA_URBA)    &#xA;&#x9;VALUES (&#xA;&#x9;source.CLAVE_DIMENSION, &#xA;&#x9;source.ID_CATEGORIA_ZONA_URBA, &#xA;&#x9;source.NOMBRE_CATEGORIA_ZONA_URBA&#xA;&#x9;);&#xA;&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
