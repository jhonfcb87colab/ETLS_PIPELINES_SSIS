                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT
ID_ESTA_FISICO 
,NOMBRE_ESTA_FISICO 
,ID_EST_ESTA_FISICO 
,CASE WHEN ID_EST_ESTA_FISICO = 1 THEN 'ACTIVO' ELSE 'INACTIVO' END EST_FISICO 
FROM [DBO].[ESTADOSFISICO]WITH(NOLOCK)
UNION
SELECT
-888 AS ID_ESTA_FISICO ,
'NO DISPONIBLE' AS NOMBRE_ESTA_FISICO,
-888 AS ID_EST_ESTA_FISICO,
'NO TIENE' AS EST_FISICO</property>
