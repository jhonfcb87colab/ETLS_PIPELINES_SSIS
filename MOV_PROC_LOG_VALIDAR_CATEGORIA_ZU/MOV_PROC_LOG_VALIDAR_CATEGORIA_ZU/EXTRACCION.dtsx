                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">--DECLARE @FECHA_INI DATE = '2023-02-07';
--DECLARE @FECHA_FIN DATE = '2023-02-20';

DECLARE @FECHA_INI DATE = ? ;
DECLARE @FECHA_FIN DATE = ? ;

WITH SEGUI_ENVIO AS (
	SELECT  
		 NUMERO_GUIA
		,FECHA_HORA_MOVIMIENTO
		,ID_CONCEPTO
		,ID_TIPOENVIO
		,NUMERO_PIEZAS
		,PESO_ENVIO
		,ID_ESTA_FISICO
		,ID_PROCESO
		,NUMERO_MOVIMI
		,CONSECUT_MOVIMI
	FROM  dbo.SEGUIMIENTO_ENVIO AS SE WITH (NOLOCK, INDEX(IX_ASEGURAMIENTO_REPLICACION) )   
	WHERE
		SE.FECHA_HORA_MOVIMIENTO &gt;= @FECHA_INI
	AND
		SE.FECHA_HORA_MOVIMIENTO &lt; @FECHA_FIN
	AND  LEN(SE.NUMERO_GUIA) &gt; 8
)
, GUIA_SEGUI AS (
SELECT 
	SE.NUMERO_GUIA
	,SE.FECHA_HORA_MOVIMIENTO
	,SE.ID_CONCEPTO
	,SE.ID_TIPOENVIO
	,SE.NUMERO_PIEZAS
	,SE.PESO_ENVIO
	,SE.ID_ESTA_FISICO
	,SE.ID_PROCESO
	,SE.NUMERO_MOVIMI
	,SE.CONSECUT_MOVIMI
	,GU.ID_TIPOGUIA 
	,GU.ID_CIUDAD_ORIGEN 
	,GU.ID_CIUDAD_DESTINO
	,GU.ID_TIEMPO 
	,GU.ID_PRODUCTO 
	,GU.ID_SUBPRODUCTO 
	,GU.ID_CLIENTE 
	,GU.FECHA_ENVIO 
    ,GU.ID_ESTADOENVIO 
FROM SEGUI_ENVIO AS SE 
INNER JOIN dbo.GUIAS GU WITH (NOLOCK, INDEX(PK_GUIAS))
ON	SE.NUMERO_GUIA = GU.NUMERO_GUIA
)

SELECT  
	 SE.NUMERO_GUIA AS SE_NUMERO_GUIA
	,SE.FECHA_HORA_MOVIMIENTO AS SE_FECHA_HORA_MOVIMIENTO
	,SE.ID_CONCEPTO AS SE_ID_CONCEPTO
	,SE.ID_TIPOENVIO AS SE_ID_TIPOENVIO
	,SE.NUMERO_PIEZAS AS SE_NUMERO_PIEZAS
	,SE.PESO_ENVIO AS SE_PESO_ENVIO
	,DC.ID_PROCESO AS DC_ID_PROCESO
	,DC.NUMERO_MOVIMI AS DC_NUMERO_MOVI
	,DC.CONSECUT_MOVIMI AS DC_CONSECUT_MOVI
	,DC.ID_CIUDAD_CANAL AS DC_ID_CIUDAD_CANAL
	,DC.ID_CIUDAD_ZONA_URBA AS DC_ID_CIUDAD_ZONA_URBA
	,DC.ID_PAIS_DIVISION_ORIGEN AS DC_ID_PAIS_DIVISION_ORIGEN
	,DC.ID_CIUDAD_DIVISION_ORIGEN AS DC_ID_CIUDAD_DIVISION_ORIGEN
	,DC.ID_DIVISION_ORIGEN AS DC_ID_DIVISION_ORIGEN
	,DC.ID_PAIS_DESTINO AS DC_ID_PAIS_DESTINO
	,DC.ID_CIUDAD_DESTINO AS DC_ID_CIUDAD_DESTINO
	,DC.ID_DIVISION_DESTINO AS DC_ID_DIVISION_DESTINO
	,DC.PLACA_VEHICULO_DOCU AS DC_PLACA_VEHICULO_DOCU
	,DC.ID_TIPO_ZONA_URBA AS DC_ID_TIPO_ZONA_URBA
	,DC.ID_ZONA_URBA AS DC_ID_ZONA_URBA
	,DC.ID_PAIS_OPERATIVO AS DC_ID_PAIS_OPERATIVO
	,DC.ID_CIUDAD_OPERATIVO AS DC_ID_CIUDAD_OPERATIVO
	,DC.ID_OPERATIVO AS DC_ID_OPERATIVO
	,DC.ESTADO_MOVIMI AS DC_ESTADO_MOVIMI
	,SE.ID_TIPOGUIA AS GU_ID_TIPOGUIA
	,SE.ID_CIUDAD_ORIGEN AS GU_ID_CIUDAD_ORIGEN
	,SE.ID_CIUDAD_DESTINO AS GU_ID_CIUDAD_DESTINO
	,SE.ID_TIEMPO AS GU_ID_TIEMPO
	,SE.ID_PRODUCTO AS GU_ID_PRODUCTO
	,SE.ID_SUBPRODUCTO AS GU_ID_SUBPRODUCTO
	,SE.ID_CLIENTE AS GU_ID_CLIENTE
	,SE.FECHA_ENVIO AS GU_FECHA_ENVIO
                   ,SE.ID_ESTADOENVIO AS GU_ID_ESTADOENVIO
                   ,SE.ID_ESTA_FISICO AS SE_ID_ESTA_FISICO
--INTO #PRUEBAS_SAL
     , 2 AS TBL_GUIAS_CLIS
FROM
	dbo.DOCUMENTOS DC WITH(NOLOCK,INDEX(abc))
INNER JOIN
	GUIA_SEGUI SE WITH (NOLOCK)   
ON	(DC.ID_PROCESO = SE.ID_PROCESO
AND	DC.NUMERO_MOVIMI = SE.NUMERO_MOVIMI
AND	DC.CONSECUT_MOVIMI = SE.CONSECUT_MOVIMI)
AND	(DC.ID_PROCESO IN (5,6,7,8,9,10,11,12,14,15,16,17,18,19,20,21,24,25,28))
OPTION(FAST 1)</property>
