            <SQLTask:SqlTaskData
              SQLTask:Connection="{5BEC2E7D-7E7B-42F9-BA36-95330FC645D4}"
              SQLTask:SqlStatementSource="USE tempdb; &#xA;&#xA;IF OBJECT_ID(N'dbo.BI_MOV_X_PROCESO_LOG_CREACION_TABLA ', N'P') IS NULL&#xA;BEGIN&#xA;    EXEC(N'&#xA;&#x9;&#x9;CREATE PROCEDURE dbo.BI_MOV_X_PROCESO_LOG_CREACION_TABLA &#xA;&#x9;&#x9;AS&#xA;&#x9;&#x9;BEGIN&#xA;&#xA;&#x9;&#x9;IF OBJECT_ID(''tempdb.dbo.GUIAS_SEG_ENVIO'') IS NOT NULL &#xA;&#x9;&#x9;&#x9;DROP TABLE tempdb.dbo.GUIAS_SEG_ENVIO;&#xA;&#xA;&#x9;&#x9;&#x9;CREATE TABLE tempdb.[dbo].[GUIAS_SEG_ENVIO] (&#xA;&#x9;&#x9;&#x9;&#x9;[NUMERO_GUIA] [numeric](20, 0) NOT NULL,&#xA;&#x9;&#x9;&#x9;&#x9;[FECHA_HORA_MOVIMIENTO] [datetime] NULL,&#xA;&#x9;&#x9;&#x9;&#x9;[ID_CONCEPTO] [tinyint] NULL,&#xA;&#x9;&#x9;&#x9;&#x9;[ID_TIPOENVIO] [tinyint] NULL,&#xA;&#x9;&#x9;&#x9;&#x9;[NUMERO_PIEZAS] [smallint] NULL,&#xA;&#x9;&#x9;&#x9;&#x9;[PESO_ENVIO] [numeric](8, 3) NULL,&#xA;&#x9;&#x9;&#x9;&#x9;[ID_ESTA_FISICO] [tinyint] NULL,&#xA;&#x9;&#x9;&#x9;&#x9;[ID_PROCESO] [smallint] NOT NULL,&#xA;&#x9;&#x9;&#x9;&#x9;[NUMERO_MOVIMI] [char](30) NOT NULL,&#xA;&#x9;&#x9;&#x9;&#x9;[CONSECUT_MOVIMI] [numeric](7, 0) NOT NULL&#xA;&#x9;&#x9;&#x9;);&#xA;&#xA;&#x9;&#x9;END;&#xA;    ');&#xA;&#xA;&#xA;END;&#xA;&#xA;    EXEC dbo.BI_MOV_X_PROCESO_LOG_CREACION_TABLA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
