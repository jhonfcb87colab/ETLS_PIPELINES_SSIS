  <DTS:Variables>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{5DDE19DA-F1E5-4F53-A801-A53B42774287}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="(DT_DATE) @[$Project::FULL_FACH_FIN] == (DT_DATE) &quot;1900-01-01&quot;?&#xA;(DT_DATE)((DT_WSTR,4)YEAR(DATEADD(&quot;DD&quot;, 1 ,GETDATE()))+&quot;-&quot;+RIGHT(&quot;0&quot;+(DT_WSTR,2)MONTH(DATEADD(&quot;DD&quot;,1,GETDATE())),2)+&quot;-&quot;+RIGHT(&quot;0&quot;+(DT_WSTR,2)DAY(DATEADD(&quot;DD&quot;,1,GETDATE())),2))&#xA;: (DT_DATE) @[$Project::FULL_FACH_FIN]"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="FechaFin">
      <DTS:VariableValue
        DTS:DataType="7">10/31/2026</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{C4D78501-6656-4CD0-9DB5-C71A56561132}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="(DT_DATE)   @[$Project::FULL_FACH_INI]    == (DT_DATE) &quot;1900-01-01&quot;? &#xA;(DT_DATE)((DT_WSTR,4)YEAR(DATEADD(&quot;DD&quot;, -@[$Project::DiaIni], GETDATE()))+&quot;-&quot;&#xA;+RIGHT(&quot;0&quot;+(DT_WSTR,2)MONTH(DATEADD(&quot;DD&quot;,-@[$Project::DiaIni],GETDATE() )),2)+&quot;-&quot;&#xA;+RIGHT(&quot;0&quot;+(DT_WSTR,2)DAY(DATEADD(&quot;DD&quot;, -@[$Project::DiaIni],GETDATE() )),2))&#xA;: (DT_DATE) @[$Project::FULL_FACH_INI]"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="FechaIni">
      <DTS:VariableValue
        DTS:DataType="7">10/25/2026</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{6393AF6F-9D10-40CC-AD3E-E273C33F50C2}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot; --DECLARE @FECHA_INI DATE  = '2025-05-21';&#xA; --DECLARE @FECHA_FIN DATE = '2025-05-22';&#xA;&#xA;DECLARE @FECHA_INI DATE = '&quot; + (DT_WSTR,25)(DT_DBDATE)  @[User::FechaIni] +&quot;' ;&#xA;DECLARE @FECHA_FIN DATE = '&quot; + (DT_WSTR,25)(DT_DBDATE) @[User::FechaFin] +&quot;'  ;&#xA;&#xA;DROP TABLE IF EXISTS tempdb..GUIAS_SEG_ENVIO ;&#xA;&#xA;&#x9;SELECT  &#xA;&#x9;&#x9; NUMERO_GUIA&#xA;&#x9;&#x9;,FECHA_HORA_MOVIMIENTO&#xA;&#x9;&#x9;,ID_CONCEPTO&#xA;&#x9;&#x9;,ID_TIPOENVIO&#xA;&#x9;&#x9;,NUMERO_PIEZAS&#xA;&#x9;&#x9;,PESO_ENVIO&#xA;&#x9;&#x9;,ID_ESTA_FISICO&#xA;&#x9;&#x9;,ID_PROCESO&#xA;&#x9;&#x9;,NUMERO_MOVIMI&#xA;&#x9;&#x9;,CONSECUT_MOVIMI&#xA;&#x9;  INTO  tempdb.DBO.GUIAS_SEG_ENVIO&#xA;&#x9;FROM  DBO.SEGUIMIENTO_ENVIO AS SE&#xA;&#x9;WHERE 1=0 ;&#xA;&#xA;-- SELECT * FROM tempdb.DBO.GUIAS_SEG_ENVIO&#xA;&#xA;INSERT INTO tempdb.DBO.GUIAS_SEG_ENVIO&#xA;&#x9;SELECT  &#xA;&#x9;&#x9; NUMERO_GUIA&#xA;&#x9;&#x9;,FECHA_HORA_MOVIMIENTO&#xA;&#x9;&#x9;,ID_CONCEPTO&#xA;&#x9;&#x9;,ID_TIPOENVIO&#xA;&#x9;&#x9;,NUMERO_PIEZAS&#xA;&#x9;&#x9;,PESO_ENVIO&#xA;&#x9;&#x9;,ID_ESTA_FISICO&#xA;&#x9;&#x9;,ID_PROCESO&#xA;&#x9;&#x9;,NUMERO_MOVIMI&#xA;&#x9;&#x9;,CONSECUT_MOVIMI&#xA;&#x9;FROM  DBO.SEGUIMIENTO_ENVIO AS SE WITH (NOLOCK, INDEX(IX_FECHA_HORA_MOVIMIENTO_BI))   &#xA;&#x9;WHERE&#xA;&#x9;&#x9;SE.FECHA_HORA_MOVIMIENTO &gt;= @FECHA_INI&#xA;&#x9;AND&#xA;&#x9;&#x9;SE.FECHA_HORA_MOVIMIENTO &lt; @FECHA_FIN&#xA;&#x9; AND &#x9;LEN(NUMERO_GUIA) &gt; 8 &#xA;OPTION(RECOMPILE)&quot;"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="QUERY_DG_SEG_ENVIO">
      <DTS:VariableValue
        DTS:DataType="8"> --DECLARE @FECHA_INI DATE  = '2025-05-21';
 --DECLARE @FECHA_FIN DATE = '2025-05-22';

DECLARE @FECHA_INI DATE = '2026-10-25' ;
DECLARE @FECHA_FIN DATE = '2026-10-31'  ;

DROP TABLE IF EXISTS tempdb..GUIAS_SEG_ENVIO ;

	SELECT  
		 NUMERO_GUIA
		,FECHA_HORA_MOVIMIENTO
		,ID_CONCEPTO
		,ID_TIPOENVIO
		,NUMERO_PIEZAS
		,PESO_ENVIO
		,ID_ESTA_FISICO
		,ID_PROCESO
		,NUMERO_MOVIMI
		,CONSECUT_MOVIMI
	  INTO  tempdb.DBO.GUIAS_SEG_ENVIO
	FROM  DBO.SEGUIMIENTO_ENVIO AS SE
	WHERE 1=0 ;

-- SELECT * FROM tempdb.DBO.GUIAS_SEG_ENVIO

INSERT INTO tempdb.DBO.GUIAS_SEG_ENVIO
	SELECT  
		 NUMERO_GUIA
		,FECHA_HORA_MOVIMIENTO
		,ID_CONCEPTO
		,ID_TIPOENVIO
		,NUMERO_PIEZAS
		,PESO_ENVIO
		,ID_ESTA_FISICO
		,ID_PROCESO
		,NUMERO_MOVIMI
		,CONSECUT_MOVIMI
	FROM  DBO.SEGUIMIENTO_ENVIO AS SE WITH (NOLOCK, INDEX(IX_FECHA_HORA_MOVIMIENTO_BI))   
	WHERE
		SE.FECHA_HORA_MOVIMIENTO &gt;= @FECHA_INI
	AND
		SE.FECHA_HORA_MOVIMIENTO &lt; @FECHA_FIN
	 AND 	LEN(NUMERO_GUIA) &gt; 8 
OPTION(RECOMPILE)</DTS:VariableValue>
    </DTS:Variable>
  </DTS:Variables>
