              description="OLE DB Source"
              name="Procesos"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset">[TMP].[OS174_MOXP]</property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT [TIMEID]
      ,[FECHA]
      ,[DIA]
      ,[MES]
      ,[AÑO]
      ,[ID_CIUDAD_MOV]
      ,[ID_PROCESO]
      ,[ID_CONCEPTO]
      ,[ID_TIPOENVIO]
      ,[ID_TIPOGUIA]
      ,[ID_CIUDAD_ORIGEN_G]
      ,[ID_CIUDAD_DESTINO_G]
      ,[ID_TIEMPO]
      ,[ID_PRODUCTO]
      ,[ID_SUBPRODUCTO]
      ,[CANTIDAD_GUIAS]
      ,[CANTIDAD_ENVIOS]
      ,[PESO]
      ,[ID_DIVISION_BOD_ORIGEN]
      ,[ID_DIVISION_BOD_DESTINO]
      ,[CANTIDAD_MANIFIESTOS]
	  ,IIF(  PATINDEX('%[^a-zA-Z0-9 ]%', PLACA_VEHICULO) &lt;&gt; 0, SIG_COL_LOGISTICA_DW.DBO.VALIDA_CARACTERS (UPPER(PLACA_VEHICULO), '_'), UPPER(PLACA_VEHICULO)) AS PLACA_VEHICULO
      ,[ID_CIUDAD_ZONA_URBA]
      ,[ID_OPERATIVO]
      ,[ID_ESTADO_MOVI]
      ,[ID_TIPO_COBRO]
      ,[ID_HORA]
      ,[ID_CLIENTE]
      ,[ID_BODEGA]
      ,[ID_VEJEZ_CALE]
      ,[ID_VEJEZ_HABIL]
      ,[ID_TIPO_TRAYECTO]
      ,[ID_ESTADO_FISICO]
      ,[ID_ESTADO_CONCEPTO]
      ,[ID_ESTADO_PROCESO]
      ,[ID_ESTADO_LEGALIZADO]
      ,[ID_ESTADO_RECAUDO]
      ,[ID_ESTADOENVIO]
      ,[CANT_AUXILIAR]
      ,[ID_AUXILIZAR_ZONA_UR]
	  ,ZONA_GEO_PE
	  ,ID_CARACT_ENTREGA
	  ,ID_CODIGO_ZONA_ORIG
	  ,ID_CODIGO_ZONA_DEST
  FROM SIG_COLOMBIA_DW.[TMP].[MOXP] WITH (NOLOCK)</property>
