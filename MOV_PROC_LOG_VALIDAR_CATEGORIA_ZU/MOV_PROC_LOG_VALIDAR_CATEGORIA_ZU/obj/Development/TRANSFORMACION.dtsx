      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:LoggingOptions
        DTS:FilterKind="0" />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{A947580C-C7C7-4E60-B63D-7A9EA12E8F3A}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;&#xA;/* inserta información para el CIL Direccion General DG */&#xA;INSERT INTO [TMP].[MOXP_02_DG] &#xA;SELECT &#xA;&#x9; TMP.SE_NUMERO_GUIA&#xA;&#x9;,SE.[FECHA_HORA_MOVIMIENTO]&#xA;FROM&#xA;&#x9;[LOG].[SEGUIMIENTO_ENVIO] SE WITH(NOLOCK, INDEX ( IX_SEGUIMIENTO_ENVIO_V3 )) &#xA;&#x9;INNER JOIN  [TMP].[MOXP_01] TMP WITH(NOLOCK,INDEX(IX_MOXP_01_SE_NUMERO_GUIA))&#xA;ON&#xA;&#x9;SE.NUMERO_GUIA = TMP.SE_NUMERO_GUIA&#xA;AND   SE.ID_PROCESO IN (5,6)&#xA;GROUP BY  TMP.SE_NUMERO_GUIA, SE.[FECHA_HORA_MOVIMIENTO]&#xA;GO &#xA;&#xA;/* inserta información para el CIL SAN ANDRES Y PROVINCIA */&#xA;INSERT INTO [TMP].[MOXP_02_DG] &#xA;SELECT &#xA;&#x9; TMP.SE_NUMERO_GUIA&#xA;&#x9;,SE.[FECHA_HORA_MOVIMIENTO]&#xA;FROM&#xA;&#x9;[LOG].[SEGUIMIENTO_ENVIO_PROV] SE WITH(NOLOCK) &#xA;&#x9;INNER JOIN  [TMP].[MOXP_01] TMP WITH(NOLOCK)&#xA;ON&#xA;&#x9;SE.NUMERO_GUIA = TMP.SE_NUMERO_GUIA&#xA;AND SE.ID_PROCESO IN (5,6)&#xA;GROUP BY  TMP.SE_NUMERO_GUIA, SE.[FECHA_HORA_MOVIMIENTO]&#xA;GO&#xA;&#xA;&#xA;--=======================================================================================--&#xA;----------------------- SELECCION DE DATOS UNICOS -----------------------------------------&#xA;--=======================================================================================--&#xA;INSERT INTO [TMP].[MOXP_02] (NUMERO_GUIA, FECHA_HORA_MOVIMIENTO)&#xA;SELECT &#xA;     NUMERO_GUIA&#xA;    ,MAX(FECHA_HORA_MOVIMIENTO) AS FECHA_HORA_MOVIMIENTO&#xA;FROM [TMP].[MOXP_02_DG] WITH (NOLOCK)&#xA;GROUP BY NUMERO_GUIA;&#xA;--=======================================================================================--&#xA;-------------------------------------------------------------------------------------------&#xA;--=======================================================================================--&#xA;&#xA;&#xA;/* inserta información para el CIL Bogotá*/&#xA;--INSERT INTO [TMP].[MOXP_02_DG] &#xA;--SELECT &#xA;--&#x9; TMP.SE_NUMERO_GUIA&#xA;--&#x9;,SE.[FECHA_HORA_MOVIMIENTO]&#xA;--FROM&#xA;--&#x9;[LOG].[SEGUIMIENTO_ENVIO_BOGO] SE WITH(NOLOCK) &#xA;--&#x9;INNER JOIN  [TMP].[MOXP_01] TMP WITH(NOLOCK)&#xA;--ON&#xA;--&#x9;SE.NUMERO_GUIA = TMP.SE_NUMERO_GUIA&#xA;--AND&#xA;--SE.ID_PROCESO IN (5,6)&#xA;--GO&#xA;&#xA;/* inserta información para el CIL Barraquilla */&#xA;--INSERT INTO [TMP].[MOXP_02_DG] &#xA;--SELECT &#xA;--&#x9; TMP.SE_NUMERO_GUIA&#xA;--&#x9;,SE.[FECHA_HORA_MOVIMIENTO]&#xA;--FROM&#xA;--&#x9;[LOG].[SEGUIMIENTO_ENVIO_BARR] SE WITH(NOLOCK) &#xA;--&#x9;INNER JOIN  [TMP].[MOXP_01] TMP WITH(NOLOCK)&#xA;--ON&#xA;--&#x9;SE.NUMERO_GUIA = TMP.SE_NUMERO_GUIA&#xA;--AND&#xA;--SE.ID_PROCESO IN (5,6)&#xA;--GO&#xA;&#xA;/* inserta información para el CIL Bucaramanga */&#xA;--INSERT INTO [TMP].[MOXP_02_DG] &#xA;--SELECT &#xA;--&#x9;TMP.SE_NUMERO_GUIA&#xA;--&#x9;,SE.[FECHA_HORA_MOVIMIENTO]&#xA;--FROM&#xA;--&#x9;[LOG].[SEGUIMIENTO_ENVIO_BUCA] SE WITH(NOLOCK) &#xA;--&#x9;INNER JOIN [TMP].[MOXP_01] TMP WITH(NOLOCK)&#xA;--ON&#xA;--&#x9;SE.NUMERO_GUIA = TMP.SE_NUMERO_GUIA&#xA;--AND&#xA;--SE.ID_PROCESO IN (5,6)&#xA;--GO&#xA;&#xA;/* inserta información para el CIL BUGA*/&#xA;--INSERT INTO [TMP].[MOXP_02_DG] &#xA;--SELECT &#xA;--&#x9; TMP.SE_NUMERO_GUIA&#xA;--&#x9;,SE.[FECHA_HORA_MOVIMIENTO]&#xA;--FROM&#xA;--&#x9;[LOG].[SEGUIMIENTO_ENVIO_BUGA] SE WITH(NOLOCK) &#xA;--&#x9;INNER JOIN  [TMP].[MOXP_01] TMP WITH(NOLOCK)&#xA;--ON&#xA;--&#x9;SE.NUMERO_GUIA = TMP.SE_NUMERO_GUIA&#xA;--AND&#xA;--SE.ID_PROCESO IN (5,6)&#xA;--GO&#xA;&#xA;/* inserta información para el CIL IBAGUE*/&#xA;--INSERT INTO [TMP].[MOXP_02_DG] &#xA;--SELECT &#xA;--&#x9; TMP.SE_NUMERO_GUIA&#xA;--&#x9;,SE.[FECHA_HORA_MOVIMIENTO]&#xA;--FROM&#xA;--&#x9;[LOG].[SEGUIMIENTO_ENVIO_IBAG] SE WITH(NOLOCK) &#xA;--&#x9;INNER JOIN [TMP].[MOXP_01] TMP WITH(NOLOCK)&#xA;--ON&#xA;--&#x9;SE.NUMERO_GUIA = TMP.SE_NUMERO_GUIA&#xA;--AND&#xA;--SE.ID_PROCESO IN (5,6)&#xA;--GO&#xA;&#xA;/* inserta información para el CIL CUCUTA*/&#xA;--INSERT INTO [TMP].[MOXP_02_DG] &#xA;--SELECT &#xA;--&#x9; TMP.SE_NUMERO_GUIA&#xA;--&#x9;,SE.[FECHA_HORA_MOVIMIENTO]&#xA;--FROM&#xA;--&#x9;[LOG].[SEGUIMIENTO_ENVIO_CUCU] SE WITH(NOLOCK) &#xA;--&#x9;INNER JOIN  [TMP].[MOXP_01] TMP WITH(NOLOCK)&#xA;--ON&#xA;--&#x9;SE.NUMERO_GUIA = TMP.SE_NUMERO_GUIA&#xA;--AND&#xA;--SE.ID_PROCESO IN (5,6)&#xA;--GO&#xA;&#xA;/* inserta información para el CIL COTA*/&#xA;--INSERT INTO [TMP].[MOXP_02_DG] &#xA;--SELECT &#xA;--&#x9; TMP.SE_NUMERO_GUIA&#xA;--&#x9;,SE.[FECHA_HORA_MOVIMIENTO]&#xA;--FROM&#xA;--&#x9;[LOG].[SEGUIMIENTO_ENVIO_COTA] SE WITH(NOLOCK) &#xA;--&#x9;INNER JOIN  [TMP].[MOXP_01] TMP WITH(NOLOCK)&#xA;--ON&#xA;--&#x9;SE.NUMERO_GUIA = TMP.SE_NUMERO_GUIA&#xA;--AND&#xA;--SE.ID_PROCESO IN (5,6)&#xA;--GO&#xA;&#xA;/* inserta información para el CIL CARTAGENA*/&#xA;--INSERT INTO [TMP].[MOXP_02_DG] &#xA;--SELECT &#xA;--&#x9; TMP.SE_NUMERO_GUIA&#xA;--&#x9;,SE.[FECHA_HORA_MOVIMIENTO]&#xA;--FROM&#xA;--&#x9;[LOG].[SEGUIMIENTO_ENVIO_CART] SE WITH(NOLOCK) &#xA;--&#x9;INNER JOIN  [TMP].[MOXP_01] TMP WITH(NOLOCK)&#xA;--ON&#xA;--&#x9;SE.NUMERO_GUIA = TMP.SE_NUMERO_GUIA&#xA;--AND&#xA;--SE.ID_PROCESO IN (5,6)&#xA;--GO&#xA;&#xA;/* inserta información para el CIL CALI*/&#xA;--INSERT INTO [TMP].[MOXP_02_DG] &#xA;--SELECT &#xA;--&#x9; TMP.SE_NUMERO_GUIA&#xA;--&#x9;,SE.[FECHA_HORA_MOVIMIENTO]&#xA;--FROM&#xA;--&#x9;[LOG].[SEGUIMIENTO_ENVIO_CALI] SE WITH(NOLOCK) &#xA;--&#x9;INNER JOIN  [TMP].[MOXP_01] TMP WITH(NOLOCK)&#xA;--ON&#xA;--&#x9;SE.NUMERO_GUIA = TMP.SE_NUMERO_GUIA&#xA;--AND&#xA;--SE.ID_PROCESO IN (5,6)&#xA;--GO&#xA;&#xA;/* inserta información para el CIL MANIZALES*/&#xA;--INSERT INTO [TMP].[MOXP_02_DG] &#xA;--SELECT &#xA;--&#x9; TMP.SE_NUMERO_GUIA&#xA;--&#x9;,SE.[FECHA_HORA_MOVIMIENTO]&#xA;--FROM&#xA;--&#x9;[LOG].[SEGUIMIENTO_ENVIO_MANI] SE WITH(NOLOCK) &#xA;--&#x9;INNER JOIN [TMP].[MOXP_01] TMP WITH(NOLOCK)&#xA;--ON&#xA;--&#x9;SE.NUMERO_GUIA = TMP.SE_NUMERO_GUIA&#xA;--AND&#xA;--SE.ID_PROCESO IN (5,6)&#xA;--GO&#xA;&#xA;/* inserta información para el CIL MEDELLIN */&#xA;--INSERT INTO [TMP].[MOXP_02_DG] &#xA;--SELECT &#xA;--&#x9; TMP.SE_NUMERO_GUIA&#xA;--&#x9;,SE.[FECHA_HORA_MOVIMIENTO]&#xA;--FROM&#xA;--&#x9;[LOG].[SEGUIMIENTO_ENVIO_MEDE] SE WITH(NOLOCK) &#xA;--&#x9;INNER JOIN  [TMP].[MOXP_01] TMP WITH(NOLOCK)&#xA;--ON&#xA;--&#x9;SE.NUMERO_GUIA = TMP.SE_NUMERO_GUIA&#xA;--AND&#xA;--SE.ID_PROCESO IN (5,6)&#xA;--GO&#xA;&#xA;/* inserta información para el CIL NEIVA */&#xA;--INSERT INTO [TMP].[MOXP_02_DG] &#xA;--SELECT &#xA;--&#x9; TMP.SE_NUMERO_GUIA&#xA;--&#x9;,SE.[FECHA_HORA_MOVIMIENTO]&#xA;--FROM&#xA;--&#x9;[LOG].[SEGUIMIENTO_ENVIO_NEIV] SE WITH(NOLOCK) &#xA;--&#x9;INNER JOIN  [TMP].[MOXP_01] TMP WITH(NOLOCK)&#xA;--ON&#xA;--&#x9;SE.NUMERO_GUIA = TMP.SE_NUMERO_GUIA&#xA;--AND&#xA;--SE.ID_PROCESO IN (5,6)&#xA;&#xA;/* inserta información para el CIL PEREIRA */&#xA;--INSERT INTO [TMP].[MOXP_02_DG] &#xA;--SELECT &#xA;--&#x9; TMP.SE_NUMERO_GUIA&#xA;--&#x9;,SE.[FECHA_HORA_MOVIMIENTO]&#xA;--FROM&#xA;--&#x9;[LOG].[SEGUIMIENTO_ENVIO_PERE] SE WITH(NOLOCK) &#xA;--&#x9;INNER JOIN [TMP].[MOXP_01] TMP WITH(NOLOCK)&#xA;--ON&#xA;--&#x9;SE.NUMERO_GUIA = TMP.SE_NUMERO_GUIA&#xA;--AND&#xA;--SE.ID_PROCESO IN (5,6)&#xA;--GO&#xA;&#xA;/* inserta información para el CIL SINCELEJO */&#xA;--INSERT INTO [TMP].[MOXP_02_DG] &#xA;--SELECT &#xA;--&#x9; TMP.SE_NUMERO_GUIA&#xA;--&#x9;,SE.[FECHA_HORA_MOVIMIENTO]&#xA;--FROM&#xA;--&#x9;[LOG].[SEGUIMIENTO_ENVIO_SINC] SE WITH(NOLOCK) &#xA;--&#x9;INNER JOIN  [TMP].[MOXP_01] TMP WITH(NOLOCK)&#xA;--ON&#xA;--&#x9;SE.NUMERO_GUIA = TMP.SE_NUMERO_GUIA&#xA;--AND&#xA;--SE.ID_PROCESO IN (5,6)&#xA;--GO&#xA;&#xA;/* inserta información para el CIL VILLAVICENCIO */&#xA;--INSERT INTO [TMP].[MOXP_02_DG]&#xA;--SELECT &#xA;--&#x9; TMP.SE_NUMERO_GUIA&#xA;--&#x9;,SE.[FECHA_HORA_MOVIMIENTO]&#xA;--FROM&#xA;--&#x9;[LOG].[SEGUIMIENTO_ENVIO_VILL] SE WITH(NOLOCK) &#xA;--&#x9;INNER JOIN  [TMP].[MOXP_01] TMP WITH(NOLOCK)&#xA;--ON&#xA;--&#x9;SE.NUMERO_GUIA = TMP.SE_NUMERO_GUIA&#xA;--AND&#xA;--SE.ID_PROCESO IN (5,6)&#xA;--GO&#xA;&#xA;SET NOCOUNT OFF; &#xA; " xmlns:SQLTask="www.microsof