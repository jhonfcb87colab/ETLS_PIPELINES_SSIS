x9;TMP.#MOXP_01_SEGUI_ENV AS SE WITH (NOLOCK, INDEX(TMP_IDX_MOXP_SEGUI_ENV))&#xA;ON&#xA;&#x9;D.ID_PROCESO = SE.ID_PROCESO&#xA;AND &#xA;&#x9;D.NUMERO_MOVIMI = SE.NUMERO_MOVIMI&#xA;AND &#xA;&#x9;D.CONSECUT_MOVIMI = SE.CONSECUT_MOVIMI&#xA;GO&#xA;&#xA;/* inserta información para el CIL NEIVA */&#xA;INSERT INTO [TMP].[OS174_MOXP_DOCU_CILES_CONSOLIDADO]&#xA;SELECT&#xA;&#x9;SE.NUMERO_GUIA&#xA;&#x9;,D.[ID_PROCESO]&#xA;&#x9;,D.[NUMERO_MOVIMI]&#xA;&#x9;,D.[CONSECUT_MOVIMI]&#xA;&#x9;,D.ESTADO_MOVIMI&#xA;&#x9;,SE.FECHA_HORA_MOVIMIENTO     &#xA;FROM [LOG].[DOCUMENTOS_NEIV] D WITH (NOLOCK)&#xA;INNER JOIN&#xA;&#x9;TMP.#MOXP_01_SEGUI_ENV AS SE WITH (NOLOCK, INDEX(TMP_IDX_MOXP_SEGUI_ENV))&#xA;ON&#xA;&#x9;D.ID_PROCESO = SE.ID_PROCESO&#xA;AND &#xA;&#x9;D.NUMERO_MOVIMI = SE.NUMERO_MOVIMI&#xA;AND &#xA;&#x9;D.CONSECUT_MOVIMI = SE.CONSECUT_MOVIMI&#xA;GO&#xA;&#xA;/* inserta información para el CIL PEREIRA */&#xA;INSERT INTO [TMP].[OS174_MOXP_DOCU_CILES_CONSOLIDADO]&#xA;SELECT&#xA;&#x9;SE.NUMERO_GUIA&#xA;&#x9;,D.[ID_PROCESO]&#xA;&#x9;,D.[NUMERO_MOVIMI]&#xA;&#x9;,D.[CONSECUT_MOVIMI]&#xA;&#x9;,D.ESTADO_MOVIMI&#xA;&#x9;,SE.FECHA_HORA_MOVIMIENTO     &#xA;FROM [LOG].[DOCUMENTOS_PERE] D WITH (NOLOCK)&#xA;INNER JOIN&#xA;&#x9;TMP.#MOXP_01_SEGUI_ENV AS SE WITH (NOLOCK, INDEX(TMP_IDX_MOXP_SEGUI_ENV))&#xA;ON&#xA;&#x9;D.ID_PROCESO = SE.ID_PROCESO&#xA;AND &#xA;&#x9;D.NUMERO_MOVIMI = SE.NUMERO_MOVIMI&#xA;AND &#xA;&#x9;D.CONSECUT_MOVIMI = SE.CONSECUT_MOVIMI&#xA;GO&#xA;&#xA;/* inserta información para el CIL SINCELEJO */&#xA;INSERT INTO [TMP].[OS174_MOXP_DOCU_CILES_CONSOLIDADO]&#xA;SELECT&#xA;&#x9;SE.NUMERO_GUIA&#xA;&#x9;,D.[ID_PROCESO]&#xA;&#x9;,D.[NUMERO_MOVIMI]&#xA;&#x9;,D.[CONSECUT_MOVIMI]&#xA;&#x9;,D.ESTADO_MOVIMI&#xA;&#x9;,SE.FECHA_HORA_MOVIMIENTO     &#xA;FROM [LOG].[DOCUMENTOS_SINC] D WITH (NOLOCK)&#xA;INNER JOIN&#xA;&#x9;TMP.#MOXP_01_SEGUI_ENV AS SE WITH (NOLOCK, INDEX(TMP_IDX_MOXP_SEGUI_ENV))&#xA;ON&#xA;&#x9;D.ID_PROCESO = SE.ID_PROCESO&#xA;AND &#xA;&#x9;D.NUMERO_MOVIMI = SE.NUMERO_MOVIMI&#xA;AND &#xA;&#x9;D.CONSECUT_MOVIMI = SE.CONSECUT_MOVIMI&#xA;GO&#xA;&#xA;/* inserta información para el CIL VILLAVICENCIO */&#xA;INSERT INTO [TMP].[OS174_MOXP_DOCU_CILES_CONSOLIDADO]&#xA;SELECT&#xA;&#x9;SE.NUMERO_GUIA&#xA;&#x9;,D.[ID_PROCESO]&#xA;&#x9;,D.[NUMERO_MOVIMI]&#xA;&#x9;,D.[CONSECUT_MOVIMI]&#xA;&#x9;,D.ESTADO_MOVIMI&#xA;&#x9;,SE.FECHA_HORA_MOVIMIENTO     &#xA;FROM [LOG].[DOCUMENTOS_VILL] D WITH (NOLOCK)&#xA;INNER JOIN&#xA;&#x9;TMP.#MOXP_01_SEGUI_ENV AS SE WITH (NOLOCK, INDEX(TMP_IDX_MOXP_SEGUI_ENV))&#xA;ON&#xA;&#x9;D.ID_PROCESO = SE.ID_PROCESO&#xA;AND &#xA;&#x9;D.NUMERO_MOVIMI = SE.NUMERO_MOVIMI&#xA;AND &#xA;&#x9;D.CONSECUT_MOVIMI = SE.CONSECUT_MOVIMI&#xA;GO&#xA;&#xA;/* inserta información para el CIL SAN ANDRES PROVINCIA */&#xA;INSERT INTO [TMP].[OS174_MOXP_DOCU_CILES_CONSOLIDADO]&#xA;SELECT&#xA;&#x9;SE.NUMERO_GUIA&#xA;&#x9;,D.[ID_PROCESO]&#xA;&#x9;,D.[NUMERO_MOVIMI]&#xA;&#x9;,D.[CONSECUT_MOVIMI]&#xA;&#x9;,D.ESTADO_MOVIMI&#xA;&#x9;,SE.FECHA_HORA_MOVIMIENTO     &#xA;FROM [LOG].[DOCUMENTOS_PROV] D WITH (NOLOCK)&#xA;INNER JOIN&#xA;&#x9;TMP.#MOXP_01_SEGUI_ENV AS SE WITH (NOLOCK, INDEX(TMP_IDX_MOXP_SEGUI_ENV))&#xA;ON&#xA;&#x9;D.ID_PROCESO = SE.ID_PROCESO&#xA;AND &#xA;&#x9;D.NUMERO_MOVIMI = SE.NUMERO_MOVIMI&#xA;AND &#xA;&#x9;D.CONSECUT_MOVIMI = SE.CONSECUT_MOVIMI&#xA;GO&#xA;&#xA;SET NOCOUNT OFF;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
