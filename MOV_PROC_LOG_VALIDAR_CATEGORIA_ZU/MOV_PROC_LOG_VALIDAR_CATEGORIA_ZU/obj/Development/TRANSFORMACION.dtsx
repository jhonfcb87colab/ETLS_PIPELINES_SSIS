            <DTS:Executable
              DTS:refId="Package\Contenedor de secuencias\MANIFIESTOS\QUITAR_DUPLICADOS_CONSO"
              DTS:CreationName="Microsoft.ExecuteSQLTask"
              DTS:Description="Execute SQL Task"
              DTS:DTSID="{399A4C6E-B4F6-4E3F-82C3-0652C51D2FB0}"
              DTS:ExecutableType="Microsoft.ExecuteSQLTask"
              DTS:LocaleID="-1"
              DTS:ObjectName="QUITAR_DUPLICADOS_CONSO"
              DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
              DTS:ThreadHint="0">
              <DTS:Variables />
              <DTS:LoggingOptions
                DTS:FilterKind="0" />
              <DTS:ObjectData>
                <SQLTask:SqlTaskData
                  SQLTask:Connection="{A947580C-C7C7-4E60-B63D-7A9EA12E8F3A}"
                  SQLTask:SqlStatementSource="SET NOCOUNT ON ; &#xA;&#xA;WITH QUITAR_DUPLICADOS&#xA;(&#xA;&#x9;ROW_REP,&#xA;&#x9;[SE_NUMERO_GUIA],&#xA;&#x9;[DC_ID_PROCESO],&#xA;&#x9;[DC_NUMERO_MOVI],&#xA;&#x9;[DC_CONSECUT_MOVI],&#xA;&#x9;[DC_ESTADO_MOVIMI],&#xA;&#x9;[SE_FECHA_HORA_MOVIMIENTO]&#xA;)&#xA;AS&#xA;(&#xA;SELECT &#xA;&#x9;ROW_NUMBER() OVER (PARTITION BY SE_NUMERO_GUIA, [DC_ID_PROCESO], [DC_NUMERO_MOVI],[DC_CONSECUT_MOVI]  ORDER BY [SE_FECHA_HORA_MOVIMIENTO] DESC) AS ROW_REP,&#xA;&#x9;[SE_NUMERO_GUIA],&#xA;&#x9;[DC_ID_PROCESO],&#xA;&#x9;[DC_NUMERO_MOVI],&#xA;&#x9;[DC_CONSECUT_MOVI],&#xA;&#x9;[DC_ESTADO_MOVIMI],&#xA;&#x9;[SE_FECHA_HORA_MOVIMIENTO]&#xA;FROM&#xA;&#x9;[TMP].[OS174_MOXP_DOCU_CILES_CONSOLIDADO] &#xA;)&#xA;INSERT INTO [TMP].[OS174_MOXP_DOCU_CILES]&#xA;(&#xA;&#x9;[SE_NUMERO_GUIA],&#xA;&#x9;[DC_ID_PROCESO],&#xA;&#x9;[DC_NUMERO_MOVI],&#xA;&#x9;[DC_CONSECUT_MOVI],&#xA;&#x9;[DC_ESTADO_MOVIMI],&#xA;&#x9;[SE_FECHA_HORA_MOVIMIENTO]&#xA;)&#xA;&#xA;SELECT &#xA;&#x9;[SE_NUMERO_GUIA],&#xA;&#x9;[DC_ID_PROCESO],&#xA;&#x9;[DC_NUMERO_MOVI],&#xA;&#x9;[DC_CONSECUT_MOVI],&#xA;&#x9;[DC_ESTADO_MOVIMI],&#xA;&#x9;[SE_FECHA_HORA_MOVIMIENTO]&#xA;FROM QUITAR_DUPLICADOS&#xA;WHERE ROW_REP = 1&#xA;;&#xA;&#xA;SET NOCOUNT OFF;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
              </DTS:ObjectData>
            </DTS:Executable>
          </DTS:Executables>
