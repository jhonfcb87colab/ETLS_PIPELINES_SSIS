          SQLTask:SqlStatementSource="DROP TABLE IF EXISTS #MOXP_01;&#xA;&#xA;SELECT &#xA;ROW_NUMBER() OVER (PARTITION BY [SE_NUMERO_GUIA], [DC_NUMERO_MOVI], [DC_CONSECUT_MOVI], [DC_ID_PROCESO] ORDER BY ORDEN_INF_TBL, [SE_FECHA_HORA_MOVIMIENTO] DESC ) AS #ROW,&#xA;[SE_NUMERO_GUIA]&#xA;      ,[SE_FECHA_HORA_MOVIMIENTO]&#xA;      ,[SE_ID_CONCEPTO]&#xA;      ,[SE_ID_TIPOENVIO]&#xA;      ,[SE_NUMERO_PIEZAS]&#xA;      ,[SE_PESO_ENVIO]&#xA;      ,[DC_ID_PROCESO]&#xA;      ,[DC_NUMERO_MOVI]&#xA;      ,[DC_CONSECUT_MOVI]&#xA;      ,[DC_ID_CIUDAD_CANAL]&#xA;      ,[DC_ID_CIUDAD_ZONA_URBA]&#xA;      ,[DC_ID_PAIS_DIVISION_ORIGEN]&#xA;      ,[DC_ID_CIUDAD_DIVISION_ORIGEN]&#xA;      ,[DC_ID_DIVISION_ORIGEN]&#xA;      ,[DC_ID_PAIS_DESTINO]&#xA;      ,[DC_ID_CIUDAD_DESTINO]&#xA;      ,[DC_ID_DIVISION_DESTINO]&#xA;      ,[DC_PLACA_VEHICULO_DOCU]&#xA;      ,[DC_ID_TIPO_ZONA_URBA]&#xA;      ,[DC_ID_ZONA_URBA]&#xA;      ,[DC_ID_PAIS_OPERATIVO]&#xA;      ,[DC_ID_CIUDAD_OPERATIVO]&#xA;      ,[DC_ID_OPERATIVO]&#xA;      ,[DC_ESTADO_MOVIMI]&#xA;      ,[GU_ID_TIPOGUIA]&#xA;      ,[GU_ID_CIUDAD_ORIGEN]&#xA;      ,[GU_ID_CIUDAD_DESTINO]&#xA;      ,[GU_ID_TIEMPO]&#xA;      ,[GU_ID_PRODUCTO]&#xA;      ,[GU_ID_SUBPRODUCTO]&#xA;      ,[GU_ID_CLIENTE]&#xA;      ,[GU_FECHA_ENVIO]&#xA;      ,[GU_ID_ESTADOENVIO]&#xA;      ,[SE_ID_ESTA_FISICO]&#xA;&#x9;  ,ORDEN_INF_TBL&#xA;INTO #MOXP_01&#xA;  FROM [TMP].[MOXP_01_CONSOLID] WITH(NOLOCK)&#xA;  WHERE LEN([SE_NUMERO_GUIA]) &gt; 8&#xA;;&#xA;&#xA;  &#xA;TRUNCATE TABLE TMP.MOXP_01;&#xA;&#xA;INSERT TMP.MOXP_01&#xA;(&#xA;[SE_NUMERO_GUIA]&#xA;      ,[SE_FECHA_HORA_MOVIMIENTO]&#xA;      ,[SE_ID_CONCEPTO]&#xA;      ,[SE_ID_TIPOENVIO]&#xA;      ,[SE_NUMERO_PIEZAS]&#xA;      ,[SE_PESO_ENVIO]&#xA;      ,[DC_ID_PROCESO]&#xA;      ,[DC_NUMERO_MOVI]&#xA;      ,[DC_CONSECUT_MOVI]&#xA;      ,[DC_ID_CIUDAD_CANAL]&#xA;      ,[DC_ID_CIUDAD_ZONA_URBA]&#xA;      ,[DC_ID_PAIS_DIVISION_ORIGEN]&#xA;      ,[DC_ID_CIUDAD_DIVISION_ORIGEN]&#xA;      ,[DC_ID_DIVISION_ORIGEN]&#xA;      ,[DC_ID_PAIS_DESTINO]&#xA;      ,[DC_ID_CIUDAD_DESTINO]&#xA;      ,[DC_ID_DIVISION_DESTINO]&#xA;      ,[DC_PLACA_VEHICULO_DOCU]&#xA;      ,[DC_ID_TIPO_ZONA_URBA]&#xA;      ,[DC_ID_ZONA_URBA]&#xA;      ,[DC_ID_PAIS_OPERATIVO]&#xA;      ,[DC_ID_CIUDAD_OPERATIVO]&#xA;      ,[DC_ID_OPERATIVO]&#xA;      ,[DC_ESTADO_MOVIMI]&#xA;      ,[GU_ID_TIPOGUIA]&#xA;      ,[GU_ID_CIUDAD_ORIGEN]&#xA;      ,[GU_ID_CIUDAD_DESTINO]&#xA;      ,[GU_ID_TIEMPO]&#xA;      ,[GU_ID_PRODUCTO]&#xA;      ,[GU_ID_SUBPRODUCTO]&#xA;      ,[GU_ID_CLIENTE]&#xA;      ,[GU_FECHA_ENVIO]&#xA;      ,[GU_ID_ESTADOENVIO]&#xA;      ,[SE_ID_ESTA_FISICO]&#xA;/* HABIALITAR EN PRODUCCIÓN */&#xA;-- , ID_TipoPruebaEntrega&#x9;&#xA;-- ,ID_ModoEntrega&#xA;)&#xA;SELECT &#xA;--COUNT(1) AS TT&#xA;[SE_NUMERO_GUIA]&#xA;      ,[SE_FECHA_HORA_MOVIMIENTO]&#xA;      ,[SE_ID_CONCEPTO]&#xA;      ,[SE_ID_TIPOENVIO]&#xA;      ,[SE_NUMERO_PIEZAS]&#xA;      ,[SE_PESO_ENVIO]&#xA;      ,[DC_ID_PROCESO]&#xA;      ,[DC_NUMERO_MOVI]&#xA;      ,[DC_CONSECUT_MOVI]&#xA;      ,[DC_ID_CIUDAD_CANAL]&#xA;      ,[DC_ID_CIUDAD_ZONA_URBA]&#xA;      ,[DC_ID_PAIS_DIVISION_ORIGEN]&#xA;      ,[DC_ID_CIUDAD_DIVISION_ORIGEN]&#xA;      ,[DC_ID_DIVISION_ORIGEN]&#xA;      ,[DC_ID_PAIS_DESTINO]&#xA;      ,[DC_ID_CIUDAD_DESTINO]&#xA;      ,[DC_ID_DIVISION_DESTINO]&#xA;      ,[DC_PLACA_VEHICULO_DOCU]&#xA;      ,[DC_ID_TIPO_ZONA_URBA]&#xA;      ,[DC_ID_ZONA_URBA]&#xA;      ,[DC_ID_PAIS_OPERATIVO]&#xA;      ,[DC_ID_CIUDAD_OPERATIVO]&#xA;      ,[DC_ID_OPERATIVO]&#xA;      ,[DC_ESTADO_MOVIMI]&#xA;      ,[GU_ID_TIPOGUIA]&#xA;      ,[GU_ID_CIUDAD_ORIGEN]&#xA;      ,[GU_ID_CIUDAD_DESTINO]&#xA;      ,[GU_ID_TIEMPO]&#xA;      ,[GU_ID_PRODUCTO]&#xA;      ,[GU_ID_SUBPRODUCTO]&#xA;      ,[GU_ID_CLIENTE]&#xA;      ,[GU_FECHA_ENVIO]&#xA;      ,[GU_ID_ESTADOENVIO]&#xA;      ,[SE_ID_ESTA_FISICO] &#xA;/* Se hace modificaicón para tipos de entrega */&#xA;-- , -888 AS ID_TipoPruebaEntrega&#xA;-- , -888 AS ID_ModoEntrega&#xA;FROM #MOXP_01 WITH(NOLOCK)&#xA;WHERE #ROW = 1&#xA;OPTION(FAST 1)&#xA;;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
