            <SQLTask:SqlTaskData
              SQLTask:Connection="{A947580C-C7C7-4E60-B63D-7A9EA12E8F3A}"
              SQLTask:SqlStatementSource="UPDATE [TMP].[MOXP_01]&#xA;SET ID_EST_CONCEPTO = CASE WHEN a.SE_ID_CONCEPTO IS NULL OR a.SE_ID_CONCEPTO = 0 OR b.ID_CONCEPTO IS NULL THEN 3&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;   WHEN b.ID_PROCESO IS NULL OR  b.ID_CONCEPTO IS NULL OR B.ID_EST_CONCEPTO = 0  THEN 0&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;   ELSE 1 END&#xA;&#x9;FROM TMP.MOXP_01 AS a WITH(NOLOCK)&#xA;&#x9;LEFT JOIN DIM.ESTADO_CONCEPTO_LOGISTICO AS b WITH(NOLOCK)&#xA;&#x9;ON a.DC_ID_PROCESO = b.ID_PROCESO AND a.SE_ID_CONCEPTO = b.ID_CONCEPTO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
