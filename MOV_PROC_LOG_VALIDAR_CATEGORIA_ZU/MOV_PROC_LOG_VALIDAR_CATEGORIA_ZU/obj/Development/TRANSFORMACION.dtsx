        <DTS:Executable
          DTS:refId="Package\Contenedor de secuencias\Contenedor de secuencias 1"
          DTS:CreationName="STOCK:SEQUENCE"
          DTS:Description="Contenedor de secuencias"
          DTS:DTSID="{2A97AF0F-EE53-49E7-9A01-F58D71AD4CAA}"
          DTS:ExecutableType="STOCK:SEQUENCE"
          DTS:LocaleID="-1"
          DTS:ObjectName="Contenedor de secuencias 1">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:Executables>
            <DTS:Executable
              DTS:refId="Package\Contenedor de secuencias\Contenedor de secuencias 1\Agregar ID_Dimension"
              DTS:CreationName="Microsoft.ExecuteSQLTask"
              DTS:Description="Execute SQL Task"
              DTS:DTSID="{5A36437E-2B41-4AC9-9293-FC2B7A6027C4}"
              DTS:ExecutableType="Microsoft.ExecuteSQLTask"
              DTS:LocaleID="-1"
              DTS:ObjectName="Agregar ID_Dimension"
              DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
              DTS:ThreadHint="0">
              <DTS:Variables />
              <DTS:LoggingOptions
                DTS:FilterKind="0" />
              <DTS:ObjectData>
                <SQLTask:SqlTaskData
                  SQLTask:Connection="{A947580C-C7C7-4E60-B63D-7A9EA12E8F3A}"
                  SQLTask:SqlStatementSource="-------INSERTAR ID EN LA DIMENSION &#xA;;WITH CTE_ID_DIMENSION (ID_DIMENSION, SE_NUMERO_GUIA, DC_ID_PROCESO)&#xA;AS&#xA;(&#xA;&#xA;SELECT -- A.ID_TipoPruebaEntrega ,  A.ID_ModoEntrega, &#xA;IIF(A.ID_TipoPruebaEntrega = ' ' AND A.ID_ModoEntrega = ' ',0&#xA;&#x9;, IIF(A.ID_TipoPruebaEntrega = 1 AND A.ID_ModoEntrega = 2,1&#xA;&#x9;, IIF(A.ID_TipoPruebaEntrega = 1 AND A.ID_ModoEntrega = 1,2&#xA;&#x9;, IIF(A.ID_TipoPruebaEntrega = 2 AND A.ID_ModoEntrega = 1,3&#xA;&#x9;, IIF(A.ID_TipoPruebaEntrega = 2 AND A.ID_ModoEntrega = 2,4&#xA;&#x9;, IIF(A.ID_TipoPruebaEntrega =-888 AND A.ID_ModoEntrega =-888,0&#xA;&#x9;, IIF(A.ID_TipoPruebaEntrega is null AND A.ID_ModoEntrega = 1,0,0&#xA;&#x9;&#x9;))))))) AS ID_DIMENSION&#xA;&#x9;, SE_NUMERO_GUIA,  DC_ID_PROCESO&#xA;FROM SIG_COLOMBIA_DW.TMP.MOXP_01 A WITH (NOLOCK) &#xA;)&#xA;UPDATE SIG_COLOMBIA_DW.TMP.MOXP_01&#xA;SET ID_CARACT_ENTREGA = A.ID_DIMENSION&#xA;FROM CTE_ID_DIMENSION A&#xA;INNER JOIN SIG_COLOMBIA_DW.TMP.MOXP_01 B WITH (NOLOCK) &#xA;ON A.SE_NUMERO_GUIA = B.SE_NUMERO_GUIA  AND A.DC_ID_PROCESO = B.DC_ID_PROCESO&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;/*&#xA;WITH CTE_ID_DIMENSION (ID_DIMENSION, SE_NUMERO_GUIA)&#xA;AS&#xA;(&#xA;&#xA;SELECT IIF(A.ID_TipoPruebaEntrega = ' ' AND A.ID_ModoEntrega = ' ',0, IIF(A.ID_TipoPruebaEntrega = 1 AND A.ID_ModoEntrega = 2,1,IIF(A.ID_TipoPruebaEntrega = 1 AND A.ID_ModoEntrega = 1,2,IIF(A.ID_TipoPruebaEntrega = 2 AND A.ID_ModoEntrega = 1,3,&#xA;IIF(A.ID_TipoPruebaEntrega = 2 AND A.ID_ModoEntrega = 2,4,IIF(A.ID_TipoPruebaEntrega =-888 AND A.ID_ModoEntrega =-888,0,IIF(A.ID_TipoPruebaEntrega is null AND A.ID_ModoEntrega = 1,0,0))))))) ID_DIMENSION, SE_NUMERO_GUIA&#xA;FROM SIG_COLOMBIA_DW.TMP.MOXP_01 A WITH (NOLOCK) &#xA;  --WHERE A.SE_NUMERO_GUIA in(9168819332,2194265711)&#xA;)&#xA;&#xA;UPDATE SIG_COLOMBIA_DW.TMP.MOXP_01&#xA;SET ID_CARACT_ENTREGA = A.ID_DIMENSION&#xA;FROM CTE_ID_DIMENSION A&#xA;INNER JOIN SIG_COLOMBIA_DW.TMP.MOXP_01 B WITH (NOLOCK) ON A.SE_NUMERO_GUIA = B.SE_NUMERO_GUIA&#xA;--WHERE B.SE_NUMERO_GUIA in(9168819332,2171397790,2194265711)  &#xA;*/" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
              </DTS:ObjectData>
            </DTS:Executable>
            <DTS:Executable
              DTS:refId="Package\Contenedor de secuencias\Contenedor de secuencias 1\Agregar Modo Emtregar"
              DTS:CreationName="Microsoft.ExecuteSQLTask"
              DTS:Description="Execute SQL Task"
              DTS:DTSID="{C8DCBEC8-0C3B-46C6-AA0F-9C2E224BB9F9}"
              DTS:ExecutableType="Microsoft.ExecuteSQLTask"
              DTS:LocaleID="-1"
              DTS:ObjectName="Agregar Modo Emtregar"
              DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
              DTS:ThreadHint="0">
              <DTS:Variables />
              <DTS:LoggingOptions
                DTS:FilterKind="0" />
              <DTS:ObjectData>
                <SQLTask:SqlTaskData
                  SQLTask:Connection="{A947580C-C7C7-4E60-B63D-7A9EA12E8F3A}"
                  SQLTask:SqlStatementSource="-------consulta MODOENTREGA&#xA;  ;WITH MOXP AS (&#xA;&#x9;SELECT SE_NUMERO_GUIA, DC_ID_PROCESO, DC_NUMERO_MOVI, DC_CONSECUT_MOVI, ID_ModoEntrega&#xA;&#x9;FROM TMP.MOXP_01 A WITH (NOLOCK) &#xA;&#x9;WHERE DC_ID_PROCESO IN (11,24)&#xA;)&#xA;UPDATE A&#xA;SET A.ID_ModoEntrega = IIF(A.DC_ID_PROCESO IN (11,24) ,C.TIPO_PRUEBA_ENTREGA, A.ID_ModoEntrega  ) &#xA;FROM MOXP AS A&#xA; LEFT JOIN SIG_COLOMBIA_DW.LOG.SEGUIMIENTO_ENVIO_INF_ADICIONAL_MOVIL C WITH (NOLOCK) &#xA;  ON A.SE_NUMERO_GUIA = C.NUMERO_GUIA&#xA;  WHERE C.TIPO_PRUEBA_ENTREGA = 2 &#xA;&#xA;&#xA;&#xA;/* Valida datos donde tipo entrega sea virtual y modo entrega sea distinto a virtual para igualarlos */&#xA;UPDATE TMP.MOXP_01&#xA;SET ID_ModoEntrega = ID_TipoPruebaEntrega&#xA;WHERE ID_TipoPruebaEntrega = 2 &#xA;AND ID_TipoPruebaEntrega &lt;&gt; ID_ModoEntrega &#xA;;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;/*&#xA;WITH CTE_MODOENTREGA (MODOENTREGA, SE_NUMERO_GUIA, DC_ID_PROCESO)&#xA;AS&#xA;(&#xA;&#xA;SELECT CASE WHEN C.TIPO_PRUEBA_ENTREGA = ' ' THEN -888 WHEN C.TIPO_PRUEBA_ENTREGA IS NULL THEN 1 ELSE C.TIPO_PRUEBA_ENTREGA END AS MODOENTREGA, A.SE_NUMERO_GUIA, A.DC_ID_PROCESO&#xA;FROM SIG_COLOMBIA_DW.TMP.MOXP_01 A WITH (NOLOCK) &#xA;LEFT JOIN SIG_COLOMBIA_DW.LOG.SEGUIMIENTO_ENVIO_INF_ADICIONAL_MOVIL C WITH (NOLOCK) ON A.SE_NUMERO_GUIA  = C.NUMERO_GUIA ---AND C.ID_PROCESO = A.DC_ID_PROCESO&#xA;  --WHERE A.SE_NUMERO_GUIA in(9168819332,2194265711)&#xA;)&#xA;&#xA;UPDATE SIG_COLOMBIA_DW.TMP.MOXP_01&#xA;SET ID_ModoEntrega = A.MODOENTREGA&#xA;FROM CTE_MODOENTREGA A&#xA;INNER JOIN SIG_COLOMBIA_DW.TMP.MOXP_01 B WITH (NOLOCK) ON A.SE_NUMERO_GUIA = B.SE_NUMERO_GUIA&#xA;--WHERE B.SE_NUMERO_GUIA in(9168819332,2171397790,2194265711) AND &#xA;WHERE B.DC_ID_PROCESO IN (24,11)&#xA;*/" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
              </DTS:ObjectData>
            </DTS:Executable>
            <DTS:Executable
              DTS:refId="Package\Contenedor de secuencias\Contenedor de secuencias 1\Agregar Tipo_Prueba_Entrega"
              DTS:CreationName="Microsoft.ExecuteSQLTask"
              DTS:Description="Execute SQL Task"
              DTS:DTSID="{7ACB8D96-A162-4BB7-B9B2-56A690D6CACC}"
              DTS:ExecutableType="Microsoft.ExecuteSQLTask"
              DTS:LocaleID="-1"
              DTS:ObjectName="Agregar Tipo_Prueba_Entrega"
              DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
              DTS:ThreadHint="0">
              <DTS:Variables />
              <DTS:LoggingOptions
                DTS:FilterKind="0" />
              <DTS:ObjectData>
                <SQLTask:SqlTaskData
                  SQLTask:Connection="{A947580C-C7C7-4E60-B63D-7A9EA12E8F3A}"
                  SQLTask:SqlStatementSource=" ----CONSULTA TIPOPRUEBAENTREGA&#xA;&#xA;UPDATE TMP.MOXP_01&#xA;SET ID_TipoPruebaEntrega = 1,&#xA;ID_ModoEntrega = 1&#xA;WHERE DC_ID_PROCESO IN (11,24)&#xA;;&#xA;GO&#xA;&#xA;&#xA;;WITH MOXP AS (&#xA;&#x9;SELECT SE_NUMERO_GUIA, DC_ID_PROCESO, DC_NUMERO_MOVI, DC_CONSECUT_MOVI, ID_TipoPruebaEntrega&#xA;&#x9;FROM TMP.MOXP_01 A WITH (NOLOCK) &#xA;&#x9;WHERE DC_ID_PROCESO IN (11,24)&#xA;)&#xA;&#xA;UPDATE  A&#xA;SET A.ID_TipoPruebaEntrega = IIF(A.DC_ID_PROCESO IN (11,24) ,C.TIPO_PRUEBA_ENTREGA, A.ID_TipoPruebaEntrega  )&#xA;FROM MOXP AS A&#xA; LEFT JOIN SIG_COLOMBIA_DW.LOG.PRUEBAS_ENTREGA  C WITH (NOLOCK) ---_ACTUAL&#xA;  ON A.SE_NUMERO_GUIA = C.NUMERO_GUIA&#xA;  WHERE C.TIPO_PRUEBA_ENTREGA = 2 &#xA;&#xA;&#xA;&#xA;&#xA;/*&#xA;WITH CTE_TIPOPRUEBAENTREGA (TIPOPRUEBAENTREGA, NUMERO_GUIA)&#xA;AS &#xA;&#xA;(&#xA;&#xA;  SELECT CASE WHEN C.TIPO_PRUEBA_ENTREGA = ' ' THEN -888 WHEN C.TIPO_PRUEBA_ENTREGA IS NULL THEN -888  WHEN C.TIPO_PRUEBA_ENTREGA IS NULL THEN 1 ELSE C.TIPO_PRUEBA_ENTREGA END AS TIPOPRUEBAENTREGA, NUMERO_GUIA&#xA;  FROM SIG_COLOMBIA_DW.TMP.MOXP_01 A WITH (NOLOCK) &#xA;  LEFT JOIN SIG_COLOMBIA_DW.LOG.PRUEBAS_ENTREGA_ACTUAL C WITH (NOLOCK) ON A.SE_NUMERO_GUIA = C.NUMERO_GUIA&#xA;   --- WHERE A.SE_NUMERO_GUIA in(9168819332,2171397790,2194265711)&#xA;  --- WHERE A.SE_NUMERO_GUIA in ('9166841077', '9137534290')&#xA;)&#xA;&#xA;UPDATE SIG_COLOMBIA_DW.TMP.MOXP_01&#xA;SET ID_TipoPruebaEntrega = TIPOPRUEBAENTREGA&#xA;FROM CTE_TIPOPRUEBAENTREGA A WITH (NOLOCK) &#xA;INNER JOIN SIG_COLOMBIA_DW.TMP.MOXP_01 B WITH (NOLOCK) ON A.NUMERO_GUIA = B.SE_NUMERO_GUIA&#xA;---WHERE B.SE_NUMERO_GUIA in(9168819332,2171397790,2194265711)&#xA;&#xA;*/&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
              </DTS:ObjectData>
            </DTS:Executable>
          </DTS:Executables>
          <DTS:PrecedenceConstraints>
            <DTS:PrecedenceConstraint
              DTS:refId="Package\Contenedor de secuencias\Contenedor de secuencias 1.PrecedenceConstraints[Constraint 3]"
              DTS:CreationName=""
              DTS:DTSID="{A60FBF1E-B0FE-4E01-AAB6-FB77CD45C178}"
              DTS:From="Package\Contenedor de secuencias\Contenedor de secuencias 1\Agregar Tipo_Prueba_Entrega"
              DTS:LogicalAnd="True"
              DTS:ObjectName="Constraint 3"
              DTS:To="Package\Contenedor de secuencias\Contenedor de secuencias 1\Agregar Modo Emtregar" />
            <DTS:PrecedenceConstraint
              DTS:refId="Package\Contenedor de secuencias\Contenedor de secuencias 1.PrecedenceConstraints[Constraint 4]"
              DTS:CreationName=""
              DTS:DTSID="{6A154BA1-7358-432B-9FD9-6C79F819B87A}"
              DTS:From="Package\Contenedor de secuencias\Contenedor de secuencias 1\Agregar Modo Emtregar"
              DTS:LogicalAnd="True"
              DTS:ObjectName="Constraint 4"
              DTS:To="Package\Contenedor de secuencias\Contenedor de secuencias 1\Agregar ID_Dimension" />
          </DTS:PrecedenceConstraints>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Contenedor de secuencias\EST_CARGA_NUEVAS_ZONAS_DIM"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{69A30477-3BD6-47C3-8637-9B2E6B5B867B}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="EST_CARGA_NUEVAS_ZONAS_DIM"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{31827A4F-F50A-440E-AF10-C379306890BB}"
              SQLTask:SqlStatementSource="&#xA;--- zonas base con datos por default en NO DISPONIBLE&#xA;/*&#xA;TRUNCATE TABLE [DIM].[CIUDADES_MOVIMIENTOS_MOVILIZADOS_ZONA]&#xA;GO&#xA;INSERT INTO [DIM].[CIUDADES_MOVIMIENTOS_MOVILIZADOS_ZONA]&#xA;SELECT CM.*,&#xA;CONCAT(ISNULL([ID_CIUDAD],0),'-NO DISPONIBLE' ) AS ID_CIUDAD_ZONA,&#xA;'NO DISPONIBLE' AS ZONA&#xA;FROM DIM.CIUDADES_MOVIMIENTOS_MOVILIZADOS AS CM WITH(NOLOCK)&#xA;*/&#xA;/*************************************************************************************************/&#xA;/********************** DIM GEOGRAFIA DESTINO Y ORIGEN *******************************************/&#xA;/*************************************************************************************************/&#xA;DROP TABLE IF EXISTS #CIUDADES_ZONAS;&#xA;SELECT &#xA;T.ID_PAIS, T.ID_CIUDAD, T.ZONA , T.ID_CIUDAD_ZONA&#xA;INTO #CIUDADES_ZONAS&#xA;FROM (&#xA;&#x9; SELECT &#xA;&#x9;  ISNULL(EM.ID_CIUDAD_ORIGEN_G,0) AS ID_CIUDAD&#xA;&#x9;  , 1 AS ID_PAIS&#xA;&#x9;  ,&#x9;SUBSTRING( ID_CODIGO_ZONA_ORIG, CHARINDEX('-',  ID_CODIGO_ZONA_ORIG)+1 , LEN(ID_CODIGO_ZONA_ORIG)+1- (CHARINDEX('-',  ID_CODIGO_ZONA_ORIG)))  AS ZONA&#xA;&#x9;  , ID_CODIGO_ZONA_ORIG AS ID_CIUDAD_ZONA&#xA;&#x9; FROM SIG_COLOMBIA_DW.TMP.MOXP EM WITH (NOLOCK) &#xA;&#x9; GROUP BY   ISNULL(EM.ID_CIUDAD_ORIGEN_G,0)&#xA;&#x9; , ID_CODIGO_ZONA_ORIG&#xA;&#x9;  UNION ALL&#xA;&#x9; SELECT &#xA;&#x9;  ISNULL(EM.ID_CIUDAD_DESTINO_G,0) AS ID_CIUDAD&#xA;&#x9;  , 1 AS ID_PAIS&#xA;&#x9;  ,&#x9;SUBSTRING( ID_CODIGO_ZONA_DEST, CHARINDEX('-',  ID_CODIGO_ZONA_DEST)+1 , LEN(ID_CODIGO_ZONA_DEST)+1- (CHARINDEX('-',  ID_CODIGO_ZONA_DEST)))  AS ZONA&#xA;&#x9;  , ID_CODIGO_ZONA_DEST AS ID_CIUDAD_ZONA&#xA;&#x9; FROM SIG_COLOMBIA_DW.TMP.MOXP EM WITH (NOLOCK) &#xA;&#x9; GROUP BY   ISNULL(EM.ID_CIUDAD_DESTINO_G,0)&#xA;&#x9; , ID_CODIGO_ZONA_DEST&#xA;) AS T&#xA;GROUP BY T.ID_PAIS, T.ID_CIUDAD, T.ID_CIUDAD_ZONA, T.ZONA&#xA;ORDER BY ID_CIUDAD, ID_CIUDAD_ZONA&#xA;&#xA;&#xA;/*************************************************************************************************/&#xA;DROP TABLE IF EXISTS #TBL_CIUDADES_ZONAS;&#xA;&#xA;SELECT CM.*, CZ.ID_CIUDAD_ZONA, CZ.ZONA &#xA; INTO #TBL_CIUDADES_ZONAS&#xA;FROM DIM.CIUDADES_MOVIMIENTOS_MOVILIZADOS AS CM WITH(NOLOCK)&#xA;INNER  JOIN #CIUDADES_ZONAS AS CZ &#xA;ON CM.ID_PAIS = CZ.ID_PAIS AND CM.ID_CIUDAD = CZ.ID_CIUDAD&#xA;;&#xA;&#xA;/*************************************************************************************************/&#xA;;MERGE [DIM].[CIUDADES_MOVIMIENTOS_MOVILIZADOS_ZONA] AS target&#xA;USING #TBL_CIUDADES_ZONAS AS source&#xA;ON  target.[ID_PAIS]  = source.[ID_PAIS] AND target.[ID_CIUDAD]  = source.[ID_CIUDAD]  AND  target.[ID_CIUDAD_ZONA]  = source.[ID_CIUDAD_ZONA]&#xA;WHEN MATCHED     AND target.ID_CIUDAD_ZONA  &lt;&gt;  source.ID_CIUDAD_ZONA&#xA;&#x9;OR (&#x9;target.[ID_PAIS]  &lt;&gt; source.[ID_PAIS]&#xA;&#x9;&#x9;OR&#x9;target.[ID_CIUDAD]  &lt;&gt; source.[ID_CIUDAD]&#xA;&#x9;&#x9;OR&#x9;target.[ID_REGIONAL]  &lt;&gt; source.[ID_REGIONAL]&#xA;&#x9;&#x9;OR&#x9;target.ZONA  &lt;&gt; source.ZONA&#xA;&#x9;) THEN&#xA;    UPDATE &#xA; SET  target.[ID_PAIS]  = source.[ID_PAIS]&#xA;  ,target.[ID_CIUDAD]  = source.[ID_CIUDAD]&#xA;  ,target.[NOMBRE_CIUDAD]  = source.[NOMBRE_CIUDAD]&#xA;  ,target.[CLASE_SISTEMA]  = source.[CLASE_SISTEMA]&#xA;  ,target.[ID_REGIONAL]  = source.[ID_REGIONAL]&#xA;  ,target.[NOMBRE_REGIONAL]  = source.[NOMBRE_REGIONAL]&#xA;  ,target.[FECHA_ACTUALIZACION]  = source.[FECHA_ACTUALIZACION]&#xA;  ,target.[NOMBRE_CPL]  = source.[NOMBRE_CPL]&#xA;  ,target.ID_CIUDAD_ZONA  = source.ID_CIUDAD_ZONA&#xA;  ,target.ZONA  = source.ZONA&#xA;&#xA;WHEN NOT MATCHED THEN&#xA;    INSERT (&#xA;  [ID_PAIS]&#xA;  ,[ID_CIUDAD]&#xA;  ,[NOMBRE_CIUDAD]&#xA;  ,[CLASE_SISTEMA]&#xA;  ,[ID_REGIONAL]&#xA;  ,[NOMBRE_REGIONAL]&#xA;  ,[FECHA_ACTUALIZACION]&#xA;  ,[NOMBRE_CPL]&#xA;  ,ID_CIUDAD_ZONA&#xA;  ,ZONA&#xA; )&#xA; VALUES(  source.[ID_PAIS]&#xA;   ,source.[ID_CIUDAD]&#xA;   ,source.[NOMBRE_CIUDAD]&#xA;   ,source.[CLASE_SISTEMA]&#xA;   ,source.[ID_REGIONAL]&#xA;   ,source.[NOMBRE_REGIONAL]&#xA;   ,source.[FECHA_ACTUALIZACION]&#xA;   ,source.[NOMBRE_CPL]&#xA;   ,source.ID_CIUDAD_ZONA&#xA;   ,source.ZONA&#xA;  );&#xA;&#xA;DROP TABLE IF EXISTS #CIUDADES_ZONAS;&#xA;DROP TABLE IF EXISTS #TBL_CIUDADES_ZONAS;&#xA;/*************************************************************************************************/&#xA;/*************************************************************************************************/&#xA;/*************************************************************************************************/&#xA;&#xA;/*************************************************************************************************/&#xA;/******************** DIM GEOGRAFIA PE ZONA GEO **************************************************/&#xA;/*************************************************************************************************/&#xA;DROP TABLE IF EXISTS #MOXP_CIUDAD&#xA;SELECT TMP.ID_CIUDAD_MOV, TMP.ZONA_GEO_PE&#xA;INTO #MOXP_CIUDAD&#xA;FROM SIG_COLOMBIA_DW.TMP.MOXP  AS  TMP (NOLOCK)&#xA;GROUP BY TMP.ID_CIUDAD_MOV, TMP.ZONA_GEO_PE&#xA;;&#xA;&#xA;;MERGE [SIG_COL_LOGISTICA_DW].[DIM].[CIUDADES_MOVIMIENTOS_PE_ZONA_G] AS TARGET&#xA;USING (&#xA;&#x9;&#x9;SELECT&#x9;&#x9; DMP.ID_PAIS&#x9;&#x9;&#x9;&#x9;,DMP.ID_CIUDAD&#x9;&#x9;&#x9;,DMP.NOMBRE_CIUDAD&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;,DMP.CLASE_SISTEMA&#x9;&#x9;&#x9;,DMP.ID_REGIONAL&#x9;&#x9;,DMP.NOMBRE_REGIONAL&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;,DMP.FECHA_ACTUALIZACION&#x9;,DMP.NOMBRE_CPL&#x9;&#x9;&#x9;,C.ZONA_GEO_PE&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;, CONCAT(DMP.ID_CIUDAD, '-', C.ZONA_GEO_PE)  AS ID_CIUDAD_ZONA_GEO&#xA;&#x9;&#x9;FROM   [SIG_COL_LOGISTICA_DW].[DIM].[CIUDADES_MOVIMIENTOS_MOVILIZADOS]  AS  DMP WITH(NOLOCK)&#xA;&#x9;&#x9;INNER JOIN  #MOXP_CIUDAD AS C ON DMP.ID_CIUDAD = C.ID_CIUDAD_MOV&#xA;&#x9;&#x9;GROUP BY&#x9; DMP.ID_PAIS&#x9;&#x9;&#x9;&#x9;,DMP.ID_CIUDAD&#x9;&#x9;&#x9;,DMP.NOMBRE_CIUDAD&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;,DMP.CLASE_SISTEMA&#x9;&#x9;&#x9;,DMP.ID_REGIONAL&#x9;&#x9;,DMP.NOMBRE_REGIONAL&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;,DMP.FECHA_ACTUALIZACION&#x9;,DMP.NOMBRE_CPL&#x9;&#x9;&#x9;,C.ZONA_GEO_PE&#xA;) AS SOURCE&#xA;ON TARGET.ID_CIUDAD_ZONA_GEO = SOURCE.ID_CIUDAD_ZONA_GEO&#xA;WHEN MATCHED &#xA;AND ( TARGET.ID_PAIS&#x9;&lt;&gt; SOURCE.ID_PAIS&#x9;&#xA;OR &#x9;  TARGET.ID_CIUDAD&#x9;&lt;&gt; SOURCE.ID_CIUDAD&#xA;OR&#x9;  TARGET.ZONA_GEO_PE &lt;&gt; SOURCE.ZONA_GEO_PE&#x9;&#x9;&#xA;OR &#x9;  TARGET.ID_CIUDAD_ZONA_GEO&#x9;&lt;&gt; SOURCE.ID_CIUDAD_ZONA_GEO&#x9;&#xA;)&#xA;THEN&#xA;UPDATE &#xA;&#x9;SET &#xA;&#x9;&#x9; TARGET.ID_PAIS&#x9;&#x9;&#x9;&#x9;&#x9;= SOURCE.ID_PAIS&#x9;&#x9;&#x9;&#x9;&#x9;&#xA;&#x9;&#x9;,TARGET.ID_CIUDAD&#x9;&#x9;&#x9;&#x9;= SOURCE.ID_CIUDAD&#x9;&#x9;&#x9;&#x9;&#x9;&#xA;&#x9;&#x9;,TARGET.NOMBRE_CIUDAD&#x9;&#x9;&#x9;= SOURCE.NOMBRE_CIUDAD&#x9;&#x9;&#x9;&#x9;&#xA;&#x9;&#x9;,TARGET.CLASE_SISTEMA&#x9;&#x9;&#x9;= SOURCE.CLASE_SISTEMA&#x9;&#x9;&#x9;&#x9;&#xA;&#x9;&#x9;,TARGET.ID_REGIONAL&#x9;&#x9;&#x9;&#x9;= SOURCE.ID_REGIONAL&#x9;&#x9;&#x9;&#x9;&#xA;&#x9;&#x9;,TARGET.NOMBRE_REGIONAL&#x9;&#x9;&#x9;= SOURCE.NOMBRE_REGIONAL&#x9;&#x9;&#x9;&#xA;&#x9;&#x9;,TARGET.FECHA_ACTUALIZACION&#x9;&#x9;= SOURCE.FECHA_ACTUALIZACION&#x9;&#x9;&#xA;&#x9;&#x9;,TARGET.NOMBRE_CPL&#x9;&#x9;&#x9;&#x9;= SOURCE.NOMBRE_CPL&#x9;&#x9;&#x9;&#x9;&#x9;&#xA;&#x9;&#x9;,TARGET.ZONA_GEO_PE&#x9;&#x9;&#x9;&#x9;= SOURCE.ZONA_GEO_PE&#x9;&#x9;&#x9;&#x9;&#xA;&#xA;WHEN NOT MATCHED  THEN&#xA;&#xA;INSERT (&#xA;&#x9; ID_PAIS&#xA;&#x9;,ID_CIUDAD&#xA;&#x9;,NOMBRE_CIUDAD&#xA;&#x9;,CLASE_SISTEMA&#xA;&#x9;,ID_REGIONAL&#xA;&#x9;,NOMBRE_REGIONAL&#xA;&#x9;,FECHA_ACTUALIZACION&#xA;&#x9;,NOMBRE_CPL&#xA;&#x9;,ZONA_GEO_PE&#xA;&#x9;,ID_CIUDAD_ZONA_GEO&#xA;) VALUES (&#xA;SOURCE.ID_PAIS&#x9;&#x9;&#x9;&#xA;,SOURCE.ID_CIUDAD&#x9;&#x9;&#x9;&#xA;,SOURCE.NOMBRE_CIUDAD&#x9;&#x9;&#xA;,SOURCE.CLASE_SISTEMA&#x9;&#x9;&#xA;,SOURCE.ID_REGIONAL&#x9;&#x9;&#xA;,SOURCE.NOMBRE_REGIONAL&#x9;&#xA;,SOURCE.FECHA_ACTUALIZACION&#xA;,SOURCE.NOMBRE_CPL&#x9;&#x9;&#x9;&#xA;,SOURCE.ZONA_GEO_PE&#x9;&#x9;&#xA;,SOURCE.ID_CIUDAD_ZONA_GEO&#x9;&#xA;)&#xA;;&#xA;&#xA;&#xA;DROP TABLE IF EXISTS #MOXP_CIUDAD;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Contenedor de secuencias\MANIFIESTOS"
          DTS:CreationName="STOCK:SEQUENCE"
          DTS:Description="Sequence Container"
          DTS:DTSID="{7AC60505-4BB7-42C4-BD7E-5B8B3A23DFE0}"
          DTS:ExecutableType="STOCK:SEQUENCE"
          DTS:LocaleID="-1"
          DTS:ObjectName="MANIFIESTOS">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:Executables>
            <DTS:Executable
              DTS:refId="Package\Contenedor de secuencias\MANIFIESTOS\ACTUALIZA_ESTA_MANIFI"
              DTS:CreationName="Microsoft.ExecuteSQLTask"
              DTS:Description="Execute SQL Task"
              DTS:DTSID="{EFDE4D7B-6614-4A80-AC05-D48575050C94}"
              DTS:ExecutableType="Microsoft.ExecuteSQLTask"
              DTS:LocaleID="-1"
              DTS:ObjectName="ACTUALIZA_ESTA_MANIFI"
              DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
              DTS:ThreadHint="0">
              <DTS:Variables />
              <DTS:LoggingOptions
                DTS:FilterKind="0" />
              <DTS:ObjectData>
                <SQLTask:SqlTaskData
                  SQLTask:Connection="{A947580C-C7C7-4E60-B63D-7A9EA12E8F3A}"
                  SQLTask:SqlStatementSource="SET NOCOUNT ON ; &#xA;&#xA;WITH CTE&#xA;(&#xA;&#x9;[SE_NUMERO_GUIA],&#xA;&#x9;[DC_ID_PROCESO],&#xA;&#x9;[DC_NUMERO_MOVI],&#xA;&#x9;[DC_CONSECUT_MOVI],&#xA;&#x9;[DC_ESTADO_MOVIMI],&#xA;&#x9;[SE_FECHA_HORA_MOVIMIENTO]&#xA;)&#xA;AS&#xA;(&#xA;SELECT&#xA;&#x9;CIL.[SE_NUMERO_GUIA],&#xA;&#x9;CIL.[DC_ID_PROCESO],&#xA;&#x9;CIL.[DC_NUMERO_MOVI],&#xA;&#x9;CIL.[DC_CONSECUT_MOVI],&#xA;&#x9;CIL.[DC_ESTADO_MOVIMI],&#xA;&#x9;CIL.[SE_FECHA_HORA_MOVIMIENTO]&#xA;FROM [TMP].[OS174_MOXP_DOCU_CILES] CIL WITH (NOLOCK)&#xA;INNER JOIN [TMP].[MOXP_01] MOXP WITH (NOLOCK) &#xA;ON &#xA;&#x9;CIL.[SE_NUMERO_GUIA] = MOXP.SE_NUMERO_GUIA&#xA;AND &#xA;&#x9;CIL.[DC_ID_PROCESO] = MOXP.DC_ID_PROCESO&#xA;AND &#xA;&#x9;CIL.[DC_NUMERO_MOVI] = MOXP.DC_NUMERO_MOVI&#xA;AND &#xA;&#x9;CIL.[DC_CONSECUT_MOVI] = MOXP.DC_CONSECUT_MOVI&#xA;)&#xA;&#xA;UPDATE [TMP].[MOXP_01] &#xA;SET DC_ESTADO_MOVIMI = CTE.DC_ESTADO_MOVIMI &#xA;FROM [TMP].[MOXP_01] M&#xA;INNER JOIN CTE&#xA;ON &#xA;&#x9;M.[SE_NUMERO_GUIA] = CTE.SE_NUMERO_GUIA&#xA;AND &#xA;&#x9;M.[DC_ID_PROCESO] = CTE.DC_ID_PROCESO&#xA;AND &#xA;&#x9;M.[DC_NUMERO_MOVI] = CTE.DC_NUMERO_MOVI&#xA;AND &#xA;&#x9;M.[DC_CONSECUT_MOVI] = CTE.DC_CONSECUT_MOVI&#xA;;&#xA;SET NOCOUNT OFF;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
              </DTS:ObjectData>
            </DTS:Executable>
            <DTS:Executable
              DTS:refId="Package\Contenedor de secuencias\MANIFIESTOS\Obtener y Consolidado de manifiestos guias ciles"
              DTS:CreationName="Microsoft.ExecuteSQLTask"
              DTS:Description="Tarea Ejecutar SQL"
              DTS:DTSID="{424D7FA9-A450-4E4E-9355-EED6CAC2AD44}"
              DTS:ExecutableType="Microsoft.ExecuteSQLTask"
              DTS:LocaleID="-1"
              DTS:ObjectName="Obtener y Consolidado de manifiestos guias ciles"
              DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
              DTS:ThreadHint="0">
              <DTS:Variables />
              <DTS:LoggingOptions
                DTS:FilterKind="0" />
              <DTS:ObjectData>
                <SQLTask:SqlTaskData
                  SQLTask:Connection="{A947580C-C7C7-4E60-B63D-7A9EA12E8F3A}"
                  SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;&#xA;&#xA;/*Se gestiona tabla en la cual se usa unicamente para guardar información del primer cruce de dastos&#xA;&#x9;ya que se presenta la misma consulta para cada cil */&#xA;DROP TABLE IF EXISTS TMP.#MOXP_01_SEGUI_ENV&#xA;GO&#xA;CREATE TABLE TMP.#MOXP_01_SEGUI_ENV (&#xA;&#x9;[NUMERO_GUIA] [numeric](20, 0) NULL,&#xA;&#x9;FECHA_HORA_MOVIMIENTO DATETIME NULL,&#xA;&#x9;[ID_PROCESO] [smallint]  NULL,&#xA;&#x9;[NUMERO_MOVIMI] [char](30)  NULL,&#xA;&#x9;[CONSECUT_MOVIMI] [numeric](7, 0)  NULL,&#xA;)&#xA;GO&#xA;CREATE CLUSTERED INDEX TMP_IDX_MOXP_SEGUI_ENV ON TMP.#MOXP_01_SEGUI_ENV  (ID_PROCESO, NUMERO_MOVIMI, CONSECUT_MOVIMI)&#xA;GO&#xA;&#xA;/*Se sa este codigo para almacenar el cruce de datos de mece_logistico(guias moxp_01) y lo que se tiene en seguimiento envio&#xA;&#x9;con el fin de realizar esta consulta una vez y luego su resultado se cruzara con la info de cada CIL */&#xA;INSERT INTO TMP.#MOXP_01_SEGUI_ENV &#xA;SELECT &#xA;NUMERO_GUIA,  FECHA_HORA_MOVIMIENTO, ID_PROCESO, NUMERO_MOVIMI, CONSECUT_MOVIMI&#xA;&#xA;&#x9;FROM LOG.SEGUIMIENTO_ENVIO SE WITH (NOLOCK)&#xA;&#x9;--INNER JOIN (SELECT TOP 10 * FROM [TMP].[MOXP_01] WITH (NOLOCK) ) AS MOX &#xA;&#x9;INNER JOIN [TMP].[MOXP_01] AS MOX WITH (NOLOCK)&#xA;&#x9;&#x9;ON &#x9;(SE.NUMERO_GUIA = MOX.SE_NUMERO_GUIA)&#xA;&#x9;&#x9;AND  ( SE.ID_PROCESO= MOX.[DC_ID_PROCESO] &#xA;&#x9;&#x9;&#x9;&#x9;AND  SE.NUMERO_MOVIMI = MOX.[DC_NUMERO_MOVI]&#xA;&#x9;&#x9;&#x9;&#x9;AND  SE.CONSECUT_MOVIMI = MOX.[DC_CONSECUT_MOVI] )&#xA;GO&#xA;&#xA;&#xA;/* inserta información para el CIL BARRANQUILLA */&#xA;INSERT INTO [TMP].[OS174_MOXP_DOCU_CILES_CONSOLIDADO]&#xA;SELECT&#xA;&#x9;SE.NUMERO_GUIA&#xA;&#x9;,D.[ID_PROCESO]&#xA;&#x9;,D.[NUMERO_MOVIMI]&#xA;&#x9;,D.[CONSECUT_MOVIMI]&#xA;&#x9;,D.ESTADO_MOVIMI&#xA;&#x9;,SE.FECHA_HORA_MOVIMIENTO     &#xA;FROM [LOG].[DOCUMENTOS_BARR] D WITH (NOLOCK)&#xA;INNER JOIN&#xA;&#x9;TMP.#MOXP_01_SEGUI_ENV AS SE WITH (NOLOCK, INDEX(TMP_IDX_MOXP_SEGUI_ENV))&#xA;ON&#xA;&#x9;D.ID_PROCESO = SE.ID_PROCESO&#xA;AND &#xA;&#x9;D.NUMERO_MOVIMI = SE.NUMERO_MOVIMI&#xA;AND &#xA;&#x9;D.CONSECUT_MOVIMI = SE.CONSECUT_MOVIMI&#xA;GO&#xA;&#xA;/* inserta información para el CIL BOGOTA*/&#xA;INSERT INTO [TMP].[OS174_MOXP_DOCU_CILES_CONSOLIDADO]&#xA;SELECT&#xA;&#x9;SE.NUMERO_GUIA&#xA;&#x9;,D.[ID_PROCESO]&#xA;&#x9;,D.[NUMERO_MOVIMI]&#xA;&#x9;,D.[CONSECUT_MOVIMI]&#xA;&#x9;,D.ESTADO_MOVIMI&#xA;&#x9;,SE.FECHA_HORA_MOVIMIENTO     &#xA;FROM [LOG].[DOCUMENTOS_BOGO] D WITH (NOLOCK)&#xA;INNER JOIN&#xA;&#x9;TMP.#MOXP_01_SEGUI_ENV AS SE WITH (NOLOCK, INDEX(TMP_IDX_MOXP_SEGUI_ENV))&#xA;ON&#xA;&#x9;D.ID_PROCESO = SE.ID_PROCESO&#xA;AND &#xA;&#x9;D.NUMERO_MOVIMI = SE.NUMERO_MOVIMI&#xA;AND &#xA;&#x9;D.CONSECUT_MOVIMI = SE.CONSECUT_MOVIMI&#xA;GO&#xA;&#xA;/* inserta información para el CIL BUCARAMANGA*/&#xA;INSERT INTO [TMP].[OS174_MOXP_DOCU_CILES_CONSOLIDADO]&#xA;SELECT&#xA;&#x9;SE.NUMERO_GUIA&#xA;&#x9;,D.[ID_PROCESO]&#xA;&#x9;,D.[NUMERO_MOVIMI]&#xA;&#x9;,D.[CONSECUT_MOVIMI]&#xA;&#x9;,D.ESTADO_MOVIMI&#xA;&#x9;,SE.FECHA_HORA_MOVIMIENTO     &#xA;FROM [LOG].[DOCUMENTOS_BUCA] D WITH (NOLOCK)&#xA;INNER JOIN&#xA;&#x9;TMP.#MOXP_01_SEGUI_ENV AS SE WITH (NOLOCK, INDEX(TMP_IDX_MOXP_SEGUI_ENV))&#xA;ON&#xA;&#x9;D.ID_PROCESO = SE.ID_PROCESO&#xA;AND &#xA;&#x9;D.NUMERO_MOVIMI = SE.NUMERO_MOVIMI&#xA;AND &#xA;&#x9;D.CONSECUT_MOVIMI = SE.CONSECUT_MOVIMI&#xA;GO&#xA;&#xA;&#xA;/* inserta información para el CIL BUGA */&#xA;INSERT INTO [TMP].[OS174_MOXP_DOCU_CILES_CONSOLIDADO]&#xA;SELECT&#xA;&#x9;SE.NUMERO_GUIA&#xA;&#x9;,D.[ID_PROCESO]&#xA;&#x9;,D.[NUMERO_MOVIMI]&#xA;&#x9;,D.[CONSECUT_MOVIMI]&#xA;&#x9;,D.ESTADO_MOVIMI&#xA;&#x9;,SE.FECHA_HORA_MOVIMIENTO     &#xA;FROM [LOG].[DOCUMENTOS_BUGA] D WITH (NOLOCK)&#xA;INNER JOIN&#xA;&#x9;TMP.#MOXP_01_SEGUI_ENV AS SE WITH (NOLOCK, INDEX(TMP_IDX_MOXP_SEGUI_ENV))&#xA;ON&#xA;&#x9;D.ID_PROCESO = SE.ID_PROCESO&#xA;AND &#xA;&#x9;D.NUMERO_MOVIMI = SE.NUMERO_MOVIMI&#xA;AND &#xA;&#x9;D.CONSECUT_MOVIMI = SE.CONSECUT_MOVIMI&#xA;GO&#xA;&#xA;/* inserta información para el CIL CALI */&#xA;INSERT INTO [TMP].[OS174_MOXP_DOCU_CILES_CONSOLIDADO]&#xA;SELECT&#xA;&#x9;SE.NUMERO_GUIA&#xA;&#x9;,D.[ID_PROCESO]&#xA;&#x9;,D.[NUMERO_MOVIMI]&#xA;&#x9;,D.[CONSECUT_MOVIMI]&#xA;&#x9;,D.ESTADO_MOVIMI&#xA;&#x9;,SE.FECHA_HORA_MOVIMIENTO     &#xA;FROM [LOG].[DOCUMENTOS_CALI] D WITH (NOLOCK)&#xA;INNER JOIN&#xA;&#x9;TMP.#MOXP_01_SEGUI_ENV AS SE WITH (NOLOCK, INDEX(TMP_IDX_MOXP_SEGUI_ENV))&#xA;ON&#xA;&#x9;D.ID_PROCESO = SE.ID_PROCESO&#xA;AND &#xA;&#x9;D.NUMERO_MOVIMI = SE.NUMERO_MOVIMI&#xA;AND &#xA;&#x9;D.CONSECUT_MOVIMI = SE.CONSECUT_MOVIMI&#xA;GO&#xA;&#xA;/* inserta información para el CIL CARTAGENA */&#xA;INSERT INTO [TMP].[OS174_MOXP_DOCU_CILES_CONSOLIDADO]&#xA;SELECT&#xA;&#x9;SE.NUMERO_GUIA&#xA;&#x9;,D.[ID_PROCESO]&#xA;&#x9;,D.[NUMERO_MOVIMI]&#xA;&#x9;,D.[CONSECUT_MOVIMI]&#xA;&#x9;,D.ESTADO_MOVIMI&#xA;&#x9;,SE.FECHA_HORA_MOVIMIENTO     &#xA;FROM [LOG].[DOCUMENTOS_CART] D WITH (NOLOCK)&#xA;INNER JOIN&#xA;&#x9;TMP.#MOXP_01_SEGUI_ENV AS SE WITH (NOLOCK, INDEX(TMP_IDX_MOXP_SEGUI_ENV))&#xA;ON&#xA;&#x9;D.ID_PROCESO = SE.ID_PROCESO&#xA;AND &#xA;&#x9;D.NUMERO_MOVIMI = SE.NUMERO_MOVIMI&#xA;AND &#xA;&#x9;D.CONSECUT_MOVIMI = SE.CONSECUT_MOVIMI&#xA;GO&#xA;&#xA;&#xA;/* inserta información para el CIL COTA */&#xA;INSERT INTO [TMP].[OS174_MOXP_DOCU_CILES_CONSOLIDADO]&#xA;SELECT&#xA;&#x9;SE.NUMERO_GUIA&#xA;&#x9;,D.[ID_PROCESO]&#xA;&#x9;,D.[NUMERO_MOVIMI]&#xA;&#x9;,D.[CONSECUT_MOVIMI]&#xA;&#x9;,D.ESTADO_MOVIMI&#xA;&#x9;,SE.FECHA_HORA_MOVIMIENTO     &#xA;FROM [LOG].[DOCUMENTOS_COTA] D WITH (NOLOCK)&#xA;INNER JOIN&#xA;&#x9;TMP.#MOXP_01_SEGUI_ENV AS SE WITH (NOLOCK, INDEX(TMP_IDX_MOXP_SEGUI_ENV))&#xA;ON&#xA;&#x9;D.ID_PROCESO = SE.ID_PROCESO&#xA;AND &#xA;&#x9;D.NUMERO_MOVIMI = SE.NUMERO_MOVIMI&#xA;AND &#xA;&#x9;D.CONSECUT_MOVIMI = SE.CONSECUT_MOVIMI&#xA;GO&#xA;&#xA;&#xA;/* inserta información para el CIL CUCUTA */&#xA;INSERT INTO [TMP].[OS174_MOXP_DOCU_CILES_CONSOLIDADO]&#xA;SELECT&#xA;&#x9;SE.NUMERO_GUIA&#xA;&#x9;,D.[ID_PROCESO]&#xA;&#x9;,D.[