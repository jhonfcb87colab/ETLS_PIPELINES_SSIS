          <DTS:Executables>
            <DTS:Executable
              DTS:refId="Package\Contenedor de secuencias\Contenedor de secuencias\Actualizar auxiliar_zona_urba"
              DTS:CreationName="Microsoft.ExecuteSQLTask"
              DTS:Description="Execute SQL Task"
              DTS:DTSID="{79352267-EC41-4F7B-A0D5-CA9E5A1E5A7B}"
              DTS:ExecutableType="Microsoft.ExecuteSQLTask"
              DTS:LocaleID="-1"
              DTS:ObjectName="Actualizar auxiliar_zona_urba"
              DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
              DTS:ThreadHint="0">
              <DTS:Variables />
              <DTS:LoggingOptions
                DTS:FilterKind="0" />
              <DTS:ObjectData>
                <SQLTask:SqlTaskData
                  SQLTask:Connection="{A947580C-C7C7-4E60-B63D-7A9EA12E8F3A}"
                  SQLTask:SqlStatementSource="WITH CTE&#xA;(&#xA;CLAVE_DIMENSION,&#xA;ID_AUXILIZAR_ZONA_UR,&#xA;CANTIDAD_AUXILIAR)&#xA;AS(&#xA;SELECT&#xA;&#x9;right( '0000' +  CONVERT(varchar,Z.Id_ciudad),4) +&#xA;&#x9;CONVERT(varchar,ID_TIPO_Zona_urba) +&#xA;&#x9;right( '000' +  CONVERT(varchar,ID_Zona_Urba),3) AS CLAVE_DIMENSION,&#xA;&#xA;&#x9;CASE WHEN (E.ID_EMPLEADO &lt;&gt; '0') THEN &#xA;&#x9;right( '0000' +  CONVERT(varchar,Z.Id_ciudad),4) +&#xA;&#x9;CONVERT(varchar,ID_TIPO_Zona_urba) +&#xA;&#x9;right( '000' +  CONVERT(varchar,ID_Zona_Urba),3) +&#xA;&#x9;CONVERT(varchar,E.ID_EMPLEADO) END &#xA;&#x9;AS ID_AUXILIZAR_ZONA_UR,&#x9;&#xA;&#x9;CASE WHEN AUXILIAR != 'NO DISPONIBLE' THEN 1 ELSE  0 END AS CANTIDAD_AUXILIAR&#xA;FROM SIG_COL_LOGISTICA_DW.DIM.CIUDADES_ZONA_URBA Z WITH (NOLOCK) &#xA;LEFT JOIN SIG_COL_LOGISTICA_DW.DIM.EMPLEADOS E WITH (NOLOCK)&#xA;ON&#xA;&#x9;Z.AUXILIAR = E.NOM_APE_EMPLEADO&#xA;)&#xA;UPDATE [TMP].[MOXP]&#xA;SET CANT_AUXILIAR = ISNULL(CTE.CANTIDAD_AUXILIAR,0),&#xA;ID_AUXILIZAR_ZONA_UR = CTE.ID_AUXILIZAR_ZONA_UR&#xA;FROM [TMP].[MOXP] MP WITH (NOLOCK) &#xA;LEFT JOIN CTE WITH (NOLOCK)&#xA;ON&#xA;MP.ID_CIUDAD_ZONA_URBA = CTE.CLAVE_DIMENSION" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
              </DTS:ObjectData>
            </DTS:Executable>
            <DTS:Executable
