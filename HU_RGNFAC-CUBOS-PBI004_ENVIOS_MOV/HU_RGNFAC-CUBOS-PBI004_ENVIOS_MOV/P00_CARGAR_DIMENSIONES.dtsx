        <DTS:Executable
          DTS:refId="Package\DIMENSIONES FORMATOS IMPRESION\CREAR DIMENSION DIM_FORMATOS_IMPRESION"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Tarea Ejecutar SQL"
          DTS:DTSID="{723ED05D-08E3-46BE-A313-7A8D644D701F}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="CREAR DIMENSION DIM_FORMATOS_IMPRESION"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{C4C160DA-53D2-4E45-A657-889A0E40B781}"
              SQLTask:SqlStatementSource="USE SIG_COLOMBIA_DW;&#xA;DROP TABLE IF EXISTS #FORMATOS_IMPRESION_TESMPORAL_01;&#xA;with CTE as ( &#xA;SELECT &#xA;[ID_TIPOGUIA] AS ID_FORMATO&#xA;,[NOMBRE_TIPOGUIA] AS NOMBRE_FORMATO&#xA;,'Cadena Contado' [CADENA_CANAL]&#xA; FROM  [PAR].[RTW_RETAIL_FORMATOS_IMPRESION_TIPOGUIA] WITH(NOLOCK)&#xA;&#xA; UNION ALL&#xA;SELECT &#xA;&#x9;Id&#x9;AS ID_FORMATO&#xA;&#x9;,NombreFormato AS NOMBRE_FORMATO&#xA;&#x9;,'Cadena Credito' [CADENA_CANAL]&#xA;FROM  [PAR].[SIS_SISCLINET_FORMATOS_IMPRESION] WITH(NOLOCK)&#xA;&#xA;)&#xA;SELECT &#xA;C.ID_FORMATO&#xA;,C.NOMBRE_FORMATO&#xA;,C.CADENA_CANAL&#xA;INTO #FORMATOS_IMPRESION_TESMPORAL_01 &#xA;FROM CTE C&#xA;INNER JOIN [PAR].[FORMATOS_IMPRESION_DISPONIBLES] T WITH(NOLOCK)&#xA;ON C.ID_FORMATO = T.ID_FORMATO AND T.CADENA_CANAL=C.CADENA_CANAL&#xA;ORDER BY 1 ASC&#xA;&#xA;&#xA;&#xA;USE SIG_COL_LOGISTICA_DW;&#xA;TRUNCATE TABLE DIM.FORMATOS_IMPRESION;&#xA;&#xA;INSERT INTO DIM.FORMATOS_IMPRESION &#xA;SELECT &#xA;ID_FORMATO=-888&#x9;&#xA;,NOMBRE_FORMATO='NO DISPONIBLE'&#x9;&#xA;,CADENA_CANAL='NO DISPONIBLE'&#xA;;&#xA;&#xA;&#xA;&#xA;INSERT INTO DIM.FORMATOS_IMPRESION &#xA;SELECT &#xA;ID_FORMATO&#x9;&#xA;,NOMBRE_FORMATO&#x9;&#xA;,CADENA_CANAL&#xA;FROM #FORMATOS_IMPRESION_TESMPORAL_01&#xA;&#xA;&#xA;-----SELECT * FROM DIM.FORMATOS_IMPRESION &#xA;&#xA;&#xA;/*&#xA;SELECT * FROM SIG_COLOMBIA_DW.[PAR].[FORMATOS_IMPRESION_DISPONIBLES]&#xA;&#xA;&#xA;&#xA;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;Cadena Crédito: &#xA;1 = BOND &#xA;2 = STICKER &#xA;3 = TIRILLA  &#xA;4 = ESTANDAR CREDITO &#xA;5 = COMANDO ZPL &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;Cadena Contado: &#xA;41 = BOND &#xA;62 = ESTANDAR CONTADO &#xA;52 = GUIA INTERNACIONAL VIRTUAL BOND&#xA;&#xA;&#xA;-----INSERT INTO SIG_COLOMBIA_DW.[PAR].[FORMATOS_IMPRESION_DISPONIBLES]&#xA;-----SELECT&#xA;-----ID_FORMATO&#x9;= 52&#xA;-----,CADENA_CANAL = 'GUIA INTERNACIONAL VIRTUAL BOND'&#xA;&#xA;----ALTER TABLE [PAR].[FORMATOS_IMPRESION_DISPONIBLES] ALTER COLUMN CADENA_CANAL VARCHAR(14)&#xA;&#xA;*/&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
