                          name="SqlCommand"
                          UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">/*
parametrica tipos de impresion
*/

SELECT        
		Id 
		,CountryId
		,FilialId
		,ReportTypeId
		,DocumentRetailTypeId
		,Url
		,Name
		,Description
		,State
		,Preprinted
		,Event
		,IsDocument
		,PromotionId
		,JointReport
		,MessageRequired
		,ReportPdf
FROM            ReportSetting AS R WITH (NOLOCK)
WHERE        (IsDocument = 1) AND (State = 1)
ORDER BY DocumentRetailTypeId</property>
