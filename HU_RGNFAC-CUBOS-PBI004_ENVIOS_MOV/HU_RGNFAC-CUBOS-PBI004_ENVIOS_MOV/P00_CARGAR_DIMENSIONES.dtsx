                          name="SqlCommand"
                          UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">/*
parametrica tipos de impresion
*/
SELECT        
ID_TIPOGUIA, 
NOMBRE_TIPOGUIA, 
NOMBRE_FORMATO, 
ID_MANEJA_CLIENTE, 
ID_MANEJA_PUNTOSERVICIO, 
ID_MANEJA_DIVISIONES, 
CODIGO_IMPRESION, 
NUMERO_LINEAS_DETALLE_IMPRESION, 
ID_CONTROL_ANTICIPO, 
ID_EST_TIPOGUIA, 
GUIA_STICKER, 
ID_IMPRIME_GUIA, 
ID_MOVIMIENTOS_LOGISTICOS, 
ID_CONFIGURA_REGIONAL, 
ID_PREFACTURA_EZU, 
VISUALIZAR_IMAGEN_INTERNET, 
VISUALIZAR_IMAGEN_INTRANET, 
GENERAR_PIN, 
LOGIN_EMPLEADO, 
FECHA_CREACION, 
FECHA_MODIFICACION, 
msrepl_tran_version, 
ID_MANEJA_AUTORIZACION, 
ID_MANEJA_NUM_VIGENCIA, 
ID_PERMITE_REASIGNACION,
id_prefijo_diferente_ps, 
ID_MANEJA_TARJETA_PREPAGO, 
id_pais, 
ES_TARJETA_PREPAGO, 
ES_GUIA_INTERNA, 
GUIA_OBSOLETA, 
ANUNCIO_IVR
FROM  Parametros.dbo.TIPOGUIA AS R WITH (NOLOCK)
WHERE        (id_pais = 1)</property>
