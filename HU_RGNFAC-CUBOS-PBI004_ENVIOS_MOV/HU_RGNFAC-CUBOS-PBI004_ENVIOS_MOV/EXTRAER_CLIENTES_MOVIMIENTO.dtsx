              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">--------------------------------------------------------------------------------
-- DESARROLLADO POR WALTON HUGO RAMÍREZ                                       --
-- NOVIEMBRE 20 DE 2006                                                       --
-- APLICACION : ENVIOS MOVILIZADOS ( DIMENSION CLIENTE MOVIMIENTO )           --
--------------------------------------------------------------------------------	

SELECT	ISNULL(C.ID_CLIENTE,'0') AS ID_CLIENTE,
		ISNULL(C.NOMBRE_CLIENTE, 'NO DISPONIBLE') AS NOMBRE_CLIENTE,
		ISNULL(C.ID_SECTOR_ECON,0) AS ID_SEC_ECON,
		ISNULL(C.SECTOR_ECON, 'NO DISPONIBLE') AS SECTOR_ECON,
		ISNULL(C.ID_ACTIV_ECON, 0) AS ID_ACTIV_ECON,
		ISNULL(C.ACTIV_ECON, 'NO DISPONIBLE') AS ACTIV_ECON,
		ISNULL(C.ID_CIIU, 0) AS ID_CIIU,
		ISNULL(C.CIIU, 'NO DISPONIBLE') AS CIIU,
		ISNULL(C.RANGO_PERMANENCIA, 'NO DISPONIBLE') AS RANGO_PERMANENCIA,
		C.FECHA_ACTUALIZACION AS FECHA_ACTUALIZACION,
		ISNULL(P.DIVISION,'NO DISPONIBLE') AS DIVISION,
		ISNULL(P.GRUPO,'NO DISPONIBLE') AS GRUPO,
		ISNULL(P.CLASE,'NO DISPONIBLE') AS CLASE,
        ISNULL(P.SECCION,'NO DISPONIBLE') AS SECCION	
		
		
FROM	DIM.CLIENTES_SECTOR AS C WITH(NOLOCK)
		INNER JOIN FAC.ENVIOS_MOVILIZADOS AS F WITH(NOLOCK) ON C.ID_CLIENTE = F.ID_CLIENTE
		INNER JOIN TMP.CLIENTEPOTENCIAL AS P WITH(NOLOCK) ON C.ID_CLIENTE = P.ID_CLIENTE
/*WHERE	C.ID_CLIENTE IN (	SELECT	TOP 1 F.ID_CLIENTE 
							FROM	FAC.ENVIOS_MOVILIZADOS AS F WITH(NOLOCK) 
							WHERE	C.ID_CLIENTE = F.ID_CLIENTE
						)*/
GROUP	BY ISNULL(C.ID_CLIENTE,'0'),
		ISNULL(C.NOMBRE_CLIENTE, 'NO DISPONIBLE'),
		ISNULL(C.ID_SECTOR_ECON,0),
		ISNULL(C.SECTOR_ECON, 'NO DISPONIBLE'),
		ISNULL(C.ID_ACTIV_ECON, 0),
		ISNULL(C.ACTIV_ECON, 'NO DISPONIBLE'),
		ISNULL(C.ID_CIIU, 0),
		ISNULL(C.CIIU, 'NO DISPONIBLE'),
