    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{F840072C-2D47-4487-9955-886E0A769418}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="(DT_DATE) @[$Project::FULL_FACH_FIN] == (DT_DATE) &quot;1900-01-01&quot;?&#xA;(DT_DATE)((DT_WSTR,4)YEAR(DATEADD(&quot;DD&quot;, 1 ,GETDATE()))+&quot;-&quot;+RIGHT(&quot;0&quot;+(DT_WSTR,2)MONTH(DATEADD(&quot;DD&quot;,1,GETDATE())),2)+&quot;-&quot;+RIGHT(&quot;0&quot;+(DT_WSTR,2)DAY(DATEADD(&quot;DD&quot;,1,GETDATE())),2))&#xA;: (DT_DATE) @[$Project::FULL_FACH_FIN]"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="FechaFin">
      <DTS:VariableValue
        DTS:DataType="7">10/23/2026</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{2316D199-B264-4DB6-A24E-954F8FA93DE4}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="(DT_DATE)   @[$Project::FULL_FACH_INI]    == (DT_DATE) &quot;1900-01-01&quot;? &#xA;(DT_DATE)((DT_WSTR,4)YEAR(DATEADD(&quot;DD&quot;, -@[$Project::DiaIni], GETDATE()))+&quot;-&quot;&#xA;+RIGHT(&quot;0&quot;+(DT_WSTR,2)MONTH(DATEADD(&quot;DD&quot;,-@[$Project::DiaIni],GETDATE() )),2)+&quot;-&quot;&#xA;+RIGHT(&quot;0&quot;+(DT_WSTR,2)DAY(DATEADD(&quot;DD&quot;, -@[$Project::DiaIni],GETDATE() )),2))&#xA;: (DT_DATE) @[$Project::FULL_FACH_INI]"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="FechaIni">
      <DTS:VariableValue
        DTS:DataType="7">10/12/2026</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{5641A5AA-1A57-4F62-BC5C-9F7BBDEF261B}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="(DT_WSTR, 10)&#xA;( &#xA;&#x9;(&#xA;&#x9;&#x9;(&#xA;&#x9;&#x9;&#x9;(  YEAR( @[User::FechaFin] )*100 )   &#xA;&#x9;&#x9;&#x9;+&#xA;&#x9;&#x9;&#x9;(  MONTH( @[User::FechaFin] )  )&#xA;&#x9;&#x9;)*100&#xA;&#x9;)+ DAY( @[User::FechaFin] )&#xA;)"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="STR_FechaFin">
      <DTS:VariableValue
        DTS:DataType="8">20261023</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{7D748C64-7039-4CCA-933D-8AE83FD72422}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="(DT_WSTR, 10)&#xA;( &#xA;&#x9;(&#xA;&#x9;&#x9;(&#xA;&#x9;&#x9;&#x9;(  YEAR( @[User::FechaIni]  )*100 )   &#xA;&#x9;&#x9;&#x9;+&#xA;&#x9;&#x9;&#x9;(  MONTH( @[User::FechaIni] )  )&#xA;&#x9;&#x9;)*100&#xA;&#x9;)+ DAY( @[User::FechaIni] )&#xA;)"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="STR_FechaIni">
      <DTS:VariableValue
        DTS:DataType="8">20261012</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{F1BB91BB-861F-453E-96A6-5CB37059299F}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot;&#xA;DECLARE @FEC_INICIAL DATETIME = CONVERT(DATETIME,CONVERT(DATE,CONVERT(DATETIME,  '&quot;+ @[User::STR_FechaIni] +&quot;'   )));&#xA;DECLARE @FEC_FINAL DATETIME = CONVERT(DATETIME,CONVERT(DATE,CONVERT(DATETIME,  '&quot;+ @[User::STR_FechaFin] +&quot;'  )));&#xA;&#xA;SELECT DISTINCT --[FECHA_HORA_MOVIMIENTO],&#xA;&#x9;[NUMERO_GUIA]&#xA;&#x9;--,[ID_PROCESO] &#xA;&#x9;--,[ID_CONCEPTO]&#xA;FROM MECE_LOGISTICO.DBO.SEGUIMIENTO_ENVIO WITH (NOLOCK)&#xA;WHERE FECHA_HORA_MOVIMIENTO &gt;= CONVERT(DATETIME,CONVERT(CHAR(11),@FEC_INICIAL-30)) AND FECHA_HORA_MOVIMIENTO &lt;= CONVERT(DATETIME,CONVERT(CHAR(11),@FEC_FINAL))--'2017-04-01 00:00:00.000'&#xA;&#x9;AND (ID_PROCESO = 9 AND ID_CONCEPTO IN (2,4,7,9))&#xA;&#x9;------AND NUMERO_GUIA = 253725916&#xA;&#xA;&quot;"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="Zquery_01_SEGUMIENTO_ENVIO">
      <DTS:VariableValue
        DTS:DataType="8">
DECLARE @FEC_INICIAL DATETIME = CONVERT(DATETIME,CONVERT(DATE,CONVERT(DATETIME,  '20261012'   )));
DECLARE @FEC_FINAL DATETIME = CONVERT(DATETIME,CONVERT(DATE,CONVERT(DATETIME,  '20261023'  )));

SELECT DISTINCT --[FECHA_HORA_MOVIMIENTO],
	[NUMERO_GUIA]
	--,[ID_PROCESO] 
	--,[ID_CONCEPTO]
FROM MECE_LOGISTICO.DBO.SEGUIMIENTO_ENVIO WITH (NOLOCK)
WHERE FECHA_HORA_MOVIMIENTO &gt;= CONVERT(DATETIME,CONVERT(CHAR(11),@FEC_INICIAL-30)) AND FECHA_HORA_MOVIMIENTO &lt;= CONVERT(DATETIME,CONVERT(CHAR(11),@FEC_FINAL))--'2017-04-01 00:00:00.000'
	AND (ID_PROCESO = 9 AND ID_CONCEPTO IN (2,4,7,9))
	------AND NUMERO_GUIA = 253725916

</DTS:VariableValue>
    </DTS:Variable>
  </DTS:Variables>
