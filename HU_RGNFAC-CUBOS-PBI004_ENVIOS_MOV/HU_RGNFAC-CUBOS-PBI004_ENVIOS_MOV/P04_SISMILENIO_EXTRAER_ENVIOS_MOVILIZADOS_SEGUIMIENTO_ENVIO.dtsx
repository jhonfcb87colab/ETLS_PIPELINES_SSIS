                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">DECLARE @FEC_INICIAL DATETIME = CONVERT(DATETIME,CONVERT(DATE,CONVERT(DATETIME,?)));
DECLARE @FEC_FINAL DATETIME = CONVERT(DATETIME,CONVERT(DATE,CONVERT(DATETIME,?)));

SELECT DISTINCT --[FECHA_HORA_MOVIMIENTO],
	[NUMERO_GUIA]
	--,[ID_PROCESO] 
	--,[ID_CONCEPTO]
FROM MECE_LOGISTICO.DBO.SEGUIMIENTO_ENVIO WITH (NOLOCK)
WHERE FECHA_HORA_MOVIMIENTO BETWEEN  CONVERT(DATETIME,CONVERT(CHAR(11),@FEC_INICIAL-30)) AND  CONVERT(DATETIME,CONVERT(CHAR(11),@FEC_FINAL))--'2017-04-01 00:00:00.000'
	AND (ID_PROCESO = 9 AND ID_CONCEPTO IN (2,4,7,9))
	------AND NUMERO_GUIA = 253725916</property>
