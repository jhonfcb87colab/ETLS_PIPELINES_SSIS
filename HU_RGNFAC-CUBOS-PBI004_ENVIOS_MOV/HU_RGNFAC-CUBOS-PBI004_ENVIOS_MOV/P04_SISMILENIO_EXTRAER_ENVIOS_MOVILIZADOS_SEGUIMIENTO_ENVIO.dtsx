        <SQLTask:SqlTaskData
          SQLTask:Connection="{57E6F15A-0984-4D7E-A335-3C620BDD84C4}"
          SQLTask:SqlStatementSource="--APLICADO PARA TIEMPO OFERTA&#xA;&#xA;/*ACTUALIZA EL CAMPO MARCA_GUIA CON 1 SI LA GUIA NO SE DEBE TENER EN CUENTA*/&#xA;&#xA;UPDATE [SIG_COL_LOGISTICA_DW].[TMP].[ENVIOS_MOV]&#xA;   SET [MARCA_GUIA] = 1&#xA;FROM [SIG_COL_LOGISTICA_DW].[TMP].[SEG_ENVIO_ENVIOS_MOV] SEM WITH (NOLOCK)&#xA; WHERE [ENVIOS_MOV].[NUMERO_GUIA] = SEM.[NUMERO_GUIA]&#xA; --225113&#xA;&#xA;&#xA;/*ACTUALIZA EL CAMPO MARCA_GUIA CON 0 SI LA GUIA SE DEBE TENER EN CUENTA*/&#xA;&#xA;UPDATE [SIG_COL_LOGISTICA_DW].[TMP].[ENVIOS_MOV]&#xA;   SET [MARCA_GUIA] = 0&#xA;WHERE [MARCA_GUIA] IS NULL&#xA;--2401958" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
