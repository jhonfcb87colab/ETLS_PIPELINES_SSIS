      DTS:Expression="(DT_DATE)   @[$Project::datFechaFin]    == (DT_DATE) &quot;1900-01-01&quot;? &#xA; &#xA;(DT_WSTR,25)((DT_WSTR,4)YEAR(DATEADD(&quot;DD&quot;, -1 , GETDATE()))+&quot;-&quot;&#xA;+RIGHT(&quot;0&quot;+(DT_WSTR,2)MONTH(DATEADD(&quot;DD&quot;,-1 ,GETDATE() )),2)+&quot;-&quot;&#xA;+RIGHT(&quot;0&quot;+(DT_WSTR,2)DAY(DATEADD(&quot;DD&quot;, -1, GETDATE() )),2))&#xA;&#xA;: (DT_STR,4,1252)DATEPART( &quot;yyyy&quot; , @[$Project::datFechaFin]  ) + &quot;-&quot;+&#xA;RIGHT(&quot;0&quot; + (DT_STR,4,1252)DATEPART( &quot;mm&quot; , @[$Project::datFechaFin]), 2) +&quot;-&quot;+&#xA;RIGHT(&quot;0&quot; + (DT_STR,4,1252)DATEPART( &quot;dd&quot; , @[$Project::datFechaFin]), 2)"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
