            <SQLTask:SqlTaskData
              SQLTask:Connection="{B8FBD4FD-CC9D-461B-917B-F62532143670}"
              SQLTask:SqlStatementSource="SELECT &#xA;&#x9;CONVERT(INT,CONVERT(NUMERIC,CONVERT(DATETIME,CONVERT(CHAR(11),MIN(S_ID_FECHA_RECOLECCION))))) FechaIni,&#xA;&#x9;CONVERT(INT,CONVERT(NUMERIC,CONVERT(DATETIME,CONVERT(CHAR(11),MAX(S_ID_FECHA_RECOLECCION))))) FechaFin&#xA;FROM &#xA;&#x9;TMP.[GM_SOLICITUDRECOLECCION] WITH(NOLOCK)"
              SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
              <SQLTask:ResultBinding
                SQLTask:ResultName="FechaIni"
                SQLTask:DtsVariableName="User::iFechaIni" />
              <SQLTask:ResultBinding
                SQLTask:ResultName="FechaFin"
                SQLTask:DtsVariableName="User::iFechaFin" />
