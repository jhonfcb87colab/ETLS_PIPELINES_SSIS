            <SQLTask:SqlTaskData
              SQLTask:Connection="{8EFE111D-E370-4228-B20E-35452077C2A0}"
              SQLTask:SqlStatementSource="UPDATE&#xA;&#x9;FAC.GM_RECOLECCION&#xA;SET&#xA;&#x9;ID_GEOGRAFIA = CONVERT(VARCHAR(37),RIGHT( '0000' +  CONVERT(VARCHAR,ID_CIUDAD_ZONA_URBA),4) + CONVERT(VARCHAR,'0') + RIGHT( '000' +  CONVERT(VARCHAR,'0'),3)) &#xA;FROM&#xA;&#x9;FAC.GM_RECOLECCION F WITH (NOLOCK)&#xA;LEFT JOIN&#xA;&#x9;DIM.CIUDADES_ZONA_URBA C WITH (NOLOCK)&#xA;ON&#xA;&#x9;F.ID_GEOGRAFIA = CONVERT(VARCHAR(37),RIGHT( '0000' +  CONVERT(VARCHAR,C.ID_CIUDAD),4) + CONVERT(VARCHAR,C.ID_TIPO_ZONA_URBA) + RIGHT( '000' +  CONVERT(VARCHAR,C.ID_ZONA_URBA),3)) &#xA;WHERE&#xA;&#x9;C.ID_CIUDAD IS NULL&#xA;AND&#xA;&#x9;F.TIME_ID BETWEEN  ? AND ?&#xA;&#xA;&#xA;/* UPDATE&#xA;&#x9;FAC.GM_RECOLECCION&#xA;SET&#xA;&#x9;ID_GEOGRAFIA = CONVERT(VARCHAR(37),RIGHT( '0000' +  CONVERT(VARCHAR,ID_CIUDAD_ZONA_URBA),4) + CONVERT(VARCHAR,'0') + RIGHT( '000' +  CONVERT(VARCHAR,'0'),3)) &#xA;FROM&#xA;&#x9;FAC.GM_RECOLECCION F WITH (NOLOCK)&#xA;LEFT JOIN&#xA;&#x9;DIM.CIUDADES_ZONA_URBA C WITH (NOLOCK)&#xA;ON&#xA;&#x9;F.ID_GEOGRAFIA = CONVERT(VARCHAR(37),RIGHT( '0000' +  CONVERT(VARCHAR,C.ID_CIUDAD),4) + CONVERT(VARCHAR,C.ID_TIPO_ZONA_URBA) + RIGHT( '000' +  CONVERT(VARCHAR,C.ID_ZONA_URBA),3)) &#xA;WHERE&#xA;&#x9;C.ID_CIUDAD IS NULL&#xA;AND&#xA;&#x9;F.TIME_ID IN&#xA;(&#xA;&#xA;&#x9;SELECT DISTINCT&#xA;&#x9;&#x9;CONVERT(INT,CONVERT(NUMERIC,CONVERT(DATETIME,CONVERT(CHAR(11),S_ID_FECHA_RECOLECCION))))&#xA;&#x9;FROM &#xA;&#x9;&#x9;[SERV-DBI01,9971].[SIG_COLOMBIA_DW].[TMP].[GM_SOLICITUDRECOLECCION]  WITH(NOLOCK)&#xA;)*/" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="0"
                SQLTask:DtsVariableName="User::iFechaIni"
                SQLTask:ParameterDirection="Input"
                SQLTask:DataType="3"
