    <DTS:Executable
      DTS:refId="Package\EJECTURAR TRANSFORMACION_gg"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:Disabled="True"
      DTS:DTSID="{C162B7B8-B53C-453E-84CE-3B65F4867E01}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="EJECTURAR TRANSFORMACION_gg"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="1">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{A57B766A-0729-46D2-B10B-3524E70D486D}"
          SQLTask:SqlStatementSource="DECLARE @solucion nvarchar(128)&#xA;DECLARE @proyecto nvarchar(128)&#xA;DECLARE @paquete nvarchar(260)&#xA;DECLARE @fechaInicio datetime&#xA;DECLARE @fechaFin datetime &#xA;DECLARE @sincronico bit = 1&#xA;DECLARE @32Bits bit = 0&#xA;DECLARE @referenciaAmbiente bigint = Null&#xA;&#xA;DECLARE @pFechaInicio datetime&#xA;SELECT @pFechaInicio = CONVERT(DATETIME,CONVERT(VARCHAR,GETDATE()-10,111))&#xA;DECLARE @pFechaFin datetime&#xA;SELECT @pFechaFin = CONVERT(DATETIME,CONVERT(VARCHAR,GETDATE(),111))&#xA;&#xA;SET @solucion = N'DATA MART LOGISTICA'&#xA;SET @proyecto = N'MODELO GREEN MOBILE'&#xA;SET @paquete = N'TRANSFORMACION DISTRIBUCION GM.dtsx'&#xA;SET @fechaInicio = @pFechaInicio&#xA;SET @fechaFin = @pFechaFin&#xA;&#xA;&#xA;  &#x9;Declare @execution_id bigint&#xA;&#x9;Declare @execution_status bigint = 1&#xA;&#xA;&#x9;-- Crea la ejecución y la inicia&#xA;&#x9;EXEC [SSISDB].[catalog].[create_execution] @package_name=@paquete, @execution_id=@execution_id OUTPUT, @folder_name=@solucion, @project_name=@proyecto, @use32bitruntime=@32Bits, @reference_id=@referenciaAmbiente&#xA;&#x9;EXEC [SSISDB].[catalog].[set_execution_parameter_value] @execution_id,  @object_type=20, @parameter_name=N'datFechaInicio', @parameter_value=@fechaInicio&#xA;&#x9;EXEC [SSISDB].[catalog].[set_execution_parameter_value] @execution_id,  @object_type=20, @parameter_name=N'datFechaFin', @parameter_value=@fechaFin&#xA;&#x9;EXEC [SSISDB].[catalog].[set_execution_parameter_value] @execution_id,  @object_type=50, @parameter_name=N'LOGGING_LEVEL', @parameter_value=100&#xA;&#x9;EXEC [SSISDB].[catalog].[set_execution_parameter_value] @execution_id,  @object_type=50, @parameter_name=N'CUSTOMIZED_LOGGING_LEVEL', @parameter_value=N'Errors &amp; Warnings'&#xA;&#xA;&#x9;EXEC [SSISDB].[catalog].[start_execution] @execution_id&#xA;&#xA;&#x9;IF(@sincronico = 1)&#xA;&#x9;BEGIN&#xA;&#x9;&#x9;--Los posibles Valores son: created (1), running (2), canceled (3), failed (4), pending (5), ended unexpectedly (6), succeeded (7), stopping (8), and completed (9)&#xA;&#x9;&#x9;WHILE(@execution_status NOT IN (3,4,6,7,9)) BEGIN &#xA;&#xA;&#x9;&#x9;&#x9;--Actualizar el estado.&#xA;&#x9;&#x9;&#x9;SET @execution_status = (&#xA;&#x9;&#x9;&#x9;SELECT&#xA;&#x9;&#x9;&#x9;[executions].[status]&#xA;&#x9;&#x9;&#x9;FROM&#xA;&#x9;&#x9;&#x9;[SSISDB].[catalog].[executions]&#xA;&#x9;&#x9;&#x9;WHERE&#xA;&#x9;&#x9;&#x9;[executions].[execution_id] = @execution_id&#xA;&#x9;&#x9;&#x9;)&#xA;&#x9;&#x9;END&#xA;&#x9;END&#xA;&#xA;&#x9;IF(@execution_status IN (3,4,6))&#xA;&#x9;BEGIN&#xA;&#x9;&#x9;Declare @mensajeErr as nvarchar(200) = 'Error al ejecutar paquete [' + @solucion + '\'  + @proyecto + '\'   + @paquete + '] el paquete '  + CASE @execution_status WHEN 3 THEN 'FUE CANCELADO' WHEN 4 THEN 'FALLO' WHEN 6 THEN 'TERMINO INESPERADAMENTE' END&#xA;&#x9;&#x9;RAISERROR(@mensajeErr,16,1)&#xA;&#x9;END" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
