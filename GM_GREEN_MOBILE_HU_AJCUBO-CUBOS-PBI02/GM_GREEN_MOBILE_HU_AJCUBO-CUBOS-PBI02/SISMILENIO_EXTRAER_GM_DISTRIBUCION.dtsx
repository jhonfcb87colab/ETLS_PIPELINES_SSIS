            <component
              refId="Package\EXTRAER GM_DISTRIBUCION\OLE DB Source"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
              description="OLE DB Source"
              name="OLE DB Source"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT 
	 CONVERT(INT,CONVERT(NUMERIC,CONVERT(DATETIME,CONVERT(CHAR(11),S_ID_FECHA_DISTRIBUCION)))) AS TIME_ID
	,S_ID_FECHA_DISTRIBUCION FECHA
	,DAY(S_ID_FECHA_DISTRIBUCION) DIA
	,MONTH(S_ID_FECHA_DISTRIBUCION) MES
	,YEAR(S_ID_FECHA_DISTRIBUCION) AÑO
	,CASE WHEN (D_ID_TIPO_ZONA_URBA = -888 OR D_ID_ZONA_URBA = -888) THEN
		CONVERT(VARCHAR(37),'00000000')
	 ELSE
		CONVERT(VARCHAR(37),RIGHT( '0000' +  CONVERT(VARCHAR,D_ID_CIUDAD_ZONA_URBA),4) + CONVERT(VARCHAR,D_ID_TIPO_ZONA_URBA) + RIGHT( '000' +  CONVERT(VARCHAR,D_ID_ZONA_URBA),3)) 
	 END ID_GEOGRAFIA
	,D_ID_CIUDAD_ZONA_URBA ID_CIUDAD_ZONA_URBA
	,CASE WHEN D_ID_TIPO_ZONA_URBA = -888 THEN 0 ELSE D_ID_TIPO_ZONA_URBA END ID_TIPO_ZONA_URBA
	,CASE WHEN D_ID_ZONA_URBA = -888 THEN 0 ELSE D_ID_ZONA_URBA END ID_ZONA_URBA
	,CASE WHEN S_ID_CONCEPTO_SZU = -888 THEN
		CONVERT(VARCHAR(5),'09000')
	 ELSE
		RIGHT('00' + CONVERT(VARCHAR,S_ID_PROCESO_SZU),2)  +RIGHT('00' + CONVERT(VARCHAR,S_ID_CONCEPTO_SZU),3)
	 END ID_PROCESO_CONCEPTO_SZU
	,S_ID_PROCESO_SZU ID_PROCESO_SZU
	,CASE WHEN S_ID_CONCEPTO_SZU = -888 THEN 0 ELSE S_ID_CONCEPTO_SZU END ID_CONCEPTO_SZU
	,CASE S_ID_PROCESO_REP
		WHEN 24 THEN CONVERT(VARCHAR(5),'24000')
		WHEN 25 THEN CONVERT(VARCHAR(5),'25000')
		ELSE  CONVERT(VARCHAR(5),'00000')
	 END ID_PROCESO_CONCEPTO_REP
	,CASE WHEN S_ID_PROCESO_REP = -888 THEN 0 ELSE S_ID_PROCESO_REP END ID_PROCESO_REP
	,0 ID_CONCEPTO_REP
	,S_ID_HORA_REP ID_HORA_REPR
	,CONVERT(TINYINT,CASE WHEN G_ID_TIPO_GUIA = -888 THEN 0 ELSE G_ID_TIPO_GUIA END) ID_TIPO_GUIA
	,CASE WHEN G_ID_CIUDAD_ORIGEN = -888 THEN 0 ELSE G_ID_CIUDAD_ORIGEN END ID_CIUDAD_ORIGEN
	,CASE WHEN G_ID_CIUDAD_DESTINO = -888 THEN 0 ELSE G_ID_CIUDAD_DESTINO END ID_CIUDAD_DESTINO
	,CASE WHEN G_ID_TIEMPO_ENTREGA = -888 THEN 0 ELSE G_ID_TIEMPO_ENTREGA END ID_TIEMPO_ENTREGA
	,CASE WHEN G_ID_PRODUCTO = -888 OR G_ID_SUBPRODUCTO = -888
		THEN CONVERT(VARCHAR(6),'000000')
	 ELSE
		CONVERT(VARCHAR(6),RIGHT('00' + CONVERT(VARCHAR,G_ID_PRODUCTO),2) + RIGHT( '0000' +  CONVERT(VARCHAR, G_ID_SUBPRODUCTO),4))
	 END ID_UEN_PROD_SUBPROD
	,CASE WHEN G_ID_PRODUCTO = -888 THEN 0 ELSE G_ID_PRODUCTO END ID_PRODUCTO
	,CASE WHEN G_ID_SUBPRODUCTO = -888 THEN 0 ELSE G_ID_SUBPRODUCTO END ID_SUBPRODUCTO
	,G_ID_GUIA NUMERO_GUIA
  FROM 
	TMP.GM_DISTRIBUCION WITH(NOLOCK)</property>
