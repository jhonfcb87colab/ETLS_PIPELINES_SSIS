          SQLTask:Connection="{E58636C1-F4AA-4075-B179-A59AF883BD17}"
          SQLTask:SqlStatementSource="DELETE FROM SIG_COL_LOGISTICA_DW.FAC.GM_DISTRIBUCION&#xA;WHERE TIME_ID IN&#xA;(&#xA;&#xA;&#x9;SELECT DISTINCT&#xA;&#x9;&#x9;CONVERT(INT,CONVERT(NUMERIC,CONVERT(DATETIME,CONVERT(CHAR(11),S_ID_FECHA_DISTRIBUCION))))&#xA;&#x9;FROM &#xA;&#x9;&#x9;SIG_COLOMBIA_DW.TMP.GM_DISTRIBUCION WITH(NOLOCK)&#xA;)" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
