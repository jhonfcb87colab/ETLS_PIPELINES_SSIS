                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">DECLARE @FECHA_FINAL DATETIME = CONVERT(DATETIME,?);
DECLARE @FECHA_INCIAL  DATETIME = DATEADD(mm,-3,DATEADD(mm,DATEDIFF(mm,0,@FECHA_FINAL),0)) 

SELECT  TOP 100
[D_ID_PROCESO]
      ,[G_NUMERO_GUIA]
      ,[D_ID_CIUDAD_DIVISION_ORIGEN]
      ,[D_ID_CIUDAD_DESTINO]
      ,[D_ID_CIUDAD_CANAL]
      ,[D_ID_CIUDAD_OPERATIVO]
      ,[D_NUMERO_MOVIMIMIENTO]
      ,[D_CONSECUTIVO_MOVIMIENTO]
      ,[D_ID_TIPO_ZONA_URBANA]
      ,[D_ID_CIUDAD_ZONA_URBANA]
      ,[D_ID_ZONA_URBANA]
      ,[D_ID_DIVISION_ORIGEN]
      ,[D_ID_DIVISION_DESTINO]
      ,[D_ID_OPERATIVO]
      ,[D_ID_CANAL]
      ,[D_ID_OPERADOR_LOGISTICO]
      ,[D_ID_TIPO_LOGISTICA]
      ,[D_ID_TIPO_DOCUMENTO]
      ,[D_FECHA_HORA_MOVIMIENTO]
      ,[D_FECHA_HORA_CIERRE]
      ,[D_PLACA_VEHICULO_DOCUMENTO]
      ,[D_ESTADO_MOVIMIENTO]
      ,[D_ID_TIPO_MOVIMIENTO]
      ,[D_FECHA_CREACION]
      ,[D_ID_FECHA_CREACION]
      ,[S_ID_CONCEPTO]
      ,[S_ID_PROCESO_CONCEPTO]
      ,[S_ID_ESTA_FISICO]
      ,[S_HORA_INICIAL_ENTREGA]
      ,[S_HORA_FINAL_ENTREGA]
      ,[S_ID_EST_EMBALAJE]
      ,[S_DEVOLUCION_REGIONAL]
      ,[S_FECHA_HORA_MOVIMIENTO]
      ,[S_ID_FECHA_HORA_MOVIMIENTO]
      ,[S_FECHA_CREACION]
      ,[S_ID_FECHA_CREACION]
      ,[S_FECHA_MODIFICACION]
      ,[SERVIDOR_ORIGEN]
      ,[FECHA_EXTRACCION]
      ,[G_ID_TIPO_GUIA]
      ,[G_ID_CANAL]
      ,[G_ID_PRODUCTO]
      ,[G_ID_SUBPRODUCTO]
      ,[G_ID_TIEMPO]
      ,[G_ID_MEDTRANS]
      ,[G_ID_CLIENTE]
      ,[G_LOGISTICA_PARA_COBROS]
      ,[G_VALOR_RECAUDAR_PRODUCTO]
      ,[G_NUMERO_CODIGO_EFECTY]
      ,[G_COD]
      ,[G_ID_FORMA_PAGO_GUIA]
      ,[G_ID_FORMA_PAGO_OPER]
      ,[G_ID_FECHA_ENVIO]
      ,[G_FECHA_ENVIO]
      ,[G_ID_MEDIO_TRANSPORTE]
      ,[G_ID_ESTADO_ENVIO]
      ,[G_ID_ESTADO_GUIA]
      ,[G_ID_BODEPROV]
      ,[G_NUMERO_PIEZAS]
      ,[G_PESO_FISICO_GUIA]
      ,[G_PESO_VOLUMETRICO_GUIA]
      ,[G_LARGO_ENVIO]
      ,[G_ANCHO_ENVIO]
      ,[G_ALTO_ENVIO]
      ,[G_CATEGORIA_PRODUCTO]
      ,[G_PRODUCTO]
      ,[G_TIPOENVIO]
      ,[G_UEN]
      ,[G_ID_REGIONAL_ORIGEN]
      ,[G_REGIONAL_ORIGEN]
      ,[G_ID_CIUDAD_ORIGEN]
      ,[G_CIUDAD_ORIGEN]
      ,[G_ID_REGIONAL_DESTINO]
      ,[G_REGIONAL_DESTINO]
      ,[G_ID_CIUDAD_DESTINO]
      ,[G_CIUDAD_DESTINO]
      ,[D_ID_REGIONAL_DIVISION_ORIGEN]
      ,[D_REGIONAL_DIVISION_ORIGEN]
      ,[D_CIUDAD_ORIGEN]
      ,[D_ID_REGIONAL_DESTINO]
      ,[D_REGIONAL_DESTINO]
      ,[D_CIUDAD_DESTINO]
      ,[D_ID_REGIONAL_OPERATIVO]
      ,[D_REGIONAL_OPERATIVO]
      ,[D_CIUDAD_OPERATIVO]
      ,[D_ID_REGIONAL_CANAL]
      ,[D_REGIONAL_CANAL]
      ,[D_CIUDAD_CANAL]
      ,[G_FORMAPAGO]
      ,[G_TIEMPOENTREGA]
      ,[G_MEDIO_TRANSPORTE]
      ,[G_NOMBRE_DIVISION]
      ,[D_ZONA_URBANA]
      ,[H_FECHA_REPORTE]
      ,[H_ID_FECHA_REPORTE]
      ,[D_ID_REPLICADO]
  FROM [SIG_LOGISTICA_DM].[FAC].[HIS_SEGUIMIENTO_ENVIO] SE WITH(NOLOCK)
		WHERE	
			SE.D_ID_PROCESO IN (9,15,24,25)
		--AND
		--	SE.D_ID_CIUDAD_ZONA_URBANA IN (5,10,15,20,40,42,47,50,60,85,90,207,233,288,664)
		AND
			SE.S_FECHA_HORA_MOVIMIENTO &gt;= '2025-09-01' 
		AND 
			SE.S_FECHA_HORA_MOVIMIENTO &lt; DATEADD(DAY,1,@FECHA_FINAL) 
		AND
			SE.H_FECHA_REPORTE &gt;= @FECHA_INCIAL</property>
