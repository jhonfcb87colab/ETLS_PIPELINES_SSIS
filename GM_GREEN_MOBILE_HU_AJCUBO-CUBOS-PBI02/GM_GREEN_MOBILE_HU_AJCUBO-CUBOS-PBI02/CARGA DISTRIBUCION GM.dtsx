            <component
              refId="Package\EXTRAER GM_DISTRIBUCION\OLE DB Source"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
              description="OLE DB Source"
              name="OLE DB Source"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">select 
      F.G_TIME_ID	 
	 ,CONVERT(VARCHAR(37),CASE WHEN ZU.CLAVE_DIMENSION IS NULL THEN CONVERT(VARCHAR,F.D_ID_CIUDAD_ZONA_URBA) + '-'+ CONVERT(VARCHAR,'-888') + '-'+ CONVERT(VARCHAR,'-888') ELSE  F.G_ID_GEOGRAFIA END) G_ID_GEOGRAFIA	  	 
	 ,F.G_ID_PROCESO_CONCEPTO_SZU
	 ,F.G_ID_PROCESO_CONCEPTO_REP	
	 ,F.G_ID_HORA_REPR
	 ,F.G_ID_TIPO_GUIA
	 ,F.G_ID_CIUDAD_ORIGEN 
	 ,F.G_ID_CIUDAD_DESTINO
	 ,F.G_ID_TIEMPO_ENTREGA
	 ,F.G_ID_UEN_PROD_SUBPROD	
	 ,F.G_NUMERO_GUIA
from SIG_LOGISTICA_DM.DIM.CIUDADES_ZONA_URBA ZU WITH (NOLOCK)

RIGHT JOIN
(

SELECT 
	 CONVERT(INT,CONVERT(NUMERIC,CONVERT(DATETIME,CONVERT(CHAR(11),S_ID_FECHA_DISTRIBUCION)))) AS G_TIME_ID	
	,CASE WHEN (D_ID_TIPO_ZONA_URBA = -888 OR D_ID_ZONA_URBA = -888) THEN
		CONVERT(VARCHAR(37),'-888')
	 ELSE
		CONVERT(VARCHAR(37),CONVERT(VARCHAR,D_ID_CIUDAD_ZONA_URBA) + '-'+ CONVERT(VARCHAR,D_ID_TIPO_ZONA_URBA) + '-' +  CONVERT(VARCHAR,D_ID_ZONA_URBA)) 
	 END G_ID_GEOGRAFIA
	,CASE WHEN S_ID_CONCEPTO_SZU = -888 OR S_ID_CONCEPTO_SZU = 0  THEN
		CONVERT(VARCHAR(6),'9--888')
	 ELSE
		CONVERT(VARCHAR,S_ID_PROCESO_SZU)  + '-'+ CONVERT(VARCHAR,S_ID_CONCEPTO_SZU)
	 END G_ID_PROCESO_CONCEPTO_SZU,
	 D_ID_CIUDAD_ZONA_URBA,

	 CASE WHEN (S_ID_PROCESO_REP = -888 ) THEN
		CONVERT(VARCHAR(37),'-888')
	 ELSE
	 CONVERT(VARCHAR,S_ID_PROCESO_REP)  + '-'+ CONVERT(VARCHAR,'-888') END G_ID_PROCESO_CONCEPTO_REP	
	,S_ID_HORA_REP G_ID_HORA_REPR
	,G_ID_TIPO_GUIA
	,CASE WHEN G_ID_CIUDAD_ORIGEN = 0 THEN CONVERT(VARCHAR,'-888') ELSE G_ID_CIUDAD_ORIGEN END G_ID_CIUDAD_ORIGEN
	,CASE WHEN G_ID_CIUDAD_DESTINO = 0 THEN CONVERT(VARCHAR,'-888') ELSE G_ID_CIUDAD_DESTINO END G_ID_CIUDAD_DESTINO
	,G_ID_TIEMPO_ENTREGA
	,CASE WHEN G_ID_PRODUCTO = -888 OR G_ID_SUBPRODUCTO = -888
		THEN CONVERT(VARCHAR(6),'-888')
	 ELSE
		CONVERT(VARCHAR(6),CONVERT(VARCHAR,G_ID_PRODUCTO) + '-' + CONVERT(VARCHAR, G_ID_SUBPRODUCTO))
	 END G_ID_UEN_PROD_SUBPROD	
	,G_ID_GUIA G_NUMERO_GUIA
  FROM 
	TMP.GM_DISTRIBUCION WITH(NOLOCK)
) f

ON
F.G_ID_GEOGRAFIA = ZU.CLAVE_DIMENSION</property>
