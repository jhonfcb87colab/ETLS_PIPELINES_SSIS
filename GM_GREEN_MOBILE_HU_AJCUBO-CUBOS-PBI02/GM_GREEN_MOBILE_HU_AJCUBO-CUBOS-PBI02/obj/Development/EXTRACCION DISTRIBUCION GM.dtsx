    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{3958CFE2-B301-4898-AA3A-3721F34A3932}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot;&#xA;WITH&#xA;&#x9;CTE_01 AS&#xA;&#x9;(&#xA;&#x9;&#x9;SELECT &#xA;&#x9;&#x9;&#x9; G.NUMERO_GUIA&#xA;&#x9;&#x9;&#x9;,G.ID_TIPOGUIA&#xA;&#x9;&#x9;&#x9;,G.ID_CIUDAD_ORIGEN&#xA;&#x9;&#x9;&#x9;,G.ID_CIUDAD_DESTINO&#xA;&#x9;&#x9;&#x9;,G.ID_TIEMPO&#xA;&#x9;&#x9;&#x9;,G.ID_PRODUCTO&#xA;&#x9;&#x9;&#x9;,G.ID_SUBPRODUCTO&#xA;&#x9;&#x9;&#x9;,G.FECHA_EXTRACCION_DW&#xA;&#x9;&#x9;FROM&#x9;&#xA;&#x9;&#x9;&#x9;LOG.GUIAS G WITH (NOLOCK)&#xA;&#x9;&#x9;WHERE&#xA;&#x9;&#x9;&#x9;G.NUMERO_GUIA IN (SELECT SE.NUMERO_GUIA FROM GM.DISTRIBUCION_SEGUIMIENTO_ENVIO SE WITH (NOLOCK))&#xA;&#x9;),&#xA;&#x9;CTE AS&#xA;&#x9;(&#xA;&#x9;&#x9;SELECT &#xA;&#x9;&#x9;&#x9; ROW_NUMBER() OVER(PARTITION BY NUMERO_GUIA ORDER BY FECHA_EXTRACCION_DW DESC) ID&#xA;&#x9;&#x9;&#x9;,NUMERO_GUIA&#xA;&#x9;&#x9;&#x9;,ID_TIPOGUIA&#xA;&#x9;&#x9;&#x9;,ID_CIUDAD_ORIGEN&#xA;&#x9;&#x9;&#x9;,ID_CIUDAD_DESTINO&#xA;&#x9;&#x9;&#x9;,ID_TIEMPO&#xA;&#x9;&#x9;&#x9;,ID_PRODUCTO&#xA;&#x9;&#x9;&#x9;,ID_SUBPRODUCTO&#xA;&#x9;&#x9;FROM&#xA;&#x9;&#x9;&#x9;CTE_01&#xA;&#x9;)&#xA;SELECT &#xA;&#x9; NUMERO_GUIA&#xA;&#x9;,ID_TIPOGUIA&#xA;&#x9;,ID_CIUDAD_ORIGEN&#xA;&#x9;,ID_CIUDAD_DESTINO&#xA;&#x9;,ID_TIEMPO&#xA;&#x9;,ID_PRODUCTO&#xA;&#x9;,ID_SUBPRODUCTO&#xA;FROM&#xA;&#x9;CTE&#xA;WHERE&#xA;&#x9;ID = 1&#xA;&quot;"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="GUIAS_DG">
      <DTS:VariableValue
        DTS:DataType="8">
WITH
	CTE_01 AS
	(
		SELECT 
			 G.NUMERO_GUIA
			,G.ID_TIPOGUIA
			,G.ID_CIUDAD_ORIGEN
			,G.ID_CIUDAD_DESTINO
			,G.ID_TIEMPO
			,G.ID_PRODUCTO
			,G.ID_SUBPRODUCTO
			,G.FECHA_EXTRACCION_DW
		FROM	
			LOG.GUIAS G WITH (NOLOCK)
		WHERE
			G.NUMERO_GUIA IN (SELECT SE.NUMERO_GUIA FROM GM.DISTRIBUCION_SEGUIMIENTO_ENVIO SE WITH (NOLOCK))
	),
	CTE AS
	(
		SELECT 
			 ROW_NUMBER() OVER(PARTITION BY NUMERO_GUIA ORDER BY FECHA_EXTRACCION_DW DESC) ID
			,NUMERO_GUIA
			,ID_TIPOGUIA
			,ID_CIUDAD_ORIGEN
			,ID_CIUDAD_DESTINO
			,ID_TIEMPO
			,ID_PRODUCTO
			,ID_SUBPRODUCTO
		FROM
			CTE_01
	)
SELECT 
	 NUMERO_GUIA
	,ID_TIPOGUIA
	,ID_CIUDAD_ORIGEN
	,ID_CIUDAD_DESTINO
	,ID_TIEMPO
	,ID_PRODUCTO
	,ID_SUBPRODUCTO
FROM
	CTE
WHERE
	ID = 1
</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{94FFE654-1C22-41D9-B2FC-434F5B7B9BCD}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot;&#xA;WITH &#xA;&#x9;CTE_01 AS&#xA;&#x9;(&#xA;&#x9;&#x9;SELECT&#xA;&#x9;&#x9;&#x9; SE.G_NUMERO_GUIA AS NUMERO_GUIA&#xA;&#x9;&#x9;&#x9;,SE.G_ID_TIPO_GUIA AS ID_TIPOGUIA&#xA;&#x9;&#x9;&#x9;,SE.G_ID_CIUDAD_ORIGEN AS ID_CIUDAD_ORIGEN&#xA;&#x9;&#x9;&#x9;,SE.G_ID_CIUDAD_DESTINO AS ID_CIUDAD_DESTINO&#xA;&#x9;&#x9;&#x9;,SE.G_ID_TIEMPO AS ID_TIEMPO&#xA;&#x9;&#x9;&#x9;,SE.G_ID_PRODUCTO AS ID_PRODUCTO&#xA;&#x9;&#x9;&#x9;,SE.G_ID_SUBPRODUCTO AS ID_SUBPRODUCTO&#xA;&#x9;&#x9;&#x9;,SE.S_FECHA_HORA_MOVIMIENTO AS FECHA_HORA_MOVIMIENTO&#xA;&#x9;&#x9;FROM&#x9;&#xA;&#x9;&#x9;&#x9;SIG_LOGISTICA_DM.FAC.HIS_SEGUIMIENTO_ENVIO SE WITH (NOLOCK)&#xA;&#x9;&#x9;WHERE&#x9;&#xA;&#x9;&#x9;&#x9;SE.D_ID_PROCESO IN (9,15,24,25)&#xA;&#x9;&#x9;AND&#xA;&#x9;&#x9;&#x9;SE.D_ID_CIUDAD_ZONA_URBANA IN (&quot;+(DT_WSTR, 50)@[User::CiudadesZona]+&quot;)&#xA;&#x9;&#x9;AND&#xA;&#x9;&#x9;&#x9;SE.S_FECHA_HORA_MOVIMIENTO &gt;= &quot; + &quot;'&quot;+LEFT( (DT_WSTR, 50) @[User::FechaInf] ,19) +&quot;'&quot;  +&quot; &#xA;&#x9;&#x9;AND &#xA;&#x9;&#x9;&#x9;SE.S_FECHA_HORA_MOVIMIENTO &lt; DATEADD(DAY,1,&quot; + &quot;'&quot;+(DT_WSTR,50) @[User::FechaSup] +&quot;'&quot; +&quot;) &#xA;&#x9;&#x9;AND&#xA;&#x9;&#x9;&#x9;SE.H_FECHA_REPORTE &gt;= &quot; + &quot;'&quot;+LEFT( (DT_WSTR, 50) @[User::FechaInf] ,19) +&quot;'&quot;  +&quot; &#xA;&#x9;&#x9;AND &#xA;&#x9;&#x9;&#x9;SE.H_FECHA_REPORTE &lt; DATEADD(DAY,1,&quot; + &quot;'&quot;+(DT_WSTR,50) @[User::FechaSup] +&quot;'&quot; +&quot;) &#xA;&#x9;),&#xA;&#x9;CTE AS&#xA;&#x9;(&#xA;&#x9;&#x9;SELECT&#xA;&#x9;&#x9;&#x9; ROW_NUMBER() OVER(PARTITION BY NUMERO_GUIA ORDER BY FECHA_HORA_MOVIMIENTO DESC) ID&#xA;&#x9;&#x9;&#x9;,NUMERO_GUIA&#xA;&#x9;&#x9;&#x9;,ID_TIPOGUIA&#xA;&#x9;&#x9;&#x9;,ID_CIUDAD_ORIGEN&#xA;&#x9;&#x9;&#x9;,ID_CIUDAD_DESTINO&#xA;&#x9;&#x9;&#x9;,ID_TIEMPO&#xA;&#x9;&#x9;&#x9;,ID_PRODUCTO&#xA;&#x9;&#x9;&#x9;,ID_SUBPRODUCTO&#xA;&#x9;&#x9;FROM&#xA;&#x9;&#x9;&#x9;CTE_01&#xA;&#x9;)&#xA;&#xA;SELECT&#xA;&#x9; NUMERO_GUIA&#xA;&#x9;,ID_TIPOGUIA&#xA;&#x9;,ID_CIUDAD_ORIGEN&#xA;&#x9;,ID_CIUDAD_DESTINO&#xA;&#x9;,ID_TIEMPO&#xA;&#x9;,ID_PRODUCTO&#xA;&#x9;,ID_SUBPRODUCTO&#xA;FROM&#xA;&#x9;CTE&#xA;WHERE&#xA;&#x9;ID = 1&#xA;&quot;"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="GUIAS_HLOG">
      <DTS:VariableValue
        DTS:DataType="8">
WITH 
	CTE_01 AS
	(
		SELECT
			 SE.G_NUMERO_GUIA AS NUMERO_GUIA
			,SE.G_ID_TIPO_GUIA AS ID_TIPOGUIA
			,SE.G_ID_CIUDAD_ORIGEN AS ID_CIUDAD_ORIGEN
			,SE.G_ID_CIUDAD_DESTINO AS ID_CIUDAD_DESTINO
			,SE.G_ID_TIEMPO AS ID_TIEMPO
			,SE.G_ID_PRODUCTO AS ID_PRODUCTO
			,SE.G_ID_SUBPRODUCTO AS ID_SUBPRODUCTO
			,SE.S_FECHA_HORA_MOVIMIENTO AS FECHA_HORA_MOVIMIENTO
		FROM	
			SIG_LOGISTICA_DM.FAC.HIS_SEGUIMIENTO_ENVIO SE WITH (NOLOCK)
		WHERE	
			SE.D_ID_PROCESO IN (9,15,24,25)
		AND
			SE.D_ID_CIUDAD_ZONA_URBANA IN (5,10,15,20,40,42,47,50,60,85,90,207,233,288,664)
		AND
			SE.S_FECHA_HORA_MOVIMIENTO &gt;= '1900-01-01' 
		AND 
			SE.S_FECHA_HORA_MOVIMIENTO &lt; DATEADD(DAY,1,'1900-01-01') 
		AND
			SE.H_FECHA_REPORTE &gt;= '1900-01-01' 
		AND 
			SE.H_FECHA_REPORTE &lt; DATEADD(DAY,1,'1900-01-01') 
	),
	CTE AS
	(
		SELECT
			 ROW_NUMBER() OVER(PARTITION BY NUMERO_GUIA ORDER BY FECHA_HORA_MOVIMIENTO DESC) ID
			,NUMERO_GUIA
			,ID_TIPOGUIA
			,ID_CIUDAD_ORIGEN
			,ID_CIUDAD_DESTINO
			,ID_TIEMPO
			,ID_PRODUCTO
			,ID_SUBPRODUCTO
		FROM
			CTE_01
	)

SELECT
	 NUMERO_GUIA
	,ID_TIPOGUIA
	,ID_CIUDAD_ORIGEN
	,ID_CIUDAD_DESTINO
	,ID_TIEMPO
	,ID_PRODUCTO
	,ID_SUBPRODUCTO
FROM
	CTE
WHERE
	ID = 1
</DTS:VariableValue>
    </DTS:Variable>
