  <DTS:Variables>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{BF4CC266-56DD-49AD-B974-25CF2E93BEA5}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="@[$Project::StrCiudadesGMD]"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="CiudadesZona">
      <DTS:VariableValue
        DTS:DataType="8">5,10,15,20,40,42,47,50,60,85,90,207,233,288,664</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{AE43D075-CB88-408C-9ADE-F55FD3FCC5A5}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot;&#xA;&#x9;WITH CTE_01 AS&#xA;&#x9;(&#xA;&#x9;&#x9;SELECT&#xA;&#x9;&#x9;&#x9; D.ID_PROCESO&#xA;&#x9;&#x9;&#x9;,D.NUMERO_MOVIMI&#xA;&#x9;&#x9;&#x9;,D.CONSECUT_MOVIMI&#xA;&#x9;&#x9;&#x9;,D.ID_TIPO_ZONA_URBA&#xA;&#x9;&#x9;&#x9;,D.ID_CIUDAD_ZONA_URBA&#xA;&#x9;&#x9;&#x9;,D.ID_ZONA_URBA&#xA;&#x9;&#x9;&#x9;,D.FECHA_EXTRACCION_DW&#xA;&#x9;&#x9;FROM&#x9;&#xA;&#x9;&#x9;&#x9;GM.DISTRIBUCION_SEGUIMIENTO_ENVIO SE WITH (NOLOCK)&#xA;&#x9;&#x9;INNER JOIN &#xA;&#x9;&#x9;&#x9;LOG.DOCUMENTOS D WITH (NOLOCK)&#xA;&#x9;&#x9;ON&#xA;&#x9;&#x9;&#x9;SE.ID_PROCESO = D.ID_PROCESO &#xA;&#x9;&#x9;AND &#xA;&#x9;&#x9;&#x9;SE.NUMERO_MOVIMI = D.NUMERO_MOVIMI &#xA;&#x9;&#x9;AND &#xA;&#x9;&#x9;&#x9;SE.CONSECUT_MOVIMI = D.CONSECUT_MOVIMI&#xA;&#x9;),&#xA;&#x9;CTE AS&#xA;&#x9;(&#xA;&#x9;&#x9;SELECT&#xA;&#x9;&#x9;&#x9; ROW_NUMBER() OVER(PARTITION BY ID_PROCESO,NUMERO_MOVIMI,CONSECUT_MOVIMI ORDER BY FECHA_EXTRACCION_DW DESC) ID&#x9;&#x9;&#x9; &#xA;&#x9;&#x9;&#x9;,ID_PROCESO&#xA;&#x9;&#x9;&#x9;,NUMERO_MOVIMI&#xA;&#x9;&#x9;&#x9;,CONSECUT_MOVIMI&#xA;&#x9;&#x9;&#x9;,ID_TIPO_ZONA_URBA&#xA;&#x9;&#x9;&#x9;,ID_CIUDAD_ZONA_URBA&#xA;&#x9;&#x9;&#x9;,ID_ZONA_URBA&#xA;&#x9;&#x9;FROM&#xA;&#x9;&#x9;&#x9;CTE_01&#xA;&#x9;)&#xA;&#xA;SELECT&#xA;&#x9; ID_PROCESO&#xA;&#x9;,NUMERO_MOVIMI&#xA;&#x9;,CONSECUT_MOVIMI&#xA;&#x9;,ID_TIPO_ZONA_URBA&#xA;&#x9;,ID_CIUDAD_ZONA_URBA&#xA;&#x9;,ID_ZONA_URBA&#xA;FROM&#xA;&#x9;CTE&#xA;WHERE&#xA;&#x9;ID = 1&#xA;&quot;"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="DOCUMENTOS_DG">
      <DTS:VariableValue
        DTS:DataType="8">
	WITH CTE_01 AS
	(
		SELECT
			 D.ID_PROCESO
			,D.NUMERO_MOVIMI
			,D.CONSECUT_MOVIMI
			,D.ID_TIPO_ZONA_URBA
			,D.ID_CIUDAD_ZONA_URBA
			,D.ID_ZONA_URBA
			,D.FECHA_EXTRACCION_DW
		FROM	
			GM.DISTRIBUCION_SEGUIMIENTO_ENVIO SE WITH (NOLOCK)
		INNER JOIN 
			LOG.DOCUMENTOS D WITH (NOLOCK)
		ON
			SE.ID_PROCESO = D.ID_PROCESO 
		AND 
			SE.NUMERO_MOVIMI = D.NUMERO_MOVIMI 
		AND 
			SE.CONSECUT_MOVIMI = D.CONSECUT_MOVIMI
	),
	CTE AS
	(
		SELECT
			 ROW_NUMBER() OVER(PARTITION BY ID_PROCESO,NUMERO_MOVIMI,CONSECUT_MOVIMI ORDER BY FECHA_EXTRACCION_DW DESC) ID			 
			,ID_PROCESO
			,NUMERO_MOVIMI
			,CONSECUT_MOVIMI
			,ID_TIPO_ZONA_URBA
			,ID_CIUDAD_ZONA_URBA
			,ID_ZONA_URBA
		FROM
			CTE_01
	)

SELECT
	 ID_PROCESO
	,NUMERO_MOVIMI
	,CONSECUT_MOVIMI
	,ID_TIPO_ZONA_URBA
	,ID_CIUDAD_ZONA_URBA
	,ID_ZONA_URBA
FROM
	CTE
WHERE
	ID = 1
</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{CAD28BC5-759D-4998-9116-903F572DB212}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot; ;WITH CTE_01 AS&#xA;&#x9;(&#xA;&#x9;&#x9;SELECT&#xA;&#x9;&#x9;&#x9; SE.D_ID_PROCESO ID_PROCESO&#xA;&#x9;&#x9;&#x9;,CONVERT(CHAR(30),SE.D_NUMERO_MOVIMIMIENTO) NUMERO_MOVIMI&#xA;&#x9;&#x9;&#x9;,SE.D_CONSECUTIVO_MOVIMIENTO CONSECUT_MOVIMI&#xA;&#x9;&#x9;&#x9;,SE.D_ID_TIPO_ZONA_URBANA ID_TIPO_ZONA_URBA&#xA;&#x9;&#x9;&#x9;,SE.D_ID_CIUDAD_ZONA_URBANA ID_CIUDAD_ZONA_URBA&#xA;&#x9;&#x9;&#x9;,SE.D_ID_ZONA_URBANA ID_ZONA_URBA&#xA;&#x9;&#x9;&#x9;,SE.S_FECHA_HORA_MOVIMIENTO FECHA_HORA_MOVIMIENTO&#xA;&#x9;&#x9;FROM&#x9;&#xA;&#x9;&#x9;&#x9;SIG_LOGISTICA_DM.FAC.HIS_SEGUIMIENTO_ENVIO SE WITH (NOLOCK)&#xA;&#x9;&#x9;WHERE&#x9;&#xA;&#x9;&#x9;&#x9;SE.D_ID_PROCESO IN (9,15,24,25)&#xA;&#x9;&#x9;AND&#xA;&#x9;&#x9;&#x9;SE.D_ID_CIUDAD_ZONA_URBANA IN (&quot;+(DT_WSTR, 50)@[User::CiudadesZona]+&quot;)&#xA;&#x9;&#x9;AND&#xA;&#x9;&#x9;&#x9;SE.S_FECHA_HORA_MOVIMIENTO &gt;= &quot; + &quot;'&quot;+LEFT( (DT_WSTR, 50) @[User::FechaInf] ,19) +&quot;'&quot;  +&quot; &#xA;&#x9;&#x9;AND &#xA;&#x9;&#x9;&#x9;SE.S_FECHA_HORA_MOVIMIENTO &lt; DATEADD(DAY,1,&quot; + &quot;'&quot;+(DT_WSTR,50) @[User::FechaSup] +&quot;'&quot; +&quot;) &#xA;&#x9;&#x9;AND&#xA;&#x9;&#x9;&#x9;SE.H_FECHA_REPORTE &gt;= &quot; + &quot;'&quot;+LEFT( (DT_WSTR, 50) @[User::FechaInf] ,19) +&quot;'&quot;  +&quot; &#xA;&#x9;&#x9;AND &#xA;&#x9;&#x9;&#x9;SE.H_FECHA_REPORTE &lt; DATEADD(DAY,1,&quot; + &quot;'&quot;+(DT_WSTR,50) @[User::FechaSup] +&quot;'&quot; +&quot;) &#xA;---- OPTION(RECOMPILE)&#xA;&#x9;),&#xA;&#x9;CTE AS&#xA;&#x9;(&#xA;&#x9;&#x9;SELECT&#xA;&#x9;&#x9;&#x9; ROW_NUMBER() OVER(PARTITION BY ID_PROCESO,NUMERO_MOVIMI,CONSECUT_MOVIMI ORDER BY FECHA_HORA_MOVIMIENTO DESC) ID&#xA;&#x9;&#x9;&#x9;,ID_PROCESO&#xA;&#x9;&#x9;&#x9;,NUMERO_MOVIMI&#xA;&#x9;&#x9;&#x9;,CONSECUT_MOVIMI&#xA;&#x9;&#x9;&#x9;,ID_TIPO_ZONA_URBA&#xA;&#x9;&#x9;&#x9;,ID_CIUDAD_ZONA_URBA&#xA;&#x9;&#x9;&#x9;,ID_ZONA_URBA&#xA;&#x9;&#x9;FROM&#xA;&#x9;&#x9;&#x9;CTE_01&#xA;&#x9;)&#xA;SELECT&#xA;&#x9; ID_PROCESO&#xA;&#x9;,NUMERO_MOVIMI&#xA;&#x9;,CONSECUT_MOVIMI&#xA;&#x9;,ID_TIPO_ZONA_URBA&#xA;&#x9;,ID_CIUDAD_ZONA_URBA&#xA;&#x9;,ID_ZONA_URBA&#xA;FROM&#xA;&#x9;CTE&#xA;WHERE&#xA;&#x9;ID = 1&#xA;&quot;"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="DOCUMENTOS_HLOG">
      <DTS:VariableValue
        DTS:DataType="8"> ;WITH CTE_01 AS
	(
		SELECT
			 SE.D_ID_PROCESO ID_PROCESO
			,CONVERT(CHAR(30),SE.D_NUMERO_MOVIMIMIENTO) NUMERO_MOVIMI
			,SE.D_CONSECUTIVO_MOVIMIENTO CONSECUT_MOVIMI
			,SE.D_ID_TIPO_ZONA_URBANA ID_TIPO_ZONA_URBA
			,SE.D_ID_CIUDAD_ZONA_URBANA ID_CIUDAD_ZONA_URBA
			,SE.D_ID_ZONA_URBANA ID_ZONA_URBA
			,SE.S_FECHA_HORA_MOVIMIENTO FECHA_HORA_MOVIMIENTO
		FROM	
			SIG_LOGISTICA_DM.FAC.HIS_SEGUIMIENTO_ENVIO SE WITH (NOLOCK)
		WHERE	
			SE.D_ID_PROCESO IN (9,15,24,25)
		AND
			SE.D_ID_CIUDAD_ZONA_URBANA IN (5,10,15,20,40,42,47,50,60,85,90,207,233,288,664)
		AND
			SE.S_FECHA_HORA_MOVIMIENTO &gt;= '1900-01-01' 
		AND 
			SE.S_FECHA_HORA_MOVIMIENTO &lt; DATEADD(DAY,1,'1900-01-01') 
		AND
			SE.H_FECHA_REPORTE &gt;= '1900-01-01' 
		AND 
			SE.H_FECHA_REPORTE &lt; DATEADD(DAY,1,'1900-01-01') 
---- OPTION(RECOMPILE)
	),
	CTE AS
	(
		SELECT
			 ROW_NUMBER() OVER(PARTITION BY ID_PROCESO,NUMERO_MOVIMI,CONSECUT_MOVIMI ORDER BY FECHA_HORA_MOVIMIENTO DESC) ID
			,ID_PROCESO
			,NUMERO_MOVIMI
			,CONSECUT_MOVIMI
			,ID_TIPO_ZONA_URBA
			,ID_CIUDAD_ZONA_URBA
			,ID_ZONA_URBA
		FROM
			CTE_01
	)
SELECT
	 ID_PROCESO
	,NUMERO_MOVIMI
	,CONSECUT_MOVIMI
	,ID_TIPO_ZONA_URBA
	,ID_CIUDAD_ZONA_URBA
	,ID_ZONA_URBA
FROM
	CTE
WHERE
	ID = 1
</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{80F52515-CC45-4E3B-B31E-D9AA76B5CDB3}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot;  ;WITH CTE_01 AS&#xA;&#x9;(&#xA;&#x9;&#x9;SELECT&#xA;&#x9;&#x9;&#x9; SE.D_ID_PROCESO ID_PROCESO&#xA;&#x9;&#x9;&#x9;,CONVERT(CHAR(30),SE.D_NUMERO_MOVIMIMIENTO) NUMERO_MOVIMI&#xA;&#x9;&#x9;&#x9;,SE.D_CONSECUTIVO_MOVIMIENTO CONSECUT_MOVIMI&#xA;&#x9;&#x9;&#x9;,SE.D_ID_TIPO_ZONA_URBANA ID_TIPO_ZONA_URBA&#xA;&#x9;&#x9;&#x9;,SE.D_ID_CIUDAD_ZONA_URBANA ID_CIUDAD_ZONA_URBA&#xA;&#x9;&#x9;&#x9;,SE.D_ID_ZONA_URBANA ID_ZONA_URBA&#xA;&#x9;&#x9;&#x9;,S_FECHA_HORA_MOVIMIENTO FECHA_HORA_MOVIMIENTO&#xA;&#x9;&#x9;FROM&#x9;&#xA;&#x9;&#x9;&#x9;SIG_LOGISTICA_DM.FAC.SEGUIMIENTO_ENVIO SE WITH (NOLOCK)&#xA;&#x9;&#x9;WHERE&#x9;&#xA;&#x9;&#x9;&#x9;SE.D_ID_PROCESO IN (9,15,24,25)&#xA;&#x9;&#x9;AND&#xA;&#x9;&#x9;&#x9;SE.D_ID_CIUDAD_ZONA_URBANA IN (&quot;+(DT_WSTR, 50)@[User::CiudadesZona]+&quot;)&#xA;&#x9;&#x9;AND&#xA;&#x9;&#x9;&#x9;SE.FLAG = (SELECT MAX(FLAG) FROM SIG_LOGISTICA_DM.DBO.SEGUIMIENTO_ENVIO_FLAG)&#xA;&#x9;&#x9;AND&#xA;&#x9;&#x9;&#x9;SE.S_FECHA_HORA_MOVIMIENTO &gt;= &quot; + &quot;'&quot;+LEFT( (DT_WSTR, 50) @[User::FechaInf] ,19) +&quot;'&quot;  +&quot; &#xA;&#x9;&#x9;AND &#xA;&#x9;&#x9;&#x9;SE.S_FECHA_HORA_MOVIMIENTO &lt; DATEADD(DAY,1,&quot; + &quot;'&quot;+(DT_WSTR,50) @[User::FechaSup] +&quot;'&quot; +&quot;)&#xA;---- OPTION(RECOMPILE)&#xA;&#x9;),&#xA;&#x9;CTE AS&#xA;&#x9;(&#xA;&#x9;&#x9;SELECT&#xA;&#x9;&#x9;&#x9; ROW_NUMBER() OVER(PARTITION BY ID_PROCESO,NUMERO_MOVIMI,CONSECUT_MOVIMI ORDER BY FECHA_HORA_MOVIMIENTO DESC) ID&#xA;&#x9;&#x9;&#x9;,ID_PROCESO&#xA;&#x9;&#x9;&#x9;,NUMERO_MOVIMI&#xA;&#x9;&#x9;&#x9;,CONSECUT_MOVIMI&#xA;&#x9;&#x9;&#x9;,ID_TIPO_ZONA_URBA&#xA;&#x9;&#x9;&#x9;,ID_CIUDAD_ZONA_URBA&#xA;&#x9;&#x9;&#x9;,ID_ZONA_URBA&#xA;&#x9;&#x9;FROM&#xA;&#x9;&#x9;&#x9;CTE_01&#xA;&#x9;)&#xA;SELECT&#xA;&#x9; ID_PROCESO&#xA;&#x9;,NUMERO_MOVIMI&#xA;&#x9;,CONSECUT_MOVIMI&#xA;&#x9;,ID_TIPO_ZONA_URBA&#xA;&#x9;,ID_CIUDAD_ZONA_URBA&#xA;&#x9;,ID_ZONA_URBA&#xA;FROM&#xA;&#x9;CTE&#xA;WHERE&#xA;&#x9;ID = 1&#xA;&quot;"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="DOCUMENTOS_LOG">
      <DTS:VariableValue
        DTS:DataType="8">  ;WITH CTE_01 AS
	(
		SELECT
			 SE.D_ID_PROCESO ID_PROCESO
			,CONVERT(CHAR(30),SE.D_NUMERO_MOVIMIMIENTO) NUMERO_MOVIMI
			,SE.D_CONSECUTIVO_MOVIMIENTO CONSECUT_MOVIMI
			,SE.D_ID_TIPO_ZONA_URBANA ID_TIPO_ZONA_URBA
			,SE.D_ID_CIUDAD_ZONA_URBANA ID_CIUDAD_ZONA_URBA
			,SE.D_ID_ZONA_URBANA ID_ZONA_URBA
			,S_FECHA_HORA_MOVIMIENTO FECHA_HORA_MOVIMIENTO
		FROM	
			SIG_LOGISTICA_DM.FAC.SEGUIMIENTO_ENVIO SE WITH (NOLOCK)
		WHERE	
			SE.D_ID_PROCESO IN (9,15,24,25)
		AND
			SE.D_ID_CIUDAD_ZONA_URBANA IN (5,10,15,20,40,42,47,50,60,85,90,207,233,288,664)
		AND
			SE.FLAG = (SELECT MAX(FLAG) FROM SIG_LOGISTICA_DM.DBO.SEGUIMIENTO_ENVIO_FLAG)
		AND
			SE.S_FECHA_HORA_MOVIMIENTO &gt;= '1900-01-01' 
		AND 
			SE.S_FECHA_HORA_MOVIMIENTO &lt; DATEADD(DAY,1,'1900-01-01')
---- OPTION(RECOMPILE)
	),
	CTE AS
	(
		SELECT
			 ROW_NUMBER() OVER(PARTITION BY ID_PROCESO,NUMERO_MOVIMI,CONSECUT_MOVIMI ORDER BY FECHA_HORA_MOVIMIENTO DESC) ID
			,ID_PROCESO
			,NUMERO_MOVIMI
			,CONSECUT_MOVIMI
			,ID_TIPO_ZONA_URBA
			,ID_CIUDAD_ZONA_URBA
			,ID_ZONA_URBA
		FROM
			CTE_01
	)
SELECT
	 ID_PROCESO
	,NUMERO_MOVIMI
	,CONSECUT_MOVIMI
	,ID_TIPO_ZONA_URBA
	,ID_CIUDAD_ZONA_URBA
	,ID_ZONA_URBA
FROM
	CTE
WHERE
	ID = 1
</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
