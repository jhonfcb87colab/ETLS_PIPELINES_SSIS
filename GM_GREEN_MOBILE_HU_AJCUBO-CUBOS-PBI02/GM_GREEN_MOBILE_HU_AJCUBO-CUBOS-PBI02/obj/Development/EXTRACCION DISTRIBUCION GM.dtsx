    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{44EC7520-96B0-4522-A7C4-18A834C2E278}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="@[$Package::PFechaFin]"
      DTS:IncludeInDebugDump="2345"
