                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT DISTINCT
	 G.NUMERO_GUIA
	,G.ID_TIPOGUIA
	,G.ID_CIUDAD_ORIGEN
	,G.ID_CIUDAD_DESTINO
	,G.ID_TIEMPO
	,G.ID_PRODUCTO
	,G.ID_SUBPRODUCTO
FROM	
	SEGUIMIENTO_ENVIO SE WITH (NOLOCK)
INNER JOIN 
	DOCUMENTOS D WITH (NOLOCK)
ON
	SE.ID_PROCESO = D.ID_PROCESO 
AND 
	SE.NUMERO_MOVIMI = D.NUMERO_MOVIMI 
AND 
	SE.CONSECUT_MOVIMI = D.CONSECUT_MOVIMI
INNER JOIN
	GUIAS G WITH (NOLOCK)
ON
	SE.NUMERO_GUIA = G.NUMERO_GUIA
WHERE	
	D.ID_PROCESO IN (9,15,24,25)
AND
	D.ID_CIUDAD_ZONA_URBA IN (5,10,15,20,40,50,60,288,259)
AND
	SE.FECHA_HORA_MOVIMIENTO &gt;= ?
AND 
	SE.FECHA_HORA_MOVIMIENTO &lt; DATEADD(DAY,1,?)</property>
                    <property
                      dataType="System.String"
