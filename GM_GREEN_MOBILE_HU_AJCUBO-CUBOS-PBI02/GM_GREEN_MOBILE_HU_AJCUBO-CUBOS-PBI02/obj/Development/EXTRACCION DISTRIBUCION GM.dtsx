    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{25FE9A39-8BF6-4EE5-BECE-20F34F44C6C4}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot;  ;WITH &#xA;&#x9;CTE_01 AS&#xA;&#x9;(&#xA;&#x9;&#x9;SELECT &#xA;&#x9;&#x9;&#x9; SE.ID_PROCESO&#xA;&#x9;&#x9;&#x9;,SE.NUMERO_MOVIMI&#xA;&#x9;&#x9;&#x9;,SE.CONSECUT_MOVIMI&#xA;&#x9;&#x9;&#x9;,SE.NUMERO_GUIA&#xA;&#x9;&#x9;&#x9;,SE.ID_CONCEPTO&#xA;&#x9;&#x9;&#x9;,SE.FECHA_HORA_MOVIMIENTO&#xA;&#x9;&#x9;FROM&#x9;&#xA;&#x9;&#x9;&#x9;LOG.SEGUIMIENTO_ENVIO SE WITH (NOLOCK)&#xA;&#x9;&#x9;INNER JOIN &#xA;&#x9;&#x9;&#x9;LOG.DOCUMENTOS D WITH (NOLOCK)&#xA;&#x9;&#x9;ON&#xA;&#x9;&#x9;&#x9;SE.ID_PROCESO = D.ID_PROCESO &#xA;&#x9;&#x9;AND &#xA;&#x9;&#x9;&#x9;SE.NUMERO_MOVIMI = D.NUMERO_MOVIMI &#xA;&#x9;&#x9;AND &#xA;&#x9;&#x9;&#x9;SE.CONSECUT_MOVIMI = D.CONSECUT_MOVIMI&#xA;&#x9;&#x9;WHERE&#x9;&#xA;&#x9;&#x9;&#x9;D.ID_PROCESO IN (9,15,24,25)&#xA;&#x9;&#x9;AND&#xA;&#x9;&#x9;&#x9;D.ID_CIUDAD_ZONA_URBA IN (&quot;+(DT_WSTR, 50)@[User::CiudadesZona]+&quot;)&#xA;&#x9;&#x9;AND&#xA;&#x9;&#x9;&#x9;SE.FECHA_HORA_MOVIMIENTO &gt;= &quot; + &quot;'&quot;+LEFT( (DT_WSTR, 50) @[User::FechaInf] ,19) +&quot;'&quot;  +&quot; &#xA;&#x9;&#x9;AND &#xA;&#x9;&#x9;&#x9;SE.FECHA_HORA_MOVIMIENTO &lt; DATEADD(DAY,1,&quot; + &quot;'&quot;+(DT_WSTR,50) @[User::FechaSup] +&quot;'&quot; +&quot;) &#xA;---- OPTION(RECOMPILE)  &#xA;&#x9;),&#xA;&#x9;CTE AS&#xA;&#x9;(&#xA;&#x9;&#x9;SELECT&#x9;&#xA;&#x9;&#x9;&#x9; ROW_NUMBER() OVER(PARTITION BY CTE_01.ID_PROCESO, CTE_01.NUMERO_MOVIMI, CTE_01.CONSECUT_MOVIMI, CTE_01.NUMERO_GUIA ORDER BY CTE_01.FECHA_HORA_MOVIMIENTO DESC) ID&#xA;&#x9;&#x9;&#x9;,ID_PROCESO&#xA;&#x9;&#x9;&#x9;,NUMERO_MOVIMI&#xA;&#x9;&#x9;&#x9;,CONSECUT_MOVIMI&#xA;&#x9;&#x9;&#x9;,NUMERO_GUIA&#xA;&#x9;&#x9;&#x9;,ID_CONCEPTO&#xA;&#x9;&#x9;&#x9;,FECHA_HORA_MOVIMIENTO&#xA;&#x9;&#x9;FROM&#xA;&#x9;&#x9;&#x9;CTE_01&#xA;&#x9;)&#xA;&#xA;SELECT&#x9;&#xA;&#x9; ID_PROCESO&#xA;&#x9;,NUMERO_MOVIMI&#xA;&#x9;,CONSECUT_MOVIMI&#xA;&#x9;,NUMERO_GUIA&#xA;&#x9;,ID_CONCEPTO&#xA;&#x9;,FECHA_HORA_MOVIMIENTO&#xA;FROM&#xA;&#x9;CTE&#xA;WHERE&#xA;&#x9;ID = 1&#xA;&quot;"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="S_ENVIOS_DG">
      <DTS:VariableValue
        DTS:DataType="8">  ;WITH 
	CTE_01 AS
	(
		SELECT 
			 SE.ID_PROCESO
			,SE.NUMERO_MOVIMI
			,SE.CONSECUT_MOVIMI
			,SE.NUMERO_GUIA
			,SE.ID_CONCEPTO
			,SE.FECHA_HORA_MOVIMIENTO
		FROM	
			LOG.SEGUIMIENTO_ENVIO SE WITH (NOLOCK)
		INNER JOIN 
			LOG.DOCUMENTOS D WITH (NOLOCK)
		ON
			SE.ID_PROCESO = D.ID_PROCESO 
		AND 
			SE.NUMERO_MOVIMI = D.NUMERO_MOVIMI 
		AND 
			SE.CONSECUT_MOVIMI = D.CONSECUT_MOVIMI
		WHERE	
			D.ID_PROCESO IN (9,15,24,25)
		AND
			D.ID_CIUDAD_ZONA_URBA IN (5,10,15,20,40,42,47,50,60,85,90,207,233,288,664)
		AND
			SE.FECHA_HORA_MOVIMIENTO &gt;= '1900-01-01' 
		AND 
			SE.FECHA_HORA_MOVIMIENTO &lt; DATEADD(DAY,1,'1900-01-01') 
---- OPTION(RECOMPILE)  
	),
	CTE AS
	(
		SELECT	
			 ROW_NUMBER() OVER(PARTITION BY CTE_01.ID_PROCESO, CTE_01.NUMERO_MOVIMI, CTE_01.CONSECUT_MOVIMI, CTE_01.NUMERO_GUIA ORDER BY CTE_01.FECHA_HORA_MOVIMIENTO DESC) ID
			,ID_PROCESO
			,NUMERO_MOVIMI
			,CONSECUT_MOVIMI
			,NUMERO_GUIA
			,ID_CONCEPTO
			,FECHA_HORA_MOVIMIENTO
		FROM
			CTE_01
	)

SELECT	
	 ID_PROCESO
	,NUMERO_MOVIMI
	,CONSECUT_MOVIMI
	,NUMERO_GUIA
	,ID_CONCEPTO
	,FECHA_HORA_MOVIMIENTO
FROM
	CTE
WHERE
	ID = 1
</DTS:VariableValue>
