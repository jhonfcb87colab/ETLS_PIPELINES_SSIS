                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT 
      F.S_TIME_ID	 
	 ,CONVERT(VARCHAR(37),CASE WHEN ZU.CLAVE_DIMENSION IS NULL THEN CONVERT(VARCHAR,F.S_ID_CIUDAD_ZONA_URBA) + '-'+ CONVERT(VARCHAR,'-888') + '-'+ CONVERT(VARCHAR,'-888') ELSE  F.S_ID_GEOGRAFIA END) S_ID_GEOGRAFIA	  	 
	 ,F.S_ID_TIEMPO_ENTREGA
	 ,F.S_ID_UEN_PROD_SUBPROD
	 ,F.S_ID_MOTIVO_RECHAZO
	 ,F.ID_TIPO_SOLICITUD
	 ,F.ID_CONFIRM_SOLICITUD
	 ,F.S_ID_CLIENTE  	
	 ,F.S_NUMERO_SOLICITUD 
	 ,F.GM_MARCA
from SIG_LOGISTICA_DM.DIM.CIUDADES_ZONA_URBA ZU WITH (NOLOCK)

RIGHT JOIN
(
SELECT 
	 CONVERT(INT,CONVERT(NUMERIC,CONVERT(DATETIME,CONVERT(CHAR(11),S_ID_FECHA_RECOLECCION)))) AS S_TIME_ID
	,CASE WHEN (S_ID_TIPO_ZONA_URBA = -888 OR S_ID_ZONA_URBA = -888) THEN
		CONVERT(VARCHAR(37),'-888')
	 ELSE
		CONVERT(VARCHAR(37),CONVERT(VARCHAR,S_ID_CIUDAD_ZONA_URBA) + '-'+ CONVERT(VARCHAR,S_ID_TIPO_ZONA_URBA) + '-' +  CONVERT(VARCHAR,S_ID_ZONA_URBA)) 
	 END S_ID_GEOGRAFIA
	 ,S_ID_CIUDAD_ZONA_URBA
	 ,S_ID_TIEMPO_ENTREGAR S_ID_TIEMPO_ENTREGA
	 ,CASE WHEN S_ID_PRODUCTO = -888 OR S_ID_SUBPRODUCTO = -888
		THEN CONVERT(VARCHAR(6),'-888')
	 ELSE
		CONVERT(VARCHAR(6),CONVERT(VARCHAR,S_ID_PRODUCTO) + '-' + CONVERT(VARCHAR, S_ID_SUBPRODUCTO))
	 END S_ID_UEN_PROD_SUBPROD
	,CONVERT(INT,S_ID_MOTIVO_RECHAZO) S_ID_MOTIVO_RECHAZO	
	,S_ID_TIPO_SOLICITUD ID_TIPO_SOLICITUD
	,S_ID_CONFIRM_SOLICITUD ID_CONFIRM_SOLICITUD
	,CASE WHEN S_ID_CLIENTE = ' ' THEN '-888' ELSE S_ID_CLIENTE END S_ID_CLIENTE  	
	,S_NUMERO_SOLICITUD
	,GM_MARCA 
FROM 
	TMP.GM_SOLICITUDRECOLECCION WITH (NOLOCK)
) f

ON
F.S_ID_GEOGRAFIA = ZU.CLAVE_DIMENSION</property>
                <property
