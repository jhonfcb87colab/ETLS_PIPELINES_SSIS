                <component
                  refId="Package\BUCLE DIA DE DISTRIBUCION\EXTRAER SZU\OLE DB Source"
                  componentClassID="Microsoft.OLEDBSource"
                  contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                  description="OLE DB Source"
                  name="OLE DB Source"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">WITH CTE_SE
(
 	 ID	
	,ID_PROCESO
	,NUMERO_MOVIMI
	,CONSECUT_MOVIMI
	,NUMERO_GUIA
	,ID_CONCEPTO
	,FECHA_DISTRIBUCION
)
AS
(
	SELECT
		 ROW_NUMBER() OVER(PARTITION BY SE.NUMERO_GUIA ORDER BY SE.FECHA_HORA_MOVIMIENTO ASC) AS ID
		,SE.ID_PROCESO
		,SE.NUMERO_MOVIMI
		,SE.CONSECUT_MOVIMI
		,SE.NUMERO_GUIA
		,SE.ID_CONCEPTO
		,CONVERT(DATETIME,CONVERT(VARCHAR(10),SE.FECHA_HORA_MOVIMIENTO,111)) FECHA_DISTRIBUCION
	FROM
		SIG_COLOMBIA_DW.GM.DISTRIBUCION_SEGUIMIENTO_ENVIO SE WITH (NOLOCK)
	WHERE	
		SE.ID_PROCESO = 9
                  AND  SE.ID_CONCEPTO NOT IN ( 2,5,7,8,9)
                   
	AND
		SE.FECHA_HORA_MOVIMIENTO &gt;= ?
	AND 
		SE.FECHA_HORA_MOVIMIENTO &lt; DATEADD(DAY,1,?)
)

SELECT
		 S_ID_FECHA_DISTRIBUCION
		,D_ID_CIUDAD_ZONA_URBA
		,D_ID_TIPO_ZONA_URBA
		,D_ID_ZONA_URBA
		,G_ID_GUIA
		,S_ID_PROCESO_SZU
		,S_ID_CONCEPTO_SZU
		,S_ID_PROCESO_REP
		,S_ID_CONCEPTO_REP
		,S_ID_HORA_REP
		,G_ID_TIPO_GUIA
		,G_ID_CIUDAD_ORIGEN
		,G_ID_CIUDAD_DESTINO
		,G_ID_TIEMPO_ENTREGA
		,G_ID_PRODUCTO
		,G_ID_SUBPRODUCTO
FROM
(
	SELECT
		 ROW_NUMBER() OVER(PARTITION BY G.NUMERO_GUIA ORDER BY SE.FECHA_DISTRIBUCION ASC) AS ID
		,SE.FECHA_DISTRIBUCION S_ID_FECHA_DISTRIBUCION
		,ISNULL(D.ID_CIUDAD_ZONA_URBA,-888) D_ID_CIUDAD_ZONA_URBA
		,ISNULL(CONVERT(INT,D.ID_TIPO_ZONA_URBA),-888) D_ID_TIPO_ZONA_URBA
		,ISNULL(CONVERT(INT,D.ID_ZONA_URBA),-888) D_ID_ZONA_URBA
		,G.NUMERO_GUIA G_ID_GUIA
		,CONVERT(INT,SE.ID_PROCESO) S_ID_PROCESO_SZU
		,ISNULL(CONVERT(INT,SE.ID_CONCEPTO),-888) S_ID_CONCEPTO_SZU
		,CONVERT(INT,-888) S_ID_PROCESO_REP
		,CONVERT(INT,-888) S_ID_CONCEPTO_REP
		,CONVERT(INT,-888) S_ID_HORA_REP
		,ISNULL(CONVERT(INT,G.ID_TIPOGUIA),-888) G_ID_TIPO_GUIA
		,ISNULL(G.ID_CIUDAD_ORIGEN,-888) G_ID_CIUDAD_ORIGEN
		,ISNULL(G.ID_CIUDAD_DESTINO,-888) G_ID_CIUDAD_DESTINO
		,ISNULL(CONVERT(INT,G.ID_TIEMPO),-888) G_ID_TIEMPO_ENTREGA
		,ISNULL(CONVERT(INT,G.ID_PRODUCTO),-888) G_ID_PRODUCTO
		,ISNULL(CONVERT(INT,G.ID_SUBPRODUCTO),-888) G_ID_SUBPRODUCTO
	FROM	
		CTE_SE SE
	INNER JOIN 
		SIG_COLOMBIA_DW.GM.DISTRIBUCION_DOCUMENTOS D WITH (NOLOCK)
	ON
		SE.ID_PROCESO = D.ID_PROCESO 
	AND 
		SE.NUMERO_MOVIMI = D.NUMERO_MOVIMI 
	AND 
		SE.CONSECUT_MOVIMI = D.CONSECUT_MOVIMI
	INNER JOIN
		SIG_COLOMBIA_DW.GM.DISTRIBUCION_GUIAS G WITH (NOLOCK)
	ON
		SE.NUMERO_GUIA = G.NUMERO_GUIA
	WHERE
		SE.ID = 1
) T
WHERE
	ID = 1</property>
