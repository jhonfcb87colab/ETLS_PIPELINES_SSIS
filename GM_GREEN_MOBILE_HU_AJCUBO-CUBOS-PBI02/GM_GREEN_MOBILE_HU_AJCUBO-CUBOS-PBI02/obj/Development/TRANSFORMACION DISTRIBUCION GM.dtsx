          SQLTask:SqlStatementSource="DECLARE @solucion nvarchar(128)&#xA;DECLARE @proyecto nvarchar(128)&#xA;DECLARE @paquete nvarchar(260)&#xA;DECLARE @fechaInicio datetime&#xA;DECLARE @fechaFin datetime &#xA;DECLARE @sincronico bit = 1&#xA;DECLARE @32Bits bit = 0&#xA;DECLARE @referenciaAmbiente bigint = Null&#xA;&#xA;&#xA;&#xA;SET @solucion = N'DATA MART LOGISTICA'&#xA;SET @proyecto = N'MODELO GREEN MOBILE'&#xA;SET @paquete = N'EXTRACCION DISTRIBUCION GM.dtsx'&#xA;SET @fechaInicio = ?&#xA;SET @fechaFin = ?&#xA;&#xA;&#xA;   Declare @execution_id bigint&#xA; Declare @execution_status bigint = 1&#xA;&#xA; -- Crea la ejecución y la inicia&#xA; EXEC [SSISDB].[catalog].[create_execution] @package_name=@paquete, @execution_id=@execution_id OUTPUT, @folder_name=@solucion, @project_name=@proyecto, @use32bitruntime=@32Bits, @reference_id=@referenciaAmbiente&#xA; EXEC [SSISDB].[catalog].[set_execution_parameter_value] @execution_id,  @object_type=20, @parameter_name=N'datFechaInicio', @parameter_value=@fechaInicio&#xA; EXEC [SSISDB].[catalog].[set_execution_parameter_value] @execution_id,  @object_type=20, @parameter_name=N'datFechaFin', @parameter_value=@fechaFin&#xA; EXEC [SSISDB].[catalog].[set_execution_parameter_value] @execution_id,  @object_type=50, @parameter_name=N'LOGGING_LEVEL', @parameter_value=100&#xA; EXEC [SSISDB].[catalog].[set_execution_parameter_value] @execution_id,  @object_type=50, @parameter_name=N'CUSTOMIZED_LOGGING_LEVEL', @parameter_value=N'Errors &amp; Warnings'&#xA;&#xA; EXEC [SSISDB].[catalog].[start_execution] @execution_id&#xA;&#xA; IF(@sincronico = 1)&#xA; BEGIN&#xA;  --Los posibles Valores son: created (1), running (2), canceled (3), failed (4), pending (5), ended unexpectedly (6), succeeded (7), stopping (8), and completed (9)&#xA;  WHILE(@execution_status NOT IN (3,4,6,7,9)) BEGIN &#xA;&#xA;   --Actualizar el estado.&#xA;   SET @execution_status = (&#xA;   SELECT&#xA;   [executions].[status]&#xA;   FROM&#xA;   [SSISDB].[catalog].[executions]&#xA;   WHERE&#xA;   [executions].[execution_id] = @execution_id&#xA;   )&#xA;  END&#xA; END&#xA;&#xA; IF(@execution_status IN (3,4,6))&#xA; BEGIN&#xA;  Declare @mensajeErr as nvarchar(200) = 'Error al ejecutar paquete [' + @solucion + '\'  + @proyecto + '\'   + @paquete + '] el paquete '  + CASE @execution_status WHEN 3 THEN 'FUE CANCELADO' WHEN 4 THEN 'FALLO' WHEN 6 THEN 'TERMINO INESPERADAMENTE' END&#xA;  RAISERROR(@mensajeErr,16,1)&#xA; END" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
