          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{B8FBD4FD-CC9D-461B-917B-F62532143670}"
              SQLTask:SqlStatementSource="WITH CTE_REP&#xA;(&#xA; &#x9; ID&#x9;&#xA;&#x9;,NUMERO_GUIA&#xA;&#x9;,ID_PROCESO&#xA;&#x9;,ID_CONCEPTO&#xA;&#x9;,FECHA_HORA_MOVIMIENTO&#xA;)&#xA;AS&#xA;(&#xA;&#x9;SELECT&#xA;&#x9;&#x9; ROW_NUMBER() OVER(PARTITION BY SE.NUMERO_GUIA ORDER BY SE.FECHA_HORA_MOVIMIENTO ASC) AS ID&#xA;&#x9;&#x9;,SE.NUMERO_GUIA&#xA;&#x9;&#x9;,SE.ID_PROCESO&#xA;&#x9;&#x9;,SE.ID_CONCEPTO&#xA;&#x9;&#x9;,SE.FECHA_HORA_MOVIMIENTO&#xA;&#x9;FROM&#xA;&#x9;&#x9;SIG_COLOMBIA_DW.GM.DISTRIBUCION_SEGUIMIENTO_ENVIO SE WITH (NOLOCK)&#xA;&#x9;INNER JOIN&#xA;&#x9;&#x9;SIG_COLOMBIA_DW.TMP.GM_DISTRIBUCION_SZU SZU WITH (NOLOCK)&#xA;&#x9;ON&#xA;&#x9;&#x9; SE.NUMERO_GUIA = SZU.G_ID_GUIA&#xA;&#x9;WHERE&#x9;&#xA;&#x9;&#x9;SE.ID_PROCESO IN (24,25)&#xA;&#x9;AND&#xA;&#x9;&#x9;SE.FECHA_HORA_MOVIMIENTO &gt;= ?&#xA;&#x9;AND &#xA;&#x9;&#x9;SE.FECHA_HORA_MOVIMIENTO &lt; DATEADD(DAY,1,?)&#xA;)&#xA;&#xA;UPDATE&#xA;&#x9;SIG_COLOMBIA_DW.TMP.GM_DISTRIBUCION_SZU&#xA;SET&#xA;&#x9; S_ID_PROCESO_REP = ISNULL(CONVERT(INT,CTE_REP.ID_PROCESO),-888)&#xA;&#x9;,S_ID_CONCEPTO_REP = ISNULL(CONVERT(INT,CTE_REP.ID_CONCEPTO),-888)&#xA;&#x9;,S_ID_HORA_REP = ISNULL(CONVERT(INT,DATEPART(HH, CTE_REP.FECHA_HORA_MOVIMIENTO)),-888)&#xA;FROM&#xA;&#x9;SIG_COLOMBIA_DW.TMP.GM_DISTRIBUCION_SZU SZU&#xA;INNER JOIN&#xA;&#x9;CTE_REP&#xA;ON&#xA;&#x9;SZU.G_ID_GUIA = CTE_REP.NUMERO_GUIA" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="0"
                SQLTask:DtsVariableName="User::datFechaDistribucion"
                SQLTask:ParameterDirection="Input"
                SQLTask:DataType="7"
                SQLTask:ParameterSize="-1" />
              <SQLTask:ParameterBinding
