            Var_FechaSup = (string)Dts.Variables["User::VFecha_Fin"].Value;
            Param_PPFechaFin = (string)Dts.Variables["$Package::PFechaFin"].Value;
            Param_PPFechaIni = (string)Dts.Variables["$Package::PFechaIni"].Value;



            MessageBox.Show("Param Fecha Inf: --" + Param_PPFechaIni + "-- \n  Param Fecha Sup; --" + Param_PPFechaFin + "-- \n Var Fecha Ini: --"
