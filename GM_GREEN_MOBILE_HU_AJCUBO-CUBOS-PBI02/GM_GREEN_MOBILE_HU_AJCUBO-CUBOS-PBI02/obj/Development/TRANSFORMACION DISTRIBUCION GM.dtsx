                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT DISTINCT
	 SE.NUMERO_GUIA
FROM	
	SIG_COLOMBIA_DW.GM.DISTRIBUCION_SEGUIMIENTO_ENVIO SE WITH (NOLOCK)
WHERE	
	SE.ID_PROCESO = 15
AND
	SE.FECHA_HORA_MOVIMIENTO &gt;= ? 
AND 
	SE.FECHA_HORA_MOVIMIENTO &lt; DATEADD(DAY,1,?)</property>
