            string Var_FechaInf;
            string Var_FechaSup;
            string Param_PPFechaFin;
            string Param_PPFechaIni;

            //User::VFecha_Fin
            //User::VFecha_Ini
            //$Package::PFechaFin
            //$Package::PFechaIni



