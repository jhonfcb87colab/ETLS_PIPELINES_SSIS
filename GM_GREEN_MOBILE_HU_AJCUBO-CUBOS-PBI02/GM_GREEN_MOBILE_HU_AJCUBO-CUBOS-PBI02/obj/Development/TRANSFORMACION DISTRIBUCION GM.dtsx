              SQLTask:SqlStatementSource="DELETE FROM SIG_COLOMBIA_DW.TMP.GM_DISTRIBUCION_SZU&#xA;FROM &#xA;&#x9;SIG_COLOMBIA_DW.TMP.GM_DISTRIBUCION_SZU SZU &#xA;INNER JOIN&#xA;&#x9;SIG_COLOMBIA_DW.TMP.GM_DISTRIBUCION_RPO RPO&#xA;ON&#xA;&#x9;SZU.G_ID_GUIA = RPO.NUMERO_GUIA" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
