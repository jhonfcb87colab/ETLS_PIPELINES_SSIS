    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{4EC34594-984C-4682-BB49-BB2B194BE88A}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot;&#xA;SELECT S.[NUMERO_SOLICITUD_RECOLECCION]&#xA;      ,S.[NUMERO_GUIA]&#xA;      ,S.[SOLICITA_IMPRESION]&#xA;      ,S.[APLICACION]&#xA;      ,S.[ID_ESTADO_RECOLECCION_GUIA]&#xA;      ,S.[ID_CAUSAL_NORECOLECCION_GUIA]&#xA;      ,S.[LOGIN_EMPLEADO]&#xA;      ,S.[FECHA_CREACION]&#xA;      ,S.[FECHA_MODIFICACION]&#xA;  FROM [dbo].[GUIAS_POR_SOLICITUDRECOLECCION] S WITH (NOLOCK)&#xA;INNER JOIN&#xA;&#x9;&#x9;[dbo].[SOLICITUDRECOLECCION] B WITH (NOLOCK)&#xA;on&#xA;S.NUMERO_SOLICITUD_RECOLECCION = B.NUMERO_SOLICITUD&#xA;WHERE &#xA;B.ID_CIUDAD IN (&quot;+(DT_WSTR, 50)@[User::CiudadesZona]+&quot;)&#xA;AND     B.FECHA_RECOLECCION  &gt;= &quot; + &quot;'&quot;+LEFT( (DT_WSTR, 50) @[User::FechaInf] ,19) +&quot;'&quot;  +&quot; &#xA;AND   B.FECHA_RECOLECCION &lt; DATEADD(DAY,1,&quot; + &quot;'&quot;+(DT_WSTR,50) @[User::FechaSup] +&quot;'&quot; +&quot;)  &#xA;AND B.ID_PAIS = 1 &quot;"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="GUIA_SOLICITUD_RECOL">
      <DTS:VariableValue
        DTS:DataType="8">
SELECT S.[NUMERO_SOLICITUD_RECOLECCION]
      ,S.[NUMERO_GUIA]
      ,S.[SOLICITA_IMPRESION]
      ,S.[APLICACION]
      ,S.[ID_ESTADO_RECOLECCION_GUIA]
      ,S.[ID_CAUSAL_NORECOLECCION_GUIA]
      ,S.[LOGIN_EMPLEADO]
      ,S.[FECHA_CREACION]
      ,S.[FECHA_MODIFICACION]
  FROM [dbo].[GUIAS_POR_SOLICITUDRECOLECCION] S WITH (NOLOCK)
INNER JOIN
		[dbo].[SOLICITUDRECOLECCION] B WITH (NOLOCK)
on
S.NUMERO_SOLICITUD_RECOLECCION = B.NUMERO_SOLICITUD
WHERE 
B.ID_CIUDAD IN (SELECT ID_CIUDAD FROM PARAMETROS.DBO.CIUDADES)
AND     B.FECHA_RECOLECCION  &gt;= '' 
AND   B.FECHA_RECOLECCION &lt; DATEADD(DAY,1,'')  
AND B.ID_PAIS = 1 </DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{1E28E9F7-FCD2-4F18-8521-38F8C88D4992}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot;&#xA;SELECT S.[ID_MOVIMIENTO]&#xA;      ,S.[NUMERO_SOLICITUD]&#xA;      ,S.[ID_ESTADO]&#xA;      ,S.[ID_PRODUCTO]&#xA;      ,S.[ID_SUBPRODUCTO]&#xA;      ,S.[ID_FORMAPAGO]&#xA;      ,S.[ID_TIEMPO]&#xA;      ,S.[ID_PAIS]&#xA;      ,S.[ID_CIUDAD]&#xA;      ,S.[ID_TIPO_ZONA_URBA]&#xA;      ,S.[ID_ZONA_URBA]&#xA;      ,S.[PLACA_VEHICULO_ASIGNADO]&#xA;      ,S.[ID_CONDUCTOR_ASIGNADO]&#xA;      ,S.[ID_AUXILIAR1_ASIGNADO]&#xA;      ,S.[ID_AUXILIAR2_ASIGNADO]&#xA;      ,S.[AVANTEL_VEHICULO_ASIGNADO]&#xA;      ,S.[FECHA_RECOLECCION_LLEGADA]&#xA;      ,S.[FECHA_RECOLECCION_SALIDA]&#xA;      ,S.[ID_MOTIVO_RECHAZO]&#xA;      ,S.[FECHA_MOVIMIENTO]&#xA;      ,S.[LOGIN_EMPLEADO]&#xA;      ,S.[FECHA_CREACION]&#xA;      ,S.[FECHA_MODIFICACION]&#xA;      ,S.[OBSERVACION_SOLICITUD]&#xA;  FROM [dbo].[MOVIMIENTO_SOLICITUD_RECOLECCION] S WITH (NOLOCK)&#xA;INNER JOIN&#xA;&#x9;&#x9;[dbo].[SOLICITUDRECOLECCION] B WITH (NOLOCK)&#xA;on&#xA;S.NUMERO_SOLICITUD = B.NUMERO_SOLICITUD&#xA;WHERE &#xA;B.ID_CIUDAD IN (&quot;+(DT_WSTR, 50)@[User::CiudadesZona]+&quot;)&#xA;AND     B.FECHA_RECOLECCION  &gt;= &quot; + &quot;'&quot;+LEFT( (DT_WSTR, 50) @[User::FechaInf] ,19) +&quot;'&quot;  +&quot; &#xA;AND   B.FECHA_RECOLECCION &lt; DATEADD(DAY,1,&quot; + &quot;'&quot;+(DT_WSTR,50) @[User::FechaSup] +&quot;'&quot; +&quot;)  &#xA;AND B.ID_PAIS = 1 &quot;"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="MOV_SOLICITUD_RECOL">
      <DTS:VariableValue
        DTS:DataType="8">
SELECT S.[ID_MOVIMIENTO]
      ,S.[NUMERO_SOLICITUD]
      ,S.[ID_ESTADO]
      ,S.[ID_PRODUCTO]
      ,S.[ID_SUBPRODUCTO]
      ,S.[ID_FORMAPAGO]
      ,S.[ID_TIEMPO]
      ,S.[ID_PAIS]
      ,S.[ID_CIUDAD]
      ,S.[ID_TIPO_ZONA_URBA]
      ,S.[ID_ZONA_URBA]
      ,S.[PLACA_VEHICULO_ASIGNADO]
      ,S.[ID_CONDUCTOR_ASIGNADO]
      ,S.[ID_AUXILIAR1_ASIGNADO]
      ,S.[ID_AUXILIAR2_ASIGNADO]
      ,S.[AVANTEL_VEHICULO_ASIGNADO]
      ,S.[FECHA_RECOLECCION_LLEGADA]
      ,S.[FECHA_RECOLECCION_SALIDA]
      ,S.[ID_MOTIVO_RECHAZO]
      ,S.[FECHA_MOVIMIENTO]
      ,S.[LOGIN_EMPLEADO]
      ,S.[FECHA_CREACION]
      ,S.[FECHA_MODIFICACION]
      ,S.[OBSERVACION_SOLICITUD]
  FROM [dbo].[MOVIMIENTO_SOLICITUD_RECOLECCION] S WITH (NOLOCK)
INNER JOIN
		[dbo].[SOLICITUDRECOLECCION] B WITH (NOLOCK)
on
S.NUMERO_SOLICITUD = B.NUMERO_SOLICITUD
WHERE 
B.ID_CIUDAD IN (SELECT ID_CIUDAD FROM PARAMETROS.DBO.CIUDADES)
AND     B.FECHA_RECOLECCION  &gt;= '' 
AND   B.FECHA_RECOLECCION &lt; DATEADD(DAY,1,'')  
AND B.ID_PAIS = 1 </DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{491D054C-25F3-4FFB-A33E-DE7E36F38976}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot;SELECT S.ID_PAIS&#xA;      ,S.NUMERO_SOLICITUD&#xA;      ,S.ID_CLIENTE&#xA;      ,S.ID_SUCURSAL&#xA;      ,S.ID_DEPENDEN&#xA;      ,S.ID_PRODUCTO&#xA;      ,S.ID_SUBPRODUCTO&#xA;      ,S.PLACA_VEHICULO_ASIGNADO&#xA;      ,S.ID_CONDUCTOR_ASIGNADO&#xA;      ,S.ID_AUXILIAR1_ASIGNADO&#xA;      ,S.ID_AUXILIAR2_ASIGNADO&#xA;      ,S.ID_FORMAPAGO&#xA;      ,S.ID_TIEMPO&#xA;      ,S.ID_TIPO_ZONA_URBA&#xA;      ,S.ID_CIUDAD&#xA;      ,S.ID_ZONA_URBA&#xA;      ,S.ID_CIUDAD_DIVISION&#xA;      ,S.ID_DIVISION&#xA;      ,S.FECHA_SOLICITUD_REC&#xA;      ,S.NOMBRE_CONTACTO_SOLIC_SER&#xA;      ,S.FECHA_RECOLECCION&#xA;      ,S.FECHA_RECOLECCION_LLEGADA&#xA;      ,S.FECHA_RECOLECCION_SALIDA&#xA;      ,S.ID_TIPO_SOLICITUD&#xA;      ,S.ID_TIPO_SOLICITANTE&#xA;      ,S.ID_CONFIRM_SOLICITUD&#xA;      ,S.OBSERVACION_SOLICITUD&#xA;      ,S.DIRECCION_RECOLECCION&#xA;      ,S.TELEFONO_RECOLECCION&#xA;      ,S.HORA_MAXIMA_RECOLECCION&#xA;      ,S.CANTIDAD_ENVIOS&#xA;      ,S.PESO_PIEZA_MAXIMA&#xA;      ,S.LARGO_PIEZA_MAXIMA&#xA;      ,S.ANCHO_PIEZA_MAXIMA&#xA;      ,S.ALTO_PIEZA_MAXIMA&#xA;      ,S.ID_MOTIVO_RECHAZO&#xA;      ,S.ID_REGISTRO_SOLICITUD&#xA;      ,S.ID_AUTO_EMBALAJE&#xA;      ,S.TOTAL_ENVIOS_RECOGIDOS&#xA;      ,S.PESO_TOTAL_SOLICITUD&#xA;      ,S.PESO_TOTAL_RECOGIDO&#xA;      ,S.PLACA_VEHICULO_RECOGIO&#xA;      ,S.ID_CONDUCTOR_RECOGIO&#xA;      ,S.ID_AUXILIAR1_RECOGIO&#xA;      ,S.ID_AUXILIAR2_RECOGIO&#xA;      ,S.ID_ESTADO_MOVIL&#xA;      ,S.AVANTEL_VEHICULO_ASIGNADO&#xA;      ,S.LOGIN_EMPLEADO&#xA;      ,S.FECHA_CREACION&#xA;      ,S.FECHA_MODIFICACION&#xA;      ,S.ORDEN_SERVICIO&#xA;      ,S.ID_REPLICADO&#xA;      ,S.ALTO_PIEZA_RECOGIDA&#xA;      ,S.ANCHO_PIEZA_RECOGIDA&#xA;      ,S.LARGO_PIEZA_RECOGIDA&#xA;      ,S.LATITUD_GPS&#xA;      ,S.LONGITUD_GPS&#xA;      ,S.ID_TIPO_IDENTIFIC&#xA;      ,S.CODIGO_POSTAL&#xA;      ,S.NUMERO_GUIA_INICIAL&#xA;      ,S.NUMERO_GUIA_FINAL&#xA;      ,S.NUMERO_GUIA_ULT_REGISTRADA&#xA;      ,S.ID_ESTADO_MANIFIESTO&#xA;      ,S.CANTIDAD_PIEZAS&#xA;      ,CASE WHEN EAUX.ID_EMPLEADO IS NOT NULL THEN 'SI' ELSE 'NO' END GM_MARCA&#xA;  FROM dbo.SOLICITUDRECOLECCION S WITH (NOLOCK)&#xA;LEFT JOIN&#xA;&#x9;(SELECT ID_EMPLEADO FROM PARAMETROS.DBO.EMPLEADOS  WITH(NOLOCK) WHERE CODIGO_GCM IS NOT NULL) EAUX&#xA;ON&#xA;&#x9;( CASE WHEN (S.ID_AUXILIAR1_ASIGNADO = '' OR S.ID_AUXILIAR1_ASIGNADO IS NULL)   &#xA;                     THEN CASE WHEN (S.ID_AUXILIAR2_ASIGNADO = '' OR S.ID_AUXILIAR2_ASIGNADO IS NULL)   &#xA;                     THEN S.ID_CONDUCTOR_ASIGNADO   &#xA;                     ELSE S.ID_AUXILIAR2_ASIGNADO END   &#xA;                     ELSE S.ID_AUXILIAR1_ASIGNADO END) = EAUX.ID_EMPLEADO&#xA;WHERE &#xA;S.ID_CIUDAD IN (&quot;+(DT_WSTR, 50)@[User::CiudadesZona]+&quot;)&#xA;AND     S.FECHA_RECOLECCION  &gt;= &quot; + &quot;'&quot;+LEFT( (DT_WSTR, 50) @[User::FechaInf] ,19) +&quot;'&quot;  +&quot; &#xA;AND   S.FECHA_RECOLECCION &lt; DATEADD(DAY,1,&quot; + &quot;'&quot;+(DT_WSTR,50) @[User::FechaSup] +&quot;'&quot; +&quot;)  &#xA;AND S.ID_PAIS = 1&#xA;&quot;"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="SOLICITUDES_RECOL">
      <DTS:VariableValue
        DTS:DataType="8">SELECT S.ID_PAIS
      ,S.NUMERO_SOLICITUD
      ,S.ID_CLIENTE
      ,S.ID_SUCURSAL
      ,S.ID_DEPENDEN
      ,S.ID_PRODUCTO
      ,S.ID_SUBPRODUCTO
      ,S.PLACA_VEHICULO_ASIGNADO
      ,S.ID_CONDUCTOR_ASIGNADO
      ,S.ID_AUXILIAR1_ASIGNADO
      ,S.ID_AUXILIAR2_ASIGNADO
      ,S.ID_FORMAPAGO
      ,S.ID_TIEMPO
      ,S.ID_TIPO_ZONA_URBA
      ,S.ID_CIUDAD
      ,S.ID_ZONA_URBA
      ,S.ID_CIUDAD_DIVISION
      ,S.ID_DIVISION
      ,S.FECHA_SOLICITUD_REC
      ,S.NOMBRE_CONTACTO_SOLIC_SER
      ,S.FECHA_RECOLECCION
      ,S.FECHA_RECOLECCION_LLEGADA
      ,S.FECHA_RECOLECCION_SALIDA
      ,S.ID_TIPO_SOLICITUD
      ,S.ID_TIPO_SOLICITANTE
      ,S.ID_CONFIRM_SOLICITUD
      ,S.OBSERVACION_SOLICITUD
      ,S.DIRECCION_RECOLECCION
      ,S.TELEFONO_RECOLECCION
      ,S.HORA_MAXIMA_RECOLECCION
      ,S.CANTIDAD_ENVIOS
      ,S.PESO_PIEZA_MAXIMA
      ,S.LARGO_PIEZA_MAXIMA
      ,S.ANCHO_PIEZA_MAXIMA
      ,S.ALTO_PIEZA_MAXIMA
      ,S.ID_MOTIVO_RECHAZO
      ,S.ID_REGISTRO_SOLICITUD
      ,S.ID_AUTO_EMBALAJE
      ,S.TOTAL_ENVIOS_RECOGIDOS
      ,S.PESO_TOTAL_SOLICITUD
      ,S.PESO_TOTAL_RECOGIDO
      ,S.PLACA_VEHICULO_RECOGIO
      ,S.ID_CONDUCTOR_RECOGIO
      ,S.ID_AUXILIAR1_RECOGIO
      ,S.ID_AUXILIAR2_RECOGIO
      ,S.ID_ESTADO_MOVIL
      ,S.AVANTEL_VEHICULO_ASIGNADO
      ,S.LOGIN_EMPLEADO
      ,S.FECHA_CREACION
      ,S.FECHA_MODIFICACION
      ,S.ORDEN_SERVICIO
      ,S.ID_REPLICADO
      ,S.ALTO_PIEZA_RECOGIDA
      ,S.ANCHO_PIEZA_RECOGIDA
      ,S.LARGO_PIEZA_RECOGIDA
      ,S.LATITUD_GPS
      ,S.LONGITUD_GPS
      ,S.ID_TIPO_IDENTIFIC
      ,S.CODIGO_POSTAL
      ,S.NUMERO_GUIA_INICIAL
      ,S.NUMERO_GUIA_FINAL
      ,S.NUMERO_GUIA_ULT_REGISTRADA
      ,S.ID_ESTADO_MANIFIESTO
      ,S.CANTIDAD_PIEZAS
      ,CASE WHEN EAUX.ID_EMPLEADO IS NOT NULL THEN 'SI' ELSE 'NO' END GM_MARCA
  FROM dbo.SOLICITUDRECOLECCION S WITH (NOLOCK)
LEFT JOIN
	(SELECT ID_EMPLEADO FROM PARAMETROS.DBO.EMPLEADOS  WITH(NOLOCK) WHERE CODIGO_GCM IS NOT NULL) EAUX
ON
	( CASE WHEN (S.ID_AUXILIAR1_ASIGNADO = '' OR S.ID_AUXILIAR1_ASIGNADO IS NULL)   
                     THEN CASE WHEN (S.ID_AUXILIAR2_ASIGNADO = '' OR S.ID_AUXILIAR2_ASIGNADO IS NULL)   
                     THEN S.ID_CONDUCTOR_ASIGNADO   
                     ELSE S.ID_AUXILIAR2_ASIGNADO END   
                     ELSE S.ID_AUXILIAR1_ASIGNADO END) = EAUX.ID_EMPLEADO
WHERE 
S.ID_CIUDAD IN (SELECT ID_CIUDAD FROM PARAMETROS.DBO.CIUDADES)
AND     S.FECHA_RECOLECCION  &gt;= '' 
AND   S.FECHA_RECOLECCION &lt; DATEADD(DAY,1,'')  
AND S.ID_PAIS = 1
</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{39C377CD-6058-41EE-BA10-D8201B0E5F05}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot;&#xA;SELECT S.[ID_PAIS]&#xA;      ,S.[NUMERO_SOLICITUD]&#xA;      ,S.[ALTO_TOTAL_RECOGIDO]&#xA;      ,S.[ANCHO_TOTAL_RECOGIDO]&#xA;      ,S.[LARGO_TOTAL_RECOGIDO]&#xA;      ,S.[PESO_TOTAL_RECOGIDO]&#xA;      ,S.[LATITUD_GPS]&#xA;      ,S.[LONGITUD_GPS]&#xA;      ,S.[SENAL_GPS]&#xA;      ,S.[LOGIN_CREACION]&#xA;      ,S.[FECHA_CREACION]&#xA;      ,S.[LOGIN_MODIFICACION]&#xA;      ,S.[FECHA_MODIFICACION]&#xA;      ,S.[RUTA_IMAGEN_FIRMA]&#xA;      ,S.[RUTA_IMAGEN_FOTO]&#xA;  FROM [dbo].[SOLICITUDRECOLECCION_DETALLE_RECOGIDO] S WITH (NOLOCK)&#xA;INNER JOIN&#xA;&#x9;&#x9;[dbo].[SOLICITUDRECOLECCION] B WITH (NOLOCK)&#xA;on&#xA;S.NUMERO_SOLICITUD = B.NUMERO_SOLICITUD&#xA;WHERE &#xA;B.ID_CIUDAD IN (&quot;+(DT_WSTR, 50)@[User::CiudadesZona]+&quot;)&#xA;AND     B.FECHA_RECOLECCION  &gt;= &quot; + &quot;'&quot;+LEFT( (DT_WSTR, 50) @[User::FechaInf] ,19) +&quot;'&quot;  +&quot; &#xA;AND   B.FECHA_RECOLECCION &lt; DATEADD(DAY,1,&quot; + &quot;'&quot;+(DT_WSTR,50) @[User::FechaSup] +&quot;'&quot; +&quot;)  &#xA;AND B.ID_PAIS = 1 &quot;"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="SOLICITUD_RECOL_DETALLE_RECOG">
      <DTS:VariableValue
        DTS:DataType="8">
SELECT S.[ID_PAIS]
      ,S.[NUMERO_SOLICITUD]
      ,S.[ALTO_TOTAL_RECOGIDO]
      ,S.[ANCHO_TOTAL_RECOGIDO]
      ,S.[LARGO_TOTAL_RECOGIDO]
      ,S.[PESO_TOTAL_RECOGIDO]
      ,S.[LATITUD_GPS]
      ,S.[LONGITUD_GPS]
      ,S.[SENAL_GPS]
      ,S.[LOGIN_CREACION]
      ,S.[FECHA_CREACION]
      ,S.[LOGIN_MODIFICACION]
      ,S.[FECHA_MODIFICACION]
      ,S.[RUTA_IMAGEN_FIRMA]
      ,S.[RUTA_IMAGEN_FOTO]
  FROM [dbo].[SOLICITUDRECOLECCION_DETALLE_RECOGIDO] S WITH (NOLOCK)
INNER JOIN
		[dbo].[SOLICITUDRECOLECCION] B WITH (NOLOCK)
on
S.NUMERO_SOLICITUD = B.NUMERO_SOLICITUD
WHERE 
B.ID_CIUDAD IN (SELECT ID_CIUDAD FROM PARAMETROS.DBO.CIUDADES)
AND     B.FECHA_RECOLECCION  &gt;= '' 
AND   B.FECHA_RECOLECCION &lt; DATEADD(DAY,1,'')  
AND B.ID_PAIS = 1 </DTS:VariableValue>
    </DTS:Variable>
  </DTS:Variables>
