                    <component
                      refId="Package\Sequence Container\DIM CDS\TRANSPORTAR CDS\OLE DB Source"
                      componentClassID="Microsoft.OLEDBSource"
                      contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                      description="OLE DB Source"
                      name="OLE DB Source"
                      usesDispositions="true"
                      version="7">
                      <properties>
                        <property
                          dataType="System.Int32"
                          description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                          name="CommandTimeout">0</property>
                        <property
                          dataType="System.String"
                          description="Specifies the name of the database object used to open a rowset."
                          name="OpenRowset"></property>
                        <property
                          dataType="System.String"
                          description="Specifies the variable that contains the name of the database object used to open a rowset."
                          name="OpenRowsetVariable"></property>
                        <property
                          dataType="System.String"
                          description="The SQL command to be executed."
                          name="SqlCommand"
                          UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">WITH CTE_G_RECOLECCION AS(
   SELECT 
   ROW_NUMBER ( )   OVER ( PARTITION BY GR.NUMERO_GUIA order by G.FECHA_MODIFICACION_DG desc )  ROWid  
   /*,GR.NUMERO_SOLICITUD AS GR_NUMERO_SOLICITUD
   ,GR.NUMERO_GUIA AS GR_NUMERO_GUIA
   ,G.FECHA_ENVIO AS G_FECHA_ENVIO 
   ,SR.FECHA_CREACION AS SR_FECHA_CREACION
   ,SR.FECHA_RECOLECCION AS SR_FECHA_RECOLECCION
   ,SR.FECHA_SOLICITUD_REC AS SR_FECHA_SOLICITUD_REC
   ,SR.FECHA_RECOLECCION_SALIDA AS SR_FECHA_RECOLECCION_SALIDA
   ,SR.FECHA_RECOLECCION_LLEGADA  AS SR_FECHA_RECOLECCION_LLEGADA
   ,G.FECHA_ENTREGA AS G_FECHA_ENTREGA
   ,G.ID_ESTADOENVIO AS G_ID_ESTADOENVIO */ 
   ,SR.ID_CLIENTE AS SR_ID_CLIENTE
   ,G.ID_CLIENTE AS G_ID_CLIENTE
   ,C.NOMBRE_CLIENTE/*
   ,SR.ID_FORMAPAGO AS SR_ID_FORMAPAGO
   ,SR.ID_TIEMPO	AS SR_ID_TIEMPO 
   ,SR.ID_TIPO_ZONA_URBA AS SR_ID_TIPO_ZONA_URBA	
   ,SR.ID_ZONA_URBA	AS SR_ID_ZONA_URBA*/
   ,SR.ID_PAIS AS SR_ID_PAIS
   ,SR.ID_CIUDAD AS SR_ID_CIUDAD	
   ,SR.ID_DIVISION AS SR_ID_DIVISION
   ,G.FECHA_MODIFICACION_DG AS G_FECHA_MODIFICACION_DG
	FROM [Mece_Logistico].[dbo].[RECOLECCIONES_GUIAS] GR WITH(NOLOCK) 
   INNER JOIN [dbo].[SOLICITUDRECOLECCION] SR ON GR.NUMERO_SOLICITUD=SR.NUMERO_SOLICITUD
   INNER JOIN [dbo].GUIAS G WITH(NOLOCK) ON G.NUMERO_GUIA=GR.NUMERO_GUIA
   INNER JOIN PARAMETROS.DBO.CLIENTES C WITH(NOLOCK) ON G.ID_CLIENTE = C.ID_CLIENTE
     -------------- INNER JOIN [dbo].SEGUIMIENTO_ENVIO SG WITH(NOLOCK) ON SG.NUMERO_GUIA=GR.NUMERO_GUIA
  --WHERE G.ID_CLIENTE IS NULL AND LEN(SR.ID_CLIENTE)&lt;1 
  --------------AND SG.ID_PROCESO IN (2,6,9)
   )
   SELECT 
   CTE.* 
   ,DIV.NOMBRE_DIVISION AS NOMBRE_CDS
   ,DIV.ID_DIVISION AS G_ID_CDS
   ,DIV.ID_EST_DIVISION AS ESTADO_CDS
   FROM CTE_G_RECOLECCION CTE 
   INNER JOIN PARAMETROS..DIVISIONES DIV WITH(NOLOCK)
   ON (
		CTE.SR_ID_PAIS=DIV.ID_PAIS
		AND CTE.SR_ID_CIUDAD=DIV.ID_CIUDAD
		AND CTE.SR_ID_DIVISION=DIV.ID_DIVISION
	)	
   WHERE CTE.ROWid=1</property>
