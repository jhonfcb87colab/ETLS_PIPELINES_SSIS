                          dataType="System.String"
                          description="The SQL command to be executed."
                          name="SqlCommand"
                          UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">WITH CTE AS(
SELECT ROW_NUMBER() OVER(PARTITION BY G_ID_CDS ORDER BY G_ID_CDS) ID, 
	   [SR_ID_PAIS]
      ,[SR_ID_CIUDAD]
      ,[SR_ID_DIVISION]
      ,[G_FECHA_MODIFICACION_DG]
      ,[NOMBRE_CDS]
      ,[G_ID_CDS]
      ,[SR_ID_CLIENTE]
      ,[ESTADO_CDS]
  FROM [TMP].[GM_RECOLECCION_CDS]
  )
SELECT *
FROM CTE WITH(NOLOCK)
WHERE ID = 1</property>
