    <DTS:Executable
      DTS:refId="Package\Paso 01 Insertar Recoleccion"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{3EF10E30-77FD-4966-9FEF-14C17AFF6780}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Paso 01 Insertar Recoleccion"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{B8FBD4FD-CC9D-461B-917B-F62532143670}"
          SQLTask:SqlStatementSource="INSERT INTO &#xA;&#x9;[TMP].[GM_SOLICITUDRECOLECCION]&#xA;(&#xA;&#x9; S_NUMERO_SOLICITUD&#xA;&#x9;,S_ID_FECHA_RECOLECCION&#xA;&#x9;,S_ID_CIUDAD_ZONA_URBA&#xA;&#x9;,S_ID_TIPO_ZONA_URBA&#xA;&#x9;,S_ID_ZONA_URBA&#xA;&#x9;,S_ID_CONFIRM_SOLICITUD&#xA;&#x9;,S_ID_TIPO_SOLICITUD&#xA;&#x9;,S_ID_MOTIVO_RECHAZO&#xA;&#x9;,S_ID_CLIENTE&#xA;&#x9;,S_ID_PRODUCTO&#xA;&#x9;,S_ID_SUBPRODUCTO&#xA;&#x9;,S_ID_TIEMPO_ENTREGAR&#xA;&#x9;,GM_MARCA&#xA;&#x9;,FECHA_SOLICITUD_REC&#xA;&#x9;,OBSERVACIONES&#xA;,CDS&#xA;,ID_CDS&#xA;)&#xA;SELECT&#xA;&#x9; S.NUMERO_SOLICITUD S_NUMERO_SOLICITUD&#xA;&#x9;,S.FECHA_RECOLECCION S_ID_FECHA_RECOLECCION&#xA;&#x9;,ISNULL(S.ID_CIUDAD,-888) S_ID_CIUDAD_ZONA_URBA&#xA;&#x9;,ISNULL(CONVERT(INT,S.ID_TIPO_ZONA_URBA),-888) S_ID_TIPO_ZONA_URBA&#xA;&#x9;,ISNULL(CONVERT(INT,S.ID_ZONA_URBA),-888) S_ID_ZONA_URBA&#xA;&#x9;,ISNULL(CONVERT(INT,S.ID_CONFIRM_SOLICITUD),-888) S_ID_CONFIRM_SOLICITUD &#xA;&#x9;,ISNULL(CONVERT(INT,S.ID_TIPO_SOLICITUD),-888) S_ID_TIPO_SOLICITUD&#xA;&#x9;,ISNULL(S.ID_MOTIVO_RECHAZO,-888) S_ID_MOTIVO_RECHAZO&#xA;&#x9;,CASE WHEN S.ID_CLIENTE = '' THEN '-888' ELSE ISNULL(CONVERT (VARCHAR,S.ID_CLIENTE),'-888') END S_ID_CLIENTE&#xA;&#x9;,ISNULL(CONVERT(INT,S.ID_PRODUCTO),-888) S_ID_PRODUCTO&#xA;&#x9;,ISNULL(CONVERT(INT,S.ID_SUBPRODUCTO),-888) S_ID_SUBPRODUCTO&#xA;&#x9;,ISNULL(CONVERT(INT,S.ID_TIEMPO),-888) S_ID_TIEMPO_ENTREGAR&#xA;&#x9;,S.GM_MARCA&#xA;&#x9;,S.FECHA_SOLICITUD_REC&#xA;&#x9;,CASE WHEN S.OBSERVACION_SOLICITUD = '' THEN 'NO DISPONIBLE' ELSE ISNULL(S.OBSERVACION_SOLICITUD,'NO DISPONIBLE') END OBSERVACIONES&#xA;&#x9;,D.NOMBRE_DIVISION AS CDS&#xA;&#x9;,S.ID_DIVISION AS ID_CDS&#xA;FROM&#xA;&#x9;[GM].[SOLICITUDRECOLECCION] S WITH(NOLOCK)&#xA;&#x9;LEFT JOIN PAR.DIVISIONES D WITH(NOLOCK)&#xA;&#x9;ON S.ID_PAIS = D.ID_PAIS&#xA;&#x9;AND S.ID_CIUDAD = D.ID_CIUDAD&#xA;&#x9;AND S.ID_DIVISION = D.ID_DIVISION&#xA;WHERE &#xA;&#x9;S.ID_TIPO_SOLICITUD IN (1,2)&#xA;AND&#xA;&#x9;CONVERT(DATETIME,CONVERT(DATE,S.FECHA_RECOLECCION)) NOT IN (SELECT [FECHA_FESTIVA] FROM [PAR].[FESTIVOSNACIONALES] WITH (NOLOCK))" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Paso 02 Insertar Fechas Movimiento Recoleccion"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{d842e81f-e640-4335-b88f-6f354006f201}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Paso 02 Insertar Fechas Movimiento Recoleccion"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{B8FBD4FD-CC9D-461B-917B-F62532143670}"
          SQLTask:SqlStatementSource="WITH CTE&#xA;(&#xA;&#x9; NUMERO_SOLICITUD&#xA;&#x9;,FECHA_HORA_RECOLECCION_REGIS&#xA;&#x9;,FECHA_HORA_RECOLECCION_ZONIF&#xA;&#x9;,FECHA_HORA_RECOLECCION_ASIGN&#xA;&#x9;,FECHA_HORA_RECOLECCION_VERIF&#xA;&#x9;,FECHA_HORA_RECOLECCION_CANCEL&#xA;)&#xA;AS&#xA;&#x9;(&#xA;&#x9;&#x9;SELECT &#xA;&#x9;&#x9;&#x9; NUMERO_SOLICITUD&#xA;&#x9;&#x9;&#x9;,ISNULL(MAX(CASE WHEN ID_ESTADO = 1 THEN FECHA_MOVIMIENTO ELSE NULL END ),'1900-01-01') FECHA_HORA_RECOLECCION_REGIS&#xA;&#x9;&#x9;&#x9;,ISNULL(MAX(CASE WHEN ID_ESTADO = 2 THEN FECHA_MOVIMIENTO ELSE NULL END ),'1900-01-01') FECHA_HORA_RECOLECCION_ZONIF&#xA;&#x9;&#x9;&#x9;,ISNULL(MAX(CASE WHEN ID_ESTADO = 3 THEN FECHA_MOVIMIENTO ELSE NULL END ),'1900-01-01') FECHA_HORA_RECOLECCION_ASIGN&#xA;&#x9;&#x9;&#x9;,ISNULL(MAX(CASE WHEN ID_ESTADO = 4 THEN FECHA_MOVIMIENTO ELSE NULL END ),'1900-01-01') FECHA_HORA_RECOLECCION_VERIF&#xA;&#x9;&#x9;&#x9;,ISNULL(MAX(CASE WHEN ID_ESTADO = 5 THEN FECHA_MOVIMIENTO ELSE NULL END ),'1900-01-01') FECHA_HORA_RECOLECCION_CANCEL&#xA;&#x9;&#x9;FROM&#xA;&#x9;&#x9;&#x9;TMP.GM_SOLICITUDRECOLECCION S WITH (NOLOCK)&#xA;&#x9;&#x9;INNER JOIN&#xA;&#x9;&#x9;&#x9;GM.MOVIMIENTO_SOLICITUD_RECOLECCION M WITH(NOLOCK)&#xA;&#x9;&#x9;ON&#xA;&#x9;&#x9;&#x9;M.NUMERO_SOLICITUD = S.S_NUMERO_SOLICITUD&#xA;&#x9;&#x9;GROUP BY &#xA;&#x9;&#x9;&#x9;NUMERO_SOLICITUD&#xA;&#x9;)&#xA;&#xA;UPDATE &#xA;&#x9;A    &#xA;SET &#xA;    &#x9;A.FECHA_HORA_RECOLECCION_REGIS  = B.FECHA_HORA_RECOLECCION_REGIS,&#xA;&#x9;A.FECHA_HORA_RECOLECCION_ZONIF  = B.FECHA_HORA_RECOLECCION_ZONIF,&#xA;&#x9;A.FECHA_HORA_RECOLECCION_ASIGN  = B.FECHA_HORA_RECOLECCION_ASIGN,&#xA;&#x9;A.FECHA_HORA_RECOLECCION_VERIF  = B.FECHA_HORA_RECOLECCION_VERIF,&#xA;&#x9;A.FECHA_HORA_RECOLECCION_CANCEL = B.FECHA_HORA_RECOLECCION_CANCEL&#xA;FROM &#xA;&#x9;TMP.GM_SOLICITUDRECOLECCION A WITH (NOLOCK)&#xA;INNER JOIN  &#xA;&#x9;CTE B WITH (NOLOCK)&#xA;ON &#xA;&#x9;A.S_NUMERO_SOLICITUD = B.NUMERO_SOLICITUD" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
