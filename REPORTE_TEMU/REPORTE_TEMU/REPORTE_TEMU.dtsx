                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=15.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT [NUMERO_GUIA]
      ,LTRIM(RTRIM(CONVERT (nvarchar,[FECHA_ENVIO_PREFA],120))) AS FECHA_ENVIO_PREFA 
 --     ,dbo.LimpiarEspacios(LTRIM(RTRIM([DESCRIPCION]))) AS DESCRIPCION
    ,DESCRIPCION = CASE WHEN DESCRIPCION LIKE '%NO%FACTURADO%' THEN 'NO FACTURADO'
							WHEN DESCRIPCION LIKE '%NO%INTEG%INCONSIS%DATO%' THEN 'NO INTEG INCONSIS DATO'
							WHEN DESCRIPCION LIKE '%LIQUIDADA%' THEN 'LIQUIDADA'
							WHEN DESCRIPCION LIKE '%EN%PREFACTURA%CERRADA%' THEN 'EN PREFACTURA CERRADA'
							WHEN DESCRIPCION LIKE '%EN%PREFACTURA%ABIERTA%' THEN 'EN PREFACTURA ABIERTA'
							ELSE DESCRIPCION 
							END
      ,LTRIM(RTRIM(CONVERT (NVARCHAR(10),[PESO_FACTURADO]))) AS PESO_FACTURADO 
      ,LTRIM(RTRIM(CONVERT (NVARCHAR(20),[CIUDAD_ORIGEN]))) AS CIUDAD_ORIGEN
      ,LTRIM(RTRIM(CONVERT (NVARCHAR(20),[CIUDAD_DESTINO]))) AS CIUDAD_DESTINO 
      ,LTRIM(RTRIM(CONVERT (NVARCHAR(20),[NOMBRE_TIPOTRAY]))) AS NOMBRE_TIPOTRAY
      ,LTRIM(RTRIM(CONVERT (nvarchar,[Fec_Envio],120))) AS Fec_Envio
      ,LTRIM(RTRIM(CONVERT (NVARCHAR(10),[Num_PesoTotal]))) AS Num_PesoTotal
      ,LTRIM(RTRIM(CONVERT (NVARCHAR(50),[CIUDAD_ORIGEN_SISCLINET]))) AS CIUDAD_ORIGEN_SISCLINET
      ,LTRIM(RTRIM(CONVERT (NVARCHAR(50),[CIUDAD_DESTINO_SISCLINET]))) AS CIUDAD_DESTINO_SISCLINET
      ,LTRIM(RTRIM(CONVERT (NVARCHAR(50),[NOMBRE_TIPO_TRAEYCTO_SISCLINET]))) AS NOMBRE_TIPO_TRAEYCTO_SISCLINET
      ,LTRIM(RTRIM(CONVERT (NVARCHAR(50),[Des_VlrCampoPersonalizado1]))) AS Des_VlrCampoPersonalizado1
      ,LTRIM(RTRIM(CONVERT (NVARCHAR(50),[Des_DiceContener]))) AS Des_DiceContener
      ,LTRIM(RTRIM(CONVERT (NVARCHAR(50),[CIUDAD_ORIGEN_DG]))) AS CIUDAD_ORIGEN_DG
      ,LTRIM(RTRIM(CONVERT (NVARCHAR(50),[CIUDAD_DESTINO_DG]))) AS CIUDAD_DESTINO_DG
      ,LTRIM(RTRIM(CONVERT (NVARCHAR(50),[NOMBRE_ESTADOENVIO]))) AS NOMBRE_ESTADOENVIO
      ,LTRIM(RTRIM(CONVERT (nvarchar,[FECHA_ENTREGA],120))) AS FECHA_ENTREGA
      ,LTRIM(RTRIM(CONVERT (nvarchar,[FECHA_PRI_MOV],120))) AS FECHA_PRI_MOV
      ,LTRIM(RTRIM(CONVERT (NVARCHAR(10),[ID_NOM_PRO_PRI_MOV]))) AS ID_NOM_PRO_PRI_MOV
      ,LTRIM(RTRIM(CONVERT (NVARCHAR(50),[NOM_PRO_PRI_MOV]))) AS NOM_PRO_PRI_MOV
      ,LTRIM(RTRIM(CONVERT (nvarchar,[FECHA_ULT_MOV],120))) AS FECHA_ULT_MOV
      ,LTRIM(RTRIM(CONVERT (NVARCHAR(10),[ID_NOM_PRO_ULT_MOV]))) AS ID_NOM_PRO_ULT_MOV
      ,LTRIM(RTRIM(CONVERT (NVARCHAR(50),[NOM_PRO_ULT_MOV]))) AS NOM_PRO_ULT_MOV
      ,LTRIM(RTRIM(CONVERT (NVARCHAR(50),[ENTREGA_VERIFICADA]))) AS ENTREGA_VERIFICADA
      ,LTRIM(RTRIM(CONVERT (NVARCHAR(50),[PRUEBA_ENTREGA]))) AS PRUEBA_ENTREGA
      ,LTRIM(RTRIM(CONVERT (NVARCHAR(50),[ID_PREFACTURA]))) AS ID_PREFACTURA
      ,LTRIM(RTRIM(CONVERT (NVARCHAR(10),[DIAS_INGRESO_VS_ENTREGA]))) AS DIAS_INGRESO_VS_ENTREGA
      ,LTRIM(RTRIM(CONVERT (NVARCHAR(10),[ROWID]))) AS ROWID
  FROM [dbo].[GUIAS_TEMU_PREFA_PE] (NOLOCK)






