        <DTS:Executable
          DTS:refId="Package\PASO 02\UPDATE ULT PRIM PROCESO LOG"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{96FFE672-F338-4D22-8816-21D54EB1E6A0}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="UPDATE ULT PRIM PROCESO LOG"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{ADA34A20-5D8B-4623-BEFE-CAC6158A0757}"
              SQLTask:SqlStatementSource="&#xA;--------------------------&#x9;&#x9;primer proceso log&#xA;;WITH CTE AS(&#xA;SELECT  ---TOP 100&#xA;ROW_NUMBER() OVER(PARTITION BY G.NUMERO_GUIA ORDER BY SEG.FECHA_HORA_MOVIMIENTO ASC) AS #ROWID,&#xA;G.NUMERO_GUIA,&#xA;SEG.FECHA_HORA_MOVIMIENTO AS FECHA_PRI_MOV,&#x9;&#xA;SEG.ID_PROCESO AS ID_NOM_PRO_PRI_MOV,&#x9;&#xA;PRO.NOMBRE_PROCESO_LOG AS NOM_PRO_PRI_MOV&#x9;&#xA;from [dbo].[GUIAS_TEMU_PREFA_DG_TMP5] G WITH(NOLOCK)&#xA;LEFT JOIN MECE_LOGISTICO.DBO.SEGUIMIENTO_ENVIO SEG (NOLOCK) &#xA;ON G.NUMERO_GUIA = SEG.NUMERO_GUIA ---AND SEG.FECHA_HORA_MOVIMIENTO =&#xA;LEFT JOIN PARAMETROS.DBO.PROCESOS PRO (NOLOCK) &#xA;ON PRO.ID_PROCESO = SEG.ID_PROCESO&#xA;where SEG.ID_PROCESO &gt;= 5&#xA;)&#xA;UPDATE TMP SET &#xA;TMP.FECHA_PRI_MOV=CT.FECHA_PRI_MOV,&#xA;TMP.ID_NOM_PRO_PRI_MOV=CT.ID_NOM_PRO_PRI_MOV,&#xA;TMP.NOM_PRO_PRI_MOV=CT.NOM_PRO_PRI_MOV&#xA;FROM CTE CT&#xA;INNER JOIN [dbo].[GUIAS_TEMU_PREFA_DG_TMP5] TMP ON TMP.NUMERO_GUIA=CT.NUMERO_GUIA&#xA;WHERE CT.#ROWID=1&#xA;&#xA;&#xA;&#xA;&#xA;--------------------------&#x9;&#x9;ultimo proceso log&#xA;;WITH CTE AS(&#xA;SELECT  ---TOP 100&#xA;ROW_NUMBER() OVER(PARTITION BY G.NUMERO_GUIA ORDER BY SEG.FECHA_HORA_MOVIMIENTO DESC) AS #ROWID,&#xA;G.NUMERO_GUIA,&#xA;SEG.FECHA_HORA_MOVIMIENTO AS FECHA_ULT_MOV,&#x9;&#xA;SEG.ID_PROCESO AS ID_NOM_PRO_ULT_MOV,&#x9;&#xA;PRO.NOMBRE_PROCESO_LOG AS NOM_PRO_ULT_MOV&#x9;&#xA;from [dbo].[GUIAS_TEMU_PREFA_DG_TMP5] G WITH(NOLOCK)&#xA;LEFT JOIN MECE_LOGISTICO.DBO.SEGUIMIENTO_ENVIO SEG (NOLOCK) &#xA;ON G.NUMERO_GUIA = SEG.NUMERO_GUIA ---AND SEG.FECHA_HORA_MOVIMIENTO =&#xA;LEFT JOIN PARAMETROS.DBO.PROCESOS PRO (NOLOCK) &#xA;ON PRO.ID_PROCESO = SEG.ID_PROCESO&#xA;where SEG.ID_PROCESO &gt;= 5&#xA;)&#xA;UPDATE TMP SET &#xA;TMP.FECHA_ULT_MOV=CT.FECHA_ULT_MOV,&#xA;TMP.ID_NOM_PRO_ULT_MOV=CT.ID_NOM_PRO_ULT_MOV,&#xA;TMP.NOM_PRO_ULT_MOV=CT.NOM_PRO_ULT_MOV&#xA;FROM CTE CT&#xA;INNER JOIN [dbo].[GUIAS_TEMU_PREFA_DG_TMP5] TMP ON TMP.NUMERO_GUIA=CT.NUMERO_GUIA&#xA;WHERE CT.#ROWID=1&#xA;&#xA;&#xA;/*&#xA;Column_name&#xA;NUMERO_GUIA&#xA;FECHA_ENVIO_PREFA&#xA;DESCRIPCION&#xA;PESO_FACTURADO&#xA;CIUDAD_ORIGEN&#xA;CIUDAD_DESTINO&#xA;NOMBRE_TIPOTRAY&#xA;ID_PREFACTURA&#xA;Fec_Envio&#xA;Num_PesoTotal&#xA;CIUDAD_ORIGEN_SISCLINET&#xA;CIUDAD_DESTINO_SISCLINET&#xA;NOMBRE_TIPO_TRAEYCTO_SISCLINET&#xA;Des_VlrCampoPersonalizado1&#xA;Des_DiceContener&#xA;FECHA_PRI_MOV&#xA;ID_NOM_PRO_PRI_MOV&#xA;NOM_PRO_PRI_MOV&#xA;CIUDAD_ORIGEN_DG&#xA;CIUDAD_DESTINO_DG&#xA;NOMBRE_ESTADOENVIO&#xA;FECHA_ENTREGA&#xA;FECHA_ULT_MOV&#xA;ID_NOM_PRO_ULT_MOV&#xA;NOM_PRO_ULT_MOV&#xA;ENTREGA_VERIFICADA&#xA;FECHA_PREFACTURA&#xA;VALOR_LIQUIDADO&#xA;&#xA;&#xA;*/&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
      </DTS:Executables>
