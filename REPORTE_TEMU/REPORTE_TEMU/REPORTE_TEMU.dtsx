            <SQLTask:SqlTaskData
              SQLTask:Connection="{3C10566C-5BB5-4AAF-90CA-5E3EF5B186EF}"
              SQLTask:SqlStatementSource="drop table if exists #sert_envio_TEMP&#xA;select &#xA;&#x9;se.[Ide_Envio]&#xA;      ,se.[Est_Estado]&#xA;      ,se.[Est_Cancelacion]&#xA;      ,se.[Num_Guia]&#xA;      ,se.[Num_Sobreporte]&#xA;      ,se.[Fec_Creacion]&#xA;      ,se.[Fec_CambioEstado]&#xA;      ,se.[Fec_TiempoEntrega]&#xA;      ,se.[Fec_ImpresionEnvio]&#xA;      ,se.[Doc_Relacionado]&#xA;      ,se.[Num_Piezas]&#xA;      ,se.[Des_TipoTrayecto]&#xA;      ,se.[Ide_Producto]&#xA;      ,se.[Ide_Destinatarios]&#xA;      ,se.[Ide_CodFacturacion]&#xA;      ,se.[Ide_Manifiesto]&#xA;      ,se.[Des_FormaPago]&#xA;      ,se.[Des_MedioTransporte]&#xA;      ,se.[Num_PesoTotal]&#xA;      ,se.[Num_ValorDeclaradoTotal]&#xA;      ,se.[Num_VolumenTotal]&#xA;      ,se.[Num_BolsaSeguridad]&#xA;      ,se.[Num_Precinto]&#xA;      ,se.[Des_Agente]&#xA;      ,se.[Des_TipoDuracionTrayecto]&#xA;      ,se.[Des_Telefono]&#xA;      ,se.[Des_Ciudad]&#xA;      ,se.[Des_Direccion]&#xA;      ,se.[Nom_Contacto]&#xA;      ,se.[Ide_SistemaCliente]&#xA;      ,se.[Des_VlrCampoPersonalizado1]&#xA;      ,se.[Des_VlrCampoPersonalizado2]&#xA;      ,se.[Num_ValorLiquidado]&#xA;      ,se.[Des_DiceContener]&#xA;      ,se.[Des_TipoGuia]&#xA;      ,se.[Est_Trazabilidad]&#xA;      ,se.[Des_OperadorLogistico]&#xA;      ,se.[Des_GuiaOperadorLogistico]&#xA;      ,se.[Id_Zonificacion]&#xA;      ,se.[Des_CiudadRemitente]&#xA;      ,se.[Des_OtraCiudad]&#xA;      ,se.[Num_VlrSobreflete]&#xA;      ,se.[Num_VlrFlete]&#xA;      ,se.[Num_Descuento]&#xA;      ,se.[Fec_Actualizacion]&#xA;      ,se.[Des_SIA]&#xA;      ,se.[Des_DireccionRecogida]&#xA;      ,se.[Des_TelefonoRecogida]&#xA;      ,se.[Des_CiudadRecogida]&#xA;      ,se.[Des_CodigoPostal]&#xA;      ,se.[idePaisOrigen]&#xA;      ,se.[idePaisDestino]&#xA;      ,se.[Des_IdArchivoOrigen]&#xA;      ,se.[Num_SincRastreo]&#xA;      ,se.[Ide_Num_Identific_Dest]&#xA;      ,se.[Ide_Num_Referencia_Dest]&#xA;      ,se.[Nom_Empresa_Dest]&#xA;      ,se.[Ide_Login]&#xA;      ,se.[Des_DireccionRemitente]&#xA;      ,se.[Est_Reimpresion]&#xA;      ,se.[Num_Intentos]&#xA;      ,se.[Num_PesoFacturado]&#xA;      ,se.[Nom_TipoTrayecto]&#xA;      ,se.[Est_CanalMayorista]&#xA;      ,se.[Nom_Remitente]&#xA;      ,se.[Num_IdentiRemitente]&#xA;      ,se.[Num_TelefonoRemitente]&#xA;      ,se.[Num_Recaudo]&#xA;      ,se.[Num_Factura]&#xA;      ,se.[Des_CorreoElectronico]&#xA;      ,se.[Num_Celular]&#xA;      ,se.[Ide_Transmitido]&#xA;      ,se.[Fec_Transmision]&#xA;      ,se.[Id_ArchivoCargar]&#xA;      ,se.[Fec_EntregaProg]&#xA;      ,se.[Cod_Azteca]&#xA;      ,se.[Cod_Barras]&#xA;      ,se.[Pre_Cerrado]&#xA;      ,se.[Est_EnviarCorreo]&#xA;      ,se.[Aplicacion]&#xA;      ,se.[VALOR_RECAUDAR_PRODUCTO]&#xA;      ,se.[NUMERO_CODIGO_EFECTY]&#xA;      ,se.[Fec_Envio]&#xA;      ,se.[Num_SobreCajaPorte]&#xA;      ,se.[Rem_CodigoPostal]&#xA;      ,se.[ID_CANAL_DISTRIBUCION]&#xA;      ,se.[ID_CASILLERO_POSTAL]&#xA;      ,se.[ID_CAUSAL_ANULACION]&#xA;      ,se.[Retorno_Digital]&#xA;      ,se.[Nom_Remitente_X_Quien_Preguntar]&#xA;      ,se.[Num_Celular_Remitente]&#xA;      ,se.[Correo_Remitente]&#xA;      ,se.[pago_datafono]&#xA;      ,se.[Num_ValorDeclaradoTotalOriginal]&#xA;      ,se.[Codigos_Zona]&#xA;      ,se.[Id_formato_impresion]&#xA;      ,se.[Id_formato_reimpresion]&#xA;      ,se.[fecha_reimpresion]&#xA;      ,se.[IdImpresionAplicacion]&#xA;      ,se.[IdImpresionAplicacionReimpresion]&#xA;      ,se.[DireccionNormalizadaRemitente]&#xA;      ,se.[InfoAdicionalDireccionRemitente]&#xA;      ,se.[DireccionRemitenteGeo]&#xA;      ,se.[DireccionNormalizadaDestinatario]&#xA;      ,se.[InfoAdicionalDireccionDestinatario]&#xA;      ,se.[DireccionDestinatarioGeo]&#xA;      ,se.[EntregaEnOficina]&#xA;INTO #sert_envio_TEMP&#xA;from [Tmp_Borrar]..GUIAS_TEMU_PREFA_PRE_CARGA t (nolock)&#xA;inner join SISCliNet.DBO.sert_envio se (nolock) on t.NUMERO_GUIA = se.Num_Guia&#xA;&#xA;INSERT INTO #sert_envio_TEMP&#xA;select&#xA;[Ide_Envio]&#xA;      ,seh.[Est_Estado]&#xA;      ,seh.[Est_Cancelacion]&#xA;      ,seh.[Num_Guia]&#xA;      ,seh.[Num_Sobreporte]&#xA;      ,seh.[Fec_Creacion]&#xA;      ,seh.[Fec_CambioEstado]&#xA;      ,seh.[Fec_TiempoEntrega]&#xA;      ,seh.[Fec_ImpresionEnvio]&#xA;      ,seh.[Doc_Relacionado]&#xA;      ,seh.[Num_Piezas]&#xA;      ,seh.[Des_TipoTrayecto]&#xA;      ,seh.[Ide_Producto]&#xA;      ,seh.[Ide_Destinatarios]&#xA;      ,seh.[Ide_CodFacturacion]&#xA;      ,seh.[Ide_Manifiesto]&#xA;      ,seh.[Des_FormaPago]&#xA;      ,seh.[Des_MedioTransporte]&#xA;      ,seh.[Num_PesoTotal]&#xA;      ,seh.[Num_ValorDeclaradoTotal]&#xA;      ,seh.[Num_VolumenTotal]&#xA;      ,seh.[Num_BolsaSeguridad]&#xA;      ,seh.[Num_Precinto]&#xA;      ,seh.[Des_Agente]&#xA;      ,seh.[Des_TipoDuracionTrayecto]&#xA;      ,seh.[Des_Telefono]&#xA;      ,seh.[Des_Ciudad]&#xA;      ,seh.[Des_Direccion]&#xA;      ,seh.[Nom_Contacto]&#xA;      ,seh.[Ide_SistemaCliente]&#xA;      ,seh.[Des_VlrCampoPersonalizado1]&#xA;      ,seh.[Des_VlrCampoPersonalizado2]&#xA;      ,seh.[Num_ValorLiquidado]&#xA;      ,seh.[Des_DiceContener]&#xA;      ,seh.[Des_TipoGuia]&#xA;      ,seh.[Est_Trazabilidad]&#xA;      ,seh.[Des_OperadorLogistico]&#xA;      ,seh.[Des_GuiaOperadorLogistico]&#xA;      ,seh.[Id_Zonificacion]&#xA;      ,seh.[Des_CiudadRemitente]&#xA;      ,seh.[Des_OtraCiudad]&#xA;      ,seh.[Num_VlrSobreflete]&#xA;      ,seh.[Num_VlrFlete]&#xA;      ,seh.[Num_Descuento]&#xA;      ,seh.[Fec_Actualizacion]&#xA;      ,seh.[Des_SIA]&#xA;      ,seh.[Des_DireccionRecogida]&#xA;      ,seh.[Des_TelefonoRecogida]&#xA;      ,seh.[Des_CiudadRecogida]&#xA;      ,seh.[Des_CodigoPostal]&#xA;      ,seh.[idePaisOrigen]&#xA;      ,seh.[idePaisDestino]&#xA;      ,seh.[Des_IdArchivoOrigen]&#xA;      ,seh.[Num_SincRastreo]&#xA;      ,seh.[Ide_Num_Identific_Dest]&#xA;      ,seh.[Ide_Num_Referencia_Dest]&#xA;      ,seh.[Nom_Empresa_Dest]&#xA;      ,seh.[Ide_Login]&#xA;      ,seh.[Des_DireccionRemitente]&#xA;      ,seh.[Est_Reimpresion]&#xA;      ,seh.[Num_Intentos]&#xA;      ,seh.[Num_PesoFacturado]&#xA;      ,seh.[Nom_TipoTrayecto]&#xA;      ,seh.[Est_CanalMayorista]&#xA;      ,seh.[Nom_Remitente]&#xA;      ,seh.[Num_IdentiRemitente]&#xA;      ,seh.[Num_TelefonoRemitente]&#xA;      ,seh.[Num_Recaudo]&#xA;      ,seh.[Num_Factura]&#xA;      ,seh.[Des_CorreoElectronico]&#xA;      ,seh.[Num_Celular]&#xA;      ,seh.[Ide_Transmitido]&#xA;      ,seh.[Fec_Transmision]&#xA;      ,seh.[Id_ArchivoCargar]&#xA;      ,seh.[Fec_EntregaProg]&#xA;      ,seh.[Cod_Azteca]&#xA;      ,seh.[Cod_Barras]&#xA;      ,seh.[Pre_Cerrado]&#xA;      ,seh.[Est_EnviarCorreo]&#xA;      ,seh.[Aplicacion]&#xA;      ,seh.[VALOR_RECAUDAR_PRODUCTO]&#xA;      ,seh.[NUMERO_CODIGO_EFECTY]&#xA;      ,seh.[Fec_Envio]&#xA;      ,seh.[Num_SobreCajaPorte]&#xA;      ,seh.[Rem_CodigoPostal]&#xA;      ,seh.[ID_CANAL_DISTRIBUCION]&#xA;      ,seh.[ID_CASILLERO_POSTAL]&#xA;      ,seh.[ID_CAUSAL_ANULACION]&#xA;      ,seh.[Retorno_Digital]&#xA;      ,seh.[Nom_Remitente_X_Quien_Preguntar]&#xA;      ,seh.[Num_Celular_Remitente]&#xA;      ,seh.[Correo_Remitente]&#xA;      ,seh.[pago_datafono]&#xA;      ,seh.[Num_ValorDeclaradoTotalOriginal]&#xA;      ,seh.[Codigos_Zona]&#xA;      ,seh.[Id_formato_impresion]&#xA;      ,seh.[Id_formato_reimpresion]&#xA;      ,seh.[fecha_reimpresion]&#xA;      ,seh.[IdImpresionAplicacion]&#xA;      ,seh.[IdImpresionAplicacionReimpresion]&#xA;      ,seh.[DireccionNormalizadaRemitente]&#xA;      ,seh.[InfoAdicionalDireccionRemitente]&#xA;      ,seh.[DireccionRemitenteGeo]&#xA;      ,seh.[DireccionNormalizadaDestinatario]&#xA;      ,seh.[InfoAdicionalDireccionDestinatario]&#xA;      ,seh.[DireccionDestinatarioGeo]&#xA;      ,seh.[EntregaEnOficina]&#xA;from [Tmp_Borrar]..GUIAS_TEMU_PREFA_PRE_CARGA t (nolock)&#xA;inner join SISCliNet_Historico.DBO.sert_envio seH (nolock) on t.NUMERO_GUIA = seh.Num_Guia&#xA;&#xA;TRUNCATE TABLE [dbo].[GUIAS_TEMU_PREFA_SISCLINET]&#xA;&#xA;INSERT INTO [dbo].[GUIAS_TEMU_PREFA_SISCLINET]&#xA;           ([NUMERO_GUIA]&#xA;           ,[FECHA_ENVIO_PREFA]&#xA;           ,[DESCRIPCION]&#xA;           ,[PESO_FACTURADO]&#xA;           ,[CIUDAD_ORIGEN]&#xA;           ,[CIUDAD_DESTINO]&#xA;           ,[NOMBRE_TIPOTRAY]&#xA;           ,[ID_PREFACTURA]&#xA;           ,[FECHA_PREFACTURA]&#xA;           ,[VALOR_LIQUIDADO]&#xA;           ,[Fec_Envio]&#xA;           ,[Num_PesoTotal]&#xA;           ,[CIUDAD_ORIGEN_SISCLINET]&#xA;           ,[CIUDAD_DESTINO_SISCLINET]&#xA;           ,[NOMBRE_TIPO_TRAEYCTO_SISCLINET]&#xA;           ,[Des_VlrCampoPersonalizado1]&#xA;           ,[Des_DiceContener])&#xA;select &#xA;t.*,&#xA;Fec_Envio = SE.Fec_Envio,&#xA;Num_PesoTotal = ISNULL(SE.Num_PesoTotal,0),&#xA;CIUDAD_ORIGEN_SISCLINET = CO.NOMBRE_CIUDAD ,&#xA;CIUDAD_DESTINO_SISCLINET = CD.NOMBRE_CIUDAD,&#xA;NOMBRE_TIPO_TRAEYCTO_SISCLINET = SE.Nom_TipoTrayecto,&#xA;Des_VlrCampoPersonalizado1 = SE.Des_VlrCampoPersonalizado1,&#xA;Des_DiceContener = SE.Des_DiceContener&#xA;from [Tmp_Borrar]..GUIAS_TEMU_PREFA_PRE_CARGA t (nolock)&#xA;LEFT join #sert_envio_TEMP se (nolock) on t.NUMERO_GUIA = se.Num_Guia&#xA;LEFT JOIN PARAMETROS.DBO.CIUDADES CO (NOLOCK) ON SE.Des_CiudadRemitente = CO.ID_CIUDAD AND CO.ID_PAIS = 1&#xA;LEFT JOIN PARAMETROS.DBO.CIUDADES CD (NOLOCK) ON SE.Des_Ciudad = CD.ID_CIUDAD AND CD.ID_PAIS = 1&#xA;--where se.Num_Guia is null" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
