      <DTS:Executables>
        <DTS:Executable
          DTS:refId="Package\PASO 02\CARGA_REPORTE"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{174D234F-B98A-49EC-A060-7039F52EAD63}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="CARGA_REPORTE"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{67C58F1D-39B2-4E40-A0AC-6CEEDCA32D82}"
              SQLTask:SqlStatementSource="TRUNCATE TABLE [dbo].[GUIAS_TEMU_PREFA_PE];&#xA;INSERT INTO [dbo].[GUIAS_TEMU_PREFA_PE]           &#xA;([NUMERO_GUIA]&#xA;,[FECHA_ENVIO_PREFA]&#xA;,[DESCRIPCION]&#xA;,[PESO_FACTURADO]&#xA;,[CIUDAD_ORIGEN]&#xA;,[CIUDAD_DESTINO]&#xA;,[NOMBRE_TIPOTRAY]&#xA;,[Fec_Envio]&#xA;,[Num_PesoTotal]&#xA;,[CIUDAD_ORIGEN_SISCLINET]&#xA;,[CIUDAD_DESTINO_SISCLINET]&#xA;,[NOMBRE_TIPO_TRAEYCTO_SISCLINET]&#xA;,[Des_VlrCampoPersonalizado1]&#xA;,[Des_DiceContener]   &#xA;,[FECHA_PREFACTURA] -- NUEVA COLUMNA&#xA;,[AÑO_FEC_PREF] -- NUEVA COLUMNA&#xA;,[MES_FEC_PREF] -- NUEVA COLUMNA&#xA;,[VALOR_LIQUIDADO] -- NUEVA COLUMNA&#xA;,[CIUDAD_ORIGEN_DG]&#xA;,[CIUDAD_DESTINO_DG]&#xA;,[NOMBRE_ESTADOENVIO]&#xA;,[FECHA_ENTREGA]&#xA;,[FECHA_PRI_MOV]  &#xA;,[AÑO_PRI_MOV] -- NUEVA COLUMNA&#xA;,[MES_PRI_MOV] -- NUEVA COLUMNA&#xA;,[ID_NOM_PRO_PRI_MOV]&#xA;,[NOM_PRO_PRI_MOV]&#xA;,[FECHA_ULT_MOV]&#xA;,[AÑO_ULT_MOV] -- NUEVA COLUMNA&#xA;,[MES_ULT_MOV] -- NUEVA COLUMNA&#xA;,[ID_NOM_PRO_ULT_MOV]&#xA;,[NOM_PRO_ULT_MOV]&#xA;,[ENTREGA_VERIFICADA]&#xA;,[PRUEBA_ENTREGA]&#xA;,[ID_PREFACTURA]&#xA;,[DIAS_INGRESO_VS_ENTREGA]&#xA;,[ROWID])&#xA;&#xA;select&#xA;    t.NUMERO_GUIA,&#xA;    FECHA_ENVIO_PREFA,&#xA;    dbo.LimpiarEspacios(LTRIM(RTRIM([DESCRIPCION]))) AS DESCRIPCION,&#xA;    PESO_FACTURADO,&#xA;    CIUDAD_ORIGEN,&#xA;    CIUDAD_DESTINO,&#xA;    NOMBRE_TIPOTRAY,&#xA;    Fec_Envio,&#xA;    Num_PesoTotal,&#xA;    CIUDAD_ORIGEN_SISCLINET,&#xA;    CIUDAD_DESTINO_SISCLINET,&#xA;    NOMBRE_TIPO_TRAEYCTO_SISCLINET,&#xA;    Des_VlrCampoPersonalizado1,&#xA;    Des_DiceContener,&#xA;    FECHA_PREFACTURA, -- NUEVA COLUMNA&#xA;    YEAR(FECHA_PREFACTURA) AS AÑO_FEC_PREF,-- NUEVA COLUMNA&#xA;    UPPER(FORMAT(FECHA_PREFACTURA, 'MMMM', 'es-ES')) AS MES_FEC_PREF,-- NUEVA COLUMNA&#xA;    CONVERT(INT, VALOR_LIQUIDADO) AS VALOR_LIQUIDADO,  -- NUEVA COLUMNA&#xA;    CIUDAD_ORIGEN_DG,&#xA;    CIUDAD_DESTINO_DG,&#xA;    NOMBRE_ESTADOENVIO,&#xA;    FECHA_ENTREGA,&#xA;    FECHA_PRI_MOV,&#xA;    YEAR(FECHA_PRI_MOV) AS AÑO_PRI_MOV, -- NUEVA COLUMNA&#xA;    UPPER(FORMAT(FECHA_PRI_MOV, 'MMMM', 'es-ES')) AS MES_PRI_MOV, -- NUEVA COLUMNA&#xA;    ID_NOM_PRO_PRI_MOV,&#xA;    NOM_PRO_PRI_MOV,&#xA;    FECHA_ULT_MOV,&#xA;    YEAR(FECHA_ULT_MOV) AS AÑO_ULT_MOV, -- NUEVA COLUMNA&#xA;    UPPER(FORMAT(FECHA_ULT_MOV, 'MMMM', 'es-ES')) AS MES_ULT_MOV, -- NUEVA COLUMNA&#xA;    ID_NOM_PRO_ULT_MOV,&#xA;    NOM_PRO_ULT_MOV,&#xA;    ENTREGA_VERIFICADA,&#xA;    case when pe.numero_guia is null then 'NO' else 'SI' end PRUEBA_ENTREGA,&#xA;    ID_PREFACTURA,&#xA;    IIF(ID_NOM_PRO_ULT_MOV = 11, DATEDIFF(DAY, FECHA_PRI_MOV, FECHA_ULT_MOV), NULL) AS DIAS_INGRESO_VS_ENTREGA,&#xA;    ROW_NUMBER() OVER (PARTITION BY t.NUMERO_GUIA ORDER BY FECHA_ENVIO_PREFA DESC) AS ROWID&#xA;    -- Nuevas columnas derivadas de FECHA_PRI_MOV:&#xA;from tmp_borrar.dbo.GUIAS_TEMU_PREFA_DG_TMP5 t (NOLOCK)&#xA;left join Pruebas_Entrega_Nacional.dbo.PRUEBAS_ENTREGA pe (NOLOCK)&#xA;     on t.numero_guia = pe.numero_guia;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
