        <DTS:Executable
          DTS:refId="Package\PASO 01\PASO_1_TABLA_3_DG"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{C635D087-8DE6-4780-8611-E0807B69D5EF}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="PASO_1_TABLA_3_DG"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{ADA34A20-5D8B-4623-BEFE-CAC6158A0757}"
              SQLTask:SqlStatementSource="INSERT INTO [dbo].[GUIAS_TEMU_PREFA_DG_TMP3]&#xA;           ([NUMERO_GUIA]&#xA;           ,[FECHA_ENVIO_PREFA]&#xA;           ,[DESCRIPCION]&#xA;           ,[PESO_FACTURADO]&#xA;           ,[CIUDAD_ORIGEN]&#xA;           ,[CIUDAD_DESTINO]&#xA;           ,[NOMBRE_TIPOTRAY]&#xA;           ,[ID_PREFACTURA]&#xA;           ,[Fec_Envio]&#xA;           ,[Num_PesoTotal]&#xA;           ,[CIUDAD_ORIGEN_SISCLINET]&#xA;           ,[CIUDAD_DESTINO_SISCLINET]&#xA;           ,[NOMBRE_TIPO_TRAEYCTO_SISCLINET]&#xA;           ,[Des_VlrCampoPersonalizado1]&#xA;           ,[Des_DiceContener]&#xA;           ,[FECHA_PREFACTURA]&#xA;           ,[VALOR_LIQUIDADO]&#xA;           ,[FECHA_PRI_MOV]&#xA;           ,[ID_NOM_PRO_PRI_MOV]&#xA;           ,[NOM_PRO_PRI_MOV]&#xA;           ,[CIUDAD_ORIGEN_DG]&#xA;           ,[CIUDAD_DESTINO_DG]&#xA;           ,[NOMBRE_ESTADOENVIO]&#xA;           ,[FECHA_ENTREGA])&#xA;select G.*,&#xA;SE.FECHA_HORA_MOVIMIENTO AS FECHA_PRI_MOV,  &#xA;SE.ID_PROCESO AS ID_NOM_PRO_PRI_MOV,&#xA;PRO.NOMBRE_PROCESO_LOG AS NOM_PRO_PRI_MOV,&#xA;CO.NOMBRE_CIUDAD AS CIUDAD_ORIGEN_DG,&#xA;CD.NOMBRE_CIUDAD AS CIUDAD_DESTINO_DG,&#xA;EE.NOMBRE_ESTADOENVIO,&#xA;GI.FECHA_ENTREGA&#xA;--into tmp_borrar_local.DBO.GUIAS_TEMU_PREFA_DG_TMP3&#xA;from tmp_borrar_local.DBO.GUIAS_TEMU_PREFA_SISCLINET G (nolock)&#xA;INNER JOIN MECE_LOGISTICO.DBO.GUIAS GI (NOLOCK) ON G.NUMERO_GUIA = GI.NUMERO_GUIA&#xA;LEFT JOIN PARAMETROS.DBO.CIUDADES CO (NOLOCK) ON GI.ID_CIUDAD_ORIGEN = CO.ID_CIUDAD AND CO.ID_PAIS = 1&#xA;LEFT JOIN PARAMETROS.DBO.CIUDADES CD (NOLOCK) ON GI.ID_CIUDAD_DESTINO = CD.ID_CIUDAD AND CD.ID_PAIS = 1&#xA;LEFT JOIN MECE_LOGISTICO.DBO.SEGUIMIENTO_ENVIO SE (NOLOCK) ON G.NUMERO_GUIA = SE.NUMERO_GUIA AND SE.ID_PROCESO NOT IN (21,29) AND FECHA_HORA_MOVIMIENTO = (&#xA;&#x9;&#x9;SELECT TOP 1 FECHA_HORA_MOVIMIENTO AS FECHA_HORA_MOVIMIENTO FROM MECE_LOGISTICO.DBO.SEGUIMIENTO_ENVIO SE1 (NOLOCK) WHERE SE.NUMERO_GUIA = SE1.NUMERO_GUIA&#xA;&#x9;&#x9;AND SE1.ID_PROCESO NOT IN (21,29) --IN (6,14)&#xA;&#x9;&#x9;ORDER BY SE1.FECHA_HORA_MOVIMIENTO ASC&#xA;&#x9;&#x9;)&#xA;LEFT JOIN PARAMETROS.DBO.ESTADOSENVIO EE (NOLOCK) ON GI.ID_ESTADOENVIO = EE.ID_ESTADOENVIO&#xA;INNER JOIN PARAMETROS.DBO.PROCESOS PRO (NOLOCK) ON PRO.ID_PROCESO = SE.ID_PROCESO&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
