        <DTS:Executable
          DTS:refId="Package\ENVIO CORREOS\LISTAR CORRESPO POR TIPO CC"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{204cfe97-ab76-4a3a-b604-84e7863a3254}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="LISTAR CORRESPO POR TIPO CC"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{C603132E-CF4F-4614-AF2E-DBEA5C39426F}"
              SQLTask:SqlStatementSource="&#xA;&#xA;USE SIG_COLOMBIA_DW;&#xA;DECLARE @COUNTER_ALL INT = (SELECT MAX(PK) FROM PAR.ENVIO_CORREO_REPORTES_VARIOS);&#xA;DECLARE @COUNT_SET INT = 0;&#xA;DECLARE @USUARIOS_BCCLINE VARCHAR(MAX);&#xA;DECLARE @USUARIOS_FINAL_BCCLINE VARCHAR(MAX);&#xA;&#xA;DECLARE @USUARIOS_CCLINE VARCHAR(MAX);&#xA;DECLARE @USUARIOS_FINAL_CCLINE VARCHAR(MAX);&#xA;&#xA;DECLARE @USUARIOS_TOLINE VARCHAR(MAX);&#xA;DECLARE @USUARIOS_FINAL_TOLINE VARCHAR(MAX);&#xA;&#xA;&#xA;&#xA;----SELECT EMAIL FROM @TABLA_ANALISTAS_ENVIO_CORREO WHERE ESTADO_FAC_PDTE_TEMU = 1&#xA;&#xA;WHILE @COUNT_SET&lt;=@COUNTER_ALL&#xA; BEGIN &#xA; SET @COUNT_SET = @COUNT_SET + 1&#xA;&#xA;  SET @USUARIOS_BCCLINE = (SELECT EMAIL FROM PAR.ENVIO_CORREO_REPORTES_VARIOS WHERE ESTADO_FAC_PDTE_TEMU = 1 AND TIPO_ENVIO_FAC_PDTE_TEMU = 'BCCLINE' AND PK=@COUNT_SET);&#xA;  IF LEN(@USUARIOS_BCCLINE)&gt;1   &#xA;    SET @USUARIOS_FINAL_BCCLINE = CONCAT(@USUARIOS_BCCLINE,';',@USUARIOS_FINAL_BCCLINE)&#xA;&#xA;  SET @USUARIOS_CCLINE = (SELECT EMAIL FROM PAR.ENVIO_CORREO_REPORTES_VARIOS WHERE ESTADO_FAC_PDTE_TEMU = 1 AND TIPO_ENVIO_FAC_PDTE_TEMU = 'CCLINE' AND PK=@COUNT_SET);&#xA;  IF LEN(@USUARIOS_CCLINE)&gt;1   &#xA;    SET @USUARIOS_FINAL_CCLINE = CONCAT(@USUARIOS_CCLINE,';',@USUARIOS_FINAL_CCLINE)&#xA; &#xA;  SET @USUARIOS_TOLINE = (SELECT EMAIL FROM PAR.ENVIO_CORREO_REPORTES_VARIOS WHERE ESTADO_FAC_PDTE_TEMU = 1 AND TIPO_ENVIO_FAC_PDTE_TEMU = 'TOLINE' AND PK=@COUNT_SET);&#xA;  IF LEN(@USUARIOS_TOLINE)&gt;1   &#xA;    SET @USUARIOS_FINAL_TOLINE = CONCAT(@USUARIOS_TOLINE,';',@USUARIOS_FINAL_TOLINE)&#xA; &#xA; &#xA; END&#xA;&#xA;DROP TABLE IF EXISTS #TABLA_USUARIOS;&#xA;CREATE TABLE #TABLA_USUARIOS(USUARIOS_BCCLINE VARCHAR(8000),USUARIOS_CCLINE VARCHAR(8000),USUARIOS_TOLINE VARCHAR(8000))&#xA;INSERT INTO #TABLA_USUARIOS&#xA;SELECT top 1  ISNULL(CONVERT(VARCHAR(8000),@USUARIOS_FINAL_BCCLINE), '') AS USUARIOS_BCCLINE,&#xA;ISNULL(CONVERT(VARCHAR(8000),@USUARIOS_FINAL_CCLINE), '') AS USUARIOS_CCLINE, &#xA;ISNULL(CONVERT(VARCHAR(8000),@USUARIOS_FINAL_TOLINE), '') AS USUARIOS_TOLINE&#xA;&#xA;DROP TABLE IF EXISTS #TABLA_USUARIOS_2;&#xA;CREATE TABLE #TABLA_USUARIOS_2(USUARIOS_BCCLINE VARCHAR(8000),USUARIOS_CCLINE VARCHAR(8000),USUARIOS_TOLINE VARCHAR(8000))&#xA;INSERT INTO #TABLA_USUARIOS_2&#xA;SELECT &#xA; USUARIOS_BCCLINE=LEFT(USUARIOS_BCCLINE,LEN(USUARIOS_BCCLINE)-1)&#x9;&#xA;,USUARIOS_CCLINE=LEFT(USUARIOS_CCLINE,LEN(USUARIOS_CCLINE)-1)&#x9;&#xA;,USUARIOS_TOLINE=LEFT(USUARIOS_TOLINE,LEN(USUARIOS_TOLINE)-1)&#xA;FROM #TABLA_USUARIOS&#xA;&#xA;SELECT TOP 1&#xA; USUARIOS_BCCLINE&#xA;,USUARIOS_CCLINE&#xA;,USUARIOS_TOLINE&#xA;FROM #TABLA_USUARIOS_2&#xA;"
              SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
              <SQLTask:ResultBinding
                SQLTask:ResultName="USUARIOS_BCCLINE"
                SQLTask:DtsVariableName="User::USUARIOS_BCCLINE" />
              <SQLTask:ResultBinding
                SQLTask:ResultName="USUARIOS_CCLINE"
                SQLTask:DtsVariableName="User::USUARIOS_CCLINE" />
              <SQLTask:ResultBinding
                SQLTask:ResultName="USUARIOS_TOLINE"
                SQLTask:DtsVariableName="User::USUARIOS_TOLINE" />
            </SQLTask:SqlTaskData>
          </DTS:ObjectData>
        </DTS:Executable>
