          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{67C58F1D-39B2-4E40-A0AC-6CEEDCA32D82}"
              SQLTask:SqlStatementSource="TRUNCATE TABLE tmp_borrar.DBO.GUIAS_TEMU_PREFA_DG_TMP5&#xA;TRUNCATE TABLE tmp_borrar.dbo.GUIAS_TEMU_PREFA_PE" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
