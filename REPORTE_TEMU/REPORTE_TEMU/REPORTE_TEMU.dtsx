        <DTS:Executable
          DTS:refId="Package\PASO 02\PASO_2_TABLA_4_DG"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{DBFCA845-B21C-424E-919D-AC1B3E2F4C32}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="PASO_2_TABLA_4_DG"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{ADA34A20-5D8B-4623-BEFE-CAC6158A0757}"
              SQLTask:SqlStatementSource="&#xA;&#xA;----------------------------------------------------------------------------------&#xA;DROP TABLE IF EXISTS #tmp_borrar_local_DBO_GUIAS_TEMU_PREFA_DG_TMP3;&#xA;;with cte_PR_MOV as(&#xA;SELECT  ---TOP 100&#xA;ROW_NUMBER() OVER(PARTITION BY TMPGUI.NUMERO_GUIA ORDER BY SEG.FECHA_HORA_MOVIMIENTO ASC) AS #ROWID&#xA;,TMPGUI.NUMERO_GUIA&#xA;,TMPGUI.FECHA_ENVIO_PREFA&#xA;,TMPGUI.DESCRIPCION&#xA;,TMPGUI.PESO_FACTURADO&#xA;,TMPGUI.CIUDAD_ORIGEN&#xA;,TMPGUI.CIUDAD_DESTINO&#xA;,TMPGUI.NOMBRE_TIPOTRAY&#xA;,TMPGUI.ID_PREFACTURA&#xA;,TMPGUI.Fec_Envio&#xA;,TMPGUI.Num_PesoTotal&#xA;,TMPGUI.CIUDAD_ORIGEN_SISCLINET&#xA;,TMPGUI.CIUDAD_DESTINO_SISCLINET&#xA;,TMPGUI.NOMBRE_TIPO_TRAEYCTO_SISCLINET&#xA;,TMPGUI.Des_VlrCampoPersonalizado1&#xA;,TMPGUI.Des_DiceContener&#xA;,TMPGUI.FECHA_PRI_MOV&#xA;,ID_NOM_PRO_PRI_MOV = SEG.ID_PROCESO&#xA;,NOM_PRO_PRI_MOV = PR.NOMBRE_PROCESO_LOG&#xA;,TMPGUI.CIUDAD_ORIGEN_DG&#xA;,TMPGUI.CIUDAD_DESTINO_DG&#xA;,TMPGUI.NOMBRE_ESTADOENVIO&#xA;,TMPGUI.FECHA_ENTREGA&#xA;--,TMPGUI.FECHA_ULT_MOV&#xA;--,TMPGUI.ID_NOM_PRO_ULT_MOV&#xA;--,TMPGUI.NOM_PRO_ULT_MOV&#xA;,TMPGUI.FECHA_PREFACTURA&#xA;,TMPGUI.VALOR_LIQUIDADO&#xA;FROM tmp_borrar_local.DBO.GUIAS_TEMU_PREFA_DG_TMP3 TMPGUI (NOLOCK)&#xA;LEFT JOIN MECE_LOGISTICO.DBO.SEGUIMIENTO_ENVIO SEG (NOLOCK) &#xA;ON SEG.NUMERO_GUIA = TMPGUI.NUMERO_GUIA&#xA;LEFT JOIN PARAMETROS..PROCESOS PR WITH(NOLOCK) ON SEG.ID_PROCESO=PR.ID_PROCESO&#xA;----where SEG.ID_PROCESO &gt;= 5&#xA;--and SEG.NUMERO_GUIA=2274902767&#xA;)&#xA;select &#xA;NUMERO_GUIA&#xA;,FECHA_ENVIO_PREFA&#xA;,DESCRIPCION&#xA;,PESO_FACTURADO&#xA;,CIUDAD_ORIGEN&#xA;,CIUDAD_DESTINO&#xA;,NOMBRE_TIPOTRAY&#xA;,ID_PREFACTURA&#xA;,Fec_Envio&#xA;,Num_PesoTotal&#xA;,CIUDAD_ORIGEN_SISCLINET&#xA;,CIUDAD_DESTINO_SISCLINET&#xA;,NOMBRE_TIPO_TRAEYCTO_SISCLINET&#xA;,Des_VlrCampoPersonalizado1&#xA;,Des_DiceContener&#xA;,FECHA_PRI_MOV&#xA;,ID_NOM_PRO_PRI_MOV &#xA;,NOM_PRO_PRI_MOV &#xA;,CIUDAD_ORIGEN_DG&#xA;,CIUDAD_DESTINO_DG&#xA;,NOMBRE_ESTADOENVIO&#xA;,FECHA_ENTREGA&#xA;--,FECHA_ULT_MOV&#xA;--,ID_NOM_PRO_ULT_MOV&#xA;--,NOM_PRO_ULT_MOV&#xA;,FECHA_PREFACTURA&#xA;,VALOR_LIQUIDADO&#xA;INTO #tmp_borrar_local_DBO_GUIAS_TEMU_PREFA_DG_TMP3&#xA;FROM cte_PR_MOV where #ROWID=1&#xA;&#xA;&#xA;&#xA;TRUNCATE TABLE [dbo].[GUIAS_TEMU_PREFA_DG_TMP4];&#xA;WITH CTE AS (&#xA;SELECT  ---TOP 100&#xA;ROW_NUMBER() OVER(PARTITION BY G.NUMERO_GUIA ORDER BY SEG.FECHA_HORA_MOVIMIENTO DESC) AS #ROWID,&#xA;G.* ,&#xA;SEG.FECHA_HORA_MOVIMIENTO AS FECHA_ULT_MOV,  &#xA;SEG.ID_PROCESO AS ID_NOM_PRO_ULT_MOV,&#xA;PRO.NOMBRE_PROCESO_LOG AS NOM_PRO_ULT_MOV&#xA;from #tmp_borrar_local_DBO_GUIAS_TEMU_PREFA_DG_TMP3 G&#xA;--tmp_borrar_local.DBO.GUIAS_TEMU_PREFA_DG_TMP3 G&#xA;LEFT JOIN MECE_LOGISTICO.DBO.SEGUIMIENTO_ENVIO SEG (NOLOCK) &#xA;ON G.NUMERO_GUIA = SEG.NUMERO_GUIA ---AND SEG.FECHA_HORA_MOVIMIENTO =&#xA;LEFT JOIN PARAMETROS.DBO.PROCESOS PRO (NOLOCK) &#xA;ON PRO.ID_PROCESO = SEG.ID_PROCESO&#xA;----where SEG.ID_PROCESO &gt;= 5&#xA;&#xA;)&#xA;INSERT INTO [dbo].[GUIAS_TEMU_PREFA_DG_TMP4]&#xA;           ([NUMERO_GUIA]&#xA;           ,[FECHA_ENVIO_PREFA]&#xA;           ,[DESCRIPCION]&#xA;           ,[PESO_FACTURADO]&#xA;           ,[CIUDAD_ORIGEN]&#xA;           ,[CIUDAD_DESTINO]&#xA;           ,[NOMBRE_TIPOTRAY]&#xA;           ,[ID_PREFACTURA]&#xA;           ,[Fec_Envio]&#xA;           ,[Num_PesoTotal]&#xA;           ,[CIUDAD_ORIGEN_SISCLINET]&#xA;           ,[CIUDAD_DESTINO_SISCLINET]&#xA;           ,[NOMBRE_TIPO_TRAEYCTO_SISCLINET]&#xA;           ,[Des_VlrCampoPersonalizado1]&#xA;           ,[Des_DiceContener]&#xA;           ,[FECHA_PREFACTURA]&#xA;           ,[VALOR_LIQUIDADO]&#xA;           ,[FECHA_PRI_MOV]&#xA;           ,[ID_NOM_PRO_PRI_MOV]&#xA;           ,[NOM_PRO_PRI_MOV]&#xA;           ,[CIUDAD_ORIGEN_DG]&#xA;           ,[CIUDAD_DESTINO_DG]&#xA;           ,[NOMBRE_ESTADOENVIO]&#xA;           ,[FECHA_ENTREGA]&#xA;           ,[FECHA_ULT_MOV]&#xA;           ,[ID_NOM_PRO_ULT_MOV]&#xA;           ,[NOM_PRO_ULT_MOV])&#xA;SELECT &#xA;&#x9;&#x9; NUMERO_GUIA&#x9;&#xA;&#x9;&#x9;,FECHA_ENVIO_PREFA&#x9;&#xA;&#x9;&#x9;,DESCRIPCION&#x9;&#xA;&#x9;&#x9;,PESO_FACTURADO&#x9;&#xA;&#x9;&#x9;,CIUDAD_ORIGEN&#x9;&#xA;&#x9;&#x9;,CIUDAD_DESTINO&#x9;&#xA;&#x9;&#x9;,NOMBRE_TIPOTRAY&#x9;&#xA;&#x9;&#x9;,ID_PREFACTURA&#x9;&#xA;&#x9;&#x9;,Fec_Envio&#x9;&#xA;&#x9;&#x9;,Num_PesoTotal&#x9;&#xA;&#x9;&#x9;,CIUDAD_ORIGEN_SISCLINET&#x9;&#xA;&#x9;&#x9;,CIUDAD_DESTINO_SISCLINET&#x9;&#xA;&#x9;&#x9;,NOMBRE_TIPO_TRAEYCTO_SISCLINET&#x9;&#xA;&#x9;&#x9;,Des_VlrCampoPersonalizado1&#x9;&#xA;&#x9;&#x9;,Des_DiceContener&#x9;&#xA;&#x9;&#x9;,FECHA_PREFACTURA&#xA;&#x9;&#x9;,VALOR_LIQUIDADO&#xA;&#x9;&#x9;,FECHA_PRI_MOV&#x9;&#xA;&#x9;&#x9;,ID_NOM_PRO_PRI_MOV&#x9;&#xA;&#x9;&#x9;,NOM_PRO_PRI_MOV&#x9;&#xA;&#x9;&#x9;,CIUDAD_ORIGEN_DG&#x9;&#xA;&#x9;&#x9;,CIUDAD_DESTINO_DG&#x9;&#xA;&#x9;&#x9;,NOMBRE_ESTADOENVIO&#x9;&#xA;&#x9;&#x9;,FECHA_ENTREGA&#x9;&#xA;&#x9;&#x9;,FECHA_ULT_MOV&#x9;&#xA;&#x9;&#x9;,ID_NOM_PRO_ULT_MOV&#x9;&#xA;&#x9;&#x9;,NOM_PRO_ULT_MOV&#xA;FROM CTE where #ROWID=1&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;/*&#xA;TRUNCATE TABLE [dbo].[GUIAS_TEMU_PREFA_DG_TMP4];&#xA;WITH CTE AS (&#xA;SELECT  ---TOP 100&#xA;ROW_NUMBER() OVER(PARTITION BY G.NUMERO_GUIA ORDER BY SEG.FECHA_HORA_MOVIMIENTO DESC) AS #ROWID,&#xA;G.* ,&#xA;SEG.FECHA_HORA_MOVIMIENTO AS FECHA_ULT_MOV,  &#xA;SEG.ID_PROCESO AS ID_NOM_PRO_ULT_MOV,&#xA;PRO.NOMBRE_PROCESO_LOG AS NOM_PRO_ULT_MOV&#xA;from tmp_borrar_local.DBO.GUIAS_TEMU_PREFA_DG_TMP3 G&#xA;LEFT JOIN MECE_LOGISTICO.DBO.SEGUIMIENTO_ENVIO SEG (NOLOCK) &#xA;ON G.NUMERO_GUIA = SEG.NUMERO_GUIA ---AND SEG.FECHA_HORA_MOVIMIENTO =&#xA;LEFT JOIN PARAMETROS.DBO.PROCESOS PRO (NOLOCK) &#xA;ON PRO.ID_PROCESO = SEG.ID_PROCESO&#xA;where SEG.ID_PROCESO &gt;= 5&#xA;&#xA;)&#xA;INSERT INTO [dbo].[GUIAS_TEMU_PREFA_DG_TMP4]&#xA;           ([NUMERO_GUIA]&#xA;           ,[FECHA_ENVIO_PREFA]&#xA;           ,[DESCRIPCION]&#xA;           ,[PESO_FACTURADO]&#xA;           ,[CIUDAD_ORIGEN]&#xA;           ,[CIUDAD_DESTINO]&#xA;           ,[NOMBRE_TIPOTRAY]&#xA;           ,[ID_PREFACTURA]&#xA;           ,[Fec_Envio]&#xA;           ,[Num_PesoTotal]&#xA;           ,[CIUDAD_ORIGEN_SISCLINET]&#xA;           ,[CIUDAD_DESTINO_SISCLINET]&#xA;           ,[NOMBRE_TIPO_TRAEYCTO_SISCLINET]&#xA;           ,[Des_VlrCampoPersonalizado1]&#xA;           ,[Des_DiceContener]&#xA;           ,[FECHA_PREFACTURA]&#xA;           ,[VALOR_LIQUIDADO]&#xA;           ,[FECHA_PRI_MOV]&#xA;           ,[ID_NOM_PRO_PRI_MOV]&#xA;           ,[NOM_PRO_PRI_MOV]&#xA;           ,[CIUDAD_ORIGEN_DG]&#xA;           ,[CIUDAD_DESTINO_DG]&#xA;           ,[NOMBRE_ESTADOENVIO]&#xA;           ,[FECHA_ENTREGA]&#xA;           ,[FECHA_ULT_MOV]&#xA;           ,[ID_NOM_PRO_ULT_MOV]&#xA;           ,[NOM_PRO_ULT_MOV])&#xA;SELECT &#xA;&#x9;&#x9; NUMERO_GUIA&#x9;&#xA;&#x9;&#x9;,FECHA_ENVIO_PREFA&#x9;&#xA;&#x9;&#x9;,DESCRIPCION&#x9;&#xA;&#x9;&#x9;,PESO_FACTURADO&#x9;&#xA;&#x9;&#x9;,CIUDAD_ORIGEN&#x9;&#xA;&#x9;&#x9;,CIUDAD_DESTINO&#x9;&#xA;&#x9;&#x9;,NOMBRE_TIPOTRAY&#x9;&#xA;&#x9;&#x9;,ID_PREFACTURA&#x9;&#xA;&#x9;&#x9;,Fec_Envio&#x9;&#xA;&#x9;&#x9;,Num_PesoTotal&#x9;&#xA;&#x9;&#x9;,CIUDAD_ORIGEN_SISCLINET&#x9;&#xA;&#x9;&#x9;,CIUDAD_DESTINO_SISCLINET&#x9;&#xA;&#x9;&#x9;,NOMBRE_TIPO_TRAEYCTO_SISCLINET&#x9;&#xA;&#x9;&#x9;,Des_VlrCampoPersonalizado1&#x9;&#xA;&#x9;&#x9;,Des_DiceContener&#x9;&#xA;&#x9;&#x9;,FECHA_PREFACTURA&#xA;&#x9;&#x9;,VALOR_LIQUIDADO&#xA;&#x9;&#x9;,FECHA_PRI_MOV&#x9;&#xA;&#x9;&#x9;,ID_NOM_PRO_PRI_MOV&#x9;&#xA;&#x9;&#x9;,NOM_PRO_PRI_MOV&#x9;&#xA;&#x9;&#x9;,CIUDAD_ORIGEN_DG&#x9;&#xA;&#x9;&#x9;,CIUDAD_DESTINO_DG&#x9;&#xA;&#x9;&#x9;,NOMBRE_ESTADOENVIO&#x9;&#xA;&#x9;&#x9;,FECHA_ENTREGA&#x9;&#xA;&#x9;&#x9;,FECHA_ULT_MOV&#x9;&#xA;&#x9;&#x9;,ID_NOM_PRO_ULT_MOV&#x9;&#xA;&#x9;&#x9;,NOM_PRO_ULT_MOV&#xA;FROM CTE where #ROWID=1&#xA;&#xA;&#xA;*/" xmlns:SQLTask