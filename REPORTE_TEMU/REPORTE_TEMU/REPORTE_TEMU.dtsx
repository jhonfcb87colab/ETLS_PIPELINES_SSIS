              SQLTask:Connection="{ADA34A20-5D8B-4623-BEFE-CAC6158A0757}"
              SQLTask:SqlStatementSource="TRUNCATE TABLE [dbo].[GUIAS_TEMU_PREFA_DG_TMP5];&#xA;WITH CTE AS (&#xA;SELECT  ---TOP 100&#xA;ROW_NUMBER() OVER(PARTITION BY TMPGUI.NUMERO_GUIA ORDER BY SEG.FECHA_HORA_MOVIMIENTO DESC) AS #ROWID,&#xA;TMPGUI.*,&#xA;CASE WHEN SEG.NUMERO_GUIA IS NOT NULL&#xA;&#x9;THEN 'SI'&#xA;&#x9;ELSE 'NO'&#xA;END AS ENTREGA_VERIFICADA&#xA;FROM tmp_borrar_local.DBO.GUIAS_TEMU_PREFA_DG_TMP4 TMPGUI (NOLOCK)&#xA;LEFT JOIN MECE_LOGISTICO.DBO.SEGUIMIENTO_ENVIO SEG (NOLOCK) &#xA;ON SEG.ID_PROCESO = 11 AND SEG.NUMERO_GUIA = TMPGUI.NUMERO_GUIA&#xA;---where SEG.ID_PROCESO &gt;= 5&#xA;)&#xA;INSERT INTO [dbo].[GUIAS_TEMU_PREFA_DG_TMP5]&#xA;           ([NUMERO_GUIA]&#xA;           ,[FECHA_ENVIO_PREFA]&#xA;           ,[DESCRIPCION]&#xA;           ,[PESO_FACTURADO]&#xA;           ,[CIUDAD_ORIGEN]&#xA;           ,[CIUDAD_DESTINO]&#xA;           ,[NOMBRE_TIPOTRAY]&#xA;           ,[ID_PREFACTURA]&#xA;           ,[Fec_Envio]&#xA;           ,[Num_PesoTotal]&#xA;           ,[CIUDAD_ORIGEN_SISCLINET]&#xA;           ,[CIUDAD_DESTINO_SISCLINET]&#xA;           ,[NOMBRE_TIPO_TRAEYCTO_SISCLINET]&#xA;           ,[Des_VlrCampoPersonalizado1]&#xA;           ,[Des_DiceContener]&#xA;           ,[FECHA_PREFACTURA]&#xA;           ,[VALOR_LIQUIDADO]&#xA;           ,[FECHA_PRI_MOV]&#xA;           ,[ID_NOM_PRO_PRI_MOV]&#xA;           ,[NOM_PRO_PRI_MOV]&#xA;           ,[CIUDAD_ORIGEN_DG]&#xA;           ,[CIUDAD_DESTINO_DG]&#xA;           ,[NOMBRE_ESTADOENVIO]&#xA;           ,[FECHA_ENTREGA]&#xA;           ,[FECHA_ULT_MOV]&#xA;           ,[ID_NOM_PRO_ULT_MOV]&#xA;           ,[NOM_PRO_ULT_MOV]&#xA;           ,[ENTREGA_VERIFICADA])&#xA;SELECT &#xA;&#x9;&#x9; [NUMERO_GUIA]&#xA;&#x9;&#x9;,[FECHA_ENVIO_PREFA]&#xA;&#x9;&#x9;,[DESCRIPCION]&#xA;&#x9;&#x9;,[PESO_FACTURADO]&#xA;&#x9;&#x9;,[CIUDAD_ORIGEN]&#xA;&#x9;&#x9;,[CIUDAD_DESTINO]&#xA;&#x9;&#x9;,[NOMBRE_TIPOTRAY]&#xA;&#x9;&#x9;,[ID_PREFACTURA]&#xA;&#x9;&#x9;,[Fec_Envio]&#xA;&#x9;&#x9;,[Num_PesoTotal]&#xA;&#x9;&#x9;,[CIUDAD_ORIGEN_SISCLINET]&#xA;&#x9;&#x9;,[CIUDAD_DESTINO_SISCLINET]&#xA;&#x9;&#x9;,[NOMBRE_TIPO_TRAEYCTO_SISCLINET]&#xA;&#x9;&#x9;,[Des_VlrCampoPersonalizado1]&#xA;&#x9;&#x9;,[Des_DiceContener]&#xA;&#x9;&#x9;,[FECHA_PREFACTURA]&#xA;&#x9;&#x9;,[VALOR_LIQUIDADO]&#xA;&#x9;&#x9;,[FECHA_PRI_MOV]&#xA;&#x9;&#x9;,[ID_NOM_PRO_PRI_MOV]&#xA;&#x9;&#x9;,[NOM_PRO_PRI_MOV]&#xA;&#x9;&#x9;,[CIUDAD_ORIGEN_DG]&#xA;&#x9;&#x9;,[CIUDAD_DESTINO_DG]&#xA;&#x9;&#x9;,[NOMBRE_ESTADOENVIO]&#xA;&#x9;&#x9;,[FECHA_ENTREGA]&#xA;&#x9;&#x9;,[FECHA_ULT_MOV]&#xA;&#x9;&#x9;,[ID_NOM_PRO_ULT_MOV]&#xA;&#x9;&#x9;,[NOM_PRO_ULT_MOV]&#xA;&#x9;&#x9;,[ENTREGA_VERIFICADA]&#xA;FROM CTE where #ROWID=1" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
