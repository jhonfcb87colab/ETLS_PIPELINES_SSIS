    <DTS:Executable
      DTS:refId="Package\INSERT SIN CARACTER"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{5369863F-025F-4AB4-A5E5-430CFB335878}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="INSERT SIN CARACTER"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{7F7EBB71-E699-425A-A34C-E9372B5D6CB1}"
          SQLTask:SqlStatementSource="INSERT INTO [SIG_FACTURACION_DM].[TMP].[PLANON]&#xA;SELECT &#xA;      &#xA;       CAST(R.[FECHA_TRANSACCION] AS CHAR(10) ) AS [FECHA_TRANSACCION]&#xA;      ,CAST(R.[NUMERO_MANIFIESTO] AS CHAR(20) )AS [NUMERO_MANIFIESTO]&#xA;      ,CAST(R.[CODIGO_MUNICIPIO_ORIGEN] AS CHAR(5) ) AS [CODIGO_MUNICIPIO_ORIGEN]&#xA;      ,CAST(R.[CODIGO_MUNICIPIO_DESTINO] AS CHAR(5) ) AS [CODIGO_MUNICIPIO_DESTINO]&#xA;      ,CAST(T1.[DPLACA] AS CHAR(10) ) AS [PLACA_VEHICULO]&#xA;      ,CAST(R.[TIPO_ID_PROPIETARIO_VEHICULO]  AS CHAR(2) ) /*CAST( ISNULL( [TIPO_ID_PROPIETARIO_VEHICULO], ' ') AS CHAR(2) )*/ AS [TIPO_ID_PROPIETARIO_VEHICULO]&#xA;      ,CAST(R.[ID_PROPIETARIO_VEHICULO] AS CHAR(20)) AS [ID_PROPIETARIO_VEHICULO]&#xA;      ,CAST(T2.[DNOMBRE_PROPIETARIO_VEHICULO] AS CHAR(100)) AS [NOMBRE_PROPIETARIO_VEHICULO]&#xA;      ,CAST(R.[TIPO_ID_TENEDOR_VEHICULO]  AS CHAR(2) ) AS [TIPO_ID_TENEDOR_VEHICULO]&#xA;&#x9;  ,CAST(R.ID_TENEDOR_VEHICULO AS CHAR(20)) AS ID_TENEDOR_VEHICULO&#xA;&#x9;  ,CAST(T3.[DNOMBRE_TENEDOR_VEHICULO] AS CHAR(100)) AS [NOMBRE_TENEDOR_VEHICULO]&#xA;      ,CAST(R.[TIPO_ID_CONDUCTOR_VEHICULO] AS CHAR(2) ) AS [TIPO_ID_CONDUCTOR_VEHICULO]&#xA;&#x9;  ,CAST(R.[ID_CONDUCTOR_VEHICULO] AS CHAR(20)) AS [ID_CONDUCTOR_VEHICULO]&#xA;&#x9;  ,CAST(T4.[DNOMBRE_CONDUCTOR_VEHICULO] AS CHAR(100)) AS [NOMBRE_CONDUCTOR_VEHICULO]&#xA;&#x9;  ,CAST(R.[PLACA_SEMIREMOLQUE] AS CHAR(10) ) AS [PLACA_SEMIREMOLQUE]&#xA;&#x9;  ,CAST(R.[TIPO_ID_PROPIETARIO_SEMIREMOLQUE] AS CHAR(2) ) AS [TIPO_ID_PROPIETARIO_SEMIREMOLQUE]  &#xA;      ,CAST(R.[ID_PROPIETARIO_SEMIREMOLQUE] AS CHAR(20)) AS [ID_PROPIETARIO_SEMIREMOLQUE]&#xA;&#x9;  ,CAST(T5.[DNOMBRE_PROPIETARIO_SEMIREMOLQUE] AS CHAR(100)) AS [NOMBRE_PROPIETARIO_SEMIREMOLQUE]&#xA;&#x9;  ,CAST(T6.[DPRODUCTO_TRANSPORTADO] AS CHAR(100)) AS  [PRODUCTO_TRANSPORTADO]&#xA;&#x9;  ,CAST(R.[TIPO_ID_REMITENTE] AS CHAR(2) ) AS [TIPO_ID_REMITENTE]  &#xA;&#x9;  ,CAST(R.[ID_REMITENTE] AS CHAR(20)) AS [ID_REMITENTE]&#xA;     ,CAST(T7.[DNOMBRE_REMITENTE] AS CHAR(100)) AS  [NOMBRE_REMITENTE]&#xA;&#x9; ,CAST(R.[TIPO_ID_DESTINATARIO] AS CHAR(2) ) AS [TIPO_ID_DESTINATARIO] &#xA;&#x9; ,CAST(R.[ID_DESTINATARIO] AS CHAR(20)) AS [ID_DESTINATARIO] &#xA;&#x9; ,CAST(R.[NOMBRE_DESTINATARIO] AS CHAR(100)) AS  [NOMBRE_DESTINATARIO] &#xA;&#x9; ,CAST(R.[VALOR_TOTAL_VIAJE] AS CHAR(20)) AS [VALOR_TOTAL_VIAJE]  &#xA;&#x9; ,CAST(R.[VALOR_VIAJE_EFECTIVO] AS CHAR(20)) AS [VALOR_VIAJE_EFECTIVO] &#xA;&#x9; ,CAST(R.[OBSERVACIONES] AS CHAR(100)) AS  [OBSERVACIONES]  &#x9; &#xA;FROM&#xA;(&#xA;SELECT * &#xA;&#xA; FROM [FAC].[REF_UIAF]  WITH(NOLOCK) &#xA; WHERE [ID_REPORTE] = ( SELECT MAX( ID_REPORTE ) FROM [SIG_FACTURACION_DM].[FAC].[UIAF] WITH (NOLOCK) )&#xA;-- AND VALOR_TOTAL_VIAJE&gt;0&#xA;) R&#xA; JOIN&#xA;(&#xA;SELECT [dbo].[DEPURAR] ([PLACA_VEHICULO]) AS [DPLACA], [PLACA_VEHICULO] FROM TMP.PLACA WITH(NOLOCK)&#xA;) T1&#xA;ON&#xA;T1.PLACA_VEHICULO =R.PLACA_VEHICULO&#xA;&#xA;JOIN&#xA;(&#xA;SELECT [dbo].[DEPURAR] ([NOMBRE_PROPIETARIO_VEHICULO]) AS [DNOMBRE_PROPIETARIO_VEHICULO], [NOMBRE_PROPIETARIO_VEHICULO] FROM TMP.PROPIETARIO_VEHICULO&#xA;)T2&#xA;ON&#xA;T2.NOMBRE_PROPIETARIO_VEHICULO = R.[NOMBRE_PROPIETARIO_VEHICULO]&#xA;&#xA;JOIN&#xA;(&#xA;SELECT [dbo].[DEPURAR] ([NOMBRE_TENEDOR_VEHICULO]) AS [DNOMBRE_TENEDOR_VEHICULO], [NOMBRE_TENEDOR_VEHICULO] FROM TMP.TENEDOR_VEHICULO&#xA;)T3&#xA;ON&#xA;T3.[NOMBRE_TENEDOR_VEHICULO] =R.[NOMBRE_TENEDOR_VEHICULO]&#xA;&#xA;JOIN&#xA;(&#xA;SELECT [dbo].[DEPURAR] ([NOMBRE_CONDUCTOR_VEHICULO]) AS [DNOMBRE_CONDUCTOR_VEHICULO], [NOMBRE_CONDUCTOR_VEHICULO] FROM TMP.CONDUCTOR_VEHICULO&#xA;)T4&#xA;ON&#xA;T4.[NOMBRE_CONDUCTOR_VEHICULO] = R.[NOMBRE_CONDUCTOR_VEHICULO]&#xA;&#xA;JOIN&#xA;(&#xA;SELECT [dbo].[DEPURAR] ([NOMBRE_PROPIETARIO_SEMIREMOLQUE]) AS [DNOMBRE_PROPIETARIO_SEMIREMOLQUE], [NOMBRE_PROPIETARIO_SEMIREMOLQUE] FROM TMP.PROPIETARIO_SEMIREMOLQUE&#xA;)T5&#xA;ON&#xA;T5.[NOMBRE_PROPIETARIO_SEMIREMOLQUE] = R.[NOMBRE_PROPIETARIO_SEMIREMOLQUE]&#xA;&#xA;JOIN&#xA;(&#xA;SELECT [dbo].[DEPURAR] ([PRODUCTO_TRANSPORTADO]) AS [DPRODUCTO_TRANSPORTADO], [PRODUCTO_TRANSPORTADO] FROM TMP.PRODUCTO_TRANSPORTADO&#xA;)T6&#xA;ON&#xA;T6.[PRODUCTO_TRANSPORTADO] = R.[PRODUCTO_TRANSPORTADO]&#xA;LEFT JOIN&#xA;(&#xA;SELECT [dbo].[DEPURAR] ([NOMBRE_REMITENTE]) AS [DNOMBRE_REMITENTE], [NOMBRE_REMITENTE] FROM TMP.REMITENTE&#xA;)T7&#xA;ON&#xA;T7.[NOMBRE_REMITENTE] = R.[NOMBRE_REMITENTE]&#xA;/*&#xA;LEFT JOIN&#xA;(&#xA;SELECT [dbo].[DEPURAR] ([NOMBRE_DESTINATARIO]) AS [DNOMBRE_DESTINATARIO], [NOMBRE_DESTINATARIO] FROM TMP.DESTINATARIO &#xA;)T8&#xA;ON&#xA;T8.[NOMBRE_DESTINATARIO] = R.[NOMBRE_DESTINATARIO]*/&#xA;/* WHERE R.[ID_REPORTE] = 10&#xA; AND R.VALOR_TOTAL_VIAJE&gt;0&#xA; ORDER BY 1 ASC*/" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
