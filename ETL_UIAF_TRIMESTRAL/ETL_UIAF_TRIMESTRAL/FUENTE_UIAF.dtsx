    <DTS:Executable
      DTS:refId="Package\PROCESA CSV"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{9443E080-7133-4C90-985C-BAD04DF9B62C}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="PROCESA CSV"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{7F7EBB71-E699-425A-A34C-E9372B5D6CB1}"
          SQLTask:SqlStatementSource="INSERT INTO [SIG_FACTURACION_DM].[TMP].[UIAF]&#xA;SELECT &#xA;       [FECHA_TRANSACCION]&#xA;      ,[NUMERO_MANIFIESTO]&#xA;      ,[CODIGO_MUNICIPIO_ORIGEN]&#xA;      ,[CODIGO_MUNICIPIO_DESTINO]&#xA;      ,[PLACA_VEHICULO]&#xA;      ,[TIPO_ID_PROPIETARIO_VEHICULO]&#xA;      ,[ID_PROPIETARIO_VEHICULO]&#xA;      ,[NOMBRE_PROPIETARIO_VEHICULO]&#xA;      ,[TIPO_ID_TENEDOR_VEHICULO]&#xA;      ,[ID_TENEDOR_VEHICULO]&#xA;      ,[NOMBRE_TENEDOR_VEHICULO]&#xA;      ,[TIPO_ID_CONDUCTOR_VEHICULO]&#xA;      ,[ID_CONDUCTOR_VEHICULO]&#xA;      ,[NOMBRE_CONDUCTOR_VEHICULO]&#xA;      ,[PLACA_SEMIREMOLQUE]&#xA;      ,[TIPO_ID_PROPIETARIO_SEMIREMOLQUE]&#xA;      ,[ID_PROPIETARIO_SEMIREMOLQUE]&#xA;      ,[NOMBRE_PROPIETARIO_SEMIREMOLQUE]&#xA;      ,[PRODUCTO_TRANSPORTADO]&#xA;      ,[TIPO_ID_REMITENTE]&#xA;      ,[ID_REMITENTE]&#xA;      ,[NOMBRE_REMITENTE]&#xA;      ,[TIPO_ID_DESTINATARIO]&#xA;      ,[ID_DESTINATARIO]&#xA;      ,[NOMBRE_DESTINATARIO]&#xA;      ,[VALOR_TOTAL_VIAJE]&#xA;      ,[VALOR_VIAJE_EFECTIVO]&#xA;      ,[OBSERVACIONES]&#xA;      ,[ID_TIPO_CLIENTE]&#xA;      ,[ID_CLIENTE]&#xA;      ,[NUMERO_GUIA]&#xA;      ,[ID_FECHA_TRANSACCION]&#xA;      ,[ID_PRODUCTO]&#xA;      ,[PRODUCTO]&#xA;      ,? AS ID_REPORTE&#xA;&#x9;  ,'MANUAL' AS ORIGEN&#xA;    FROM [SIG_FACTURACION_DM].[TMP].[UIAF_MANUAL_CSV] WITH(NOLOCK)" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::ID_REPORTE"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="131"
            SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\PROCESA ENVIOS CANAL CORPORATIVO"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{A11B9646-46CB-4DDF-AB19-79E5A6F7DBEF}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="PROCESA ENVIOS CANAL CORPORATIVO"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{6FA04C17-D9C0-4D11-91D6-F4389DC2340A}"
          SQLTask:SqlStatementSource="SELECT  S.NUMERO_GUIA, &#xA;   MAX( S.FECHA_HORA_MOVIMIENTO ) AS FECHA_ULT_SZU,&#xA;   RTRIM( S.NUMERO_MOVIMI ) AS NUMERO_MOVIMI,&#xA;   RTRIM( S.CONSECUT_MOVIMI ) AS CONSECUT_MOVIMI,&#xA;   RTRIM( D.PLACA_VEHICULO_DOCU ) AS PLACA_VEHICULO_DOCU, &#xA;   RTRIM( D.ID_COURIER_CONDUCTOR ) AS ID_COURIER_CONDUCTOR&#xA;INTO  #ULTIMOS_MOV9&#xA;FROM  TMP.UIAF_SEGUIMIENTO_ENVIO S WITH (NOLOCK)&#xA;   LEFT JOIN TMP.UIAF_DOCUMENTOS D WITH (NOLOCK) &#xA;     ON D.NUMERO_MOVIMI = S.NUMERO_MOVIMI AND&#xA;      D.CONSECUT_MOVIMI = S.CONSECUT_MOVIMI AND&#xA;      D.ID_PROCESO = S.ID_PROCESO&#xA;   INNER JOIN TMP.UIAF_GUIAS G WITH (NOLOCK)&#xA;     ON G.NUMERO_GUIA = S.NUMERO_GUIA&#xA;WHERE  S.ID_PROCESO = 9 AND&#xA;--   S.FECHA_HORA_MOVIMIENTO BETWEEN DATEADD( MONTH,DATEDIFF( MONTH, 0, GETDATE() ) - 3, 0 ) AND DATEADD( SECOND, -1, DATEADD( MONTH, DATEDIFF( MONTH, 0, GETDATE() ), 0 ) ) AND&#xA;   G.ID_PRODUCTO NOT IN ( 1, 3, 45, 64, 65, 70, 77 ) AND&#xA;   G.PESO_FISICO_OPERA &gt;= 5 AND&#xA;   G.ID_CLIENTE NOT IN ( '800179612', '860512330', '9912856790', '650325927' ) AND&#xA;   G.ID_CLIENTE IS NOT NULL&#xA;GROUP BY S.NUMERO_GUIA, S.NUMERO_MOVIMI, S.CONSECUT_MOVIMI, D.PLACA_VEHICULO_DOCU, D.ID_COURIER_CONDUCTOR&#xA;ORDER BY S.NUMERO_GUIA ASC&#xA;&#xA;&#xA;SELECT  RTRIM( G.ID_CLIENTE ) AS ID_CLIENTE&#xA;INTO  #CLIENTES&#xA;FROM  PRF.MECE_LOGISTICO_GUIAS G WITH (NOLOCK)&#xA;   INNER JOIN #ULTIMOS_MOV9 U&#xA;     ON U.NUMERO_GUIA = G.NUMERO_GUIA&#xA;GROUP BY G.ID_CLIENTE&#xA;HAVING  SUM( G.VALOR_SEG_MAN_GUIAS + G.VALOR_FLETES_GUIAS - G.VALOR_DESCUENTO_GUIAS ) &gt;= 30000000&#xA;&#xA;&#xA;SELECT  G.NUMERO_GUIA,&#xA;   RTRIM( G.ID_CLIENTE ) AS ID_CLIENTE,&#xA;   RTRIM( G1.NOMBRE_REMITE_GUIA ) + ' ' + RTRIM( G1.APELLIDO_REMITE_GUIA ) AS NOMBRE_REMITE_GUIA,&#xA;   RTRIM( G1.ID_DESTINA ) AS ID_DESTINA,&#xA;   RTRIM( G1.NOMBRE_DESTINA_GUIA ) + ' ' + RTRIM( G1.APELLIDO_DESTINA_GUIA ) AS NOMBRE_DESTINA_GUIA,&#xA;   G.ID_PRODUCTO,&#xA;   G1.CONTENIDO,&#xA;   RTRIM( G.ID_CIUDAD_ORIGEN ) AS ID_CIUDAD_ORIGEN,&#xA;   RTRIM( G.ID_CIUDAD_DESTINO ) AS ID_CIUDAD_DESTINO,&#xA;   G.VALOR_SEG_MAN_GUIAS + G.VALOR_FLETES_GUIAS - G.VALOR_DESCUENTO_GUIAS AS VALOR_FLETES_GUIAS,&#xA;   FP.FORMA_DE_PAGO&#xA;INTO  #GUIAS&#xA;FROM  PRF.MECE_LOGISTICO_GUIAS G&#xA;   INNER JOIN TMP.UIAF_GUIAS G1 WITH (NOLOCK)&#xA;     ON G1.NUMERO_GUIA = G.NUMERO_GUIA&#xA;   LEFT JOIN LOG.GUIAS_INF_ADICIONAL GIA&#xA;     ON GIA.NUMERO_GUIA = G.NUMERO_GUIA&#xA;   LEFT JOIN DIM.FORMADEPAGO FP&#xA;     ON FP.ID_FORMAPAGO = GIA.ID_FORMAPAGO_GUIA&#xA;WHERE  G.ID_CLIENTE IN ( SELECT * FROM #CLIENTES )&#xA;&#xA;&#xA;SELECT  CP.NOMBRE_CATEGPROD,&#xA;   P.ID_PRODUCTO,&#xA;   P.NOMBRE_PRODUCTO&#xA;INTO  #PRODUCTOS&#xA;FROM  PAR.PRODUCTOS P&#xA;   LEFT JOIN PAR.CATEGORIA_PRODUCTO CP&#xA;     ON CP.ID_CATEGPROD = P.ID_CATEGPROD&#xA;&#xA;&#xA;SELECT  ID_CIUDAD,&#xA;   RTRIM( CODIGO_DANE ) AS CODIGO_DANE&#xA;INTO  #GEOGRAFIA&#xA;FROM  PAR.CIUDADES WITH (NOLOCK)&#xA;&#xA;       &#xA;SELECT  RTRIM( V.PLACA_VEHICULO ) AS PLACA_VEHICULO,&#xA;   TV.NOMBRE_TIPO_VEHI,&#xA;   13 AS TIPO_ID_PROPIETARIO_VEHICULO,&#xA;   RTRIM( T.ID_TERCERO ) AS ID_TERCERO,&#xA;   T.NOMBRE_TERCERO,&#xA;   13 AS TIPO_ID_TENEDOR_VEHICULO,&#xA;   RTRIM( ET.ID_EMPRETRANSP ) AS ID_EMPRETRANSP,&#xA;   ET.NOMBRE_EMPRETRANSP&#xA;INTO  #VEHICULOS&#xA;FROM  PAR.VEHICULOS V WITH (NOLOCK)&#xA;   LEFT JOIN PAR.TIPOSVEHICULOS TV WITH (NOLOCK)&#xA;     ON TV.ID_TIPO_VEHI = V.ID_TIPO_VEHI&#xA;   LEFT JOIN PAR.TERCEROS T WITH (NOLOCK)&#xA;     ON T.ID_TERCERO = V.ID_TERCERO&#xA;   LEFT JOIN PAR.EMPRESA_TRANSPORTADORA ET WITH (NOLOCK)&#xA;     ON ET.ID_EMPRETRANSP = V.ID_EMPRETRANSP&#xA;&#xA;&#xA;INSERT INTO SIG_FACTURACION_DM.TMP.UIAF&#xA;SELECT  --ROW_NUMBER() OVER( ORDER BY G.NUMERO_GUIA ASC ) AS CONSECUTIVO,&#xA;   FORMAT( U.FECHA_ULT_SZU, 'yyyy/MM/dd', 'en-US' ) AS FECHA_TRANSACCION,&#xA;   U.NUMERO_MOVIMI AS NUMERO_MANIFIESTO,&#xA;   G1.CODIGO_DANE AS CODIGO_MUNICIPIO_ORIGEN,&#xA;   G2.CODIGO_DANE AS CODIGO_MUNICIPIO_DESTINO,&#xA;   UPPER( U.PLACA_VEHICULO_DOCU ) AS PLACA_VEHICULO,&#xA;   V.TIPO_ID_PROPIETARIO_VEHICULO AS TIPO_ID_PROPIETARIO_VEHICULO,&#xA;   CASE WHEN PU.PLACA_VEHICULO IS NOT NULL THEN PU.ID_PROPIETARIO_VEHICULO ELSE V.ID_TERCERO END AS ID_PROPIETARIO_VEHICULO,&#xA;   CASE WHEN PU.PLACA_VEHICULO IS NOT NULL THEN UPPER(PU.NOMBRE_PROPIETARIO_VEHICULO) ELSE  UPPER( V.NOMBRE_TERCERO ) END AS NOMBRE_PROPIETARIO_VEHICULO, &#xA;   V.TIPO_ID_TENEDOR_VEHICULO AS TIPO_ID_TENEDOR_VEHICULO,&#xA;   V.ID_EMPRETRANSP AS ID_TENEDOR_VEHICULO,&#xA;   UPPER( V.NOMBRE_EMPRETRANSP ) AS NOMBRE_TENEDOR_VEHICULO,&#xA;   13 AS TIPO_ID_CONDUCTOR_VEHICULO,   &#xA;   CASE WHEN PU.PLACA_VEHICULO IS NOT NULL THEN PU.ID_CONDUCTOR_VEHICULO ELSE  U.ID_COURIER_CONDUCTOR END AS ID_CONDUCTOR_VEHICULO,    &#xA;   CASE WHEN PU.PLACA_VEHICULO IS NOT NULL THEN UPPER(PU.NOMBRE_CONDUCTOR_VEHICULO) ELSE  RTRIM(E.NOMBRE_EMPLEADO) + ' ' + RTRIM(E.APELLIDO_EMPLEADO) END AS NOMBRE_CONDUCTOR_VEHICULO,      &#xA;   'NO APLICA' AS PLACA_SEMIREMOLQUE,&#xA;   'NO APLICA' AS TIPO_ID_PROPIETARIO_SEMIREMOLQUE,&#xA;   'NO APLICA' AS ID_PROPIETARIO_SEMIREMOLQUE,&#xA;   'NO APLICA' AS NOMBRE_PROPIETARIO_SEMIREMOLQUE,&#xA;   UPPER( G.CONTENIDO ) AS PRODUCTO_TRANSPORTADO,&#xA;   CASE WHEN CL.[ID_TIPO_IDENTIFIC] = 1 THEN 31 &#xA;   WHEN CL.[ID_TIPO_IDENTIFIC] = 2 THEN 13&#xA;   WHEN CL.[ID_TIPO_IDENTIFIC] = 3 THEN 22&#xA;   WHEN CL.[ID_TIPO_IDENTIFIC] = 4 THEN 12&#xA;   WHEN CL.[ID_TIPO_IDENTIFIC] = 5 THEN 41&#xA;   ELSE 0 END  AS TIPO_ID_REMITENTE,&#xA;   G.ID_CLIENTE AS ID_REMITENTE,&#xA;   UPPER( G.NOMBRE_REMITE_GUIA ) AS NOMBRE_REMITENTE,&#xA;   13 AS TIPO_ID_DESTINATARIO,&#xA;   G.ID_DESTINA AS ID_DESTINATARIO,&#xA;   UPPER( G.NOMBRE_DESTINA_GUIA ) AS NOMBRE_DESTINATARIO,&#xA;   G.VALOR_FLETES_GUIAS AS VALOR_TOTAL_VIAJE,&#xA;   VALOR_VIAJE_EFECTIVO = CASE G.FORMA_DE_PAGO&#xA;          WHEN 'CONTADO' THEN G.VALOR_FLETES_GUIAS&#xA;          ELSE 0&#xA;         END,&#xA;   NULL AS OBSERVACIONES,&#xA;   CASE WHEN CD.[ID_TIPO_IDENTIFIC] = 1 THEN 31 &#xA;   WHEN CD.[ID_TIPO_IDENTIFIC] = 2 THEN 13&#xA;   WHEN CD.[ID_TIPO_IDENTIFIC] = 3 THEN 22&#xA;   WHEN CD.[ID_TIPO_IDENTIFIC] = 4 THEN 12&#xA;   WHEN CD.[ID_TIPO_IDENTIFIC] = 5 THEN 41&#xA;   ELSE 0 END  AS ID_TIPO_CLIENTE,&#xA;   G.ID_CLIENTE,&#xA;   G.NUMERO_GUIA AS NUMERO_GUIA,&#xA;   ( (DATEPART( YEAR, U.FECHA_ULT_SZU ) * 1000000 ) +&#xA;     (DATEPART( MONTH, U.FECHA_ULT_SZU ) * 10000 ) +&#xA;     (DATEPART( DAY, U.FECHA_ULT_SZU ) * 100 ) +&#xA;     (DATEPART( HOUR, U.FECHA_ULT_SZU ) ) ) AS ID_FECHA_TRANSACCION,&#xA;   P.ID_PRODUCTO,&#xA;   P.NOMBRE_PRODUCTO AS PRODUCTO,&#xA;   ? AS ID_REPORTE,&#xA;   'CORPORATIVO' AS ORIGEN&#xA;FROM  #GUIAS G&#xA;   INNER JOIN #ULTIMOS_MOV9 U&#xA;     ON U.NUMERO_GUIA = G.NUMERO_GUIA&#xA;   LEFT JOIN #PRODUCTOS P&#xA;     ON P.ID_PRODUCTO = G.ID_PRODUCTO&#xA;   LEFT JOIN #GEOGRAFIA G1&#xA;     ON G1.ID_CIUDAD = G.ID_CIUDAD_ORIGEN&#xA;   LEFT JOIN #GEOGRAFIA G2&#xA;     ON G2.ID_CIUDAD = ID_CIUDAD_DESTINO&#xA;   LEFT JOIN #VEHICULOS V&#xA;     ON V.PLACA_VEHICULO = U.PLACA_VEHICULO_DOCU&#xA;   LEFT JOIN TMP.PLACAS_UIAF PU WITH(NOLOCK)&#xA;     ON U.PLACA_VEHICULO_DOCU = PU.PLACA_VEHICULO&#xA;   LEFT JOIN PAR.EMPLEADOS E WITH (NOLOCK)&#xA;     ON E.ID_EMPLEADO = U.ID_COURIER_CONDUCTOR&#xA;   LEFT JOIN PAR.CLIENTES CL&#xA;   ON  G.ID_CLIENTE = CL.ID_CLIENTE&#xA;   LEFT JOIN PAR.CLIENTES CD&#xA;   ON  G.ID_CLIENTE = CD.ID_CLIENTE" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::ID_REPORTE"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="131"
            SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\PROCESA ENVIOS CANAL RETAIL"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{90A84C59-0464-4BCA-B5CB-F03369BDBBC5}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="PROCESA ENVIOS CANAL RETAIL"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="1">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{6FA04C17-D9C0-4D11-91D6-F4389DC2340A}"
          SQLTask:SqlStatementSource="SELECT  S.NUMERO_GUIA, &#xA;   MAX( S.FECHA_HORA_MOVIMIENTO ) AS FECHA_ULT_SZU,&#xA;   RTRIM( S.NUMERO_MOVIMI ) AS NUMERO_MOVIMI,&#xA;   RTRIM( S.CONSECUT_MOVIMI ) AS CONSECUT_MOVIMI,&#xA;   RTRIM( D.PLACA_VEHICULO_DOCU ) AS PLACA_VEHICULO_DOCU, &#xA;   RTRIM( D.ID_COURIER_CONDUCTOR ) AS ID_COURIER_CONDUCTOR&#xA;INTO  #ULTIMOS_MOV9&#xA;FROM  TMP.UIAF_SEGUIMIENTO_ENVIO S WITH (NOLOCK)&#xA;   LEFT JOIN TMP.UIAF_DOCUMENTOS D WITH (NOLOCK) &#xA;     ON D.NUMERO_MOVIMI = S.NUMERO_MOVIMI AND&#xA;      D.CONSECUT_MOVIMI = S.CONSECUT_MOVIMI AND&#xA;      D.ID_PROCESO = S.ID_PROCESO&#xA;   INNER JOIN TMP.UIAF_GUIAS G WITH (NOLOCK)&#xA;     ON G.NUMERO_GUIA = S.NUMERO_GUIA&#xA;WHERE  S.ID_PROCESO = 9 AND&#xA;   --S.FECHA_HORA_MOVIMIENTO BETWEEN DATEADD( MONTH,DATEDIFF( MONTH, 0, GETDATE() ) - 3, 0 ) AND DATEADD( SECOND, -1, DATEADD( MONTH, DATEDIFF( MONTH, 0, GETDATE() ), 0 ) ) AND&#xA;   G.ID_PRODUCTO NOT IN ( 1, 3, 45, 64, 65, 70, 77 ) AND&#xA;   G.PESO_FISICO_OPERA &gt;= 5 AND&#xA;   G.ID_CLIENTE IS NULL&#xA;GROUP BY S.NUMERO_GUIA, S.NUMERO_MOVIMI, S.CONSECUT_MOVIMI, D.PLACA_VEHICULO_DOCU, D.ID_COURIER_CONDUCTOR&#xA;ORDER BY S.NUMERO_GUIA ASC&#xA;&#xA;&#xA;SELECT  RTRIM( G.ID_REMITE ) AS ID_CLIENTE&#xA;INTO  #CLIENTES&#xA;FROM  TMP.UIAF_GUIAS G WITH (NOLOCK)&#xA;   INNER JOIN #ULTIMOS_MOV9 U&#xA;     ON U.NUMERO_GUIA = G.NUMERO_GUIA&#xA;GROUP BY G.ID_REMITE&#xA;HAVING  SUM( ABS(G.VALOR_FLETES_GUIAS) ) &gt;= 30000000&#xA;&#xA;&#xA;SELECT  G.NUMERO_GUIA,&#xA;   RTRIM( G.ID_REMITE ) AS ID_CLIENTE,&#xA;   RTRIM( G.NOMBRE_REMITE_GUIA ) + ' ' + RTRIM( G.APELLIDO_REMITE_GUIA ) AS NOMBRE_REMITE_GUIA,&#xA;   RTRIM( G.ID_DESTINA ) AS ID_DESTINA,&#xA;   RTRIM( G.NOMBRE_DESTINA_GUIA ) + ' ' + RTRIM( G.APELLIDO_DESTINA_GUIA ) AS NOMBRE_DESTINA_GUIA,&#xA;   G.ID_PRODUCTO,&#xA;   G.CONTENIDO,&#xA;   RTRIM( G.ID_CIUDAD_ORIGEN ) AS ID_CIUDAD_ORIGEN,&#xA;   RTRIM( G.ID_CIUDAD_DESTINO ) AS ID_CIUDAD_DESTINO,&#xA;   G.VALOR_FLETES_GUIAS,&#xA;   FP.FORMA_DE_PAGO&#xA;INTO  #GUIAS&#xA;FROM  TMP.UIAF_GUIAS G&#xA;   LEFT JOIN LOG.GUIAS_INF_ADICIONAL GIA&#xA;     ON GIA.NUMERO_GUIA = G.NUMERO_GUIA&#xA;   LEFT JOIN DIM.FORMADEPAGO FP&#xA;     ON FP.ID_FORMAPAGO = GIA.ID_FORMAPAGO_GUIA&#xA;WHERE  G.ID_REMITE IN ( SELECT * FROM #CLIENTES )&#xA;&#xA;&#xA;SELECT  CP.NOMBRE_CATEGPROD,&#xA;   P.ID_PRODUCTO,&#xA;   P.NOMBRE_PRODUCTO&#xA;INTO  #PRODUCTOS&#xA;FROM  PAR.PRODUCTOS P&#xA;   LEFT JOIN PAR.CATEGORIA_PRODUCTO CP&#xA;     ON CP.ID_CATEGPROD = P.ID_CATEGPROD&#xA;&#xA;&#xA;SELECT  ID_CIUDAD,&#xA;   RTRIM( CODIGO_DANE ) AS CODIGO_DANE&#xA;INTO  #GEOGRAFIA&#xA;FROM  PAR.CIUDADES WITH (NOLOCK)&#xA;&#xA;       &#xA;SELECT  RTRIM( V.PLACA_VEHICULO ) AS PLACA_VEHICULO,&#xA;   TV.NOMBRE_TIPO_VEHI,&#xA;   13 AS TIPO_ID_PROPIETARIO_VEHICULO,&#xA;   RTRIM( T.ID_TERCERO ) AS ID_TERCERO,&#xA;   T.NOMBRE_TERCERO,&#xA;   13 AS TIPO_ID_TENEDOR_VEHICULO,&#xA;   RTRIM( ET.ID_EMPRETRANSP ) AS ID_EMPRETRANSP,&#xA;   ET.NOMBRE_EMPRETRANSP&#xA;INTO  #VEHICULOS&#xA;FROM  PAR.VEHICULOS V WITH (NOLOCK)&#xA;   LEFT JOIN PAR.TIPOSVEHICULOS TV WITH (NOLOCK)&#xA;     ON TV.ID_TIPO_VEHI = V.ID_TIPO_VEHI&#xA;   LEFT JOIN PAR.TERCEROS T WITH (NOLOCK)&#xA;     ON T.ID_TERCERO = V.ID_TERCERO&#xA;   LEFT JOIN PAR.EMPRESA_TRANSPORTADORA ET WITH (NOLOCK)&#xA;     ON ET.ID_EMPRETRANSP = V.ID_EMPRETRANSP&#xA;&#xA;&#xA;INSERT INTO SIG_FACTURACION_DM.TMP.UIAF&#xA;SELECT  --ROW_NUMBER() OVER( ORDER BY G.NUMERO_GUIA ASC ) AS CONSECUTIVO,&#xA;   FORMAT( U.FECHA_ULT_SZU, 'yyyy/MM/dd', 'en-US' ) AS FECHA_TRANSACCION,&#xA;   U.NUMERO_MOVIMI AS NUMERO_MANIFIESTO,&#xA;   G1.CODIGO_DANE AS CODIGO_MUNICIPIO_ORIGEN,&#xA;   G2.CODIGO_DANE AS CODIGO_MUNICIPIO_DESTINO,&#xA;   UPPER( U.PLACA_VEHICULO_DOCU ) AS PLACA_VEHICULO,&#xA;   V.TIPO_ID_PROPIETARIO_VEHICULO AS TIPO_ID_PROPIETARIO_VEHICULO,&#xA;   CASE WHEN PU.PLACA_VEHICULO IS NOT NULL THEN PU.ID_PROPIETARIO_VEHICULO ELSE V.ID_TERCERO END AS ID_PROPIETARIO_VEHICULO,&#xA;   CASE WHEN PU.PLACA_VEHICULO IS NOT NULL THEN UPPER(PU.NOMBRE_PROPIETARIO_VEHICULO) ELSE  UPPER( V.NOMBRE_TERCERO ) END AS NOMBRE_PROPIETARIO_VEHICULO,   &#xA;   V.TIPO_ID_TENEDOR_VEHICULO AS TIPO_ID_TENEDOR_VEHICULO,&#xA;   V.ID_EMPRETRANSP AS ID_TENEDOR_VEHICULO,&#xA;   UPPER( V.NOMBRE_EMPRETRANSP ) AS NOMBRE_TENEDOR_VEHICULO,&#xA;   13 AS TIPO_ID_CONDUCTOR_VEHICULO,   &#xA;   CASE WHEN PU.PLACA_VEHICULO IS NOT NULL THEN PU.ID_CONDUCTOR_VEHICULO ELSE  U.ID_COURIER_CONDUCTOR END AS ID_CONDUCTOR_VEHICULO,&#xA;   CASE WHEN PU.PLACA_VEHICULO IS NOT NULL THEN UPPER(PU.NOMBRE_CONDUCTOR_VEHICULO) ELSE  RTRIM(E.NOMBRE_EMPLEADO) + ' ' + RTRIM(E.APELLIDO_EMPLEADO) END AS NOMBRE_CONDUCTOR_VEHICULO,      &#xA;   'NO APLICA' AS PLACA_SEMIREMOLQUE,&#xA;   'NO APLICA' AS TIPO_ID_PROPIETARIO_SEMIREMOLQUE,&#xA;   'NO APLICA' AS ID_PROPIETARIO_SEMIREMOLQUE,&#xA;   'NO APLICA' AS NOMBRE_PROPIETARIO_SEMIREMOLQUE,&#xA;   UPPER( G.CONTENIDO ) AS PRODUCTO_TRANSPORTADO,&#xA;   CASE WHEN CL.[ID_TIPO_IDENTIFIC] = 1 THEN 31 &#xA;   WHEN CL.[ID_TIPO_IDENTIFIC] = 2 THEN 13&#xA;   WHEN CL.[ID_TIPO_IDENTIFIC] = 3 THEN 22&#xA;   WHEN CL.[ID_TIPO_IDENTIFIC] = 4 THEN 12&#xA;   WHEN CL.[ID_TIPO_IDENTIFIC] = 5 THEN 41&#xA;   ELSE 0 END  AS TIPO_ID_REMITENTE,&#xA;   G.ID_CLIENTE AS ID_REMITENTE,&#xA;   UPPER( G.NOMBRE_REMITE_GUIA ) AS NOMBRE_REMITENTE,&#xA;   13 AS TIPO_ID_DESTINATARIO,&#xA;   G.ID_DESTINA AS ID_DESTINATARIO,&#xA;   UPPER( G.NOMBRE_DESTINA_GUIA ) AS NOMBRE_DESTINATARIO,&#xA;   G.VALOR_FLETES_GUIAS AS VALOR_TOTAL_VIAJE,&#xA;   VALOR_VIAJE_EFECTIVO = CASE G.FORMA_DE_PAGO&#xA;          WHEN 'CONTADO' THEN G.VALOR_FLETES_GUIAS&#xA;          ELSE 0&#xA;         END,&#xA;   NULL AS OBSERVACIONES,&#xA;   CASE WHEN CD.[ID_TIPO_IDENTIFIC] = 1 THEN 31 &#xA;   WHEN CD.[ID_TIPO_IDENTIFIC] = 2 THEN 13&#xA;   WHEN CD.[ID_TIPO_IDENTIFIC] = 3 THEN 22&#xA;   WHEN CD.[ID_TIPO_IDENTIFIC] = 4 THEN 12&#xA;   WHEN CD.[ID_TIPO_IDENTIFIC] = 5 THEN 41&#xA;   ELSE 0 END  AS ID_TIPO_CLIENTE,&#xA;   G.ID_CLIENTE,&#xA;   G.NUMERO_GUIA AS NUMERO_GUIA,&#xA;   ( (DATEPART( YEAR, U.FECHA_ULT_SZU ) * 1000000 ) +&#xA;     (DATEPART( MONTH, U.FECHA_ULT_SZU ) * 10000 ) +&#xA;     (DATEPART( DAY, U.FECHA_ULT_SZU ) * 100 ) +&#xA;     (DATEPART( HOUR, U.FECHA_ULT_SZU ) ) ) AS ID_FECHA_TRANSACCION,&#xA;   P.ID_PRODUCTO,&#xA;   P.NOMBRE_PRODUCTO AS PRODUCTO,&#xA;   ? AS ID_REPORTE,&#xA;   'SISMILENIO' AS ORIGEN&#xA;   FROM  #GUIAS G&#xA;   INNER JOIN #ULTIMOS_MOV9 U&#xA;     ON U.NUMERO_GUIA = G.NUMERO_GUIA&#xA;   LEFT JOIN #PRODUCTOS P&#xA;     ON P.ID_PRODUCTO = G.ID_PRODUCTO&#xA;   LEFT JOIN #GEOGRAFIA G1&#xA;     ON G1.ID_CIUDAD = G.ID_CIUDAD_ORIGEN&#xA;   LEFT JOIN #GEOGRAFIA G2&#xA;     ON G2.ID_CIUDAD = ID_CIUDAD_DESTINO&#xA;   LEFT JOIN #VEHICULOS V&#xA;     ON V.PLACA_VEHICULO = U.PLACA_VEHICULO_DOCU&#xA;   LEFT JOIN TMP.PLACAS_UIAF PU WITH(NOLOCK)&#xA;     ON U.PLACA_VEHICULO_DOCU = PU.PLACA_VEHICULO&#xA;   LEFT JOIN PAR.EMPLEADOS E WITH (NOLOCK)&#xA;     ON E.ID_EMPLEADO = U.ID_COURIER_CONDUCTOR&#xA;&#x9; LEFT JOIN PAR.CLIENTES CL&#xA;   ON  G.ID_CLIENTE = CL.ID_CLIENTE&#xA;    LEFT JOIN PAR.CLIENTES CD&#xA;   ON  G.ID_CLIENTE = CD.ID_CLIENTE" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::ID_REPORTE"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="131"
            SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
