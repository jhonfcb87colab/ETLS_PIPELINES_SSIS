            <component
              refId="Package\GENERAR ARCHIVO\OLE DB Source"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
              description="OLE DB Source"
              name="OLE DB Source"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT 
       [CONSECUTIVO]
      ,[FECHA_TRANSACCION]
      ,[NUMERO_MANIFIESTO]
      ,[CODIGO_MUNICIPIO_ORIGEN] = case when [CODIGO_MUNICIPIO_ORIGEN] ='27493' then '27086' else [CODIGO_MUNICIPIO_ORIGEN] end
      ,[CODIGO_MUNICIPIO_DESTINO] = case when [CODIGO_MUNICIPIO_DESTINO] ='27493' then '27086' else [CODIGO_MUNICIPIO_DESTINO] end
      ,[PLACA_VEHICULO]
      ,[TIPO_ID_PROPIETARIO_VEHICULO]
	  ,[ID_PROPIETARIO_VEHICULO]
      ,UPPER( REPLACE( CAST( CONCAT( REPLICATE( ' ', 100 - LEN( LTRIM( RTRIM( REPLACE( CASE WHEN [NOMBRE_PROPIETARIO_VEHICULO] IS NULL OR [NOMBRE_PROPIETARIO_VEHICULO] = '' THEN 'SIN DATO' ELSE [NOMBRE_PROPIETARIO_VEHICULO] END, '|', '' ) ) ) ) ), LTRIM( RTRIM( REPLACE( CASE WHEN [NOMBRE_PROPIETARIO_VEHICULO] IS NULL OR [NOMBRE_PROPIETARIO_VEHICULO] = '' THEN 'SIN DATO' ELSE [NOMBRE_PROPIETARIO_VEHICULO] END, '|', '' ) ) ) ) AS CHAR(100) ), CHAR(9), ' ') ) AS [NOMBRE_PROPIETARIO_VEHICULO]
      ,[TIPO_ID_TENEDOR_VEHICULO]
	  ,[ID_TENEDOR_VEHICULO]
	  ,UPPER( REPLACE( CAST( CONCAT( REPLICATE( ' ', 100 - LEN( LTRIM( RTRIM( REPLACE( CASE WHEN [NOMBRE_TENEDOR_VEHICULO] IS NULL OR [NOMBRE_TENEDOR_VEHICULO] = '' THEN 'SIN DATO' ELSE [NOMBRE_TENEDOR_VEHICULO] END, '|', '' ) ) ) ) ), LTRIM( RTRIM( REPLACE( CASE WHEN [NOMBRE_TENEDOR_VEHICULO] IS NULL OR [NOMBRE_TENEDOR_VEHICULO] = '' THEN 'SIN DATO' ELSE [NOMBRE_TENEDOR_VEHICULO] END, '|', '' ) ) ) ) AS CHAR(100) ), CHAR(9), ' ') ) AS [NOMBRE_TENEDOR_VEHICULO]
	  ,[TIPO_ID_CONDUCTOR_VEHICULO]
	  ,[ID_CONDUCTOR_VEHICULO]
      ,UPPER( REPLACE( CAST( CONCAT( REPLICATE( ' ', 100 - LEN( LTRIM( RTRIM( REPLACE( CASE WHEN [NOMBRE_CONDUCTOR_VEHICULO] IS NULL OR [NOMBRE_CONDUCTOR_VEHICULO] = '' THEN 'SIN DATO' ELSE [NOMBRE_CONDUCTOR_VEHICULO] END, '|', '' ) ) ) ) ), LTRIM( RTRIM( REPLACE( CASE WHEN [NOMBRE_CONDUCTOR_VEHICULO] IS NULL OR [NOMBRE_CONDUCTOR_VEHICULO] = '' THEN 'SIN DATO' ELSE [NOMBRE_CONDUCTOR_VEHICULO] END, '|', '' ) ) ) ) AS CHAR(100) ), CHAR(9), ' ') ) AS [NOMBRE_CONDUCTOR_VEHICULO]
	  ,[PLACA_SEMIREMOLQUE]
      ,[TIPO_ID_PROPIETARIO_SEMIREMOLQUE]
	  ,[ID_PROPIETARIO_SEMIREMOLQUE]
	  ,UPPER( REPLACE( CAST( CONCAT( REPLICATE( ' ', 100 - LEN( LTRIM( RTRIM( REPLACE( CASE WHEN [NOMBRE_PROPIETARIO_SEMIREMOLQUE] IS NULL OR [NOMBRE_PROPIETARIO_SEMIREMOLQUE] = '' THEN 'SIN DATO' ELSE [NOMBRE_PROPIETARIO_SEMIREMOLQUE] END, '|', '' ) ) ) ) ), LTRIM( RTRIM( REPLACE( CASE WHEN [NOMBRE_PROPIETARIO_SEMIREMOLQUE] IS NULL OR [NOMBRE_PROPIETARIO_SEMIREMOLQUE] = '' THEN 'SIN DATO' ELSE [NOMBRE_PROPIETARIO_SEMIREMOLQUE] END, '|', '' ) ) ) ) AS CHAR(100) ), CHAR(9), ' ') ) AS [NOMBRE_PROPIETARIO_SEMIREMOLQUE]
	  ,UPPER( REPLACE( CAST( CONCAT( REPLICATE( ' ', 100 - LEN( LTRIM( RTRIM( REPLACE( CASE WHEN [PRODUCTO_TRANSPORTADO] IS NULL OR [PRODUCTO_TRANSPORTADO] = '' THEN 'SIN DATO' ELSE [PRODUCTO_TRANSPORTADO] END, '|', '' ) ) ) ) ), LTRIM( RTRIM( REPLACE( CASE WHEN [PRODUCTO_TRANSPORTADO] IS NULL OR [PRODUCTO_TRANSPORTADO] = '' THEN 'SIN DATO' ELSE [PRODUCTO_TRANSPORTADO] END, '|', '' ) ) ) ) AS CHAR(100) ), CHAR(9), ' ') ) AS [PRODUCTO_TRANSPORTADO]
      , [TIPO_ID_REMITENTE]
      , [ID_REMITENTE]
      ,UPPER( REPLACE( CAST( CONCAT( REPLICATE( ' ', 100 - LEN( LTRIM( RTRIM( REPLACE( CASE WHEN [NOMBRE_REMITENTE] IS NULL OR [NOMBRE_REMITENTE] = '' THEN 'SIN DATO' ELSE [NOMBRE_REMITENTE] END, '|', '' ) ) ) ) ), LTRIM( RTRIM( REPLACE( CASE WHEN [NOMBRE_REMITENTE] IS NULL OR [NOMBRE_REMITENTE] = '' THEN 'SIN DATO' ELSE [NOMBRE_REMITENTE] END, '|', '' ) ) ) ) AS CHAR(100) ), CHAR(9), ' ') ) AS [NOMBRE_REMITENTE]
      , [TIPO_ID_DESTINATARIO]
      , [ID_DESTINATARIO]
      ,UPPER( REPLACE( CAST( CONCAT( REPLICATE( ' ', 100 - LEN( LTRIM( RTRIM( REPLACE( CASE WHEN [NOMBRE_DESTINATARIO] IS NULL OR [NOMBRE_DESTINATARIO] = '' THEN 'SIN DATO' ELSE [NOMBRE_DESTINATARIO] END, '|', '' ) ) ) ) ), LTRIM( RTRIM( REPLACE( CASE WHEN [NOMBRE_DESTINATARIO] IS NULL OR [NOMBRE_DESTINATARIO] = '' THEN 'SIN DATO' ELSE [NOMBRE_DESTINATARIO] END, '|', '' ) ) ) ) AS CHAR(100) ), CHAR(9), ' ') ) AS [NOMBRE_DESTINATARIO]
      , [VALOR_TOTAL_VIAJE]
      , [VALOR_VIAJE_EFECTIVO]
      , [OBSERVACIONES] 
  FROM [TMP].[FUENTE_PLANO] WITH(NOLOCK) ORDER BY [CONSECUTIVOCULTO]

/*
