          SQLTask:SqlStatementSource="SELECT  CASE DATEPART( MONTH, DATEADD( SECOND, -1, DATEADD( MONTH, DATEDIFF( MONTH, 0, GETDATE() ), 0 ) ) ) &#xA;    WHEN 1 THEN CAST( DATEPART( YEAR, DATEADD( SECOND, -1, DATEADD( MONTH,DATEDIFF( MONTH, 0, GETDATE() ) - 3, 0 ) ) ) AS varchar(4) ) + '4'&#xA;    WHEN 2 THEN CAST( DATEPART( YEAR, DATEADD( SECOND, -1, DATEADD( MONTH,DATEDIFF( MONTH, 0, GETDATE() ) - 3, 0 ) ) ) AS varchar(4) ) + '4'&#xA;    WHEN 3 THEN CAST( DATEPART( YEAR, DATEADD( SECOND, -1, DATEADD( MONTH,DATEDIFF( MONTH, 0, GETDATE() )    , 0 ) ) ) AS varchar(4) ) + '1'&#xA;    WHEN 4 THEN CAST( DATEPART( YEAR, DATEADD( SECOND, -1, DATEADD( MONTH,DATEDIFF( MONTH, 0, GETDATE() ) - 3, 0 ) ) ) AS varchar(4) ) + '1'&#xA;    WHEN 5 THEN CAST( DATEPART( YEAR, DATEADD( SECOND, -1, DATEADD( MONTH,DATEDIFF( MONTH, 0, GETDATE() ) - 3, 0 ) ) ) AS varchar(4) ) + '1'&#xA;    WHEN 6 THEN CAST( DATEPART( YEAR, DATEADD( SECOND, -1, DATEADD( MONTH,DATEDIFF( MONTH, 0, GETDATE() ) - 3, 0 ) ) ) AS varchar(4) ) + '2'&#xA;    WHEN 7 THEN CAST( DATEPART( YEAR, DATEADD( SECOND, -1, DATEADD( MONTH,DATEDIFF( MONTH, 0, GETDATE() ) - 3, 0 ) ) ) AS varchar(4) ) + '2'&#xA;    WHEN 8 THEN CAST( DATEPART( YEAR, DATEADD( SECOND, -1, DATEADD( MONTH,DATEDIFF( MONTH, 0, GETDATE() ) - 3, 0 ) ) ) AS varchar(4) ) + '2'&#xA;    WHEN 9 THEN CAST( DATEPART( YEAR, DATEADD( SECOND, -1, DATEADD( MONTH,DATEDIFF( MONTH, 0, GETDATE() ) - 3, 0 ) ) ) AS varchar(4) ) + '3'&#xA;    WHEN 10 THEN CAST( DATEPART( YEAR, DATEADD( SECOND, -1, DATEADD( MONTH,DATEDIFF( MONTH, 0, GETDATE() ) - 3, 0 ) ) ) AS varchar(4) ) + '3'&#xA;    WHEN 11 THEN CAST( DATEPART( YEAR, DATEADD( SECOND, -1, DATEADD( MONTH,DATEDIFF( MONTH, 0, GETDATE() ) - 3, 0 ) ) ) AS varchar(4) ) + '3'&#xA;    WHEN 12 THEN CAST( DATEPART( YEAR, DATEADD( SECOND, -1, DATEADD( MONTH,DATEDIFF( MONTH, 0, GETDATE() ) - 3, 0 ) ) ) AS varchar(4) ) + '4'&#xA;   END AS TRIMESTRE"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="0"
            SQLTask:DtsVariableName="User::TRIMESTRE" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
