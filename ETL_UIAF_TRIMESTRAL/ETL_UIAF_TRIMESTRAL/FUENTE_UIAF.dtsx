      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{7F7EBB71-E699-425A-A34C-E9372B5D6CB1}"
          SQLTask:SqlStatementSource="INSERT INTO [SIG_FACTURACION_DM].[TMP].[FUENTE_PLANO]&#xA;SELECT right('         ' + CAST('0'  AS varchar(10)), 10 ) AS CONSECUTIVO, CAST(? AS CHAR(9) ) as CODIGO_ENTIDAD,MAX(FECHA_TRANSACCION) as FECHA_CORTE,right('         ' + CAST(COUNT(CONSECUTIVO)  AS varchar(10)), 10 ) as TOTAL,( '') AS CARACTER&#xA;,'' AS [PLACA_VEHICULO]&#xA;,'' AS [TIPO_ID_PROPIETARIO_VEHICULO]&#xA;,'' AS [ID_PROPIETARIO_VEHICULO] &#xA;,'' AS [NOMBRE_PROPIETARIO_VEHICULO]&#xA;,'' AS [TIPO_ID_TENEDOR_VEHICULO]&#xA;,'' AS [ID_TENEDOR_VEHICULO]&#xA;,'' AS [NOMBRE_TENEDOR_VEHICULO]&#xA;,'' AS [TIPO_ID_CONDUCTOR_VEHICULO]&#xA;,'' AS [ID_CONDUCTOR_VEHICULO]&#xA;,'' AS [NOMBRE_CONDUCTOR_VEHICULO]&#xA;,'' AS [PLACA_SEMIREMOLQUE]&#xA;,'' AS [TIPO_ID_PROPIETARIO_SEMIREMOLQUE]&#xA;,'' AS [ID_PROPIETARIO_SEMIREMOLQUE]&#xA;,'' AS [NOMBRE_PROPIETARIO_SEMIREMOLQUE]&#xA;,'' AS [PRODUCTO_TRANSPORTADO]&#xA;,'' AS [TIPO_ID_REMITENTE]&#xA;,'' AS [ID_REMITENTE]&#xA;,'' AS [NOMBRE_REMITENTE]&#xA;,'' AS [TIPO_ID_DESTINATARIO]&#xA;,'' AS [ID_DESTINATARIO]&#xA;,'' AS [NOMBRE_DESTINATARIO]&#xA;,'' AS [VALOR_TOTAL_VIAJE]&#xA;,'' AS [VALOR_VIAJE_EFECTIVO]&#xA;,'' AS [OBSERVACIONES] FROM TMP.PLANON WITH(NOLOCK)&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="$Project::intCodigoEntidad"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
