                  refId="Package\Lista Errados\OLE DB Source.Connections[OleDbConnection]"
                  connectionManagerID="{81f05ae2-27ac-4f79-8cc5-871b537378dc}:external"
                  connectionManagerRefId="Project.ConnectionManagers[SERV-DBI01 SSISDB]"
                  description="The OLE DB runtime connection used to access the database."
                  name="OleDbConnection" />
              </connections>
              <outputs>
                <output
                  refId="Package\Lista Errados\OLE DB Source.Outputs[OLE DB Source Output]"
                  name="OLE DB Source Output">
                  <outputColumns>
                    <outputColumn
                      refId="Package\Lista Errados\OLE DB Source.Outputs[OLE DB Source Output].Columns[message]"
                      dataType="nText"
                      errorOrTruncationOperation="Conversion"
                      errorRowDisposition="FailComponent"
                      externalMetadataColumnId="Package\Lista Errados\OLE DB Source.Outputs[OLE DB Source Output].ExternalColumns[message]"
                      lineageId="Package\Lista Errados\OLE DB Source.Outputs[OLE DB Source Output].Columns[message]"
                      name="message"
                      truncationRowDisposition="FailComponent" />
