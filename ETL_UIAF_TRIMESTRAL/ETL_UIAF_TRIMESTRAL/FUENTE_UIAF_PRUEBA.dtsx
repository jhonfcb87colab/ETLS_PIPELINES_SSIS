            <component
              refId="Package\INSERT FAC_UIAF\OLE DB Source"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
              description="OLE DB Source"
              name="OLE DB Source"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT 
  [CONSECUTIVO]
, CONVERT( DATE, C.[FECHA_TRANSACCION], 120 ) AS [FECHA_TRANSACCION]
      ,RIGHT( C.[NUMERO_MANIFIESTO], 20 ) AS [NUMERO_MANIFIESTO]
      ,ISNULL( LEFT( C.[CODIGO_MUNICIPIO_ORIGEN], 5 ), '00000' ) AS [CODIGO_MUNICIPIO_ORIGEN]
      ,ISNULL( LEFT( C.[CODIGO_MUNICIPIO_DESTINO], 5 ), '00000' ) AS [CODIGO_MUNICIPIO_DESTINO]
      ,CONCAT( REPLICATE( ' ', 10 - LEN( REPLACE( CASE WHEN C.[PLACA_VEHICULO] IS NULL OR C.[PLACA_VEHICULO] = '' THEN 'SINDATO' ELSE C.[PLACA_VEHICULO] END, ' ', '' ) ) ), REPLACE( CASE WHEN C.[PLACA_VEHICULO] IS NULL OR C.[PLACA_VEHICULO] = '' THEN 'SINDATO' ELSE C.[PLACA_VEHICULO] END, ' ', '' )) AS [PLACA_VEHICULO]
      ,CASE WHEN C.[TIPO_ID_PROPIETARIO_VEHICULO] IS NULL OR C.[TIPO_ID_PROPIETARIO_VEHICULO] = ' ' OR C.[TIPO_ID_PROPIETARIO_VEHICULO] = '  ' THEN '0 ' ELSE C.[TIPO_ID_PROPIETARIO_VEHICULO] END AS [TIPO_ID_PROPIETARIO_VEHICULO]
      ,CONCAT( REPLICATE( ' ', 20 - LEN(	CASE ISNUMERIC( LTRIM( RTRIM( C.[ID_PROPIETARIO_VEHICULO] ) ) )
											WHEN 1 THEN CASE 
															WHEN LEN( LTRIM( RTRIM( C.[ID_PROPIETARIO_VEHICULO] ) ) ) &gt; 4 THEN REPLACE( C.[ID_PROPIETARIO_VEHICULO],' ', '')
															ELSE '111111'
														END
												WHEN 0 THEN '111111'
											END ) ), 
					CASE ISNUMERIC( LTRIM( RTRIM( C.[ID_PROPIETARIO_VEHICULO] ) ) )
												WHEN 1 THEN CASE 
																WHEN LEN( LTRIM( RTRIM( C.[ID_PROPIETARIO_VEHICULO] ) ) ) &gt; 4 THEN REPLACE( C.[ID_PROPIETARIO_VEHICULO],' ', '')
																ELSE '111111'
															END
												WHEN 0 THEN '111111'
											END ) AS [ID_PROPIETARIO_VEHICULO]
    ,UPPER( REPLACE( CAST( CONCAT( REPLICATE( ' ', 100 - LEN( LTRIM( RTRIM( REPLACE( CASE WHEN C.[NOMBRE_PROPIETARIO_VEHICULO] IS NULL OR C. [NOMBRE_PROPIETARIO_VEHICULO] = '' THEN 'SIN DATO' ELSE C. [NOMBRE_PROPIETARIO_VEHICULO] END, '|', '' ) ) ) ) ), LTRIM( RTRIM( REPLACE( CASE WHEN C.[NOMBRE_PROPIETARIO_VEHICULO] IS NULL OR C.[NOMBRE_PROPIETARIO_VEHICULO] = '' THEN 'SIN DATO' ELSE C.[NOMBRE_PROPIETARIO_VEHICULO] END, '|', '' ) ) ) ) AS CHAR(100) ), CHAR(9), ' ') ) AS [NOMBRE_PROPIETARIO_VEHICULO]
    ,CASE WHEN C.[TIPO_ID_TENEDOR_VEHICULO] IS NULL OR C.[TIPO_ID_TENEDOR_VEHICULO] = ' ' OR C.[TIPO_ID_TENEDOR_VEHICULO] = '  ' THEN '0 ' ELSE C.[TIPO_ID_TENEDOR_VEHICULO] END AS [TIPO_ID_TENEDOR_VEHICULO]
    ,CONCAT( REPLICATE( ' ', 20 - LEN(	CASE ISNUMERIC( LTRIM( RTRIM( C.[ID_TENEDOR_VEHICULO] ) ) )
												WHEN 1 THEN CASE 
																WHEN LEN( LTRIM( RTRIM( C.[ID_TENEDOR_VEHICULO] ) ) ) &gt; 4 THEN REPLACE( C.[ID_TENEDOR_VEHICULO],' ', '')
																ELSE '111111'
															END
												WHEN 0 THEN '111111'
											END ) ), 
					CASE ISNUMERIC( LTRIM( RTRIM( C.[ID_TENEDOR_VEHICULO] ) ) )
												WHEN 1 THEN CASE 
																WHEN LEN( LTRIM( RTRIM( C.[ID_TENEDOR_VEHICULO] ) ) ) &gt; 4 THEN REPLACE( C.[ID_TENEDOR_VEHICULO],' ', '')
																ELSE '111111'
															END
												WHEN 0 THEN '111111'
											END ) AS [ID_TENEDOR_VEHICULO]
      ,UPPER( REPLACE( CAST( CONCAT( REPLICATE( ' ', 100 - LEN( LTRIM( RTRIM( REPLACE( CASE WHEN C.[NOMBRE_TENEDOR_VEHICULO] IS NULL OR C.[NOMBRE_TENEDOR_VEHICULO] = '' THEN 'SIN DATO' ELSE C.[NOMBRE_TENEDOR_VEHICULO] END, '|', '' ) ) ) ) ), LTRIM( RTRIM( REPLACE( CASE WHEN C.[NOMBRE_TENEDOR_VEHICULO] IS NULL OR C.[NOMBRE_TENEDOR_VEHICULO] = '' THEN 'SIN DATO' ELSE C.[NOMBRE_TENEDOR_VEHICULO] END, '|', '' ) ) ) ) AS CHAR(100) ), CHAR(9), ' ') ) AS [NOMBRE_TENEDOR_VEHICULO]
      ,CAST(CASE WHEN C.[TIPO_ID_CONDUCTOR_VEHICULO] IS NULL OR C.[TIPO_ID_CONDUCTOR_VEHICULO] = ' ' OR C.[TIPO_ID_CONDUCTOR_VEHICULO] = '  ' THEN '0 ' ELSE C.[TIPO_ID_CONDUCTOR_VEHICULO] END  AS CHAR(2) ) AS [TIPO_ID_CONDUCTOR_VEHICULO]
      ,CONCAT( REPLICATE( ' ', 20 - LEN(	CASE ISNUMERIC( LTRIM( RTRIM( C.[ID_CONDUCTOR_VEHICULO] ) ) )
												WHEN 1 THEN CASE 
																WHEN LEN( LTRIM( RTRIM( C.[ID_CONDUCTOR_VEHICULO] ) ) ) &gt; 4 THEN REPLACE( C.[ID_CONDUCTOR_VEHICULO],' ', '')
																ELSE '111111'
															END
												WHEN 0 THEN '111111'
											END ) ), 
					CASE ISNUMERIC( LTRIM( RTRIM( C.[ID_CONDUCTOR_VEHICULO] ) ) )
												WHEN 1 THEN CASE 
																WHEN LEN( LTRIM( RTRIM( C.[ID_CONDUCTOR_VEHICULO] ) ) ) &gt; 4 THEN REPLACE( C.[ID_CONDUCTOR_VEHICULO],' ', '')
																ELSE '111111'
															END
												WHEN 0 THEN '111111'
											END ) AS [ID_CONDUCTOR_VEHICULO]
      ,UPPER( REPLACE( CAST( CONCAT( REPLICATE( ' ', 100 - LEN( LTRIM( RTRIM( REPLACE( CASE WHEN C.[NOMBRE_CONDUCTOR_VEHICULO] IS NULL OR C.[NOMBRE_CONDUCTOR_VEHICULO] = '' THEN 'SIN DATO' ELSE C.[NOMBRE_CONDUCTOR_VEHICULO] END, '|', '' ) ) ) ) ), LTRIM( RTRIM( REPLACE( CASE WHEN C.[NOMBRE_CONDUCTOR_VEHICULO] IS NULL OR C.[NOMBRE_CONDUCTOR_VEHICULO] = '' THEN 'SIN DATO' ELSE C.[NOMBRE_CONDUCTOR_VEHICULO] END, '|', '' ) ) ) ) AS CHAR(100) ), CHAR(9), ' ') ) AS [NOMBRE_CONDUCTOR_VEHICULO]
     ,CASE WHEN LTRIM( RTRIM(C.[PLACA_SEMIREMOLQUE])) IS NULL OR LTRIM( RTRIM(C.[PLACA_SEMIREMOLQUE])) = 'NO APLICA' THEN '' ELSE C.[PLACA_SEMIREMOLQUE] END AS [PLACA_SEMIREMOLQUE]
	 ,CASE WHEN C.[TIPO_ID_PROPIETARIO_SEMIREMOLQUE] IS NULL OR C.[TIPO_ID_PROPIETARIO_SEMIREMOLQUE] = 'NO APLICA' THEN '0 ' ELSE C.[TIPO_ID_PROPIETARIO_SEMIREMOLQUE] END [TIPO_ID_PROPIETARIO_SEMIREMOLQUE]
     ,CONCAT( REPLICATE( ' ', 20 - LEN(	CASE WHEN C.[ID_PROPIETARIO_SEMIREMOLQUE] IS NULL OR C.[ID_PROPIETARIO_SEMIREMOLQUE] = ' ' OR C.[ID_PROPIETARIO_SEMIREMOLQUE] = 'NO APLICA' THEN  '111111' ELSE C.[ID_PROPIETARIO_SEMIREMOLQUE] END ) ), 
  					CASE WHEN C.[ID_PROPIETARIO_SEMIREMOLQUE] IS NULL OR C.[ID_PROPIETARIO_SEMIREMOLQUE] = ' ' OR [ID_PROPIETARIO_SEMIREMOLQUE] = 'NO APLICA' THEN  '111111' ELSE C.[ID_PROPIETARIO_SEMIREMOLQUE] END ) AS [ID_PROPIETARIO_SEMIREMOLQUE]
	 ,CONCAT( REPLICATE( ' ', 100 - LEN(	CASE WHEN C.[NOMBRE_PROPIETARIO_SEMIREMOLQUE] IS NULL OR C.[NOMBRE_PROPIETARIO_SEMIREMOLQUE] = ' ' OR C.[NOMBRE_PROPIETARIO_SEMIREMOLQUE] = 'NO APLICA' THEN  'SIN DATO' ELSE C.[NOMBRE_PROPIETARIO_SEMIREMOLQUE] END ) ), 
  					CASE WHEN C.[NOMBRE_PROPIETARIO_SEMIREMOLQUE] IS NULL OR C.[NOMBRE_PROPIETARIO_SEMIREMOLQUE] = ' ' OR C.[NOMBRE_PROPIETARIO_SEMIREMOLQUE] = 'NO APLICA' THEN  'SIN DATO' ELSE C.[NOMBRE_PROPIETARIO_SEMIREMOLQUE] END ) AS [NOMBRE_PROPIETARIO_SEMIREMOLQUE]
     ,CONCAT( REPLICATE( ' ', 100 - LEN(	CASE WHEN C.[PRODUCTO_TRANSPORTADO] IS NULL OR C.[PRODUCTO_TRANSPORTADO] = ' ' OR C.[PRODUCTO_TRANSPORTADO] = 'NO APLICA' THEN  'SIN DATO' ELSE C.[PRODUCTO_TRANSPORTADO] END ) ), 
  					CASE WHEN C.[PRODUCTO_TRANSPORTADO] IS NULL OR C.[PRODUCTO_TRANSPORTADO] = ' ' OR C.[PRODUCTO_TRANSPORTADO] = 'NO APLICA' THEN  'SIN DATO' ELSE C.[PRODUCTO_TRANSPORTADO] END ) AS [PRODUCTO_TRANSPORTADO]
	 ,CASE WHEN C.[TIPO_ID_REMITENTE] IS NULL OR C.[TIPO_ID_REMITENTE] = ' ' OR C.[TIPO_ID_REMITENTE] = '  ' THEN '0 ' ELSE C.[TIPO_ID_REMITENTE] END AS [TIPO_ID_REMITENTE]
     ,CONCAT( REPLICATE( ' ', 20 - LEN(	CASE ISNUMERIC( LTRIM( RTRIM( C.[ID_REMITENTE] ) ) )
												WHEN 1 THEN CASE 
																WHEN LEN( LTRIM( RTRIM( C.[ID_REMITENTE] ) ) ) &gt; 4 THEN REPLACE( C.[ID_REMITENTE],' ', '')
																ELSE '111111'
															END
												WHEN 0 THEN '111111'
												END ) ), 
					CASE ISNUMERIC( LTRIM( RTRIM( C.[ID_REMITENTE] ) ) )
												WHEN 1 THEN CASE 
																WHEN LEN( LTRIM( RTRIM( C.[ID_REMITENTE] ) ) ) &gt; 4 THEN REPLACE( C.[ID_REMITENTE],' ', '')
																ELSE '111111'
															END
												WHEN 0 THEN '111111'
											END ) AS [ID_REMITENTE]
     ,UPPER( REPLACE( CAST( CONCAT( REPLICATE( ' ', 100 - LEN( LTRIM( RTRIM( REPLACE( CASE WHEN C.[NOMBRE_REMITENTE] IS NULL OR C.[NOMBRE_REMITENTE] = '' THEN 'SIN DATO' ELSE C.[NOMBRE_REMITENTE] END, '|', '' ) ) ) ) ), LTRIM( RTRIM( REPLACE( CASE WHEN C.[NOMBRE_REMITENTE] IS NULL OR C.[NOMBRE_REMITENTE] = '' THEN 'SIN DATO' ELSE C.[NOMBRE_REMITENTE] END, '|', '' ) ) ) ) AS CHAR(100) ), CHAR(9), ' ') ) AS [NOMBRE_REMITENTE]
     ,CAST(CASE WHEN C.[TIPO_ID_DESTINATARIO] IS NULL OR C.[TIPO_ID_DESTINATARIO] = ' ' OR C.[TIPO_ID_DESTINATARIO] = '  ' THEN '0 ' ELSE C.[TIPO_ID_DESTINATARIO] END  AS CHAR(2) ) AS [TIPO_ID_DESTINATARIO]
     ,CONCAT( REPLICATE( ' ', 20 - LEN(	CASE ISNUMERIC( LTRIM( RTRIM( C.[ID_DESTINATARIO] ) ) )
												WHEN 1 THEN CASE 
																WHEN LEN( LTRIM( RTRIM( C.[ID_DESTINATARIO] ) ) ) &gt; 4 THEN REPLACE( C.[ID_DESTINATARIO],' ', '')
																ELSE '111111'
															END
												WHEN 0 THEN '111111'
												END ) ), 
					CASE ISNUMERIC( LTRIM( RTRIM( C.[ID_DESTINATARIO] ) ) )
												WHEN 1 THEN CASE 
																WHEN LEN( LTRIM( RTRIM( C.[ID_DESTINATARIO] ) ) ) &gt; 4 THEN REPLACE( C.[ID_DESTINATARIO],' ', '')
																ELSE '111111'
															END
												WHEN 0 THEN '111111'
											END ) AS [ID_DESTINATARIO]
	  
	  ,REPLACE( CAST( CONCAT( REPLICATE( ' ', 100 - LEN( CASE WHEN LTRIM( RTRIM( C.[NOMBRE_DESTINATARIO] ) ) IS NULL OR C.[NOMBRE_DESTINATARIO] = '' THEN 'SIN DATO' ELSE LTRIM( RTRIM( C.[NOMBRE_DESTINATARIO] ) ) END ) ), CASE WHEN LTRIM( RTRIM( C.[NOMBRE_DESTINATARIO] ) ) IS NULL OR C.[NOMBRE_DESTINATARIO] = '' THEN 'SIN DATO' ELSE LTRIM( RTRIM( C.[NOMBRE_DESTINATARIO] ) ) END ) AS CHAR(100) ), CHAR(9), ' ') AS [NOMBRE_DESTINATARIO]
	  ,CAST( CONCAT( LEFT( CAST( C.[VALOR_TOTAL_VIAJE] AS VARCHAR(30) ), LEN(C.[VALOR_TOTAL_VIAJE]) - 3 ), REPLICATE( ' ', 20 - LEN( LEFT( CAST( C.[VALOR_TOTAL_VIAJE] AS VARCHAR(30) ), LEN( C.[VALOR_TOTAL_VIAJE] ) - 3 ) ) ) ) AS CHAR(20) ) AS [VALOR_TOTAL_VIAJE]
	  ,CAST( CONCAT( LEFT( CAST( C.[VALOR_VIAJE_EFECTIVO] AS VARCHAR(30) ), LEN( C.[VALOR_VIAJE_EFECTIVO] ) - 3 ), REPLICATE( ' ', 20 - LEN( LEFT( CAST( C.[VALOR_VIAJE_EFECTIVO] AS VARCHAR(30) ), LEN( C.[VALOR_VIAJE_EFECTIVO] ) - 3 ) ) ) ) AS CHAR(20) ) AS [VALOR_VIAJE_EFECTIVO]
	  ,REPLACE( CAST( CONCAT( REPLICATE( ' ', 100 - LEN( CASE WHEN LTRIM( RTRIM( C.[OBSERVACIONES] ) ) IS NULL THEN ' ' ELSE LTRIM( RTRIM( C.[OBSERVACIONES] ) ) END ) ), CASE WHEN LTRIM( RTRIM( C.[OBSERVACIONES] ) ) IS NULL THEN ' ' ELSE LTRIM( RTRIM( C.[OBSERVACIONES] ) ) END ) AS CHAR(100) ), CHAR(9), ' ') AS [OBSERVACIONES]
	  ,C.[ID_TIPO_CLIENTE] AS ID_TIPO_CLIENTE
      ,C.[ID_CLIENTE] AS ID_CLIENTE
      ,C.[NUMERO_GUIA] AS CNUMERO_GUIA
      ,C.[ID_FECHA_TRANSACCION] AS ID_FECHA_TRANSACCION
      ,C.[ID_PRODUCTO] AS ID_PRODUCTO
      ,C.[PRODUCTO] AS PRODUCTO
      ,C.[ID_REPORTE] AS ID_REPORTE
      ,C.[ORIGEN] AS ORIGEN
 FROM [TMP].[UIAF] C WITH(NOLOCK) 
		LEFT JOIN	[SIG_COLOMBIA_DW].[PAR].[CLIENTES] [D] WITH(NOLOCK)
				ON	[D].[ID_CLIENTE] = [C].[ID_CLIENTE]

AND  C.VALOR_TOTAL_VIAJE&gt;0</property>
