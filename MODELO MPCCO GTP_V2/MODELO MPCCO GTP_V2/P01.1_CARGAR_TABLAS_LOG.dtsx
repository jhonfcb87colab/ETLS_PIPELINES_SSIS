    <DTS:Executable
      DTS:refId="Package\SQL_SELECT_Crear_tabla_guias"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{AE736C21-3E21-4C10-BF56-6030D352470B}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL_SELECT_Crear_tabla_guias"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{94C855A8-E2EA-4CF8-9340-DC0E1AB28830}"
          SQLTask:SqlStatementSource="USE SIG_COL_LOGISTICA_DW;&#xA;IF NOT EXISTS (&#xA;    SELECT 1 &#xA;    FROM sys.objects &#xA;    WHERE object_id = OBJECT_ID(N'TMP.TBL_NUMERO_GUIAS')&#xA;      AND type = N'U'&#xA;)&#xA;BEGIN&#xA;    CREATE TABLE TMP.TBL_NUMERO_GUIAS (&#xA;        NUMERO_GUIA   NVARCHAR(50) NOT NULL,&#xA;        CTRL_LOAD_TS  DATETIME2(3) NOT NULL &#xA;            CONSTRAINT DF_TBL_NUMERO_GUIAS_CTRL_LOAD_TS DEFAULT SYSUTCDATETIME(),&#xA;        CONSTRAINT PK_TBL_NUMERO_GUIAS PRIMARY KEY CLUSTERED (NUMERO_GUIA)&#xA;    );&#xA;END;&#xA;&#xA;SET NOCOUNT ON;&#xA;&#xA;BEGIN TRY&#xA;    TRUNCATE TABLE TMP.TBL_NUMERO_GUIAS;&#xA;&#xA;    INSERT INTO TMP.TBL_NUMERO_GUIAS WITH (TABLOCK) (NUMERO_GUIA, CTRL_LOAD_TS)&#xA;    SELECT DISTINCT CAST(NUMERO_GUIA AS NVARCHAR(50)) AS NUMERO_GUIA, SYSUTCDATETIME()&#xA;    FROM TMP.MPCCO_ENVIOS_MOV&#xA;    WHERE NUMERO_GUIA IS NOT NULL;&#xA;&#xA;    UPDATE STATISTICS TMP.TBL_NUMERO_GUIAS WITH FULLSCAN;&#xA;END TRY&#xA;BEGIN CATCH&#xA;    DECLARE @msg nvarchar(4000) = ERROR_MESSAGE();&#xA;    THROW 50001, @msg, 1;&#xA;END CATCH;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
