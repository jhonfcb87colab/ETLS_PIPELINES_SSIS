    <DTS:Executable
      DTS:refId="Package\SQL_SELECT_Historia_guias_seguimiento"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{74D59C99-070F-4A0C-90DB-025E225F9900}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL_SELECT_Historia_guias_seguimiento"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{0F71B9E3-67F3-480C-9D98-4B662F275574}"
          SQLTask:SqlStatementSource="IF OBJECT_ID('[tmp_borrar_local].DBO.SEGUIMIENTO_ENVIO','U') IS NULL&#xA;BEGIN&#xA;    CREATE TABLE [tmp_borrar_local].[DBO].[SEGUIMIENTO_ENVIO] (&#xA;        NUMERO_GUIA           NUMERIC(20,0)  NOT NULL,&#xA;        ID_PROCESO            SMALLINT       NOT NULL,&#xA;        ID_CONCEPTO           TINYINT        NULL,&#xA;        FECHA_HORA_MOVIMIENTO DATETIME       NULL,&#xA;        CONSECUT_MOVIMI       NUMERIC(7,0)   NOT NULL,&#xA;        NUMERO_MOVIMI         CHAR(30)       NOT NULL,&#xA;        FECHA_EXTRACCION      DATETIME       NULL&#xA;    );&#xA;END&#xA;ELSE&#xA;BEGIN&#xA;    TRUNCATE TABLE [tmp_borrar_local].[DBO].[SEGUIMIENTO_ENVIO];&#xA;END;&#xA;&#xA;-- Crear índices SOLO si no existen&#xA;IF NOT EXISTS (&#xA;    SELECT 1&#xA;    FROM [tmp_borrar_local].sys.indexes&#xA;    WHERE name = 'CIX_FECHA_HORA_MOVIMIENTO_Fecha'&#xA;      AND object_id = OBJECT_ID('[tmp_borrar_local].DBO.SEGUIMIENTO_ENVIO')&#xA;)&#xA;BEGIN&#xA;    CREATE CLUSTERED INDEX CIX_FECHA_HORA_MOVIMIENTO_Fecha&#xA;    ON [tmp_borrar_local].[DBO].[SEGUIMIENTO_ENVIO] (FECHA_HORA_MOVIMIENTO);&#xA;END;&#xA;&#xA;IF NOT EXISTS (&#xA;    SELECT 1&#xA;    FROM [tmp_borrar_local].sys.indexes&#xA;    WHERE name = 'IX_SEGUIMIENTO_ENVIO_NumeroGuia'&#xA;      AND object_id = OBJECT_ID('[tmp_borrar_local].DBO.SEGUIMIENTO_ENVIO')&#xA;)&#xA;BEGIN&#xA;    CREATE NONCLUSTERED INDEX IX_SEGUIMIENTO_ENVIO_NumeroGuia&#xA;    ON [tmp_borrar_local].[DBO].[SEGUIMIENTO_ENVIO] (NUMERO_GUIA);&#xA;END;&#xA;&#xA;-- Carga&#xA;INSERT INTO [tmp_borrar_local].[DBO].[SEGUIMIENTO_ENVIO] WITH (TABLOCK)&#xA;SELECT &#xA;    G.NUMERO_GUIA,&#xA;    G.ID_PROCESO,&#xA;    G.ID_CONCEPTO,&#xA;    G.FECHA_HORA_MOVIMIENTO,&#xA;    G.CONSECUT_MOVIMI,&#xA;    G.NUMERO_MOVIMI&#xA;FROM dbo.SEGUIMIENTO_ENVIO AS G WITH (NOLOCK)&#xA;WHERE EXISTS (&#xA;    SELECT 1&#xA;    FROM [tmp_borrar_local].[dbo].[TBL_NUMERO_GUIAS] AS T&#xA;    WHERE T.NUMERO_GUIA = G.NUMERO_GUIA&#xA;);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
