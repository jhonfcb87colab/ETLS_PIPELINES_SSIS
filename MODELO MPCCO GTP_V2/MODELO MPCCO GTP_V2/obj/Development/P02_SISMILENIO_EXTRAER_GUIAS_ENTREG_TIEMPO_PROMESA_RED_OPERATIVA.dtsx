    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{26BB036D-3EC9-4253-93B6-5F4BFE4DBE32}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot;TRUNCATE TABLE &quot;+ @[User::TBL_TMP_PROMESA_PRC_1] +&quot;&#xA;TRUNCATE TABLE &quot;+ @[User::TBL_TMP_PROMESA_PRC_2] +&quot;&#xA;TRUNCATE TABLE &quot;+@[User::TBL_TMP_PROMESA_PROCESOS]"
      DTS:IncludeInDebugDump="2345"
