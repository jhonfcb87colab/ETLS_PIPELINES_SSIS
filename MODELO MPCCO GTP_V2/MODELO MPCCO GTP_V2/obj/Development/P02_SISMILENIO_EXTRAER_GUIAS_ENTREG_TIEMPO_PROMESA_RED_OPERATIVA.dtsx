    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{67EA6CCC-DB68-490B-9B8F-2C1575189428}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="( (@[$Project::P_FECHA_FIN] == &quot;&quot; || TRIM(@[$Project::P_FECHA_FIN]) == &quot;&quot; || @[$Project::P_FECHA_FIN] == &quot;1900-01-01&quot;)&#xA;  ? (DT_WSTR,4) YEAR(DATEADD(&quot;day&quot;,1,GETDATE()))&#xA;  : (DT_WSTR,4) YEAR(DATEADD(&quot;day&quot;,1,(DT_DATE)@[$Project::P_FECHA_FIN]))&#xA;)"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="SET_Anio">
      <DTS:VariableValue
        DTS:DataType="8">2026</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{68521944-DD5C-48E4-9556-5B79877503CC}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="(ISNULL(@[$Project::Dias_Hacia_Atras]) || @[$Project::Dias_Hacia_Atras] == 0) &#xA;? 92 &#xA;: @[$Project::Dias_Hacia_Atras]"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="SET_Cantidad_Dias_Atras">
      <DTS:VariableValue
        DTS:DataType="3">60</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{A4CE28AB-0F12-4DA6-B1E7-3F7C7F995F1C}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="(&#xA;  (@[$Project::P_FECHA_FIN] == &quot;&quot; || TRIM(@[$Project::P_FECHA_FIN]) == &quot;&quot; || @[$Project::P_FECHA_FIN] == &quot;1900-01-01&quot;)&#xA;  ? RIGHT(&quot;0&quot; + (DT_WSTR,2) DAY(DATEADD(&quot;day&quot;, 1, GETDATE()) ), 2)&#xA;  : RIGHT(&quot;0&quot; + (DT_WSTR,2) DAY(DATEADD(&quot;day&quot;, 1, (DT_DATE)@[$Project::P_FECHA_FIN]) ), 2)&#xA;)"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="SET_Dia">
      <DTS:VariableValue
        DTS:DataType="8">09</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{8F4AB27B-BC4F-4303-BB15-AA38A364765F}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="(&#xA;  (@[$Project::P_FECHA_FIN] == &quot;&quot; || TRIM(@[$Project::P_FECHA_FIN]) == &quot;&quot; || @[$Project::P_FECHA_FIN] == &quot;1900-01-01&quot;)&#xA;  ? RIGHT(&quot;0&quot; + (DT_WSTR,2) MONTH(DATEADD(&quot;day&quot;, 1, GETDATE()) ), 2)&#xA;  : RIGHT(&quot;0&quot; + (DT_WSTR,2) MONTH(DATEADD(&quot;day&quot;, 1, (DT_DATE)@[$Project::P_FECHA_FIN]) ), 2)&#xA;)"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="SET_Mes">
      <DTS:VariableValue
        DTS:DataType="8">04</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{1F58B4F8-7BF9-4C6D-B8C3-08C87E5C3C2E}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot;SELECT&#xA;     DOCND.ID_PROCESO&#xA;    ,DOCND.NUMERO_MOVIMI&#xA;    ,DOCND.CONSECUT_MOVIMI&#xA;    ,DETND.ID_PAIS_UNO&#xA;    ,DETND.ID_CIUDAD_UNO&#xA;    ,DETND.ID_PAIS_DOS&#xA;    ,DETND.ID_CIUDAD_DOS&#xA;    ,DETND.ID_SUBTIPO_NOVEDAD&#xA;    ,DETND.ID_COURIER_CONDUCTOR&#xA;    ,DETND.PLACA_VEHICULO_DOCU&#xA;    ,DETND.UBICACION&#xA;    ,ND.ID_TIPO_NOVEDAD&#xA;    ,DETND.FECHA_NOVEDAD&#xA;    ,DETND.FECHA_HORA_ENTRADA_CIL&#xA;    ,DETND.FECHA_HORA_FIN_NOVEDAD&#xA;FROM &quot; + @[User::CONN_SIG_COLOMBIA_DW] + &quot;.&quot; + @[User::TBL_LOG_DETALLE_NOVEDAD_DIARIA] + &quot; DETND WITH (NOLOCK)&#xA;INNER JOIN &quot; + @[User::CONN_SIG_COLOMBIA_DW] + &quot;.&quot; + @[User::TBL_LOG_DOCUMENTOS_NOVEDAD_DIARIA] + &quot; DOCND WITH (NOLOCK)&#xA;  ON DETND.ID_PAIS_UNO = DOCND.ID_PAIS_UNO&#xA; AND DETND.ID_CIUDAD_UNO = DOCND.ID_CIUDAD_UNO&#xA;INNER JOIN &quot; + @[User::CONN_SIG_COLOMBIA_DW] + &quot;.&quot; + @[User::TBL_LOG_NOVEDAD_DIARIA] + &quot; ND WITH (NOLOCK)&#xA;  ON DETND.ID_PAIS_UNO = ND.ID_PAIS_UNO&#xA; AND DETND.ID_CIUDAD_UNO = ND.ID_CIUDAD_UNO&#xA;INNER JOIN &quot; + @[User::CONN_SIG_COLOMBIA_DW] + &quot;.&quot; + @[User::TBL_PAR_TIPOSNOVEDADESOPERATIVAS] + &quot; TNO&#xA;  ON ND.ID_TIPO_NOVEDAD = TNO.ID_TIPO_NOVEDAD&#xA;WHERE TNO.ES_NOVEDAD_EXTERNA = 1&#xA;  AND DETND.FECHA_NOVEDAD = DOCND.FECHA_NOVEDAD&#xA;  AND DETND.FECHA_NOVEDAD = ND.FECHA_NOVEDAD&#xA;  AND DETND.FECHA_NOVEDAD &gt;= '&quot; + @[User::VAL_fechaIni] + &quot;'&#xA;  AND DETND.FECHA_NOVEDAD &lt;= '&quot; + @[User::VAL_fechaFin] + &quot;'&#xA;  AND DETND.FECHA_HORA_ENTRADA_CIL IS NOT NULL&quot;"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="SQL_SELECT_Cargar_Promesa_ND_Base">
      <DTS:VariableValue
        DTS:DataType="8">SELECT
     DOCND.ID_PROCESO
    ,DOCND.NUMERO_MOVIMI
    ,DOCND.CONSECUT_MOVIMI
    ,DETND.ID_PAIS_UNO
    ,DETND.ID_CIUDAD_UNO
    ,DETND.ID_PAIS_DOS
    ,DETND.ID_CIUDAD_DOS
    ,DETND.ID_SUBTIPO_NOVEDAD
    ,DETND.ID_COURIER_CONDUCTOR
    ,DETND.PLACA_VEHICULO_DOCU
    ,DETND.UBICACION
    ,ND.ID_TIPO_NOVEDAD
    ,DETND.FECHA_NOVEDAD
    ,DETND.FECHA_HORA_ENTRADA_CIL
    ,DETND.FECHA_HORA_FIN_NOVEDAD
FROM SIG_COLOMBIA_DW.LOG.MPCCO_DETALLE_NOVEDAD_DIARIA DETND WITH (NOLOCK)
INNER JOIN SIG_COLOMBIA_DW.LOG.MPCCO_DOCUMENTOS_NOVEDAD_DIARIA DOCND WITH (NOLOCK)
  ON DETND.ID_PAIS_UNO = DOCND.ID_PAIS_UNO
 AND DETND.ID_CIUDAD_UNO = DOCND.ID_CIUDAD_UNO
INNER JOIN SIG_COLOMBIA_DW.LOG.MPCCO_NOVEDAD_DIARIA ND WITH (NOLOCK)
  ON DETND.ID_PAIS_UNO = ND.ID_PAIS_UNO
 AND DETND.ID_CIUDAD_UNO = ND.ID_CIUDAD_UNO
INNER JOIN SIG_COLOMBIA_DW.PAR.TIPOSNOVEDADESOPERATIVAS TNO
  ON ND.ID_TIPO_NOVEDAD = TNO.ID_TIPO_NOVEDAD
WHERE TNO.ES_NOVEDAD_EXTERNA = 1
  AND DETND.FECHA_NOVEDAD = DOCND.FECHA_NOVEDAD
  AND DETND.FECHA_NOVEDAD = ND.FECHA_NOVEDAD
  AND DETND.FECHA_NOVEDAD &gt;= '2026-02-08'
  AND DETND.FECHA_NOVEDAD &lt;= '2026-04-09'
  AND DETND.FECHA_HORA_ENTRADA_CIL IS NOT NULL</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{D8999123-7FE8-494A-95CC-2DCBC328ADC6}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot;&#xA;&#xA;&#xA;/****************************************************************************************************************************************************************************************************&#xA;**Proyecto:       &#x9;&#x9;Cubo: ENVIOS MOVILIZADOS - Perspectiva: GUIAS ENTREGADAS EN TIEMPO DE PROMESA REDOPERATIVA.&#xA;**Descripción:    &#x9;&#x9;Determina el Tiempo sin tener en cuenta Domingos y Festivos por Guia, aplicado a TIEMPO_PROMESA_H&#xA;&#x9;&#x9;&#x9;luego inserta la información agrupadamente (sin guias) en la tabla FAC.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA&#xA;&#x9;&#x9;&#x9;(Forma de calculo similar a PQR)&#xA;**Autor:         &#x9;&#x9;PRONÓSTICA SAS&#xA;&#xA;+-------------------------------------------------------------------------------------------------------------------------------------------------------+&#xA;**-Requerimiento:&#x9;&#x9;Optimización cálculo TIEMPO_PROMESA – migración de lógica WHILE a set-based con deduplicación a raiz de crear una fact rapida&#xA;&#x9;&#x9;&#x9;mostrarla en un dashboard de power bi.&#xA;**Autor:&#x9;&#x9;&#x9;Ditech - Joan Sebastian Castiblanco Cuvides&#xA;**Fecha modificación&#x9;2025-08-26&#xA;+-------------------------------------------------------------------------------------------------------------------------------------------------------+&#xA;**Descripción del cambio: &#xA;Se reemplazó la lógica basada en WHILE y cálculos fila por fila por una implementación set-based optimizada. &#xA;Ahora se genera un calendario único con acumulado de días hábiles, se aplica deduplicación controlada por &#xA;(NÚMERO_GUIA, FECHA) para evitar sobreconteos, y se incorporan las reglas de concepto y novedades operativas &#xA;con CTEs y joins en lugar de consultas repetitivas. Además, se usa OUTER APPLY/LEFT JOIN para asegurar que &#xA;todas las guías conserven fila aunque falte calendario. Estos cambios mejoran rendimiento, mantenibilidad y &#xA;paridad con PRD, reduciendo tiempos de ejecución y riesgos de duplicidad o pérdida de datos.&#xA;+-------------------------------------------------------------------------------------------------------------------------------------------------------+&#xA;******************************************************************************************************************************************************************************************************/&#xA;&#xA;-- 1) Semántica de días como el legado: Lunes=1 → Domingo=1, Sábado=7&#xA;SET DATEFIRST 1;&#xA;&#xA;--+----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+&#xA;-- 2) Rango de calendario (min FECHA, máx FECHA_ENTREGA/GETDATE) + HARDEN + EARLY EXIT&#xA;--+----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+&#xA;DECLARE @dmin date, @dmax date, @days int, @has int;&#xA;&#xA;-- ¿Hay datos para procesar?&#xA;SELECT @has = COUNT(1)&#xA;FROM SIG_COL_LOGISTICA_DW.TMP.MPCCO_PROMESA WITH (NOLOCK);&#xA;&#xA;IF (@has = 0)&#xA;BEGIN&#xA;  PRINT 'No hay datos en SIG_COL_LOGISTICA_DW.TMP.MPCCO_PROMESA; se omite cálculo e inserción.';&#xA;  RETURN;  -- evitar correr en vacío y evitar TOP(NULL)&#xA;END&#xA;&#xA;SELECT&#xA;    @dmin = CONVERT(date, MIN(EM.FECHA)),&#xA;    @dmax = CONVERT(date, MAX(ISNULL(EM.FECHA_ENTREGA, GETDATE())))&#xA;FROM SIG_COL_LOGISTICA_DW.TMP.MPCCO_PROMESA AS EM WITH (NOLOCK);&#xA;&#xA;-- HARDEN: evita NULL/negativos en el TOP&#xA;SET @dmin = ISNULL(@dmin, CONVERT(date, GETDATE()));&#xA;SET @dmax = ISNULL(@dmax, @dmin);&#xA;IF (@dmax &lt; @dmin) SET @dmax = @dmin;&#xA;&#xA;SET @days = DATEDIFF(DAY, @dmin, @dmax) + 1;&#xA;IF (@days &lt; 1) SET @days = 1;&#xA;&#xA;--+----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+&#xA;-- 3) Calendario día a día con marcadores hábiles y acumulado&#xA;--+----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+&#xA;IF OBJECT_ID('tempdb..#CAL') IS NOT NULL DROP TABLE #CAL;&#xA;&#xA;WITH N AS (&#xA;    SELECT TOP (@days)  -- &lt;&lt;&lt;&lt;&lt;&lt; hardened&#xA;           ROW_NUMBER() OVER (ORDER BY (SELECT NULL)) - 1 AS n&#xA;    FROM sys.all_objects ao1&#xA;    CROSS JOIN sys.all_objects ao2&#xA;)&#xA;SELECT&#xA;    CAST(DATEADD(DAY, n, @dmin) AS date) AS dt,&#xA;    CASE WHEN DATEPART(WEEKDAY, DATEADD(DAY, n, @dmin)) = 1 THEN 1 ELSE 0 END AS IsSunday&#xA;INTO #CAL&#xA;FROM N;&#xA;&#xA;CREATE UNIQUE CLUSTERED INDEX IX_CAL_dt ON #CAL(dt);&#xA;&#xA;ALTER TABLE #CAL ADD IsHoliday bit NULL, IsBusinessDay bit NULL, CumBusinessDays int NULL;&#xA;&#xA;UPDATE C&#xA;SET IsHoliday = CASE WHEN F.FECHA_FESTIVA IS NOT NULL THEN 1 ELSE 0 END&#xA;FROM #CAL C&#xA;LEFT JOIN DIM.TIEMPO_FESTIVOS_NACIONALES F WITH (NOLOCK)&#xA;  ON F.FECHA_FESTIVA = C.dt AND F.ID_PAIS = 1;&#xA;&#xA;UPDATE #CAL&#xA;SET IsBusinessDay = CASE WHEN IsSunday = 1 OR IsHoliday = 1 THEN 0 ELSE 1 END;&#xA;&#xA;WITH X AS (&#xA;  SELECT dt,&#xA;         cum = SUM(CASE WHEN IsBusinessDay = 1 THEN 1 ELSE 0 END)&#xA;               OVER (ORDER BY dt ROWS UNBOUNDED PRECEDING)&#xA;  FROM #CAL&#xA;)&#xA;UPDATE c&#xA;SET CumBusinessDays = x.cum&#xA;FROM #CAL c&#xA;JOIN X ON X.dt = c.dt;&#xA;&#xA;--+----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+&#xA;-- 4) ND por guía (preagregado)&#xA;--+----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+&#xA;IF OBJECT_ID('tempdb..#ND') IS NOT NULL DROP TABLE #ND;&#xA;&#xA;SELECT NUMERO_GUIA,&#xA;       SUM(ISNULL(ND_HORAS,0)) AS HORAS_ND&#xA;INTO #ND&#xA;FROM SIG_COLOMBIA_DW.TMP.MPCCO_PROMESA_ND WITH (NOLOCK)&#xA;GROUP BY NUMERO_GUIA;&#xA;&#xA;&#xA;&#xA;&#xA;CREATE UNIQUE CLUSTERED INDEX IX_ND_GUIA ON #ND(NUMERO_GUIA);&#xA;&#xA;--+----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+&#xA;-- 5) CONCEPTO por guía (ajustado a legado)&#xA;--    - Proceso 21: 2 más recientes (DESC)&#xA;--    - Sábado vía DATEPART(WEEKDAY)=7 (con DATEFIRST 1)&#xA;--+----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+&#xA;IF OBJECT_ID('tempdb..#CONCEPTO') IS NOT NULL DROP TABLE #CONCEPTO;&#xA;&#xA;;WITH PP AS (&#xA;    SELECT P.NUMERO_GUIA, P.ID_PROCESO, P.ID_CONCEPTO, P.FECHA_HORA_MOVIMIENTO&#xA;    FROM SIG_COL_LOGISTICA_DW.TMP.MPCCO_PROMESA_PROCESOS P WITH (NOLOCK)&#xA;),&#xA;PP21 AS (&#xA;    SELECT&#xA;        NUMERO_GUIA, ID_PROCESO, ID_CONCEPTO, FECHA_HORA_MOVIMIENTO,&#xA;        ROW_NUMBER() OVER (&#xA;          PARTITION BY NUMERO_GUIA&#xA;          ORDER BY FECHA_HORA_MOVIMIENTO DESC&#xA;        ) AS rn&#xA;    FROM PP&#xA;    WHERE ID_PROCESO = 21&#xA;),&#xA;PP21_TOP2 AS (&#xA;    SELECT * FROM PP21 WHERE rn &lt;= 2&#xA;),&#xA;FLAGS AS (&#xA;    SELECT&#xA;        X.NUMERO_GUIA,&#xA;        MAX(X.Flag_21_71)     AS has_21_71,&#xA;        MAX(X.Flag_21_72)     AS has_21_72,&#xA;        MAX(X.Flag_9_IN)      AS has_9_in,&#xA;        MAX(X.Flag_21_73_SAT) AS has_21_73_sat&#xA;    FROM (&#xA;        -- Proceso 21 (top 2)&#xA;        SELECT&#xA;            T.NUMERO_GUIA,&#xA;            CASE WHEN T.ID_CONCEPTO = 71 THEN 1 ELSE 0 END AS Flag_21_71,&#xA;            CASE WHEN T.ID_CONCEPTO = 72 THEN 1 ELSE 0 END AS Flag_21_72,&#xA;            0 AS Flag_9_IN,&#xA;            CASE WHEN T.ID_CONCEPTO = 73&#xA;                      AND DATEPART(WEEKDAY, CAST(T.FECHA_HORA_MOVIMIENTO AS date)) = 7&#xA;                 THEN 1 ELSE 0 END AS Flag_21_73_SAT&#xA;        FROM PP21_TOP2 T&#xA;&#xA;        UNION ALL&#xA;&#xA;        -- Proceso 9&#xA;        SELECT&#xA;            P.NUMERO_GUIA,&#xA;            0, 0,&#xA;            CASE WHEN P.ID_PROCESO = 9 AND P.ID_CONCEPTO IN (2,4,7,9) THEN 1 ELSE 0 END,&#xA;            0&#xA;        FROM PP P&#xA;    ) X&#xA;    GROUP BY X.NUMERO_GUIA&#xA;)&#xA;SELECT&#xA;    F.NUMERO_GUIA,&#xA;    ID_CONCEPTO =&#xA;        CASE&#xA;            WHEN F.has_21_71     = 1 THEN '2'&#xA;            WHEN F.has_21_72     = 1 THEN '3'&#xA;            WHEN F.has_9_in      = 1 THEN '4'&#xA;            WHEN F.has_21_73_sat = 1 THEN '5'&#xA;            ELSE '1'&#xA;        END&#xA;INTO #CONCEPTO&#xA;FROM FLAGS F;&#xA;&#xA;CREATE UNIQUE CLUSTERED INDEX IX_CONC_GUIA ON #CONCEPTO(NUMERO_GUIA);&#xA;&#xA;--+----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+&#xA;-- 6) Rutas activas por combinación&#xA;--+----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+&#xA;IF OBJECT_ID('tempdb..#ROUTE_MAP') IS NOT NULL DROP TABLE #ROUTE_MAP;&#xA;&#xA;SELECT&#xA;   MAX(ID_RUTA) AS ID_RUTA,&#xA;   ID_CIUDAD_ORIGEN,&#xA;   ID_CIUDAD_DESTINO,&#xA;   ID_TIEMPO,&#xA;   ID_MEDTRANS&#xA;INTO #ROUTE_MAP&#xA;FROM DIM.RED_OPERATIVA_RUTA WITH (NOLOCK)&#xA;WHERE ID_ESTADO_RUTA = 1&#xA;GROUP BY ID_CIUDAD_ORIGEN, ID_CIUDAD_DESTINO, ID_TIEMPO, ID_MEDTRANS;&#xA;&#xA;CREATE UNIQUE CLUSTERED INDEX IX_RMAP_KEYS&#xA;ON #ROUTE_MAP(ID_CIUDAD_ORIGEN, ID_CIUDAD_DESTINO, ID_TIEMPO, ID_MEDTRANS);&#xA;CREATE NONCLUSTERED INDEX IX_RMAP_RUTA ON #ROUTE_MAP(ID_RUTA);&#xA;&#xA;--+----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+&#xA;-- 7) Carga TMP (set-based) con DEDUP del origen PROMESA&#xA;--    DEDUP por NUMERO_GUIA + FECHA(date) para no colapsar días distintos&#xA;--+----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+&#xA;&#xA;-- TRUNCATE solo si hay datos a procesar (ya validado con @has)&#xA;TRUNCATE TABLE TMP.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA;&#xA;&#xA;&#xA;---------------------------&gt; NUEVAS COLUMNAS&#xA;&#xA;--ALTER TABLE  TMP.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA ADD  [ULT_MOV_FECHA_HORA_MOVIMIENTO] datetime&#xA;--ALTER TABLE  TMP.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA ADD  [ULT_MOV_ID_PROCESO] smallint&#xA;--ALTER TABLE  TMP.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA ADD  [ULT_MOV_NUMERO_MOVIMI] varchar(30)&#xA;--ALTER TABLE  TMP.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA ADD  [ULT_MOV_CONSECUT_MOVIMI] numeric(7,0)&#xA;&#xA;&#xA;INSERT INTO TMP.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA&#xA;(&#xA;&#x9; TIME_ID, FECHA, DIA, MES, AÑO,&#xA;&#x9; ID_CIUDAD_ORIGEN, ID_CIUDAD_DESTINO, ID_ESTADOENVIO, ID_PRODUCTO, ID_SUBPRODUCTO, ID_CLIENTE,&#xA;&#x9; ID_CONCEPTO, ID_TIEMPO_ENTREGA, ID_MEDTRANS,&#xA;&#x9; NUMERO_GUIA,&#xA;&#x9; TIEMPO_PROMESA_H,&#xA;&#x9; TIEMPO_PROMESA_CUMPLE_H,&#xA;&#x9; HORAS_ND, ID_ESTADO_ND,&#xA;&#x9; GR_ID_TIPO_COBRO,&#xA;&#x9; [ULT_MOV_FECHA_HORA_MOVIMIENTO],&#xA;&#x9; [ULT_MOV_ID_PROCESO], &#xA;&#x9; [ULT_MOV_NUMERO_MOVIMI], &#xA;&#x9; [ULT_MOV_CONSECUT_MOVIMI] &#xA;)&#xA;SELECT&#xA;   CONVERT(NUMERIC, CONVERT(DATETIME, CONVERT(CHAR(11), EM.FECHA)))        AS TIME_ID,&#xA;   CONVERT(DATETIME, CONVERT(CHAR(11), EM.FECHA))                          AS FECHA,&#xA;   DAY(EM.FECHA)                                                           AS DIA,&#xA;   MONTH(EM.FECHA)                                                         AS MES,&#xA;   YEAR(EM.FECHA)                                                          AS AÑO,&#xA;   ISNULL(EM.ID_CIUDAD_ORIGEN,0),&#xA;   ISNULL(EM.ID_CIUDAD_DESTINO,0),&#xA;   EM.ID_ESTADOENVIO,&#xA;   EM.ID_PRODUCTO,&#xA;   EM.ID_SUBPRODUCTO,&#xA;   EM.ID_CLIENTE,&#xA;   COALESCE(CPT.ID_CONCEPTO, '1')                                          AS ID_CONCEPTO,&#xA;   ISNULL(EM.ID_TIEMPO_ENTREGA,0),&#xA;   ISNULL(EM.ID_MEDTRANS,0),&#xA;   EM.NUMERO_GUIA,&#xA;&#xA;   -- Tiempo hábil (minutos/60) — usar 0 si no hay cálculo, para no perder fila&#xA;   ISNULL(CA.time_minutes / 60.0, 0)                                       AS TIEMPO_PROMESA_H,&#xA;&#xA;   -- Cumplimiento para 2 (hoy) y 3 (cero) igual al legado&#xA;   CASE&#xA;      WHEN EM.ID_TIEMPO_ENTREGA = 2 THEN&#xA;           CASE WHEN ISNULL(ND.HORAS_ND,0) &gt; 0 THEN&#xA;                    CASE WHEN CONVERT(date, EM.FECHA_ENTREGA_DEF) IN (CONVERT(date, EM.FECHA),&#xA;                                                                     DATEADD(DAY,1,CONVERT(date, EM.FECHA)))&#xA;                         THEN 'SI' ELSE 'NO' END&#xA;                ELSE&#xA;                    CASE WHEN CONVERT(date, EM.FECHA_ENTREGA_DEF) = CONVERT(date, EM.FECHA)&#xA;                         THEN 'SI' ELSE 'NO' END&#xA;           END&#xA;      WHEN EM.ID_TIEMPO_ENTREGA = 3 THEN&#xA;           CASE WHEN ISNULL(ND.HORAS_ND,0) &gt; 0 THEN&#xA;                    CASE WHEN EM.FECHA_ENTREGA_DEF &lt; DATEADD(DAY, 1, CONVERT(DATETIME, CONVERT(date, EM.FECHA_VIGENTE)))&#xA;                         THEN 'SI' ELSE 'NO' END&#xA;                ELSE&#xA;                    CASE WHEN EM.FECHA_ENTREGA_DEF &lt;= EM.FECHA_VIGENTE&#xA;                         THEN 'SI' ELSE 'NO' END&#xA;           END&#xA;      ELSE NULL&#xA;   END                                                                      AS TIEMPO_PROMESA_CUMPLE_H,&#xA;&#xA;   ISNULL(ND.HORAS_ND,0)                                                   AS HORAS_ND,&#xA;   CASE WHEN ISNULL(ND.HORAS_ND,0) &gt; 0 THEN 'SI' ELSE 'NO' END             AS ID_ESTADO_ND,&#xA;   EM.GR_ID_TIPO_COBRO,&#xA;&#x9;[ULT_MOV_FECHA_HORA_MOVIMIENTO],&#xA;&#x9;[ULT_MOV_ID_PROCESO], &#xA;&#x9;[ULT_MOV_NUMERO_MOVIMI], &#xA;&#x9;[ULT_MOV_CONSECUT_MOVIMI] &#xA;FROM (&#xA;   /* ===== DEDUP de PROMESA: 1 fila por NUMERO_GUIA + FECHA(date) ===== */&#xA;   SELECT&#xA;      P.NUMERO_GUIA,&#xA;      P.ID_CIUDAD_ORIGEN, P.ID_CIUDAD_DESTINO, P.ID_ESTADOENVIO,&#xA;      P.ID_PRODUCTO, P.ID_SUBPRODUCTO, P.ID_CLIENTE,&#xA;      P.ID_TIEMPO_ENTREGA, P.ID_MEDTRANS,&#xA;      P.FECHA,&#xA;      CAST(P.FECHA AS date) AS FECHA_ENVIO_D,&#xA;      CAST(ISNULL(P.FECHA_ENTREGA, CONVERT(DATETIME, CONVERT(date, GETDATE()))) AS datetime) AS FECHA_ENTREGA_DEF,&#xA;      CAST(ISNULL(P.FECHA_ENTREGA, GETDATE()) AS date) AS FECHA_ENTREGA_D,&#xA;      P.FECHA_VIGENTE,&#xA;      P.GR_ID_TIPO_COBRO,&#xA;&#x9;  P.[ULT_MOV_FECHA_HORA_MOVIMIENTO],&#xA;&#x9;  P.[ULT_MOV_ID_PROCESO], &#xA;&#x9;  P.[ULT_MOV_NUMERO_MOVIMI], &#xA;&#x9;  P.[ULT_MOV_CONSECUT_MOVIMI] &#xA;   FROM (&#xA;     SELECT *&#xA;     FROM (&#xA;       SELECT P.*,&#xA;              ROW_NUMBER() OVER (&#xA;                PARTITION BY P.NUMERO_GUIA, CAST(P.FECHA AS date)   -- &lt;&lt; clave&#xA;                ORDER BY ISNULL(P.FECHA_ENTREGA, P.FECHA) DESC,&#xA;                         P.FECHA DESC,&#xA;                         P.FECHA_VIGENTE DESC&#xA;              ) AS rn&#xA;       FROM SIG_COL_LOGISTICA_DW.TMP.MPCCO_PROMESA P WITH (NOLOCK)&#xA;     ) z&#xA;     WHERE z.rn = 1&#xA;   ) P&#xA;   /* ===== fin DEDUP ===== */&#xA;) EM&#xA;/* === OUTER APPLY + LEFT JOIN a CE, y forzamos fila para 2/3 === */&#xA;OUTER APPLY (&#xA;   SELECT&#xA;     (CE.CumBusinessDays - ISNULL(CSPrev.CumBusinessDays, 0)) * 1440&#xA;     - CASE WHEN CS.IsBusinessDay = 1 THEN DATEDIFF(MINUTE, EM.FECHA_ENVIO_D, EM.FECHA) ELSE 0 END&#xA;     - CASE WHEN CE.IsBusinessDay = 1 THEN DATEDIFF(MINUTE, EM.FECHA_ENTREGA_DEF, DATEADD(DAY,1,EM.FECHA_ENTREGA_D)) ELSE 0 END&#xA;     AS time_minutes&#xA;   FROM #CAL CS&#xA;   LEFT JOIN #CAL CSPrev ON CSPrev.dt = DATEADD(DAY, -1, CS.dt)&#xA;   LEFT JOIN #CAL CE     ON CE.dt = EM.FECHA_ENTREGA_D&#xA;   WHERE CS.dt = EM.FECHA_ENVIO_D&#xA;      OR EM.ID_TIEMPO_ENTREGA IN (2,3)&#xA;) CA&#xA;LEFT JOIN #CONCEPTO CPT ON CPT.NUMERO_GUIA = EM.NUMERO_GUIA&#xA;LEFT JOIN #ND ND        ON ND.NUMERO_GUIA  = EM.NUMERO_GUIA;&#xA;&#xA;--+----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+&#xA;-- 8) “Seguro” de DEDUP en TMP (por si algo coló)&#xA;--    DEDUP por FECHA + NUMERO_GUIA (no solo por guía)&#xA;--+----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+&#xA;;WITH DEDUP AS (&#xA;  SELECT *,&#xA;         ROW_NUMBER() OVER (&#xA;           PARTITION BY FECHA, NUMERO_GUIA&#xA;           ORDER BY TIME_ID DESC&#xA;         ) AS rn&#xA;  FROM TMP.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA&#xA;)&#xA;DELETE FROM DEDUP WHERE rn &gt; 1;&#xA;&#xA;-- Índice útil para siguientes pasos&#xA;IF NOT EXISTS (&#xA;  SELECT 1 FROM sys.indexes&#xA;  WHERE object_id = OBJECT_ID('TMP.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA')&#xA;    AND name = 'IX_TMP_PROMESA_NUMERO_GUIA'&#xA;)&#xA;CREATE NONCLUSTERED INDEX IX_TMP_PROMESA_NUMERO_GUIA&#xA;ON TMP.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA (NUMERO_GUIA);&#xA;&#xA;--+----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+&#xA;-- 9) Asignar ID_RUTA por combinación&#xA;--+----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+&#xA;UPDATE T&#xA;SET T.ID_RUTA = ISNULL(RM.ID_RUTA, 0)&#xA;FROM TMP.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA T&#xA;LEFT JOIN #ROUTE_MAP RM&#xA;  ON T.ID_CIUDAD_ORIGEN = RM.ID_CIUDAD_ORIGEN&#xA; AND T.ID_CIUDAD_DESTINO = RM.ID_CIUDAD_DESTINO&#xA; AND T.ID_TIEMPO_ENTREGA = RM.ID_TIEMPO&#xA; AND T.ID_MEDTRANS      = RM.ID_MEDTRANS;&#xA;&#xA;--+----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+&#xA;-- 10) Tiempo de oferta y grupo de red&#xA;--+----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+&#xA;UPDATE T&#xA;SET&#xA;  T.TIEMPO_OFERTA = R.TIEMPO_ENTREGA_COMERCIAL_HOR,&#xA;  T.ID_GRUPO_RED  = CASE&#xA;                      WHEN R.ID_RUTA = 0 THEN 0&#xA;                      WHEN R.TIEMPO_ENTREGA_COMERCIAL_HOR BETWEEN 0   AND 36  THEN 1&#xA;                      WHEN R.TIEMPO_ENTREGA_COMERCIAL_HOR BETWEEN 37  AND 60  THEN 2&#xA;                      WHEN R.TIEMPO_ENTREGA_COMERCIAL_HOR BETWEEN 61  AND 84  THEN 3&#xA;                      WHEN R.TIEMPO_ENTREGA_COMERCIAL_HOR BETWEEN 85  AND 108 THEN 4&#xA;                      ELSE 5&#xA;                    END&#xA;FROM TMP.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA T&#xA;LEFT JOIN DIM.RED_OPERATIVA_RUTA R WITH (NOLOCK)&#xA;  ON T.ID_RUTA = R.ID_RUTA;&#xA;&#xA;--+----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+&#xA;-- 11) Cumplimiento por bandas (general)&#xA;--+----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+&#xA;UPDATE T&#xA;SET T.TIEMPO_PROMESA_CUMPLE_H =&#xA;  CASE&#xA;    WHEN T.TIEMPO_PROMESA_H &gt;&#xA;         (CASE&#xA;            WHEN T.ID_RUTA = 0 THEN 0&#xA;            WHEN T.TIEMPO_OFERTA &lt;= 36 THEN (36 + T.HORAS_ND)&#xA;            WHEN T.TIEMPO_OFERTA &gt; 36 AND (T.TIEMPO_OFERTA + T.HORAS_ND) &lt;= 60 THEN (60 + T.HORAS_ND)&#xA;            WHEN T.TIEMPO_OFERTA &gt; 60 AND (T.TIEMPO_OFERTA + T.HORAS_ND) &lt;= 84 THEN (84 + T.HORAS_ND)&#xA;            WHEN T.TIEMPO_OFERTA &gt; 84 AND (T.TIEMPO_OFERTA + T.HORAS_ND) &lt;= 108 THEN (108 + T.HORAS_ND)&#xA;            ELSE T.TIEMPO_OFERTA + T.HORAS_ND&#xA;          END)&#xA;      THEN 'NO' ELSE 'SI'&#xA;  END&#xA;FROM TMP.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA AS T&#xA;WHERE T.ID_TIEMPO_ENTREGA NOT IN (2,3)&#xA;  AND T.TIEMPO_PROMESA_CUMPLE_H IS NULL;&#xA;&#xA;--+----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+&#xA;-- 12) Sincronización con FAC&#xA;--+----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+&#xA;&#xA;&#xA;DELETE FAC&#xA;FROM TMP.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA TMP&#xA;INNER JOIN FAC.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA FAC&#xA;ON FAC.NUMERO_GUIA=TMP.NUMERO_GUIA&#xA;&#xA;;WITH CTE AS(&#xA;SELECT&#xA;ROW_DEL = ROW_NUMBER() OVER(PARTITION BY NUMERO_GUIA ORDER BY FECHA ASC) &#xA;,NUMERO_GUIA&#xA;FROM FAC.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA&#xA;)DELETE CTE WHERE  ROW_DEL &gt;1&#xA;&#xA;  ------------------------------------------------------NUEVAS COLUMNAS&#xA;--ALTER TABLE  FAC.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA ADD  [ULT_MOV_FECHA_HORA_MOVIMIENTO] datetime&#xA;--ALTER TABLE  FAC.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA ADD  [ULT_MOV_ID_PROCESO] smallint&#xA;--ALTER TABLE  FAC.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA ADD  [ULT_MOV_NUMERO_MOVIMI] varchar(30)&#xA;--ALTER TABLE  FAC.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA ADD  [ULT_MOV_CONSECUT_MOVIMI] numeric(7,0)&#xA;--ALTER TABLE FAC.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA ADD FEHCA_INSERT DATETIME&#xA;INSERT INTO FAC.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA&#xA;(&#xA;   TIME_ID, FECHA, DIA, MES, AÑO,&#xA;   ID_CIUDAD_ORIGEN, ID_CIUDAD_DESTINO, ID_CLIENTE,&#xA;   ID_ESTADOENVIO, ID_PRODUCTO, ID_SUBPRODUCTO, ID_PROD_SUBP,&#xA;   ID_TIEMPO_ENTREGA, NUMERO_GUIA,&#xA;   ID_RUTA, ID_GRUPO_RED,&#xA;   TIEMPO_PROMESA_H, TIEMPO_OFERTA, TIEMPO_PROMESA_CUMPLE_H,&#xA;   ID_GEOGRAFIA_CONCEPTO,&#xA;   HORAS_ND, ID_ESTADO_ND,&#xA;   GR_ID_TIPO_COBRO,&#xA;   [ULT_MOV_FECHA_HORA_MOVIMIENTO],&#xA;   [ULT_MOV_ID_PROCESO], &#xA;   [ULT_MOV_NUMERO_MOVIMI], &#xA;   [ULT_MOV_CONSECUT_MOVIMI],&#xA;   FEHCA_INSERT&#xA;)&#xA;SELECT&#xA;   T.TIME_ID, T.FECHA, T.DIA, T.MES, T.AÑO,&#xA;   T.ID_CIUDAD_ORIGEN, T.ID_CIUDAD_DESTINO, T.ID_CLIENTE,&#xA;   T.ID_ESTADOENVIO, T.ID_PRODUCTO, T.ID_SUBPRODUCTO,&#xA;   RIGHT('00' + CONVERT(varchar, T.ID_PRODUCTO), 2)&#xA;   + RIGHT('0000' + CONVERT(varchar, T.ID_SUBPRODUCTO), 4) AS ID_PROD_SUBP,&#xA;   T.ID_TIEMPO_ENTREGA, T.NUMERO_GUIA,&#xA;   T.ID_RUTA, T.ID_GRUPO_RED,&#xA;   T.TIEMPO_PROMESA_H, T.TIEMPO_OFERTA, T.TIEMPO_PROMESA_CUMPLE_H,&#xA;   CONVERT(varchar, G.ID_REGIONAL) + '-' + CONVERT(varchar, T.ID_CONCEPTO) AS ID_GEOGRAFIA_CONCEPTO,&#xA;   T.HORAS_ND, T.ID_ESTADO_ND,&#xA;   T.GR_ID_TIPO_COBRO,&#xA;   T.[ULT_MOV_FECHA_HORA_MOVIMIENTO],&#xA;   T.[ULT_MOV_ID_PROCESO], &#xA;   T.[ULT_MOV_NUMERO_MOVIMI], &#xA;   T.[ULT_MOV_CONSECUT_MOVIMI], &#xA;   GETDATE() AS FEHCA_INSERT&#xA;FROM TMP.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA AS T&#xA;LEFT JOIN SIG_COLOMBIA_DW.DIM.GEOGRAFIA AS G WITH (NOLOCK)&#xA;  ON T.ID_CIUDAD_DESTINO = G.ID_CIUDAD;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;DELETE FAC.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA WHERE FECHA &lt; DATEADD(mm,-3,DATEADD(mm,DATEDIFF(mm,0,GETDATE()),0)) &#xA;&#xA;&#xA;&quot;"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="SQL_SELECT_INSERT_Calcular_promesa_fac_guias">
      <DTS:VariableValue
        DTS:DataType="8">


/****************************************************************************************************************************************************************************************************
**Proyecto:       		Cubo: ENVIOS MOVILIZADOS - Perspectiva: GUIAS ENTREGADAS EN TIEMPO DE PROMESA REDOPERATIVA.
**Descripción:    		Determina el Tiempo sin tener en cuenta Domingos y Festivos por Guia, aplicado a TIEMPO_PROMESA_H
			luego inserta la información agrupadamente (sin guias) en la tabla FAC.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA
			(Forma de calculo similar a PQR)
**Autor:         		PRONÓSTICA SAS

+-------------------------------------------------------------------------------------------------------------------------------------------------------+
**-Requerimiento:		Optimización cálculo TIEMPO_PROMESA – migración de lógica WHILE a set-based con deduplicación a raiz de crear una fact rapida
			mostrarla en un dashboard de power bi.
**Autor:			Ditech - Joan Sebastian Castiblanco Cuvides
**Fecha modificación	2025-08-26
+-------------------------------------------------------------------------------------------------------------------------------------------------------+
**Descripción del cambio: 
Se reemplazó la lógica basada en WHILE y cálculos fila por fila por una implementación set-based optimizada. 
Ahora se genera un calendario único con acumulado de días hábiles, se aplica deduplicación controlada por 
(NÚMERO_GUIA, FECHA) para evitar sobreconteos, y se incorporan las reglas de concepto y novedades operativas 
con CTEs y joins en lugar de consultas repetitivas. Además, se usa OUTER APPLY/LEFT JOIN para asegurar que 
todas las guías conserven fila aunque falte calendario. Estos cambios mejoran rendimiento, mantenibilidad y 
paridad con PRD, reduciendo tiempos de ejecución y riesgos de duplicidad o pérdida de datos.
+-------------------------------------------------------------------------------------------------------------------------------------------------------+
******************************************************************************************************************************************************************************************************/

-- 1) Semántica de días como el legado: Lunes=1 → Domingo=1, Sábado=7
SET DATEFIRST 1;

--+----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
-- 2) Rango de calendario (min FECHA, máx FECHA_ENTREGA/GETDATE) + HARDEN + EARLY EXIT
--+----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
DECLARE @dmin date, @dmax date, @days int, @has int;

-- ¿Hay datos para procesar?
SELECT @has = COUNT(1)
FROM SIG_COL_LOGISTICA_DW.TMP.MPCCO_PROMESA WITH (NOLOCK);

IF (@has = 0)
BEGIN
  PRINT 'No hay datos en SIG_COL_LOGISTICA_DW.TMP.MPCCO_PROMESA; se omite cálculo e inserción.';
  RETURN;  -- evitar correr en vacío y evitar TOP(NULL)
END

SELECT
    @dmin = CONVERT(date, MIN(EM.FECHA)),
    @dmax = CONVERT(date, MAX(ISNULL(EM.FECHA_ENTREGA, GETDATE())))
FROM SIG_COL_LOGISTICA_DW.TMP.MPCCO_PROMESA AS EM WITH (NOLOCK);

-- HARDEN: evita NULL/negativos en el TOP
SET @dmin = ISNULL(@dmin, CONVERT(date, GETDATE()));
SET @dmax = ISNULL(@dmax, @dmin);
IF (@dmax &lt; @dmin) SET @dmax = @dmin;

SET @days = DATEDIFF(DAY, @dmin, @dmax) + 1;
IF (@days &lt; 1) SET @days = 1;

--+----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
-- 3) Calendario día a día con marcadores hábiles y acumulado
--+----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
IF OBJECT_ID('tempdb..#CAL') IS NOT NULL DROP TABLE #CAL;

WITH N AS (
    SELECT TOP (@days)  -- &lt;&lt;&lt;&lt;&lt;&lt; hardened
           ROW_NUMBER() OVER (ORDER BY (SELECT NULL)) - 1 AS n
    FROM sys.all_objects ao1
    CROSS JOIN sys.all_objects ao2
)
SELECT
    CAST(DATEADD(DAY, n, @dmin) AS date) AS dt,
    CASE WHEN DATEPART(WEEKDAY, DATEADD(DAY, n, @dmin)) = 1 THEN 1 ELSE 0 END AS IsSunday
INTO #CAL
FROM N;

CREATE UNIQUE CLUSTERED INDEX IX_CAL_dt ON #CAL(dt);

ALTER TABLE #CAL ADD IsHoliday bit NULL, IsBusinessDay bit NULL, CumBusinessDays int NULL;

UPDATE C
SET IsHoliday = CASE WHEN F.FECHA_FESTIVA IS NOT NULL THEN 1 ELSE 0 END
FROM #CAL C
LEFT JOIN DIM.TIEMPO_FESTIVOS_NACIONALES F WITH (NOLOCK)
  ON F.FECHA_FESTIVA = C.dt AND F.ID_PAIS = 1;

UPDATE #CAL
SET IsBusinessDay = CASE WHEN IsSunday = 1 OR IsHoliday = 1 THEN 0 ELSE 1 END;

WITH X AS (
  SELECT dt,
         cum = SUM(CASE WHEN IsBusinessDay = 1 THEN 1 ELSE 0 END)
               OVER (ORDER BY dt ROWS UNBOUNDED PRECEDING)
  FROM #CAL
)
UPDATE c
SET CumBusinessDays = x.cum
FROM #CAL c
JOIN X ON X.dt = c.dt;

--+----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
-- 4) ND por guía (preagregado)
--+----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
IF OBJECT_ID('tempdb..#ND') IS NOT NULL DROP TABLE #ND;

SELECT NUMERO_GUIA,
       SUM(ISNULL(ND_HORAS,0)) AS HORAS_ND
INTO #ND
FROM SIG_COLOMBIA_DW.TMP.MPCCO_PROMESA_ND WITH (NOLOCK)
GROUP BY NUMERO_GUIA;




CREATE UNIQUE CLUSTERED INDEX IX_ND_GUIA ON #ND(NUMERO_GUIA);

--+----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
-- 5) CONCEPTO por guía (ajustado a legado)
--    - Proceso 21: 2 más recientes (DESC)
--    - Sábado vía DATEPART(WEEKDAY)=7 (con DATEFIRST 1)
--+----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
IF OBJECT_ID('tempdb..#CONCEPTO') IS NOT NULL DROP TABLE #CONCEPTO;

;WITH PP AS (
    SELECT P.NUMERO_GUIA, P.ID_PROCESO, P.ID_CONCEPTO, P.FECHA_HORA_MOVIMIENTO
    FROM SIG_COL_LOGISTICA_DW.TMP.MPCCO_PROMESA_PROCESOS P WITH (NOLOCK)
),
PP21 AS (
    SELECT
        NUMERO_GUIA, ID_PROCESO, ID_CONCEPTO, FECHA_HORA_MOVIMIENTO,
        ROW_NUMBER() OVER (
          PARTITION BY NUMERO_GUIA
          ORDER BY FECHA_HORA_MOVIMIENTO DESC
        ) AS rn
    FROM PP
    WHERE ID_PROCESO = 21
),
PP21_TOP2 AS (
    SELECT * FROM PP21 WHERE rn &lt;= 2
),
FLAGS AS (
    SELECT
        X.NUMERO_GUIA,
        MAX(X.Flag_21_71)     AS has_21_71,
        MAX(X.Flag_21_72)     AS has_21_72,
        MAX(X.Flag_9_IN)      AS has_9_in,
        MAX(X.Flag_21_73_SAT) AS has_21_73_sat
    FROM (
        -- Proceso 21 (top 2)
        SELECT
            T.NUMERO_GUIA,
            CASE WHEN T.ID_CONCEPTO = 71 THEN 1 ELSE 0 END AS Flag_21_71,
            CASE WHEN T.ID_CONCEPTO = 72 THEN 1 ELSE 0 END AS Flag_21_72,
            0 AS Flag_9_IN,
            CASE WHEN T.ID_CONCEPTO = 73
                      AND DATEPART(WEEKDAY, CAST(T.FECHA_HORA_MOVIMIENTO AS date)) = 7
                 THEN 1 ELSE 0 END AS Flag_21_73_SAT
        FROM PP21_TOP2 T

        UNION ALL

        -- Proceso 9
        SELECT
            P.NUMERO_GUIA,
            0, 0,
            CASE WHEN P.ID_PROCESO = 9 AND P.ID_CONCEPTO IN (2,4,7,9) THEN 1 ELSE 0 END,
            0
        FROM PP P
    ) X
    GROUP BY X.NUMERO_GUIA
)
SELECT
    F.NUMERO_GUIA,
    ID_CONCEPTO =
        CASE
            WHEN F.has_21_71     = 1 THEN '2'
            WHEN F.has_21_72     = 1 THEN '3'
            WHEN F.has_9_in      = 1 THEN '4'
            WHEN F.has_21_73_sat = 1 THEN '5'
            ELSE '1'
        END
INTO #CONCEPTO
FROM FLAGS F;

CREATE UNIQUE CLUSTERED INDEX IX_CONC_GUIA ON #CONCEPTO(NUMERO_GUIA);

--+----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
-- 6) Rutas activas por combinación
--+----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
IF OBJECT_ID('tempdb..#ROUTE_MAP') IS NOT NULL DROP TABLE #ROUTE_MAP;

SELECT
   MAX(ID_RUTA) AS ID_RUTA,
   ID_CIUDAD_ORIGEN,
   ID_CIUDAD_DESTINO,
   ID_TIEMPO,
   ID_MEDTRANS
INTO #ROUTE_MAP
FROM DIM.RED_OPERATIVA_RUTA WITH (NOLOCK)
WHERE ID_ESTADO_RUTA = 1
GROUP BY ID_CIUDAD_ORIGEN, ID_CIUDAD_DESTINO, ID_TIEMPO, ID_MEDTRANS;

CREATE UNIQUE CLUSTERED INDEX IX_RMAP_KEYS
ON #ROUTE_MAP(ID_CIUDAD_ORIGEN, ID_CIUDAD_DESTINO, ID_TIEMPO, ID_MEDTRANS);
CREATE NONCLUSTERED INDEX IX_RMAP_RUTA ON #ROUTE_MAP(ID_RUTA);

--+----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
-- 7) Carga TMP (set-based) con DEDUP del origen PROMESA
--    DEDUP por NUMERO_GUIA + FECHA(date) para no colapsar días distintos
--+----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+

-- TRUNCATE solo si hay datos a procesar (ya validado con @has)
TRUNCATE TABLE TMP.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA;


---------------------------&gt; NUEVAS COLUMNAS

--ALTER TABLE  TMP.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA ADD  [ULT_MOV_FECHA_HORA_MOVIMIENTO] datetime
--ALTER TABLE  TMP.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA ADD  [ULT_MOV_ID_PROCESO] smallint
--ALTER TABLE  TMP.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA ADD  [ULT_MOV_NUMERO_MOVIMI] varchar(30)
--ALTER TABLE  TMP.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA ADD  [ULT_MOV_CONSECUT_MOVIMI] numeric(7,0)


INSERT INTO TMP.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA
(
	 TIME_ID, FECHA, DIA, MES, AÑO,
	 ID_CIUDAD_ORIGEN, ID_CIUDAD_DESTINO, ID_ESTADOENVIO, ID_PRODUCTO, ID_SUBPRODUCTO, ID_CLIENTE,
	 ID_CONCEPTO, ID_TIEMPO_ENTREGA, ID_MEDTRANS,
	 NUMERO_GUIA,
	 TIEMPO_PROMESA_H,
	 TIEMPO_PROMESA_CUMPLE_H,
	 HORAS_ND, ID_ESTADO_ND,
	 GR_ID_TIPO_COBRO,
	 [ULT_MOV_FECHA_HORA_MOVIMIENTO],
	 [ULT_MOV_ID_PROCESO], 
	 [ULT_MOV_NUMERO_MOVIMI], 
	 [ULT_MOV_CONSECUT_MOVIMI] 
)
SELECT
   CONVERT(NUMERIC, CONVERT(DATETIME, CONVERT(CHAR(11), EM.FECHA)))        AS TIME_ID,
   CONVERT(DATETIME, CONVERT(CHAR(11), EM.FECHA))                          AS FECHA,
   DAY(EM.FECHA)                                                           AS DIA,
   MONTH(EM.FECHA)                                                         AS MES,
   YEAR(EM.FECHA)                                                          AS AÑO,
   ISNULL(EM.ID_CIUDAD_ORIGEN,0),
   ISNULL(EM.ID_CIUDAD_DESTINO,0),
   EM.ID_ESTADOENVIO,
   EM.ID_PRODUCTO,
   EM.ID_SUBPRODUCTO,
   EM.ID_CLIENTE,
   COALESCE(CPT.ID_CONCEPTO, '1')                                          AS ID_CONCEPTO,
   ISNULL(EM.ID_TIEMPO_ENTREGA,0),
   ISNULL(EM.ID_MEDTRANS,0),
   EM.NUMERO_GUIA,

   -- Tiempo hábil (minutos/60) — usar 0 si no hay cálculo, para no perder fila
   ISNULL(CA.time_minutes / 60.0, 0)                                       AS TIEMPO_PROMESA_H,

   -- Cumplimiento para 2 (hoy) y 3 (cero) igual al legado
   CASE
      WHEN EM.ID_TIEMPO_ENTREGA = 2 THEN
           CASE WHEN ISNULL(ND.HORAS_ND,0) &gt; 0 THEN
                    CASE WHEN CONVERT(date, EM.FECHA_ENTREGA_DEF) IN (CONVERT(date, EM.FECHA),
                                                                     DATEADD(DAY,1,CONVERT(date, EM.FECHA)))
                         THEN 'SI' ELSE 'NO' END
                ELSE
                    CASE WHEN CONVERT(date, EM.FECHA_ENTREGA_DEF) = CONVERT(date, EM.FECHA)
                         THEN 'SI' ELSE 'NO' END
           END
      WHEN EM.ID_TIEMPO_ENTREGA = 3 THEN
           CASE WHEN ISNULL(ND.HORAS_ND,0) &gt; 0 THEN
                    CASE WHEN EM.FECHA_ENTREGA_DEF &lt; DATEADD(DAY, 1, CONVERT(DATETIME, CONVERT(date, EM.FECHA_VIGENTE)))
                         THEN 'SI' ELSE 'NO' END
                ELSE
                    CASE WHEN EM.FECHA_ENTREGA_DEF &lt;= EM.FECHA_VIGENTE
                         THEN 'SI' ELSE 'NO' END
           END
      ELSE NULL
   END                                                                      AS TIEMPO_PROMESA_CUMPLE_H,

   ISNULL(ND.HORAS_ND,0)                                                   AS HORAS_ND,
   CASE WHEN ISNULL(ND.HORAS_ND,0) &gt; 0 THEN 'SI' ELSE 'NO' END             AS ID_ESTADO_ND,
   EM.GR_ID_TIPO_COBRO,
	[ULT_MOV_FECHA_HORA_MOVIMIENTO],
	[ULT_MOV_ID_PROCESO], 
	[ULT_MOV_NUMERO_MOVIMI], 
	[ULT_MOV_CONSECUT_MOVIMI] 
FROM (
   /* ===== DEDUP de PROMESA: 1 fila por NUMERO_GUIA + FECHA(date) ===== */
   SELECT
      P.NUMERO_GUIA,
      P.ID_CIUDAD_ORIGEN, P.ID_CIUDAD_DESTINO, P.ID_ESTADOENVIO,
      P.ID_PRODUCTO, P.ID_SUBPRODUCTO, P.ID_CLIENTE,
      P.ID_TIEMPO_ENTREGA, P.ID_MEDTRANS,
      P.FECHA,
      CAST(P.FECHA AS date) AS FECHA_ENVIO_D,
      CAST(ISNULL(P.FECHA_ENTREGA, CONVERT(DATETIME, CONVERT(date, GETDATE()))) AS datetime) AS FECHA_ENTREGA_DEF,
      CAST(ISNULL(P.FECHA_ENTREGA, GETDATE()) AS date) AS FECHA_ENTREGA_D,
      P.FECHA_VIGENTE,
      P.GR_ID_TIPO_COBRO,
	  P.[ULT_MOV_FECHA_HORA_MOVIMIENTO],
	  P.[ULT_MOV_ID_PROCESO], 
	  P.[ULT_MOV_NUMERO_MOVIMI], 
	  P.[ULT_MOV_CONSECUT_MOVIMI] 
   FROM (
     SELECT *
     FROM (
       SELECT P.*,
              ROW_NUMBER() OVER (
                PARTITION BY P.NUMERO_GUIA, CAST(P.FECHA AS date)   -- &lt;&lt; clave
                ORDER BY ISNULL(P.FECHA_ENTREGA, P.FECHA) DESC,
                         P.FECHA DESC,
                         P.FECHA_VIGENTE DESC
              ) AS rn
       FROM SIG_COL_LOGISTICA_DW.TMP.MPCCO_PROMESA P WITH (NOLOCK)
     ) z
     WHERE z.rn = 1
   ) P
   /* ===== fin DEDUP ===== */
) EM
/* === OUTER APPLY + LEFT JOIN a CE, y forzamos fila para 2/3 === */
OUTER APPLY (
   SELECT
     (CE.CumBusinessDays - ISNULL(CSPrev.CumBusinessDays, 0)) * 1440
     - CASE WHEN CS.IsBusinessDay = 1 THEN DATEDIFF(MINUTE, EM.FECHA_ENVIO_D, EM.FECHA) ELSE 0 END
     - CASE WHEN CE.IsBusinessDay = 1 THEN DATEDIFF(MINUTE, EM.FECHA_ENTREGA_DEF, DATEADD(DAY,1,EM.FECHA_ENTREGA_D)) ELSE 0 END
     AS time_minutes
   FROM #CAL CS
   LEFT JOIN #CAL CSPrev ON CSPrev.dt = DATEADD(DAY, -1, CS.dt)
   LEFT JOIN #CAL CE     ON CE.dt = EM.FECHA_ENTREGA_D
   WHERE CS.dt = EM.FECHA_ENVIO_D
      OR EM.ID_TIEMPO_ENTREGA IN (2,3)
) CA
LEFT JOIN #CONCEPTO CPT ON CPT.NUMERO_GUIA = EM.NUMERO_GUIA
LEFT JOIN #ND ND        ON ND.NUMERO_GUIA  = EM.NUMERO_GUIA;

--+----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
-- 8) “Seguro” de DEDUP en TMP (por si algo coló)
--    DEDUP por FECHA + NUMERO_GUIA (no solo por guía)
--+----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
;WITH DEDUP AS (
  SELECT *,
         ROW_NUMBER() OVER (
           PARTITION BY FECHA, NUMERO_GUIA
           ORDER BY TIME_ID DESC
         ) AS rn
  FROM TMP.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA
)
DELETE FROM DEDUP WHERE rn &gt; 1;

-- Índice útil para siguientes pasos
IF NOT EXISTS (
  SELECT 1 FROM sys.indexes
  WHERE object_id = OBJECT_ID('TMP.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA')
    AND name = 'IX_TMP_PROMESA_NUMERO_GUIA'
)
CREATE NONCLUSTERED INDEX IX_TMP_PROMESA_NUMERO_GUIA
ON TMP.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA (NUMERO_GUIA);

--+----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
-- 9) Asignar ID_RUTA por combinación
--+----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
UPDATE T
SET T.ID_RUTA = ISNULL(RM.ID_RUTA, 0)
FROM TMP.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA T
LEFT JOIN #ROUTE_MAP RM
  ON T.ID_CIUDAD_ORIGEN = RM.ID_CIUDAD_ORIGEN
 AND T.ID_CIUDAD_DESTINO = RM.ID_CIUDAD_DESTINO
 AND T.ID_TIEMPO_ENTREGA = RM.ID_TIEMPO
 AND T.ID_MEDTRANS      = RM.ID_MEDTRANS;

--+----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
-- 10) Tiempo de oferta y grupo de red
--+----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
UPDATE T
SET
  T.TIEMPO_OFERTA = R.TIEMPO_ENTREGA_COMERCIAL_HOR,
  T.ID_GRUPO_RED  = CASE
                      WHEN R.ID_RUTA = 0 THEN 0
                      WHEN R.TIEMPO_ENTREGA_COMERCIAL_HOR BETWEEN 0   AND 36  THEN 1
                      WHEN R.TIEMPO_ENTREGA_COMERCIAL_HOR BETWEEN 37  AND 60  THEN 2
                      WHEN R.TIEMPO_ENTREGA_COMERCIAL_HOR BETWEEN 61  AND 84  THEN 3
                      WHEN R.TIEMPO_ENTREGA_COMERCIAL_HOR BETWEEN 85  AND 108 THEN 4
                      ELSE 5
                    END
FROM TMP.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA T
LEFT JOIN DIM.RED_OPERATIVA_RUTA R WITH (NOLOCK)
  ON T.ID_RUTA = R.ID_RUTA;

--+----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
-- 11) Cumplimiento por bandas (general)
--+----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
UPDATE T
SET T.TIEMPO_PROMESA_CUMPLE_H =
  CASE
    WHEN T.TIEMPO_PROMESA_H &gt;
         (CASE
            WHEN T.ID_RUTA = 0 THEN 0
            WHEN T.TIEMPO_OFERTA &lt;= 36 THEN (36 + T.HORAS_ND)
            WHEN T.TIEMPO_OFERTA &gt; 36 AND (T.TIEMPO_OFERTA + T.HORAS_ND) &lt;= 60 THEN (60 + T.HORAS_ND)
            WHEN T.TIEMPO_OFERTA &gt; 60 AND (T.TIEMPO_OFERTA + T.HORAS_ND) &lt;= 84 THEN (84 + T.HORAS_ND)
            WHEN T.TIEMPO_OFERTA &gt; 84 AND (T.TIEMPO_OFERTA + T.HORAS_ND) &lt;= 108 THEN (108 + T.HORAS_ND)
            ELSE T.TIEMPO_OFERTA + T.HORAS_ND
          END)
      THEN 'NO' ELSE 'SI'
  END
FROM TMP.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA AS T
WHERE T.ID_TIEMPO_ENTREGA NOT IN (2,3)
  AND T.TIEMPO_PROMESA_CUMPLE_H IS NULL;

--+----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
-- 12) Sincronización con FAC
--+----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+


DELETE FAC
FROM TMP.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA TMP
INNER JOIN FAC.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA FAC
ON FAC.NUMERO_GUIA=TMP.NUMERO_GUIA

;WITH CTE AS(
SELECT
ROW_DEL = ROW_NUMBER() OVER(PARTITION BY NUMERO_GUIA ORDER BY FECHA ASC) 
,NUMERO_GUIA
FROM FAC.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA
)DELETE CTE WHERE  ROW_DEL &gt;1

  ------------------------------------------------------NUEVAS COLUMNAS
--ALTER TABLE  FAC.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA ADD  [ULT_MOV_FECHA_HORA_MOVIMIENTO] datetime
--ALTER TABLE  FAC.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA ADD  [ULT_MOV_ID_PROCESO] smallint
--ALTER TABLE  FAC.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA ADD  [ULT_MOV_NUMERO_MOVIMI] varchar(30)
--ALTER TABLE  FAC.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA ADD  [ULT_MOV_CONSECUT_MOVIMI] numeric(7,0)
--ALTER TABLE FAC.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA ADD FEHCA_INSERT DATETIME
INSERT INTO FAC.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA
(
   TIME_ID, FECHA, DIA, MES, AÑO,
   ID_CIUDAD_ORIGEN, ID_CIUDAD_DESTINO, ID_CLIENTE,
   ID_ESTADOENVIO, ID_PRODUCTO, ID_SUBPRODUCTO, ID_PROD_SUBP,
   ID_TIEMPO_ENTREGA, NUMERO_GUIA,
   ID_RUTA, ID_GRUPO_RED,
   TIEMPO_PROMESA_H, TIEMPO_OFERTA, TIEMPO_PROMESA_CUMPLE_H,
   ID_GEOGRAFIA_CONCEPTO,
   HORAS_ND, ID_ESTADO_ND,
   GR_ID_TIPO_COBRO,
   [ULT_MOV_FECHA_HORA_MOVIMIENTO],
   [ULT_MOV_ID_PROCESO], 
   [ULT_MOV_NUMERO_MOVIMI], 
   [ULT_MOV_CONSECUT_MOVIMI],
   FEHCA_INSERT
)
SELECT
   T.TIME_ID, T.FECHA, T.DIA, T.MES, T.AÑO,
   T.ID_CIUDAD_ORIGEN, T.ID_CIUDAD_DESTINO, T.ID_CLIENTE,
   T.ID_ESTADOENVIO, T.ID_PRODUCTO, T.ID_SUBPRODUCTO,
   RIGHT('00' + CONVERT(varchar, T.ID_PRODUCTO), 2)
   + RIGHT('0000' + CONVERT(varchar, T.ID_SUBPRODUCTO), 4) AS ID_PROD_SUBP,
   T.ID_TIEMPO_ENTREGA, T.NUMERO_GUIA,
   T.ID_RUTA, T.ID_GRUPO_RED,
   T.TIEMPO_PROMESA_H, T.TIEMPO_OFERTA, T.TIEMPO_PROMESA_CUMPLE_H,
   CONVERT(varchar, G.ID_REGIONAL) + '-' + CONVERT(varchar, T.ID_CONCEPTO) AS ID_GEOGRAFIA_CONCEPTO,
   T.HORAS_ND, T.ID_ESTADO_ND,
   T.GR_ID_TIPO_COBRO,
   T.[ULT_MOV_FECHA_HORA_MOVIMIENTO],
   T.[ULT_MOV_ID_PROCESO], 
   T.[ULT_MOV_NUMERO_MOVIMI], 
   T.[ULT_MOV_CONSECUT_MOVIMI], 
   GETDATE() AS FEHCA_INSERT
FROM TMP.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA AS T
LEFT JOIN SIG_COLOMBIA_DW.DIM.GEOGRAFIA AS G WITH (NOLOCK)
  ON T.ID_CIUDAD_DESTINO = G.ID_CIUDAD;






DELETE FAC.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA WHERE FECHA &lt; DATEADD(mm,-3,DATEADD(mm,DATEDIFF(mm,0,GETDATE()),0)) 


</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{26E11708-6194-4665-90DC-17A77E7344FB}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot;WITH CTE&#xA;(&#xA;     NUMERO_GUIA&#xA;    ,FECHA&#xA;    ,ID_PAIS_ORIGEN&#xA;    ,ID_CIUDAD_ORIGEN&#xA;    ,ID_PAIS_DESTINO&#xA;    ,ID_CIUDAD_DESTINO&#xA;    ,ID_TIPOGUIA&#xA;    ,ID_CLIENTE&#xA;    ,ID_ESTADOENVIO&#xA;    ,ID_DOCU_ULT_MOVI&#xA;    ,ID_MEDTRANS&#xA;    ,ID_PRODUCTO&#xA;    ,ID_SUBPRODUCTO&#xA;    ,ID_ESTADOGUIA&#xA;    ,ID_TIEMPO_ENTREGA&#xA;    ,ID_REQ_EMBALAJE&#xA;    ,NUMERO_PIEZAS&#xA;    ,FECHA_ENTREGA&#xA;    ,FECHA_MODIFICACION&#xA;&#x9;,[ULT_MOV_FECHA_HORA_MOVIMIENTO]&#xA;&#x9;,[ULT_MOV_ID_PROCESO] &#xA;&#x9;,[ULT_MOV_NUMERO_MOVIMI] &#xA;&#x9;,[ULT_MOV_CONSECUT_MOVIMI]&#xA;)&#xA;AS&#xA;(&#xA;    SELECT &#xA;         EV.NUMERO_GUIA&#xA;        ,EV.FECHA_ENVIO AS FECHA&#xA;        ,EV.ID_PAIS_ORIGEN&#xA;        ,EV.ID_CIUDAD_ORIGEN&#xA;        ,EV.ID_PAIS_DESTINO&#xA;        ,EV.ID_CIUDAD_DESTINO&#xA;        ,EV.ID_TIPOGUIA&#xA;        ,EV.ID_CLIENTE&#xA;        ,EV.ID_ESTADOENVIO&#xA;        ,EV.ID_DOCU_ULT_MOVI&#xA;        ,EV.ID_MEDTRANS&#xA;        ,EV.ID_PRODUCTO&#xA;        ,EV.ID_SUBPRODUCTO&#xA;        ,EV.ID_ESTADOGUIA&#xA;        ,EV.ID_TIEMPO_ENTREGA&#xA;        ,EV.ID_REQ_EMBALAJE&#xA;        ,EV.NUMERO_PIEZAS&#xA;        ,EV.FECHA_ENTREGA&#xA;        ,EV.FECHA_MODIFICACION&#xA;&#x9;&#x9;,[ULT_MOV_FECHA_HORA_MOVIMIENTO]&#xA;&#x9;&#x9;,[ULT_MOV_ID_PROCESO] &#xA;&#x9;&#x9;,[ULT_MOV_NUMERO_MOVIMI] &#xA;&#x9;&#x9;,[ULT_MOV_CONSECUT_MOVIMI]&#xA;    FROM &quot; + @[User::CONN_SIG_COL_LOGISTICA_DW] + &quot;.&quot; + @[User::TBL_TMP_ENVIOS_MOV] + &quot; EV WITH (NOLOCK)&#xA;)&#xA;INSERT INTO &quot; + @[User::TBL_TMP_PROMESA] + &quot;&#xA;(&#xA;     NUMERO_GUIA&#xA;    ,FECHA&#xA;    ,ID_PAIS_ORIGEN&#xA;    ,ID_CIUDAD_ORIGEN&#xA;    ,ID_PAIS_DESTINO&#xA;    ,ID_CIUDAD_DESTINO&#xA;    ,ID_TIPOGUIA&#xA;    ,ID_CLIENTE&#xA;    ,ID_ESTADOENVIO&#xA;    ,ID_DOCU_ULT_MOVI&#xA;    ,ID_MEDTRANS&#xA;    ,ID_PRODUCTO&#xA;    ,ID_SUBPRODUCTO&#xA;    ,ID_ESTADOGUIA&#xA;    ,ID_TIEMPO_ENTREGA&#xA;    ,ID_REQ_EMBALAJE&#xA;    ,NUMERO_PIEZAS&#xA;    ,FECHA_ENTREGA&#xA;    ,FECHA_MODIFICACION&#xA;&#x9;,[ULT_MOV_FECHA_HORA_MOVIMIENTO]&#xA;&#x9;,[ULT_MOV_ID_PROCESO] &#xA;&#x9;,[ULT_MOV_NUMERO_MOVIMI] &#xA;&#x9;,[ULT_MOV_CONSECUT_MOVIMI]&#xA;)&#xA;SELECT&#xA;     CTE.NUMERO_GUIA&#xA;    ,CTE.FECHA&#xA;    ,CTE.ID_PAIS_ORIGEN&#xA;    ,CTE.ID_CIUDAD_ORIGEN&#xA;    ,CTE.ID_PAIS_DESTINO&#xA;    ,CTE.ID_CIUDAD_DESTINO&#xA;    ,CTE.ID_TIPOGUIA&#xA;    ,CTE.ID_CLIENTE&#xA;    ,CTE.ID_ESTADOENVIO&#xA;    ,CTE.ID_DOCU_ULT_MOVI&#xA;    ,CTE.ID_MEDTRANS&#xA;    ,CTE.ID_PRODUCTO&#xA;    ,CTE.ID_SUBPRODUCTO&#xA;    ,CTE.ID_ESTADOGUIA&#xA;    ,CTE.ID_TIEMPO_ENTREGA&#xA;    ,CTE.ID_REQ_EMBALAJE&#xA;    ,CTE.NUMERO_PIEZAS&#xA;    ,CTE.FECHA_ENTREGA&#xA;    ,CTE.FECHA_MODIFICACION&#xA;&#x9;,CTE.[ULT_MOV_FECHA_HORA_MOVIMIENTO]&#xA;&#x9;,CTE.[ULT_MOV_ID_PROCESO] &#xA;&#x9;,CTE.[ULT_MOV_NUMERO_MOVIMI] &#xA;&#x9;,CTE.[ULT_MOV_CONSECUT_MOVIMI]&#xA;FROM CTE&#xA;LEFT OUTER JOIN &quot; + @[User::CONN_SIG_COLOMBIA_DW] + &quot;.&quot; + @[User::TBL_TMP_PROMESA] + &quot; PR WITH (NOLOCK)&#xA;  ON CTE.NUMERO_GUIA = PR.NUMERO_GUIA&#xA;WHERE PR.NUMERO_GUIA IS NULL&#xA;  AND CTE.FECHA &gt;= '&quot; + @[User::VAL_fechaIni] + &quot;'&#xA;  AND CTE.FECHA &lt;= '&quot; + @[User::VAL_fechaFin] + &quot;'&quot;"
      DTS:IncludeInDebugDump="2345"
