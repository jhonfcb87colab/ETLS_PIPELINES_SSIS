      DTS:Expression="&quot;TRUNCATE TABLE &quot;+ @[User::TBL_TMP_PROMESA] +&quot;&#xA;&#xA;TRUNCATE TABLE &quot;+ @[User::TBL_TMP_PROMESA_FECHA] +&quot;&quot;"
