      DTS:Expression="&quot;TRUNCATE TABLE &quot;+ @[User::TBL_TMP_PROMESA_1] +&quot;&#xA;TRUNCATE TABLE &quot;+ @[User::TBL_TMP_PROMESA_2] +&quot;&#xA;TRUNCATE TABLE &quot;+ @[User::TBL_TMP_PROMESA_3] +&quot;&#xA;TRUNCATE TABLE &quot;+ @[User::TBL_TMP_PROMESA] +&quot;&quot;"
