        <DTS:Executable
          DTS:refId="Package\EXTRACCION PROMESA\SQL_SELECT_INSERT_Guias_Faltantes"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{1FB2F185-696A-4A6D-9073-72908B2F0964}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="SQL_SELECT_INSERT_Guias_Faltantes"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{CE05DB66-31E1-4BF7-B85A-81929B965F18}"
              SQLTask:SqlStatementSource="DECLARE @FechaInicioFinal DATE;&#xA;DECLARE @FechaFinFinal    DATE;&#xA;&#xA;&#xA;&#xA;IF DATEPART(HOUR, GETDATE()) &gt;= 19&#xA;   AND DATEPART(HOUR, GETDATE()) &lt;= 23&#xA;BEGIN&#xA;&#xA;    SET @FechaInicioFinal = ?;&#xA;    SET @FechaFinFinal    = ?;&#xA;END&#xA;ELSE&#xA;BEGIN&#xA;&#xA;&#xA;    SET @FechaInicioFinal = CONVERT(DATE,DATEADD(DAY, -10, GETDATE()));&#xA;    SET @FechaFinFinal    = CONVERT(DATE, GETDATE());&#xA;END;&#xA;&#xA;WITH CTE&#xA;(&#xA;     NUMERO_GUIA&#xA;    ,FECHA&#xA;    ,ID_PAIS_ORIGEN&#xA;    ,ID_CIUDAD_ORIGEN&#xA;    ,ID_PAIS_DESTINO&#xA;    ,ID_CIUDAD_DESTINO&#xA;    ,ID_TIPOGUIA&#xA;    ,ID_CLIENTE&#xA;    ,ID_ESTADOENVIO&#xA;    ,ID_DOCU_ULT_MOVI&#xA;    ,ID_MEDTRANS&#xA;    ,ID_PRODUCTO&#xA;    ,ID_SUBPRODUCTO&#xA;    ,ID_ESTADOGUIA&#xA;    ,ID_TIEMPO_ENTREGA&#xA;    ,ID_REQ_EMBALAJE&#xA;    ,NUMERO_PIEZAS&#xA;    ,FECHA_ENTREGA&#xA;    ,FECHA_MODIFICACION&#xA;&#x9;,[ULT_MOV_FECHA_HORA_MOVIMIENTO]&#xA;&#x9;,[ULT_MOV_ID_PROCESO] &#xA;&#x9;,[ULT_MOV_NUMERO_MOVIMI] &#xA;&#x9;,[ULT_MOV_CONSECUT_MOVIMI]&#xA;)&#xA;AS&#xA;(&#xA;    SELECT &#xA;         EV.NUMERO_GUIA&#xA;        ,EV.FECHA_ENVIO AS FECHA&#xA;        ,EV.ID_PAIS_ORIGEN&#xA;        ,EV.ID_CIUDAD_ORIGEN&#xA;        ,EV.ID_PAIS_DESTINO&#xA;        ,EV.ID_CIUDAD_DESTINO&#xA;        ,EV.ID_TIPOGUIA&#xA;        ,EV.ID_CLIENTE&#xA;        ,EV.ID_ESTADOENVIO&#xA;        ,EV.ID_DOCU_ULT_MOVI&#xA;        ,EV.ID_MEDTRANS&#xA;        ,EV.ID_PRODUCTO&#xA;        ,EV.ID_SUBPRODUCTO&#xA;        ,EV.ID_ESTADOGUIA&#xA;        ,EV.ID_TIEMPO_ENTREGA&#xA;        ,EV.ID_REQ_EMBALAJE&#xA;        ,EV.NUMERO_PIEZAS&#xA;        ,EV.FECHA_ENTREGA&#xA;        ,EV.FECHA_MODIFICACION&#xA;&#x9;&#x9;,[ULT_MOV_FECHA_HORA_MOVIMIENTO]&#xA;&#x9;&#x9;,[ULT_MOV_ID_PROCESO] &#xA;&#x9;&#x9;,[ULT_MOV_NUMERO_MOVIMI] &#xA;&#x9;&#x9;,[ULT_MOV_CONSECUT_MOVIMI]&#xA;    FROM SIG_COL_LOGISTICA_DW.TMP.MPCCO_ENVIOS_MOV EV WITH (NOLOCK)&#xA;)&#xA;INSERT INTO TMP.MPCCO_PROMESA&#xA;(&#xA;     NUMERO_GUIA&#xA;    ,FECHA&#xA;    ,ID_PAIS_ORIGEN&#xA;    ,ID_CIUDAD_ORIGEN&#xA;    ,ID_PAIS_DESTINO&#xA;    ,ID_CIUDAD_DESTINO&#xA;    ,ID_TIPOGUIA&#xA;    ,ID_CLIENTE&#xA;    ,ID_ESTADOENVIO&#xA;    ,ID_DOCU_ULT_MOVI&#xA;    ,ID_MEDTRANS&#xA;    ,ID_PRODUCTO&#xA;    ,ID_SUBPRODUCTO&#xA;    ,ID_ESTADOGUIA&#xA;    ,ID_TIEMPO_ENTREGA&#xA;    ,ID_REQ_EMBALAJE&#xA;    ,NUMERO_PIEZAS&#xA;    ,FECHA_ENTREGA&#xA;    ,FECHA_MODIFICACION&#xA;&#x9;,[ULT_MOV_FECHA_HORA_MOVIMIENTO]&#xA;&#x9;,[ULT_MOV_ID_PROCESO] &#xA;&#x9;,[ULT_MOV_NUMERO_MOVIMI] &#xA;&#x9;,[ULT_MOV_CONSECUT_MOVIMI]&#xA;)&#xA;SELECT&#xA;     CTE.NUMERO_GUIA&#xA;    ,CTE.FECHA&#xA;    ,CTE.ID_PAIS_ORIGEN&#xA;    ,CTE.ID_CIUDAD_ORIGEN&#xA;    ,CTE.ID_PAIS_DESTINO&#xA;    ,CTE.ID_CIUDAD_DESTINO&#xA;    ,CTE.ID_TIPOGUIA&#xA;    ,CTE.ID_CLIENTE&#xA;    ,CTE.ID_ESTADOENVIO&#xA;    ,CTE.ID_DOCU_ULT_MOVI&#xA;    ,CTE.ID_MEDTRANS&#xA;    ,CTE.ID_PRODUCTO&#xA;    ,CTE.ID_SUBPRODUCTO&#xA;    ,CTE.ID_ESTADOGUIA&#xA;    ,CTE.ID_TIEMPO_ENTREGA&#xA;    ,CTE.ID_REQ_EMBALAJE&#xA;    ,CTE.NUMERO_PIEZAS&#xA;    ,CTE.FECHA_ENTREGA&#xA;    ,CTE.FECHA_MODIFICACION&#xA;&#x9;,CTE.[ULT_MOV_FECHA_HORA_MOVIMIENTO]&#xA;&#x9;,CTE.[ULT_MOV_ID_PROCESO] &#xA;&#x9;,CTE.[ULT_MOV_NUMERO_MOVIMI] &#xA;&#x9;,CTE.[ULT_MOV_CONSECUT_MOVIMI]&#xA;FROM CTE&#xA;LEFT OUTER JOIN SIG_COLOMBIA_DW.TMP.MPCCO_PROMESA PR WITH (NOLOCK)&#xA;  ON CTE.NUMERO_GUIA = PR.NUMERO_GUIA&#xA;WHERE PR.NUMERO_GUIA IS NULL&#xA;  AND CTE.FECHA &gt;=  @FechaInicioFinal&#xA;  AND CTE.FECHA &lt;= @FechaFinFinal" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="0"
                SQLTask:DtsVariableName="User::VAL_fechaIni"
                SQLTask:ParameterDirection="Input"
                SQLTask:DataType="129"
                SQLTask:ParameterSize="-1" />
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="1"
                SQLTask:DtsVariableName="User::VAL_fechaFin"
                SQLTask:ParameterDirection="Input"
                SQLTask:DataType="129"
                SQLTask:ParameterSize="-1" />
            </SQLTask:SqlTaskData>
          </DTS:ObjectData>
        </DTS:Executable>
