                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">DECLARE @FechaInicioFinal DATE;
DECLARE @FechaFinFinal    DATE;


IF DATEPART(HOUR, GETDATE()) &gt;= 19
   AND DATEPART(HOUR, GETDATE()) &lt;= 23
BEGIN

    SET @FechaInicioFinal = ?;
    SET @FechaFinFinal    = ?;
END
ELSE
BEGIN


    SET @FechaInicioFinal = CONVERT(DATE,DATEADD(DAY, -10, GETDATE()));
    SET @FechaFinFinal    = CONVERT(DATE, GETDATE());
END;


SELECT
     DOCND.ID_PROCESO
    ,DOCND.NUMERO_MOVIMI
    ,DOCND.CONSECUT_MOVIMI
    ,DETND.ID_PAIS_UNO
    ,DETND.ID_CIUDAD_UNO
    ,DETND.ID_PAIS_DOS
    ,DETND.ID_CIUDAD_DOS
    ,DETND.ID_SUBTIPO_NOVEDAD
    ,DETND.ID_COURIER_CONDUCTOR
    ,DETND.PLACA_VEHICULO_DOCU
    ,DETND.UBICACION
    ,ND.ID_TIPO_NOVEDAD
    ,DETND.FECHA_NOVEDAD
    ,DETND.FECHA_HORA_ENTRADA_CIL
    ,DETND.FECHA_HORA_FIN_NOVEDAD
FROM SIG_COLOMBIA_DW.LOG.MPCCO_DETALLE_NOVEDAD_DIARIA DETND WITH (NOLOCK)
INNER JOIN SIG_COLOMBIA_DW.LOG.MPCCO_DOCUMENTOS_NOVEDAD_DIARIA DOCND WITH (NOLOCK) ON DETND.ID_PAIS_UNO = DOCND.ID_PAIS_UNO AND DETND.ID_CIUDAD_UNO = DOCND.ID_CIUDAD_UNO
INNER JOIN SIG_COLOMBIA_DW.LOG.MPCCO_NOVEDAD_DIARIA ND WITH (NOLOCK) ON DETND.ID_PAIS_UNO = ND.ID_PAIS_UNO AND DETND.ID_CIUDAD_UNO = ND.ID_CIUDAD_UNO
INNER JOIN SIG_COLOMBIA_DW.PAR.TIPOSNOVEDADESOPERATIVAS TNO ON ND.ID_TIPO_NOVEDAD = TNO.ID_TIPO_NOVEDAD
WHERE TNO.ES_NOVEDAD_EXTERNA = 1
  AND DETND.FECHA_NOVEDAD = DOCND.FECHA_NOVEDAD
  AND DETND.FECHA_NOVEDAD = ND.FECHA_NOVEDAD
  AND DETND.FECHA_NOVEDAD &gt;= @FechaInicioFinal
  AND DETND.FECHA_NOVEDAD &lt;= @FechaFinFinal
  AND DETND.FECHA_HORA_ENTRADA_CIL IS NOT NULL</property>
