      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot;SELECT [NUMERO_GUIA]&#xA;      ,[FECHA]&#xA;      ,[ID_PAIS_ORIGEN]&#xA;      ,[ID_CIUDAD_ORIGEN]&#xA;      ,[ID_PAIS_DESTINO]&#xA;      ,[ID_CIUDAD_DESTINO]&#xA;      ,[ID_TIPOGUIA]&#xA;      ,[ID_CLIENTE]&#xA;      ,[ID_ESTADOENVIO]&#xA;      ,[ID_DOCU_ULT_MOVI]&#xA;      ,[ID_MEDTRANS]&#xA;      ,[ID_PRODUCTO]&#xA;      ,[ID_SUBPRODUCTO]&#xA;      ,[ID_ESTADOGUIA]&#xA;      ,[ID_TIEMPO_ENTREGA]&#xA;      ,[ID_REQ_EMBALAJE]&#xA;      ,[NUMERO_PIEZAS]&#xA;      ,[FECHA_ENTREGA]&#xA;      ,[FECHA_MODIFICACION]&#xA;      ,ISNULL(GR_ID_TIPO_COBRO,&quot; +@[User::VAL_Default]+ &quot;) GR_ID_TIPO_COBRO&#xA;&#x9;,[ULT_MOV_FECHA_HORA_MOVIMIENTO]&#xA;&#x9;,[ULT_MOV_ID_PROCESO] &#xA;&#x9;,[ULT_MOV_NUMERO_MOVIMI] &#xA;&#x9;,[ULT_MOV_CONSECUT_MOVIMI]  &#xA;  FROM &quot;+ @[User::TBL_TMP_PROMESA] +&quot; WITH (NOLOCK)&quot;"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="SQL_SELECT_Promesa">
      <DTS:VariableValue
        DTS:DataType="8">SELECT [NUMERO_GUIA]
      ,[FECHA]
      ,[ID_PAIS_ORIGEN]
      ,[ID_CIUDAD_ORIGEN]
      ,[ID_PAIS_DESTINO]
      ,[ID_CIUDAD_DESTINO]
      ,[ID_TIPOGUIA]
      ,[ID_CLIENTE]
