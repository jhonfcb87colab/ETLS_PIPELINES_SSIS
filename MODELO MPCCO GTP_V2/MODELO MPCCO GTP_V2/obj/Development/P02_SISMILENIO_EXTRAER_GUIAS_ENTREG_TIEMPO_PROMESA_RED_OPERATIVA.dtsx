      ,[ID_ESTADOGUIA]
      ,[ID_TIEMPO_ENTREGA]
      ,[ID_REQ_EMBALAJE]
      ,[NUMERO_PIEZAS]
      ,[FECHA_ENTREGA]
      ,[FECHA_MODIFICACION]
      ,ISNULL(GR_ID_TIPO_COBRO,-888) GR_ID_TIPO_COBRO
	,[ULT_MOV_FECHA_HORA_MOVIMIENTO]
	,[ULT_MOV_ID_PROCESO] 
	,[ULT_MOV_NUMERO_MOVIMI] 
	,[ULT_MOV_CONSECUT_MOVIMI]  
  FROM TMP.MPCCO_PROMESA WITH (NOLOCK)</property>
