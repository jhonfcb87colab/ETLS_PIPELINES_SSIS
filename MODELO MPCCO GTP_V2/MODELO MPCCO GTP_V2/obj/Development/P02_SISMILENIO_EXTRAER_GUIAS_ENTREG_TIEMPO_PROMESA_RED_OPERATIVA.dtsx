    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{939E336A-3C79-4B29-80B5-5C7C488465F5}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot;SELECT &#xA;&#x9;&#x9;P.NUMERO_GUIA,S.ID_PROCESO,S.CONSECUT_MOVIMI,S.NUMERO_MOVIMI,S.FECHA_HORA_MOVIMIENTO&#xA;FROM&#xA;&#x9;&#x9;&quot;+ @[User::TBL_TMP_PROMESA] +&quot; P WITH (NOLOCK) &#xA;INNER JOIN&#xA;&#x9;&#x9;  &quot;+ @[User::CONN_SIG_COLOMBIA_DW] +&quot;.&quot;+ @[User::TBL_LOG_SEGUIMIENTO_ENVIO_6MESES] +&quot; S WITH (NOLOCK)&#xA;ON&#xA;&#x9;&#x9;P.NUMERO_GUIA = S.NUMERO_GUIA&#xA;WHERE S.ID_PROCESO = 12&quot;"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="SQL_SELECT_Promesa_nd_01">
      <DTS:VariableValue
        DTS:DataType="8">SELECT 
		P.NUMERO_GUIA,S.ID_PROCESO,S.CONSECUT_MOVIMI,S.NUMERO_MOVIMI,S.FECHA_HORA_MOVIMIENTO
FROM
		TMP.MPCCO_PROMESA P WITH (NOLOCK) 
INNER JOIN
		  SIG_COLOMBIA_DW.LOG.MPCCO_SEGUIMIENTO_ENVIO_6MESES S WITH (NOLOCK)
ON
		P.NUMERO_GUIA = S.NUMERO_GUIA
WHERE S.ID_PROCESO = 12</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{E5C348C0-BDF7-44AF-86F3-BF85AF737ADB}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot;SELECT [NUMERO_GUIA]&#xA;      ,[FECHA_HORA_MOVIMIENTO]&#xA;      ,[ID_PROCESO]&#xA;      ,[CONSECUT_MOVIMI]&#xA;      ,[NUMERO_MOVIMI]&#xA;      ,[PLACA_VEHICULO_DOCU]&#xA;      ,[ID_PAIS_DESTINO]&#xA;      ,[ID_CIUDAD_DESTINO]&#xA;      ,[HORA_CONTROL_MAXIMO_LLEGADA]&#xA;      ,[FECHA_HORA_ENTRADA_CIL]&#xA;  FROM &quot;+ @[User::TBL_TMP_PROMESA_ND04_01] +&quot; WITH (NOLOCK)&quot;"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="SQL_SELECT_Promesa_nd_04">
      <DTS:VariableValue
        DTS:DataType="8">SELECT [NUMERO_GUIA]
      ,[FECHA_HORA_MOVIMIENTO]
      ,[ID_PROCESO]
      ,[CONSECUT_MOVIMI]
      ,[NUMERO_MOVIMI]
      ,[PLACA_VEHICULO_DOCU]
      ,[ID_PAIS_DESTINO]
      ,[ID_CIUDAD_DESTINO]
      ,[HORA_CONTROL_MAXIMO_LLEGADA]
      ,[FECHA_HORA_ENTRADA_CIL]
  FROM TMP.MPCCO_PROMESA_ND04_01 WITH (NOLOCK)</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{B09202DE-FAD5-46AA-9971-FF6C8D91480B}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot;SELECT&#xA;&#x9;&#x9;      SE.NUMERO_GUIA&#xA;&#x9;&#x9;&#x9;,ISNULL(CASE&#xA;&#x9;&#x9;&#x9;&#x9;WHEN (CONVERT(TIME(7),SE.FECHA_HORA_ENTRADA_CIL) &gt; SE.HORA_CONTROL_MAXIMO_LLEGADA) AND (ND.ND_HORAS &gt; 24)&#xA;&#x9;&#x9;&#x9;&#x9;THEN 36&#xA;&#x9;&#x9;&#x9;&#x9;WHEN (CONVERT(TIME(7),SE.FECHA_HORA_ENTRADA_CIL) &gt; SE.HORA_CONTROL_MAXIMO_LLEGADA) AND (ND.ND_HORAS &lt;= 24)&#xA;&#x9;&#x9;&#x9;&#x9;THEN 24&#xA;&#x9;&#x9;&#x9;ELSE ND.ND_HORAS END,0) ND_HORAS&#x9;&#x9;&#x9;&#x9;&#xA;&#x9;&#x9;FROM&#x9;&#x9;&#xA;&#x9;&#x9;&quot;+ @[User::TBL_TMP_PROMESA_ND04] +&quot; SE WITH(NOLOCK)&#x9;&#x9;&#xA;&#x9;&#x9;INNER JOIN&#x9;&#x9;&#xA;&#x9;&#x9;&quot;+ @[User::TBL_TMP_PROMESA_ND05_01] +&quot; ND WITH(NOLOCK)&#x9;&#x9;&#xA;&#x9;&#x9;ON&#xA;&#x9;&#x9;&#x9;SE.[ID_PROCESO] = ND.[ID_PROCESO] AND&#xA;&#x9;&#x9;&#x9;SE.[NUMERO_MOVIMI] = ND.[NUMERO_MOVIMI] AND&#xA;&#x9;&#x9;&#x9;SE.[CONSECUT_MOVIMI] = ND.[CONSECUT_MOVIMI] AND&#xA;&#x9;&#x9;&#x9;SE.[PLACA_VEHICULO_DOCU] = ND.[PLACA_VEHICULO_DOCU]&#xA;&#x9;&#x9;WHERE&#xA;&#x9;&#x9;&#x9;SE.FECHA_HORA_ENTRADA_CIL IS NOT NULL&quot;"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="SQL_SELECT_Promesa_nd_05">
      <DTS:VariableValue
        DTS:DataType="8">SELECT
		      SE.NUMERO_GUIA
			,ISNULL(CASE
				WHEN (CONVERT(TIME(7),SE.FECHA_HORA_ENTRADA_CIL) &gt; SE.HORA_CONTROL_MAXIMO_LLEGADA) AND (ND.ND_HORAS &gt; 24)
				THEN 36
				WHEN (CONVERT(TIME(7),SE.FECHA_HORA_ENTRADA_CIL) &gt; SE.HORA_CONTROL_MAXIMO_LLEGADA) AND (ND.ND_HORAS &lt;= 24)
				THEN 24
			ELSE ND.ND_HORAS END,0) ND_HORAS				
		FROM		
		TMP.MPCCO_PROMESA_ND04 SE WITH(NOLOCK)		
		INNER JOIN		
		TMP.MPCCO_PROMESA_ND05_01 ND WITH(NOLOCK)		
		ON
			SE.[ID_PROCESO] = ND.[ID_PROCESO] AND
			SE.[NUMERO_MOVIMI] = ND.[NUMERO_MOVIMI] AND
			SE.[CONSECUT_MOVIMI] = ND.[CONSECUT_MOVIMI] AND
			SE.[PLACA_VEHICULO_DOCU] = ND.[PLACA_VEHICULO_DOCU]
		WHERE
			SE.FECHA_HORA_ENTRADA_CIL IS NOT NULL</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{0CF4A2A4-3DA2-4092-A29B-862A40AE6A5B}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot;SELECT * FROM&#xA;(&#xA;SELECT &#xA;&#x9;  ROW_NUMBER() OVER(PARTITION BY NUMERO_GUIA,FECHA_HORA_MOVIMIENTO ORDER BY FECHA_HORA_MOVIMIENTO DESC) ROW&#xA;&#x9; ,NUMERO_GUIA&#xA;&#x9; ,ID_PROCESO&#xA;&#x9; ,ID_CONCEPTO&#xA;&#x9; ,FECHA_HORA_MOVIMIENTO &#xA;FROM &quot;+ @[User::TBL_TMP_PROMESA_PRC_1] +&quot; WITH (NOLOCK) &#xA;) T&#xA;WHERE T.ROW = 1&quot;"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="SQL_SELECT_Promesa_PRC_2">
      <DTS:VariableValue
        DTS:DataType="8">SELECT * FROM
(
SELECT 
	  ROW_NUMBER() OVER(PARTITION BY NUMERO_GUIA,FECHA_HORA_MOVIMIENTO ORDER BY FECHA_HORA_MOVIMIENTO DESC) ROW
	 ,NUMERO_GUIA
	 ,ID_PROCESO
	 ,ID_CONCEPTO
	 ,FECHA_HORA_MOVIMIENTO 
FROM TMP.MPCCO_PROMESA_PRC_1 WITH (NOLOCK) 
) T
WHERE T.ROW = 1</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{86091A9E-738D-4F1A-8FA9-F7B39B47366F}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot;SELECT &#xA;&#x9;  ROW_NUMBER() OVER(PARTITION BY NUMERO_GUIA ORDER BY FECHA_HORA_MOVIMIENTO ASC) CONSECUTIVO&#xA;&#x9; ,NUMERO_GUIA&#xA;&#x9; ,ID_PROCESO&#xA;&#x9; ,ID_CONCEPTO&#xA;&#x9; ,FECHA_HORA_MOVIMIENTO &#xA;FROM &quot;+ @[User::TBL_TMP_PROMESA_PRC_2] +&quot; WITH (NOLOCK)&quot;"
