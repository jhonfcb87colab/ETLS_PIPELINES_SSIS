      DTS:ObjectName="SQL_SELECT_INSERT_Guias_Faltantes">
      <DTS:VariableValue
        DTS:DataType="8">WITH CTE
(
     NUMERO_GUIA
    ,FECHA
    ,ID_PAIS_ORIGEN
    ,ID_CIUDAD_ORIGEN
    ,ID_PAIS_DESTINO
    ,ID_CIUDAD_DESTINO
    ,ID_TIPOGUIA
    ,ID_CLIENTE
    ,ID_ESTADOENVIO
    ,ID_DOCU_ULT_MOVI
    ,ID_MEDTRANS
    ,ID_PRODUCTO
    ,ID_SUBPRODUCTO
    ,ID_ESTADOGUIA
    ,ID_TIEMPO_ENTREGA
    ,ID_REQ_EMBALAJE
    ,NUMERO_PIEZAS
    ,FECHA_ENTREGA
    ,FECHA_MODIFICACION
	,[ULT_MOV_FECHA_HORA_MOVIMIENTO]
	,[ULT_MOV_ID_PROCESO] 
	,[ULT_MOV_NUMERO_MOVIMI] 
	,[ULT_MOV_CONSECUT_MOVIMI]
)
AS
(
    SELECT 
         EV.NUMERO_GUIA
        ,EV.FECHA_ENVIO AS FECHA
        ,EV.ID_PAIS_ORIGEN
        ,EV.ID_CIUDAD_ORIGEN
        ,EV.ID_PAIS_DESTINO
        ,EV.ID_CIUDAD_DESTINO
        ,EV.ID_TIPOGUIA
        ,EV.ID_CLIENTE
        ,EV.ID_ESTADOENVIO
        ,EV.ID_DOCU_ULT_MOVI
        ,EV.ID_MEDTRANS
        ,EV.ID_PRODUCTO
        ,EV.ID_SUBPRODUCTO
        ,EV.ID_ESTADOGUIA
        ,EV.ID_TIEMPO_ENTREGA
        ,EV.ID_REQ_EMBALAJE
        ,EV.NUMERO_PIEZAS
        ,EV.FECHA_ENTREGA
        ,EV.FECHA_MODIFICACION
		,[ULT_MOV_FECHA_HORA_MOVIMIENTO]
		,[ULT_MOV_ID_PROCESO] 
		,[ULT_MOV_NUMERO_MOVIMI] 
		,[ULT_MOV_CONSECUT_MOVIMI]
    FROM SIG_COL_LOGISTICA_DW.TMP.MPCCO_ENVIOS_MOV EV WITH (NOLOCK)
)
INSERT INTO TMP.MPCCO_PROMESA
(
     NUMERO_GUIA
    ,FECHA
    ,ID_PAIS_ORIGEN
    ,ID_CIUDAD_ORIGEN
    ,ID_PAIS_DESTINO
    ,ID_CIUDAD_DESTINO
    ,ID_TIPOGUIA
    ,ID_CLIENTE
    ,ID_ESTADOENVIO
    ,ID_DOCU_ULT_MOVI
    ,ID_MEDTRANS
    ,ID_PRODUCTO
    ,ID_SUBPRODUCTO
    ,ID_ESTADOGUIA
    ,ID_TIEMPO_ENTREGA
    ,ID_REQ_EMBALAJE
    ,NUMERO_PIEZAS
    ,FECHA_ENTREGA
    ,FECHA_MODIFICACION
	,[ULT_MOV_FECHA_HORA_MOVIMIENTO]
	,[ULT_MOV_ID_PROCESO] 
	,[ULT_MOV_NUMERO_MOVIMI] 
	,[ULT_MOV_CONSECUT_MOVIMI]
)
SELECT
     CTE.NUMERO_GUIA
    ,CTE.FECHA
    ,CTE.ID_PAIS_ORIGEN
    ,CTE.ID_CIUDAD_ORIGEN
    ,CTE.ID_PAIS_DESTINO
    ,CTE.ID_CIUDAD_DESTINO
    ,CTE.ID_TIPOGUIA
    ,CTE.ID_CLIENTE
    ,CTE.ID_ESTADOENVIO
    ,CTE.ID_DOCU_ULT_MOVI
    ,CTE.ID_MEDTRANS
    ,CTE.ID_PRODUCTO
    ,CTE.ID_SUBPRODUCTO
    ,CTE.ID_ESTADOGUIA
    ,CTE.ID_TIEMPO_ENTREGA
    ,CTE.ID_REQ_EMBALAJE
    ,CTE.NUMERO_PIEZAS
    ,CTE.FECHA_ENTREGA
    ,CTE.FECHA_MODIFICACION
	,CTE.[ULT_MOV_FECHA_HORA_MOVIMIENTO]
	,CTE.[ULT_MOV_ID_PROCESO] 
	,CTE.[ULT_MOV_NUMERO_MOVIMI] 
	,CTE.[ULT_MOV_CONSECUT_MOVIMI]
FROM CTE
LEFT OUTER JOIN SIG_COLOMBIA_DW.TMP.MPCCO_PROMESA PR WITH (NOLOCK)
  ON CTE.NUMERO_GUIA = PR.NUMERO_GUIA
WHERE PR.NUMERO_GUIA IS NULL
  AND CTE.FECHA &gt;= '2026-02-08'
  AND CTE.FECHA &lt;= '2026-04-09'</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{6BA2B431-4CC7-4691-9220-426200FD9B34}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot;SELECT &#xA;  &#xA;      DISTINCT CONVERT(DATETIME,CONVERT(DATE,FECHA)) FECHA_ENVIO&#xA;      &#xA;  FROM &quot;+ @[User::TBL_TMP_PROMESA] +&quot; WITH (NOLOCK)&#xA;  ORDER BY 1&quot;"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="SQL_SELECT_Obtener_Fechas">
      <DTS:VariableValue
