        <DTS:PrecedenceConstraint
          DTS:refId="Package\EXTRACCION PROMESA.PrecedenceConstraints[Constraint 9]"
          DTS:CreationName=""
          DTS:DTSID="{E2EEFDFE-F317-4FB7-8E16-DE92CA8CB212}"
          DTS:From="Package\EXTRACCION PROMESA\SQL_UPDATE_Fecha_Vigente"
