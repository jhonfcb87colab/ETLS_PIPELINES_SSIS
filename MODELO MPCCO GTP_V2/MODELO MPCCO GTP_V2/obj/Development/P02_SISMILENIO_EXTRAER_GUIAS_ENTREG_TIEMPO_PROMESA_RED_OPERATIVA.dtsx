            <SQLTask:SqlTaskData
              SQLTask:Connection="{94C855A8-E2EA-4CF8-9340-DC0E1AB28830}"
              SQLTask:SqlStatementSource="TRUNCATE TABLE TMP.MPCCO_PROMESA&#xA;TRUNCATE TABLE TMP.MPCCO_PROMESA_FECHA" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
