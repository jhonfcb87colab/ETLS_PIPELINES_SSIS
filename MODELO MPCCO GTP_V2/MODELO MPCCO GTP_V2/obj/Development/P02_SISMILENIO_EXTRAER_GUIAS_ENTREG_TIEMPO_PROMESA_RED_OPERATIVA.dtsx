        <DTS:Executable
          DTS:refId="Package\EXTRACCION PROMESA\SQL_UPDATE_Fecha_Envio"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{27C3AFCF-70EB-4EFC-AD20-19D5C7E76EC1}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="SQL_UPDATE_Fecha_Envio"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{94C855A8-E2EA-4CF8-9340-DC0E1AB28830}"
              SQLTask:SqlStatementSource="UPDATE A    &#xA;  &#xA;SET A.FECHA_VIGENTE = RA.FECHA_VIGENTE&#xA;&#xA;FROM TMP.MPCCO_PROMESA A&#xA; &#xA;INNER JOIN TMP.MPCCO_PROMESA_FECHA RA&#xA;   &#xA;ON CONVERT(DATETIME,CONVERT(DATE,A.FECHA)) = RA.FECHA_ENVIO&#xA;WHERE A.ID_TIEMPO_ENTREGA = 3" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\EXTRACCION PROMESA\SQL_UPDATE_Fecha_Vigente"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{048BA6D4-B156-45CD-BEC1-3C0A8BAA24ED}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="SQL_UPDATE_Fecha_Vigente"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{94C855A8-E2EA-4CF8-9340-DC0E1AB28830}"
              SQLTask:SqlStatementSource="DECLARE @fecha datetime&#xA;DECLARE @fecha2 datetime&#xA;DECLARE @estado VARCHAR (5)&#xA;SET @estado = 'SI'&#xA;&#xA;&#x9;-- Declara el cursor y reemplaza los valores de los parámetros&#xA;&#x9;DECLARE SQL_CURSOR CURSOR FOR   &#x9;&#xA;&#x9;SELECT  FECHA_ENVIO   FROM TMP.MPCCO_PROMESA_FECHA T WITH (NOLOCK)&#xA;&#xA;&#x9;OPEN SQL_CURSOR  &#xA;&#xA;&#x9;FETCH NEXT FROM SQL_CURSOR   &#xA;&#x9;INTO @fecha&#xA;&#xA;&#x9;WHILE @@FETCH_STATUS = 0  &#xA;&#x9;BEGIN  &#xA;&#x9;&#xA;&#x9;--SELECT @fecha&#xA;&#xA;SET @estado = 'SI'&#xA;SET @fecha2 =  @fecha&#x9;&#xA;WHILE  @estado = 'SI' &#xA;&#xA;&#x9;&#x9;BEGIN&#xA;&#x9;&#x9;    SET @fecha =  DATEADD(DAY,1,CONVERT(DATETIME,CONVERT(DATE,@fecha)))&#x9;&#x9;&#x9;&#x9;&#x9;&#xA;&#x9;&#x9;&#x9;IF DATEPART(DW,@fecha) = 1 /* 1 = DOMINGO */&#xA;&#x9;&#x9;    &#x9; SET @estado = 'SI' &#x9;&#x9;&#x9;&#x9; &#xA;&#x9;&#x9;&#x9;ELSE &#xA;&#x9;&#x9;BEGIN&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#xA;&#x9;&#x9;&#x9;IF EXISTS (SELECT * FROM  DIM.TIEMPO_FESTIVOS_NACIONALES WHERE FECHA_FESTIVA  = @fecha)&#x9;&#x9;&#x9;&#xA;&#x9;&#x9;    &#x9; SET @estado = 'SI' &#x9;&#x9;&#x9;&#x9; &#xA;&#x9;&#x9;&#x9;ELSE &#xA;&#x9;&#x9;&#x9;&#x9;SET @estado = 'NO' &#x9;&#x9;&#x9;&#x9; &#x9;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#xA;END&#xA;END&#xA;&#xA;UPDATE TMP.MPCCO_PROMESA_FECHA SET FECHA_VIGENTE = DATEADD(HOUR,9,@fecha) WHERE FECHA_ENVIO = @fecha2&#xA;&#xA;&#xA;FETCH NEXT FROM SQL_CURSOR   &#xA;&#x9;INTO @fecha&#xA;&#xA;END&#xA;&#x9;&#xA;CLOSE SQL_CURSOR&#xA;DEALLOCATE SQL_CURSOR" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\EXTRACCION PROMESA\SQL_UPDATE_Tipo_Cobro"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{B128342F-23DE-402E-947A-1F20F850AEA5}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="SQL_UPDATE_Tipo_Cobro"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{CE05DB66-31E1-4BF7-B85A-81929B965F18}"
              SQLTask:SqlStatementSource="  WITH CTE (NUMERO_GUIA, ID_TIPO_COBRO) AS (&#xA;&#xA;    SELECT PR.NUMERO_GUIA, GR.ID_TIPO_COBRO&#xA;    FROM TMP.MPCCO_PROMESA AS PR WITH (NOLOCK)&#xA;    INNER JOIN LOG.MPCCO_GUIA_RECAUDO AS GR WITH (NOLOCK)&#xA;    ON GR.NUMERO_GUIA = PR.NUMERO_GUIA&#xA;&#xA;)&#xA;UPDATE PR&#xA;&#xA;&#x9;SET PR.GR_ID_TIPO_COBRO = CASE WHEN C.ID_TIPO_COBRO = 1 THEN 1 ELSE 2 END&#xA;&#xA;FROM TMP.MPCCO_PROMESA AS PR&#xA;INNER JOIN CTE AS C&#xA;ON C.NUMERO_GUIA = PR.NUMERO_GUIA&#xA;&#xA;WHERE PR.GR_ID_TIPO_COBRO IS NULL&#xA;   OR PR.GR_ID_TIPO_COBRO &lt;&gt; CASE WHEN C.ID_TIPO_COBRO = 1 THEN 1 ELSE 2 END;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
      </DTS:Executables>
