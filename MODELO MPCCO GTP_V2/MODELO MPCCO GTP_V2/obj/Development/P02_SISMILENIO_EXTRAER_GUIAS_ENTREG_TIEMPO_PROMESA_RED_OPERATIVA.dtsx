                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT S.NUMERO_GUIA
    ,S.ID_PROCESO
    ,S.ID_CONCEPTO
    ,S.FECHA_HORA_MOVIMIENTO 
FROM TMP.PROMESA T WITH (NOLOCK)
INNER JOIN  LOG.MPCCO_SEGUIMIENTO_ENVIO_6MESES S WITH (NOLOCK) ON T.NUMERO_GUIA = S.NUMERO_GUIA
WHERE S.ID_PROCESO IN (21,9)</property>
