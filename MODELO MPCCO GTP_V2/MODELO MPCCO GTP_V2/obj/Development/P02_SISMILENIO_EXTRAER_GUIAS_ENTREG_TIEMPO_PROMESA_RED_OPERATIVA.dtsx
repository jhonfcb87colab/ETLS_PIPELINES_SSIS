            <SQLTask:SqlTaskData
              SQLTask:Connection="{CE05DB66-31E1-4BF7-B85A-81929B965F18}"
              SQLTask:SqlStatementSource="TRUNCATE TABLE TMP.MPCCO_PROMESA_1&#xA;TRUNCATE TABLE TMP.MPCCO_PROMESA_2&#xA;TRUNCATE TABLE TMP.MPCCO_PROMESA_3&#xA;TRUNCATE TABLE TMP.MPCCO_PROMESA&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
