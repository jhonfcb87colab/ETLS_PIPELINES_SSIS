    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{49E4DAD4-F70E-4476-A2A6-6490E5DC36DB}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot;UPDATE A    &#xA;  &#xA;SET A.FECHA_VIGENTE = RA.FECHA_VIGENTE&#xA;&#xA;FROM &quot;+ @[User::TBL_TMP_PROMESA] +&quot; A&#xA; &#xA;INNER JOIN &quot;+ @[User::TBL_TMP_PROMESA_FECHA] +&quot; RA&#xA;   &#xA;ON CONVERT(DATETIME,CONVERT(DATE,A.FECHA)) = RA.FECHA_ENVIO&#xA;WHERE A.ID_TIEMPO_ENTREGA = 3&quot;"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="SQL_UPDATE_Fecha_Envio">
      <DTS:VariableValue
        DTS:DataType="8">UPDATE A    
  
SET A.FECHA_VIGENTE = RA.FECHA_VIGENTE

FROM TMP.MPCCO_PROMESA A
 
INNER JOIN TMP.MPCCO_PROMESA_FECHA RA
   
ON CONVERT(DATETIME,CONVERT(DATE,A.FECHA)) = RA.FECHA_ENVIO
WHERE A.ID_TIEMPO_ENTREGA = 3</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{734AA8B4-8730-4349-A49F-505B3E6D0568}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot;DECLARE @fecha datetime&#xA;DECLARE @fecha2 datetime&#xA;DECLARE @estado VARCHAR (5)&#xA;SET @estado = 'SI'&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#x9;-- Declara el cursor y reemplaza los valores de los parámetros&#xA;&#x9;DECLARE SQL_CURSOR CURSOR FOR   &#x9;&#xA;&#x9;SELECT  FECHA_ENVIO   FROM &quot;+ @[User::TBL_TMP_PROMESA_FECHA] +&quot; T WITH (NOLOCK)&#xA;&#xA;&#x9;OPEN SQL_CURSOR  &#xA;&#xA;&#x9;FETCH NEXT FROM SQL_CURSOR   &#xA;&#x9;INTO @fecha&#xA;&#xA;&#x9;WHILE @@FETCH_STATUS = 0  &#xA;&#x9;BEGIN  &#xA;&#x9;&#xA;&#x9;--SELECT @fecha&#xA;&#xA;SET @estado = 'SI'&#xA;SET @fecha2 =  @fecha&#x9;&#xA;WHILE  @estado = 'SI' &#xA;&#xA;&#x9;&#x9;BEGIN&#xA;&#x9;&#x9;    SET @fecha =  DATEADD(DAY,1,CONVERT(DATETIME,CONVERT(DATE,@fecha)))&#x9;&#x9;&#x9;&#x9;&#x9;&#xA;&#x9;&#x9;&#x9;IF DATEPART(DW,@fecha) = 1 /* 1 = DOMINGO */&#xA;&#x9;&#x9;    &#x9; SET @estado = 'SI' &#x9;&#x9;&#x9;&#x9; &#xA;&#x9;&#x9;&#x9;ELSE &#xA;&#x9;&#x9;BEGIN&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#xA;&#x9;&#x9;&#x9;IF EXISTS (SELECT * FROM  &quot;+ @[User::TBL_DIM_TIEMPO_FESTIVOS_NACIONALES] +&quot; WHERE FECHA_FESTIVA  = @fecha)&#x9;&#x9;&#x9;&#xA;&#x9;&#x9;    &#x9; SET @estado = 'SI' &#x9;&#x9;&#x9;&#x9; &#xA;&#x9;&#x9;&#x9;ELSE &#xA;&#x9;&#x9;&#x9;&#x9;SET @estado = 'NO' &#x9;&#x9;&#x9;&#x9; &#x9;&#xA;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9; &#xA;&#xA;END&#xA;END&#xA;&#xA;&#xA;&#xA;UPDATE &quot;+ @[User::TBL_TMP_PROMESA_FECHA] +&quot; SET FECHA_VIGENTE = DATEADD(HOUR,9,@fecha) WHERE FECHA_ENVIO = @fecha2&#xA;&#xA;&#xA;FETCH NEXT FROM SQL_CURSOR   &#xA;&#x9;INTO @fecha&#xA;&#xA;&#xA;&#x9;&#xA;&#x9;&#xA;END&#xA;&#x9;&#x9;&#xA;&#xA;CLOSE SQL_CURSOR&#xA;DEALLOCATE SQL_CURSOR&quot;"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="SQL_UPDATE_Fecha_Vigente">
      <DTS:VariableValue
        DTS:DataType="8">DECLARE @fecha datetime
DECLARE @fecha2 datetime
DECLARE @estado VARCHAR (5)
SET @estado = 'SI'





	-- Declara el cursor y reemplaza los valores de los parámetros
	DECLARE SQL_CURSOR CURSOR FOR   	
	SELECT  FECHA_ENVIO   FROM TMP.MPCCO_PROMESA_FECHA T WITH (NOLOCK)

	OPEN SQL_CURSOR  

	FETCH NEXT FROM SQL_CURSOR   
	INTO @fecha

	WHILE @@FETCH_STATUS = 0  
	BEGIN  
	
	--SELECT @fecha

SET @estado = 'SI'
SET @fecha2 =  @fecha	
WHILE  @estado = 'SI' 

		BEGIN
		    SET @fecha =  DATEADD(DAY,1,CONVERT(DATETIME,CONVERT(DATE,@fecha)))					
			IF DATEPART(DW,@fecha) = 1 /* 1 = DOMINGO */
		    	 SET @estado = 'SI' 				 
			ELSE 
		BEGIN
							
			IF EXISTS (SELECT * FROM  DIM.TIEMPO_FESTIVOS_NACIONALES WHERE FECHA_FESTIVA  = @fecha)			
		    	 SET @estado = 'SI' 				 
			ELSE 
				SET @estado = 'NO' 				 	

							 

END
END



UPDATE TMP.MPCCO_PROMESA_FECHA SET FECHA_VIGENTE = DATEADD(HOUR,9,@fecha) WHERE FECHA_ENVIO = @fecha2


FETCH NEXT FROM SQL_CURSOR   
	INTO @fecha


	
	
END
		

CLOSE SQL_CURSOR
DEALLOCATE SQL_CURSOR</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{1ECDC915-25F3-4C22-89E2-EF289C02A03D}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot;WITH CTE&#xA;(&#xA;&#x9; [ID_PROCESO]&#xA;&#x9;,[NUMERO_MOVIMI]&#xA;&#x9;,[CONSECUT_MOVIMI]&#xA;&#x9;,[PLACA_VEHICULO_DOCU]&#xA;&#x9;,[FECHA_HORA_ENTRADA_CIL]&#xA;)&#xA;AS&#xA;(&#xA;&#x9;SELECT&#xA;&#x9;&#x9; [ID_PROCESO]&#xA;&#x9;&#x9;,[NUMERO_MOVIMI]&#xA;&#x9;&#x9;,[CONSECUT_MOVIMI]&#xA;&#x9;&#x9;,[PLACA_VEHICULO_DOCU]&#xA;&#x9;&#x9;,MAX([FECHA_HORA_ENTRADA_CIL]) [FECHA_HORA_ENTRADA_CIL]&#xA;&#x9;FROM&#xA;&#x9;&#x9;&quot;+ @[User::TBL_TMP_PROMESA_NDBASE] +&quot;&#xA;&#x9;GROUP BY&#xA;&#x9;&#x9; [ID_PROCESO]&#xA;&#x9;&#x9;,[NUMERO_MOVIMI]&#xA;&#x9;&#x9;,[CONSECUT_MOVIMI]&#xA;&#x9;&#x9;,[PLACA_VEHICULO_DOCU]&#xA;)&#xA;&#xA;UPDATE &#xA;&#x9;&#x9;&quot;+ @[User::TBL_TMP_PROMESA_ND04_01] +&quot;&#xA;SET&#xA;&#x9;&#x9;FECHA_HORA_ENTRADA_CIL = ND.FECHA_HORA_ENTRADA_CIL&#xA;FROM&#xA;&#x9;&#x9;&quot;+ @[User::TBL_TMP_PROMESA_ND04_01] +&quot; SE&#xA;INNER JOIN&#xA;&#x9;&#x9;CTE ND&#xA;ON&#xA;SE.[ID_PROCESO] = ND.[ID_PROCESO] AND&#xA;SE.[NUMERO_MOVIMI] = ND.[NUMERO_MOVIMI] AND&#xA;SE.[CONSECUT_MOVIMI] = ND.[CONSECUT_MOVIMI] AND&#xA;SE.[PLACA_VEHICULO_DOCU] = ND.[PLACA_VEHICULO_DOCU]&quot;"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="SQL_UPDATE_Promesa_nd_04_01">
      <DTS:VariableValue
        DTS:DataType="8">WITH CTE
(
	 [ID_PROCESO]
	,[NUMERO_MOVIMI]
	,[CONSECUT_MOVIMI]
	,[PLACA_VEHICULO_DOCU]
	,[FECHA_HORA_ENTRADA_CIL]
)
AS
(
	SELECT
		 [ID_PROCESO]
		,[NUMERO_MOVIMI]
		,[CONSECUT_MOVIMI]
		,[PLACA_VEHICULO_DOCU]
		,MAX([FECHA_HORA_ENTRADA_CIL]) [FECHA_HORA_ENTRADA_CIL]
	FROM
		TMP.MPCCO_PROMESA_NDBASE
	GROUP BY
		 [ID_PROCESO]
		,[NUMERO_MOVIMI]
		,[CONSECUT_MOVIMI]
		,[PLACA_VEHICULO_DOCU]
)

UPDATE 
		TMP.MPCCO_PROMESA_ND04_01
SET
		FECHA_HORA_ENTRADA_CIL = ND.FECHA_HORA_ENTRADA_CIL
FROM
		TMP.MPCCO_PROMESA_ND04_01 SE
INNER JOIN
		CTE ND
ON
SE.[ID_PROCESO] = ND.[ID_PROCESO] AND
SE.[NUMERO_MOVIMI] = ND.[NUMERO_MOVIMI] AND
SE.[CONSECUT_MOVIMI] = ND.[CONSECUT_MOVIMI] AND
SE.[PLACA_VEHICULO_DOCU] = ND.[PLACA_VEHICULO_DOCU]</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{C7821BCC-AB5A-4313-85E2-DD4563B6E71B}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot;WITH CTE (NUMERO_GUIA, ID_TIPO_COBRO) AS (&#xA;&#xA;    SELECT PR.NUMERO_GUIA, GR.ID_TIPO_COBRO&#xA;    FROM &quot; + @[User::TBL_TMP_PROMESA] + &quot; AS PR WITH (NOLOCK)&#xA;    INNER JOIN &quot; + @[User::TBL_LOG_GUIA_RECAUDO] + &quot; AS GR WITH (NOLOCK)&#xA;    ON GR.NUMERO_GUIA = PR.NUMERO_GUIA&#xA;&#xA;)&#xA;UPDATE PR&#xA;&#xA;&#x9;SET PR.GR_ID_TIPO_COBRO = CASE WHEN C.ID_TIPO_COBRO = 1 THEN 1 ELSE 2 END&#xA;&#xA;FROM &quot; + @[User::TBL_TMP_PROMESA] + &quot; AS PR&#xA;INNER JOIN CTE AS C&#xA;ON C.NUMERO_GUIA = PR.NUMERO_GUIA&#xA;&#xA;WHERE PR.GR_ID_TIPO_COBRO IS NULL&#xA;   OR PR.GR_ID_TIPO_COBRO &lt;&gt; CASE WHEN C.ID_TIPO_COBRO = 1 THEN 1 ELSE 2 END;&quot;"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="SQL_UPDATE_Tipo_Cobro">
      <DTS:VariableValue
        DTS:DataType="8">WITH CTE (NUMERO_GUIA, ID_TIPO_COBRO) AS (

    SELECT PR.NUMERO_GUIA, GR.ID_TIPO_COBRO
    FROM TMP.MPCCO_PROMESA AS PR WITH (NOLOCK)
    INNER JOIN LOG.MPCCO_GUIA_RECAUDO AS GR WITH (NOLOCK)
    ON GR.NUMERO_GUIA = PR.NUMERO_GUIA

)
UPDATE PR

	SET PR.GR_ID_TIPO_COBRO = CASE WHEN C.ID_TIPO_COBRO = 1 THEN 1 ELSE 2 END

FROM TMP.MPCCO_PROMESA AS PR
INNER JOIN CTE AS C
ON C.NUMERO_GUIA = PR.NUMERO_GUIA

WHERE PR.GR_ID_TIPO_COBRO IS NULL
   OR PR.GR_ID_TIPO_COBRO &lt;&gt; CASE WHEN C.ID_TIPO_COBRO = 1 THEN 1 ELSE 2 END;</DTS:VariableValue>
    </DTS:Variable>
