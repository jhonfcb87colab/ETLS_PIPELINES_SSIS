                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT * FROM
(
SELECT 
	  ROW_NUMBER() OVER(PARTITION BY NUMERO_GUIA,FECHA_HORA_MOVIMIENTO ORDER BY FECHA_HORA_MOVIMIENTO DESC) ROW
	 ,NUMERO_GUIA
	 ,ID_PROCESO
	 ,ID_CONCEPTO
	 ,FECHA_HORA_MOVIMIENTO 
FROM TMP.MPCCO_PROMESA_PRC_1 WITH (NOLOCK) 
) T
WHERE T.ROW = 1</property>
