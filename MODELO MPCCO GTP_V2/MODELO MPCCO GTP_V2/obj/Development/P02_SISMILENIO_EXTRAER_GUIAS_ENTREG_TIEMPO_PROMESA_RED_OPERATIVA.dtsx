      DISTINCT CONVERT(DATETIME,CONVERT(DATE,FECHA)) FECHA_ENVIO
      
  FROM TMP.MPCCO_PROMESA WITH (NOLOCK)
  ORDER BY 1</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
