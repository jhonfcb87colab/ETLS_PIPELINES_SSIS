                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT 
                   T.NUMERO_GUIA
                  ,T.FECHA_HORA_MOVIMIENTO
                  ,T.ID_PROCESO
                  ,T.CONSECUT_MOVIMI
                  ,T.NUMERO_MOVIMI
                  ,T.PLACA_VEHICULO_DOCU
                  ,T.ID_PAIS_DESTINO
                  ,T.ID_CIUDAD_DESTINO
                  ,P.HORA_CONTROL_MAXIMO_LLEGADA

FROM TMP.MPCCO_PROMESA_ND02 T WITH (NOLOCK)
INNER JOIN TMP.MPCCO_PROMESA_NDCENLOG P WITH (NOLOCK) ON T.ID_PAIS_DESTINO = P.ID_PAIS AND T.ID_CIUDAD_DESTINO = P.ID_CIUDAD</property>
