                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT [NUMERO_GUIA]
      ,[FECHA]
      ,[ID_PAIS_ORIGEN]
      ,[ID_CIUDAD_ORIGEN]
      ,[ID_PAIS_DESTINO]
      ,[ID_CIUDAD_DESTINO]
