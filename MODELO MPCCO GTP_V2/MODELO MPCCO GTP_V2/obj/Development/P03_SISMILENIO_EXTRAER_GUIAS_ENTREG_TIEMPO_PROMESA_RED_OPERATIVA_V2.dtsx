                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">WITH CTE (
    ID,[NUMERO_GUIA],[ID_PROCESO],[ID_CONCEPTO],[FECHA_HORA_MOVIMIENTO],[NUMERO_MOVIMI],[CONSECUT_MOVIMI]
) AS (
    SELECT 
        ROW_NUMBER() OVER (PARTITION BY [ID_PROCESO], [NUMERO_MOVIMI], [CONSECUT_MOVIMI], SE.[NUMERO_GUIA]
                           ORDER BY [FECHA_HORA_MOVIMIENTO]) AS ID,
        SE.[NUMERO_GUIA],
        [ID_PROCESO],
        CASE WHEN ISNULL(CONVERT(INT,[ID_CONCEPTO]),-888) = 0 THEN -888 ELSE ISNULL(CONVERT(INT,[ID_CONCEPTO]),-888) END AS ID_CONCEPTO,
        [FECHA_HORA_MOVIMIENTO],
        [NUMERO_MOVIMI],
        [CONSECUT_MOVIMI]
    FROM SIG_COLOMBIA_DW.LOG.MPCCO_SEGUIMIENTO_ENVIO_6MESES SE WITH (NOLOCK)
    INNER JOIN TMP.MPCCO_CUMPLIMIENTO_AC_DEP G WITH (NOLOCK)
        ON G.G_NUMERO_GUIA = SE.NUMERO_GUIA
)
SELECT [NUMERO_GUIA],[ID_PROCESO],[ID_CONCEPTO],[FECHA_HORA_MOVIMIENTO],[NUMERO_MOVIMI],[CONSECUT_MOVIMI]
FROM CTE
WHERE ID = 1;</property>
