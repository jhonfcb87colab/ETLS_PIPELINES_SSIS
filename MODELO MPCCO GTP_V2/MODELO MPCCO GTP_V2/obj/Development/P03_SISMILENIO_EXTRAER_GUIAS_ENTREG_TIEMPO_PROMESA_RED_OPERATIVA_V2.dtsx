                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">;WITH PROMESA AS ( 
SELECT 
ROW_NUMBER() OVER (PARTITION BY CONVERT(DATETIME,CONVERT(DATE,FECHA)) ORDER BY CONVERT(DATETIME,CONVERT(DATE,FECHA)) ) AS #ROW,
CONVERT(DATETIME,CONVERT(DATE,FECHA)) AS FECHA_ENVIO

  FROM TMP.MPCCO_PROMESA_V2 WITH (NOLOCK)
)
SELECT FECHA_ENVIO 
FROM PROMESA 
WHERE #ROW = 1 ORDER BY FECHA_ENVIO</property>
