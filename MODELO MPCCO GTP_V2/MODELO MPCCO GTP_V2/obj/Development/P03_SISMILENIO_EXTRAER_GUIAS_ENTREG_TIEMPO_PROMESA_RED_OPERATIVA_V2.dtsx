    <DTS:Executable
      DTS:refId="Package\EXTRACCION PROMESA"
      DTS:CreationName="STOCK:SEQUENCE"
      DTS:Description="Sequence Container"
      DTS:DTSID="{20CA2E15-B5A2-4CB4-A7D9-4658D51E6ECA}"
      DTS:ExecutableType="STOCK:SEQUENCE"
      DTS:LocaleID="-1"
      DTS:ObjectName="EXTRACCION PROMESA">
      <DTS:Variables />
      <DTS:Executables>
        <DTS:Executable
          DTS:refId="Package\EXTRACCION PROMESA\ACTUALIZAR FECHA ENVIO"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{3A445AFA-3FE7-47FE-9393-D4EA27D65842}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="ACTUALIZAR FECHA ENVIO"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{94C855A8-E2EA-4CF8-9340-DC0E1AB28830}"
              SQLTask:SqlStatementSource="&#xA;UPDATE A&#xA;SET A.FECHA_VIGENTE = RA.FECHA_VIGENTE&#xA;FROM TMP.MPCCO_PROMESA_V2 A&#xA;INNER JOIN TMP.MPCCO_PROMESA_FECHA_V2 RA&#xA;  ON CONVERT(DATETIME,CONVERT(DATE,A.FECHA)) = RA.FECHA_ENVIO&#xA;WHERE A.ID_TIEMPO_ENTREGA = 3;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\EXTRACCION PROMESA\SQL_SELECT_Modalidad_pago"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{5F32E39A-C1DE-4741-A4AA-CA2792335EEF}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="SQL_SELECT_Modalidad_pago"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{CE05DB66-31E1-4BF7-B85A-81929B965F18}"
              SQLTask:SqlStatementSource=" WITH CTE (NUMERO_GUIA, ID_TIPO_COBRO) AS (&#xA;    SELECT &#xA;        PR.NUMERO_GUIA, &#xA;        GR.ID_TIPO_COBRO&#xA;    FROM TMP.MPCCO_PROMESA_V2 PR WITH (NOLOCK)&#xA;    INNER JOIN LOG.MPCCO_GUIA_RECAUDO GR WITH (NOLOCK)&#xA;        ON PR.NUMERO_GUIA = GR.NUMERO_GUIA&#xA;)&#xA;UPDATE PR&#xA;SET GR_ID_TIPO_COBRO = CASE WHEN CTE.ID_TIPO_COBRO = 1 THEN 1 ELSE 2 END&#xA;FROM TMP.MPCCO_PROMESA_V2 PR&#xA;INNER JOIN CTE &#xA;    ON PR.NUMERO_GUIA = CTE.NUMERO_GUIA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\EXTRACCION PROMESA\SQL_SELECT_Obtener_fecha_vigente"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{EEC44552-C679-40C7-9098-2A488E42EC3C}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="SQL_SELECT_Obtener_fecha_vigente"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{94C855A8-E2EA-4CF8-9340-DC0E1AB28830}"
              SQLTask:SqlStatementSource="DECLARE @fecha datetime&#xA;DECLARE @fecha2 datetime&#xA;DECLARE @estado VARCHAR (5)&#xA;SET @estado = 'SI'&#xA;&#xA;DECLARE SQL_CURSOR CURSOR FOR   &#x9;&#xA;SELECT FECHA_ENVIO FROM TMP.MPCCO_PROMESA_FECHA_V2 WITH (NOLOCK)&#xA;&#xA;OPEN SQL_CURSOR  &#xA;&#xA;FETCH NEXT FROM SQL_CURSOR INTO @fecha&#xA;&#xA;WHILE @@FETCH_STATUS = 0  &#xA;BEGIN  &#xA;    SET @estado = 'SI'&#xA;    SET @fecha2 = @fecha&#x9;&#xA;&#xA;    WHILE @estado = 'SI' &#xA;    BEGIN&#xA;        SET @fecha = DATEADD(DAY,1,CONVERT(DATETIME,CONVERT(DATE,@fecha)))&#x9;&#x9;&#x9;&#x9;&#x9;&#xA;        IF DATEPART(WEEKDAY,@fecha) = 1 /* 1 = DOMINGO */&#xA;            SET @estado = 'SI' &#x9;&#x9;&#x9;&#x9; &#xA;        ELSE &#xA;        BEGIN&#xA;            IF EXISTS (&#xA;                SELECT 1 &#xA;                FROM DIM.TIEMPO_FESTIVOS_NACIONALES &#xA;                WHERE FECHA_FESTIVA = @fecha&#xA;            )&#xA;                SET @estado = 'SI' &#x9;&#x9;&#x9;&#x9; &#xA;            ELSE &#xA;                SET @estado = 'NO' &#x9;&#x9;&#x9;&#x9; &#x9;&#xA;        END&#xA;    END&#xA;&#xA;    UPDATE TMP.MPCCO_PROMESA_FECHA_V2 &#xA;    SET FECHA_VIGENTE = DATEADD(HOUR,9,@fecha) &#xA;    WHERE FECHA_ENVIO = @fecha2&#xA;&#xA;    FETCH NEXT FROM SQL_CURSOR INTO @fecha&#xA;END&#xA;&#xA;CLOSE SQL_CURSOR&#xA;DEALLOCATE SQL_CURSOR" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\EXTRACCION PROMESA\SQL_SELECT_Obtener_Guias_Faltantes"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{D2B93319-AE3D-4586-A129-1E116D037557}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="SQL_SELECT_Obtener_Guias_Faltantes"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{CE05DB66-31E1-4BF7-B85A-81929B965F18}"
              SQLTask:SqlStatementSource="DECLARE @FechaInicioFinal DATE;&#xA;DECLARE @FechaFinFinal    DATE;&#xA;&#xA;&#xA;&#xA;IF DATEPART(HOUR, GETDATE()) &gt;= 19&#xA;   AND DATEPART(HOUR, GETDATE()) &lt;= 23&#xA;BEGIN&#xA;&#xA;    SET @FechaInicioFinal = ?;&#xA;    SET @FechaFinFinal    = ?;&#xA;END&#xA;ELSE&#xA;BEGIN&#xA;&#xA;&#xA;    SET @FechaInicioFinal = CONVERT(DATE,DATEADD(DAY, -10, GETDATE()));&#xA;    SET @FechaFinFinal    = CONVERT(DATE, GETDATE());&#xA;END;&#xA;&#xA;&#xA;&#xA;WITH CTE&#xA;(&#xA;     NUMERO_GUIA&#xA;    ,FECHA&#xA;    ,ID_PAIS_ORIGEN&#xA;    ,ID_CIUDAD_ORIGEN&#xA;    ,ID_PAIS_DESTINO&#xA;    ,ID_CIUDAD_DESTINO&#xA;    ,ID_TIPOGUIA&#xA;    ,ID_CLIENTE&#xA;    ,ID_ESTADOENVIO&#xA;    ,ID_DOCU_ULT_MOVI&#xA;    ,ID_MEDTRANS&#xA;    ,ID_PRODUCTO&#xA;    ,ID_SUBPRODUCTO&#xA;    ,ID_ESTADOGUIA&#xA;    ,ID_TIEMPO_ENTREGA&#xA;    ,ID_REQ_EMBALAJE&#xA;    ,NUMERO_PIEZAS&#xA;    ,FECHA_ENTREGA&#xA;    ,FECHA_MODIFICACION&#xA;,[ULT_MOV_FECHA_HORA_MOVIMIENTO]&#xA;,[ULT_MOV_ID_PROCESO] &#xA;,[ULT_MOV_NUMERO_MOVIMI] &#xA;,[ULT_MOV_CONSECUT_MOVIMI]&#xA;)&#xA;AS&#xA;(&#xA;    SELECT &#xA;     EV.NUMERO_GUIA&#xA;    ,EV.FECHA_ENVIO AS FECHA&#xA;    ,EV.ID_PAIS_ORIGEN&#xA;    ,EV.ID_CIUDAD_ORIGEN&#xA;    ,EV.ID_PAIS_DESTINO&#xA;    ,EV.ID_CIUDAD_DESTINO&#xA;    ,EV.ID_TIPOGUIA&#xA;    ,EV.ID_CLIENTE&#xA;    ,EV.ID_ESTADOENVIO&#xA;    ,EV.ID_DOCU_ULT_MOVI&#xA;    ,EV.ID_MEDTRANS&#xA;    ,EV.ID_PRODUCTO&#xA;    ,EV.ID_SUBPRODUCTO&#xA;    ,EV.ID_ESTADOGUIA&#xA;    ,EV.ID_TIEMPO_ENTREGA&#xA;    ,EV.ID_REQ_EMBALAJE&#xA;    ,EV.NUMERO_PIEZAS&#xA;    ,EV.FECHA_ENTREGA&#xA;    ,EV.FECHA_MODIFICACION&#xA;&#x9;,EV.[ULT_MOV_FECHA_HORA_MOVIMIENTO]&#xA;&#x9;,EV.[ULT_MOV_ID_PROCESO] &#xA;&#x9;,EV.[ULT_MOV_NUMERO_MOVIMI] &#xA;&#x9;,EV.[ULT_MOV_CONSECUT_MOVIMI]&#xA;    FROM SIG_COL_LOGISTICA_DW.TMP.MPCCO_ENVIOS_MOV EV WITH (NOLOCK)&#xA;    WHERE SUBSTRING(CONVERT(VARCHAR(20), EV.NUMERO_GUIA), 1, 1) &lt;&gt; 5&#xA;      AND EV.FECHA_ENVIO &gt;= @FechaInicioFinal&#xA;      AND EV.FECHA_ENVIO &lt;=   @FechaFinFinal&#xA;)&#xA;INSERT INTO TMP.MPCCO_PROMESA_V2&#xA;(&#xA;     NUMERO_GUIA&#xA;    ,FECHA&#xA;    ,ID_PAIS_ORIGEN&#xA;    ,ID_CIUDAD_ORIGEN&#xA;    ,ID_PAIS_DESTINO&#xA;    ,ID_CIUDAD_DESTINO&#xA;    ,ID_TIPOGUIA&#xA;    ,ID_CLIENTE&#xA;    ,ID_ESTADOENVIO&#xA;    ,ID_DOCU_ULT_MOVI&#xA;    ,ID_MEDTRANS&#xA;    ,ID_PRODUCTO&#xA;    ,ID_SUBPRODUCTO&#xA;    ,ID_ESTADOGUIA&#xA;    ,ID_TIEMPO_ENTREGA&#xA;    ,ID_REQ_EMBALAJE&#xA;    ,NUMERO_PIEZAS&#xA;    ,FECHA_ENTREGA&#xA;    ,FECHA_MODIFICACION&#xA;&#x9;,[ULT_MOV_FECHA_HORA_MOVIMIENTO]&#xA;&#x9;,[ULT_MOV_ID_PROCESO] &#xA;&#x9;,[ULT_MOV_NUMERO_MOVIMI] &#xA;&#x9;,[ULT_MOV_CONSECUT_MOVIMI]&#xA;)&#xA;SELECT&#xA;     CTE.NUMERO_GUIA&#xA;    ,CTE.FECHA&#xA;    ,CTE.ID_PAIS_ORIGEN&#xA;    ,CTE.ID_CIUDAD_ORIGEN&#xA;    ,CTE.ID_PAIS_DESTINO&#xA;    ,CTE.ID_CIUDAD_DESTINO&#xA;    ,CTE.ID_TIPOGUIA&#xA;    ,CTE.ID_CLIENTE&#xA;    ,CTE.ID_ESTADOENVIO&#xA;    ,CTE.ID_DOCU_ULT_MOVI&#xA;    ,CTE.ID_MEDTRANS&#xA;    ,CTE.ID_PRODUCTO&#xA;    ,CTE.ID_SUBPRODUCTO&#xA;    ,CTE.ID_ESTADOGUIA&#xA;    ,CTE.ID_TIEMPO_ENTREGA&#xA;    ,CTE.ID_REQ_EMBALAJE&#xA;    ,CTE.NUMERO_PIEZAS&#xA;    ,CTE.FECHA_ENTREGA&#xA;    ,CTE.FECHA_MODIFICACION&#xA;&#x9;,CTE.[ULT_MOV_FECHA_HORA_MOVIMIENTO]&#xA;&#x9;,CTE.[ULT_MOV_ID_PROCESO] &#xA;&#x9;,CTE.[ULT_MOV_NUMERO_MOVIMI] &#xA;&#x9;,CTE.[ULT_MOV_CONSECUT_MOVIMI]&#xA;FROM CTE&#xA;LEFT OUTER JOIN SIG_COLOMBIA_DW.TMP.MPCCO_PROMESA_V2 PR WITH (NOLOCK)&#xA;  ON CTE.NUMERO_GUIA = PR.NUMERO_GUIA&#xA; AND PR.NUMERO_GUIA IS NULL" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="0"
                SQLTask:DtsVariableName="User::VAL_fechaIni"
                SQLTask:ParameterDirection="Input"
                SQLTask:DataType="129"
                SQLTask:ParameterSize="-1" />
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="1"
                SQLTask:DtsVariableName="User::VAL_fechaFin"
                SQLTask:ParameterDirection="Input"
                SQLTask:DataType="129"
                SQLTask:ParameterSize="-1" />
            </SQLTask:SqlTaskData>
