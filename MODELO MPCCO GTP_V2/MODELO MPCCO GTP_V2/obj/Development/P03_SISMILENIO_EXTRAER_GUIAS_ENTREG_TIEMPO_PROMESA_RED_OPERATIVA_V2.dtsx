                <component
                  refId="Package\CALCULO INDICADOR ACIDO Y DEPURADA\SQL_SELECT_Novedades_responsable\SQL_SELECT_Novedades_responsable"
                  componentClassID="Microsoft.OLEDBSource"
                  contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                  description="OLE DB Source"
                  name="SQL_SELECT_Novedades_responsable"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT 
		CONVERT(VARCHAR(10), ISNULL(CONVERT(VARCHAR,P.ID_PROCESO),'-888')  + '-' + ISNULL(CONVERT(VARCHAR,I.ID_CONCEPTO),'-888') ) ID_PROCESO_CONCEPTO,
		ISNULL(CONVERT(INT,P.ID_PROCESO),'-888') AS ID_PROCESO,
		ISNULL(CONVERT(INT,I.ID_CONCEPTO),'-888') AS ID_CONCEPTO,
		ISNULL(P.NOMBRE_PROCESO_LOG,'NO DISPONIBLE') AS NOMBRE_PROCESO,
		ISNULL(I.NOMBRE_CONCEPTO,'NO DISPONIBLE') AS NOMBRE_CONCEPTO,
		CASE WHEN (ID_RESPONSABILIDAD) = 1 THEN
		'C'
		WHEN (ID_RESPONSABILIDAD) = 2 THEN
		'S'
		WHEN (ID_RESPONSABILIDAD) = 3 THEN
		'E'
		END AS [RESP],
		1 ES_DEPU,
		1 ES_DEPU_PV
FROM
		dbo.PROCESOS AS P WITH (NOLOCK)
LEFT JOIN 
		dbo.ITEM_CONCEPTO AS I WITH (NOLOCK)
	ON 
		P.ID_PROCESO = I.ID_PROCESO
WHERE 
	I.ID_RESPONSABILIDAD IS NOT NULL;</property>
                    <property
