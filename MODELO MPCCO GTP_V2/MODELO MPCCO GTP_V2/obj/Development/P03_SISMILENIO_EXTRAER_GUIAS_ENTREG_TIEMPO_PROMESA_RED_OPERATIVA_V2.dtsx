    <DTS:Executable
      DTS:refId="Package\Merge FAC_MPCCO_GTP2_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{CC6E4DD0-C96B-49CD-A9B3-8F0EE2121F49}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Merge FAC_MPCCO_GTP2_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{94C855A8-E2EA-4CF8-9340-DC0E1AB28830}"
          SQLTask:SqlStatementSource=";WITH src AS (&#xA;    SELECT &#xA;      CMD.NOMBRE_REGIONAL                              AS NOMBRE_REGIONAL,&#xA;      CMD.NOMBRE_CPL                                   AS NOMBRE_CPL,&#xA;      T.YEAR                                           AS AÑO,&#xA;      T.MONTH                                          AS MES_DEL_AÑO,&#xA;      T.DAY_OF_MONTH                                   AS DIA,&#xA;      SM.NOMBRE_UEN                                    AS NOMBRE_UEN,&#xA;      CONVERT(varchar(12),&#xA;        CAST(100.0 * SUM(CASE WHEN GRO.SE_PROMESA_CUMPLE_ACIDA    = 'SI' THEN 1 ELSE 0 END)&#xA;            / NULLIF(COUNT_BIG(*), 0) AS decimal(6,2))&#xA;      ) + '%'                                          AS RED_OPE_GUIAS_CUMPLIENDO_ACIDA,&#xA;      CONVERT(varchar(12),&#xA;        CAST(100.0 * SUM(CASE WHEN GRO.SE_PROMESA_CUMPLE_DEPURADA = 'SI' THEN 1 ELSE 0 END)&#xA;            / NULLIF(COUNT_BIG(*), 0) AS decimal(6,2))&#xA;      ) + '%'                                          AS RED_OPE_GUIAS_CUMPLIENDO_DEPURADA,&#xA;      COUNT(DISTINCT GRO.NUMERO_GUIA)                  AS CANTIDAD_GUIAS_TPROM_RED_V2&#xA;    FROM FAC.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2 AS GRO&#xA;    INNER JOIN DIM.CIUDADES_MOVIMIENTOS_DESTINO_MOVILIZADOS AS CMD&#xA;      ON GRO.ID_CIUDAD_DESTINO = CMD.ID_CIUDAD&#xA;    INNER JOIN DIM.TIEMPO AS T&#xA;      ON GRO.TIME_ID = T.TIME_ID&#xA;    INNER JOIN DIM.SUBPRODUCTOS_MOVIMIENTO AS SM&#xA;      ON GRO.ID_PRODUCTO = SM.ID_PRODUCTO&#xA;     AND GRO.ID_SUBPRODUCTO = SM.ID_SUBPRODUCTO&#xA;    INNER JOIN DIM.ESTADOS_ENVIO AS EE&#xA;      ON EE.ID_ESTADO_ENVIO = GRO.ID_ESTADOENVIO&#xA;    --WHERE T.[DATE] &gt;= '2025-08-14'&#xA;      AND EE.ID_ESTADO_ENVIO IN (3,4,5)&#xA;    GROUP BY CMD.NOMBRE_REGIONAL, CMD.NOMBRE_CPL, T.YEAR, T.MONTH, T.DAY_OF_MONTH, SM.NOMBRE_UEN&#xA;)&#xA;MERGE FAC.MPCCO_GTP2_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2 AS tgt&#xA;USING src&#xA;   ON tgt.NOMBRE_REGIONAL = src.NOMBRE_REGIONAL&#xA;  AND tgt.NOMBRE_CPL      = src.NOMBRE_CPL&#xA;  AND tgt.AÑO             = src.AÑO&#xA;  AND tgt.MES_DEL_AÑO     = src.MES_DEL_AÑO&#xA;  AND tgt.DIA             = src.DIA&#xA;  AND tgt.NOMBRE_UEN      = src.NOMBRE_UEN&#xA;&#xA;WHEN MATCHED AND (&#xA;       ISNULL(tgt.RED_OPE_GUIAS_CUMPLIENDO_ACIDA,    '') &lt;&gt; ISNULL(src.RED_OPE_GUIAS_CUMPLIENDO_ACIDA,    '')&#xA;    OR ISNULL(tgt.RED_OPE_GUIAS_CUMPLIENDO_DEPURADA, '') &lt;&gt; ISNULL(src.RED_OPE_GUIAS_CUMPLIENDO_DEPURADA, '')&#xA;    OR ISNULL(tgt.CANTIDAD_GUIAS_TPROM_RED_V2,       -1) &lt;&gt; ISNULL(src.CANTIDAD_GUIAS_TPROM_RED_V2,       -1)&#xA;) THEN&#xA;  UPDATE SET&#xA;      tgt.RED_OPE_GUIAS_CUMPLIENDO_ACIDA    = src.RED_OPE_GUIAS_CUMPLIENDO_ACIDA,&#xA;      tgt.RED_OPE_GUIAS_CUMPLIENDO_DEPURADA = src.RED_OPE_GUIAS_CUMPLIENDO_DEPURADA,&#xA;      tgt.CANTIDAD_GUIAS_TPROM_RED_V2       = src.CANTIDAD_GUIAS_TPROM_RED_V2,&#xA;      tgt.FECHA_MODIFICACION_DW             = GETDATE()   -- &lt;&lt;&lt; solo en UPDATE&#xA;&#xA;WHEN NOT MATCHED BY TARGET THEN&#xA;  INSERT (&#xA;      NOMBRE_REGIONAL, NOMBRE_CPL, AÑO, MES_DEL_AÑO, DIA, NOMBRE_UEN,&#xA;      RED_OPE_GUIAS_CUMPLIENDO_ACIDA, RED_OPE_GUIAS_CUMPLIENDO_DEPURADA,&#xA;      CANTIDAD_GUIAS_TPROM_RED_V2,&#xA;      FECHA_EXTRACCION_DW, FECHA_MODIFICACION_DW                     -- &lt;&lt;&lt; nuevas&#xA;  )&#xA;  VALUES (&#xA;      src.NOMBRE_REGIONAL, src.NOMBRE_CPL, src.AÑO, src.MES_DEL_AÑO, src.DIA, src.NOMBRE_UEN,&#xA;      src.RED_OPE_GUIAS_CUMPLIENDO_ACIDA, src.RED_OPE_GUIAS_CUMPLIENDO_DEPURADA,&#xA;      src.CANTIDAD_GUIAS_TPROM_RED_V2,GETDATE(), GETDATE()                              -- &lt;&lt;&lt; iguales en INSERT&#xA;  );" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Merge FAC_MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{EB9312C8-E1DC-4F99-83C0-37D2FD450A20}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Merge FAC_MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{94C855A8-E2EA-4CF8-9340-DC0E1AB28830}"
          SQLTask:SqlStatementSource="&#xA;;WITH src AS (&#xA;    SELECT&#xA;         T.TIME_ID&#xA;        ,T.FECHA&#xA;        ,T.DIA&#xA;        ,T.MES&#xA;        ,T.AÑO&#xA;        ,T.ID_CIUDAD_ORIGEN&#xA;        ,T.ID_CIUDAD_DESTINO&#xA;        ,T.ID_CLIENTE&#xA;        ,T.ID_ESTADOENVIO&#xA;        ,T.ID_PRODUCTO&#xA;        ,T.ID_SUBPRODUCTO&#xA;        ,CONVERT(VARCHAR(6),&#xA;           RIGHT('00' + CONVERT(VARCHAR, T.ID_PRODUCTO), 2) +&#xA;           RIGHT('0000' + CONVERT(VARCHAR, T.ID_SUBPRODUCTO), 4)&#xA;         ) AS ID_PROD_SUBP&#xA;        ,T.ID_TIEMPO_ENTREGA&#xA;        ,T.NUMERO_GUIA&#xA;        ,T.ID_RUTA&#xA;        ,ISNULL(T.ID_GRUPO_RED, -888)                       AS ID_GRUPO_RED&#xA;        ,ISNULL(T.TIEMPO_PROMESA_H, 0)                      AS TIEMPO_PROMESA_H&#xA;        ,ISNULL(T.TIEMPO_OFERTA, 0)                         AS TIEMPO_OFERTA&#xA;        ,ISNULL(T.TIEMPO_PROMESA_CUMPLE_H, 'NO')            AS TIEMPO_PROMESA_CUMPLE_H&#xA;        ,CONVERT(VARCHAR, G.ID_REGIONAL) + '-' + CONVERT(VARCHAR, T.ID_CONCEPTO)&#xA;                                                          AS ID_GEOGRAFIA_CONCEPTO&#xA;        ,T.HORAS_ND&#xA;        ,T.ID_ESTADO_ND&#xA;        ,ISNULL(T.GR_ID_TIPO_COBRO, -888)                   AS GR_ID_TIPO_COBRO&#xA;        ,CONVERT(VARCHAR(2),&#xA;            IIF(T.SE_PROMESA_CUMPLE_ACIDA = 'NO DISPONIBLE','NO',ISNULL(T.SE_PROMESA_CUMPLE_ACIDA,'NO'))&#xA;         ) AS SE_PROMESA_CUMPLE_ACIDA&#xA;        ,CONVERT(VARCHAR(2),&#xA;            IIF(T.SE_PROMESA_CUMPLE_DEPURADA = 'NO DISPONIBLE','NO',ISNULL(T.SE_PROMESA_CUMPLE_DEPURADA,'NO'))&#xA;         ) AS SE_PROMESA_CUMPLE_DEPURADA&#xA;        ,T.SE_RESPONSABLE_ID&#xA;        ,T.SE_FECHA_PROMESA_ENTREGA&#xA;        ,T.ID_PROCESO                                          -- &lt;&lt;&lt; NUEVO CAMPO&#xA;&#x9;&#x9;,T.ULT_MOV_FECHA_HORA_MOVIMIENTO&#xA;&#x9;&#x9;,T.ULT_MOV_ID_PROCESO&#xA;&#x9;&#x9;,T.ULT_MOV_NUMERO_MOVIMI&#xA;&#x9;&#x9;,T.ULT_MOV_CONSECUT_MOVIMI&#xA;    FROM TMP.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2 AS T&#xA;    LEFT JOIN SIG_COLOMBIA_DW.DIM.GEOGRAFIA AS G&#xA;      ON T.ID_CIUDAD_DESTINO = G.ID_CIUDAD&#xA;)&#xA;MERGE FAC.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2 AS tgt&#xA;USING src&#xA;   ON tgt.NUMERO_GUIA = src.NUMERO_GUIA&#xA;&#xA;WHEN MATCHED &#xA;&#xA;/*&#xA;AND (&#xA;       ISNULL(tgt.FECHA,'19000101')             &lt;&gt; ISNULL(src.FECHA,'19000101') OR&#xA;       ISNULL(tgt.DIA,-1)                       &lt;&gt; ISNULL(src.DIA,-1) OR&#xA;       ISNULL(tgt.MES,-1)                       &lt;&gt; ISNULL(src.MES,-1) OR&#xA;       ISNULL(tgt.AÑO,-1)                       &lt;&gt; ISNULL(src.AÑO,-1) OR&#xA;       ISNULL(tgt.ID_CIUDAD_ORIGEN,-1)          &lt;&gt; ISNULL(src.ID_CIUDAD_ORIGEN,-1) OR&#xA;       ISNULL(tgt.ID_CIUDAD_DESTINO,-1)         &lt;&gt; ISNULL(src.ID_CIUDAD_DESTINO,-1) OR&#xA;       ISNULL(tgt.ID_CLIENTE,-1)                &lt;&gt; ISNULL(src.ID_CLIENTE,-1) OR&#xA;       ISNULL(tgt.ID_ESTADOENVIO,-1)            &lt;&gt; ISNULL(src.ID_ESTADOENVIO,-1) OR&#xA;       ISNULL(tgt.ID_PRODUCTO,-1)               &lt;&gt; ISNULL(src.ID_PRODUCTO,-1) OR&#xA;       ISNULL(tgt.ID_SUBPRODUCTO,-1)            &lt;&gt; ISNULL(src.ID_SUBPRODUCTO,-1) OR&#xA;       ISNULL(tgt.ID_PROD_SUBP,'')              &lt;&gt; ISNULL(src.ID_PROD_SUBP,'') OR&#xA;       ISNULL(tgt.ID_TIEMPO_ENTREGA,-1)         &lt;&gt; ISNULL(src.ID_TIEMPO_ENTREGA,-1) OR&#xA;       ISNULL(tgt.ID_RUTA,-1)                   &lt;&gt; ISNULL(src.ID_RUTA,-1) OR&#xA;       ISNULL(tgt.ID_GRUPO_RED,-888)            &lt;&gt; ISNULL(src.ID_GRUPO_RED,-888) OR&#xA;       ISNULL(tgt.TIEMPO_PROMESA_H,0)           &lt;&gt; ISNULL(src.TIEMPO_PROMESA_H,0) OR&#xA;       ISNULL(tgt.TIEMPO_OFERTA,0)              &lt;&gt; ISNULL(src.TIEMPO_OFERTA,0) OR&#xA;       ISNULL(tgt.TIEMPO_PROMESA_CUMPLE_H,'NO') &lt;&gt; ISNULL(src.TIEMPO_PROMESA_CUMPLE_H,'NO') OR&#xA;       ISNULL(tgt.ID_GEOGRAFIA_CONCEPTO,'')     &lt;&gt; ISNULL(src.ID_GEOGRAFIA_CONCEPTO,'') OR&#xA;       ISNULL(tgt.HORAS_ND,0)                   &lt;&gt; ISNULL(src.HORAS_ND,0) OR&#xA;       ISNULL(tgt.ID_ESTADO_ND,'NO')            &lt;&gt; ISNULL(src.ID_ESTADO_ND,'NO') OR&#xA;       ISNULL(tgt.GR_ID_TIPO_COBRO,-888)        &lt;&gt; ISNULL(src.GR_ID_TIPO_COBRO,-888) OR&#xA;       ISNULL(tgt.SE_PROMESA_CUMPLE_ACIDA,'NO') &lt;&gt; ISNULL(src.SE_PROMESA_CUMPLE_ACIDA,'NO') OR&#xA;       ISNULL(tgt.SE_PROMESA_CUMPLE_DEPURADA,'NO') &lt;&gt; ISNULL(src.SE_PROMESA_CUMPLE_DEPURADA,'NO') OR&#xA;       ISNULL(tgt.SE_RESPONSABLE_ID,-1)         &lt;&gt; ISNULL(src.SE_RESPONSABLE_ID,-1) OR&#xA;       ISNULL(tgt.SE_FECHA_PROMESA_ENTREGA,'')  &lt;&gt; ISNULL(src.SE_FECHA_PROMESA_ENTREGA,'') OR&#xA;       ISNULL(tgt.ID_PROCESO,-1)                &lt;&gt; ISNULL(src.ID_PROCESO,-1)                -- &lt;&lt;&lt; NUEVO COMPARADOR&#xA;&#xA;) */&#xA;&#xA;THEN&#xA;    UPDATE SET&#xA;         tgt.FECHA                   = src.FECHA&#xA;        ,tgt.DIA                     = src.DIA&#xA;        ,tgt.MES                     = src.MES&#xA;        ,tgt.AÑO                     = src.AÑO&#xA;        ,tgt.ID_CIUDAD_ORIGEN        = src.ID_CIUDAD_ORIGEN&#xA;        ,tgt.ID_CIUDAD_DESTINO       = src.ID_CIUDAD_DESTINO&#xA;        ,tgt.ID_CLIENTE              = src.ID_CLIENTE&#xA;        ,tgt.ID_ESTADOENVIO          = src.ID_ESTADOENVIO&#xA;        ,tgt.ID_PRODUCTO             = src.ID_PRODUCTO&#xA;        ,tgt.ID_SUBPRODUCTO          = src.ID_SUBPRODUCTO&#xA;        ,tgt.ID_PROD_SUBP            = src.ID_PROD_SUBP&#xA;        ,tgt.ID_TIEMPO_ENTREGA       = src.ID_TIEMPO_ENTREGA&#xA;        ,tgt.ID_RUTA                 = src.ID_RUTA&#xA;        ,tgt.ID_GRUPO_RED            = src.ID_GRUPO_RED&#xA;        ,tgt.TIEMPO_PROMESA_H        = src.TIEMPO_PROMESA_H&#xA;        ,tgt.TIEMPO_OFERTA           = src.TIEMPO_OFERTA&#xA;        ,tgt.TIEMPO_PROMESA_CUMPLE_H = src.TIEMPO_PROMESA_CUMPLE_H&#xA;        ,tgt.ID_GEOGRAFIA_CONCEPTO   = src.ID_GEOGRAFIA_CONCEPTO&#xA;        ,tgt.HORAS_ND                = src.HORAS_ND&#xA;        ,tgt.ID_ESTADO_ND            = src.ID_ESTADO_ND&#xA;        ,tgt.GR_ID_TIPO_COBRO        = src.GR_ID_TIPO_COBRO&#xA;        ,tgt.SE_PROMESA_CUMPLE_ACIDA = src.SE_PROMESA_CUMPLE_ACIDA&#xA;        ,tgt.SE_PROMESA_CUMPLE_DEPURADA = src.SE_PROMESA_CUMPLE_DEPURADA&#xA;        ,tgt.SE_RESPONSABLE_ID       = src.SE_RESPONSABLE_ID&#xA;        ,tgt.SE_FECHA_PROMESA_ENTREGA = src.SE_FECHA_PROMESA_ENTREGA&#xA;        ,tgt.ID_PROCESO              = src.ID_PROCESO            -- &lt;&lt;&lt; NUEVO UPDATE&#xA;        ,tgt.FECHA_MODIFICACION_DW   = GETDATE()&#xA;&#x9;&#x9;,tgt.ULT_MOV_FECHA_HORA_MOVIMIENTO   = src.ULT_MOV_FECHA_HORA_MOVIMIENTO&#xA;&#x9;&#x9;,tgt.ULT_MOV_ID_PROCESO&#x9;&#x9;&#x9;&#x9; = src.ULT_MOV_ID_PROCESO&#xA;&#x9;&#x9;,tgt.ULT_MOV_NUMERO_MOVIMI&#x9;&#x9;&#x9; = src.ULT_MOV_NUMERO_MOVIMI&#xA;&#x9;&#x9;,tgt.ULT_MOV_CONSECUT_MOVIMI&#x9;&#x9; = src.ULT_MOV_CONSECUT_MOVIMI&#xA;WHEN NOT MATCHED BY TARGET THEN&#xA;    INSERT (&#xA;         TIME_ID, FECHA, DIA, MES, AÑO&#xA;        ,ID_CIUDAD_ORIGEN, ID_CIUDAD_DESTINO, ID_CLIENTE, ID_ESTADOENVIO&#xA;        ,ID_PRODUCTO, ID_SUBPRODUCTO, ID_PROD_SUBP, ID_TIEMPO_ENTREGA&#xA;        ,NUMERO_GUIA, ID_RUTA, ID_GRUPO_RED, TIEMPO_PROMESA_H, TIEMPO_OFERTA&#xA;        ,TIEMPO_PROMESA_CUMPLE_H, ID_GEOGRAFIA_CONCEPTO, HORAS_ND, ID_ESTADO_ND&#xA;        ,GR_ID_TIPO_COBRO, SE_PROMESA_CUMPLE_ACIDA, SE_PROMESA_CUMPLE_DEPURADA&#xA;        ,SE_RESPONSABLE_ID, CAUSAL_INCUMPLIMIENTO, TIEMPO_EXCEDIDO_HR, TIEMPO_EJECUTADO_HR&#xA;        ,SE_FECHA_PROMESA_ENTREGA&#xA;        ,ID_PROCESO                     -- &lt;&lt;&lt; NUEVA COLUMNA EN INSERT&#xA;        ,FECHA_EXTRACCION_DW, FECHA_MODIFICACION_DW&#xA;&#x9;&#x9;,ULT_MOV_FECHA_HORA_MOVIMIENTO&#xA;&#x9;&#x9;,ULT_MOV_ID_PROCESO&#xA;&#x9;&#x9;,ULT_MOV_NUMERO_MOVIMI&#xA;&#x9;&#x9;,ULT_MOV_CONSECUT_MOVIMI&#xA;    )&#xA;    VALUES (&#xA;         src.TIME_ID, src.FECHA, src.DIA, src.MES, src.AÑO&#xA;        ,src.ID_CIUDAD_ORIGEN, src.ID_CIUDAD_DESTINO, src.ID_CLIENTE, src.ID_ESTADOENVIO&#xA;        ,src.ID_PRODUCTO, src.ID_SUBPRODUCTO, src.ID_PROD_SUBP, src.ID_TIEMPO_ENTREGA&#xA;        ,src.NUMERO_GUIA, src.ID_RUTA, src.ID_GRUPO_RED, src.TIEMPO_PROMESA_H, src.TIEMPO_OFERTA&#xA;        ,src.TIEMPO_PROMESA_CUMPLE_H, src.ID_GEOGRAFIA_CONCEPTO, src.HORAS_ND, src.ID_ESTADO_ND&#xA;        ,src.GR_ID_TIPO_COBRO, src.SE_PROMESA_CUMPLE_ACIDA, src.SE_PROMESA_CUMPLE_DEPURADA&#xA;        ,src.SE_RESPONSABLE_ID, NULL, NULL, NULL&#xA;        ,src.SE_FECHA_PROMESA_ENTREGA&#xA;        ,src.ID_PROCESO                 -- &lt;&lt;&lt; NUEVO VALUE&#xA;        ,GETDATE(), GETDATE()&#xA;&#x9;&#x9;,src.ULT_MOV_FECHA_HORA_MOVIMIENTO&#xA;&#x9;&#x9;,src.ULT_MOV_ID_PROCESO&#xA;&#x9;&#x9;,src.ULT_MOV_NUMERO_MOVIMI&#xA;&#x9;&#x9;,src.ULT_MOV_CONSECUT_MOVIMI&#xA;    );&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\NOVEDAD DIARIA"
      DTS:CreationName="STOCK:SEQUENCE"
