                    <externalMetadataColumn
                      refId="Package\SQL_SELECT_Guias_entreg_tiempo_promesa_red_operativa_v2\TMP_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2.Inputs[OLE DB Destination Input].ExternalColumns[SE_PROMESA_CUMPLE_DEPURADA]"
                      codePage="1252"
