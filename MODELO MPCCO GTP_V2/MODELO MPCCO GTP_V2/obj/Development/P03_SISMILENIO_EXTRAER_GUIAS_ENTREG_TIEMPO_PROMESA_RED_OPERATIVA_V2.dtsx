        <DTS:Executable
          DTS:refId="Package\CALCULO INDICADOR ACIDO Y DEPURADA\SQL_INSERT_Obtener_guia_depurada"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{167ABB73-D0F1-4449-9165-F6DA15701AE6}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="SQL_INSERT_Obtener_guia_depurada"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{94C855A8-E2EA-4CF8-9340-DC0E1AB28830}"
              SQLTask:SqlStatementSource="INSERT INTO TMP.MPCCO_CUMPLIMIENTO_AC_DEP_03&#xA;           ([G_NUMERO_GUIA]&#xA;           ,[NOMBRE_TIPO_NOVEDAD]&#xA;           ,[NOMBRE_NOVEDAD]&#xA;           ,[RESP]&#xA;           ,[FECHA_HORA_MOVIMIENTO])&#xA;SELECT&#xA;&#x9; CLI.G_NUMERO_GUIA&#xA;&#x9;,CONVERT(VARCHAR(50), 'NOVEDAD OPERATIVA') AS NOMBRE_TIPO_NOVEDAD&#xA;&#x9;,TNO.NOMBRE_TIPO_NOVEDAD AS NOMBRE_NOVEDAD&#xA;&#x9;,IIF(TNO.ES_NOVEDAD_EXTERNA = 1, 'E', IIF(TNO.ES_NOVEDAD_EXTERNA = 0, 'S', NULL)) AS RESP&#xA;&#x9;,CLI.FECHA_HORA_MOVIMIENTO&#xA;FROM&#xA;&#x9;SIG_COLOMBIA_DW.LOG.MPCCO_DETALLE_NOVEDAD_DIARIA DETND WITH (NOLOCK)&#xA;INNER JOIN&#xA;&#x9;SIG_COLOMBIA_DW.LOG.MPCCO_DOCUMENTOS_NOVEDAD_DIARIA DOCND WITH (NOLOCK)&#xA;&#x9;ON DETND.ID_PAIS_UNO = DOCND.ID_PAIS_UNO&#xA;   AND DETND.ID_CIUDAD_UNO = DOCND.ID_CIUDAD_UNO&#xA;INNER JOIN&#xA;&#x9;SIG_COLOMBIA_DW.LOG.MPCCO_NOVEDAD_DIARIA ND WITH (NOLOCK)&#xA;&#x9;ON DETND.ID_PAIS_UNO = ND.ID_PAIS_UNO&#xA;   AND DETND.ID_CIUDAD_UNO = ND.ID_CIUDAD_UNO&#xA;INNER JOIN&#xA;&#x9;SIG_COLOMBIA_DW.PAR.TIPOSNOVEDADESOPERATIVAS TNO WITH (NOLOCK)&#xA;&#x9;ON ND.ID_TIPO_NOVEDAD = TNO.ID_TIPO_NOVEDAD&#xA;INNER JOIN&#xA;&#x9;TMP.MPCCO_CUMPLIMIENTO_AC_DEP_02 CLI&#xA;&#x9;ON DOCND.ID_PROCESO = CLI.ID_PROCESO&#xA;   AND DOCND.NUMERO_MOVIMI = CLI.NUMERO_MOVIMI&#xA;   AND DOCND.CONSECUT_MOVIMI = CLI.CONSECUT_MOVIMI&#xA;   AND DETND.PLACA_VEHICULO_DOCU = CLI.PLACA_VEHICULO_DOCU&#xA;WHERE&#xA;&#x9;DETND.FECHA_NOVEDAD = DOCND.FECHA_NOVEDAD&#xA;  AND DETND.FECHA_NOVEDAD = ND.FECHA_NOVEDAD;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\CALCULO INDICADOR ACIDO Y DEPURADA\SQL_INSERT_Placa_depurada"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{76FF70EF-89A6-4BE3-A39D-6D4A68E7DE6E}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="SQL_INSERT_Placa_depurada"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{94C855A8-E2EA-4CF8-9340-DC0E1AB28830}"
              SQLTask:SqlStatementSource="&#xA;  WITH CTE (&#xA;    G_NUMERO_GUIA,&#xA;    ID_PROCESO,&#xA;    NUMERO_MOVIMI,&#xA;    CONSECUT_MOVIMI,&#xA;    FECHA_HORA_MOVIMIENTO&#xA;) AS (&#xA;    SELECT&#xA;        C.G_NUMERO_GUIA,&#xA;        P.ID_PROCESO,&#xA;        P.NUMERO_MOVIMI,&#xA;        P.CONSECUT_MOVIMI,&#xA;        P.FECHA_HORA_MOVIMIENTO&#xA;    FROM TMP.MPCCO_CUMPLIMIENTO_AC_DEP C WITH (NOLOCK)&#xA;    INNER JOIN TMP.MPCCO_CUMPLIMIENTO_AC_DEP_01 P WITH (NOLOCK)&#xA;      ON C.G_NUMERO_GUIA = P.NUMERO_GUIA&#xA;    WHERE (C.SE_PROMESA_CUMPLE_DEPURADA = 'NO' OR C.SE_PROMESA_CUMPLE_ACIDA = 'NO')&#xA;      AND P.ID_PROCESO = 12&#xA;)&#xA;INSERT INTO TMP.MPCCO_CUMPLIMIENTO_AC_DEP_02 (&#xA;    G_NUMERO_GUIA,&#xA;    ID_PROCESO,&#xA;    NUMERO_MOVIMI,&#xA;    CONSECUT_MOVIMI,&#xA;    PLACA_VEHICULO_DOCU,&#xA;    FECHA_HORA_MOVIMIENTO&#xA;)&#xA;SELECT&#xA;    CTE.G_NUMERO_GUIA,&#xA;    CTE.ID_PROCESO,&#xA;    CTE.NUMERO_MOVIMI,&#xA;    CTE.CONSECUT_MOVIMI,&#xA;    D.PLACA_VEHICULO_DOCU,&#xA;    CTE.FECHA_HORA_MOVIMIENTO&#xA;FROM SIG_COLOMBIA_DW.LOG.MPCCO_DOCUMENTOS_6MESES D WITH (NOLOCK)&#xA;INNER JOIN CTE&#xA;  ON D.ID_PROCESO    = CTE.ID_PROCESO&#xA; AND D.NUMERO_MOVIMI = CTE.NUMERO_MOVIMI&#xA; AND D.CONSECUT_MOVIMI = CTE.CONSECUT_MOVIMI;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\CALCULO INDICADOR ACIDO Y DEPURADA\SQL_SELECT_Cumplimiento_ac_dep"
          DTS:CreationName="Microsoft.Pipeline"
          DTS:Description="Data Flow Task"
          DTS:DTSID="{0B988BC9-2AA6-457F-A92A-6A89AB1D8C9E}"
          DTS:ExecutableType="Microsoft.Pipeline"
          DTS:LocaleID="-1"
          DTS:ObjectName="SQL_SELECT_Cumplimiento_ac_dep"
          DTS:TaskContact="Performs high-performance data extraction, transformation and loading;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1">
          <DTS:Variables />
          <DTS:ObjectData>
            <pipeline
              version="1">
              <components>
                <component
                  refId="Package\CALCULO INDICADOR ACIDO Y DEPURADA\SQL_SELECT_Cumplimiento_ac_dep\SQL_SELECT_Cumplimiento_ac_dep"
                  componentClassID="Microsoft.OLEDBSource"
                  contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                  description="OLE DB Source"
                  name="SQL_SELECT_Cumplimiento_ac_dep"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">WITH PROMESA AS (
	SELECT 
		 NUMERO_GUIA AS G_NUMERO_GUIA
		,0 AS SE_ID_FECHA
		,'1900-01-01' AS SE_FECHA
		,ISNULL(ID_CIUDAD_ORIGEN,-888) AS  G_ID_CIUDAD_ORIGEN
		,ISNULL(ID_CIUDAD_DESTINO,-888) AS G_ID_CIUDAD_DESTINO
		,ISNULL(ID_CLIENTE,-888) AS G_ID_CLIENTE
		,ISNULL(CONVERT(INT,ID_TIEMPO_ENTREGA),-888) AS G_ID_TIEMPO
		,ISNULL(CONVERT(INT,ID_MEDTRANS),-888) AS G_ID_MEDTRANS
		,0 AS G_ID_HABIL_SABADO
		,GR_ID_TIPO_COBRO
	FROM 
		SIG_COL_LOGISTICA_DW.TMP.MPCCO_PROMESA_V2 T WITH (NOLOCK)
		WHERE ID_TIEMPO_ENTREGA = 1
)

SELECT 
	 GUIAS.G_NUMERO_GUIA
	,GUIAS.SE_ID_FECHA
	,GUIAS.SE_FECHA
	,GUIAS.G_ID_CIUDAD_ORIGEN
	,GUIAS.G_ID_CIUDAD_DESTINO
	,GUIAS.G_ID_CLIENTE
	,GUIAS.G_ID_TIEMPO
	,GUIAS.G_ID_MEDTRANS
	,GUIAS.G_ID_HABIL_SABADO
	,GUIAS.GR_ID_TIPO_COBRO
	,ISNULL(RED.ID_RUTA,0) AS ID_RUTA
	,RED2.TIEMPO_ENTREGA_COMERCIAL_HOR AS TIEMPO_OFERTA
	, CASE WHEN ISNULL(RED.ID_RUTA,0) = 0 THEN 0  
				WHEN RED2.TIEMPO_ENTREGA_COMERCIAL_HOR BETWEEN 0 AND 36 THEN 1 
				WHEN RED2.TIEMPO_ENTREGA_COMERCIAL_HOR BETWEEN 37 AND 60 THEN 2
				WHEN RED2.TIEMPO_ENTREGA_COMERCIAL_HOR BETWEEN 61 AND 84 THEN 3
				WHEN RED2.TIEMPO_ENTREGA_COMERCIAL_HOR BETWEEN 85 AND 108 THEN 4
				ELSE 5 END 		
	  AS ID_GRUPO_RED
	,C.TIEMPO_PROMESA_H
	,C.TIEMPO_PROMESA_CUMPLE_H
FROM PROMESA AS GUIAS 
INNER JOIN  DIM.MPCCO_RED_OPERATIVA_RUTA_V2 RED
	ON	GUIAS.G_ID_CIUDAD_ORIGEN = RED.ID_CIUDAD_ORIGEN
	AND	GUIAS.G_ID_CIUDAD_DESTINO = RED.ID_CIUDAD_DESTINO
	AND	GUIAS.G_ID_TIEMPO = RED.ID_TIEMPO
	AND GUIAS.G_ID_MEDTRANS = RED.ID_MEDTRANS
INNER JOIN  DIM.RED_OPERATIVA_RUTA RED2
	ON  ISNULL(RED.ID_RUTA,0) = RED2.ID_RUTA
/* SE CRUZA CON LA TEMPORAL DEL CUBO ANTIGUO PARA TRER DATOS QUE YA FUERON PROCESADOS 
POR TIEMPO PROMESA */
INNER JOIN TMP.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA AS C WITH(NOLOCK)
	ON C.NUMERO_GUIA = GUIAS.G_NUMERO_GUIA</property>
                    <property
