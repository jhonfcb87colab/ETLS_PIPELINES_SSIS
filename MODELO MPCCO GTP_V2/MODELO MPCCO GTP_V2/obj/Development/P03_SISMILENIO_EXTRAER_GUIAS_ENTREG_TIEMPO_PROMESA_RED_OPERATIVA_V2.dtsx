          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{CE05DB66-31E1-4BF7-B85A-81929B965F18}"
              SQLTask:SqlStatementSource="TRUNCATE TABLE TMP.MPCCO_PROMESA_NDCENLOG_V2;&#xA;TRUNCATE TABLE TMP.MPCCO_PROMESA_NDBASE_V2;&#xA;TRUNCATE TABLE TMP.MPCCO_PROMESA_ND01_V2;&#xA;TRUNCATE TABLE TMP.MPCCO_PROMESA_ND02_01;&#xA;TRUNCATE TABLE TMP.MPCCO_PROMESA_ND02_02_V2;&#xA;TRUNCATE TABLE TMP.MPCCO_PROMESA_ND02_V2;&#xA;TRUNCATE TABLE TMP.MPCCO_PROMESA_ND03_01_V2;&#xA;TRUNCATE TABLE TMP.MPCCO_PROMESA_ND03_02_V2;&#xA;TRUNCATE TABLE TMP.MPCCO_PROMESA_ND04_01_V2;&#xA;TRUNCATE TABLE TMP.MPCCO_PROMESA_ND04;&#xA;TRUNCATE TABLE TMP.MPCCO_PROMESA_ND05_01_V2;&#xA;TRUNCATE TABLE TMP.MPCCO_PROMESA_ND05_V2;&#xA;TRUNCATE TABLE TMP.MPCCO_PROMESA_ND_V2;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
