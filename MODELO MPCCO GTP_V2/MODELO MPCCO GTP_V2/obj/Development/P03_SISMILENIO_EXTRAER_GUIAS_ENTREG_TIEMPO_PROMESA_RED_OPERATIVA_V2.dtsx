      DTS:EvaluateAsExpression="True"
      DTS:Expression="@[$Project::REPOBLAR] == &quot;NO&quot;&#xA;?&#xA;(DT_WSTR,10)(&#xA;    (DT_WSTR,4) YEAR(DATEADD(&quot;day&quot;, 1 - @[$Project::Dias_Hacia_Atras], GETDATE()))&#xA;    + &quot;-&quot;&#xA;    + RIGHT(&quot;0&quot; + (DT_WSTR,2) MONTH(DATEADD(&quot;day&quot;, 1 - @[$Project::Dias_Hacia_Atras], GETDATE())), 2)&#xA;    + &quot;-&quot;&#xA;    + RIGHT(&quot;0&quot; + (DT_WSTR,2) DAY(DATEADD(&quot;day&quot;, 1 - @[$Project::Dias_Hacia_Atras], GETDATE())), 2)&#xA;)&#xA;:&#xA;(DT_WSTR,10) @[$Project::datFechaInicio]"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="VAL_fechaIni">
      <DTS:VariableValue
        DTS:DataType="8">2026-02-08</DTS:VariableValue>
