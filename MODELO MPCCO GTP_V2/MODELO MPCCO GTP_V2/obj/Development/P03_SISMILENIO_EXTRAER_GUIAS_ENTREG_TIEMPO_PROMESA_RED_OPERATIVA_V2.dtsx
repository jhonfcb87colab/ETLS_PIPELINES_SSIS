        <DTS:Executable
          DTS:refId="Package\CALCULO INDICADOR ACIDO Y DEPURADA\SQL_SELECT_Fecha_entrega_promesa"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{0E6E45A5-1670-4681-8F02-F65C3DAC3C83}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="SQL_SELECT_Fecha_entrega_promesa"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{94C855A8-E2EA-4CF8-9340-DC0E1AB28830}"
              SQLTask:SqlStatementSource="IF OBJECT_ID('tempdb..#FECHA_ENTREGA_PRIMGEST') IS NOT NULL DROP TABLE #FECHA_ENTREGA_PRIMGEST;&#xA;&#xA;SELECT&#xA;    DATEADD(ms,-3, DATEADD(dd, DATEDIFF(dd, 0, SE_ID_FECHA_PRIMGEST), 1)) AS SE_ID_FECHA_PRIMGEST,&#xA;    TIEMPO_OFERTA,&#xA;    SIG_COLOMBIA_DW.LOG.UFN_COUNT_HORA_RANGE(&#xA;        DATEADD(ms,-3, DATEADD(dd, DATEDIFF(dd, 0, SE_ID_FECHA_PRIMGEST), 1)),&#xA;        TIEMPO_OFERTA,&#xA;        'DIA DOMINICAL,DIA FESTIVO'&#xA;    ) AS ID_FECHA_PROMESA_ENTREGA&#xA;INTO #FECHA_ENTREGA_PRIMGEST&#xA;FROM SIG_COL_LOGISTICA_DW.TMP.MPCCO_CUMPLIMIENTO_AC_DEP WITH (NOLOCK)&#xA;GROUP BY DATEADD(ms,-3, DATEADD(dd, DATEDIFF(dd, 0, SE_ID_FECHA_PRIMGEST), 1)), TIEMPO_OFERTA;&#xA;&#xA;UPDATE TMP&#xA;SET&#xA;    TMP.SE_ID_FECHA_PROMESA_ENTREGA = PRM.ID_FECHA_PROMESA_ENTREGA,&#xA;    TMP.SE_FECHA_PROMESA_ENTREGA    = CONVERT(varchar(50), CONVERT(date, PRM.ID_FECHA_PROMESA_ENTREGA))&#xA;FROM TMP.MPCCO_CUMPLIMIENTO_AC_DEP AS TMP&#xA;INNER JOIN #FECHA_ENTREGA_PRIMGEST AS PRM&#xA;  ON DATEADD(ms,-3, DATEADD(dd, DATEDIFF(dd, 0, TMP.SE_ID_FECHA_PRIMGEST), 1)) = PRM.SE_ID_FECHA_PRIMGEST&#xA; AND TMP.TIEMPO_OFERTA = PRM.TIEMPO_OFERTA;&#xA;&#xA;DROP TABLE IF EXISTS #FECHA_ENTREGA_PRIMGEST;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\CALCULO INDICADOR ACIDO Y DEPURADA\SQL_SELECT_Novedades_procesos_depurada"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{2BE2FF58-9C24-4149-B504-B2187D4C39D0}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="SQL_SELECT_Novedades_procesos_depurada"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{94C855A8-E2EA-4CF8-9340-DC0E1AB28830}"
              SQLTask:SqlStatementSource="  INSERT INTO TMP.MPCCO_CUMPLIMIENTO_AC_DEP_04&#xA;           ([G_NUMERO_GUIA]&#xA;           ,[SE_DESC_PROC_DEPU]&#xA;           ,[SE_DESC_CONC_DEPU]&#xA;           ,[SE_DEPURADO_RESP]&#xA;           ,[FECHA_HORA_MOVIMIENTO])&#xA;SELECT&#xA;         C.G_NUMERO_GUIA&#xA;        ,D.NOMBRE_PROCESO AS SE_DESC_PROC_DEPU&#xA;        ,D.NOMBRE_PROCESO AS SE_DESC_CONC_DEPU&#xA;        ,D.RESP AS SE_DEPURADO_RESP&#xA;        ,P.FECHA_HORA_MOVIMIENTO&#xA;FROM TMP.MPCCO_CUMPLIMIENTO_AC_DEP C WITH (NOLOCK)&#xA;INNER JOIN TMP.MPCCO_CUMPLIMIENTO_AC_DEP_01 P WITH (NOLOCK)&#xA;  ON C.G_NUMERO_GUIA = P.NUMERO_GUIA&#xA;INNER JOIN TMP.MPCCO_NOVEDADES_RESPONSABLE D&#xA;  ON P.ID_PROCESO = D.ID_PROCESO&#xA; AND P.ID_CONCEPTO = D.ID_CONCEPTO&#xA;WHERE D.ES_DEPU = 1&#xA;  AND C.SE_PROMESA_CUMPLE_DEPURADA = 'NO';&#xA;&#xA;INSERT INTO TMP.MPCCO_CUMPLIMIENTO_AC_DEP_04&#xA;           ([G_NUMERO_GUIA]&#xA;           ,[SE_DESC_PROC_DEPU]&#xA;           ,[SE_DESC_CONC_DEPU]&#xA;           ,[SE_DEPURADO_RESP]&#xA;           ,[FECHA_HORA_MOVIMIENTO])&#xA;SELECT&#xA;         C.G_NUMERO_GUIA&#xA;        ,N.NOMBRE_TIPO_NOVEDAD AS SE_DESC_PROC_DEPU&#xA;        ,N.NOMBRE_NOVEDAD AS SE_DESC_CONC_DEPU&#xA;        ,N.RESP AS SE_DEPURADO_RESP&#xA;        ,N.FECHA_HORA_MOVIMIENTO&#xA;FROM TMP.MPCCO_CUMPLIMIENTO_AC_DEP C WITH (NOLOCK)&#xA;INNER JOIN TMP.MPCCO_CUMPLIMIENTO_AC_DEP_03 N WITH (NOLOCK)&#xA;  ON C.G_NUMERO_GUIA = N.G_NUMERO_GUIA&#xA;WHERE C.SE_PROMESA_CUMPLE_DEPURADA = 'NO';&#xA;&#xA;;WITH CTE (&#xA;  ID,&#xA;  G_NUMERO_GUIA,&#xA;  SE_DESC_PROC_DEPU,&#xA;  SE_DESC_CONC_DEPU,&#xA;  SE_DEPURADO_RESP&#xA;) AS (&#xA;  SELECT&#xA;      ROW_NUMBER() OVER (PARTITION BY G_NUMERO_GUIA ORDER BY FECHA_HORA_MOVIMIENTO) AS ID,&#xA;      G_NUMERO_GUIA,&#xA;      SE_DESC_PROC_DEPU,&#xA;      SE_DESC_CONC_DEPU,&#xA;      SE_DEPURADO_RESP&#xA;  FROM TMP.MPCCO_CUMPLIMIENTO_AC_DEP_04 C WITH (NOLOCK)&#xA;)&#xA;UPDATE C&#xA;SET&#xA;  C.SE_RESPONSABLE_ID = ISNULL(CTE.SE_DEPURADO_RESP, 'NO APLICA')&#xA;FROM TMP.MPCCO_CUMPLIMIENTO_AC_DEP AS C&#xA;INNER JOIN CTE&#xA;  ON C.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA&#xA;WHERE CTE.ID = 1;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
