      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{94C855A8-E2EA-4CF8-9340-DC0E1AB28830}"
          SQLTask:SqlStatementSource="UPDATE TMP.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2&#xA;SET &#xA;  SE_PROMESA_CUMPLE_ACIDA    = TIEMPO_PROMESA_CUMPLE_H,&#xA;  SE_PROMESA_CUMPLE_DEPURADA = TIEMPO_PROMESA_CUMPLE_H,&#xA;  SE_RESPONSABLE_ID          = 'NO APLICA'&#xA;FROM TMP.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\TRANSFORMACION PROMESA FALLAS"
      DTS:CreationName="STOCK:SEQUENCE"
      DTS:Description="Sequence Container"
      DTS:DTSID="{203A9FE7-B71C-48C5-86E1-F2C73229303D}"
      DTS:ExecutableType="STOCK:SEQUENCE"
      DTS:LocaleID="-1"
      DTS:ObjectName="TRANSFORMACION PROMESA FALLAS">
      <DTS:Variables />
      <DTS:Executables>
        <DTS:Executable
          DTS:refId="Package\TRANSFORMACION PROMESA FALLAS\SQL_INSERT_Promesa_red_operativa_v2"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{F901269F-C95D-4126-9B00-042132D0FF65}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="SQL_INSERT_Promesa_red_operativa_v2"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{94C855A8-E2EA-4CF8-9340-DC0E1AB28830}"
              SQLTask:SqlStatementSource="/*&#xA;User::SQL_INSERT_Promesa_red_operativa_v2&#xA;&#xA;*/&#xA;&#xA;&#xA;--******************************************&#xA;-----&#x9;&#x9;CONSTRUIDO POR SERVIENTREGA&#xA;--********************************************************************************************************************************************/&#xA;&#xA;-- =========================================================================================================&#xA;-- PASO 01 DEFINIR VARIABLES TEMPORALES&#xA;-- =========================================================================================================&#xA;&#xA;&#x9; DECLARE @NUM_REG INT&#xA;&#x9;&#x9;&#x9;,@CONSECUTIVO INT&#xA;&#x9;&#x9;&#x9;,@FECHA_MIN DATETIME&#xA;&#x9;&#x9;&#x9;,@FECHA_CAM DATETIME&#xA;&#x9;&#x9;&#x9;,@FECHA_ULT DATETIME&#xA;&#x9;&#x9;&#x9;,@FMIN DATETIME&#xA;&#x9;&#x9;&#x9;,@FMAX DATETIME&#xA;&#x9;&#x9;&#x9;,@FECHA_MINIMA DATETIME&#xA;&#x9;&#x9;&#x9;,@FECHA_MAX DATETIME&#xA;&#x9;&#x9;&#x9;,@MENOS_MI INT&#xA;&#x9;&#x9;&#x9;,@MENOS_MA INT&#xA;&#x9;&#x9;&#x9;,@TIEMPO INT&#xA;&#x9;&#x9;&#x9;,@CONCEPTO VARCHAR(2)&#xA;&#x9;&#x9;&#x9;&#xA;&#x9;/*CREACIÓN DE LAS TABLAS TEMPORALES PARA EL PROCESO EN EL WHILE*/&#xA;&#x9;IF OBJECT_ID('TEMPDB..#MPCCO_TMP_GUIA_FECHA') IS NOT NULL&#xA;&#x9;DROP TABLE #MPCCO_TMP_GUIA_FECHA&#xA;&#x9;&#xA;&#x9;IF OBJECT_ID('TEMPDB..#MPCCO_TMP_TIEMPO_ENV_MOV') IS NOT NULL&#xA;&#x9;DROP TABLE #MPCCO_TMP_TIEMPO_ENV_MOV&#xA;&#x9;&#x9;&#xA;&#x9;CREATE TABLE #MPCCO_TMP_GUIA_FECHA&#xA;&#x9;&#x9;(&#xA;&#x9;&#x9;&#x9;CONSECUTIVO INT IDENTITY(1,1),&#xA;&#x9;&#x9;&#x9;NUMERO_GUIA NUMERIC(20) NULL,&#xA;&#x9;&#x9;&#x9;ID_CONCEPTO VARCHAR(10) NULL,&#xA;&#x9;&#x9;&#x9;FECHA_ENVIO DATETIME NULL,&#xA;&#x9;&#x9;&#x9;FECHA_ENTREGA DATETIME NULL&#xA;&#x9;&#x9;)&#xA;&#xA;&#x9;CREATE TABLE #MPCCO_TMP_TIEMPO_ENV_MOV&#xA;&#x9;&#x9;(&#xA;&#x9;&#x9;&#x9;CONSECUTIVO INT,&#xA;&#x9;&#x9;&#x9;NUMERO_GUIA NUMERIC(20) NULL,&#xA;&#x9;&#x9;&#x9;ID_CONCEPTO VARCHAR(10) NULL,&#xA;&#x9;&#x9;&#x9;FECHA_ENVIO DATETIME NULL,&#xA;&#x9;&#x9;&#x9;FECHA_ENTREGA DATETIME NULL,&#xA;&#x9;&#x9;&#x9;TIEMPO NUMERIC(18) NULL&#xA;&#x9;&#x9;)&#xA;&#xA;-- =========================================================================================================&#xA;-- PASO 02 INSERTAR EN UNA TABLA TEMPORAL LOS CAMPOS NECESARIOS PARA EL CALCULO DE TIEMPO&#xA;-- =========================================================================================================&#xA;&#xA;&#xA;&#xA;&#x9;INSERT INTO  #MPCCO_TMP_GUIA_FECHA&#xA;               SELECT   NUMERO_GUIA&#xA;&#x9;               ,'0' ID_CONCEPTO&#xA;&#x9;&#x9;,FECHA FECHA_ENVIO&#xA;                                ,ISNULL(FECHA_ENTREGA,CONVERT(DATETIME,CONVERT(DATE,GETDATE()))) FECHA_ENTREGA&#xA;&#x9;FROM SIG_COL_LOGISTICA_DW.TMP.MPCCO_PROMESA_V2  AS EM WITH (NOLOCK)&#xA;&#xA;&#x9;WHERE ID_TIEMPO_ENTREGA &lt;&gt; 1 -- REQ 8 Y 9 EL TIEMPO DE ENTREGA SE VALIDARÁ EN ACIDO Y DEPURADA&#xA;&#xA;&#x9;ORDER BY FECHA_ENVIO, NUMERO_GUIA&#xA;&#xA;&#x9;CREATE INDEX IDX2 ON #MPCCO_TMP_GUIA_FECHA(CONSECUTIVO)&#xA;&#x9;&#xA;&#xA;--SELECT * FROM SIG_COL_LOGISTICA_DW.TMP.MPCCO_PROMESA_V2  AS EM WITH (NOLOCK)&#xA;--SELECT * FROM  TMP.GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2 WITH (NOLOCK)&#xA;--SELECT * FROM #MPCCO_TMP_GUIA_FECHA&#xA;-- =========================================================================================================&#xA;-- PASO 03 BUCLE PARA EL CALCULO DEL TIEMPO DE PROMESA&#xA;-- =========================================================================================================&#xA;&#xA;-- =========================================================================================================&#xA;-- PASO 03.01 INICIA CONTADORES DEL BUCLE&#xA;-- =========================================================================================================&#xA;&#xA;&#x9;SET @NUM_REG = 0&#xA;&#x9;SET @CONSECUTIVO = 0&#xA;&#xA;&#x9;SELECT&#x9;@NUM_REG = COUNT(CONSECUTIVO)&#xA;&#x9;FROM&#x9;#MPCCO_TMP_GUIA_FECHA&#xA;&#xA;-- =========================================================================================================&#xA;-- PASO 03.02 INICIA EL BUCLE&#xA;-- =========================================================================================================&#xA;&#x9;WHILE @NUM_REG &gt;= @CONSECUTIVO&#xA;&#x9;BEGIN&#x9;&#xA;&#x9;&#x9;SET&#x9;@CONSECUTIVO = @CONSECUTIVO + 1&#xA;&#x9;&#x9;&#xA;&#x9;-- =========================================================================================================&#xA;&#x9;-- PASO 03.02.01 ASIGNA LAS FECHAS A LAS VARIABLES&#xA;&#x9;-- =========================================================================================================&#xA;&#x9;&#x9;SET @FMIN = (&#x9;SELECT FECHA_ENVIO&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;FROM #MPCCO_TMP_GUIA_FECHA WITH (NOLOCK)&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHERE CONSECUTIVO = @CONSECUTIVO&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;) &#xA;&#xA;&#x9;&#x9;SET @FMAX = (&#x9;SELECT FECHA_ENTREGA&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;FROM #MPCCO_TMP_GUIA_FECHA WITH (NOLOCK)&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHERE CONSECUTIVO = @CONSECUTIVO&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;) &#xA;&#x9;-- =========================================================================================================&#xA;&#x9;-- PASO 03.02.02 DECLARA TABLA PARA LOS FESTIVOS&#xA;&#x9;-- =========================================================================================================&#xA;&#x9;&#x9;DECLARE @FestivosNal TABLE &#xA;&#x9;&#x9;(&#x9;FECHA DATETIME, &#xA;&#x9;&#x9;&#x9;DiaHabil bit )&#xA;&#xA;&#x9;-- =========================================================================================================&#xA;&#x9;-- PASO 03.02.03 ASIGNA LAS FECHAS SIN HORAS Y LA FECHA DE PASO CON EL VALOR  DE LA FECHA MINIMA&#xA;&#x9;-- =========================================================================================================&#xA;&#x9;&#x9;SELECT @FECHA_MIN = @FMIN&#xA;&#x9;&#x9;SET @FECHA_MIN = CONVERT(DATETIME, CONVERT(VARCHAR,@FECHA_MIN,112))&#xA;&#x9;&#x9;SET @FECHA_CAM = @FECHA_MIN&#xA;&#x9;&#x9;SET @FECHA_ULT = CONVERT(DATETIME, CONVERT(VARCHAR,@FMAX,112))&#xA;&#x9;&#x9;&#xA;&#x9;-- =========================================================================================================&#xA;&#x9;-- PASO 03.02.04 RECORRE ENTRE LA FMIN Y LA FMAX, IDENTIFICA LOS DOMINGOS CON 0 Y LOS DEMÁS DÍAS CON 1&#xA;&#x9;-- =========================================================================================================&#xA;&#x9;&#x9;WHILE @FECHA_CAM &lt;= @FECHA_ULT&#xA;&#x9;&#x9;BEGIN&#xA;&#x9;&#x9;&#x9;&#xA;&#x9;&#x9;&#x9;IF DATEPART(DW,@FECHA_CAM) = 1 /* 1 = DOMINGO */&#xA;&#x9;&#x9;&#x9;&#x9;INSERT INTO @FestivosNal (FECHA,DiaHabil) VALUES(@FECHA_CAM,0) /*0 = NO HÁBIL*/&#xA;&#x9;&#x9;&#x9;ELSE&#xA;&#x9;&#x9;&#x9;&#x9;INSERT INTO @FestivosNal (FECHA,DiaHabil) VALUES(@FECHA_CAM,1) /*1 = HÁBIL*/&#x9;&#x9;         &#xA;&#x9;&#x9;&#x9;SET @FECHA_CAM=DATEADD(D,1,@FECHA_CAM)&#xA;&#x9;&#x9;END&#xA;&#x9;&#x9;&#x9;  &#xA;&#x9;-- =========================================================================================================&#xA;&#x9;-- PASO 03.02.05 ELIMINA DE LA TEMPORAL LO DÍAS FESTIVOS&#xA;&#x9;-- =========================================================================================================&#xA;&#x9;&#x9;DELETE A &#xA;&#x9;&#x9;FROM @FestivosNal A &#xA;&#x9;&#x9;&#x9;INNER JOIN DIM.TIEMPO_FESTIVOS_NACIONALES B (NOLOCK) &#xA;&#x9;&#x9;&#x9;&#x9;ON A.FECHA = B.FECHA_FESTIVA &#xA;&#x9;&#x9;WHERE ID_PAIS = 1 /*1 = COLOMBIA*/&#xA;&#x9;&#x9;&#xA;&#x9;-- =========================================================================================================&#xA;&#x9;-- PASO 03.02.06 INSERTA DE LA TEMPORAL LO DÍAS FESTIVOS Y LOS MARCA CON CERO&#xA;&#x9;-- =========================================================================================================&#xA;&#x9;&#x9;INSERT INTO @FestivosNal &#xA;&#x9;&#x9;SELECT FECHA_FESTIVA,0 /*MARCA EL FESTIVO COMO NO HABIL: 0*/&#xA;&#x9;&#x9;FROM DIM.TIEMPO_FESTIVOS_NACIONALES (NOLOCK) &#xA;&#x9;&#x9;WHERE FECHA_FESTIVA BETWEEN @FECHA_MIN AND @FECHA_ULT&#xA;&#x9;&#x9;&#x9;AND ID_PAIS = 1  /*1 = COLOMBIA*/&#xA;&#x9;&#x9;&#x9;&#x9;&#xA;&#x9;-- =========================================================================================================&#xA;&#x9;-- PASO 03.02.07 ASIGNA LAS VARIABLES PARA LA DIFERENCIA EN MINUTOS DEL PRIMER Y ULTIMO DÍA&#xA;&#x9;-- =========================================================================================================&#xA;&#x9;&#x9;SET @FECHA_Minima = @FMIN&#xA;&#x9;&#x9;SET @FECHA_Max = @FMAX&#xA;&#x9;&#x9;SET @MENOS_MI = 0&#xA;&#x9;&#x9;SET @MENOS_MA = 0&#xA;&#xA;&#x9;-- =========================================================================================================&#xA;&#x9;-- PASO 03.02.08 CALCULA LA DIFERENCIA EN MINUTOS ENTRE LAS CERO HORAS DEL INICIAL HASTA LA HORA DE LA FECHA MINIMA&#xA;&#x9;-- =========================================================================================================&#xA;&#x9;&#x9;IF EXISTS (SELECT * FROM  @FestivosNal WHERE (CONVERT(DATE,FECHA)) = (CONVERT(DATE,@FECHA_MINIMA)) AND DiaHabil = 1)&#xA;&#x9;&#x9;BEGIN&#xA;&#x9;&#x9;&#x9;SET @MENOS_MI =&#x9;(SELECT DATEDIFF(MI,FECHA,@FECHA_Minima) FROM @FestivosNal WHERE (CONVERT(DATE,FECHA)) = (CONVERT(DATE,@FECHA_Minima)))&#xA;&#x9;&#x9;END&#x9;&#xA;&#x9;&#x9;ELSE&#xA;&#x9;&#x9;BEGIN&#xA;&#x9;&#x9;&#x9;IF EXISTS (SELECT * FROM  @FestivosNal WHERE (CONVERT(DATE,FECHA)) = (CONVERT(DATE,@FECHA_MINIMA)) AND DiaHabil = 0)&#xA;&#x9;&#x9;&#x9;BEGIN&#xA;&#x9;&#x9;&#x9;&#x9;SET @MENOS_MI =&#x9;0&#xA;&#x9;&#x9;&#x9;END&#xA;&#x9;&#x9;END&#xA;&#xA;&#x9;-- =========================================================================================================&#xA;&#x9;-- PASO 03.02.09 CALCULA LA DIFERENCIA EN MINUTOS ENTRE LA FECHA MAXIMA Y LAS CERO HORAS DEL DIA SIGUIENTE&#xA;&#x9;-- =========================================================================================================&#xA;&#x9;&#x9;IF EXISTS (SELECT * FROM  @FestivosNal WHERE (CONVERT(DATE,FECHA)) = (CONVERT(DATE,@FECHA_MAX)) AND DiaHabil = 1)&#xA;&#x9;&#x9;BEGIN&#xA;&#x9;&#x9;&#x9;SET @MENOS_MA = (SELECT DATEDIFF(MI,@FECHA_MAX,DATEADD(DAY,1,FECHA)) FROM @FestivosNal WHERE (CONVERT(DATE,FECHA)) = (CONVERT(DATE,@FECHA_MAX)))&#xA;&#x9;&#x9;END&#x9;&#xA;&#x9;&#x9;ELSE&#xA;&#x9;&#x9;BEGIN&#x9;&#x9;&#xA;&#x9;&#x9;&#x9;IF EXISTS (SELECT * FROM  @FestivosNal WHERE (CONVERT(DATE,FECHA)) = (CONVERT(DATE,@FECHA_MAX)) AND DiaHabil = 0)&#xA;&#x9;&#x9;&#x9;BEGIN&#xA;&#x9;&#x9;&#x9;&#x9;SET @MENOS_MA = 0&#xA;&#x9;&#x9;&#x9;END&#xA;&#x9;&#x9;END&#x9;&#xA;&#x9;&#x9;&#xA;&#x9;-- =========================================================================================================&#xA;&#x9;-- PASO 03.02.10 CALCULA EL TIEMPO SUMANDO LOS DÍAS HABILES, MULTIPLICANDOLOS POR 1440 Y RESTANDO LAS DIFERENCIAS DE LOS PASOS&#xA;&#x9;-- 03.02.08 Y 03.02.09&#xA;&#x9;-- =========================================================================================================&#xA;&#x9;&#x9;SET @TIEMPO = (SELECT (SUM(CONVERT(INT,DiaHabil))*1440 /*24 Horas*/) - @MENOS_MI - @MENOS_MA TIEMPO_TOT FROM @FestivosNal)&#xA;&#xA;&#x9;-- =========================================================================================================&#xA;&#x9;-- PASO 03.02.11 BORRA LOS DÍAS DE LA TABLA TEMPORAL Y LA PREPARA PARA UNA SIGUIENTE GUÍA&#xA;&#x9;-- =========================================================================================================&#xA;&#x9;&#x9;DELETE @FestivosNal&#xA;&#x9;&#x9;&#xA;&#x9;-- =========================================================================================================&#xA;&#x9;-- PASO 03.02.12 INSERTA X CADA GUÍA DEL BUCLE EL TIEMPO Y EL CONCEPTO CALCULADO&#xA;&#x9;-- =========================================================================================================&#xA;&#x9;&#x9;&#x9;&#x9;&#xA;&#x9;SET @CONCEPTO = '1'&#xA;&#xA;&#x9;&#x9;      &#xA;&#x9;   IF EXISTS(SELECT * FROM (SELECT TOP 2 * FROM (SELECT * FROM (SELECT * FROM  TMP.MPCCO_PROMESA_PROCESOS_V2 WHERE NUMERO_GUIA = (SELECT NUMERO_GUIA  FROM #MPCCO_TMP_GUIA_FECHA WHERE CONSECUTIVO = @CONSECUTIVO) ) TA WHERE ID_PROCESO = 21) TB) TC WHERE ID_CONCEPTO = 71)&#xA;BEGIN&#xA;&#x9;SET @CONCEPTO = '2'&#xA;&#xA;&#x9;&#x9;&#xA;END&#xA;ELSE&#xA;BEGIN &#xA;&#xA;&#x9;IF EXISTS(SELECT * FROM (SELECT TOP 2 * FROM (SELECT * FROM (SELECT * FROM  TMP.MPCCO_PROMESA_PROCESOS_V2 WHERE NUMERO_GUIA = (SELECT NUMERO_GUIA  FROM #MPCCO_TMP_GUIA_FECHA WHERE CONSECUTIVO = @CONSECUTIVO)) TA WHERE ID_PROCESO = 21) TB) TC WHERE ID_CONCEPTO = 72)&#xA;&#x9;BEGIN&#xA;&#x9;SET @CONCEPTO = '3'&#xA;&#xA;&#x9;&#xA;&#x9;END&#x9;&#xA;&#x9;ELSE&#xA;&#x9;BEGIN&#xA;&#xA;&#x9;&#x9;IF EXISTS(SELECT * FROM (SELECT * FROM (SELECT * FROM (SELECT * FROM  TMP.MPCCO_PROMESA_PROCESOS_V2 WHERE NUMERO_GUIA = (SELECT NUMERO_GUIA  FROM #MPCCO_TMP_GUIA_FECHA WHERE CONSECUTIVO = @CONSECUTIVO)) TA WHERE ID_PROCESO = 9) TB) TC WHERE ID_CONCEPTO IN (2,4,7,9))&#xA;&#x9;&#x9;BEGIN&#xA;&#x9;&#x9;&#x9;SET @CONCEPTO = '4'&#xA;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#xA;&#x9;&#x9;END  &#xA;&#x9;&#x9;ELSE&#xA;&#x9;&#x9;BEGIN&#xA;&#xA;&#x9;&#x9;&#x9;IF EXISTS(SELECT * FROM (SELECT * FROM (SELECT TOP 2 * FROM (SELECT * FROM (SELECT * FROM  TMP.MPCCO_PROMESA_PROCESOS_V2 WHERE NUMERO_GUIA = (SELECT NUMERO_GUIA  FROM #MPCCO_TMP_GUIA_FECHA WHERE CONSECUTIVO = @CONSECUTIVO)) TA WHERE ID_PROCESO = 21) TB) TC WHERE ID_CONCEPTO = 73) TD WHERE DATEPART(WEEKDAY,FECHA_HORA_MOVIMIENTO) = 7)&#xA;&#x9;&#x9;&#x9;BEGIN&#xA;&#x9;&#x9;&#x9;&#x9;SET @CONCEPTO = '5'&#xA;&#xA;&#x9;&#x9;&#x9;&#xA;&#x9;&#x9;&#x9;END&#xA;&#x9;&#x9;&#x9;ELSE&#xA;&#x9;&#x9;&#x9;BEGIN&#xA;&#x9;&#x9;&#x9;&#x9;SET @CONCEPTO = '1'&#xA;&#x9;&#x9;&#x9;&#xA;&#xA;&#x9;&#x9;&#x9;END&#xA;&#x9;&#x9;END&#xA;&#x9;END&#xA;END&#xA;UPDATE&#x9;#MPCCO_TMP_GUIA_FECHA SET ID_CONCEPTO = @CONCEPTO WHERE  CONSECUTIVO = @CONSECUTIVO&#x9;&#x9;&#xA;&#x9;&#x9;&#x9;&#xA;&#x9;&#x9;&#x9;&#x9;INSERT INTO #MPCCO_TMP_TIEMPO_ENV_MOV&#xA;&#x9;&#x9;&#x9;&#x9;SELECT&#x9;CONSECUTIVO &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;,NUMERO_GUIA&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;,ID_CONCEPTO &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;,FECHA_ENVIO &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;,FECHA_ENTREGA&#x9;&#x9;&#x9;&#x9;&#x9;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;,@TIEMPO&#xA;&#x9;&#x9;&#x9; FROM&#x9;#MPCCO_TMP_GUIA_FECHA &#xA;&#x9;&#x9;&#x9;&#x9;WHERE CONSECUTIVO = @CONSECUTIVO&#xA;&#xA;&#xA;DELETE FROM #MPCCO_TMP_GUIA_FECHA WHERE CONSECUTIVO = @CONSECUTIVO&#xA;&#xA;END&#xA;&#xA;&#xA; --=========================================================================================================&#xA;-- PASO 04 CALCULAR LA PROMESA&#xA;-- =========================================================================================================&#xA;&#x9;&#xA;&#x9;--=========================================================================================================&#xA;&#x9;-- PASO 04.01 INSERTA EN LA TABLA TMP.GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA&#xA;&#x9;-- =========================================================================================================&#xA;&#x9;&#xA;&#x9;&#x9;TRUNCATE TABLE TMP.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2&#xA;&#xA;&#x9;&#xA;&#x9;INSERT INTO TMP.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2&#xA;&#x9;(&#xA;&#x9;   [TIME_ID]&#xA;      ,[FECHA]&#xA;      ,[DIA]&#xA;      ,[MES]&#xA;      ,[AÑO]&#xA;      ,[ID_CIUDAD_ORIGEN]&#xA;      ,[ID_CIUDAD_DESTINO]&#xA;      ,[ID_ESTADOENVIO]&#xA;&#x9;  ,[ID_PRODUCTO]&#xA;      ,[ID_SUBPRODUCTO]&#xA;&#x9;  ,[ID_CLIENTE]&#xA;      ,[ID_CONCEPTO]&#xA;      ,[ID_TIEMPO_ENTREGA]&#xA;      ,[ID_MEDTRANS]&#xA;      ,[NUMERO_GUIA]      &#xA;      ,[TIEMPO_PROMESA_H]  &#xA;&#x9;  ,[TIEMPO_PROMESA_CUMPLE_H] &#x9;&#xA;&#x9;  ,[HORAS_ND]&#xA; &#x9;  ,[ID_ESTADO_ND]&#xA;&#x9;  ,[GR_ID_TIPO_COBRO]&#xA;&#x9;  ,[ULT_MOV_FECHA_HORA_MOVIMIENTO] &#xA;&#x9;  ,[ULT_MOV_ID_PROCESO] &#xA;&#x9;  ,[ULT_MOV_NUMERO_MOVIMI] &#xA;&#x9;  ,[ULT_MOV_CONSECUT_MOVIMI] &#x9;&#x9; &#xA;&#x9;)&#xA;&#x9;SELECT &#x9;    &#xA;&#x9;    CONVERT(NUMERIC,CONVERT(DATETIME,CONVERT(CHAR(11),EM.FECHA))) AS TIMEID&#xA;&#x9;&#x9;---,CONVERT(DATETIME,CONVERT(CHAR(11),EM.FECHA)) AS FECHA----------------------------------------------------------------------------------------&gt;&gt;se inhabilita para fecha correcta&#xA;&#x9;&#x9;,EM.FECHA AS FECHA&#xA;&#x9;&#x9;,DAY (EM.FECHA) AS DIA&#xA;&#x9;&#x9;,MONTH (EM.FECHA) AS MES&#xA;&#x9;&#x9;,YEAR (EM.FECHA) AS AÑO&#xA;&#x9;&#x9;,ISNULL(EM.ID_CIUDAD_ORIGEN,0) AS ID_CIUDAD_ORIGEN&#xA;&#x9;&#x9;,ISNULL(EM.ID_CIUDAD_DESTINO,0) AS ID_CIUDAD_DESTINO&#xA;                                ,EM.ID_ESTADOENVIO&#xA;   &#x9;&#x9;,EM.ID_PRODUCTO&#xA;                                ,EM.ID_SUBPRODUCTO&#xA;                               ,EM.ID_CLIENTE&#xA;&#x9;&#x9;,T.ID_CONCEPTO&#xA;&#x9;&#x9;,ISNULL(EM.ID_TIEMPO_ENTREGA,0) AS ID_TIEMPO_ENTREGA&#xA;&#x9;&#x9;,ISNULL(EM.ID_MEDTRANS,0) AS ID_MEDTRANS&#xA;&#x9;&#x9;,EM.NUMERO_GUIA&#xA;&#x9;&#x9;,CASE /*Se toman las condiciones como en el campo TIEMPO_EN_ENTREGA, omitiendo Domingos y festivos y sin aplicar 2880 (48 Horas), sino 2160/60 (36 Horas), para no impactar en el resultado del campo TIEMPO_PROMESA_CUMPLE_H mas adelante (Revisado con Aldemar Sanchez)*/&#xA;&#x9;&#x9;&#x9;WHEN EM.ID_ESTADOENVIO &lt; 3 AND EM.FECHA_ENTREGA IS NULL &#xA;&#x9;&#x9;&#x9;&#x9;THEN T.TIEMPO/60&#xA;&#x9;&#x9;&#x9;WHEN (EM.ID_DOCU_ULT_MOVI &lt;&gt; 11 OR EM.ID_DOCU_ULT_MOVI &lt;&gt; 24) AND EM.FECHA_ENTREGA IS NULL &#xA;&#x9;&#x9;&#x9;&#x9;THEN T.TIEMPO/60&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#xA;&#x9;&#x9;&#x9;ELSE T.TIEMPO/60&#xA;&#x9;&#x9;END AS TIEMPO_PROMESA_H,&#xA;&#x9;&#x9;&#x9;-- Si el tiempo de entrega es hoy mismo, aquí se cálcula la promesa&#x9;&#xA;&#x9;&#x9;&#x9;CASE WHEN EM.ID_TIEMPO_ENTREGA = 2 THEN&#xA;&#x9;&#x9;&#x9;&#x9;-- Si el tiempo de entrega es hoy mismo y tiene novedad operativa, la promesa debe ser hoy o el siguiente día&#xA;&#x9;&#x9;&#x9;&#x9;CASE WHEN (SELECT SUM(ISNULL(ND_HORAS,0)) FROM SIG_COLOMBIA_DW.TMP.PROMESA_ND_V2 WHERE NUMERO_GUIA = EM.NUMERO_GUIA) &gt; 0 THEN&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;CASE WHEN (CONVERT(DATE,EM.FECHA_ENTREGA) =  CONVERT(DATE,EM.FECHA)) OR (CONVERT(DATE,EM.FECHA_ENTREGA) =  DATEADD(DAY,1,CONVERT(DATE,EM.FECHA))) THEN&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;'SI'&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;ELSE&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;'NO'&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;END&#xA;&#x9;&#x9;&#x9;&#x9;ELSE&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;-- Si el tiempo de entrega es hoy mismo y no tiene novedad operativa, la promesa debe ser hoy&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;CASE WHEN (CONVERT(DATE,EM.FECHA_ENTREGA) =  CONVERT(DATE,EM.FECHA)) THEN&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;'SI'&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;ELSE&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;'NO'&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;END&#xA;&#x9;&#x9;&#x9;&#x9;END&#xA;&#x9;&#x9;&#x9;ELSE&#xA;&#x9;&#x9;&#x9;&#x9;-- Si el tiempo de entrega es cero horas, aquí se cálcula la promesa&#x9;&#xA;&#x9;&#x9;&#x9;&#x9;CASE WHEN EM.ID_TIEMPO_ENTREGA = 3 THEN&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;-- Si el tiempo de entrega es cero horas y tiene novedad operativa, la promesa la puede cumplir hasta el final del dia del siguiente día habil&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;CASE WHEN (SELECT SUM(ISNULL(ND_HORAS,0)) FROM SIG_COLOMBIA_DW.TMP.PROMESA_ND_V2 WHERE NUMERO_GUIA = EM.NUMERO_GUIA) &gt; 0 THEN&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;CASE WHEN EM.FECHA_ENTREGA &lt; DATEADD(DAY,1,CONVERT(DATETIME,CONVERT(DATE,EM.FECHA_VIGENTE)))   THEN &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;'SI'&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;ELSE &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;'NO'&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;END&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;ELSE&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;-- Si el tiempo de entrega es cero horas y no tiene novedad operativa, la promesa la puede cumplir hasta las 9:00am del siguiente día habil&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;CASE WHEN EM.FECHA_ENTREGA &lt;= EM.FECHA_VIGENTE   THEN &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;'SI'&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;ELSE &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;'NO'&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;END&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;END&#xA;&#x9;&#x9;&#x9;&#x9;ELSE&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;--Si no es hoy mismo o cero horas, la promesa se cálcula con la red operativa&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;NULL&#xA;&#x9;&#x9;&#x9;&#x9;END&#xA;&#x9;&#x9;&#x9;END TIEMPO_PROMESA_CUMPLE_H &#xA;                                               , 0  HORAS_ND&#xA; &#x9;&#x9;&#x9;,'NO'  ID_ESTADO_ND&#xA;&#x9;&#x9;&#x9;,EM.GR_ID_TIPO_COBRO&#xA;&#x9;&#x9;&#x9;,EM.[ULT_MOV_FECHA_HORA_MOVIMIENTO] &#xA;&#x9;&#x9;&#x9;,EM.[ULT_MOV_ID_PROCESO] &#xA;&#x9;&#x9;&#x9;,EM.[ULT_MOV_NUMERO_MOVIMI] &#xA;&#x9;&#x9;&#x9;,EM.[ULT_MOV_CONSECUT_MOVIMI] &#xA;&#x9;   FROM #MPCCO_TMP_TIEMPO_ENV_MOV T&#xA;&#x9;&#x9;&#x9;INNER JOIN  SIG_COL_LOGISTICA_DW.TMP.MPCCO_PROMESA_V2 EM WITH (NOLOCK)&#xA;&#x9;&#x9;&#x9;&#x9;ON T.NUMERO_GUIA = EM.NUMERO_GUIA&#x9;&#xA;&#x9;&#x9;&#x9;&#x9;&#xA;&#x9; --=========================================================================================================&#xA;&#x9; --PASO 04.02 CREA INDICES PARA OPTIMIZAR EL CÁLCULO&#xA;&#x9; --=========================================================================================================&#xA;&#xA;&#x9;--IF EXISTS(SELECT * FROM sys.indexes WHERE object_id = object_id('TMP.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2') AND NAME ='MPCCO_IX_TMP_GUIAS_RED_OPERATIVA_PROMESA')&#xA;&#x9;--&#x9;PRINT('Si existe')&#xA;&#x9;DROP INDEX if exists  MPCCO_IX_TMP_GUIAS_RED_OPERATIVA_PROMESA ON TMP.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2&#xA;&#xA;&#xA;&#x9;----drop index MPCCO_IX_TMP_GUIAS_RED_OPERATIVA_PROMESA             on TMP.GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2 &#xA;&#x9;----drop index MPCCO_IX_TMP_GUIAS_RED_OPERATIVA_RUTA&#x9;&#x9;&#x9;&#x9;on TMP.GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2 &#xA;&#x9;----drop index MPCCO_IX_TMP_GUIAS_RED_OPERATIVA_TIME_ID&#x9;&#x9;&#x9;&#x9;on TMP.GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2 &#xA;&#x9;----drop index OS211_IX_TMP_GUIAS_RED_OPERATIVA_PROMESA&#x9;&#x9;&#x9;&#x9;on TMP.GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2 &#xA;&#x9;----drop index OS211_IX_TMP_GUIAS_RED_OPERATIVA_RUTA&#x9;&#x9;&#x9;&#x9;on TMP.GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2 &#xA;&#x9;----drop index OS211_IX_TMP_GUIAS_RED_OPERATIVA_TIME_ID&#x9;&#x9;&#x9;&#x9;on TMP.GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2 &#xA;&#x9;----drop index OS211_IX_TMP_PROMESA_V2_NUMERO_GUIA&#x9;&#x9;&#x9;&#x9;&#x9;on TMP.GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2 &#xA;&#xA;&#xA;&#xA;&#x9;CREATE NONCLUSTERED INDEX MPCCO_IX_TMP_GUIAS_RED_OPERATIVA_PROMESA ON TMP.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2&#xA;&#x9;(&#xA;&#x9;&#x9;TIEMPO_PROMESA_H ASC&#xA;&#x9;)&#xA;&#x9;INCLUDE (TIEMPO_OFERTA)&#xA;&#xA;-----&#x9;IF EXISTS(SELECT * FROM sys.indexes WHERE object_id = object_id('TMP.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2') AND NAME ='MPCCO_IX_TMP_GUIAS_RED_OPERATIVA_RUTA')&#xA;&#x9;DROP INDEX if exists MPCCO_IX_TMP_GUIAS_RED_OPERATIVA_RUTA ON TMP.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2&#xA;&#xA;&#x9;CREATE NONCLUSTERED INDEX MPCCO_IX_TMP_GUIAS_RED_OPERATIVA_RUTA ON TMP.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2&#xA;&#x9;(&#xA;&#x9;&#x9;ID_RUTA ASC&#xA;&#x9;)&#xA;&#xA;---&#x9;IF EXISTS(SELECT * FROM sys.indexes WHERE object_id = object_id('TMP.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2') AND NAME ='MPCCO_IX_TMP_GUIAS_RED_OPERATIVA_TIME_ID')&#xA;&#x9;DROP INDEX if exists   MPCCO_IX_TMP_GUIAS_RED_OPERATIVA_TIME_ID ON TMP.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2&#xA;&#xA;&#x9;CREATE NONCLUSTERED INDEX MPCCO_IX_TMP_GUIAS_RED_OPERATIVA_TIME_ID ON TMP.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2&#xA;&#x9;(&#xA;&#x9;&#x9;TIME_ID ASC&#xA;&#x9;)&#x9;&#xA;&#x9;&#x9;&#x9;&#x9;&#xA;&#x9; --=========================================================================================================&#xA;&#x9; --PASO 04.03 OBTIENE LAS RUTAS DE RED OPERATIVA HABILES Y LAS LLEVA A UNA TEMPORAL&#xA;&#x9; --=========================================================================================================&#xA;&#xA;&#x9;TRUNCATE TABLE TMP.MPCCO_RED_OPERATIVA_RUTA_V2&#xA;&#xA;&#x9;INSERT INTO TMP.RED_OPERATIVA_RUTA_V2&#xA;&#x9;(&#xA;&#x9;&#x9; ID_RUTA&#xA;&#x9;&#x9;,ID_CIUDAD_ORIGEN&#xA;&#x9;&#x9;,ID_CIUDAD_DESTINO&#xA;&#x9;&#x9;,ID_TIEMPO&#xA;&#x9;&#x9;,ID_MEDTRANS&#xA;&#x9;)&#xA;&#x9;SELECT&#xA;&#x9;&#x9; MAX(ID_RUTA) ID_RUTA&#xA;&#x9;&#x9;,ID_CIUDAD_ORIGEN&#xA;&#x9;&#x9;,ID_CIUDAD_DESTINO&#xA;&#x9;&#x9;,ID_TIEMPO&#xA;&#x9;&#x9;,ID_MEDTRANS&#xA;&#x9;FROM&#xA;&#x9;&#x9;DIM.RED_OPERATIVA_RUTA&#xA;&#x9;WHERE&#xA;&#x9;&#x9;ID_ESTADO_RUTA = 1&#xA;&#x9;GROUP BY&#xA;&#x9;&#x9; ID_CIUDAD_ORIGEN&#xA;&#x9;&#x9;,ID_CIUDAD_DESTINO&#xA;&#x9;&#x9;,ID_TIEMPO&#xA;&#x9;&#x9;,ID_MEDTRANS&#xA;&#xA;&#xA;--SELECT COUNT(1) FROM DIM.RED_OPERATIVA_RUTA&#xA;--SELECT COUNT(1) FROM [SERV-DBI01,9971].[SIG_COL_LOGISTICA_DW].DIM.RED_OPERATIVA_RUTA&#xA;&#xA;&#x9; --=========================================================================================================&#xA;&#x9; --PASO 04.04 CREA INDICES PARA OPTIMIZAR EL CÁLCULO&#xA;&#x9; --=========================================================================================================&#xA;&#xA;&#xA;-----&#x9;IF EXISTS(SELECT * FROM sys.indexes WHERE object_id = object_id('TMP.MPCCO_RED_OPERATIVA_RUTA_V2') AND NAME ='MPCCO_IX_TMP_RED_OPERATIVA_RUTA_ESTADO_CIUDAD')&#xA;&#x9;DROP INDEX if EXISTS [MPCCO_IX_TMP_RED_OPERATIVA_RUTA_ESTADO_CIUDAD] ON [TMP].[MPCCO_RED_OPERATIVA_RUTA_V2]&#xA;&#xA;&#x9;CREATE NONCLUSTERED INDEX [MPCCO_IX_TMP_RED_OPERATIVA_RUTA_ESTADO_CIUDAD] ON [TMP].[MPCCO_RED_OPERATIVA_RUTA_V2]&#xA;&#x9;(&#xA;&#x9;&#x9; ID_CIUDAD_ORIGEN&#xA;&#x9;&#x9;,ID_CIUDAD_DESTINO&#xA;&#x9;&#x9;,ID_TIEMPO&#xA;&#x9;&#x9;,ID_MEDTRANS&#xA;&#x9;)&#xA;&#x9;INCLUDE (ID_RUTA)&#xA;&#xA;&#x9; --=========================================================================================================&#xA;&#x9; --PASO 04.05 ASIGNA LA RUTA AL NÚMERO DE GUÍA SEGÚN ORIGEN, DESTINO, TIE. ENTREGA Y MED. TRANSPORTE&#xA;&#x9; --========================================================================================================&#xA;&#xA;&#x9;UPDATE &#xA;&#x9;&#x9;TMP.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2&#xA;&#x9;SET &#xA;&#x9;&#x9;ID_RUTA = ISNULL(RED.ID_RUTA,0)&#xA;&#x9;FROM &#xA;&#x9;    TMP.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2 GUIAS&#xA;&#x9;INNER JOIN&#xA;&#x9;&#x9;TMP.MPCCO_RED_OPERATIVA_RUTA_V2 RED&#xA;&#x9;ON&#xA;&#x9;&#x9;GUIAS.ID_CIUDAD_ORIGEN = RED.ID_CIUDAD_ORIGEN&#xA;&#x9;AND&#xA;&#x9;&#x9;GUIAS.ID_CIUDAD_DESTINO = RED.ID_CIUDAD_DESTINO&#xA;&#x9;AND&#xA;&#x9;&#x9;GUIAS.ID_TIEMPO_ENTREGA = RED.ID_TIEMPO&#xA;&#x9;AND&#xA;&#x9;&#x9;GUIAS.ID_MEDTRANS = RED.ID_MEDTRANS&#xA;&#xA;&#xA;&#x9; --=========================================================================================================&#xA;&#x9; --PASO 04.06 ASIGNA SIN RUTA LAS GUIAS QUE NO TENGAN RUTA EN RED OPERATIVA&#xA;&#x9; --========================================================================================================&#xA;&#xA;&#xA;&#x9;UPDATE &#xA;&#x9;&#x9; TMP.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2&#xA;&#x9;SET &#xA;&#x9;&#x9;ID_RUTA = 0&#xA;&#x9;WHERE&#xA;&#x9;&#x9;ID_RUTA IS NULL&#xA;&#xA;&#xA;&#x9; --=========================================================================================================&#xA;&#x9; --PASO 04.07 ASIGNA A LA GUIA EL TIEMPO DE LA PROMESA EN HORAS SEGÚN LA RUTA DE RED OPERATIVA&#xA;&#x9; --========================================================================================================&#xA;&#xA;&#xA;&#x9;UPDATE &#xA;&#x9;&#x9;TMP.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2&#xA;&#x9;SET &#xA;&#x9;&#x9;TIEMPO_OFERTA = RED.TIEMPO_ENTREGA_COMERCIAL_HOR&#xA;&#x9;&#x9;,ID_GRUPO_RED = &#xA;&#x9;&#x9;CASE WHEN RED.ID_RUTA = 0 THEN 0  &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN RED.TIEMPO_ENTREGA_COMERCIAL_HOR BETWEEN 0 AND 36 THEN 1 &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN RED.TIEMPO_ENTREGA_COMERCIAL_HOR BETWEEN 37 AND 60 THEN 2&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN RED.TIEMPO_ENTREGA_COMERCIAL_HOR BETWEEN 61 AND 84 THEN 3&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN RED.TIEMPO_ENTREGA_COMERCIAL_HOR BETWEEN 85 AND 108 THEN 4&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;ELSE 5 END &#x9;&#x9;&#x9;&#xA;&#x9;    &#xA;&#x9;FROM &#xA;&#x9;&#x9;TMP.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2 GUIAS&#xA;&#x9;INNER JOIN&#xA;&#x9;&#x9;DIM.RED_OPERATIVA_RUTA RED&#xA;&#x9;ON&#xA;&#x9;&#x9;GUIAS.ID_RUTA = RED.ID_RUTA&#xA;&#xA;&#xA;&#xA;--USE SIG_COLOMBIA_DW&#xA;--USE SIG_COL_LOGISTICA_DW&#xA;&#x9; --=========================================================================================================&#xA;&#x9; --PASO 04.08 CALCULA SI CUMPLE O NO LA PROMESA&#xA;&#x9; --========================================================================================================&#xA;&#xA;&#x9;UPDATE&#xA;&#x9;&#x9; TMP.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2&#xA;&#x9;SET&#xA;&#x9;&#x9; HORAS_ND = ISNULL(ND.ND_HORAS,0)&#xA;&#x9;&#x9;,ID_ESTADO_ND = CASE WHEN ISNULL(ND.ND_HORAS,0)&gt; 0 THEN 'SI' ELSE 'NO' END&#xA;&#x9;FROM&#xA;&#x9;&#x9;TMP.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2 PR&#xA;&#x9;INNER JOIN&#xA;&#x9;&#x9;SIG_COLOMBIA_DW.TMP.MPCCO_PROMESA_ND_V2 ND&#xA;&#x9;ON&#xA;&#x9;ND.NUMERO_GUIA = PR.NUMERO_GUIA&#xA;&#x9;&#xA;&#xA;&#x9;UPDATE&#xA;&#x9; TMP.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2&#xA;&#x9;SET&#xA;&#x9;TIEMPO_PROMESA_CUMPLE_H = (CASE WHEN TIEMPO_PROMESA_H &gt;  (CASE WHEN  ID_RUTA = 0&#xA;                          &#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;THEN 0  &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;       WHEN TIEMPO_OFERTA  &lt;= 36&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;THEN (36 + HORAS_ND)&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;      WHEN TIEMPO_OFERTA &gt; 36 AND (TIEMPO_OFERTA + HORAS_ND) &lt;= 60&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;THEN (60 + HORAS_ND)&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;      WHEN TIEMPO_OFERTA &gt; 60 AND (TIEMPO_OFERTA + HORAS_ND) &lt;= 84&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;THEN (84 + HORAS_ND)&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;      WHEN TIEMPO_OFERTA  &gt; 84 AND (TIEMPO_OFERTA + HORAS_ND) &lt;= 108&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;THEN (108 + HORAS_ND)&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;ELSE TIEMPO_OFERTA + HORAS_ND END) THEN 'NO' ELSE 'SI' END)&#xA;   &#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHERE ID_TIEMPO_ENTREGA NOT IN (2,3)&#xA;             &#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;AND TIEMPO_PROMESA_CUMPLE_H IS NULL&#xA;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;  &#xA;----SELECT * FROM TMP.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2&#xA;&#xA;&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
      </DTS:Executables>
    </DTS:Executable>
