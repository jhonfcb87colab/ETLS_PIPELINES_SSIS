                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT
    ID_PROCESO,
    NUMERO_MOVIMI,
    CONSECUT_MOVIMI,
    PLACA_VEHICULO_DOCU,
    ISNULL(
        SUM(
            CONVERT(
                INT,
                ROUND(
                    (CONVERT(FLOAT, DATEDIFF(MINUTE, [FECHA_NOVEDAD], ISNULL([FECHA_HORA_FIN_NOVEDAD], GETDATE()))) / 60),
                0)
            )
        ),
    0) AS ND_HORAS
FROM TMP.MPCCO_PROMESA_NDBASE_V2 ND WITH (NOLOCK)
GROUP BY
    ID_PROCESO,
    NUMERO_MOVIMI,
    CONSECUT_MOVIMI,
    PLACA_VEHICULO_DOCU;</property>
