        <DTS:Executable
          DTS:refId="Package\CALCULO INDICADOR ACIDO Y DEPURADA\SQL_SELECT_Obtener_fecha_entrega"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{60A802E6-0BB3-457F-AEB3-6F9CDF95EEE9}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="SQL_SELECT_Obtener_fecha_entrega"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{94C855A8-E2EA-4CF8-9340-DC0E1AB28830}"
              SQLTask:SqlStatementSource="&#xA;  IF OBJECT_ID('tempdb..#DATOS_FECHA_SZU_EMPRESARIO_SATE') IS NOT NULL DROP TABLE #DATOS_FECHA_SZU_EMPRESARIO_SATE;&#xA;&#xA;;WITH SZU AS (&#xA;    SELECT &#xA;        ROW_NUMBER() OVER (PARTITION BY AC.G_NUMERO_GUIA ORDER BY SE.FECHA_HORA_MOVIMIENTO ASC) AS RN,&#xA;        'SALIDA A ZONA URBANA' AS SE_PROCESO_PRIMGEST,&#xA;        AC.G_NUMERO_GUIA,&#xA;        SE.ID_PROCESO,&#xA;        SE.ID_CONCEPTO,&#xA;        SE.FECHA_HORA_MOVIMIENTO AS FECHA_SZU&#xA;    FROM TMP.MPCCO_CUMPLIMIENTO_AC_DEP AS AC WITH (NOLOCK)&#xA;    INNER JOIN SIG_COLOMBIA_DW.LOG.MPCCO_SEGUIMIENTO_ENVIO_6MESES AS SE WITH (NOLOCK)&#xA;        ON AC.G_NUMERO_GUIA = SE.NUMERO_GUIA&#xA;       AND SE.ID_PROCESO = 9&#xA;       AND SE.ID_CONCEPTO IN (2,4,7,9,10)&#xA;       AND SE.ID_PROCESO &lt;&gt; 15&#xA;)&#xA;SELECT &#xA;    G_NUMERO_GUIA,&#xA;    SE_PROCESO_PRIMGEST,&#xA;    ISNULL(FECHA_SZU,'1900-01-01') AS SE_ID_FECHA_PRIMGEST,&#xA;    ISNULL(CONVERT(VARCHAR, FECHA_SZU, 111), 'NO DISPONIBLE') AS SE_FECHA_PRIMGEST&#xA;INTO #DATOS_FECHA_SZU_EMPRESARIO_SATE&#xA;FROM SZU&#xA;WHERE RN = 1;&#xA;&#xA;;WITH CTE (&#xA;    ID, G_NUMERO_GUIA, SE_PROCESO_PRIMGEST, SE_ID_FECHA_PRIMGEST, SE_FECHA_PRIMGEST&#xA;) AS (&#xA;    SELECT&#xA;        ROW_NUMBER() OVER (PARTITION BY G_NUMERO_GUIA ORDER BY FECHA) AS ID,&#xA;        G_NUMERO_GUIA,&#xA;        PROCESO AS SE_PROCESO_PRIMGEST,&#xA;        FECHA AS SE_ID_FECHA_PRIMGEST,&#xA;        ISNULL(CONVERT(VARCHAR, FECHA, 111), 'NO DISPONIBLE') AS SE_FECHA_PRIMGEST&#xA;    FROM (&#xA;        SELECT &#xA;            G_NUMERO_GUIA,&#xA;            SE_ID_FECHA_EV  AS [ENTREGA VERIFICADA],&#xA;            SE_ID_FECHA_RE  AS [REPORTADO ENTREGADO],&#xA;            SE_ID_FECHA_DIG AS [DIGITALIZADA]&#xA;        FROM TMP.MPCCO_CUMPLIMIENTO_AC_DEP&#xA;        WHERE SE_FECHA_RR  &lt;&gt; 'NO DISPONIBLE'&#xA;           OR SE_FECHA_RE  &lt;&gt; 'NO DISPONIBLE'&#xA;           OR SE_FECHA_DIG &lt;&gt; 'NO DISPONIBLE'&#xA;    ) p&#xA;    UNPIVOT (FECHA FOR PROCESO IN ([ENTREGA VERIFICADA],[REPORTADO ENTREGADO],[DIGITALIZADA])) AS UNPVT&#xA;    WHERE FECHA &lt;&gt; '1900-01-01'&#xA;),&#xA;DATOS_VAL AS (&#xA;    SELECT &#xA;        CTE.G_NUMERO_GUIA,&#xA;        IIF(CTE.SE_ID_FECHA_PRIMGEST &gt; SZU.SE_ID_FECHA_PRIMGEST, SZU.SE_PROCESO_PRIMGEST, CTE.SE_PROCESO_PRIMGEST) AS SE_PROCESO_PRIMGEST,&#xA;        IIF(CTE.SE_ID_FECHA_PRIMGEST &gt; SZU.SE_ID_FECHA_PRIMGEST, SZU.SE_ID_FECHA_PRIMGEST, CTE.SE_ID_FECHA_PRIMGEST) AS SE_ID_FECHA_PRIMGEST,&#xA;        IIF(CTE.SE_ID_FECHA_PRIMGEST &gt; SZU.SE_ID_FECHA_PRIMGEST, SZU.SE_FECHA_PRIMGEST, CTE.SE_FECHA_PRIMGEST) AS SE_FECHA_PRIMGEST&#xA;    FROM CTE WITH (NOLOCK)&#xA;    LEFT JOIN #DATOS_FECHA_SZU_EMPRESARIO_SATE AS SZU&#xA;      ON CTE.G_NUMERO_GUIA = SZU.G_NUMERO_GUIA&#xA;    WHERE CTE.ID = 1&#xA;)&#xA;UPDATE TMP&#xA;SET&#xA;    --TMP.SE_PROCESO_PRIMGEST = CTE.SE_PROCESO_PRIMGEST,   -- (descomenta si quieres guardar el texto)&#xA;    TMP.SE_ID_FECHA = CONVERT(INT, CTE.SE_ID_FECHA_PRIMGEST),&#xA;    TMP.SE_FECHA    = CTE.SE_ID_FECHA_PRIMGEST&#xA;FROM TMP.MPCCO_CUMPLIMIENTO_AC_DEP AS TMP&#xA;INNER JOIN DATOS_VAL AS CTE&#xA;  ON TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\CALCULO INDICADOR ACIDO Y DEPURADA\SQL_TRUNCATE_Cumplimientos_ac_dep"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{3A34943F-749F-4B33-A02D-A39FB737F22E}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="SQL_TRUNCATE_Cumplimientos_ac_dep"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{94C855A8-E2EA-4CF8-9340-DC0E1AB28830}"
              SQLTask:SqlStatementSource="TRUNCATE TABLE TMP.MPCCO_CUMPLIMIENTO_AC_DEP;&#xA;TRUNCATE TABLE TMP.MPCCO_CUMPLIMIENTO_AC_DEP_01;&#xA;TRUNCATE TABLE TMP.MPCCO_CUMPLIMIENTO_AC_DEP_02;&#xA;TRUNCATE TABLE TMP.MPCCO_CUMPLIMIENTO_AC_DEP_03;&#xA;TRUNCATE TABLE TMP.MPCCO_CUMPLIMIENTO_AC_DEP_04;&#xA;TRUNCATE TABLE TMP.MPCCO_CUMPLIMIENTO_AC_DEP_DH;&#xA;TRUNCATE TABLE TMP.MPCCO_NOVEDADES_RESPONSABLE;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\CALCULO INDICADOR ACIDO Y DEPURADA\SQL_UPDATE_Calcular_cumplimiento_depurada"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{A83D7023-7BAA-4425-B67C-8B702F6472EF}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="SQL_UPDATE_Calcular_cumplimiento_depurada"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{94C855A8-E2EA-4CF8-9340-DC0E1AB28830}"
              SQLTask:SqlStatementSource="WITH CTE (&#xA;  ID,&#xA;  G_NUMERO_GUIA,&#xA;  SE_DESC_PROC_DEPU,&#xA;  SE_DESC_CONC_DEPU,&#xA;  SE_DEPURADO_RESP&#xA;) AS (&#xA;  SELECT&#xA;      ROW_NUMBER() OVER (PARTITION BY G_NUMERO_GUIA ORDER BY FECHA_HORA_MOVIMIENTO) AS ID,&#xA;      G_NUMERO_GUIA,&#xA;      SE_DESC_PROC_DEPU,&#xA;      SE_DESC_CONC_DEPU,&#xA;      SE_DEPURADO_RESP&#xA;  FROM TMP.MPCCO_CUMPLIMIENTO_AC_DEP_04 AS C WITH (NOLOCK)&#xA;)&#xA;UPDATE C&#xA;SET&#xA;    C.SE_PROMESA_CUMPLE_DEPURADA = CASE WHEN CTE.SE_DEPURADO_RESP IN ('E','C') THEN 'SI' ELSE C.SE_PROMESA_CUMPLE_DEPURADA END,&#xA;    --C.SE_DESC_PROC_DEPU = CTE.SE_DESC_PROC_DEPU,&#xA;    --C.SE_DESC_CONC_DEPU = CTE.SE_DESC_CONC_DEPU,&#xA;    C.SE_RESPONSABLE_ID = ISNULL(CTE.SE_DEPURADO_RESP, 'NO APLICA')&#xA;FROM TMP.MPCCO_CUMPLIMIENTO_AC_DEP AS C&#xA;INNER JOIN CTE&#xA;  ON C.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA&#xA;WHERE CTE.ID = 1;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\CALCULO INDICADOR ACIDO Y DEPURADA\SQL_UPDATE_Cumplimiento_acida"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{6950B06B-FC36-4D42-B0CD-B510F82B366B}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="SQL_UPDATE_Cumplimiento_acida"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{94C855A8-E2EA-4CF8-9340-DC0E1AB28830}"
              SQLTask:SqlStatementSource="UPDATE TMP&#xA;SET&#xA;  TMP.SE_PROMESA_CUMPLE_ACIDA     = CASE WHEN CONVERT(date, TMP.SE_FECHA) &lt;= TMP.SE_ID_FECHA_PROMESA_ENTREGA_DH THEN 'SI' ELSE 'NO' END,&#xA;  TMP.SE_PROMESA_CUMPLE_DEPURADA  = CASE WHEN CONVERT(date, TMP.SE_FECHA) &lt;= TMP.SE_ID_FECHA_PROMESA_ENTREGA_DH THEN 'SI' ELSE 'NO' END&#xA;FROM TMP.MPCCO_CUMPLIMIENTO_AC_DEP AS TMP&#xA;WHERE TMP.SE_FECHA &lt;&gt; '1900-01-01'&#xA;  AND TMP.SE_FECHA_PROMESA_ENTREGA_DH &lt;&gt; 'NO DISPONIBLE';" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\CALCULO INDICADOR ACIDO Y DEPURADA\SQL_UPDATE_Dias_habiles_primera_gestion"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{57BC5212-FB86-4897-AF3F-54E203F2833A}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="SQL_UPDATE_Dias_habiles_primera_gestion"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{94C855A8-E2EA-4CF8-9340-DC0E1AB28830}"
              SQLTask:SqlStatementSource="&#xA;SET NOCOUNT ON;&#xA;&#xA;IF NOT EXISTS (&#xA;    SELECT 1&#xA;    FROM sys.indexes &#xA;    WHERE name = 'IX_DEP_DH__FECHA'&#xA;      AND object_id = OBJECT_ID('TMP.MPCCO_CUMPLIMIENTO_AC_DEP_DH')&#xA;)&#xA;BEGIN&#xA;    CREATE INDEX IX_DEP_DH__FECHA &#xA;    ON TMP.MPCCO_CUMPLIMIENTO_AC_DEP_DH (FECHA);&#xA;END&#xA;&#xA;UPDATE STATISTICS TMP.MPCCO_CUMPLIMIENTO_AC_DEP WITH FULLSCAN;&#xA;UPDATE STATISTICS TMP.MPCCO_CUMPLIMIENTO_AC_DEP_DH WITH FULLSCAN;&#xA;&#xA;UPDATE c&#xA;SET &#xA;    c.SE_ID_FECHA_PRIMGEST_DH = a.FECHA_DH,&#xA;    c.SE_FECHA_PRIMGEST_DH    = CONVERT(varchar(50), a.FECHA_DH, 100)&#xA;FROM TMP.MPCCO_CUMPLIMIENTO_AC_DEP AS c&#xA;OUTER APPLY (&#xA;    SELECT TOP (1) dh.FECHA AS FECHA_DH&#xA;    FROM TMP.MPCCO_CUMPLIMIENTO_AC_DEP_DH AS dh&#xA;    WHERE dh.FECHA &gt;= CONVERT(date, c.SE_ID_FECHA_PRIMGEST)&#xA;    ORDER BY dh.FECHA ASC&#xA;) AS a&#xA;WHERE &#xA;    c.SE_ID_FECHA_PRIMGEST IS NOT NULL&#xA;    AND CONVERT(date, c.SE_ID_FECHA_PRIMGEST) &lt;&gt; '19000101'&#xA;    AND a.FECHA_DH IS NOT NULL&#xA;    AND (&#xA;         c.SE_ID_FECHA_PRIMGEST_DH IS NULL OR c.SE_ID_FECHA_PRIMGEST_DH &lt;&gt; a.FECHA_DH&#xA;      OR c.SE_FECHA_PRIMGEST_DH    IS NULL OR c.SE_FECHA_PRIMGEST_DH    &lt;&gt; CONVERT(varchar(50), a.FECHA_DH, 100)&#xA;    );" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\CALCULO INDICADOR ACIDO Y DEPURADA\SQL_UPDATE_Dia_habil_fecha_entrega_promesa"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{E1AC26A5-3917-41D4-8417-C6C4FC652F36}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="SQL_UPDATE_Dia_habil_fecha_entrega_promesa"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{94C855A8-E2EA-4CF8-9340-DC0E1AB28830}"
              SQLTask:SqlStatementSource="/* Paso 1: asignar fecha hábil &gt;= fecha promesa */&#xA;UPDATE c&#xA;SET c.SE_ID_FECHA_PROMESA_ENTREGA_DH =&#xA;    ISNULL((&#xA;        SELECT TOP (1) dh.FECHA&#xA;        FROM TMP.MPCCO_CUMPLIMIENTO_AC_DEP_DH AS dh WITH (NOLOCK)&#xA;        WHERE dh.FECHA &gt;= CONVERT(date, c.SE_ID_FECHA_PROMESA_ENTREGA)&#xA;        ORDER BY dh.FECHA ASC&#xA;    ), CONVERT(date, '1900-01-01'))&#xA;FROM TMP.MPCCO_CUMPLIMIENTO_AC_DEP AS c;&#xA;&#xA;/* Paso 2: normalizar a fin de día (23:59:59) */&#xA;UPDATE c&#xA;SET&#xA;    c.SE_ID_FECHA_PROMESA_ENTREGA_DH = DATEADD(SECOND, -1, DATEADD(DAY, 1, c.SE_ID_FECHA_PROMESA_ENTREGA_DH)),&#xA;    c.SE_FECHA_PROMESA_ENTREGA_DH    = CONVERT(varchar(50), DATEADD(SECOND, -1, DATEADD(DAY, 1, c.SE_ID_FECHA_PROMESA_ENTREGA_DH)))&#xA;FROM TMP.MPCCO_CUMPLIMIENTO_AC_DEP AS c;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\CALCULO INDICADOR ACIDO Y DEPURADA\SQL_UPDATE_Digitalizacion"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{920CDC84-A7B5-4201-AD31-9122ABC024F2}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="SQL_UPDATE_Digitalizacion"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{94C855A8-E2EA-4CF8-9340-DC0E1AB28830}"
              SQLTask:SqlStatementSource="WITH CTE (&#xA;    G_NUMERO_GUIA,&#xA;    SE_ID_FECHA_DIG,&#xA;    SE_FECHA_DIG&#xA;) AS (&#xA;    SELECT&#xA;        TMP.G_NUMERO_GUIA,&#xA;        ISNULL(PE.FECHA_DIGITALIZACION, '1900-01-01') AS SE_ID_FECHA_DIG,&#xA;        ISNULL(CONVERT(VARCHAR, PE.FECHA_DIGITALIZACION, 111), 'NO DISPONIBLE') AS SE_FECHA_DIG&#xA;    FROM TMP.MPCCO_CUMPLIMIENTO_AC_DEP AS TMP&#xA;    INNER JOIN SIG_COLOMBIA_DW.LOG.MPCCO_PRUEBAS_ENTREGA AS PE&#xA;      ON TMP.G_NUMERO_GUIA = PE.NUMERO_GUIA&#xA;)&#xA;UPDATE TMP&#xA;SET&#xA;    TMP.SE_ID_FECHA_DIG = CTE.SE_ID_FECHA_DIG,&#xA;    TMP.SE_FECHA_DIG    = CTE.SE_FECHA_DIG&#xA;FROM TMP.MPCCO_CUMPLIMIENTO_AC_DEP AS TMP&#xA;INNER JOIN CTE&#xA;  ON TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\CALCULO INDICADOR ACIDO Y DEPURADA\SQL_UPDATE_Movimientos"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{CF44C8A5-97A4-4372-8ACD-460138AF12C0}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="SQL_UPDATE_Movimientos"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{94C855A8-E2EA-4CF8-9340-DC0E1AB28830}"
              SQLTask:SqlStatementSource="&#xA;WITH CTE (&#xA;  NUMERO_GUIA,&#xA;  SE_ID_FECHA_EZU, SE_FECHA_EZU,&#xA;  SE_ID_FECHA_RR,  SE_FECHA_RR,&#xA;  SE_ID_FECHA_EPS, SE_FECHA_EPS,&#xA;  SE_ID_FECHA_RE,  SE_FECHA_RE,&#xA;  SE_ID_FECHA_EV,  SE_FECHA_EV&#xA;) AS (&#xA;  SELECT &#xA;      NUMERO_GUIA,&#xA;      ISNULL(MIN(CASE WHEN ID_PROCESO = 6  THEN FECHA_HORA_MOVIMIENTO END),'1900-01-01')                                         AS SE_ID_FECHA_EZU,&#xA;      ISNULL(CONVERT(VARCHAR, MIN(CASE WHEN ID_PROCESO = 6  THEN FECHA_HORA_MOVIMIENTO END), 111), 'NO DISPONIBLE')              AS SE_FECHA_EZU,&#xA;&#xA;      ISNULL(MIN(CASE WHEN ID_PROCESO = 28 THEN FECHA_HORA_MOVIMIENTO END),'1900-01-01')                                         AS SE_ID_FECHA_RR,&#xA;      ISNULL(CONVERT(VARCHAR, MIN(CASE WHEN ID_PROCESO = 28 THEN FECHA_HORA_MOVIMIENTO END), 111), 'NO DISPONIBLE')             AS SE_FECHA_RR,&#xA;&#xA;      ISNULL(MIN(CASE WHEN ID_PROCESO = 5  THEN FECHA_HORA_MOVIMIENTO END),'1900-01-01')                                         AS SE_ID_FECHA_EPS,&#xA;      ISNULL(CONVERT(VARCHAR, MIN(CASE WHEN ID_PROCESO = 5  THEN FECHA_HORA_MOVIMIENTO END), 111), 'NO DISPONIBLE')              AS SE_FECHA_EPS,&#xA;&#xA;      ISNULL(MIN(CASE WHEN ID_PROCESO = 24 THEN FECHA_HORA_MOVIMIENTO END),'1900-01-01')                                         AS SE_ID_FECHA_RE,&#xA;      ISNULL(CONVERT(VARCHAR, MIN(CASE WHEN ID_PROCESO = 24 THEN FECHA_HORA_MOVIMIENTO END), 111), 'NO DISPONIBLE')             AS SE_FECHA_RE,&#xA;&#xA;      ISNULL(MIN(CASE WHEN ID_PROCESO = 11 THEN FECHA_HORA_MOVIMIENTO END),'1900-01-01')                                         AS SE_ID_FECHA_EV,&#xA;      ISNULL(CONVERT(VARCHAR, MIN(CASE WHEN ID_PROCESO = 11 THEN FECHA_HORA_MOVIMIENTO END), 111), 'NO DISPONIBLE')             AS SE_FECHA_EV&#xA;  FROM TMP.MPCCO_CUMPLIMIENTO_AC_DEP_01 WITH (NOLOCK)&#xA;  INNER JOIN TMP.MPCCO_CUMPLIMIENTO_AC_DEP WITH (NOLOCK)&#xA;    ON NUMERO_GUIA = G_NUMERO_GUIA&#xA;  GROUP BY NUMERO_GUIA&#xA;)&#xA;UPDATE G&#xA;SET G.SE_ID_FECHA_EZU = C.SE_ID_FECHA_EZU,&#xA;    G.SE_FECHA_EZU    = C.SE_FECHA_EZU,&#xA;    G.SE_ID_FECHA_RR  = C.SE_ID_FECHA_RR,&#xA;    G.SE_FECHA_RR     = C.SE_FECHA_RR,&#xA;    G.SE_ID_FECHA_EPS = C.SE_ID_FECHA_EPS,&#xA;    G.SE_FECHA_EPS    = C.SE_FECHA_EPS,&#xA;    G.SE_ID_FECHA_RE  = C.SE_ID_FECHA_RE,&#xA;    G.SE_FECHA_RE     = C.SE_FECHA_RE,&#xA;    G.SE_ID_FECHA_EV  = C.SE_ID_FECHA_EV,&#xA;    G.SE_FECHA_EV     = C.SE_FECHA_EV&#xA;FROM TMP.MPCCO_CUMPLIMIENTO_AC_DEP AS G&#xA;INNER JOIN CTE AS C&#xA;  ON C.NUMERO_GUIA = G.G_NUMERO_GUIA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\CALCULO INDICADOR ACIDO Y DEPURADA\SQL_UPDATE_Primera_gestion"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{61FDAEB2-C965-4006-9DEC-62FC24A5E1FB}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="SQL_UPDATE_Primera_gestion"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{94C855A8-E2EA-4CF8-9340-DC0E1AB28830}"
              SQLTask:SqlStatementSource="WITH CTE (&#xA;  G_NUMERO_GUIA,&#xA;  SE_PROCESO_PRIMGEST,&#xA;  SE_ID_FECHA_PRIMGEST,&#xA;  SE_FECHA_PRIMGEST&#xA;) AS (&#xA;  SELECT&#xA;      G_NUMERO_GUIA,&#xA;      CASE &#xA;        WHEN SE_FECHA_RR  &lt;&gt; 'NO DISPONIBLE' THEN 'REPORTADO RECOGIDO'&#xA;        WHEN SE_FECHA_EZU &lt;&gt; 'NO DISPONIBLE' THEN 'ENTRADA ZONA URBANA'&#xA;        WHEN SE_FECHA_EPS &lt;&gt; 'NO DISPONIBLE' THEN 'ENTRADA PUNTO SERVICIO'&#xA;        ELSE 'NO DISPONIBLE'&#xA;      END AS SE_PROCESO_PRIMGEST,&#xA;      CASE &#xA;        WHEN SE_FECHA_RR  &lt;&gt; 'NO DISPONIBLE' THEN SE_ID_FECHA_RR&#xA;        WHEN SE_FECHA_EZU &lt;&gt; 'NO DISPONIBLE' THEN SE_ID_FECHA_EZU&#xA;        WHEN SE_FECHA_EPS &lt;&gt; 'NO DISPONIBLE' THEN SE_ID_FECHA_EPS&#xA;        ELSE '1900-01-01'&#xA;      END AS SE_ID_FECHA_PRIMGEST,&#xA;      CASE &#xA;        WHEN SE_FECHA_RR  &lt;&gt; 'NO DISPONIBLE' THEN SE_FECHA_RR&#xA;        WHEN SE_FECHA_EZU &lt;&gt; 'NO DISPONIBLE' THEN SE_FECHA_EZU&#xA;        WHEN SE_FECHA_EPS &lt;&gt; 'NO DISPONIBLE' THEN SE_FECHA_EPS&#xA;        ELSE 'NO DISPONIBLE'&#xA;      END AS SE_FECHA_PRIMGEST&#xA;  FROM TMP.MPCCO_CUMPLIMIENTO_AC_DEP&#xA;)&#xA;UPDATE TMP&#xA;SET&#xA;    TMP.SE_PROCESO_PRIMGEST    = CTE.SE_PROCESO_PRIMGEST,&#xA;    TMP.SE_ID_FECHA_PRIMGEST   = CTE.SE_ID_FECHA_PRIMGEST,&#xA;    TMP.SE_FECHA_PRIMGEST      = CTE.SE_FECHA_PRIMGEST&#xA;FROM TMP.MPCCO_CUMPLIMIENTO_AC_DEP AS TMP&#xA;INNER JOIN CTE&#xA;  ON TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\CALCULO INDICADOR ACIDO Y DEPURADA\SQL_UPDATE_Promesa_red_operativa"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{7C00F7CF-257A-4D3D-962E-D744023DCA9B}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="SQL_UPDATE_Promesa_red_operativa"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{94C855A8-E2EA-4CF8-9340-DC0E1AB28830}"
              SQLTask:SqlStatementSource="WITH CTE (&#xA;    G_NUMERO_GUIA,&#xA;    SE_ID_FECHA_ENTREGA,&#xA;    SE_ID_DIAS_PROMESA&#xA;) AS (&#xA;    SELECT &#xA;        C.G_NUMERO_GUIA,&#xA;        C.SE_FECHA AS SE_ID_FECHA_ENTREGA,&#xA;        CONVERT(INT, C.TIEMPO_OFERTA_DIA) AS SE_ID_DIAS_PROMESA&#xA;    FROM (&#xA;        SELECT &#xA;            TMP.G_NUMERO_GUIA,&#xA;            TMP.SE_FECHA,&#xA;            ISNULL(R.TIEMPO_ENTREGA_COMERCIAL_DIA, 0) AS TIEMPO_OFERTA_DIA&#xA;        FROM TMP.MPCCO_CUMPLIMIENTO_AC_DEP TMP WITH (NOLOCK)&#xA;        INNER JOIN TMP.MPCCO_RED_OPERATIVA_RUTA RA WITH (NOLOCK)&#xA;            ON TMP.G_ID_CIUDAD_ORIGEN = RA.ID_CIUDAD_ORIGEN&#xA;           AND TMP.G_ID_CIUDAD_DESTINO = RA.ID_CIUDAD_DESTINO&#xA;           AND CASE WHEN ISNULL(TMP.G_ID_TIEMPO, 0)   &lt;&gt; 0 THEN TMP.G_ID_TIEMPO   ELSE 1 END = RA.ID_TIEMPO&#xA;           AND CASE WHEN ISNULL(TMP.G_ID_MEDTRANS, 0) &lt;&gt; 0 THEN TMP.G_ID_MEDTRANS ELSE 1 END = RA.ID_MEDTRANS&#xA;        INNER JOIN DIM.RED_OPERATIVA_RUTA R WITH (NOLOCK)&#xA;            ON RA.ID_RUTA = R.ID_RUTA&#xA;    ) C&#xA;)&#xA;UPDATE TMP&#xA;SET TMP.SE_ID_DIAS_PROMESA = CTE.SE_ID_DIAS_PROMESA&#xA;FROM TMP.MPCCO_CUMPLIMIENTO_AC_DEP AS TMP&#xA;INNER JOIN CTE&#xA;  ON TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
      </DTS:Executables>
