        <DTS:Executable
          DTS:refId="Package\NOVEDAD DIARIA\SQL_UPDATE_Promesa_nd_04_01"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{AEBCDFF2-871C-4C54-9FEC-9E5AFC144542}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="SQL_UPDATE_Promesa_nd_04_01"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{CE05DB66-31E1-4BF7-B85A-81929B965F18}"
              SQLTask:SqlStatementSource="WITH CTE (&#xA;    [ID_PROCESO],&#xA;    [NUMERO_MOVIMI],&#xA;    [CONSECUT_MOVIMI],&#xA;    [PLACA_VEHICULO_DOCU],&#xA;    [FECHA_HORA_ENTRADA_CIL]&#xA;) AS (&#xA;    SELECT&#xA;        [ID_PROCESO],&#xA;        [NUMERO_MOVIMI],&#xA;        [CONSECUT_MOVIMI],&#xA;        [PLACA_VEHICULO_DOCU],&#xA;        MAX([FECHA_HORA_ENTRADA_CIL]) AS [FECHA_HORA_ENTRADA_CIL]&#xA;    FROM TMP.MPCCO_PROMESA_NDBASE_V2&#xA;    GROUP BY&#xA;        [ID_PROCESO],&#xA;        [NUMERO_MOVIMI],&#xA;        [CONSECUT_MOVIMI],&#xA;        [PLACA_VEHICULO_DOCU]&#xA;)&#xA;UPDATE SE&#xA;SET SE.FECHA_HORA_ENTRADA_CIL = ND.FECHA_HORA_ENTRADA_CIL&#xA;FROM TMP.MPCCO_PROMESA_ND04_01_V2 AS SE&#xA;INNER JOIN CTE AS ND&#xA;  ON SE.[ID_PROCESO]       = ND.[ID_PROCESO]&#xA; AND SE.[NUMERO_MOVIMI]    = ND.[NUMERO_MOVIMI]&#xA; AND SE.[CONSECUT_MOVIMI]  = ND.[CONSECUT_MOVIMI]&#xA; AND SE.[PLACA_VEHICULO_DOCU] = ND.[PLACA_VEHICULO_DOCU];" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
      </DTS:Executables>
