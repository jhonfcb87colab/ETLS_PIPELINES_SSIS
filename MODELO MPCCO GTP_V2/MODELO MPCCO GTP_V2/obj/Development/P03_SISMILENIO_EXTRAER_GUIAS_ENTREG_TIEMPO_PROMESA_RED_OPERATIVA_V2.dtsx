                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT 
    P.NUMERO_GUIA,
    S.ID_PROCESO,
    S.CONSECUT_MOVIMI,
    S.NUMERO_MOVIMI,
    S.FECHA_HORA_MOVIMIENTO
FROM TMP.MPCCO_PROMESA_V2 P WITH (NOLOCK)
INNER JOIN SIG_COLOMBIA_DW.LOG.MPCCO_SEGUIMIENTO_ENVIO_6MESES S WITH (NOLOCK)
    ON P.NUMERO_GUIA = S.NUMERO_GUIA
WHERE S.ID_PROCESO = 12;</property>
