                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT
    ROW_NUMBER() OVER (ORDER BY T.TIME_ID) AS ID_DIA_HABIL,
    T.TIME_ID,
    T.[DATE] AS FECHA
FROM DIM.TIEMPO T WITH (NOLOCK)
LEFT JOIN PAR.FESTIVOSNACIONALES F WITH (NOLOCK)
  ON T.[DATE] = F.FECHA_FESTIVA
WHERE
    CASE 
      WHEN T.[DAY] = 'Domingo' THEN 1
      WHEN F.FECHA_FESTIVA IS NOT NULL THEN 1
      ELSE 0
    END = 0;</property>
