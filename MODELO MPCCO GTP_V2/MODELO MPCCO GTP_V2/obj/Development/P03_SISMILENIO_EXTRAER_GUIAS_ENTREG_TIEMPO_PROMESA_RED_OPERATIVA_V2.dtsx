                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT 
    T.NUMERO_GUIA,
    T.FECHA_HORA_MOVIMIENTO,
    T.ID_PROCESO,
    D.CONSECUT_MOVIMI,
    D.NUMERO_MOVIMI,
    D.PLACA_VEHICULO_DOCU,
    D.ID_PAIS_DESTINO,
    D.ID_CIUDAD_DESTINO
FROM TMP.MPCCO_PROMESA_ND01_V2 T WITH (NOLOCK)
INNER JOIN LOG.MPCCO_DOCUMENTOS_6MESES D WITH (NOLOCK)
    ON D.ID_PROCESO = 12
    AND D.NUMERO_MOVIMI COLLATE SQL_Latin1_General_CP850_CI_AI = T.NUMERO_MOVIMI COLLATE SQL_Latin1_General_CP850_CI_AI
    AND D.CONSECUT_MOVIMI = T.CONSECUT_MOVIMI;</property>
