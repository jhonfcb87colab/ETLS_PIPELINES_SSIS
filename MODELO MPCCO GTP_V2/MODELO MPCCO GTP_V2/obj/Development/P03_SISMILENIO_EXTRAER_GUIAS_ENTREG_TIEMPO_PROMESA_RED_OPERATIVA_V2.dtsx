    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{ACF384D4-BD8D-4DD7-AC64-CFC5B28A2377}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot;DELETE FROM &quot; + @[User::TBL_FAC_MPCCO_GTP2_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2]  + &quot;&#xA;WHERE CAST(&#xA;        CAST(AÑO AS VARCHAR(4)) + '-' +&#xA;        CASE UPPER(MES_DEL_AÑO)&#xA;          WHEN 'ENERO'      THEN '01'&#xA;          WHEN 'FEBRERO'    THEN '02'&#xA;          WHEN 'MARZO'      THEN '03'&#xA;          WHEN 'ABRIL'      THEN '04'&#xA;          WHEN 'MAYO'       THEN '05'&#xA;          WHEN 'JUNIO'      THEN '06'&#xA;          WHEN 'JULIO'      THEN '07'&#xA;          WHEN 'AGOSTO'     THEN '08'&#xA;          WHEN 'SEPTIEMBRE' THEN '09'&#xA;          WHEN 'OCTUBRE'    THEN '10'&#xA;          WHEN 'NOVIEMBRE'  THEN '11'&#xA;          WHEN 'DICIEMBRE'  THEN '12'&#xA;        END + '-' +&#xA;        RIGHT('0' + CAST(DIA AS VARCHAR(2)), 2)&#xA;     AS DATE&#xA;    ) BETWEEN '&quot; + @[User::VAL_fechaIni] + &quot;' AND '&quot; + @[User::VAL_fechaFin] + &quot;';&quot;"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="SQL_DELETE_Dias_Reproceso">
      <DTS:VariableValue
        DTS:DataType="8">DELETE FROM FAC.MPCCO_GTP2_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2
WHERE CAST(
        CAST(AÑO AS VARCHAR(4)) + '-' +
        CASE UPPER(MES_DEL_AÑO)
          WHEN 'ENERO'      THEN '01'
          WHEN 'FEBRERO'    THEN '02'
          WHEN 'MARZO'      THEN '03'
          WHEN 'ABRIL'      THEN '04'
          WHEN 'MAYO'       THEN '05'
          WHEN 'JUNIO'      THEN '06'
          WHEN 'JULIO'      THEN '07'
          WHEN 'AGOSTO'     THEN '08'
          WHEN 'SEPTIEMBRE' THEN '09'
          WHEN 'OCTUBRE'    THEN '10'
          WHEN 'NOVIEMBRE'  THEN '11'
          WHEN 'DICIEMBRE'  THEN '12'
        END + '-' +
        RIGHT('0' + CAST(DIA AS VARCHAR(2)), 2)
     AS DATE
    ) BETWEEN '2026-02-08' AND '2026-04-09';</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{505E4AFC-5894-42A1-A5AF-EAB4A987D581}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot;DELETE F&#xA;FROM &quot; + @[User::TBL_FAC_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2] + &quot; AS F&#xA;INNER JOIN &quot; + @[User::TBL_TMP_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2] + &quot; AS T&#xA;  ON T.NUMERO_GUIA = F.NUMERO_GUIA;&quot;"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="SQL_DELETE_Fac_registros_ingresar">
      <DTS:VariableValue
        DTS:DataType="8">DELETE F
FROM FAC.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2 AS F
INNER JOIN TMP.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2 AS T
  ON T.NUMERO_GUIA = F.NUMERO_GUIA;</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{96DDB92E-B173-4178-921F-8F9BC5DFB35A}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot;DELETE FROM &quot; + @[User::TBL_FAC_MPCCO_GTP2_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2] + &quot;&#xA;WHERE CAST(&#xA;        CAST(AÑO AS VARCHAR(4)) + '-' +&#xA;        CASE UPPER(MES_DEL_AÑO)&#xA;          WHEN 'ENERO'      THEN '01'&#xA;          WHEN 'FEBRERO'    THEN '02'&#xA;          WHEN 'MARZO'      THEN '03'&#xA;          WHEN 'ABRIL'      THEN '04'&#xA;          WHEN 'MAYO'       THEN '05'&#xA;          WHEN 'JUNIO'      THEN '06'&#xA;          WHEN 'JULIO'      THEN '07'&#xA;          WHEN 'AGOSTO'     THEN '08'&#xA;          WHEN 'SEPTIEMBRE' THEN '09'&#xA;          WHEN 'OCTUBRE'    THEN '10'&#xA;          WHEN 'NOVIEMBRE'  THEN '11'&#xA;          WHEN 'DICIEMBRE'  THEN '12'&#xA;        END + '-' +&#xA;        RIGHT('0' + CAST(DIA AS VARCHAR(2)), 2)&#xA;     AS DATE&#xA;    ) &lt; DATEADD(MONTH, -3, DATEADD(MONTH, DATEDIFF(MONTH,0,GETDATE()), 0));&#xA;&#xA;DELETE FROM &quot; + @[User::TBL_FAC_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2] + &quot;&#xA;WHERE FECHA &lt; DATEADD(MONTH, -3, DATEADD(MONTH, DATEDIFF(MONTH,0,GETDATE()), 0));&quot;"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="SQL_DELETE_Tres_meses_facs">
      <DTS:VariableValue
        DTS:DataType="8">DELETE FROM FAC.MPCCO_GTP2_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2
WHERE CAST(
        CAST(AÑO AS VARCHAR(4)) + '-' +
        CASE UPPER(MES_DEL_AÑO)
          WHEN 'ENERO'      THEN '01'
          WHEN 'FEBRERO'    THEN '02'
          WHEN 'MARZO'      THEN '03'
          WHEN 'ABRIL'      THEN '04'
          WHEN 'MAYO'       THEN '05'
          WHEN 'JUNIO'      THEN '06'
          WHEN 'JULIO'      THEN '07'
          WHEN 'AGOSTO'     THEN '08'
          WHEN 'SEPTIEMBRE' THEN '09'
          WHEN 'OCTUBRE'    THEN '10'
          WHEN 'NOVIEMBRE'  THEN '11'
          WHEN 'DICIEMBRE'  THEN '12'
        END + '-' +
        RIGHT('0' + CAST(DIA AS VARCHAR(2)), 2)
     AS DATE
    ) &lt; DATEADD(MONTH, -3, DATEADD(MONTH, DATEDIFF(MONTH,0,GETDATE()), 0));

DELETE FROM FAC.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2
WHERE FECHA &lt; DATEADD(MONTH, -3, DATEADD(MONTH, DATEDIFF(MONTH,0,GETDATE()), 0));</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{9CF9143C-EA6E-4F21-A445-EFDA4F946FE4}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot;/* GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2 — set-based + DEDUP (corrigido) */&#xA;&#xA;SET DATEFIRST 1;&#xA;DECLARE @incluir_tiempo1 bit = 0;&#xA;&#xA;DECLARE @dmin date, @dmax date, @days int, @has int;&#xA;&#xA;SELECT @has = COUNT(1)&#xA;FROM &quot; + @[User::CONN_SIG_COL_LOGISTICA_DW] + &quot;.&quot; + @[User::TBL_TMP_PROMESA_V2] + &quot; WITH (NOLOCK)&#xA;WHERE (@incluir_tiempo1 = 1 OR ID_TIEMPO_ENTREGA &lt;&gt; 1);&#xA;&#xA;IF (@has = 0)&#xA;BEGIN&#xA;  PRINT 'No hay datos en TMP.PROMESA_V2 para el filtro; se omite cálculo e inserción.';&#xA;  RETURN;&#xA;END;&#xA;&#xA;SELECT&#xA;    @dmin = CONVERT(date, MIN(P.FECHA)),&#xA;    @dmax = CONVERT(date, MAX(ISNULL(P.FECHA_ENTREGA, GETDATE())))&#xA;FROM &quot; + @[User::CONN_SIG_COL_LOGISTICA_DW] + &quot;.&quot; + @[User::TBL_TMP_PROMESA_V2] + &quot; AS P WITH (NOLOCK)&#xA;WHERE (@incluir_tiempo1 = 1 OR P.ID_TIEMPO_ENTREGA &lt;&gt; 1);&#xA;&#xA;SET @dmin = ISNULL(@dmin, CONVERT(date, GETDATE()));&#xA;SET @dmax = ISNULL(@dmax, @dmin);&#xA;IF (@dmax &lt; @dmin) SET @dmax = @dmin;&#xA;&#xA;SET @days = DATEDIFF(DAY, @dmin, @dmax) + 1;&#xA;IF (@days &lt; 1) SET @days = 1;&#xA;&#xA;IF OBJECT_ID('tempdb..#CAL') IS NOT NULL DROP TABLE #CAL;&#xA;&#xA;WITH N AS (&#xA;    SELECT TOP (@days)&#xA;           ROW_NUMBER() OVER (ORDER BY (SELECT NULL)) - 1 AS n&#xA;    FROM sys.all_objects ao1&#xA;    CROSS JOIN sys.all_objects ao2&#xA;)&#xA;SELECT&#xA;    CAST(DATEADD(DAY, n, @dmin) AS date) AS dt,&#xA;    CASE WHEN DATEPART(WEEKDAY, DATEADD(DAY, n, @dmin)) = 1 THEN 1 ELSE 0 END AS IsSunday&#xA;INTO #CAL&#xA;FROM N;&#xA;&#xA;CREATE UNIQUE CLUSTERED INDEX IX_CAL_dt ON #CAL(dt);&#xA;ALTER TABLE #CAL ADD IsHoliday bit NULL, IsBusinessDay bit NULL, CumBusinessDays int NULL;&#xA;&#xA;UPDATE C&#xA;SET IsHoliday = CASE WHEN F.FECHA_FESTIVA IS NOT NULL THEN 1 ELSE 0 END&#xA;FROM #CAL C&#xA;LEFT JOIN &quot; + @[User::TBL_DIM_TIEMPO_FESTIVOS_NACIONALES] + &quot; F WITH (NOLOCK)&#xA;  ON F.FECHA_FESTIVA = C.dt AND F.ID_PAIS = 1;&#xA;&#xA;UPDATE #CAL&#xA;SET IsBusinessDay = CASE WHEN IsSunday = 1 OR IsHoliday = 1 THEN 0 ELSE 1 END;&#xA;&#xA;WITH X AS (&#xA;  SELECT dt,&#xA;         cum = SUM(CASE WHEN IsBusinessDay = 1 THEN 1 ELSE 0 END)&#xA;               OVER (ORDER BY dt ROWS UNBOUNDED PRECEDING)&#xA;  FROM #CAL&#xA;)&#xA;UPDATE c&#xA;SET CumBusinessDays = x.cum&#xA;FROM #CAL c&#xA;JOIN X ON X.dt = c.dt;&#xA;&#xA;IF OBJECT_ID('tempdb..#ND') IS NOT NULL DROP TABLE #ND;&#xA;&#xA;SELECT NUMERO_GUIA,&#xA;       SUM(ISNULL(ND_HORAS,0)) AS HORAS_ND&#xA;INTO #ND&#xA;FROM &quot; + @[User::CONN_SIG_COLOMBIA_DW] + &quot;.&quot; + @[User::TBL_TMP_PROMESA_ND_V2] + &quot; WITH (NOLOCK)&#xA;GROUP BY NUMERO_GUIA;&#xA;&#xA;CREATE UNIQUE CLUSTERED INDEX IX_ND_GUIA ON #ND(NUMERO_GUIA);&#xA;&#xA;IF OBJECT_ID('tempdb..#CONCEPTO') IS NOT NULL DROP TABLE #CONCEPTO;&#xA;&#xA;;WITH PP AS (&#xA;    SELECT P.NUMERO_GUIA, P.ID_PROCESO, P.ID_CONCEPTO, P.FECHA_HORA_MOVIMIENTO&#xA;    FROM &quot; + @[User::CONN_SIG_COL_LOGISTICA_DW] + &quot;.&quot; + @[User::TBL_TMP_PROMESA_PROCESOS_V2] + &quot; P WITH (NOLOCK)&#xA;),&#xA;PP21 AS (&#xA;    SELECT&#xA;        NUMERO_GUIA, ID_PROCESO, ID_CONCEPTO, FECHA_HORA_MOVIMIENTO,&#xA;        ROW_NUMBER() OVER (&#xA;          PARTITION BY NUMERO_GUIA&#xA;          ORDER BY FECHA_HORA_MOVIMIENTO DESC&#xA;        ) AS rn&#xA;    FROM PP&#xA;    WHERE ID_PROCESO = 21&#xA;),&#xA;PP21_TOP2 AS ( SELECT * FROM PP21 WHERE rn &lt;= 2 ),&#xA;FLAGS AS (&#xA;    SELECT&#xA;        X.NUMERO_GUIA,&#xA;        MAX(X.Flag_21_71)     AS has_21_71,&#xA;        MAX(X.Flag_21_72)     AS has_21_72,&#xA;        MAX(X.Flag_9_IN)      AS has_9_in,&#xA;        MAX(X.Flag_21_73_SAT) AS has_21_73_sat&#xA;    FROM (&#xA;        SELECT&#xA;            T.NUMERO_GUIA,&#xA;            CASE WHEN T.ID_CONCEPTO = 71 THEN 1 ELSE 0 END AS Flag_21_71,&#xA;            CASE WHEN T.ID_CONCEPTO = 72 THEN 1 ELSE 0 END AS Flag_21_72,&#xA;            0 AS Flag_9_IN,&#xA;            CASE WHEN T.ID_CONCEPTO = 73&#xA;                      AND DATEPART(WEEKDAY, CAST(T.FECHA_HORA_MOVIMIENTO AS date)) = 7&#xA;                 THEN 1 ELSE 0 END AS Flag_21_73_SAT&#xA;        FROM PP21_TOP2 T&#xA;        UNION ALL&#xA;        SELECT&#xA;            P.NUMERO_GUIA,&#xA;            0, 0,&#xA;            CASE WHEN P.ID_PROCESO = 9 AND P.ID_CONCEPTO IN (2,4,7,9) THEN 1 ELSE 0 END,&#xA;            0&#xA;        FROM PP P&#xA;    ) X&#xA;    GROUP BY X.NUMERO_GUIA&#xA;)&#xA;SELECT&#xA;    F.NUMERO_GUIA,&#xA;    ID_CONCEPTO =&#xA;        CASE&#xA;            WHEN F.has_21_71     = 1 THEN '2'&#xA;            WHEN F.has_21_72     = 1 THEN '3'&#xA;            WHEN F.has_9_in      = 1 THEN '4'&#xA;            WHEN F.has_21_73_sat = 1 THEN '5'&#xA;            ELSE '1'&#xA;        END&#xA;INTO #CONCEPTO&#xA;FROM FLAGS F;&#xA;&#xA;CREATE UNIQUE CLUSTERED INDEX IX_CONC_GUIA ON #CONCEPTO(NUMERO_GUIA);&#xA;&#xA;IF OBJECT_ID('tempdb..#ROUTE_MAP_V2') IS NOT NULL DROP TABLE #ROUTE_MAP_V2;&#xA;&#xA;SELECT&#xA;   MAX(ID_RUTA) AS ID_RUTA,&#xA;   ID_CIUDAD_ORIGEN,&#xA;   ID_CIUDAD_DESTINO,&#xA;   ID_TIEMPO,&#xA;   ID_MEDTRANS&#xA;INTO #ROUTE_MAP_V2&#xA;FROM &quot; + @[User::TBL_DIM_RED_OPERATIVA_RUTA] + &quot; WITH (NOLOCK)&#xA;WHERE ID_ESTADO_RUTA = 1&#xA;GROUP BY ID_CIUDAD_ORIGEN, ID_CIUDAD_DESTINO, ID_TIEMPO, ID_MEDTRANS;&#xA;&#xA;CREATE UNIQUE CLUSTERED INDEX IX_RMAPV2_KEYS ON #ROUTE_MAP_V2(ID_CIUDAD_ORIGEN, ID_CIUDAD_DESTINO, ID_TIEMPO, ID_MEDTRANS);&#xA;CREATE NONCLUSTERED INDEX IX_RMAPV2_RUTA ON #ROUTE_MAP_V2(ID_RUTA);&#xA;&#xA;/* === PERSISTIR #ROUTE_MAP_V2 EN STAGING FÍSICA: TMP.MPCCO_RED_OPERATIVA_RUTA_V2 === */&#xA;IF OBJECT_ID('TMP.MPCCO_RED_OPERATIVA_RUTA_V2','U') IS NULL&#xA;BEGIN&#xA;  CREATE TABLE TMP.MPCCO_RED_OPERATIVA_RUTA_V2 (&#xA;      ID_RUTA           INT         NOT NULL,&#xA;      ID_CIUDAD_ORIGEN  INT         NOT NULL,&#xA;      ID_CIUDAD_DESTINO INT         NOT NULL,&#xA;      ID_TIEMPO         INT         NOT NULL,&#xA;      ID_MEDTRANS       INT         NOT NULL&#xA;  );&#xA;END;&#xA;&#xA;TRUNCATE TABLE TMP.MPCCO_RED_OPERATIVA_RUTA_V2;&#xA;&#xA;INSERT INTO TMP.MPCCO_RED_OPERATIVA_RUTA_V2 (ID_RUTA, ID_CIUDAD_ORIGEN, ID_CIUDAD_DESTINO, ID_TIEMPO, ID_MEDTRANS)&#xA;SELECT ID_RUTA, ID_CIUDAD_ORIGEN, ID_CIUDAD_DESTINO, ID_TIEMPO, ID_MEDTRANS&#xA;FROM #ROUTE_MAP_V2;&#xA;&#xA;IF EXISTS (&#xA;  SELECT 1 FROM sys.indexes &#xA;  WHERE object_id = OBJECT_ID('TMP.MPCCO_RED_OPERATIVA_RUTA_V2') &#xA;    AND name='OS211_IX_TMP_RED_OPERATIVA_RUTA_ESTADO_CIUDAD'&#xA;)&#xA;  DROP INDEX OS211_IX_TMP_RED_OPERATIVA_RUTA_ESTADO_CIUDAD ON TMP.MPCCO_RED_OPERATIVA_RUTA_V2;&#xA;&#xA;CREATE NONCLUSTERED INDEX OS211_IX_TMP_RED_OPERATIVA_RUTA_ESTADO_CIUDAD&#xA;ON TMP.MPCCO_RED_OPERATIVA_RUTA_V2 (ID_CIUDAD_ORIGEN, ID_CIUDAD_DESTINO, ID_TIEMPO, ID_MEDTRANS)&#xA;INCLUDE (ID_RUTA);&#xA;/* === FIN PERSISTENCIA === */&#xA;&#xA;TRUNCATE TABLE &quot; + @[User::TBL_TMP_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2] + &quot;;&#xA;&#xA;INSERT INTO &quot; + @[User::TBL_TMP_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2] + &quot;&#xA;(&#xA;   TIME_ID, FECHA, DIA, MES, AÑO,&#xA;   ID_CIUDAD_ORIGEN, ID_CIUDAD_DESTINO, ID_ESTADOENVIO, ID_PRODUCTO, ID_SUBPRODUCTO, ID_CLIENTE,&#xA;   ID_CONCEPTO, ID_TIEMPO_ENTREGA, ID_MEDTRANS,&#xA;   NUMERO_GUIA,&#xA;   TIEMPO_PROMESA_H,&#xA;   TIEMPO_PROMESA_CUMPLE_H,&#xA;   HORAS_ND, ID_ESTADO_ND,&#xA;   GR_ID_TIPO_COBRO&#xA;)&#xA;SELECT&#xA;   CONVERT(int, CONVERT(char(8), CAST(EM.FECHA AS date), 112))                AS TIME_ID,&#xA;   CAST(CAST(EM.FECHA AS date) AS datetime)                                   AS FECHA,&#xA;   DAY(EM.FECHA) AS DIA,&#xA;   MONTH(EM.FECHA) AS MES,&#xA;   YEAR(EM.FECHA) AS AÑO,&#xA;   ISNULL(EM.ID_CIUDAD_ORIGEN,0),&#xA;   ISNULL(EM.ID_CIUDAD_DESTINO,0),&#xA;   EM.ID_ESTADOENVIO,&#xA;   EM.ID_PRODUCTO,&#xA;   EM.ID_SUBPRODUCTO,&#xA;   EM.ID_CLIENTE,&#xA;   COALESCE(CPT.ID_CONCEPTO, '1') AS ID_CONCEPTO,&#xA;   ISNULL(EM.ID_TIEMPO_ENTREGA,0),&#xA;   ISNULL(EM.ID_MEDTRANS,0),&#xA;   EM.NUMERO_GUIA,&#xA;   ISNULL(CA.time_minutes / 60.0, 0) AS TIEMPO_PROMESA_H,&#xA;   CASE&#xA;      WHEN EM.ID_TIEMPO_ENTREGA = 2 THEN&#xA;           CASE WHEN ISNULL(ND.HORAS_ND,0) &gt; 0 THEN&#xA;                    CASE WHEN CONVERT(date, EM.FECHA_ENTREGA_DEF) IN (CONVERT(date, EM.FECHA), DATEADD(DAY,1,CONVERT(date, EM.FECHA)))&#xA;                         THEN 'SI' ELSE 'NO' END&#xA;                ELSE&#xA;                    CASE WHEN CONVERT(date, EM.FECHA_ENTREGA_DEF) = CONVERT(date, EM.FECHA)&#xA;                         THEN 'SI' ELSE 'NO' END&#xA;           END&#xA;      WHEN EM.ID_TIEMPO_ENTREGA = 3 THEN&#xA;           CASE WHEN ISNULL(ND.HORAS_ND,0) &gt; 0 THEN&#xA;                    CASE WHEN EM.FECHA_ENTREGA_DEF &lt; DATEADD(DAY, 1, CONVERT(DATETIME, CONVERT(date, EM.FECHA_VIGENTE)))&#xA;                         THEN 'SI' ELSE 'NO' END&#xA;                ELSE&#xA;                    CASE WHEN EM.FECHA_ENTREGA_DEF &lt;= EM.FECHA_VIGENTE&#xA;                         THEN 'SI' ELSE 'NO' END&#xA;           END&#xA;      ELSE NULL&#xA;   END AS TIEMPO_PROMESA_CUMPLE_H,&#xA;   ISNULL(ND.HORAS_ND,0) AS HORAS_ND,&#xA;   CASE WHEN ISNULL(ND.HORAS_ND,0) &gt; 0 THEN 'SI' ELSE 'NO' END AS ID_ESTADO_ND,&#xA;   EM.GR_ID_TIPO_COBRO&#xA;FROM (&#xA;   SELECT&#xA;      P.NUMERO_GUIA,&#xA;      P.ID_CIUDAD_ORIGEN, P.ID_CIUDAD_DESTINO, P.ID_ESTADOENVIO,&#xA;      P.ID_PRODUCTO, P.ID_SUBPRODUCTO, P.ID_CLIENTE,&#xA;      P.ID_TIEMPO_ENTREGA, P.ID_MEDTRANS,&#xA;      P.FECHA,&#xA;      CAST(P.FECHA AS date) AS FECHA_ENVIO_D,&#xA;      CAST(ISNULL(P.FECHA_ENTREGA, CONVERT(DATETIME, CONVERT(date, GETDATE()))) AS datetime) AS FECHA_ENTREGA_DEF,&#xA;      CAST(ISNULL(P.FECHA_ENTREGA, GETDATE()) AS date) AS FECHA_ENTREGA_D,&#xA;      P.FECHA_VIGENTE,&#xA;      P.GR_ID_TIPO_COBRO&#xA;   FROM (&#xA;     SELECT *&#xA;     FROM (&#xA;       SELECT P.*,&#xA;              ROW_NUMBER() OVER (&#xA;                PARTITION BY P.NUMERO_GUIA, CAST(P.FECHA AS date)&#xA;                ORDER BY ISNULL(P.FECHA_ENTREGA, P.FECHA) DESC, P.FECHA DESC, P.FECHA_VIGENTE DESC&#xA;              ) AS rn&#xA;       FROM &quot; + @[User::CONN_SIG_COL_LOGISTICA_DW] + &quot;.&quot; + @[User::TBL_TMP_PROMESA_V2] + &quot; P WITH (NOLOCK)&#xA;       WHERE (@incluir_tiempo1 = 1 OR P.ID_TIEMPO_ENTREGA &lt;&gt; 1)&#xA;     ) z&#xA;     WHERE z.rn = 1&#xA;   ) P&#xA;) EM&#xA;OUTER APPLY (&#xA;   SELECT&#xA;     (CE.CumBusinessDays - ISNULL(CSPrev.CumBusinessDays, 0)) * 1440&#xA;     - CASE WHEN CS.IsBusinessDay = 1 THEN DATEDIFF(MINUTE, EM.FECHA_ENVIO_D, EM.FECHA) ELSE 0 END&#xA;     - CASE WHEN CE.IsBusinessDay = 1 THEN DATEDIFF(MINUTE, EM.FECHA_ENTREGA_DEF, DATEADD(DAY,1,EM.FECHA_ENTREGA_D)) ELSE 0 END&#xA;     AS time_minutes&#xA;   FROM #CAL CS&#xA;   LEFT JOIN #CAL CSPrev ON CSPrev.dt = DATEADD(DAY, -1, CS.dt)&#xA;   LEFT JOIN #CAL CE     ON CE.dt = EM.FECHA_ENTREGA_D&#xA;   WHERE CS.dt = EM.FECHA_ENVIO_D OR EM.ID_TIEMPO_ENTREGA IN (2,3)&#xA;) CA&#xA;LEFT JOIN #CONCEPTO CPT ON CPT.NUMERO_GUIA = EM.NUMERO_GUIA&#xA;LEFT JOIN #ND ND        ON ND.NUMERO_GUIA  = EM.NUMERO_GUIA;&#xA;&#xA;;WITH DEDUP AS (&#xA;  SELECT *,&#xA;         ROW_NUMBER() OVER (PARTITION BY FECHA, NUMERO_GUIA ORDER BY TIME_ID DESC) AS rn&#xA;  FROM &quot; + @[User::TBL_TMP_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2] + &quot;&#xA;)&#xA;DELETE FROM DEDUP WHERE rn &gt; 1;&#xA;&#xA;IF NOT EXISTS (&#xA;  SELECT 1 FROM sys.indexes&#xA;  WHERE object_id = OBJECT_ID('&quot; + @[User::TBL_TMP_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2] + &quot;')&#xA;    AND name = 'OS211_IX_TMP_PROMESA_V2_NUMERO_GUIA'&#xA;)&#xA;CREATE NONCLUSTERED INDEX OS211_IX_TMP_PROMESA_V2_NUMERO_GUIA&#xA;ON &quot; + @[User::TBL_TMP_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2] + &quot; (NUMERO_GUIA);&#xA;&#xA;UPDATE T&#xA;SET T.ID_RUTA = ISNULL(RM.ID_RUTA, 0)&#xA;FROM &quot; + @[User::TBL_TMP_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2] + &quot; T&#xA;LEFT JOIN #ROUTE_MAP_V2 RM&#xA;  ON T.ID_CIUDAD_ORIGEN = RM.ID_CIUDAD_ORIGEN&#xA; AND T.ID_CIUDAD_DESTINO = RM.ID_CIUDAD_DESTINO&#xA; AND T.ID_TIEMPO_ENTREGA = RM.ID_TIEMPO&#xA; AND T.ID_MEDTRANS      = RM.ID_MEDTRANS;&#xA;&#xA;UPDATE T&#xA;SET&#xA;  T.TIEMPO_OFERTA = R.TIEMPO_ENTREGA_COMERCIAL_HOR,&#xA;  T.ID_GRUPO_RED  = CASE&#xA;                      WHEN R.ID_RUTA = 0 THEN 0&#xA;                      WHEN R.TIEMPO_ENTREGA_COMERCIAL_HOR BETWEEN 0   AND 36  THEN 1&#xA;                      WHEN R.TIEMPO_ENTREGA_COMERCIAL_HOR BETWEEN 37  AND 60  THEN 2&#xA;                      WHEN R.TIEMPO_ENTREGA_COMERCIAL_HOR BETWEEN 61  AND 84  THEN 3&#xA;                      WHEN R.TIEMPO_ENTREGA_COMERCIAL_HOR BETWEEN 85  AND 108 THEN 4&#xA;                      ELSE 5&#xA;                    END&#xA;FROM &quot; + @[User::TBL_TMP_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2] + &quot; T&#xA;LEFT JOIN &quot; + @[User::TBL_DIM_RED_OPERATIVA_RUTA] + &quot; R WITH (NOLOCK)&#xA;  ON T.ID_RUTA = R.ID_RUTA;&#xA;&#xA;UPDATE T&#xA;SET T.TIEMPO_PROMESA_CUMPLE_H =&#xA;  CASE&#xA;    WHEN T.TIEMPO_PROMESA_H &gt;&#xA;         (CASE&#xA;            WHEN T.ID_RUTA = 0 THEN 0&#xA;            WHEN T.TIEMPO_OFERTA &lt;= 36 THEN (36 + T.HORAS_ND)&#xA;            WHEN T.TIEMPO_OFERTA &gt; 36 AND (T.TIEMPO_OFERTA + T.HORAS_ND) &lt;= 60 THEN (60 + T.HORAS_ND)&#xA;            WHEN T.TIEMPO_OFERTA &gt; 60 AND (T.TIEMPO_OFERTA + T.HORAS_ND) &lt;= 84 THEN (84 + T.HORAS_ND)&#xA;            WHEN T.TIEMPO_OFERTA &gt; 84 AND (T.TIEMPO_OFERTA + T.HORAS_ND) &lt;= 108 THEN (108 + T.HORAS_ND)&#xA;            ELSE T.TIEMPO_OFERTA + T.HORAS_ND&#xA;          END)&#xA;      THEN 'NO' ELSE 'SI'&#xA;  END&#xA;FROM &quot; + @[User::TBL_TMP_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2] + &quot; AS T&#xA;WHERE T.ID_TIEMPO_ENTREGA NOT IN (2,3)&#xA;  AND T.TIEMPO_PROMESA_CUMPLE_H IS NULL;&#xA;&#xA;IF EXISTS(SELECT * FROM sys.indexes WHERE object_id = object_id('&quot; + @[User::TBL_TMP_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2] + &quot;') AND NAME ='OS211_IX_TMP_GUIAS_RED_OPERATIVA_PROMESA')&#xA;    DROP INDEX OS211_IX_TMP_GUIAS_RED_OPERATIVA_PROMESA ON &quot; + @[User::TBL_TMP_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2] + &quot;;&#xA;&#xA;CREATE NONCLUSTERED INDEX OS211_IX_TMP_GUIAS_RED_OPERATIVA_PROMESA ON &quot; + @[User::TBL_TMP_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2] + &quot; ( TIEMPO_PROMESA_H ASC ) INCLUDE (TIEMPO_OFERTA);&#xA;&#xA;IF EXISTS(SELECT * FROM sys.indexes WHERE object_id = object_id('&quot; + @[User::TBL_TMP_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2] + &quot;') AND NAME ='OS211_IX_TMP_GUIAS_RED_OPERATIVA_RUTA')&#xA;    DROP INDEX OS211_IX_TMP_GUIAS_RED_OPERATIVA_RUTA ON &quot; + @[User::TBL_TMP_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2] + &quot;;&#xA;&#xA;CREATE NONCLUSTERED INDEX OS211_IX_TMP_GUIAS_RED_OPERATIVA_RUTA ON &quot; + @[User::TBL_TMP_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2] + &quot; ( ID_RUTA ASC );&#xA;&#xA;IF EXISTS(SELECT * FROM sys.indexes WHERE object_id = object_id('&quot; + @[User::TBL_TMP_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2] + &quot;') AND NAME ='OS211_IX_TMP_GUIAS_RED_OPERATIVA_TIME_ID')&#xA;    DROP INDEX OS211_IX_TMP_GUIAS_RED_OPERATIVA_TIME_ID ON &quot; + @[User::TBL_TMP_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2] + &quot;;&#xA;&#xA;CREATE NONCLUSTERED INDEX OS211_IX_TMP_GUIAS_RED_OPERATIVA_TIME_ID ON &quot; + @[User::TBL_TMP_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2] + &quot; ( TIME_ID ASC );&quot;"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="SQL_INSERT_Promesa_red_operativa_v2">
      <DTS:VariableValue
        DTS:DataType="8">/* GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2 — set-based + DEDUP (corrigido) */

SET DATEFIRST 1;
DECLARE @incluir_tiempo1 bit = 0;

DECLARE @dmin date, @dmax date, @days int, @has int;

SELECT @has = COUNT(1)
FROM SIG_COL_LOGISTICA_DW.TMP.MPCCO_PROMESA_V2 WITH (NOLOCK)
WHERE (@incluir_tiempo1 = 1 OR ID_TIEMPO_ENTREGA &lt;&gt; 1);

IF (@has = 0)
BEGIN
  PRINT 'No hay datos en TMP.PROMESA_V2 para el filtro; se omite cálculo e inserción.';
  RETURN;
END;

SELECT
    @dmin = CONVERT(date, MIN(P.FECHA)),
    @dmax = CONVERT(date, MAX(ISNULL(P.FECHA_ENTREGA, GETDATE())))
FROM SIG_COL_LOGISTICA_DW.TMP.MPCCO_PROMESA_V2 AS P WITH (NOLOCK)
WHERE (@incluir_tiempo1 = 1 OR P.ID_TIEMPO_ENTREGA &lt;&gt; 1);

SET @dmin = ISNULL(@dmin, CONVERT(date, GETDATE()));
SET @dmax = ISNULL(@dmax, @dmin);
IF (@dmax &lt; @dmin) SET @dmax = @dmin;

SET @days = DATEDIFF(DAY, @dmin, @dmax) + 1;
IF (@days &lt; 1) SET @days = 1;

IF OBJECT_ID('tempdb..#CAL') IS NOT NULL DROP TABLE #CAL;

WITH N AS (
    SELECT TOP (@days)
           ROW_NUMBER() OVER (ORDER BY (SELECT NULL)) - 1 AS n
    FROM sys.all_objects ao1
    CROSS JOIN sys.all_objects ao2
)
SELECT
    CAST(DATEADD(DAY, n, @dmin) AS date) AS dt,
    CASE WHEN DATEPART(WEEKDAY, DATEADD(DAY, n, @dmin)) = 1 THEN 1 ELSE 0 END AS IsSunday
INTO #CAL
FROM N;

CREATE UNIQUE CLUSTERED INDEX IX_CAL_dt ON #CAL(dt);
ALTER TABLE #CAL ADD IsHoliday bit NULL, IsBusinessDay bit NULL, CumBusinessDays int NULL;

UPDATE C
SET IsHoliday = CASE WHEN F.FECHA_FESTIVA IS NOT NULL THEN 1 ELSE 0 END
FROM #CAL C
LEFT JOIN DIM.TIEMPO_FESTIVOS_NACIONALES F WITH (NOLOCK)
  ON F.FECHA_FESTIVA = C.dt AND F.ID_PAIS = 1;

UPDATE #CAL
SET IsBusinessDay = CASE WHEN IsSunday = 1 OR IsHoliday = 1 THEN 0 ELSE 1 END;

WITH X AS (
  SELECT dt,
         cum = SUM(CASE WHEN IsBusinessDay = 1 THEN 1 ELSE 0 END)
               OVER (ORDER BY dt ROWS UNBOUNDED PRECEDING)
  FROM #CAL
)
UPDATE c
SET CumBusinessDays = x.cum
FROM #CAL c
JOIN X ON X.dt = c.dt;

IF OBJECT_ID('tempdb..#ND') IS NOT NULL DROP TABLE #ND;

SELECT NUMERO_GUIA,
       SUM(ISNULL(ND_HORAS,0)) AS HORAS_ND
INTO #ND
FROM SIG_COLOMBIA_DW.TMP.MPCCO_PROMESA_ND_V2 WITH (NOLOCK)
GROUP BY NUMERO_GUIA;

CREATE UNIQUE CLUSTERED INDEX IX_ND_GUIA ON #ND(NUMERO_GUIA);

IF OBJECT_ID('tempdb..#CONCEPTO') IS NOT NULL DROP TABLE #CONCEPTO;

;WITH PP AS (
    SELECT P.NUMERO_GUIA, P.ID_PROCESO, P.ID_CONCEPTO, P.FECHA_HORA_MOVIMIENTO
    FROM SIG_COL_LOGISTICA_DW.TMP.MPCCO_PROMESA_PROCESOS_V2 P WITH (NOLOCK)
),
PP21 AS (
    SELECT
        NUMERO_GUIA, ID_PROCESO, ID_CONCEPTO, FECHA_HORA_MOVIMIENTO,
        ROW_NUMBER() OVER (
          PARTITION BY NUMERO_GUIA
          ORDER BY FECHA_HORA_MOVIMIENTO DESC
        ) AS rn
    FROM PP
    WHERE ID_PROCESO = 21
),
PP21_TOP2 AS ( SELECT * FROM PP21 WHERE rn &lt;= 2 ),
FLAGS AS (
    SELECT
        X.NUMERO_GUIA,
        MAX(X.Flag_21_71)     AS has_21_71,
        MAX(X.Flag_21_72)     AS has_21_72,
        MAX(X.Flag_9_IN)      AS has_9_in,
        MAX(X.Flag_21_73_SAT) AS has_21_73_sat
    FROM (
        SELECT
            T.NUMERO_GUIA,
            CASE WHEN T.ID_CONCEPTO = 71 THEN 1 ELSE 0 END AS Flag_21_71,
            CASE WHEN T.ID_CONCEPTO = 72 THEN 1 ELSE 0 END AS Flag_21_72,
            0 AS Flag_9_IN,
            CASE WHEN T.ID_CONCEPTO = 73
                      AND DATEPART(WEEKDAY, CAST(T.FECHA_HORA_MOVIMIENTO AS date)) = 7
                 THEN 1 ELSE 0 END AS Flag_21_73_SAT
        FROM PP21_TOP2 T
        UNION ALL
        SELECT
            P.NUMERO_GUIA,
            0, 0,
            CASE WHEN P.ID_PROCESO = 9 AND P.ID_CONCEPTO IN (2,4,7,9) THEN 1 ELSE 0 END,
            0
        FROM PP P
    ) X
    GROUP BY X.NUMERO_GUIA
)
SELECT
    F.NUMERO_GUIA,
    ID_CONCEPTO =
        CASE
            WHEN F.has_21_71     = 1 THEN '2'
            WHEN F.has_21_72     = 1 THEN '3'
            WHEN F.has_9_in      = 1 THEN '4'
            WHEN F.has_21_73_sat = 1 THEN '5'
            ELSE '1'
        END
INTO #CONCEPTO
FROM FLAGS F;

CREATE UNIQUE CLUSTERED INDEX IX_CONC_GUIA ON #CONCEPTO(NUMERO_GUIA);

IF OBJECT_ID('tempdb..#ROUTE_MAP_V2') IS NOT NULL DROP TABLE #ROUTE_MAP_V2;

SELECT
   MAX(ID_RUTA) AS ID_RUTA,
   ID_CIUDAD_ORIGEN,
   ID_CIUDAD_DESTINO,
   ID_TIEMPO,
   ID_MEDTRANS
INTO #ROUTE_MAP_V2
FROM DIM.RED_OPERATIVA_RUTA WITH (NOLOCK)
WHERE ID_ESTADO_RUTA = 1
GROUP BY ID_CIUDAD_ORIGEN, ID_CIUDAD_DESTINO, ID_TIEMPO, ID_MEDTRANS;

CREATE UNIQUE CLUSTERED INDEX IX_RMAPV2_KEYS ON #ROUTE_MAP_V2(ID_CIUDAD_ORIGEN, ID_CIUDAD_DESTINO, ID_TIEMPO, ID_MEDTRANS);
CREATE NONCLUSTERED INDEX IX_RMAPV2_RUTA ON #ROUTE_MAP_V2(ID_RUTA);

/* === PERSISTIR #ROUTE_MAP_V2 EN STAGING FÍSICA: TMP.MPCCO_RED_OPERATIVA_RUTA_V2 === */
IF OBJECT_ID('TMP.MPCCO_RED_OPERATIVA_RUTA_V2','U') IS NULL
BEGIN
  CREATE TABLE TMP.MPCCO_RED_OPERATIVA_RUTA_V2 (
      ID_RUTA           INT         NOT NULL,
      ID_CIUDAD_ORIGEN  INT         NOT NULL,
      ID_CIUDAD_DESTINO INT         NOT NULL,
      ID_TIEMPO         INT         NOT NULL,
      ID_MEDTRANS       INT         NOT NULL
  );
END;

TRUNCATE TABLE TMP.MPCCO_RED_OPERATIVA_RUTA_V2;

INSERT INTO TMP.MPCCO_RED_OPERATIVA_RUTA_V2 (ID_RUTA, ID_CIUDAD_ORIGEN, ID_CIUDAD_DESTINO, ID_TIEMPO, ID_MEDTRANS)
SELECT ID_RUTA, ID_CIUDAD_ORIGEN, ID_CIUDAD_DESTINO, ID_TIEMPO, ID_MEDTRANS
FROM #ROUTE_MAP_V2;

IF EXISTS (
  SELECT 1 FROM sys.indexes 
  WHERE object_id = OBJECT_ID('TMP.MPCCO_RED_OPERATIVA_RUTA_V2') 
    AND name='OS211_IX_TMP_RED_OPERATIVA_RUTA_ESTADO_CIUDAD'
)
  DROP INDEX OS211_IX_TMP_RED_OPERATIVA_RUTA_ESTADO_CIUDAD ON TMP.MPCCO_RED_OPERATIVA_RUTA_V2;

CREATE NONCLUSTERED INDEX OS211_IX_TMP_RED_OPERATIVA_RUTA_ESTADO_CIUDAD
ON TMP.MPCCO_RED_OPERATIVA_RUTA_V2 (ID_CIUDAD_ORIGEN, ID_CIUDAD_DESTINO, ID_TIEMPO, ID_MEDTRANS)
INCLUDE (ID_RUTA);
/* === FIN PERSISTENCIA === */

TRUNCATE TABLE TMP.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2;

INSERT INTO TMP.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2
(
   TIME_ID, FECHA, DIA, MES, AÑO,
   ID_CIUDAD_ORIGEN, ID_CIUDAD_DESTINO, ID_ESTADOENVIO, ID_PRODUCTO, ID_SUBPRODUCTO, ID_CLIENTE,
   ID_CONCEPTO, ID_TIEMPO_ENTREGA, ID_MEDTRANS,
   NUMERO_GUIA,
   TIEMPO_PROMESA_H,
   TIEMPO_PROMESA_CUMPLE_H,
   HORAS_ND, ID_ESTADO_ND,
   GR_ID_TIPO_COBRO
)
SELECT
   CONVERT(int, CONVERT(char(8), CAST(EM.FECHA AS date), 112))                AS TIME_ID,
   CAST(CAST(EM.FECHA AS date) AS datetime)                                   AS FECHA,
   DAY(EM.FECHA) AS DIA,
   MONTH(EM.FECHA) AS MES,
   YEAR(EM.FECHA) AS AÑO,
   ISNULL(EM.ID_CIUDAD_ORIGEN,0),
   ISNULL(EM.ID_CIUDAD_DESTINO,0),
   EM.ID_ESTADOENVIO,
   EM.ID_PRODUCTO,
   EM.ID_SUBPRODUCTO,
   EM.ID_CLIENTE,
   COALESCE(CPT.ID_CONCEPTO, '1') AS ID_CONCEPTO,
   ISNULL(EM.ID_TIEMPO_ENTREGA,0),
   ISNULL(EM.ID_MEDTRANS,0),
   EM.NUMERO_GUIA,
   ISNULL(CA.time_minutes / 60.0, 0) AS TIEMPO_PROMESA_H,
   CASE
      WHEN EM.ID_TIEMPO_ENTREGA = 2 THEN
           CASE WHEN ISNULL(ND.HORAS_ND,0) &gt; 0 THEN
                    CASE WHEN CONVERT(date, EM.FECHA_ENTREGA_DEF) IN (CONVERT(date, EM.FECHA), DATEADD(DAY,1,CONVERT(date, EM.FECHA)))
                         THEN 'SI' ELSE 'NO' END
                ELSE
                    CASE WHEN CONVERT(date, EM.FECHA_ENTREGA_DEF) = CONVERT(date, EM.FECHA)
                         THEN 'SI' ELSE 'NO' END
           END
      WHEN EM.ID_TIEMPO_ENTREGA = 3 THEN
           CASE WHEN ISNULL(ND.HORAS_ND,0) &gt; 0 THEN
                    CASE WHEN EM.FECHA_ENTREGA_DEF &lt; DATEADD(DAY, 1, CONVERT(DATETIME, CONVERT(date, EM.FECHA_VIGENTE)))
                         THEN 'SI' ELSE 'NO' END
                ELSE
                    CASE WHEN EM.FECHA_ENTREGA_DEF &lt;= EM.FECHA_VIGENTE
                         THEN 'SI' ELSE 'NO' END
           END
      ELSE NULL
   END AS TIEMPO_PROMESA_CUMPLE_H,
   ISNULL(ND.HORAS_ND,0) AS HORAS_ND,
   CASE WHEN ISNULL(ND.HORAS_ND,0) &gt; 0 THEN 'SI' ELSE 'NO' END AS ID_ESTADO_ND,
   EM.GR_ID_TIPO_COBRO
FROM (
   SELECT
      P.NUMERO_GUIA,
      P.ID_CIUDAD_ORIGEN, P.ID_CIUDAD_DESTINO, P.ID_ESTADOENVIO,
      P.ID_PRODUCTO, P.ID_SUBPRODUCTO, P.ID_CLIENTE,
      P.ID_TIEMPO_ENTREGA, P.ID_MEDTRANS,
      P.FECHA,
      CAST(P.FECHA AS date) AS FECHA_ENVIO_D,
      CAST(ISNULL(P.FECHA_ENTREGA, CONVERT(DATETIME, CONVERT(date, GETDATE()))) AS datetime) AS FECHA_ENTREGA_DEF,
      CAST(ISNULL(P.FECHA_ENTREGA, GETDATE()) AS date) AS FECHA_ENTREGA_D,
      P.FECHA_VIGENTE,
      P.GR_ID_TIPO_COBRO
   FROM (
     SELECT *
     FROM (
       SELECT P.*,
              ROW_NUMBER() OVER (
                PARTITION BY P.NUMERO_GUIA, CAST(P.FECHA AS date)
                ORDER BY ISNULL(P.FECHA_ENTREGA, P.FECHA) DESC, P.FECHA DESC, P.FECHA_VIGENTE DESC
              ) AS rn
       FROM SIG_COL_LOGISTICA_DW.TMP.MPCCO_PROMESA_V2 P WITH (NOLOCK)
       WHERE (@incluir_tiempo1 = 1 OR P.ID_TIEMPO_ENTREGA &lt;&gt; 1)
     ) z
     WHERE z.rn = 1
   ) P
) EM
OUTER APPLY (
   SELECT
     (CE.CumBusinessDays - ISNULL(CSPrev.CumBusinessDays, 0)) * 1440
     - CASE WHEN CS.IsBusinessDay = 1 THEN DATEDIFF(MINUTE, EM.FECHA_ENVIO_D, EM.FECHA) ELSE 0 END
     - CASE WHEN CE.IsBusinessDay = 1 THEN DATEDIFF(MINUTE, EM.FECHA_ENTREGA_DEF, DATEADD(DAY,1,EM.FECHA_ENTREGA_D)) ELSE 0 END
     AS time_minutes
   FROM #CAL CS
   LEFT JOIN #CAL CSPrev ON CSPrev.dt = DATEADD(DAY, -1, CS.dt)
   LEFT JOIN #CAL CE     ON CE.dt = EM.FECHA_ENTREGA_D
   WHERE CS.dt = EM.FECHA_ENVIO_D OR EM.ID_TIEMPO_ENTREGA IN (2,3)
) CA
LEFT JOIN #CONCEPTO CPT ON CPT.NUMERO_GUIA = EM.NUMERO_GUIA
LEFT JOIN #ND ND        ON ND.NUMERO_GUIA  = EM.NUMERO_GUIA;

;WITH DEDUP AS (
  SELECT *,
         ROW_NUMBER() OVER (PARTITION BY FECHA, NUMERO_GUIA ORDER BY TIME_ID DESC) AS rn
  FROM TMP.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2
)
DELETE FROM DEDUP WHERE rn &gt; 1;

IF NOT EXISTS (
  SELECT 1 FROM sys.indexes
  WHERE object_id = OBJECT_ID('TMP.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2')
    AND name = 'OS211_IX_TMP_PROMESA_V2_NUMERO_GUIA'
)
CREATE NONCLUSTERED INDEX OS211_IX_TMP_PROMESA_V2_NUMERO_GUIA
ON TMP.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2 (NUMERO_GUIA);

UPDATE T
SET T.ID_RUTA = ISNULL(RM.ID_RUTA, 0)
FROM TMP.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2 T
LEFT JOIN #ROUTE_MAP_V2 RM
  ON T.ID_CIUDAD_ORIGEN = RM.ID_CIUDAD_ORIGEN
 AND T.ID_CIUDAD_DESTINO = RM.ID_CIUDAD_DESTINO
 AND T.ID_TIEMPO_ENTREGA = RM.ID_TIEMPO
 AND T.ID_MEDTRANS      = RM.ID_MEDTRANS;

UPDATE T
SET
  T.TIEMPO_OFERTA = R.TIEMPO_ENTREGA_COMERCIAL_HOR,
  T.ID_GRUPO_RED  = CASE
                      WHEN R.ID_RUTA = 0 THEN 0
                      WHEN R.TIEMPO_ENTREGA_COMERCIAL_HOR BETWEEN 0   AND 36  THEN 1
                      WHEN R.TIEMPO_ENTREGA_COMERCIAL_HOR BETWEEN 37  AND 60  THEN 2
                      WHEN R.TIEMPO_ENTREGA_COMERCIAL_HOR BETWEEN 61  AND 84  THEN 3
                      WHEN R.TIEMPO_ENTREGA_COMERCIAL_HOR BETWEEN 85  AND 108 THEN 4
                      ELSE 5
                    END
FROM TMP.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2 T
LEFT JOIN DIM.RED_OPERATIVA_RUTA R WITH (NOLOCK)
  ON T.ID_RUTA = R.ID_RUTA;

UPDATE T
SET T.TIEMPO_PROMESA_CUMPLE_H =
  CASE
    WHEN T.TIEMPO_PROMESA_H &gt;
         (CASE
            WHEN T.ID_RUTA = 0 THEN 0
            WHEN T.TIEMPO_OFERTA &lt;= 36 THEN (36 + T.HORAS_ND)
            WHEN T.TIEMPO_OFERTA &gt; 36 AND (T.TIEMPO_OFERTA + T.HORAS_ND) &lt;= 60 THEN (60 + T.HORAS_ND)
            WHEN T.TIEMPO_OFERTA &gt; 60 AND (T.TIEMPO_OFERTA + T.HORAS_ND) &lt;= 84 THEN (84 + T.HORAS_ND)
            WHEN T.TIEMPO_OFERTA &gt; 84 AND (T.TIEMPO_OFERTA + T.HORAS_ND) &lt;= 108 THEN (108 + T.HORAS_ND)
            ELSE T.TIEMPO_OFERTA + T.HORAS_ND
          END)
      THEN 'NO' ELSE 'SI'
  END
FROM TMP.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2 AS T
WHERE T.ID_TIEMPO_ENTREGA NOT IN (2,3)
  AND T.TIEMPO_PROMESA_CUMPLE_H IS NULL;

IF EXISTS(SELECT * FROM sys.indexes WHERE object_id = object_id('TMP.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2') AND NAME ='OS211_IX_TMP_GUIAS_RED_OPERATIVA_PROMESA')
    DROP INDEX OS211_IX_TMP_GUIAS_RED_OPERATIVA_PROMESA ON TMP.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2;

CREATE NONCLUSTERED INDEX OS211_IX_TMP_GUIAS_RED_OPERATIVA_PROMESA ON TMP.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2 ( TIEMPO_PROMESA_H ASC ) INCLUDE (TIEMPO_OFERTA);

IF EXISTS(SELECT * FROM sys.indexes WHERE object_id = object_id('TMP.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2') AND NAME ='OS211_IX_TMP_GUIAS_RED_OPERATIVA_RUTA')
    DROP INDEX OS211_IX_TMP_GUIAS_RED_OPERATIVA_RUTA ON TMP.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2;

CREATE NONCLUSTERED INDEX OS211_IX_TMP_GUIAS_RED_OPERATIVA_RUTA ON TMP.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2 ( ID_RUTA ASC );

IF EXISTS(SELECT * FROM sys.indexes WHERE object_id = object_id('TMP.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2') AND NAME ='OS211_IX_TMP_GUIAS_RED_OPERATIVA_TIME_ID')
    DROP INDEX OS211_IX_TMP_GUIAS_RED_OPERATIVA_TIME_ID ON TMP.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2;

CREATE NONCLUSTERED INDEX OS211_IX_TMP_GUIAS_RED_OPERATIVA_TIME_ID ON TMP.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2 ( TIME_ID ASC );</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{AA1F75F5-6075-46BA-B1E1-84D3EEEFAA7E}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot;WITH PROMESA AS (&#xA;    SELECT&#xA;         NUMERO_GUIA AS G_NUMERO_GUIA&#xA;        ,0 AS SE_ID_FECHA&#xA;        ,'1900-01-01' AS SE_FECHA&#xA;        ,ISNULL(ID_CIUDAD_ORIGEN,-888) AS G_ID_CIUDAD_ORIGEN&#xA;        ,ISNULL(ID_CIUDAD_DESTINO,-888) AS G_ID_CIUDAD_DESTINO&#xA;        ,ISNULL(ID_CLIENTE,-888) AS G_ID_CLIENTE&#xA;        ,ISNULL(CONVERT(INT,ID_TIEMPO_ENTREGA),-888) AS G_ID_TIEMPO&#xA;        ,ISNULL(CONVERT(INT,ID_MEDTRANS),-888) AS G_ID_MEDTRANS&#xA;        ,0 AS G_ID_HABIL_SABADO&#xA;        ,GR_ID_TIPO_COBRO&#xA;    FROM &quot; + @[User::CONN_SIG_COL_LOGISTICA_DW] + &quot;.&quot; + @[User::TBL_TMP_PROMESA_V2] + &quot; T WITH (NOLOCK)&#xA;    WHERE ID_TIEMPO_ENTREGA = 1&#xA;)&#xA;SELECT &#xA;     GUIAS.G_NUMERO_GUIA&#xA;    ,GUIAS.SE_ID_FECHA&#xA;    ,GUIAS.SE_FECHA&#xA;    ,GUIAS.G_ID_CIUDAD_ORIGEN&#xA;    ,GUIAS.G_ID_CIUDAD_DESTINO&#xA;    ,GUIAS.G_ID_CLIENTE&#xA;    ,GUIAS.G_ID_TIEMPO&#xA;    ,GUIAS.G_ID_MEDTRANS&#xA;    ,GUIAS.G_ID_HABIL_SABADO&#xA;    ,GUIAS.GR_ID_TIPO_COBRO&#xA;    ,ISNULL(RED.ID_RUTA,0) AS ID_RUTA&#xA;    ,RED2.TIEMPO_ENTREGA_COMERCIAL_HOR AS TIEMPO_OFERTA&#xA;    ,CASE &#xA;        WHEN ISNULL(RED.ID_RUTA,0) = 0 THEN 0&#xA;        WHEN RED2.TIEMPO_ENTREGA_COMERCIAL_HOR BETWEEN 0  AND 36  THEN 1&#xA;        WHEN RED2.TIEMPO_ENTREGA_COMERCIAL_HOR BETWEEN 37 AND 60  THEN 2&#xA;        WHEN RED2.TIEMPO_ENTREGA_COMERCIAL_HOR BETWEEN 61 AND 84  THEN 3&#xA;        WHEN RED2.TIEMPO_ENTREGA_COMERCIAL_HOR BETWEEN 85 AND 108 THEN 4&#xA;        ELSE 5 &#xA;     END AS ID_GRUPO_RED&#xA;    ,C.TIEMPO_PROMESA_H&#xA;    ,C.TIEMPO_PROMESA_CUMPLE_H&#xA;FROM PROMESA AS GUIAS&#xA;INNER JOIN &quot; + @[User::TBL_TMP_RED_OPERATIVA_RUTA_V2] + &quot; RED&#xA;   ON GUIAS.G_ID_CIUDAD_ORIGEN = RED.ID_CIUDAD_ORIGEN&#xA;  AND GUIAS.G_ID_CIUDAD_DESTINO = RED.ID_CIUDAD_DESTINO&#xA;  AND GUIAS.G_ID_TIEMPO = RED.ID_TIEMPO&#xA;  AND GUIAS.G_ID_MEDTRANS = RED.ID_MEDTRANS&#xA;INNER JOIN &quot; + @[User::TBL_DIM_RED_OPERATIVA_RUTA] + &quot; RED2&#xA;   ON ISNULL(RED.ID_RUTA,0) = RED2.ID_RUTA&#xA;INNER JOIN &quot; + @[User::TBL_TMP_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA] + &quot; C WITH (NOLOCK)&#xA;   ON C.NUMERO_GUIA = GUIAS.G_NUMERO_GUIA;&quot;"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="SQL_SELECT_Cumplimiento_ac_dep">
      <DTS:VariableValue
        DTS:DataType="8">WITH PROMESA AS (
    SELECT
         NUMERO_GUIA AS G_NUMERO_GUIA
        ,0 AS SE_ID_FECHA
        ,'1900-01-01' AS SE_FECHA
        ,ISNULL(ID_CIUDAD_ORIGEN,-888) AS G_ID_CIUDAD_ORIGEN
        ,ISNULL(ID_CIUDAD_DESTINO,-888) AS G_ID_CIUDAD_DESTINO
        ,ISNULL(ID_CLIENTE,-888) AS G_ID_CLIENTE
        ,ISNULL(CONVERT(INT,ID_TIEMPO_ENTREGA),-888) AS G_ID_TIEMPO
        ,ISNULL(CONVERT(INT,ID_MEDTRANS),-888) AS G_ID_MEDTRANS
        ,0 AS G_ID_HABIL_SABADO
        ,GR_ID_TIPO_COBRO
    FROM SIG_COL_LOGISTICA_DW.TMP.MPCCO_PROMESA_V2 T WITH (NOLOCK)
    WHERE ID_TIEMPO_ENTREGA = 1
)
SELECT 
     GUIAS.G_NUMERO_GUIA
    ,GUIAS.SE_ID_FECHA
    ,GUIAS.SE_FECHA
    ,GUIAS.G_ID_CIUDAD_ORIGEN
    ,GUIAS.G_ID_CIUDAD_DESTINO
    ,GUIAS.G_ID_CLIENTE
    ,GUIAS.G_ID_TIEMPO
    ,GUIAS.G_ID_MEDTRANS
    ,GUIAS.G_ID_HABIL_SABADO
    ,GUIAS.GR_ID_TIPO_COBRO
    ,ISNULL(RED.ID_RUTA,0) AS ID_RUTA
    ,RED2.TIEMPO_ENTREGA_COMERCIAL_HOR AS TIEMPO_OFERTA
    ,CASE 
        WHEN ISNULL(RED.ID_RUTA,0) = 0 THEN 0
        WHEN RED2.TIEMPO_ENTREGA_COMERCIAL_HOR BETWEEN 0  AND 36  THEN 1
        WHEN RED2.TIEMPO_ENTREGA_COMERCIAL_HOR BETWEEN 37 AND 60  THEN 2
        WHEN RED2.TIEMPO_ENTREGA_COMERCIAL_HOR BETWEEN 61 AND 84  THEN 3
        WHEN RED2.TIEMPO_ENTREGA_COMERCIAL_HOR BETWEEN 85 AND 108 THEN 4
        ELSE 5 
     END AS ID_GRUPO_RED
    ,C.TIEMPO_PROMESA_H
    ,C.TIEMPO_PROMESA_CUMPLE_H
FROM PROMESA AS GUIAS
INNER JOIN TMP.MPCCO_RED_OPERATIVA_RUTA_V2 RED
   ON GUIAS.G_ID_CIUDAD_ORIGEN = RED.ID_CIUDAD_ORIGEN
  AND GUIAS.G_ID_CIUDAD_DESTINO = RED.ID_CIUDAD_DESTINO
  AND GUIAS.G_ID_TIEMPO = RED.ID_TIEMPO
  AND GUIAS.G_ID_MEDTRANS = RED.ID_MEDTRANS
INNER JOIN DIM.RED_OPERATIVA_RUTA RED2
   ON ISNULL(RED.ID_RUTA,0) = RED2.ID_RUTA
INNER JOIN TMP.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA C WITH (NOLOCK)
   ON C.NUMERO_GUIA = GUIAS.G_NUMERO_GUIA;</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{E51CFFCC-8876-4C15-B99B-50CAFF908398}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot;SELECT&#xA;     T.TIME_ID&#xA;    ,T.FECHA&#xA;    ,T.DIA&#xA;    ,T.MES&#xA;    ,T.AÑO&#xA;    ,T.ID_CIUDAD_ORIGEN&#xA;    ,T.ID_CIUDAD_DESTINO&#xA;    ,T.ID_CLIENTE&#xA;    ,T.ID_ESTADOENVIO&#xA;    ,T.ID_PRODUCTO&#xA;    ,T.ID_SUBPRODUCTO&#xA;    ,CONVERT(VARCHAR(6), RIGHT('00' + CONVERT(VARCHAR, T.ID_PRODUCTO), 2) + RIGHT('0000' + CONVERT(VARCHAR, T.ID_SUBPRODUCTO), 4)) AS ID_PROD_SUBP&#xA;    ,T.ID_TIEMPO_ENTREGA&#xA;    ,T.NUMERO_GUIA&#xA;    ,T.ID_RUTA&#xA;    ,ISNULL(T.ID_GRUPO_RED, -888) AS ID_GRUPO_RED&#xA;    ,ISNULL(T.TIEMPO_PROMESA_H, 0) AS TIEMPO_PROMESA_H&#xA;    ,ISNULL(T.TIEMPO_OFERTA, 0) AS TIEMPO_OFERTA&#xA;    ,ISNULL(T.TIEMPO_PROMESA_CUMPLE_H, 'NO') AS TIEMPO_PROMESA_CUMPLE_H&#xA;    ,CONVERT(VARCHAR, G.ID_REGIONAL) + '-' + CONVERT(VARCHAR, T.ID_CONCEPTO) AS ID_GEOGRAFIA_CONCEPTO&#xA;    ,T.HORAS_ND&#xA;    ,T.ID_ESTADO_ND&#xA;    ,ISNULL(T.GR_ID_TIPO_COBRO, -888) AS GR_ID_TIPO_COBRO&#xA;    ,CONVERT(VARCHAR(2), IIF(T.SE_PROMESA_CUMPLE_ACIDA = 'NO DISPONIBLE', 'NO', ISNULL(T.SE_PROMESA_CUMPLE_ACIDA, 'NO'))) AS SE_PROMESA_CUMPLE_ACIDA&#xA;    ,CONVERT(VARCHAR(2), IIF(T.SE_PROMESA_CUMPLE_DEPURADA = 'NO DISPONIBLE', 'NO', ISNULL(T.SE_PROMESA_CUMPLE_DEPURADA, 'NO'))) AS SE_PROMESA_CUMPLE_DEPURADA&#xA;    ,T.SE_RESPONSABLE_ID&#xA;FROM &quot; + @[User::TBL_TMP_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2] + &quot; T&#xA;LEFT JOIN &quot; + @[User::CONN_SIG_COLOMBIA_DW] + &quot;.&quot; + @[User::TBL_DIM_GEOGRAFIA] + &quot; G&#xA;  ON T.ID_CIUDAD_DESTINO = G.ID_CIUDAD;&quot;"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="SQL_SELECT_Fac_guias_entreg_teimpo_promesa_red_operativa_v2">
      <DTS:VariableValue
        DTS:DataType="8">SELECT
     T.TIME_ID
    ,T.FECHA
    ,T.DIA
    ,T.MES
    ,T.AÑO
    ,T.ID_CIUDAD_ORIGEN
    ,T.ID_CIUDAD_DESTINO
    ,T.ID_CLIENTE
    ,T.ID_ESTADOENVIO
    ,T.ID_PRODUCTO
    ,T.ID_SUBPRODUCTO
    ,CONVERT(VARCHAR(6), RIGHT('00' + CONVERT(VARCHAR, T.ID_PRODUCTO), 2) + RIGHT('0000' + CONVERT(VARCHAR, T.ID_SUBPRODUCTO), 4)) AS ID_PROD_SUBP
    ,T.ID_TIEMPO_ENTREGA
    ,T.NUMERO_GUIA
    ,T.ID_RUTA
    ,ISNULL(T.ID_GRUPO_RED, -888) AS ID_GRUPO_RED
    ,ISNULL(T.TIEMPO_PROMESA_H, 0) AS TIEMPO_PROMESA_H
    ,ISNULL(T.TIEMPO_OFERTA, 0) AS TIEMPO_OFERTA
    ,ISNULL(T.TIEMPO_PROMESA_CUMPLE_H, 'NO') AS TIEMPO_PROMESA_CUMPLE_H
    ,CONVERT(VARCHAR, G.ID_REGIONAL) + '-' + CONVERT(VARCHAR, T.ID_CONCEPTO) AS ID_GEOGRAFIA_CONCEPTO
    ,T.HORAS_ND
    ,T.ID_ESTADO_ND
    ,ISNULL(T.GR_ID_TIPO_COBRO, -888) AS GR_ID_TIPO_COBRO
    ,CONVERT(VARCHAR(2), IIF(T.SE_PROMESA_CUMPLE_ACIDA = 'NO DISPONIBLE', 'NO', ISNULL(T.SE_PROMESA_CUMPLE_ACIDA, 'NO'))) AS SE_PROMESA_CUMPLE_ACIDA
    ,CONVERT(VARCHAR(2), IIF(T.SE_PROMESA_CUMPLE_DEPURADA = 'NO DISPONIBLE', 'NO', ISNULL(T.SE_PROMESA_CUMPLE_DEPURADA, 'NO'))) AS SE_PROMESA_CUMPLE_DEPURADA
    ,T.SE_RESPONSABLE_ID
FROM TMP.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2 T
LEFT JOIN SIG_COLOMBIA_DW.DIM.GEOGRAFIA G
  ON T.ID_CIUDAD_DESTINO = G.ID_CIUDAD;</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{0BF92155-AEDF-4A97-BC9C-0A50D0172F8A}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot;IF OBJECT_ID('tempdb..#FECHA_ENTREGA_PRIMGEST') IS NOT NULL DROP TABLE #FECHA_ENTREGA_PRIMGEST;&#xA;&#xA;SELECT&#xA;    DATEADD(ms,-3, DATEADD(dd, DATEDIFF(dd, 0, SE_ID_FECHA_PRIMGEST), 1)) AS SE_ID_FECHA_PRIMGEST,&#xA;    TIEMPO_OFERTA,&#xA;    &quot; + @[User::CONN_SIG_COLOMBIA_DW] + &quot;.&quot; + @[User::FUNC_LOG_UFN_COUNT_HORA_RANGE] + &quot;(&#xA;        DATEADD(ms,-3, DATEADD(dd, DATEDIFF(dd, 0, SE_ID_FECHA_PRIMGEST), 1)),&#xA;        TIEMPO_OFERTA,&#xA;        'DIA DOMINICAL,DIA FESTIVO'&#xA;    ) AS ID_FECHA_PROMESA_ENTREGA&#xA;INTO #FECHA_ENTREGA_PRIMGEST&#xA;FROM &quot; + @[User::CONN_SIG_COL_LOGISTICA_DW] + &quot;.&quot; + @[User::TBL_TMP_CUMPLIMIENTO_AC_DEP] + &quot; WITH (NOLOCK)&#xA;GROUP BY DATEADD(ms,-3, DATEADD(dd, DATEDIFF(dd, 0, SE_ID_FECHA_PRIMGEST), 1)), TIEMPO_OFERTA;&#xA;&#xA;UPDATE TMP&#xA;SET&#xA;    TMP.SE_ID_FECHA_PROMESA_ENTREGA = PRM.ID_FECHA_PROMESA_ENTREGA,&#xA;    TMP.SE_FECHA_PROMESA_ENTREGA    = CONVERT(varchar(50), CONVERT(date, PRM.ID_FECHA_PROMESA_ENTREGA))&#xA;FROM &quot; + @[User::TBL_TMP_CUMPLIMIENTO_AC_DEP] + &quot; AS TMP&#xA;INNER JOIN #FECHA_ENTREGA_PRIMGEST AS PRM&#xA;  ON DATEADD(ms,-3, DATEADD(dd, DATEDIFF(dd, 0, TMP.SE_ID_FECHA_PRIMGEST), 1)) = PRM.SE_ID_FECHA_PRIMGEST&#xA; AND TMP.TIEMPO_OFERTA = PRM.TIEMPO_OFERTA;&#xA;&#xA;DROP TABLE IF EXISTS #FECHA_ENTREGA_PRIMGEST;&quot;"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="SQL_SELECT_Fecha_entrega_promesa">
      <DTS:VariableValue
        DTS:DataType="8">IF OBJECT_ID('tempdb..#FECHA_ENTREGA_PRIMGEST') IS NOT NULL DROP TABLE #FECHA_ENTREGA_PRIMGEST;

SELECT
    DATEADD(ms,-3, DATEADD(dd, DATEDIFF(dd, 0, SE_ID_FECHA_PRIMGEST), 1)) AS SE_ID_FECHA_PRIMGEST,
    TIEMPO_OFERTA,
    SIG_COLOMBIA_DW.LOG.UFN_COUNT_HORA_RANGE(
        DATEADD(ms,-3, DATEADD(dd, DATEDIFF(dd, 0, SE_ID_FECHA_PRIMGEST), 1)),
        TIEMPO_OFERTA,
        'DIA DOMINICAL,DIA FESTIVO'
    ) AS ID_FECHA_PROMESA_ENTREGA
INTO #FECHA_ENTREGA_PRIMGEST
FROM SIG_COL_LOGISTICA_DW.TMP.MPCCO_CUMPLIMIENTO_AC_DEP WITH (NOLOCK)
GROUP BY DATEADD(ms,-3, DATEADD(dd, DATEDIFF(dd, 0, SE_ID_FECHA_PRIMGEST), 1)), TIEMPO_OFERTA;

UPDATE TMP
SET
    TMP.SE_ID_FECHA_PROMESA_ENTREGA = PRM.ID_FECHA_PROMESA_ENTREGA,
    TMP.SE_FECHA_PROMESA_ENTREGA    = CONVERT(varchar(50), CONVERT(date, PRM.ID_FECHA_PROMESA_ENTREGA))
FROM TMP.MPCCO_CUMPLIMIENTO_AC_DEP AS TMP
INNER JOIN #FECHA_ENTREGA_PRIMGEST AS PRM
  ON DATEADD(ms,-3, DATEADD(dd, DATEDIFF(dd, 0, TMP.SE_ID_FECHA_PRIMGEST), 1)) = PRM.SE_ID_FECHA_PRIMGEST
 AND TMP.TIEMPO_OFERTA = PRM.TIEMPO_OFERTA;

DROP TABLE IF EXISTS #FECHA_ENTREGA_PRIMGEST;</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{86CA6635-5018-4F58-94F4-5A57E6C49775}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot;SELECT &#xA;  CMD.NOMBRE_REGIONAL AS [NOMBRE_REGIONAL],&#xA;  CMD.NOMBRE_CPL      AS [NOMBRE_CPL],&#xA;  T.YEAR              AS [AÑO],&#xA;  T.MONTH             AS [MES_DEL_AÑO],&#xA;  T.DAY_OF_MONTH      AS [DIA],&#xA;  SM.NOMBRE_UEN       AS [NOMBRE_UEN],&#xA;  CONVERT(varchar(12),CAST(100.0 * SUM(CASE WHEN GRO.SE_PROMESA_CUMPLE_ACIDA = 'SI' THEN 1 ELSE 0 END)/NULLIF(COUNT_BIG(*), 0) AS decimal(6,2))) + '%' AS 'RED_OPE_GUIAS_CUMPLIENDO_ACIDA',&#xA;  CONVERT(varchar(12),CAST(100.0 * SUM(CASE WHEN GRO.SE_PROMESA_CUMPLE_DEPURADA = 'SI' THEN 1 ELSE 0 END)/NULLIF(COUNT_BIG(*), 0) AS decimal(6,2))) + '%' AS 'RED_OPE_GUIAS_CUMPLIENDO_DEPURADA',&#xA;  COUNT(DISTINCT GRO.NUMERO_GUIA) AS [CANTIDAD_GUIAS_TPROM_RED_V2],&#xA;  GETDATE() AS [FECHA_INGESTA]&#xA;FROM &quot; + @[User::TBL_FAC_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2] + &quot; AS GRO&#xA;INNER JOIN &quot; + @[User::TBL_DIM_CIUDADES_MOVIMIENTOS_DESTINO_MOVILIZADOS] + &quot; AS CMD&#xA;  ON GRO.ID_CIUDAD_DESTINO = CMD.ID_CIUDAD&#xA;INNER JOIN &quot; + @[User::TBL_DIM_TIEMPO] + &quot; AS T&#xA;  ON GRO.TIME_ID = T.TIME_ID&#xA;INNER JOIN &quot; + @[User::TBL_DIM_SUBPRODUCTOS_MOVIMIENTO] + &quot; AS SM&#xA;  ON GRO.ID_PRODUCTO = SM.ID_PRODUCTO AND GRO.ID_SUBPRODUCTO = SM.ID_SUBPRODUCTO&#xA;INNER JOIN &quot; + @[User::TBL_DIM_ESTADOS_ENVIO] + &quot; AS EE&#xA;  ON EE.ID_ESTADO_ENVIO = GRO.ID_ESTADOENVIO&#xA;WHERE T.[DATE] &gt;= '&quot; + @[User::VAL_fechaIni] + &quot;'&#xA;  AND EE.ID_ESTADO_ENVIO IN (3,4,5)&#xA;GROUP BY CMD.NOMBRE_REGIONAL, CMD.NOMBRE_CPL, T.YEAR, T.MONTH, T.DAY_OF_MONTH, SM.NOMBRE_UEN&quot;"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="SQL_SELECT_Mpcco_gtp2_guias_entreg_tiempo_promesa_red_operativa_v2">
      <DTS:VariableValue
        DTS:DataType="8">SELECT 
  CMD.NOMBRE_REGIONAL AS [NOMBRE_REGIONAL],
  CMD.NOMBRE_CPL      AS [NOMBRE_CPL],
  T.YEAR              AS [AÑO],
  T.MONTH             AS [MES_DEL_AÑO],
  T.DAY_OF_MONTH      AS [DIA],
  SM.NOMBRE_UEN       AS [NOMBRE_UEN],
  CONVERT(varchar(12),CAST(100.0 * SUM(CASE WHEN GRO.SE_PROMESA_CUMPLE_ACIDA = 'SI' THEN 1 ELSE 0 END)/NULLIF(COUNT_BIG(*), 0) AS decimal(6,2))) + '%' AS 'RED_OPE_GUIAS_CUMPLIENDO_ACIDA',
  CONVERT(varchar(12),CAST(100.0 * SUM(CASE WHEN GRO.SE_PROMESA_CUMPLE_DEPURADA = 'SI' THEN 1 ELSE 0 END)/NULLIF(COUNT_BIG(*), 0) AS decimal(6,2))) + '%' AS 'RED_OPE_GUIAS_CUMPLIENDO_DEPURADA',
  COUNT(DISTINCT GRO.NUMERO_GUIA) AS [CANTIDAD_GUIAS_TPROM_RED_V2],
  GETDATE() AS [FECHA_INGESTA]
FROM FAC.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2 AS GRO
INNER JOIN DIM.CIUDADES_MOVIMIENTOS_DESTINO_MOVILIZADOS AS CMD
  ON GRO.ID_CIUDAD_DESTINO = CMD.ID_CIUDAD
INNER JOIN DIM.TIEMPO AS T
  ON GRO.TIME_ID = T.TIME_ID
INNER JOIN DIM.SUBPRODUCTOS_MOVIMIENTO AS SM
  ON GRO.ID_PRODUCTO = SM.ID_PRODUCTO AND GRO.ID_SUBPRODUCTO = SM.ID_SUBPRODUCTO
INNER JOIN DIM.ESTADOS_ENVIO AS EE
  ON EE.ID_ESTADO_ENVIO = GRO.ID_ESTADOENVIO
WHERE T.[DATE] &gt;= '2026-02-08'
  AND EE.ID_ESTADO_ENVIO IN (3,4,5)
GROUP BY CMD.NOMBRE_REGIONAL, CMD.NOMBRE_CPL, T.YEAR, T.MONTH, T.DAY_OF_MONTH, SM.NOMBRE_UEN</DTS:VariableValue>
    </DTS:Variable>
