                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT *
FROM (
    SELECT 
        ROW_NUMBER() OVER(PARTITION BY CONSECUT_MOVIMI, NUMERO_MOVIMI ORDER BY FECHA_HORA_MOVIMIENTO DESC) AS R,
        ID_PROCESO,
        CONSECUT_MOVIMI,
        NUMERO_MOVIMI,
        PLACA_VEHICULO_DOCU,
        ID_PAIS_DESTINO,
        ID_CIUDAD_DESTINO
    FROM TMP.MPCCO_PROMESA_ND02_01_V2 WITH (NOLOCK)
) T
WHERE T.R = 1;</property>
