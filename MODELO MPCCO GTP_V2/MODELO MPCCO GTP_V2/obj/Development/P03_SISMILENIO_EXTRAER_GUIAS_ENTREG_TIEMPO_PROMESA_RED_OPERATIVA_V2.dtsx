    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{46DC863F-65DA-471B-A1A5-FFA0EBC4914D}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot;UPDATE A&#xA;SET A.FECHA_VIGENTE = RA.FECHA_VIGENTE&#xA;FROM &quot; + @[User::TBL_TMP_PROMESA_V2] + &quot; A&#xA;INNER JOIN &quot; + @[User::TBL_TMP_PROMESA_FECHA_V2] + &quot; RA&#xA;  ON CONVERT(DATETIME,CONVERT(DATE,A.FECHA)) = RA.FECHA_ENVIO&#xA;WHERE A.ID_TIEMPO_ENTREGA = 3;&quot;"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="SQL_UPDATE_Actualizar_fecha_envio">
      <DTS:VariableValue
        DTS:DataType="8">UPDATE A
SET A.FECHA_VIGENTE = RA.FECHA_VIGENTE
FROM TMP.MPCCO_PROMESA_V2 A
INNER JOIN TMP.MPCCO_PROMESA_FECHA_V2 RA
  ON CONVERT(DATETIME,CONVERT(DATE,A.FECHA)) = RA.FECHA_ENVIO
WHERE A.ID_TIEMPO_ENTREGA = 3;</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{A9158228-E8F7-449B-ABFD-31A5F6678163}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot;WITH CTE (&#xA;  ID,&#xA;  G_NUMERO_GUIA,&#xA;  SE_DESC_PROC_DEPU,&#xA;  SE_DESC_CONC_DEPU,&#xA;  SE_DEPURADO_RESP&#xA;) AS (&#xA;  SELECT&#xA;      ROW_NUMBER() OVER (PARTITION BY G_NUMERO_GUIA ORDER BY FECHA_HORA_MOVIMIENTO) AS ID,&#xA;      G_NUMERO_GUIA,&#xA;      SE_DESC_PROC_DEPU,&#xA;      SE_DESC_CONC_DEPU,&#xA;      SE_DEPURADO_RESP&#xA;  FROM &quot; + @[User::TBL_TMP_CUMPLIMIENTO_AC_DEP_04] + &quot; AS C WITH (NOLOCK)&#xA;)&#xA;UPDATE C&#xA;SET&#xA;    C.SE_PROMESA_CUMPLE_DEPURADA = CASE WHEN CTE.SE_DEPURADO_RESP IN ('E','C') THEN 'SI' ELSE C.SE_PROMESA_CUMPLE_DEPURADA END,&#xA;    --C.SE_DESC_PROC_DEPU = CTE.SE_DESC_PROC_DEPU,&#xA;    --C.SE_DESC_CONC_DEPU = CTE.SE_DESC_CONC_DEPU,&#xA;    C.SE_RESPONSABLE_ID = ISNULL(CTE.SE_DEPURADO_RESP, 'NO APLICA')&#xA;FROM &quot; + @[User::TBL_TMP_CUMPLIMIENTO_AC_DEP] + &quot; AS C&#xA;INNER JOIN CTE&#xA;  ON C.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA&#xA;WHERE CTE.ID = 1;&quot;"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="SQL_UPDATE_Calcular_cumplimiento_depurada">
      <DTS:VariableValue
        DTS:DataType="8">WITH CTE (
  ID,
  G_NUMERO_GUIA,
  SE_DESC_PROC_DEPU,
  SE_DESC_CONC_DEPU,
  SE_DEPURADO_RESP
) AS (
  SELECT
      ROW_NUMBER() OVER (PARTITION BY G_NUMERO_GUIA ORDER BY FECHA_HORA_MOVIMIENTO) AS ID,
      G_NUMERO_GUIA,
      SE_DESC_PROC_DEPU,
      SE_DESC_CONC_DEPU,
      SE_DEPURADO_RESP
  FROM TMP.MPCCO_CUMPLIMIENTO_AC_DEP_04 AS C WITH (NOLOCK)
)
UPDATE C
SET
    C.SE_PROMESA_CUMPLE_DEPURADA = CASE WHEN CTE.SE_DEPURADO_RESP IN ('E','C') THEN 'SI' ELSE C.SE_PROMESA_CUMPLE_DEPURADA END,
    --C.SE_DESC_PROC_DEPU = CTE.SE_DESC_PROC_DEPU,
    --C.SE_DESC_CONC_DEPU = CTE.SE_DESC_CONC_DEPU,
    C.SE_RESPONSABLE_ID = ISNULL(CTE.SE_DEPURADO_RESP, 'NO APLICA')
FROM TMP.MPCCO_CUMPLIMIENTO_AC_DEP AS C
INNER JOIN CTE
  ON C.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA
WHERE CTE.ID = 1;</DTS:VariableValue>
    </DTS:Variable>
