                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT
      CONVERT(NUMERIC, CONVERT(DATETIME, CONVERT(CHAR(11), EV.FECHA_ENVIO))) AS TIMEID,
      --CONVERT(DATETIME, CONVERT(CHAR(11), EV.FECHA_ENVIO)) AS FECHA,-------------------------------------------------------------&gt;&gt;&gt;&gt; mod fecha datetime
      EV.FECHA_ENVIO AS FECHA,
      DAY(EV.FECHA_ENVIO)   AS DIA,
      MONTH(EV.FECHA_ENVIO) AS MES,
      YEAR(EV.FECHA_ENVIO)  AS AÑO,
      EV.ID_CIUDAD_ORIGEN,
      EV.ID_CIUDAD_DESTINO,
      EV.ID_ESTADOENVIO,
      EV.ID_PROCESO,
      EV.ID_PRODUCTO,
      EV.ID_SUBPRODUCTO,
      EV.ID_CLIENTE,
      0 AS ID_CONCEPTO,
      EV.ID_TIEMPO_ENTREGA,
      EV.ID_MEDTRANS,
      EV.NUMERO_GUIA,
      AC.SE_PROMESA_CUMPLE_ACIDA,
      AC.SE_PROMESA_CUMPLE_DEPURADA,
      CASE AC.SE_RESPONSABLE_ID WHEN 'NO DISPONIBLE' THEN 'NO APLICA' ELSE AC.SE_RESPONSABLE_ID END AS SE_RESPONSABLE_ID,
      AC.GR_ID_TIPO_COBRO,
      AC.ID_RUTA,
      AC.ID_GRUPO_RED,
      AC.TIEMPO_OFERTA,
      AC.TIEMPO_PROMESA_H,
      AC.TIEMPO_PROMESA_CUMPLE_H,
      AC.SE_FECHA_PROMESA_ENTREGA,
      EV.[ULT_MOV_FECHA_HORA_MOVIMIENTO],
      EV.[ULT_MOV_ID_PROCESO],
      EV.[ULT_MOV_NUMERO_MOVIMI],
      EV.[ULT_MOV_CONSECUT_MOVIMI] 
FROM SIG_COL_LOGISTICA_DW.TMP.MPCCO_ENVIOS_MOV EV WITH (NOLOCK)
INNER JOIN TMP.MPCCO_CUMPLIMIENTO_AC_DEP AC WITH (NOLOCK)
  ON AC.G_NUMERO_GUIA = EV.NUMERO_GUIA</property>
