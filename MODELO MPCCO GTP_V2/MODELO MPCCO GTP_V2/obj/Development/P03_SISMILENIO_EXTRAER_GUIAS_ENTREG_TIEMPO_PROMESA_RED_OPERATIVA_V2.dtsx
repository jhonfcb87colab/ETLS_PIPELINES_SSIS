    <DTS:Executable
      DTS:refId="Package\SQL_DELETE_Tres_meses_facs"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{C9F20CD9-6C74-4623-B501-EC1F6549E510}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL_DELETE_Tres_meses_facs"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{94C855A8-E2EA-4CF8-9340-DC0E1AB28830}"
          SQLTask:SqlStatementSource="DELETE FROM FAC.MPCCO_GTP2_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2&#xA;WHERE CAST(&#xA;        CAST(AÑO AS VARCHAR(4)) + '-' +&#xA;        CASE UPPER(MES_DEL_AÑO)&#xA;          WHEN 'ENERO'      THEN '01'&#xA;          WHEN 'FEBRERO'    THEN '02'&#xA;          WHEN 'MARZO'      THEN '03'&#xA;          WHEN 'ABRIL'      THEN '04'&#xA;          WHEN 'MAYO'       THEN '05'&#xA;          WHEN 'JUNIO'      THEN '06'&#xA;          WHEN 'JULIO'      THEN '07'&#xA;          WHEN 'AGOSTO'     THEN '08'&#xA;          WHEN 'SEPTIEMBRE' THEN '09'&#xA;          WHEN 'OCTUBRE'    THEN '10'&#xA;          WHEN 'NOVIEMBRE'  THEN '11'&#xA;          WHEN 'DICIEMBRE'  THEN '12'&#xA;        END + '-' +&#xA;        RIGHT('0' + CAST(DIA AS VARCHAR(2)), 2)&#xA;     AS DATE&#xA;    ) &lt; DATEADD(MONTH, -3, DATEADD(MONTH, DATEDIFF(MONTH,0,GETDATE()), 0));&#xA;&#xA;DELETE FROM FAC.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2&#xA;WHERE FECHA &lt; DATEADD(MONTH, -3, DATEADD(MONTH, DATEDIFF(MONTH,0,GETDATE()), 0));" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
