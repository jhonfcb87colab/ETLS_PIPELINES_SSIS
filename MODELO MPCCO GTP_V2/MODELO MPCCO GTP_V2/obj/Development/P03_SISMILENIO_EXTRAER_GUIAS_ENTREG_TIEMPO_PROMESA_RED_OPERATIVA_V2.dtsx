                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT *
FROM (
    SELECT
        ROW_NUMBER() OVER (PARTITION BY [NUMERO_GUIA] ORDER BY [FECHA_HORA_MOVIMIENTO] DESC) AS ID,
        [NUMERO_GUIA],
        [FECHA_HORA_MOVIMIENTO],
        [ID_PROCESO],
        [CONSECUT_MOVIMI],
        [NUMERO_MOVIMI],
        [PLACA_VEHICULO_DOCU],
        [ID_PAIS_DESTINO],
        [ID_CIUDAD_DESTINO],
        [HORA_CONTROL_MAXIMO_LLEGADA],
        NULL AS [FECHA_HORA_ENTRADA_CIL]
    FROM TMP.MPCCO_PROMESA_ND03_02_V2 WITH (NOLOCK)
) T
WHERE T.ID = 1;</property>
