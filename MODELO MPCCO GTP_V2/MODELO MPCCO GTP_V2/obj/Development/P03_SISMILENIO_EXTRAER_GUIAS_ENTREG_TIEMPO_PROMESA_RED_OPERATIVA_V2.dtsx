                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">WITH CTE (ID,[ID_PAIS],[ID_CIUDAD],[HORA_CONTROL_MAXIMO_LLEGADA]) AS (
    SELECT
        ROW_NUMBER() OVER (PARTITION BY [ID_PAIS], [ID_CIUDAD] ORDER BY [HORA_CONTROL_MAXIMO_LLEGADA] DESC) AS ID,
        [ID_PAIS],
        [ID_CIUDAD],
        [HORA_CONTROL_MAXIMO_LLEGADA]
    FROM PAR.CENTROS_LOGISTICOS WITH (NOLOCK)
    WHERE [HORA_CONTROL_MAXIMO_LLEGADA] &gt; '00:00:00'
)
SELECT
    [ID_PAIS],
    [ID_CIUDAD],
    [HORA_CONTROL_MAXIMO_LLEGADA]
FROM CTE
WHERE ID = 1;</property>
