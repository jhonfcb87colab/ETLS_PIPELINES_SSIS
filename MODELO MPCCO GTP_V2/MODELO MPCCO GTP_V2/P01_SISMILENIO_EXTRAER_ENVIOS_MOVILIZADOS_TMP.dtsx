                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">WITH EV AS (
  SELECT DISTINCT NUMERO_GUIA
  FROM SIG_COL_LOGISTICA_DW.TMP.ENVIOS_MOV
)
SELECT
  EV.NUMERO_GUIA,
  MAX(I.DocumentRetailTypeId) AS ID_TIPO_FORMATO_IMPRESION
FROM EV
JOIN SIG_COLOMBIA_DW.RTW.GUIDE         AS G  ON G.NUMBER = EV.NUMERO_GUIA
JOIN SIG_COLOMBIA_DW.RTW.InvoiceDetail AS D  ON D.Id     = G.InvoiceDetailId
JOIN SIG_COLOMBIA_DW.RTW.Invoice       AS I  ON I.Id     = D.InvoiceId
WHERE I.DocumentRetailTypeId IS NOT NULL
GROUP BY EV.NUMERO_GUIA;</property>
                    <property
                      dataType="System.String"
                      description="The variable that contains the SQL command to be executed."
                      name="SqlCommandVariable">User::SQL_SELECT_Datos_Reatil</property>
