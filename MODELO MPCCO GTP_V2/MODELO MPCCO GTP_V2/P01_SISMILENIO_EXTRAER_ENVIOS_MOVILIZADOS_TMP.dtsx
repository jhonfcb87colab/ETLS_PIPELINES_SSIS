      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{94C855A8-E2EA-4CF8-9340-DC0E1AB28830}"
          SQLTask:SqlStatementSource="TRUNCATE TABLE DIM.MPCCO_RED_OPERATIVA_RUTA_V2&#xA;&#xA;;WITH CTE_RED_OPE AS(&#xA;SELECT &#xA;ROW_NUMBER() OVER(PARTITION BY ID_CIUDAD_ORIGEN&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;,ID_CIUDAD_DESTINO&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;,ID_TIEMPO&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;,ID_MEDTRANS ORDER BY ID_RUTA DESC) #ROW_ID&#xA;,ID_RUTA&#xA;,ID_CIUDAD_ORIGEN&#xA;,ID_CIUDAD_DESTINO&#xA;,ID_TIEMPO&#xA;,ID_MEDTRANS&#xA;FROM DIM.RED_OPERATIVA_RUTA RED&#xA;WHERE ID_RUTA&gt;0&#xA;AND ID_ESTADO_RUTA=1&#xA;)&#xA;INSERT INTO DIM.MPCCO_RED_OPERATIVA_RUTA_V2&#xA;SELECT &#xA;ID_RUTA&#xA;,ID_CIUDAD_ORIGEN&#xA;,ID_CIUDAD_DESTINO&#xA;,ID_TIEMPO&#xA;,ID_MEDTRANS&#xA;FROM CTE_RED_OPE WHERE #ROW_ID=1&#xA;&#xA;&#xA;&#xA;-----" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
