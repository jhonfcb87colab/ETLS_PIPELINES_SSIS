      <DTS:Variables />
      <DTS:ObjectData>
        <pipeline
          version="1">
          <components>
            <component
              refId="Package\Transformacion Guias Validas\SQL_SELECT_Guias_Validas"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
              description="OLE DB Source"
              name="SQL_SELECT_Guias_Validas"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">WITH m AS (
    SELECT  
        MIN(FECHA_HORA_MOVIMIENTO) AS FECHA,
        ID_PAIS_ORIGEN,
        ID_CIUDAD_ORIGEN,
        ID_PAIS_DESTINO,
        ID_CIUDAD_DESTINO,
        ID_TIPOGUIA,
        ID_CLIENTE,
        ID_ESTADOENVIO,
        ID_DOCU_ULT_MOVI,
        ID_MEDTRANS,
        ID_PRODUCTO,
        ID_SUBPRODUCTO,
        ID_ESTADOGUIA,
        ID_TIEMPO_ENTREGA,
        ID_REQ_EMBALAJE,
        NUMERO_GUIA,
        NUMERO_PIEZAS,
        ID_PROCESO,
        FECHA_ENTREGA,
        FECHA_MODIFICACION,
        ULT_MOV_FECHA_HORA_MOVIMIENTO,
        ULT_MOV_ID_PROCESO,
        ULT_MOV_NUMERO_MOVIMI,
        ULT_MOV_CONSECUT_MOVIMI
    FROM TMP.MPCCO_ENVIOS_MOV_SOURCE WITH (NOLOCK)
    WHERE (
            (LEFT(NUMERO_GUIA, 1) IN ('1','2','5','7','9') AND LEN(NUMERO_GUIA) &gt;= 9)
         OR (LEFT(NUMERO_GUIA, 1) IN ('3','4')       AND LEN(NUMERO_GUIA) &gt;= 8)
          )
      --AND NUMERO_GUIA = 9186758720   -- filtro de prueba
    GROUP BY 
        ID_PAIS_ORIGEN,
        ID_CIUDAD_ORIGEN,
        ID_PAIS_DESTINO,
        ID_CIUDAD_DESTINO,
        ID_TIPOGUIA,
        ID_CLIENTE,
        ID_ESTADOENVIO,
        ID_DOCU_ULT_MOVI,
        ID_MEDTRANS,
        ID_PRODUCTO,
        ID_SUBPRODUCTO,
        ID_ESTADOGUIA,
        ID_TIEMPO_ENTREGA,
        ID_REQ_EMBALAJE,
        NUMERO_GUIA,
        NUMERO_PIEZAS,
        ID_PROCESO,
        FECHA_ENTREGA,
        FECHA_MODIFICACION,
        ULT_MOV_FECHA_HORA_MOVIMIENTO,
        ULT_MOV_ID_PROCESO,
        ULT_MOV_NUMERO_MOVIMI,
        ULT_MOV_CONSECUT_MOVIMI
)

SELECT DISTINCT
        m.FECHA,
        m.ID_PAIS_ORIGEN,
        m.ID_CIUDAD_ORIGEN,
        m.ID_PAIS_DESTINO,
        m.ID_CIUDAD_DESTINO,
        m.ID_TIPOGUIA,
        m.ID_CLIENTE,
        m.ID_ESTADOENVIO,
        m.ID_DOCU_ULT_MOVI,
        m.ID_MEDTRANS,
        m.ID_PRODUCTO,
        m.ID_SUBPRODUCTO,
        m.ID_ESTADOGUIA,
        m.ID_TIEMPO_ENTREGA,
        m.ID_REQ_EMBALAJE,
        m.NUMERO_GUIA,
        m.NUMERO_PIEZAS,
        m.ID_PROCESO,
        m.FECHA_ENTREGA,
        m.FECHA_MODIFICACION,
        m.ULT_MOV_FECHA_HORA_MOVIMIENTO,
        m.ULT_MOV_ID_PROCESO,
        m.ULT_MOV_NUMERO_MOVIMI,
        m.ULT_MOV_CONSECUT_MOVIMI
FROM m
WHERE m.NUMERO_GUIA IS NOT NULL

/* 1️ Excluir SOLO si ya fue SI
      y NO existe un movimiento más reciente o cambio de proceso */
AND NOT EXISTS (
    SELECT 1
    FROM SIG_COL_LOGISTICA_DW.FAC.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2 f_si
    WHERE f_si.NUMERO_GUIA = m.NUMERO_GUIA
      AND f_si.SE_PROMESA_CUMPLE_DEPURADA = 'SI'
      AND (
            f_si.ULT_MOV_FECHA_HORA_MOVIMIENTO &gt;=  m.ULT_MOV_FECHA_HORA_MOVIMIENTO
        AND f_si.ULT_MOV_ID_PROCESO = m.ULT_MOV_ID_PROCESO
          )
)

/* 2️ Excluir si fue NO recientemente */
AND NOT EXISTS (
    SELECT 1
    FROM SIG_COL_LOGISTICA_DW.FAC.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2 f_no
    WHERE f_no.NUMERO_GUIA = m.NUMERO_GUIA
      AND f_no.SE_PROMESA_CUMPLE_DEPURADA = 'NO'
      AND f_no.FECHA_MODIFICACION_DW &gt;= DATEADD(HOUR, -8, GETDATE())
);</property>
