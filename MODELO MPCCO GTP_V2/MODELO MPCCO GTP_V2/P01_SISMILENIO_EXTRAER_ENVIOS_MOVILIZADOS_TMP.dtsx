    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{73A5F31F-EFDB-448A-A786-BEBBBD6EA096}"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="VAL_guiasValidas_Guias_Validas">
      <DTS:VariableValue
