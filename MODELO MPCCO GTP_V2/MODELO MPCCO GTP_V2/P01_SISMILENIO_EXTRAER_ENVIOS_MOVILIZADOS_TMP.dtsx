    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{21961C2E-F305-4FBF-9358-B15FE79B072B}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot;TRUNCATE TABLE &quot;+ @[User::TBL_TMP_GUIAMA_ENV_MOV_TIPO_GUIA_IMPRESION] +&quot;:&quot;"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="SQL_TRUNCATE_Guiama">
      <DTS:VariableValue
        DTS:DataType="8">TRUNCATE TABLE TMP.MPCCO_GUIAMA_ENV_MOV_TIPO_GUIA_IMPRESION:</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{C30EDAA4-C5A3-4375-8D5F-0014877F97F2}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot;/*&#xA;--+-----------------------------------------------------------------------+&#xA;Modificación:&#x9;2025/08/26&#xA;Autor:&#x9;&#x9;Ditech - Joan Sebastian Castiblanco Cuvides&#xA;Descripción:&#xA;&#x9;&#x9;-- Actualiza ENVIOS_MOV con el mayor ID_TIPO_FORMATO_IMPRESION por NUMERO_GUIA,&#xA;&#x9;&#x9;-- usando MAX() en lugar de ROW_NUMBER() para simplificar y optimizar el rendimiento.&#xA;&#x9;&#x9;-- Si no hay coincidencia, se asigna el valor -888 por defecto.&#xA;--+-----------------------------------------------------------------------+&#xA;*/&#xA;&#xA;UPDATE T&#xA;SET T.ID_TIPO_FORMATO_IMPRESION = ISNULL(S.ID_TIPO_FORMATO_IMPRESION, &quot;+ @[User::VAL_idTipoFormatoImpresionDefault_Update_Id_Tipo_Guia] +&quot;)&#xA;FROM TMP.ENVIOS_MOV AS T&#xA;LEFT JOIN (&#xA;    SELECT NUMERO_GUIA, MAX(ID_TIPO_FORMATO_IMPRESION) AS ID_TIPO_FORMATO_IMPRESION&#xA;    FROM  &quot;+ @[User::TBL_TMP_GUIAMA_ENV_MOV_TIPO_GUIA_IMPRESION] +&quot;&#xA;    GROUP BY NUMERO_GUIA&#xA;) AS S&#xA;  ON S.NUMERO_GUIA = T.NUMERO_GUIA&quot;"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="SQL_UPDATE_Actualizar_Id_Tipo_Guia_Formato_Impresion">
      <DTS:VariableValue
        DTS:DataType="8">/*
--+-----------------------------------------------------------------------+
Modificación:	2025/08/26
Autor:		Ditech - Joan Sebastian Castiblanco Cuvides
Descripción:
		-- Actualiza ENVIOS_MOV con el mayor ID_TIPO_FORMATO_IMPRESION por NUMERO_GUIA,
		-- usando MAX() en lugar de ROW_NUMBER() para simplificar y optimizar el rendimiento.
		-- Si no hay coincidencia, se asigna el valor -888 por defecto.
--+-----------------------------------------------------------------------+
*/

UPDATE T
SET T.ID_TIPO_FORMATO_IMPRESION = ISNULL(S.ID_TIPO_FORMATO_IMPRESION, -888)
FROM TMP.ENVIOS_MOV AS T
LEFT JOIN (
    SELECT NUMERO_GUIA, MAX(ID_TIPO_FORMATO_IMPRESION) AS ID_TIPO_FORMATO_IMPRESION
    FROM  TMP.MPCCO_GUIAMA_ENV_MOV_TIPO_GUIA_IMPRESION
    GROUP BY NUMERO_GUIA
) AS S
  ON S.NUMERO_GUIA = T.NUMERO_GUIA</DTS:VariableValue>
    </DTS:Variable>
