        <DTS:Executable
          DTS:refId="Package\CARGA INICIAL MOVILIZADOS Y ULT PROCESO\extraccion guias entrada y ult proceso"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{5CA36BA5-F4F3-49AB-AF5E-2DC63A609FA1}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="extraccion guias entrada y ult proceso"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{443A2D3D-8F05-4181-9D34-217D19C4DA82}"
              SQLTask:SqlStatementSource="DROP TABLE IF EXISTS #GUIAS_EVIOS_MOVILIZADOS_GETP;&#xA; &#xA;;WITH SEGUIMI_ENVIO AS (&#xA;    SELECT DISTINCT &#xA;&#x9;se.NUMERO_GUIA,&#xA;    SE.ID_PROCESO,&#xA;&#x9;SE.FECHA_HORA_MOVIMIENTO&#xA;&#x9;FROM MECE_LOGISTICO.DBO.SEGUIMIENTO_ENVIO se WITH (NOLOCK, INDEX(IX_FECHA_HORA_MOVIMIENTO_BI))&#xA;    WHERE se.FECHA_HORA_MOVIMIENTO &#x9;&#x9;&gt;=  ? AND &#xA;&#x9;&#x9;  se.FECHA_HORA_MOVIMIENTO &#x9;&lt;=  ? AND&#xA;&#x9;&#x9;  se.ID_PROCESO IN (5,6)&#xA;)&#xA;SELECT --CONVERT(NUMERIC,CONVERT(DATETIME,CONVERT(CHAR(11),GUIAS.FECHA_ENVIO)))AS TIMEID,&#xA;&#x9;&#x9;--GUIAS.FECHA_ENVIO, --AS FECHA, --CONVERT(DATETIME,CONVERT(CHAR(11),GUIAS.FECHA_ENVIO))AS FECHA,&#xA;&#x9;&#x9;SE_FECH.FECHA_HORA_MOVIMIENTO,&#xA;&#x9;&#x9;SE_FECH.ID_PROCESO,&#xA;&#x9;&#x9;GUIAS.ID_PAIS_ORIGEN, --ISNULL(GUIAS.ID_PAIS_ORIGEN,0) AS ID_PAIS_ORIGEN,&#xA;&#x9;&#x9;GUIAS.ID_CIUDAD_ORIGEN, --ISNULL(GUIAS.ID_CIUDAD_ORIGEN,0) AS ID_CIUDAD_ORIGEN,&#xA;&#x9;&#x9;GUIAS.ID_PAIS_DESTINO, --ISNULL(GUIAS.ID_PAIS_DESTINO,0) AS ID_PAIS_DESTINO,&#xA;&#x9;&#x9;GUIAS.ID_CIUDAD_DESTINO, --ISNULL(GUIAS.ID_CIUDAD_DESTINO,0) AS ID_CIUDAD_DESTINO,&#xA;&#x9;&#x9;GUIAS.ID_TIPOGUIA, --ISNULL(GUIAS.ID_TIPOGUIA,0) AS ID_TIPOGUIA,&#xA;&#x9;&#x9;GUIAS.ID_CLIENTE, --ISNULL(GUIAS.ID_CLIENTE,0) AS ID_CLIENTE,&#xA;&#x9;&#x9;GUIAS.ID_ESTADOENVIO, --ISNULL(GUIAS.ID_ESTADOENVIO,0) AS ID_ESTADOENVIO,&#xA;&#x9;&#x9;GUIAS.ID_DOCU_ULT_MOVI, --ISNULL(GUIAS.ID_DOCU_ULT_MOVI,0) AS   ID_PROCESO,&#xA;&#x9;&#x9;GUIAS.ID_MEDTRANS, --ISNULL(GUIAS.ID_MEDTRANS,0) AS ID_MEDTRANS,&#xA;&#x9;&#x9;GUIAS.ID_PRODUCTO, --ISNULL(GUIAS.ID_PRODUCTO,0) AS ID_PRODUCTO,&#xA;&#x9;&#x9;GUIAS.ID_SUBPRODUCTO, --ISNULL(GUIAS.ID_SUBPRODUCTO,0) AS ID_SUBPRODUCTO,&#xA;&#x9;&#x9;GUIAS.ID_ESTADOGUIA, --ISNULL(GUIAS.ID_ESTADOGUIA,0) AS ID_ESTADOGUIA,&#xA;&#x9;&#x9;GUIAS.ID_TIEMPO AS ID_TIEMPO_ENTREGA, --ISNULL(GUIAS.ID_TIEMPO,0) AS ID_TIEMPO_ENTREGA,&#xA;&#x9;&#x9;GUIAS.ID_REQUIERE_EMBALAJE AS ID_REQ_EMBALAJE, --ISNULL(GUIAS.ID_REQUIERE_EMBALAJE,0) AS ID_REQ_EMBALAJE,&#xA;&#x9;&#x9;GUIAS.NUMERO_GUIA, --COUNT(DISTINCT GUIAS.NUMERO_GUIA) AS CANTIDAD_GUIAS,&#xA;&#x9;&#x9;GUIAS.NUMERO_PIEZAS, --SUM(CASE WHEN ISNULL(GUIAS.NUMERO_PIEZAS,0) = 0 THEN 1 ELSE GUIAS.NUMERO_PIEZAS END) AS CANTIDAD_PIEZAS,&#xA;&#x9;&#x9;GUIAS.FECHA_ENTREGA, --ISNULL(DATEDIFF(MI,GUIAS.FECHA_ENTREGA,GUIAS.FECHA_MODIFICACION),0) AS TIEMPO_DIGITALIZACION,&#xA;&#x9;&#x9;GUIAS.FECHA_MODIFICACION&#xA;&#x9;&#x9;--ISNULL((DATEDIFF(HH,FECHA_ENVIO,FECHA_ENTREGA)),0) AS TIEMPO_PROMESA_H&#xA;&#x9;&#x9;INTO #GUIAS_EVIOS_MOVILIZADOS_GETP&#xA;FROM &#x9;MECE_LOGISTICO.DBO.GUIAS GUIAS WITH (NOLOCK, INDEX(UK_GUIA)  )&#xA;&#x9;&#x9;INNER JOIN&#x9;SEGUIMI_ENVIO AS SE_FECH  &#xA;&#x9;&#x9;&#x9;ON SE_FECH.NUMERO_GUIA = GUIAS.NUMERO_GUIA --SE.NUMERO_GUIA = SE_FECH.NUMERO_GUIA&#xA;&#x9;&#x9;--WHERE GUIAS.ID_DOCU_ULT_MOVI &gt;= 4 -- ID_PROCESO&#xA;&#xA;&#xA;drop index if exists [ZZZZIDX_GUIAS_GETP20251201] on #GUIAS_EVIOS_MOVILIZADOS_GETP&#xA;CREATE  NONCLUSTERED INDEX [ZZZZIDX_GUIAS_GETP20251201] ON #GUIAS_EVIOS_MOVILIZADOS_GETP&#xA;(&#xA;&#x9;NUMERO_GUIA ASC&#xA;)WITH (PAD_INDEX = OFF, STATISTICS_NORECOMPUTE = OFF, SORT_IN_TEMPDB = OFF, DROP_EXISTING = OFF, ONLINE = OFF, ALLOW_ROW_LOCKS = ON, ALLOW_PAGE_LOCKS = ON, FILLFACTOR = 80)&#xA;&#xA;&#xA;&#xA;;WITH CTE_DEPURAR AS(&#xA;SELECT &#xA;ROW_NUMBER() OVER(PARTITION BY NUMERO_GUIA ORDER BY FECHA_HORA_MOVIMIENTO) ROW_ID,&#xA;NUMERO_GUIA,&#xA;FECHA_HORA_MOVIMIENTO&#xA;FROM #GUIAS_EVIOS_MOVILIZADOS_GETP&#xA;)&#xA;DELETE CTE_DEPURAR WHERE ROW_ID&gt; 1&#xA;&#xA;DROP TABLE IF EXISTS #ULTIMO_PROCESO_LOGISTICO;&#xA;;WITH CTE AS(&#xA;SELECT TOP 0&#xA;ROW_NUMBER() OVER(PARTITION BY TEMP.NUMERO_GUIA ORDER BY SE.FECHA_HORA_MOVIMIENTO DESC) AS ROW_ID,&#xA;TEMP.NUMERO_GUIA,SE.FECHA_HORA_MOVIMIENTO,SE.ID_PROCESO,SE.NUMERO_MOVIMI,SE.CONSECUT_MOVIMI &#xA;FROM #GUIAS_EVIOS_MOVILIZADOS_GETP TEMP&#xA;INNER JOIN Mece_Logistico..SEGUIMIENTO_ENVIO SE WITH(NOLOCK)&#xA;ON SE.NUMERO_GUIA=TEMP.NUMERO_GUIA&#xA;)&#xA;SELECT * &#xA;INTO #ULTIMO_PROCESO_LOGISTICO&#xA;FROM CTE WHERE ROW_ID=1&#xA; &#xA;--SELECT TOP 20 *&#xA;--FROM #GUIAS_EVIOS_MOVILIZADOS_GETP &#xA;&#xA;;WITH CTE AS(&#xA;SELECT &#xA;ROW_NUMBER() OVER(PARTITION BY TEMP.NUMERO_GUIA ORDER BY SE.FECHA_HORA_MOVIMIENTO DESC) AS ROW_ID,&#xA;TEMP.NUMERO_GUIA,SE.FECHA_HORA_MOVIMIENTO,SE.ID_PROCESO,SE.NUMERO_MOVIMI,SE.CONSECUT_MOVIMI &#xA;FROM #GUIAS_EVIOS_MOVILIZADOS_GETP TEMP WITH(NOLOCK, INDEX([ZZZZIDX_GUIAS_GETP20251201]))&#xA;INNER JOIN Mece_Logistico..SEGUIMIENTO_ENVIO SE WITH(NOLOCK, INDEX([REL_GUIAS_SEGUIMIENTOENVIO_FK]))&#xA;ON SE.NUMERO_GUIA=TEMP.NUMERO_GUIA&#xA;)&#xA;INSERT INTO #ULTIMO_PROCESO_LOGISTICO&#xA;SELECT * &#xA;FROM CTE WHERE ROW_ID=1&#xA; &#xA;DROP TABLE IF EXISTS ##MOVILIZADOS_CON_ULTIMO_PROCESO_LOGISTICO&#xA;SELECT &#xA;BASE.*&#xA;,ULT_MOV.FECHA_HORA_MOVIMIENTO AS ULT_MOV_FECHA_HORA_MOVIMIENTO&#x9;&#xA;,ULT_MOV.ID_PROCESO AS ULT_MOV_ID_PROCESO&#x9;&#xA;,ULT_MOV.NUMERO_MOVIMI AS ULT_MOV_NUMERO_MOVIMI&#x9;&#xA;,ULT_MOV.CONSECUT_MOVIMI AS ULT_MOV_CONSECUT_MOVIMI&#xA;INTO ##MOVILIZADOS_CON_ULTIMO_PROCESO_LOGISTICO&#xA;FROM #ULTIMO_PROCESO_LOGISTICO ULT_MOV &#xA;INNER JOIN #GUIAS_EVIOS_MOVILIZADOS_GETP BASE ON ULT_MOV.NUMERO_GUIA=BASE.NUMERO_GUIA" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="0"
                SQLTask:DtsVariableName="User::VAL_fechaIni"
                SQLTask:ParameterDirection="Input"
                SQLTask:DataType="129"
                SQLTask:ParameterSize="-1" />
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="1"
                SQLTask:DtsVariableName="User::VAL_fechaFin"
                SQLTask:ParameterDirection="Input"
                SQLTask:DataType="129"
                SQLTask:ParameterSize="-1" />
            </SQLTask:SqlTaskData>
          </DTS:ObjectData>
