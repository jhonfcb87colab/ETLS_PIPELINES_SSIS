    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{E612B212-E04B-4288-8DCE-C3283CA7587E}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot;&#xA;DROP TABLE IF EXISTS #GUIAS_EVIOS_MOVILIZADOS_GETP;&#xA; &#xA;;WITH SEGUIMI_ENVIO AS (&#xA;    SELECT DISTINCT &#xA;&#x9;se.NUMERO_GUIA,&#xA;    SE.ID_PROCESO,&#xA;&#x9;SE.FECHA_HORA_MOVIMIENTO&#xA;&#x9;FROM MECE_LOGISTICO.DBO.SEGUIMIENTO_ENVIO se WITH (NOLOCK, INDEX(IX_FECHA_HORA_MOVIMIENTO_BI))&#xA;    WHERE se.FECHA_HORA_MOVIMIENTO &gt;=  '&quot;+ @[User::VAL_fechaIni] +&quot;' AND &#xA;&#x9;&#x9;  se.FECHA_HORA_MOVIMIENTO &lt;=  '&quot;+ @[User::VAL_fechaFin] +&quot;' AND/**/&#xA;&#x9;&#x9;  se.ID_PROCESO IN (5,6)&#xA;)&#xA;SELECT --CONVERT(NUMERIC,CONVERT(DATETIME,CONVERT(CHAR(11),GUIAS.FECHA_ENVIO)))AS TIMEID,&#xA;&#x9;&#x9;--GUIAS.FECHA_ENVIO, --AS FECHA, --CONVERT(DATETIME,CONVERT(CHAR(11),GUIAS.FECHA_ENVIO))AS FECHA,&#xA;&#x9;&#x9;SE_FECH.FECHA_HORA_MOVIMIENTO,&#xA;&#x9;&#x9;SE_FECH.ID_PROCESO,&#xA;&#x9;&#x9;GUIAS.ID_PAIS_ORIGEN, --ISNULL(GUIAS.ID_PAIS_ORIGEN,0) AS ID_PAIS_ORIGEN,&#xA;&#x9;&#x9;GUIAS.ID_CIUDAD_ORIGEN, --ISNULL(GUIAS.ID_CIUDAD_ORIGEN,0) AS ID_CIUDAD_ORIGEN,&#xA;&#x9;&#x9;GUIAS.ID_PAIS_DESTINO, --ISNULL(GUIAS.ID_PAIS_DESTINO,0) AS ID_PAIS_DESTINO,&#xA;&#x9;&#x9;GUIAS.ID_CIUDAD_DESTINO, --ISNULL(GUIAS.ID_CIUDAD_DESTINO,0) AS ID_CIUDAD_DESTINO,&#xA;&#x9;&#x9;GUIAS.ID_TIPOGUIA, --ISNULL(GUIAS.ID_TIPOGUIA,0) AS ID_TIPOGUIA,&#xA;&#x9;&#x9;GUIAS.ID_CLIENTE, --ISNULL(GUIAS.ID_CLIENTE,0) AS ID_CLIENTE,&#xA;&#x9;&#x9;GUIAS.ID_ESTADOENVIO, --ISNULL(GUIAS.ID_ESTADOENVIO,0) AS ID_ESTADOENVIO,&#xA;&#x9;&#x9;GUIAS.ID_DOCU_ULT_MOVI, --ISNULL(GUIAS.ID_DOCU_ULT_MOVI,0) AS   ID_PROCESO,&#xA;&#x9;&#x9;GUIAS.ID_MEDTRANS, --ISNULL(GUIAS.ID_MEDTRANS,0) AS ID_MEDTRANS,&#xA;&#x9;&#x9;GUIAS.ID_PRODUCTO, --ISNULL(GUIAS.ID_PRODUCTO,0) AS ID_PRODUCTO,&#xA;&#x9;&#x9;GUIAS.ID_SUBPRODUCTO, --ISNULL(GUIAS.ID_SUBPRODUCTO,0) AS ID_SUBPRODUCTO,&#xA;&#x9;&#x9;GUIAS.ID_ESTADOGUIA, --ISNULL(GUIAS.ID_ESTADOGUIA,0) AS ID_ESTADOGUIA,&#xA;&#x9;&#x9;GUIAS.ID_TIEMPO AS ID_TIEMPO_ENTREGA, --ISNULL(GUIAS.ID_TIEMPO,0) AS ID_TIEMPO_ENTREGA,&#xA;&#x9;&#x9;GUIAS.ID_REQUIERE_EMBALAJE AS ID_REQ_EMBALAJE, --ISNULL(GUIAS.ID_REQUIERE_EMBALAJE,0) AS ID_REQ_EMBALAJE,&#xA;&#x9;&#x9;GUIAS.NUMERO_GUIA, --COUNT(DISTINCT GUIAS.NUMERO_GUIA) AS CANTIDAD_GUIAS,&#xA;&#x9;&#x9;GUIAS.NUMERO_PIEZAS, --SUM(CASE WHEN ISNULL(GUIAS.NUMERO_PIEZAS,0) = 0 THEN 1 ELSE GUIAS.NUMERO_PIEZAS END) AS CANTIDAD_PIEZAS,&#xA;&#x9;&#x9;GUIAS.FECHA_ENTREGA, --ISNULL(DATEDIFF(MI,GUIAS.FECHA_ENTREGA,GUIAS.FECHA_MODIFICACION),0) AS TIEMPO_DIGITALIZACION,&#xA;&#x9;&#x9;GUIAS.FECHA_MODIFICACION&#xA;&#x9;&#x9;--ISNULL((DATEDIFF(HH,FECHA_ENVIO,FECHA_ENTREGA)),0) AS TIEMPO_PROMESA_H&#xA;&#x9;&#x9;INTO #GUIAS_EVIOS_MOVILIZADOS_GETP&#xA;FROM &#x9;MECE_LOGISTICO.DBO.GUIAS GUIAS WITH (NOLOCK, INDEX(UK_GUIA)  )&#xA;&#x9;&#x9;INNER JOIN&#x9;SEGUIMI_ENVIO AS SE_FECH  &#xA;&#x9;&#x9;&#x9;ON SE_FECH.NUMERO_GUIA = GUIAS.NUMERO_GUIA --SE.NUMERO_GUIA = SE_FECH.NUMERO_GUIA&#xA;&#x9;&#x9;--WHERE GUIAS.ID_DOCU_ULT_MOVI &gt;= 4 -- ID_PROCESO&#xA;&#xA;&#xA;drop index if exists [ZZZZIDX_GUIAS_GETP20251201] on #GUIAS_EVIOS_MOVILIZADOS_GETP&#xA;CREATE  NONCLUSTERED INDEX [ZZZZIDX_GUIAS_GETP20251201] ON #GUIAS_EVIOS_MOVILIZADOS_GETP&#xA;(&#xA;&#x9;NUMERO_GUIA ASC&#xA;)WITH (PAD_INDEX = OFF, STATISTICS_NORECOMPUTE = OFF, SORT_IN_TEMPDB = OFF, DROP_EXISTING = OFF, ONLINE = OFF, ALLOW_ROW_LOCKS = ON, ALLOW_PAGE_LOCKS = ON, FILLFACTOR = 80)&#xA;&#xA;&#xA;&#xA;;WITH CTE_DEPURAR AS(&#xA;SELECT &#xA;ROW_NUMBER() OVER(PARTITION BY NUMERO_GUIA ORDER BY FECHA_HORA_MOVIMIENTO) ROW_ID,&#xA;NUMERO_GUIA,&#xA;FECHA_HORA_MOVIMIENTO&#xA;FROM #GUIAS_EVIOS_MOVILIZADOS_GETP&#xA;)&#xA;DELETE CTE_DEPURAR WHERE ROW_ID&gt; 1&#xA;&#xA;DROP TABLE IF EXISTS #ULTIMO_PROCESO_LOGISTICO;&#xA;;WITH CTE AS(&#xA;SELECT TOP 0&#xA;ROW_NUMBER() OVER(PARTITION BY TEMP.NUMERO_GUIA ORDER BY SE.FECHA_HORA_MOVIMIENTO DESC) AS ROW_ID,&#xA;TEMP.NUMERO_GUIA,SE.FECHA_HORA_MOVIMIENTO,SE.ID_PROCESO,SE.NUMERO_MOVIMI,SE.CONSECUT_MOVIMI &#xA;FROM #GUIAS_EVIOS_MOVILIZADOS_GETP TEMP&#xA;INNER JOIN Mece_Logistico..SEGUIMIENTO_ENVIO SE WITH(NOLOCK)&#xA;ON SE.NUMERO_GUIA=TEMP.NUMERO_GUIA&#xA;)&#xA;SELECT * &#xA;INTO #ULTIMO_PROCESO_LOGISTICO&#xA;FROM CTE WHERE ROW_ID=1&#xA; &#xA;--SELECT TOP 20 *&#xA;--FROM #GUIAS_EVIOS_MOVILIZADOS_GETP &#xA;&#xA;;WITH CTE AS(&#xA;SELECT &#xA;ROW_NUMBER() OVER(PARTITION BY TEMP.NUMERO_GUIA ORDER BY SE.FECHA_HORA_MOVIMIENTO DESC) AS ROW_ID,&#xA;TEMP.NUMERO_GUIA,SE.FECHA_HORA_MOVIMIENTO,SE.ID_PROCESO,SE.NUMERO_MOVIMI,SE.CONSECUT_MOVIMI &#xA;FROM #GUIAS_EVIOS_MOVILIZADOS_GETP TEMP WITH(NOLOCK, INDEX([ZZZZIDX_GUIAS_GETP20251201]))&#xA;INNER JOIN Mece_Logistico..SEGUIMIENTO_ENVIO SE WITH(NOLOCK, INDEX([REL_GUIAS_SEGUIMIENTOENVIO_FK]))&#xA;ON SE.NUMERO_GUIA=TEMP.NUMERO_GUIA&#xA;)&#xA;INSERT INTO #ULTIMO_PROCESO_LOGISTICO&#xA;SELECT * &#xA;FROM CTE WHERE ROW_ID=1&#xA; &#xA;DROP TABLE IF EXISTS ##MOVILIZADOS_CON_ULTIMO_PROCESO_LOGISTICO&#xA;SELECT &#xA;BASE.*&#xA;,ULT_MOV.FECHA_HORA_MOVIMIENTO AS ULT_MOV_FECHA_HORA_MOVIMIENTO&#x9;&#xA;,ULT_MOV.ID_PROCESO AS ULT_MOV_ID_PROCESO&#x9;&#xA;,ULT_MOV.NUMERO_MOVIMI AS ULT_MOV_NUMERO_MOVIMI&#x9;&#xA;,ULT_MOV.CONSECUT_MOVIMI AS ULT_MOV_CONSECUT_MOVIMI&#xA;INTO ##MOVILIZADOS_CON_ULTIMO_PROCESO_LOGISTICO&#xA;FROM #ULTIMO_PROCESO_LOGISTICO ULT_MOV &#xA;INNER JOIN #GUIAS_EVIOS_MOVILIZADOS_GETP BASE ON ULT_MOV.NUMERO_GUIA=BASE.NUMERO_GUIA&#xA;&quot;"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="SQL_SELECT_Consulta_DG">
      <DTS:VariableValue
        DTS:DataType="8">
DROP TABLE IF EXISTS #GUIAS_EVIOS_MOVILIZADOS_GETP;
 
;WITH SEGUIMI_ENVIO AS (
    SELECT DISTINCT 
	se.NUMERO_GUIA,
    SE.ID_PROCESO,
	SE.FECHA_HORA_MOVIMIENTO
	FROM MECE_LOGISTICO.DBO.SEGUIMIENTO_ENVIO se WITH (NOLOCK, INDEX(IX_FECHA_HORA_MOVIMIENTO_BI))
    WHERE se.FECHA_HORA_MOVIMIENTO &gt;=  '2026-02-08' AND 
		  se.FECHA_HORA_MOVIMIENTO &lt;=  '2026-04-09' AND/**/
		  se.ID_PROCESO IN (5,6)
)
SELECT --CONVERT(NUMERIC,CONVERT(DATETIME,CONVERT(CHAR(11),GUIAS.FECHA_ENVIO)))AS TIMEID,
		--GUIAS.FECHA_ENVIO, --AS FECHA, --CONVERT(DATETIME,CONVERT(CHAR(11),GUIAS.FECHA_ENVIO))AS FECHA,
		SE_FECH.FECHA_HORA_MOVIMIENTO,
		SE_FECH.ID_PROCESO,
		GUIAS.ID_PAIS_ORIGEN, --ISNULL(GUIAS.ID_PAIS_ORIGEN,0) AS ID_PAIS_ORIGEN,
		GUIAS.ID_CIUDAD_ORIGEN, --ISNULL(GUIAS.ID_CIUDAD_ORIGEN,0) AS ID_CIUDAD_ORIGEN,
		GUIAS.ID_PAIS_DESTINO, --ISNULL(GUIAS.ID_PAIS_DESTINO,0) AS ID_PAIS_DESTINO,
		GUIAS.ID_CIUDAD_DESTINO, --ISNULL(GUIAS.ID_CIUDAD_DESTINO,0) AS ID_CIUDAD_DESTINO,
		GUIAS.ID_TIPOGUIA, --ISNULL(GUIAS.ID_TIPOGUIA,0) AS ID_TIPOGUIA,
		GUIAS.ID_CLIENTE, --ISNULL(GUIAS.ID_CLIENTE,0) AS ID_CLIENTE,
		GUIAS.ID_ESTADOENVIO, --ISNULL(GUIAS.ID_ESTADOENVIO,0) AS ID_ESTADOENVIO,
		GUIAS.ID_DOCU_ULT_MOVI, --ISNULL(GUIAS.ID_DOCU_ULT_MOVI,0) AS   ID_PROCESO,
		GUIAS.ID_MEDTRANS, --ISNULL(GUIAS.ID_MEDTRANS,0) AS ID_MEDTRANS,
		GUIAS.ID_PRODUCTO, --ISNULL(GUIAS.ID_PRODUCTO,0) AS ID_PRODUCTO,
		GUIAS.ID_SUBPRODUCTO, --ISNULL(GUIAS.ID_SUBPRODUCTO,0) AS ID_SUBPRODUCTO,
		GUIAS.ID_ESTADOGUIA, --ISNULL(GUIAS.ID_ESTADOGUIA,0) AS ID_ESTADOGUIA,
		GUIAS.ID_TIEMPO AS ID_TIEMPO_ENTREGA, --ISNULL(GUIAS.ID_TIEMPO,0) AS ID_TIEMPO_ENTREGA,
		GUIAS.ID_REQUIERE_EMBALAJE AS ID_REQ_EMBALAJE, --ISNULL(GUIAS.ID_REQUIERE_EMBALAJE,0) AS ID_REQ_EMBALAJE,
		GUIAS.NUMERO_GUIA, --COUNT(DISTINCT GUIAS.NUMERO_GUIA) AS CANTIDAD_GUIAS,
		GUIAS.NUMERO_PIEZAS, --SUM(CASE WHEN ISNULL(GUIAS.NUMERO_PIEZAS,0) = 0 THEN 1 ELSE GUIAS.NUMERO_PIEZAS END) AS CANTIDAD_PIEZAS,
		GUIAS.FECHA_ENTREGA, --ISNULL(DATEDIFF(MI,GUIAS.FECHA_ENTREGA,GUIAS.FECHA_MODIFICACION),0) AS TIEMPO_DIGITALIZACION,
		GUIAS.FECHA_MODIFICACION
		--ISNULL((DATEDIFF(HH,FECHA_ENVIO,FECHA_ENTREGA)),0) AS TIEMPO_PROMESA_H
		INTO #GUIAS_EVIOS_MOVILIZADOS_GETP
FROM 	MECE_LOGISTICO.DBO.GUIAS GUIAS WITH (NOLOCK, INDEX(UK_GUIA)  )
		INNER JOIN	SEGUIMI_ENVIO AS SE_FECH  
			ON SE_FECH.NUMERO_GUIA = GUIAS.NUMERO_GUIA --SE.NUMERO_GUIA = SE_FECH.NUMERO_GUIA
		--WHERE GUIAS.ID_DOCU_ULT_MOVI &gt;= 4 -- ID_PROCESO


drop index if exists [ZZZZIDX_GUIAS_GETP20251201] on #GUIAS_EVIOS_MOVILIZADOS_GETP
CREATE  NONCLUSTERED INDEX [ZZZZIDX_GUIAS_GETP20251201] ON #GUIAS_EVIOS_MOVILIZADOS_GETP
(
	NUMERO_GUIA ASC
)WITH (PAD_INDEX = OFF, STATISTICS_NORECOMPUTE = OFF, SORT_IN_TEMPDB = OFF, DROP_EXISTING = OFF, ONLINE = OFF, ALLOW_ROW_LOCKS = ON, ALLOW_PAGE_LOCKS = ON, FILLFACTOR = 80)



;WITH CTE_DEPURAR AS(
SELECT 
ROW_NUMBER() OVER(PARTITION BY NUMERO_GUIA ORDER BY FECHA_HORA_MOVIMIENTO) ROW_ID,
NUMERO_GUIA,
FECHA_HORA_MOVIMIENTO
FROM #GUIAS_EVIOS_MOVILIZADOS_GETP
)
DELETE CTE_DEPURAR WHERE ROW_ID&gt; 1

DROP TABLE IF EXISTS #ULTIMO_PROCESO_LOGISTICO;
;WITH CTE AS(
SELECT TOP 0
ROW_NUMBER() OVER(PARTITION BY TEMP.NUMERO_GUIA ORDER BY SE.FECHA_HORA_MOVIMIENTO DESC) AS ROW_ID,
TEMP.NUMERO_GUIA,SE.FECHA_HORA_MOVIMIENTO,SE.ID_PROCESO,SE.NUMERO_MOVIMI,SE.CONSECUT_MOVIMI 
FROM #GUIAS_EVIOS_MOVILIZADOS_GETP TEMP
INNER JOIN Mece_Logistico..SEGUIMIENTO_ENVIO SE WITH(NOLOCK)
ON SE.NUMERO_GUIA=TEMP.NUMERO_GUIA
)
SELECT * 
INTO #ULTIMO_PROCESO_LOGISTICO
FROM CTE WHERE ROW_ID=1
 
--SELECT TOP 20 *
--FROM #GUIAS_EVIOS_MOVILIZADOS_GETP 

;WITH CTE AS(
SELECT 
ROW_NUMBER() OVER(PARTITION BY TEMP.NUMERO_GUIA ORDER BY SE.FECHA_HORA_MOVIMIENTO DESC) AS ROW_ID,
TEMP.NUMERO_GUIA,SE.FECHA_HORA_MOVIMIENTO,SE.ID_PROCESO,SE.NUMERO_MOVIMI,SE.CONSECUT_MOVIMI 
FROM #GUIAS_EVIOS_MOVILIZADOS_GETP TEMP WITH(NOLOCK, INDEX([ZZZZIDX_GUIAS_GETP20251201]))
INNER JOIN Mece_Logistico..SEGUIMIENTO_ENVIO SE WITH(NOLOCK, INDEX([REL_GUIAS_SEGUIMIENTOENVIO_FK]))
ON SE.NUMERO_GUIA=TEMP.NUMERO_GUIA
)
INSERT INTO #ULTIMO_PROCESO_LOGISTICO
SELECT * 
FROM CTE WHERE ROW_ID=1
 
DROP TABLE IF EXISTS ##MOVILIZADOS_CON_ULTIMO_PROCESO_LOGISTICO
SELECT 
BASE.*
,ULT_MOV.FECHA_HORA_MOVIMIENTO AS ULT_MOV_FECHA_HORA_MOVIMIENTO	
,ULT_MOV.ID_PROCESO AS ULT_MOV_ID_PROCESO	
,ULT_MOV.NUMERO_MOVIMI AS ULT_MOV_NUMERO_MOVIMI	
,ULT_MOV.CONSECUT_MOVIMI AS ULT_MOV_CONSECUT_MOVIMI
INTO ##MOVILIZADOS_CON_ULTIMO_PROCESO_LOGISTICO
FROM #ULTIMO_PROCESO_LOGISTICO ULT_MOV 
INNER JOIN #GUIAS_EVIOS_MOVILIZADOS_GETP BASE ON ULT_MOV.NUMERO_GUIA=BASE.NUMERO_GUIA
</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{65B63103-8A36-49C6-B5C7-481398494A02}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot;WITH EV AS (&#xA;  SELECT DISTINCT NUMERO_GUIA&#xA;  FROM &quot;+ @[User::CONN_SIG_COL_LOGISTICA_DW] +&quot;.&quot;+ @[User::TBL_TMP_ENVIOS_MOV] +&quot;&#xA;)&#xA;SELECT&#xA;  EV.NUMERO_GUIA,&#xA;  MAX(I.DocumentRetailTypeId) AS ID_TIPO_FORMATO_IMPRESION&#xA;FROM EV&#xA;JOIN &quot;+ @[User::CONN_SIG_COLOMBIA_DW] +&quot;.&quot;+ @[User::TBL_RTW_GUIDE] +&quot;         &#x9;AS G  ON G.NUMBER = EV.NUMERO_GUIA&#xA;JOIN &quot;+ @[User::CONN_SIG_COLOMBIA_DW] +&quot;.&quot;+ @[User::TBL_RTW_INVOICEDETAIL] +&quot;&#x9;AS D  ON D.Id     = G.InvoiceDetailId&#xA;JOIN &quot;+ @[User::CONN_SIG_COLOMBIA_DW] +&quot;.&quot;+ @[User::TBL_RTW_INVOICE] +&quot;      &#x9;AS I  ON I.Id     = D.InvoiceId&#xA;WHERE I.DocumentRetailTypeId IS NOT NULL&#xA;GROUP BY EV.NUMERO_GUIA&quot;"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="SQL_SELECT_Datos_Reatil">
      <DTS:VariableValue
        DTS:DataType="8">WITH EV AS (
  SELECT DISTINCT NUMERO_GUIA
  FROM SIG_COL_LOGISTICA_DW.TMP.MPCCO_ENVIOS_MOV
)
SELECT
  EV.NUMERO_GUIA,
  MAX(I.DocumentRetailTypeId) AS ID_TIPO_FORMATO_IMPRESION
FROM EV
JOIN SIG_COLOMBIA_DW.RTW.GUIDE         	AS G  ON G.NUMBER = EV.NUMERO_GUIA
JOIN SIG_COLOMBIA_DW.RTW.InvoiceDetail	AS D  ON D.Id     = G.InvoiceDetailId
JOIN SIG_COLOMBIA_DW.RTW.Invoice      	AS I  ON I.Id     = D.InvoiceId
WHERE I.DocumentRetailTypeId IS NOT NULL
GROUP BY EV.NUMERO_GUIA</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{9A084FB1-E4F2-464F-B002-8380094D6897}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot;WITH CTW01 AS&#xA;(SELECT EV.NUMERO_GUIA FROM  &quot;+ @[User::CONN_SIG_COL_LOGISTICA_DW] +&quot;.&quot;+ @[User::TBL_TMP_ENVIOS_MOV] +&quot; EV WITH (NOLOCK) GROUP BY EV.NUMERO_GUIA),&#xA;CTE02 AS (&#xA;&#x9;&#x9;SELECT &#xA;&#x9;&#x9;ROW_NUMBER ( )   OVER ( PARTITION BY SCN.[Num_Guia] order by SCN.[fecha_reimpresion] desc )  ROWid, &#xA;&#x9;&#x9;&#x9;  SCN.[Num_Guia]&#xA;&#x9;&#x9;&#x9;  ,SCN.[Id_formato_impresion]&#xA;&#x9;&#x9;&#x9;  ,SCN.[Id_formato_reimpresion]&#xA;&#x9;&#x9;&#x9;  ,SCN.[fecha_reimpresion]&#xA;&#x9;&#x9;  FROM  &quot;+ @[User::CONN_SIG_COLOMBIA_DW] +&quot;.&quot;+ @[User::TBL_SCN_SERT_ENVIO] +&quot; SCN WITH(NOLOCK)&#xA;                                       &#xA;&#x9;&#x9;  INNER JOIN CTW01 GTEMP&#xA;&#x9;&#x9;  ON GTEMP.NUMERO_GUIA=SCN.Num_Guia&#xA;)&#xA;SELECT &#xA;&#x9;Num_Guia AS NUMERO_GUIA&#xA;&#x9;,ID_TIPO_FORMATO_IMPRESION =&#xA;&#x9;CASE &#xA;&#x9;WHEN Id_formato_reimpresion IS NULL AND Id_formato_impresion IS NULL THEN 0&#xA;&#x9;WHEN fecha_reimpresion IS NULL THEN Id_formato_impresion&#xA;&#x9;WHEN Id_formato_impresion IS NULL THEN Id_formato_reimpresion&#xA;&#x9;WHEN Id_formato_reimpresion IS NULL THEN Id_formato_impresion&#xA;&#x9;ELSE Id_formato_reimpresion END&#xA;&#x9;--,Id_formato_impresion&#x9;&#xA;&#x9;--,Id_formato_reimpresion&#x9;&#xA;&#x9;--,fecha_reimpresion&#xA;FROM CTE02 WHERE ROWid=1&quot;"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="SQL_SELECT_Datos_Sisclinet">
      <DTS:VariableValue
        DTS:DataType="8">WITH CTW01 AS
(SELECT EV.NUMERO_GUIA FROM  SIG_COL_LOGISTICA_DW.TMP.MPCCO_ENVIOS_MOV EV WITH (NOLOCK) GROUP BY EV.NUMERO_GUIA),
CTE02 AS (
		SELECT 
		ROW_NUMBER ( )   OVER ( PARTITION BY SCN.[Num_Guia] order by SCN.[fecha_reimpresion] desc )  ROWid, 
			  SCN.[Num_Guia]
			  ,SCN.[Id_formato_impresion]
			  ,SCN.[Id_formato_reimpresion]
			  ,SCN.[fecha_reimpresion]
		  FROM  SIG_COLOMBIA_DW.SCN.SERT_ENVIO SCN WITH(NOLOCK)
                                       
		  INNER JOIN CTW01 GTEMP
		  ON GTEMP.NUMERO_GUIA=SCN.Num_Guia
)
SELECT 
	Num_Guia AS NUMERO_GUIA
	,ID_TIPO_FORMATO_IMPRESION =
	CASE 
	WHEN Id_formato_reimpresion IS NULL AND Id_formato_impresion IS NULL THEN 0
	WHEN fecha_reimpresion IS NULL THEN Id_formato_impresion
	WHEN Id_formato_impresion IS NULL THEN Id_formato_reimpresion
	WHEN Id_formato_reimpresion IS NULL THEN Id_formato_impresion
	ELSE Id_formato_reimpresion END
	--,Id_formato_impresion	
	--,Id_formato_reimpresion	
	--,fecha_reimpresion
FROM CTE02 WHERE ROWid=1</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{E6A1957E-A331-4706-B32C-B693A2774B00}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot;&#xA;WITH m AS (&#xA;    SELECT  &#xA;        MIN(FECHA_HORA_MOVIMIENTO) AS FECHA,&#xA;        ID_PAIS_ORIGEN,&#xA;        ID_CIUDAD_ORIGEN,&#xA;        ID_PAIS_DESTINO,&#xA;        ID_CIUDAD_DESTINO,&#xA;        ID_TIPOGUIA,&#xA;        ID_CLIENTE,&#xA;        ID_ESTADOENVIO,&#xA;        ID_DOCU_ULT_MOVI,&#xA;        ID_MEDTRANS,&#xA;        ID_PRODUCTO,&#xA;        ID_SUBPRODUCTO,&#xA;        ID_ESTADOGUIA,&#xA;        ID_TIEMPO_ENTREGA,&#xA;        ID_REQ_EMBALAJE,&#xA;        NUMERO_GUIA,&#xA;        NUMERO_PIEZAS,&#xA;        ID_PROCESO,&#xA;        FECHA_ENTREGA,&#xA;        FECHA_MODIFICACION,&#xA;&#x9;&#x9;[ULT_MOV_FECHA_HORA_MOVIMIENTO],&#xA;&#x9;&#x9;[ULT_MOV_ID_PROCESO],&#xA;&#x9;&#x9;[ULT_MOV_NUMERO_MOVIMI],&#xA;&#x9;&#x9;[ULT_MOV_CONSECUT_MOVIMI]&#xA;    FROM TMP.MPCCO_ENVIOS_MOV_SOURCE WITH (NOLOCK)&#xA;    WHERE (&#xA;        (LEFT(NUMERO_GUIA, 1) IN ('1','2','5','7','9') AND LEN(NUMERO_GUIA) &gt;= 9)&#xA;        OR&#xA;        (LEFT(NUMERO_GUIA, 1) IN ('3','4') AND LEN(NUMERO_GUIA) &gt;= 8)&#xA;    )&#xA;    GROUP BY &#xA;        ID_PAIS_ORIGEN, ID_CIUDAD_ORIGEN,&#xA;        ID_PAIS_DESTINO, ID_CIUDAD_DESTINO,&#xA;        ID_TIPOGUIA, ID_CLIENTE, ID_ESTADOENVIO,&#xA;        ID_DOCU_ULT_MOVI, ID_MEDTRANS, ID_PRODUCTO,&#xA;        ID_SUBPRODUCTO, ID_ESTADOGUIA, ID_TIEMPO_ENTREGA,&#xA;        ID_REQ_EMBALAJE, NUMERO_GUIA, NUMERO_PIEZAS,&#xA;        ID_PROCESO,FECHA_ENTREGA, FECHA_MODIFICACION,&#xA;&#x9;&#x9;[ULT_MOV_FECHA_HORA_MOVIMIENTO],[ULT_MOV_ID_PROCESO],[ULT_MOV_NUMERO_MOVIMI],[ULT_MOV_CONSECUT_MOVIMI]&#xA;)&#xA;SELECT DISTINCT &#xA;        m.FECHA,&#xA;        m.ID_PAIS_ORIGEN,&#xA;        m.ID_CIUDAD_ORIGEN,&#xA;        m.ID_PAIS_DESTINO,&#xA;        m.ID_CIUDAD_DESTINO,&#xA;        m.ID_TIPOGUIA,&#xA;        m.ID_CLIENTE,&#xA;        m.ID_ESTADOENVIO,&#xA;        m.ID_DOCU_ULT_MOVI,&#xA;        m.ID_MEDTRANS,&#xA;        m.ID_PRODUCTO,&#xA;        m.ID_SUBPRODUCTO,&#xA;        m.ID_ESTADOGUIA,&#xA;        m.ID_TIEMPO_ENTREGA,&#xA;        m.ID_REQ_EMBALAJE,&#xA;        m.NUMERO_GUIA,&#xA;        m.NUMERO_PIEZAS,&#xA;        m.ID_PROCESO,&#xA;        m.FECHA_ENTREGA,&#xA;        m.FECHA_MODIFICACION,&#xA;&#x9;&#x9;m.[ULT_MOV_FECHA_HORA_MOVIMIENTO],&#xA;&#x9;&#x9;m.[ULT_MOV_ID_PROCESO],&#xA;&#x9;&#x9;m.[ULT_MOV_NUMERO_MOVIMI],&#xA;&#x9;&#x9;m.[ULT_MOV_CONSECUT_MOVIMI]&#xA;FROM m&#xA;WHERE m.NUMERO_GUIA IS NOT NULL&#xA;  AND NOT EXISTS (&#xA;        SELECT NUMERO_GUIA&#xA;        FROM SIG_COL_LOGISTICA_DW.FAC.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2 AS f_si&#xA;        WHERE f_si.NUMERO_GUIA = m.NUMERO_GUIA&#xA;          AND f_si.SE_PROMESA_CUMPLE_DEPURADA = 'SI'&#xA;)&#xA;-- 2) Excluir si ya fue calculada como NO en las últimas horas&#xA;  AND NOT EXISTS (&#xA;        SELECT NUMERO_GUIA&#xA;        FROM SIG_COL_LOGISTICA_DW.FAC.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2 AS f_no&#xA;        WHERE f_no.NUMERO_GUIA = m.NUMERO_GUIA&#xA;          AND f_no.SE_PROMESA_CUMPLE_DEPURADA = 'NO'&#xA;          AND f_no.FECHA_MODIFICACION_DW &gt;= DATEADD(HOUR, -3, GETDATE()));&#xA;&#xA;&#xA;&quot;"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="SQL_SELECT_Guias_Validas">
      <DTS:VariableValue
        DTS:DataType="8">
WITH m AS (
    SELECT  
        MIN(FECHA_HORA_MOVIMIENTO) AS FECHA,
        ID_PAIS_ORIGEN,
        ID_CIUDAD_ORIGEN,
        ID_PAIS_DESTINO,
        ID_CIUDAD_DESTINO,
        ID_TIPOGUIA,
        ID_CLIENTE,
        ID_ESTADOENVIO,
        ID_DOCU_ULT_MOVI,
        ID_MEDTRANS,
        ID_PRODUCTO,
        ID_SUBPRODUCTO,
        ID_ESTADOGUIA,
        ID_TIEMPO_ENTREGA,
        ID_REQ_EMBALAJE,
        NUMERO_GUIA,
        NUMERO_PIEZAS,
        ID_PROCESO,
        FECHA_ENTREGA,
        FECHA_MODIFICACION,
		[ULT_MOV_FECHA_HORA_MOVIMIENTO],
		[ULT_MOV_ID_PROCESO],
		[ULT_MOV_NUMERO_MOVIMI],
		[ULT_MOV_CONSECUT_MOVIMI]
    FROM TMP.MPCCO_ENVIOS_MOV_SOURCE WITH (NOLOCK)
    WHERE (
        (LEFT(NUMERO_GUIA, 1) IN ('1','2','5','7','9') AND LEN(NUMERO_GUIA) &gt;= 9)
        OR
        (LEFT(NUMERO_GUIA, 1) IN ('3','4') AND LEN(NUMERO_GUIA) &gt;= 8)
    )
    GROUP BY 
        ID_PAIS_ORIGEN, ID_CIUDAD_ORIGEN,
        ID_PAIS_DESTINO, ID_CIUDAD_DESTINO,
        ID_TIPOGUIA, ID_CLIENTE, ID_ESTADOENVIO,
        ID_DOCU_ULT_MOVI, ID_MEDTRANS, ID_PRODUCTO,
        ID_SUBPRODUCTO, ID_ESTADOGUIA, ID_TIEMPO_ENTREGA,
        ID_REQ_EMBALAJE, NUMERO_GUIA, NUMERO_PIEZAS,
        ID_PROCESO,FECHA_ENTREGA, FECHA_MODIFICACION,
		[ULT_MOV_FECHA_HORA_MOVIMIENTO],[ULT_MOV_ID_PROCESO],[ULT_MOV_NUMERO_MOVIMI],[ULT_MOV_CONSECUT_MOVIMI]
)
SELECT DISTINCT 
        m.FECHA,
        m.ID_PAIS_ORIGEN,
        m.ID_CIUDAD_ORIGEN,
        m.ID_PAIS_DESTINO,
        m.ID_CIUDAD_DESTINO,
        m.ID_TIPOGUIA,
        m.ID_CLIENTE,
        m.ID_ESTADOENVIO,
        m.ID_DOCU_ULT_MOVI,
        m.ID_MEDTRANS,
        m.ID_PRODUCTO,
        m.ID_SUBPRODUCTO,
        m.ID_ESTADOGUIA,
        m.ID_TIEMPO_ENTREGA,
        m.ID_REQ_EMBALAJE,
        m.NUMERO_GUIA,
        m.NUMERO_PIEZAS,
        m.ID_PROCESO,
        m.FECHA_ENTREGA,
        m.FECHA_MODIFICACION,
		m.[ULT_MOV_FECHA_HORA_MOVIMIENTO],
		m.[ULT_MOV_ID_PROCESO],
		m.[ULT_MOV_NUMERO_MOVIMI],
		m.[ULT_MOV_CONSECUT_MOVIMI]
FROM m
WHERE m.NUMERO_GUIA IS NOT NULL
  AND NOT EXISTS (
        SELECT NUMERO_GUIA
        FROM SIG_COL_LOGISTICA_DW.FAC.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2 AS f_si
        WHERE f_si.NUMERO_GUIA = m.NUMERO_GUIA
          AND f_si.SE_PROMESA_CUMPLE_DEPURADA = 'SI'
)
-- 2) Excluir si ya fue calculada como NO en las últimas horas
  AND NOT EXISTS (
        SELECT NUMERO_GUIA
        FROM SIG_COL_LOGISTICA_DW.FAC.MPCCO_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2 AS f_no
        WHERE f_no.NUMERO_GUIA = m.NUMERO_GUIA
          AND f_no.SE_PROMESA_CUMPLE_DEPURADA = 'NO'
          AND f_no.FECHA_MODIFICACION_DW &gt;= DATEADD(HOUR, -3, GETDATE()));


</DTS:VariableValue>
    </DTS:Variable>
