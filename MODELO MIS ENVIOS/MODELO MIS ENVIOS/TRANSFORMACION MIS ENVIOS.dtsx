          DTS:ObjectName="Paso 16 Actualizar FormaPago"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{82E3C266-AD9E-4E38-9443-8FFFA079254B}"
              SQLTask:SqlStatementSource="UPDATE &#xA;&#x9;[TMP].[ME_TBCL]&#xA;SET&#xA;&#x9;GINF_FORMAPAGO = F.NOMBRE_FORMAPAGO&#xA;FROM &#xA;&#x9;[TMP].[ME_TBCL] P WITH (NOLOCK)&#xA;INNER JOIN&#xA;&#x9;PAR.FORMAPAGO F WITH (NOLOCK)&#xA;ON&#xA;&#x9;P.GINF_ID_FORMAPAGO = F.ID_FORMAPAGO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Sequence Container\Paso 17 Actualizar Tipo Trayecto"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{7AFAB0EC-51F2-45C8-A8B2-4101B48E45C9}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Paso 17 Actualizar Tipo Trayecto"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{82E3C266-AD9E-4E38-9443-8FFFA079254B}"
              SQLTask:SqlStatementSource="WITH CTE &#xA;(&#xA;&#x9; G_NUMERO_GUIA&#xA;&#x9;,ID_TIPOTRAY&#xA;&#x9;,NOMBRE_TIPOTRAY&#xA;)&#xA;AS&#xA;&#x9;(&#xA;&#x9;&#x9;SELECT&#xA;&#x9;&#x9;&#x9; P.G_NUMERO_GUIA&#xA;&#x9;&#x9;&#x9;,R.ID_TIPOTRAY&#xA;&#x9;&#x9;&#x9;,T.NOMBRE_TIPOTRAY&#xA;&#x9;&#x9;FROM &#xA;&#x9;&#x9;&#x9;TMP.ME_TBCL P WITH (NOLOCK)&#xA;&#x9;&#x9;INNER JOIN &#xA;&#x9;&#x9;&#x9;[PAR].[RED_OPERATIVA_CONSOLIDADA_TRAYECTOS] R WITH (NOLOCK)&#xA;&#x9;&#x9;ON &#xA;&#x9;&#x9;&#x9;P.G_ID_CIUDAD_ORIGEN = R.ID_CIUDAD_ORIGEN&#xA;&#x9;&#x9;AND &#xA;&#x9;&#x9;&#x9;P.G_ID_CIUDAD_DESTINO = R.ID_CIUDAD_DESTINO&#xA;&#x9;&#x9;INNER JOIN &#xA;&#x9;&#x9;&#x9;[PAR].[TIPOTRAYECTO] T  WITH (NOLOCK)&#xA;&#x9;&#x9;ON &#xA;&#x9;&#x9;&#x9;R.ID_TIPOTRAY = T.ID_TIPOTRAY&#xA;&#x9;)&#xA;&#xA;&#xA;UPDATE&#xA;&#x9;TMP.ME_TBCL&#xA;SET&#xA;&#x9;P_ID_TIPO_TRAYECTO = ISNULL(CTE.ID_TIPOTRAY,-888),&#xA;&#x9;P_TIPO_TRAYECTO = ISNULL(CTE.NOMBRE_TIPOTRAY,'NO DISPONIBLE')&#xA;FROM &#xA;&#x9;TMP.ME_TBCL TMP WITH (NOLOCK) INNER JOIN&#xA;&#x9;CTE&#xA;ON&#xA;&#x9;TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Sequence Container\Paso 18 Actualizar Departamanto"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{0B29B90E-BBA7-460C-AC35-B45C434D8028}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Paso 18 Actualizar Departamanto"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{82E3C266-AD9E-4E38-9443-8FFFA079254B}"
              SQLTask:SqlStatementSource="WITH CTE &#xA;(&#xA;&#x9; G_NUMERO_GUIA&#xA;&#x9;,ID_DEPARTAMENTO&#xA;)&#xA;AS&#xA;&#x9;(&#xA;&#x9;&#x9;SELECT&#xA;&#x9;&#x9;&#x9; P.G_NUMERO_GUIA&#xA;&#x9;&#x9;&#x9;,C.ID_DEPARTAMENTO&#xA;&#x9;&#x9;FROM &#xA;&#x9;&#x9;&#x9;TMP.ME_TBCL P WITH (NOLOCK)&#xA;&#x9;&#x9;INNER JOIN &#xA;&#x9;&#x9;&#x9;PAR.CIUDADES C WITH (NOLOCK)&#xA;&#x9;&#x9;ON &#xA;&#x9;&#x9;&#x9;P.G_ID_CIUDAD_ORIGEN = C.ID_CIUDAD&#xA;&#x9;)&#xA;&#xA;&#xA;UPDATE&#xA;&#x9;TMP.ME_TBCL&#xA;SET&#xA;&#x9;G_ID_DEPTO_ORIGEN = ISNULL(CONVERT(INT,CTE.ID_DEPARTAMENTO),-888)&#xA;FROM &#xA;&#x9;TMP.ME_TBCL TMP INNER JOIN&#xA;&#x9;CTE&#xA;ON &#xA;&#x9;TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA&#xA;GO&#xA;&#xA;&#xA;WITH CTE &#xA;(&#xA;&#x9; G_NUMERO_GUIA&#xA;&#x9;,ID_DEPARTAMENTO&#xA;)&#xA;AS&#xA;&#x9;(&#xA;&#x9;&#x9;SELECT&#xA;&#x9;&#x9;&#x9; P.G_NUMERO_GUIA&#xA;&#x9;&#x9;&#x9;,C.ID_DEPARTAMENTO&#xA;&#x9;&#x9;FROM &#xA;&#x9;&#x9;&#x9;TMP.ME_TBCL P WITH (NOLOCK)&#xA;&#x9;&#x9;INNER JOIN &#xA;&#x9;&#x9;&#x9;PAR.CIUDADES C WITH (NOLOCK)&#xA;&#x9;&#x9;ON &#xA;&#x9;&#x9;&#x9;P.G_ID_CIUDAD_DESTINO = C.ID_CIUDAD&#xA;&#x9;)&#xA;&#xA;&#xA;UPDATE&#xA;&#x9;TMP.ME_TBCL&#xA;SET&#xA;&#x9;G_ID_DEPTO_DESTINO = ISNULL(CONVERT(INT,CTE.ID_DEPARTAMENTO),-888)&#xA;FROM &#xA;&#x9;TMP.ME_TBCL TMP INNER JOIN&#xA;&#x9;CTE&#xA;ON &#xA;&#x9;TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Sequence Container\Paso 19 Actualizar base con procesos logísticos"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{57C9D344-F076-418D-9F96-C4EFD398589E}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Paso 19 Actualizar base con procesos logísticos"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{82E3C266-AD9E-4E38-9443-8FFFA079254B}"
              SQLTask:SqlStatementSource="WITH CTE&#xA;(&#xA;&#x9; G_NUMERO_GUIA&#xA;&#x9;,SE_ID_FECHA_RE&#xA;&#x9;,SE_FECHA_RE&#xA;&#x9;,SE_ID_FECHA_EV&#xA;&#x9;,SE_FECHA_EV&#xA;&#x9;,SE_ID_ULTI&#xA;&#x9;,SE_ID_FECHA_EZU&#xA;&#x9;,SE_ID_FECHA_EPS&#xA;&#x9;,SE_ID_FECHA_ER&#xA;&#x9;,SE_ID_FECHA_EBL&#xA;&#x9;,SE_ID_FECHA_SZU&#xA;&#x9;,SE_ID_FECHA_SR&#xA;&#x9;,SE_ID_FECHA_RRE&#xA;&#x9;,SE_REVERSION&#xA;&#x9;,SE_ID_FECHA_RE_RRE&#xA;&#x9;,SE_FECHA_RE_RRE&#xA;&#x9;,SE_ID_FECHA_EV_RRE&#xA;&#x9;,SE_FECHA_EV_RRE&#xA;)&#xA;AS&#xA;(&#xA;SELECT &#xA;&#x9; NUMERO_GUIA G_NUMERO_GUIA&#xA;&#x9;,ISNULL(MIN(CASE WHEN ID_PROCESO = 24 THEN FECHA_HORA_MOVIMIENTO ELSE NULL END ),'1900-01-01') SE_ID_FECHA_RE&#xA;&#x9;,ISNULL(CONVERT(VARCHAR,MIN(CASE WHEN ID_PROCESO = 24 THEN FECHA_HORA_MOVIMIENTO ELSE NULL END ),111),'NO DISPONIBLE') SE_FECHA_RE&#xA;&#x9;,ISNULL(MIN(CASE WHEN ID_PROCESO = 11 THEN FECHA_HORA_MOVIMIENTO ELSE NULL END ),'1900-01-01') SE_ID_FECHA_EV&#xA;&#x9;,ISNULL(CONVERT(VARCHAR,MIN(CASE WHEN ID_PROCESO = 11 THEN FECHA_HORA_MOVIMIENTO ELSE NULL END ),111),'NO DISPONIBLE') SE_FECHA_EV&#xA;&#x9;,ISNULL(MAX(ID),-888) SE_ID_ULTI&#xA;&#x9;,ISNULL(MIN(CASE WHEN ID_PROCESO = 6 THEN FECHA_HORA_MOVIMIENTO ELSE NULL END ),'1900-01-01') SE_ID_FECHA_EZU&#xA;&#x9;,ISNULL(MIN(CASE WHEN ID_PROCESO = 5 THEN FECHA_HORA_MOVIMIENTO ELSE NULL END ),'1900-01-01') SE_ID_FECHA_EPS&#xA;&#x9;,ISNULL(MIN(CASE WHEN ID_PROCESO = 14 THEN FECHA_HORA_MOVIMIENTO ELSE NULL END ),'1900-01-01') SE_ID_FECHA_ER&#xA;&#x9;,ISNULL(MIN(CASE WHEN ID_PROCESO = 8 THEN FECHA_HORA_MOVIMIENTO ELSE NULL END ),'1900-01-01') SE_ID_FECHA_EBL&#xA;&#x9;,ISNULL(MIN(CASE WHEN ID_PROCESO = 9 THEN FECHA_HORA_MOVIMIENTO ELSE NULL END ),'1900-01-01') SE_ID_FECHA_SZU&#xA;&#x9;,ISNULL(MIN(CASE WHEN ID_PROCESO = 12 THEN FECHA_HORA_MOVIMIENTO ELSE NULL END ),'1900-01-01') SE_ID_FECHA_SR&#xA;&#x9;,ISNULL(MAX(CASE WHEN ID_PROCESO = 30 THEN FECHA_HORA_MOVIMIENTO ELSE NULL END ),'1900-01-01') SE_ID_FECHA_RRE&#xA;&#x9;,ISNULL(MAX(CASE WHEN ID_PROCESO = 30 THEN 'SI' ELSE NULL END ),'NO') SE_REVERSION&#xA;&#x9;,ISNULL(MAX(CASE WHEN ID_PROCESO = 24 THEN FECHA_HORA_MOVIMIENTO ELSE NULL END ),'1900-01-01') SE_ID_FECHA_RE_RRE&#xA;&#x9;,ISNULL(CONVERT(VARCHAR,MAX(CASE WHEN ID_PROCESO = 24 THEN FECHA_HORA_MOVIMIENTO ELSE NULL END ),111),'NO DISPONIBLE') SE_FECHA_RE_RRE&#xA;&#x9;,ISNULL(MAX(CASE WHEN ID_PROCESO = 11 THEN FECHA_HORA_MOVIMIENTO ELSE NULL END ),'1900-01-01') SE_ID_FECHA_EV_RRE&#xA;&#x9;,ISNULL(CONVERT(VARCHAR,MAX(CASE WHEN ID_PROCESO = 11 THEN FECHA_HORA_MOVIMIENTO ELSE NULL END ),111),'NO DISPONIBLE') SE_FECHA_EV_RRE&#xA;FROM &#xA;&#x9;TMP.ME_TBCL_04 WITH(NOLOCK)&#xA;GROUP BY &#xA;&#x9;NUMERO_GUIA&#xA;)&#xA;&#xA;&#xA;UPDATE &#xA;&#x9;[TMP].[ME_TBCL]&#xA;SET&#xA;&#x9; SE_ID_FECHA_RE = CTE.SE_ID_FECHA_RE&#xA;&#x9;,SE_FECHA_RE = CTE.SE_FECHA_RE&#xA;&#x9;,SE_ID_FECHA_EV = CTE.SE_ID_FECHA_EV&#xA;&#x9;,SE_FECHA_EV = CTE.SE_FECHA_EV&#xA;&#x9;,SE_ID_ULTI = CTE.SE_ID_ULTI&#xA;&#x9;,SE_ID_FECHA_EZU = CTE.SE_ID_FECHA_EZU&#xA;&#x9;,SE_ID_FECHA_EPS = CTE.SE_ID_FECHA_EPS&#xA;&#x9;,SE_ID_FECHA_ER = CTE.SE_ID_FECHA_ER&#xA;&#x9;,SE_ID_FECHA_EBL = CTE.SE_ID_FECHA_EBL&#xA;&#x9;,SE_ID_FECHA_SZU = CTE.SE_ID_FECHA_SZU&#xA;&#x9;,SE_ID_FECHA_SR = CTE.SE_ID_FECHA_SR&#xA;&#x9;,SE_ID_FECHA_RRE = CTE.SE_ID_FECHA_RRE&#xA;&#x9;,SE_REVERSION = CTE.SE_REVERSION&#xA;&#x9;,SE_ID_FECHA_RE_RRE = CTE.SE_ID_FECHA_RE_RRE&#xA;&#x9;,SE_FECHA_RE_RRE = CTE.SE_FECHA_RE_RRE&#xA;&#x9;,SE_ID_FECHA_EV_RRE = CTE.SE_ID_FECHA_EV_RRE&#xA;&#x9;,SE_FECHA_EV_RRE = CTE.SE_FECHA_EV_RRE&#xA;FROM&#xA;&#x9;TMP.ME_TBCL TMP WITH (NOLOCK) INNER JOIN &#xA;&#x9;CTE&#xA;ON&#xA;&#x9;TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Sequence Container\Paso 20 Actualizar Base proceso concepto"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{B533D875-8C81-441F-8BF9-A9E9E9356D9C}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Paso 20 Actualizar Base proceso concepto"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{82E3C266-AD9E-4E38-9443-8FFFA079254B}"
              SQLTask:SqlStatementSource="WITH CTE&#xA;(&#xA;&#x9; G_NUMERO_GUIA&#xA;&#x9;,G_ID_ESTADOENVIO&#xA;&#x9;,ID_PROCESO&#xA;&#x9;,ID_CONCEPTO&#xA;&#x9;,SE_ID_ULTI_PROC_CONCP&#xA;)&#xA;AS&#xA;&#x9;(&#xA;&#x9;&#x9;SELECT&#xA;&#x9;&#x9;&#x9; TMP.G_NUMERO_GUIA&#xA;&#x9;&#x9;&#x9;,TMP.G_ID_ESTADOENVIO&#xA;&#x9;&#x9;&#x9;,TMP4.ID_PROCESO&#xA;&#x9;&#x9;&#x9;,TMP4.ID_CONCEPTO&#xA;&#x9;&#x9;&#x9;,ISNULL(CONVERT(VARCHAR,TMP.G_ID_ESTADOENVIO) + '-' + CONVERT (VARCHAR,TMP4.ID_PROCESO) + '-' + CONVERT (VARCHAR,-888),'NO DISPONIBLE') SE_ID_ULTI_PROC_CONCP&#xA;&#x9;&#x9;FROM&#xA;&#x9;&#x9;&#x9;TMP.ME_TBCL TMP WITH (NOLOCK)&#xA;&#x9;&#x9;INNER JOIN&#xA;&#x9;&#x9;&#x9;TMP.ME_TBCL_04 TMP4 WITH (NOLOCK)&#xA;&#x9;&#x9;ON&#xA;&#x9;&#x9;&#x9;TMP.[SE_ID_ULTI] = TMP4.ID&#xA;&#x9;)&#xA;&#xA;&#xA;UPDATE &#xA;&#x9;[TMP].[ME_TBCL] &#xA;SET &#xA;&#x9;SE_ID_PROCESO = ISNULL(CTE.ID_PROCESO,-888) , &#xA;&#x9;SE_ID_CONCEPTO = CTE.ID_CONCEPTO ,&#xA;&#x9;SE_ID_ULTI_PROC_CONCP = CTE.SE_ID_ULTI_PROC_CONCP&#xA;FROM&#xA;&#x9;TMP.ME_TBCL TMP WITH (NOLOCK) INNER JOIN CTE&#xA;ON&#xA;&#x9;TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Sequence Container\Paso 20 Actualizar RE Sin RRE"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
