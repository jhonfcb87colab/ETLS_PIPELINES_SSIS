                  SQLTask:Connection="{82E3C266-AD9E-4E38-9443-8FFFA079254B}"
                  SQLTask:SqlStatementSource="--SET NOCOUNT ON;&#xA;&#xA;/* 1. INSERTA DATOS COTA */&#xA;INSERT INTO [TMP].[ME_TBCL_03]&#xA;SELECT &#xA;&#x9; SE.[NUMERO_GUIA]&#xA;&#x9;,SE.[ID_PROCESO]&#xA;&#x9;,SE.[ID_CONCEPTO]&#xA;&#x9;,SE.[FECHA_HORA_MOVIMIENTO]&#xA;&#x9;,SE.[NUMERO_MOVIMI]&#xA;&#x9;,SE.[CONSECUT_MOVIMI]&#xA;FROM&#xA;&#x9;[LOG].[SEGUIMIENTO_ENVIO_COTA] SE WITH(NOLOCK) &#xA;&#x9;INNER JOIN [TMP].[ME_TBCL_02] TMP WITH(NOLOCK)&#xA;ON&#xA;&#x9;SE.NUMERO_GUIA = TMP.NUMERO_GUIA&#xA;;&#xA;GO&#xA;&#xA;/* 2. INSERTA DATOS NEIVA */&#xA;INSERT INTO [TMP].[ME_TBCL_03]&#xA;SELECT &#xA;&#x9; SE.[NUMERO_GUIA]&#xA;&#x9;,SE.[ID_PROCESO]&#xA;&#x9;,SE.[ID_CONCEPTO]&#xA;&#x9;,SE.[FECHA_HORA_MOVIMIENTO]&#xA;&#x9;,SE.[NUMERO_MOVIMI]&#xA;&#x9;,SE.[CONSECUT_MOVIMI]&#xA;FROM&#xA;&#x9;[LOG].[SEGUIMIENTO_ENVIO_NEIV] SE WITH(NOLOCK) &#xA;&#x9;INNER JOIN [TMP].[ME_TBCL_02] TMP WITH(NOLOCK)&#xA;ON&#xA;&#x9;SE.NUMERO_GUIA = TMP.NUMERO_GUIA&#xA;;&#xA;GO&#xA;&#xA;/* 3. INSERTA DATOS PEREIRA */&#xA;INSERT INTO [TMP].[ME_TBCL_03]&#xA;SELECT &#xA;&#x9; SE.[NUMERO_GUIA]&#xA;&#x9;,SE.[ID_PROCESO]&#xA;&#x9;,SE.[ID_CONCEPTO]&#xA;&#x9;,SE.[FECHA_HORA_MOVIMIENTO]&#xA;&#x9;,SE.[NUMERO_MOVIMI]&#xA;&#x9;,SE.[CONSECUT_MOVIMI]&#xA;FROM&#xA;&#x9;[LOG].[SEGUIMIENTO_ENVIO_PERE] SE WITH(NOLOCK) &#xA;&#x9;INNER JOIN [TMP].[ME_TBCL_02] TMP WITH(NOLOCK)&#xA;ON&#xA;&#x9;SE.NUMERO_GUIA = TMP.NUMERO_GUIA&#xA;;&#xA;GO&#xA;&#xA;/* 4. INSERTA DATOS CUCUTA */&#xA;INSERT INTO [TMP].[ME_TBCL_03]&#xA;SELECT &#xA;&#x9; SE.[NUMERO_GUIA]&#xA;&#x9;,SE.[ID_PROCESO]&#xA;&#x9;,SE.[ID_CONCEPTO]&#xA;&#x9;,SE.[FECHA_HORA_MOVIMIENTO]&#xA;&#x9;,SE.[NUMERO_MOVIMI]&#xA;&#x9;,SE.[CONSECUT_MOVIMI]&#xA;FROM&#xA;&#x9;[LOG].[SEGUIMIENTO_ENVIO_CUCU] SE WITH(NOLOCK) &#xA;&#x9;INNER JOIN [TMP].[ME_TBCL_02] TMP WITH(NOLOCK)&#xA;ON&#xA;&#x9;SE.NUMERO_GUIA = TMP.NUMERO_GUIA&#xA;;&#xA;GO&#xA;&#xA;&#xA;/* 5. INSERTA DATOS BUGA */&#xA;/*&#xA;INSERT INTO [TMP].[ME_TBCL_03]&#xA;SELECT &#xA;&#x9; SE.[NUMERO_GUIA]&#xA;&#x9;,SE.[ID_PROCESO]&#xA;&#x9;,SE.[ID_CONCEPTO]&#xA;&#x9;,SE.[FECHA_HORA_MOVIMIENTO]&#xA;&#x9;,SE.[NUMERO_MOVIMI]&#xA;&#x9;,SE.[CONSECUT_MOVIMI]&#xA;FROM&#xA;&#x9;[LOG].[SEGUIMIENTO_ENVIO_BUGA] SE WITH(NOLOCK) &#xA;&#x9;INNER JOIN  [TMP].[ME_TBCL_02] TMP WITH(NOLOCK)&#xA;ON&#xA;&#x9;SE.NUMERO_GUIA = TMP.NUMERO_GUIA&#xA;;&#xA;GO&#xA;*/&#xA;&#xA;/* 6. INSERTA DATOS IBAGUE */&#xA;INSERT INTO [TMP].[ME_TBCL_03]&#xA;SELECT &#xA;&#x9; SE.[NUMERO_GUIA]&#xA;&#x9;,SE.[ID_PROCESO]&#xA;&#x9;,SE.[ID_CONCEPTO]&#xA;&#x9;,SE.[FECHA_HORA_MOVIMIENTO]&#xA;&#x9;,SE.[NUMERO_MOVIMI]&#xA;&#x9;,SE.[CONSECUT_MOVIMI]&#xA;FROM&#xA;&#x9;[LOG].[SEGUIMIENTO_ENVIO_IBAG] SE WITH(NOLOCK) &#xA;&#x9;INNER JOIN [TMP].[ME_TBCL_02] TMP WITH(NOLOCK)&#xA;ON&#xA;&#x9;SE.NUMERO_GUIA = TMP.NUMERO_GUIA&#xA;;&#xA;GO&#xA;&#xA;/* 7. INSERTA DATOS MANIZALES */&#xA;INSERT INTO [TMP].[ME_TBCL_03]&#xA;SELECT &#xA;&#x9; SE.[NUMERO_GUIA]&#xA;&#x9;,SE.[ID_PROCESO]&#xA;&#x9;,SE.[ID_CONCEPTO]&#xA;&#x9;,SE.[FECHA_HORA_MOVIMIENTO]&#xA;&#x9;,SE.[NUMERO_MOVIMI]&#xA;&#x9;,SE.[CONSECUT_MOVIMI]&#xA;FROM&#xA;&#x9;[LOG].[SEGUIMIENTO_ENVIO_MANI] SE WITH(NOLOCK) &#xA;&#x9;INNER JOIN [TMP].[ME_TBCL_02] TMP WITH(NOLOCK)&#xA;ON&#xA;&#x9;SE.NUMERO_GUIA = TMP.NUMERO_GUIA&#xA;;&#xA;GO&#xA;&#xA;/* 8. INSERTA DATOS CARTAGENA */&#xA;INSERT INTO [TMP].[ME_TBCL_03]&#xA;SELECT &#xA;&#x9; SE.[NUMERO_GUIA]&#xA;&#x9;,SE.[ID_PROCESO]&#xA;&#x9;,SE.[ID_CONCEPTO]&#xA;&#x9;,SE.[FECHA_HORA_MOVIMIENTO]&#xA;&#x9;,SE.[NUMERO_MOVIMI]&#xA;&#x9;,SE.[CONSECUT_MOVIMI]&#xA;FROM&#xA;&#x9;[LOG].[SEGUIMIENTO_ENVIO_CART] SE WITH(NOLOCK) &#xA;&#x9;INNER JOIN [TMP].[ME_TBCL_02] TMP WITH(NOLOCK)&#xA;ON&#xA;&#x9;SE.NUMERO_GUIA = TMP.NUMERO_GUIA&#xA;;&#xA;GO&#xA;&#xA;/* 9. INSERTA DATOS SINCELEJO */&#xA;INSERT INTO [TMP].[ME_TBCL_03]&#xA;SELECT &#xA;&#x9; SE.[NUMERO_GUIA]&#xA;&#x9;,SE.[ID_PROCESO]&#xA;&#x9;,SE.[ID_CONCEPTO]&#xA;&#x9;,SE.[FECHA_HORA_MOVIMIENTO]&#xA;&#x9;,SE.[NUMERO_MOVIMI]&#xA;&#x9;,SE.[CONSECUT_MOVIMI]&#xA;FROM&#xA;&#x9;[LOG].[SEGUIMIENTO_ENVIO_SINC] SE WITH(NOLOCK) &#xA;&#