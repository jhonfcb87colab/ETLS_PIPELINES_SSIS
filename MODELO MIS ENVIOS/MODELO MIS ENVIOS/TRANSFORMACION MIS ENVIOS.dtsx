          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{82E3C266-AD9E-4E38-9443-8FFFA079254B}"
              SQLTask:SqlStatementSource="--1. PRIORIDAD CLIENTE&#xA;WITH CTE&#xA;(&#xA;&#x9; ID&#xA;&#x9;,G_NUMERO_GUIA&#xA;&#x9;,ID_NOVEDAD_ME_TBCL&#xA;&#x9;,SE_DESC_PROC_DEPU&#xA;&#x9;,SE_DESC_CONC_DEPU&#xA;&#x9;,SE_DEPURADO_RESP&#xA;&#x9;,SE_ID_FECHA_NOVE&#xA;)&#xA;AS&#xA;&#x9;(&#xA;&#x9;&#x9;SELECT&#xA;&#x9;&#x9;&#x9; ROW_NUMBER() OVER(PARTITION BY G_NUMERO_GUIA ORDER BY FECHA_HORA_MOVIMIENTO) ID&#xA;&#x9;&#x9;&#x9;,G_NUMERO_GUIA&#xA;&#x9;&#x9;&#x9;,[ID_NOVEDAD_ME_TBCL]&#xA;&#x9;&#x9;&#x9;,SE_DESC_PROC_DEPU&#xA;&#x9;&#x9;&#x9;,SE_DESC_CONC_DEPU&#xA;&#x9;&#x9;&#x9;,SE_DEPURADO_RESP&#xA;&#x9;&#x9;&#x9;,FECHA_HORA_MOVIMIENTO AS SE_ID_FECHA_NOVE&#xA;&#x9;&#x9;&#x9;--into #pruebas_hol&#xA;&#x9;&#x9;FROM&#xA;&#x9;&#x9;&#x9;TMP.ME_TBCL_08 C WITH(NOLOCK)&#xA;&#x9;&#x9;WHERE&#xA;&#x9;&#x9;&#x9;SE_DEPURADO_RESP = 'C'&#xA;&#x9;)&#xA;&#xA;UPDATE &#xA;&#x9;[TMP].[ME_TBCL]&#xA;SET&#xA;&#x9; SE_CUMPLE_EFIC_DEPU = CASE WHEN C.SE_CUMPLE_EFIC_DEPU = 'NO'  THEN (CASE WHEN CTE.SE_DEPURADO_RESP IN ('E','C') THEN 'SI' ELSE C.SE_CUMPLE_EFIC_DEPU END) ELSE C.SE_CUMPLE_EFIC_DEPU END &#xA;&#x9;,SE_ID_NOVEDAD_ME_TBCL = CTE.ID_NOVEDAD_ME_TBCL&#xA;&#x9;,SE_DESC_PROC_DEPU = CTE.SE_DESC_PROC_DEPU&#xA;&#x9;,SE_DESC_CONC_DEPU = CTE.SE_DESC_CONC_DEPU&#xA;&#x9;,SE_DEPURADO_NOMBRE_RESP = 'CLIENTE'&#xA;&#x9;,SE_DEPURADO_RESP = CTE.SE_DEPURADO_RESP&#xA;&#x9;,SE_ID_FECHA_NOVE = ISNULL(CTE.SE_ID_FECHA_NOVE,'1900-01-01')&#xA;&#x9;,SE_FECHA_NOVE = CASE WHEN ISNULL(CTE.SE_ID_FECHA_NOVE,'1900-01-01') = '1900-01-01' THEN 'NO DISPONIBLE' ELSE CONVERT (VARCHAR,CTE.SE_ID_FECHA_NOVE,111) END&#xA;FROM&#xA;&#x9; TMP.ME_TBCL C WITH (NOLOCK) INNER JOIN&#xA;&#x9;CTE&#xA;ON&#xA;&#x9;C.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA&#xA;WHERE&#xA;&#x9;CTE.ID = 1&#xA;AND&#xA;&#x9;C.SE_ID_NOVEDAD_ME_TBCL = '-888'&#xA;GO&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;--2. PRIORIDAD EXTERNA&#xA;WITH CTE&#xA;(&#xA;&#x9; ID&#xA;&#x9;,G_NUMERO_GUIA&#xA;&#x9;,ID_NOVEDAD_ME_TBCL&#xA;&#x9;,SE_DESC_PROC_DEPU&#xA;&#x9;,SE_DESC_CONC_DEPU&#xA;&#x9;,SE_DEPURADO_RESP&#xA;&#x9;,SE_ID_FECHA_NOVE&#xA;)&#xA;AS&#xA;&#x9;(&#xA;&#x9;&#x9;SELECT&#xA;&#x9;&#x9;&#x9; ROW_NUMBER() OVER(PARTITION BY G_NUMERO_GUIA ORDER BY FECHA_HORA_MOVIMIENTO) ID&#xA;&#x9;&#x9;&#x9;,G_NUMERO_GUIA&#xA;&#x9;&#x9;&#x9;,[ID_NOVEDAD_ME_TBCL]&#xA;&#x9;&#x9;&#x9;,SE_DESC_PROC_DEPU&#xA;&#x9;&#x9;&#x9;,SE_DESC_CONC_DEPU&#xA;&#x9;&#x9;&#x9;,SE_DEPURADO_RESP&#xA;&#x9;&#x9;&#x9;,FECHA_HORA_MOVIMIENTO AS SE_ID_FECHA_NOVE&#xA;&#x9;&#x9;FROM&#xA;&#x9;&#x9;&#x9;TMP.ME_TBCL_08 C WITH(NOLOCK)&#xA;&#x9;&#x9;WHERE&#xA;&#x9;&#x9;&#x9;SE_DEPURADO_RESP = 'E'&#xA;&#x9;)&#xA;UPDATE &#xA;&#x9;[TMP].[ME_TBCL]&#xA;SET&#xA;&#x9; SE_CUMPLE_EFIC_DEPU = CASE WHEN C.SE_CUMPLE_EFIC_DEPU = 'NO'  THEN (CASE WHEN CTE.SE_DEPURADO_RESP IN ('E','C') THEN 'SI' ELSE C.SE_CUMPLE_EFIC_DEPU END) ELSE C.SE_CUMPLE_EFIC_DEPU END &#xA;&#x9;,SE_ID_NOVEDAD_ME_TBCL = CTE.ID_NOVEDAD_ME_TBCL&#xA;&#x9;,SE_DESC_PROC_DEPU = CTE.SE_DESC_PROC_DEPU&#xA;&#x9;,SE_DESC_CONC_DEPU = CTE.SE_DESC_CONC_DEPU&#xA;&#x9;,SE_DEPURADO_NOMBRE_RESP = 'EXTERNA'&#xA;&#x9;,SE_DEPURADO_RESP = CTE.SE_DEPURADO_RESP&#xA;&#x9;,SE_ID_FECHA_NOVE = ISNULL(CTE.SE_ID_FECHA_NOVE,'1900-01-01')&#xA;&#x9;,SE_FECHA_NOVE = CASE WHEN ISNULL(CTE.SE_ID_FECHA_NOVE,'1900-01-01') = '1900-01-01' THEN 'NO DISPONIBLE' ELSE CONVERT (VARCHAR,CTE.SE_ID_FECHA_NOVE,111) END&#xA;FROM&#xA;&#x9; TMP.ME_TBCL C WITH (NOLOCK)&#xA;&#x9; INNER JOIN CTE&#xA;ON&#xA;&#x9;C.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA&#xA;WHERE&#xA;&#x9;CTE.ID = 1&#xA;AND&#xA;&#x9;C.SE_ID_NOVEDAD_ME_TBCL = '-888'&#xA;GO&#xA;--3. PRIORIDAD SERVIENTREGA&#xA;WITH CTE&#xA;(&#xA;&#x9; ID&#xA;&#x9;,G_NUMERO_GUIA&#xA;&#x9;,ID_NOVEDAD_ME_TBCL&#xA;&#x9;,SE_DESC_PROC_DEPU&#xA;&#x9;,SE_DESC_CONC_DEPU&#xA;&#x9;,SE_DEPURADO_RESP&#xA;&#x9;,SE_ID_FECHA_NOVE&#xA;)&#xA;AS&#xA;&#x9;(&#xA;&#x9;&#x9;SELECT&#xA;&#x9;&#x9;&#x9; ROW_NUMBER() OVER(PARTITION BY G_NUMERO_GUIA ORDER BY FECHA_HORA_MOVIMIENTO) ID&#xA;&#x9;&#x9;&#x9;,G_NUMERO_GUIA&#xA;&#x9;&#x9;&#x9;,[ID_NOVEDAD_ME_TBCL]&#xA;&#x9;&#x9;&#x9;,SE_DESC_PROC_DEPU&#xA;&#x9;&#x9;&#x9;,SE_DESC_CONC_DEPU&#xA;&#x9;&#x9;&#x9;,SE_DEPURADO_RESP&#xA;&#x9;&#x9;&#x9;,FECHA_HORA_MOVIMIENTO AS SE_ID_FECHA_NOVE&#xA;&#x9;&#x9;FROM&#xA;&#x9;&#x9;&#x9;TMP.ME_TBCL_08 C WITH(NOLOCK)&#xA;&#x9;&#x9;WHERE&#xA;&#x9;&#x9;&#x9;SE_DEPURADO_RESP = 'S'&#xA;&#x9;)&#xA;UPDATE &#xA;&#x9;[TMP].[ME_TBCL]&#xA;SET&#xA;&#x9; SE_CUMPLE_EFIC_DEPU = CASE WHEN C.SE_CUMPLE_EFIC_DEPU = 'NO'  THEN (CASE WHEN CTE.SE_DEPURADO_RESP IN ('E','C') THEN 'SI' ELSE C.SE_CUMPLE_EFIC_DEPU END) ELSE C.SE_CUMPLE_EFIC_DEPU END &#xA;&#x9;,SE_ID_NOVEDAD_ME_TBCL = CTE.ID_NOVEDAD_ME_TBCL&#xA;&#x9;,SE_DESC_PROC_DEPU = CTE.SE_DESC_PROC_DEPU&#xA;&#x9;,SE_DESC_CONC_DEPU = CTE.SE_DESC_CONC_DEPU&#xA;&#x9;,SE_DEPURADO_NOMBRE_RESP = 'SERVIENTREGA'&#xA;&#x9;,SE_DEPURADO_RESP = CTE.SE_DEPURADO_RESP&#xA;&#x9;,SE_ID_FECHA_NOVE = ISNULL(CTE.SE_ID_FECHA_NOVE,'1900-01-01')&#xA;&#x9;,SE_FECHA_NOVE = CASE WHEN ISNULL(CTE.SE_ID_FECHA_NOVE,'1900-01-01') = '1900-01-01' THEN 'NO DISPONIBLE' ELSE CONVERT (VARCHAR,CTE.SE_ID_FECHA_NOVE,111) END&#xA;FROM&#xA;&#x9; TMP.ME_TBCL C WITH (NOLOCK)&#xA;&#x9;INNER JOIN CTE&#xA;ON &#xA;&#x9;C.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA&#xA;WHERE&#xA;&#x9;CTE.ID = 1&#xA;AND&#xA;&#x9;C.SE_ID_NOVEDAD_ME_TBCL = '-888'&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Contenedor de secuencias\Paso 35 Actualizar Tiempo Entrega"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{3C2321F6-4DAB-441C-B6B1-191058B3C3CE}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Paso 35 Actualizar Tiempo Entrega"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{82E3C266-AD9E-4E38-9443-8FFFA079254B}"
              SQLTask:SqlStatementSource="UPDATE&#xA;&#x9;TMP.ME_TBCL&#xA;SET &#xA;&#x9;G_ID_MEDTRANS = -888&#xA;FROM &#xA;&#x9;TMP.ME_TBCL A WITH (NOLOCK)&#xA;WHERE &#xA;&#x9;A.G_ID_MEDTRANS = 0 " xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Contenedor de secuencias\Paso 36 Fecha de ingreso al CIL"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{BFF32973-CC2E-4290-A17A-E381456D4317}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Paso 36 Fecha de ingreso al CIL"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{82E3C266-AD9E-4E38-9443-8FFFA079254B}"
              SQLTask:SqlStatementSource="UPDATE &#xA;&#x9;[TMP].[ME_TBCL]&#xA;SET&#xA;&#x9; [SE_ID_FECHA_INGRESO_CIL] = SE_ID_FECHA_EBL&#xA;&#x9;,[SE_FECHA_INGRESO_CIL] =  CONVERT(VARCHAR,SE_ID_FECHA_EBL,111) &#xA;&#x9;,[SE_HORA_INGRESO_CIL] = CONVERT(VARCHAR(8),SE_ID_FECHA_EBL,114) &#xA;&#x9;,[SE_DIA_INGRESO_CIL] = CASE DATEPART(dw,SE_ID_FECHA_EBL) WHEN 2 THEN 'LUNES' WHEN 3 THEN 'MARTES' WHEN 4 THEN 'MIERCOLES' WHEN 5 THEN 'JUEVES' WHEN 6 THEN 'VIERNES' WHEN 7 THEN 'SABADO' WHEN 1 THEN 'DOMINGO' END&#xA;WHERE&#xA;&#x9;SE_ID_FECHA_EBL &lt;&gt; '1900-01-01'&#xA;GO&#xA;UPDATE &#xA;&#x9;[TMP].[ME_TBCL]&#xA;SET&#xA;&#x9; SE_ID_FECHA_INGRESO_CIL = SE_ID_FECHA_ER&#xA;&#x9;,[SE_FECHA_INGRESO_CIL] =  CONVERT(VARCHAR,SE_ID_FECHA_ER,111) &#xA;&#x9;,[SE_HORA_INGRESO_CIL] = CONVERT(VARCHAR(8),SE_ID_FECHA_ER,114) &#xA;&#x9;,[SE_DIA_INGRESO_CIL] = CASE DATEPART(dw,SE_ID_FECHA_ER) WHEN 2 THEN 'LUNES' WHEN 3 THEN 'MARTES' WHEN 4 THEN 'MIERCOLES' WHEN 5 THEN 'JUEVES' WHEN 6 THEN 'VIERNES' WHEN 7 THEN 'SABADO' WHEN 1 THEN 'DOMINGO' END&#xA;WHERE&#xA;&#x9;SE_ID_FECHA_ER &lt;&gt; '1900-01-01'&#xA;GO&#xA;UPDATE &#xA;&#x9;[TMP].[ME_TBCL]&#xA;SET&#xA;&#x9; SE_ID_FECHA_INGRESO_CIL = SE_ID_FECHA_EPS&#xA;&#x9;,[SE_FECHA_INGRESO_CIL] =  CONVERT(VARCHAR,SE_ID_FECHA_EPS,111) &#xA;&#x9;,[SE_HORA_INGRESO_CIL] = CONVERT(VARCHAR(8),SE_ID_FECHA_EPS,114) &#xA;&#x9;,[SE_DIA_INGRESO_CIL] = CASE DATEPART(dw,SE_ID_FECHA_EPS) WHEN 2 THEN 'LUNES' WHEN 3 THEN 'MARTES' WHEN 4 THEN 'MIERCOLES' WHEN 5 THEN 'JUEVES' WHEN 6 THEN 'VIERNES' WHEN 7 THEN 'SABADO' WHEN 1 THEN 'DOMINGO' END&#xA;WHERE&#xA;&#x9;SE_ID_FECHA_EPS &lt;&gt; '1900-01-01'&#xA;UPDATE &#xA;&#x9;[TMP].[ME_TBCL]&#xA;SET&#xA;&#x9; SE_ID_FECHA_INGRESO_CIL = SE_ID_FECHA_EZU&#xA;&#x9;,[SE_FECHA_INGRESO_CIL] =  CONVERT(VARCHAR,SE_ID_FECHA_EZU,111) &#xA;&#x9;,[SE_HORA_INGRESO_CIL] = CONVERT(VARCHAR(8),SE_ID_FECHA_EZU,114) &#xA;&#x9;,[SE_DIA_INGRESO_CIL] = CASE DATEPART(dw,SE_ID_FECHA_EZU) WHEN 2 THEN 'LUNES' WHEN 3 THEN 'MARTES' WHEN 4 THEN 'MIERCOLES' WHEN 5 THEN 'JUEVES' WHEN 6 THEN 'VIERNES' WHEN 7 THEN 'SABADO' WHEN 1 THEN 'DOMINGO' END&#xA;WHERE&#xA;&#x9;SE_ID_FECHA_EZU &lt;&gt; '1900-01-01'" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Contenedor de secuencias\Paso 37 Actualizar Referencia-Remision"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{5E87C6C4-703E-4639-A13C-EFDE6E80CF1A}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Paso 37 Actualizar Referencia-Remision"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{82E3C266-AD9E-4E38-9443-8FFFA079254B}"
              SQLTask:SqlStatementSource="WITH CTE&#xA;(&#xA;&#x9; G_NUMERO_GUIA&#xA;&#x9;,G_REFERENCIA&#xA;&#x9;,G_REMISION&#xA;)&#xA;AS&#xA;&#x9;(&#xA;&#x9;&#x9;SELECT &#xA;&#x9;&#x9;&#x9; TMP.G_NUMERO_GUIA&#xA;&#x9;&#x9;&#x9;,SCN.DOC_RELACIONADO AS&#x9;G_REFERENCIA&#xA;&#x9;&#x9;&#x9;,SCN.IDE_NUM_REFERENCIA_DEST AS G_REMISION&#xA;&#x9;&#x9;FROM &#xA;&#x9;&#x9;&#x9;SCN.SERT_ENVIO SCN WITH (NOLOCK)&#xA;&#x9;&#x9;INNER JOIN &#xA;&#x9;&#x9;&#x9;TMP.ME_TBCL TMP WITH (NOLOCK)&#xA;&#x9;&#x9;ON&#xA;&#x9;&#x9;&#x9;SCN.NUM_GUIA = TMP.G_NUMERO_GUIA&#xA;&#x9;)&#xA;UPDATE&#xA;&#x9;TMP.ME_TBCL&#xA;SET &#xA;&#x9; G_REFERENCIA = CASE WHEN CTE.G_REFERENCIA = '' THEN 'NO DISPONIBLE' ELSE ISNULL(CTE.G_REFERENCIA,'NO DISPONIBLE') END&#xA;&#x9;,G_REMISION = CASE WHEN CTE.G_REMISION = '' THEN 'NO DISPONIBLE' ELSE ISNULL(CTE.G_REMISION,'NO DISPONIBLE') END&#xA;FROM &#xA;&#x9; TMP.ME_TBCL TMP WITH (NOLOCK)&#xA;&#x9; INNER  JOIN CTE&#xA;ON&#xA;&#x9;TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Contenedor de secuencias\Paso 38 Actualizar Digitalizada"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{801056C3-0874-4233-8C5D-438F2B0C007B}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Paso 38 Actualizar Digitalizada"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{82E3C266-AD9E-4E38-9443-8FFFA079254B}"
              SQLTask:SqlStatementSource="WITH CTE&#xA;(&#xA;&#x9; G_NUMERO_GUIA&#xA;&#x9;,SE_PRUEBA_ENTREGA&#xA;)&#xA;AS&#xA;&#x9;(&#xA;&#x9;&#x9;SELECT &#xA;&#x9;&#x9;&#x9; TMP.G_NUMERO_GUIA&#xA;&#x9;&#x9;&#x9;,'SI' AS SE_PRUEBA_ENTREGA&#xA;&#x9;&#x9;FROM &#xA;&#x9;&#x9;&#x9;[LOG].[PRUEBAS_ENTREGA] PE WITH (NOLOCK)&#xA;&#x9;&#x9;INNER JOIN &#xA;&#x9;&#x9;&#x9;TMP.ME_TBCL TMP WITH (NOLOCK)&#xA;&#x9;&#x9;ON&#xA;&#x9;&#x9;&#x9;PE.NUMERO_GUIA = TMP.G_NUMERO_GUIA&#xA;&#x9;)&#xA;UPDATE&#xA;&#x9;TMP.ME_TBCL&#xA;SET &#xA;&#x9; SE_PRUEBA_ENTREGA = CTE.SE_PRUEBA_ENTREGA&#xA;FROM &#xA;&#x9; TMP.ME_TBCL TMP WITH (NOLOCK)&#xA;&#x9;INNER JOIN CTE&#xA;ON&#xA;&#x9;TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Contenedor de secuencias\Paso 39 Actualizar Proceso y Fecha Prim Salida"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{97A77D88-4F90-497C-A5D9-7D21E1846091}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Paso 39 Actualizar Proceso y Fecha Prim Salida"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{82E3C266-AD9E-4E38-9443-8FFFA079254B}"
              SQLTask:SqlStatementSource="UPDATE &#xA;&#x9;[TMP].[ME_TBCL]&#xA;SET&#xA;&#x9; SE_PROCE_PRIM_SALIDA = CASE WHEN SE_ID_FECHA_SZU = '1900-01-01' AND SE_ID_FECHA_SR = '1900-01-01' THEN 'NO DISPONIBLE' ELSE CASE WHEN SE_ID_FECHA_SZU &lt; SE_ID_FECHA_SR THEN CASE WHEN SE_ID_FECHA_SZU = '1900-01-01' THEN 'SALIDA REGIONAL' ELSE 'SALIDA A ZONA URBANA' END ELSE CASE WHEN SE_ID_FECHA_SR = '1900-01-01' THEN 'SALIDA A ZONA URBANA' ELSE 'SALIDA REGIONAL' END END END&#xA;&#x9;,SE_ID_FECHA_PRIM_SALIDA = CASE WHEN SE_ID_FECHA_SZU = '1900-01-01' AND SE_ID_FECHA_SR = '1900-01-01' THEN '1900-01-01' ELSE CASE WHEN SE_ID_FECHA_SZU &lt; SE_ID_FECHA_SR THEN CASE WHEN SE_ID_FECHA_SZU = '1900-01-01' THEN SE_ID_FECHA_SR ELSE SE_ID_FECHA_SZU END ELSE CASE WHEN SE_ID_FECHA_SR = '1900-01-01' THEN SE_ID_FECHA_SZU ELSE SE_ID_FECHA_SR END END END&#xA;FROM &#xA;&#x9;[TMP].[ME_TBCL]&#xA;GO&#xA;UPDATE &#xA;&#x9;[TMP].[ME_TBCL]&#xA;SET&#xA;&#x9;SE_FECHA_PRIM_SALIDA = CASE WHEN SE_ID_FECHA_SZU = '1900-01-01' THEN 'NO DISPONIBLE' ELSE CONVERT (VARCHAR,SE_ID_FECHA_SZU,111) END&#xA;FROM &#xA;&#x9;[TMP].[ME_TBCL]" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Contenedor de secuencias\Paso 43 Actualizar Bodega"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{5076f634-fb19-482e-9eb8-1a517f0c7c52}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Paso 43 Actualizar Bodega"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{82E3C266-AD9E-4E38-9443-8FFFA079254B}"
              SQLTask:SqlStatementSource="WITH CTE&#xA;(&#xA;&#x9; G_NUMERO_GUIA&#xA;&#x9;,SE_ID_BODEGA&#xA;)&#xA;AS&#xA;&#x9;(&#xA;&#x9;&#x9;SELECT&#xA;&#x9;&#x9;&#x9; G_NUMERO_GUIA&#xA;&#x9;&#x9;&#x9;,CASE PRO.ID_TIPO_PROCESO &#xA;&#x9;&#x9;&#x9;&#x9;WHEN 1 THEN &#x9;&#x9;&#x9;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;CASE WHEN ISNULL(TMP.DC_ID_CIUDAD_DESTINO,0) &gt; 0 THEN &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;CONVERT(VARCHAR(100),ISNULL(CONVERT(VARCHAR,TMP.DC_ID_PAIS_DESTINO) + '-' + CONVERT(VARCHAR,TMP.DC_ID_CIUDAD_DESTINO) + '-' + CONVERT(VARCHAR,TMP.DC_ID_DIVISION_DESTINO),'-888'))&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;ELSE &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;CONVERT(VARCHAR(100),ISNULL(CONVERT(VARCHAR,TMP.DC_ID_PAIS_DIVISION_ORIGEN) + '-' + CONVERT(VARCHAR,TMP.DC_ID_CIUDAD_DIVISION_ORIGEN) + '-' + CONVERT(VARCHAR,TMP.DC_ID_DIVISION_ORIGEN),'-888'))&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;END&#xA;&#x9;&#x9;&#x9;&#x9;ELSE &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;CASE WHEN ISNULL(TMP.DC_ID_CIUDAD_DIVISION_ORIGEN,0) &gt; 0 THEN &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;CONVERT(VARCHAR(100),ISNULL(CONVERT(VARCHAR,TMP.DC_ID_PAIS_DIVISION_ORIGEN) + '-' + CONVERT(VARCHAR,TMP.DC_ID_CIUDAD_DIVISION_ORIGEN) + '-' + CONVERT(VARCHAR,TMP.DC_ID_DIVISION_ORIGEN),'-888'))&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;ELSE &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;CONVERT(VARCHAR(100),ISNULL(CONVERT(VARCHAR,TMP.DC_ID_PAIS_DESTINO) + '-' + CONVERT(VARCHAR,TMP.DC_ID_CIUDAD_DESTINO) + '-' + CONVERT(VARCHAR,TMP.DC_ID_DIVISION_DESTINO),'-888'))&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;END&#xA;&#x9;&#x9;&#x9;END AS SE_ID_BODEGA&#xA;&#x9;&#x9;FROM &#xA;&#x9;&#x9;&#x9;[TMP].[ME_TBCL_11] TMP WITH (NOLOCK)&#xA;&#x9;&#x9;LEFT JOIN &#xA;&#x9;&#x9;&#x9;PAR.PROCESOS PRO WITH (NOLOCK)&#xA;&#x9;&#x9;ON &#xA;&#x9;&#x9;&#x9;TMP.DC_ID_PROCESO = PRO.ID_PROCESO&#xA;&#x9;)&#xA;UPDATE&#xA;&#x9;TMP.ME_TBCL&#xA;SET&#xA;&#x9;SE_ID_BODEGA = CTE.SE_ID_BODEGA&#xA;FROM&#xA;&#x9; TMP.ME_TBCL TMP WITH (NOLOCK)&#xA;&#x9;INNER JOIN CTE &#xA;ON&#xA;&#x9;TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA&#xA;--Actualizar Descriptivo&#xA;UPDATE&#xA;&#x9;[TMP].[ME_TBCL]&#xA;SET&#xA;&#x9;[SE_BODEGA] = ISNULL(DIV.[NOMBRE_DIVISION],'NO DISPONIBLE')&#xA;FROM &#xA;&#x9;[TMP].[ME_TBCL] TMP &#xA;INNER JOIN &#xA;&#x9;[PAR].[DIVISIONES] DIV&#xA;ON &#xA;&#x9;TMP.[SE_ID_BODEGA] = CONVERT(VARCHAR,DIV.[ID_PAIS]) + '-' + CONVERT(VARCHAR,DIV.[ID_CIUDAD]) + '-' + CONVERT(VARCHAR,DIV.[ID_DIVISION])&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Contenedor de secuencias\Paso 44 Actualizar ultimo Proceso, Concepto y fecha"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{B75BFAA4-B3D3-4F3A-AA01-5ADE172091C8}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Paso 44 Actualizar ultimo Proceso, Concepto y fecha"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{82E3C266-AD9E-4E38-9443-8FFFA079254B}"
              SQLTask:SqlStatementSource="WITH CTE&#xA;(&#xA;     ID&#xA;&#x9; ,G_NUMERO_GUIA&#xA;&#x9;,SE_ID_ULTI_PROCESO&#xA;&#x9;,SE_ID_ULTI_CONCEPTO&#xA;&#x9;,SE_ULTI_FECHA&#xA;)&#xA;AS&#xA;&#x9;(&#xA;&#x9;  SELECT ROW_NUMBER ( ) OVER ( PARTITION BY A.[NUMERO_GUIA] order by A.FECHA_HORA_MOVIMIENTO desc )  id &#xA;&#x9;,A.NUMERO_GUIA&#xA;&#x9;,A.ID_PROCESO&#xA;&#x9;,A.ID_CONCEPTO&#xA;&#x9;,A.FECHA_HORA_MOVIMIENTO&#xA;&#x9;FROM [TMP].[ME_TBCL_04] A  WITH (NOLOCK)&#xA;&#x9;&#x9;)&#xA;UPDATE &#xA;&#x9;[TMP].[ME_TBCL]&#xA;SET &#xA;&#x9; SE_ID_ULTI_PROCESO = ISNULL(CTE.SE_ID_ULTI_PROCESO,-888)&#xA;&#x9;,SE_ID_ULTI_CONCEPTO = ISNULL(CTE.SE_ID_ULTI_CONCEPTO,-888)&#xA;&#x9;,SE_ID_ULTI_FECHA = ISNULL(CTE.SE_ULTI_FECHA,'1900-01-01')&#xA;&#x9;,SE_ULTI_FECHA = CASE WHEN CTE.SE_ULTI_FECHA IS NULL THEN 'NO DISPONIBLE' ELSE CONVERT(VARCHAR,CTE.SE_ULTI_FECHA,111) END&#xA;FROM &#xA;&#x9; [TMP].[ME_TBCL] TMP WITH (NOLOCK)&#xA;&#x9;INNER JOIN CTE&#xA;ON&#xA;&#x9;TMP.[G_NUMERO_GUIA] = CTE.[G_NUMERO_GUIA]&#xA;&#x9;WHERE ID = 1&#xA;&#xA;--Actualizar Proceso &#xA;UPDATE &#xA;&#x9;[TMP].[ME_TBCL] &#xA;SET&#xA;&#x9;SE_ULTI_PROCESO = ISNULL(PRO.NOMBRE_PROCESO_LOG,'NO DISPONIBLE')&#xA;FROM&#xA;&#x9;[TMP].[ME_TBCL] TMP WITH (NOLOCK)&#xA;INNER JOIN&#xA;&#x9;PAR.PROCESOS PRO WITH (NOLOCK)&#xA;ON&#xA;&#x9;TMP.SE_ID_ULTI_PROCESO = PRO.ID_PROCESO&#xA;--Actualizar Concepto &#xA;UPDATE &#xA;&#x9;[TMP].[ME_TBCL] &#xA;SET&#xA;&#x9;SE_ULTI_CONCEPTO = ISNULL(ICN.NOMBRE_CONCEPTO,'NO DISPONIBLE')&#xA;FROM&#xA;&#x9;[TMP].[ME_TBCL] TMP WITH (NOLOCK)&#xA;INNER JOIN&#xA;&#x9;PAR.ITEM_CONCEPTO ICN WITH (NOLOCK)&#xA;ON&#xA;&#x9;TMP.SE_ID_ULTI_PROCESO = ICN.ID_PROCESO&#xA;AND&#xA;&#x9;TMP.SE_ID_ULTI_CONCEPTO = ICN.ID_CONCEPTO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Contenedor de secuencias\Paso 45 Actualizar Ultima Geografia"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{30E13323-E723-46B6-832C-330A37EC127E}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Paso 45 Actualizar Ultima Geografia"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{82E3C266-AD9E-4E38-9443-8FFFA079254B}"
              SQLTask:SqlStatementSource="&#xA;WITH SEG_ENVIO AS&#xA;&#x9;(&#xA;&#x9;&#x9;SELECT &#xA;&#x9;&#x9;&#x9; ROW_NUMBER() OVER(PARTITION BY [ID_PROCESO], [NUMERO_MOVIMI], [CONSECUT_MOVIMI], [NUMERO_GUIA] ORDER BY [FECHA_HORA_MOVIMIENTO] DESC ) #ROW&#xA;&#x9;&#x9;&#x9;,[NUMERO_GUIA]&#xA;&#x9;&#x9;&#x9;,[ID_PROCESO]&#xA;&#x9;&#x9;&#x9;,CASE WHEN ISNULL(CONVERT(INT,[ID_CONCEPTO]),-888) = 0 THEN -888 ELSE ISNULL(CONVERT(INT,[ID_CONCEPTO]),-888) END ID_CONCEPTO&#xA;&#x9;&#x9;&#x9;,[FECHA_HORA_MOVIMIENTO]&#xA;&#x9;&#x9;&#x9;,[NUMERO_MOVIMI]&#xA;&#x9;&#x9;&#x9;,[CONSECUT_MOVIMI]&#xA;&#x9;&#x9;FROM &#xA;&#x9;&#x9;&#x9;[TMP].[ME_TBCL_03] WITH(NOLOCK)&#xA;&#x9;&#x9;WHERE&#xA;&#x9;&#x9;&#x9;ID_PROCESO IS NOT NULL&#xA;&#x9;&#x9;OR &#xA;&#x9;&#x9;&#x9;FECHA_HORA_MOVIMIENTO IS NOT NULL&#xA;&#x9;)&#xA;, DATOS_MANI AS (&#xA;SELECT &#xA;ROW_NUMBER ( ) OVER ( PARTITION BY A.[G_NUMERO_GUIA] order by B.FECHA_HORA_MOVIMIENTO desc )  id &#xA;&#x9;,A.G_NUMERO_GUIA&#xA;&#x9;,D.ID_CIUDAD_DESTINO AS SE_ID_ULTI_CIUDAD&#xA;FROM [TMP].[ME_TBCL_11] A  WITH (NOLOCK)&#xA;&#x9;INNER JOIN SEG_ENVIO B WITH (NOLOCK) &#xA;&#x9;&#x9;ON A.G_NUMERO_GUIA = B.NUMERO_GUIA&#xA;&#x9;INNER JOIN LOG.DOCUMENTOS D WITH (NOLOCK) &#xA;&#x9;&#x9;ON&#x9;D.CONSECUT_MOVIMI = B.CONSECUT_MOVIMI &#xA;&#x9;&#x9;&#x9;AND D.ID_PROCESO = B.ID_PROCESO&#xA;&#x9;&#x9;&#x9;AND B.NUMERO_MOVIMI = D.NUMERO_MOVIMI&#xA;&#x9;LEFT JOIN [SIG_COLOMBIA_DW].[PAR].[DIVISIONES] DIV WITH (NOLOCK)&#xA;&#x9;&#x9;ON DIV.ID_DIVISION=D.ID_DIVISION_DESTINO &#xA;&#x9;&#x9;AND D.ID_CIUDAD_DESTINO=DIV.ID_CIUDAD&#xA;WHERE  #ROW = 1&#xA;)&#xA;&#xA;UPDATE&#xA;&#x9;TMP.ME_TBCL&#xA;SET&#xA;&#x9;SE_ID_ULTI_CIUDAD = ISNULL(CTE.SE_ID_ULTI_CIUDAD,-888)&#xA;FROM&#xA;&#x9; TMP.ME_TBCL TMP WITH (NOLOCK)&#xA;&#x9;INNER JOIN DATOS_MANI AS CTE &#xA;ON&#xA;&#x9;TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA&#xA;&#x9;WHERE ID = 1&#xA;&#xA;--Actualizar Descriptivo&#xA;UPDATE&#xA;&#x9;[TMP].[ME_TBCL]&#xA;SET&#xA;&#x9; SE_ULTI_CIUDAD = ISNULL(GEO.CIUDAD,'NO DISPONIBLE')&#xA;&#x9;,SE_ULTI_DEPA = ISNULL(GEO.DEPARTAMENTO,'NO DISPONIBLE')&#xA;&#x9;,SE_ULTI_REGIONAL = ISNULL(GEO.REGIONAL,'NO DISPONIBLE')&#xA;FROM &#xA;&#x9;[TMP].[ME_TBCL] TMP WITH (NOLOCK)&#xA;INNER JOIN &#xA;&#x9;DIM.GEOGRAFIA GEO WITH (NOLOCK)&#xA;ON &#xA;&#x9;TMP.SE_ID_ULTI_CIUDAD = GEO.ID_CIUDAD&#xA;&#xA;&#xA;&#xA;&#xA;/*&#xA;&#xA;WITH CTE&#xA;&#x9;(&#xA;&#x9;ID,&#xA;&#x9;G_NUMERO_GUIA,&#xA;&#x9;SE_ID_ULTI_CIUDAD&#xA;&#x9;)&#xA;&#x9;AS&#xA;&#x9;(&#xA;&#x9;SELECT ROW_NUMBER ( ) OVER ( PARTITION BY A.[G_NUMERO_GUIA] order by B.FECHA_HORA_MOVIMIENTO desc )  id &#xA;&#x9;,A.G_NUMERO_GUIA&#xA;&#x9;,D.ID_CIUDAD_DESTINO&#xA;&#x9;FROM [TMP].[ME_TBCL_11] A  WITH (NOLOCK)&#xA;&#x9;INNER JOIN LOG.SEGUIMIENTO_ENVIO B WITH (NOLOCK) ON A.G_NUMERO_GUIA = B.NUMERO_GUIA&#xA;&#x9;INNER JOIN LOG.DOCUMENTOS D WITH (NOLOCK) ON D.CONSECUT_MOVIMI = B.CONSECUT_MOVIMI AND D.ID_PROCESO = B.ID_PROCESO&#xA;&#x9;AND B.NUMERO_MOVIMI = D.NUMERO_MOVIMI&#xA;&#x9;LEFT JOIN [SIG_COLOMBIA_DW].[PAR].[DIVISIONES] DIV WITH (NOLOCK)&#xA;&#x9;ON DIV.ID_DIVISION=D.ID_DIVISION_DESTINO AND D.ID_CIUDAD_DESTINO=DIV.ID_CIUDAD&#xA;&#x9;&#x9;)&#xA;UPDATE&#xA;&#x9;TMP.ME_TBCL&#xA;SET&#xA;&#x9;SE_ID_ULTI_CIUDAD = ISNULL(CTE.SE_ID_ULTI_CIUDAD,-888)&#xA;FROM&#xA;&#x9; TMP.ME_TBCL TMP WITH (NOLOCK)&#xA;&#x9;INNER JOIN CTE &#xA;ON&#xA;&#x9;TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA&#xA;&#x9;WHERE ID = 1&#xA;--Actualizar Descriptivo&#xA;UPDATE&#xA;&#x9;[TMP].[ME_TBCL]&#xA;SET&#xA;&#x9; SE_ULTI_CIUDAD = ISNULL(GEO.CIUDAD,'NO DISPONIBLE')&#xA;&#x9;,SE_ULTI_DEPA = ISNULL(GEO.DEPARTAMENTO,'NO DISPONIBLE')&#xA;&#x9;,SE_ULTI_REGIONAL = ISNULL(GEO.REGIONAL,'NO DISPONIBLE')&#xA;FROM &#xA;&#x9;[TMP].[ME_TBCL] TMP WITH (NOLOCK)&#xA;INNER JOIN &#xA;&#x9;DIM.GEOGRAFIA GEO WITH (NOLOCK)&#xA;ON &#xA;&#x9;TMP.SE_ID_ULTI_CIUDAD = GEO.ID_CIUDAD&#xA;&#xA;*/" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Contenedor de secuencias\Paso 46 Armar Base Novedades"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{57EBB098-6282-4158-BF97-F9AC528290F6}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Paso 46 Armar Base Novedades"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{82E3C266-AD9E-4E38-9443-8FFFA079254B}"
              SQLTask:SqlStatementSource="INSERT INTO &#xA;&#x9;[TMP].[ME_TBCL_NOVEDADES]&#xA;(&#xA;&#x9; [G_NUMERO_GUIA]&#xA;&#x9;,[G_NOMBRE_NOVEDAD]&#xA;&#x9;,[G_TIPO_NOVEDAD]&#xA;&#x9;,[G_SUBTIPO_NOVEDAD]&#xA;&#x9;,[DETND_FECHA_NOVEDAD]&#xA;)&#xA;SELECT&#xA;&#x9; TMP.G_NUMERO_GUIA &#xA;&#x9;,TIPN.NOMBRE_TIPO_NOVEDAD AS NOMBRE_NOVEDAD&#xA;&#x9;,CASE WHEN TIPN.[ES_NOVEDAD_EXTERNA] = 1 THEN 'EXTERNA' ELSE 'INTERNA' END  TIPO_NOVEDAD&#xA;&#x9;,ISNULL(PAR.NOMBRE_SUBTIPO_NOVEDAD,'NO DISPONIBLE') AS  [SUBTIPO_NOVEDAD]&#xA;&#x9;,TMP04.FECHA_HORA_MOVIMIENTO AS DETND_FECHA_NOVEDAD&#xA;FROM [TMP].[ME_TBCL] TMP WITH (NOLOCK)&#xA;INNER JOIN  [TMP].[ME_TBCL_04] TMP04 WITH (NOLOCK)&#xA;&#x9;ON  [TMP].[G_NUMERO_GUIA] = [TMP04].[NUMERO_GUIA]&#xA;INNER JOIN  [LOG].[DOCUMENTOS_NOVEDAD_DIARIA] DOCND WITH(NOLOCK)&#xA;&#x9;ON  [DOCND].[ID_PROCESO] = [TMP04].[ID_PROCESO]&#xA;&#x9;&#x9;AND  [DOCND].[NUMERO_MOVIMI] = [TMP04].[NUMERO_MOVIMI]&#xA;&#x9;&#x9;AND  [DOCND].[CONSECUT_MOVIMI] = [TMP04].[CONSECUT_MOVIMI]&#xA;INNER JOIN  [LOG].[NOVEDAD_DIARIA] ND WITH(NOLOCK)&#xA;&#x9;ON &#x9;[DOCND].[ID_PAIS_UNO] = [ND].[ID_PAIS_UNO]&#xA;&#x9;&#x9;AND  [DOCND].[ID_CIUDAD_UNO] = [ND].[ID_CIUDAD_UNO]&#xA;&#x9;&#x9;AND  [DOCND].[FECHA_NOVEDAD] = [ND].[FECHA_NOVEDAD]&#xA;INNER JOIN  [PAR].[TIPOSNOVEDADESOPERATIVAS] TIPN WITH (NOLOCK)&#xA;&#x9;ON  [ND].[ID_TIPO_NOVEDAD] = [TIPN].[ID_TIPO_NOVEDAD]&#xA;LEFT JOIN  [LOG].[DETALLE_NOVEDAD_DIARIA] DETND WITH(NOLOCK)&#xA;&#x9;ON  [DOCND].[ID_PAIS_UNO] = [DETND].[ID_PAIS_UNO]&#xA;&#x9;&#x9;AND [DOCND].[ID_CIUDAD_UNO] = [DETND].[ID_CIUDAD_UNO]&#xA;&#x9;&#x9;AND [DOCND].[FECHA_NOVEDAD] = [DETND].[FECHA_NOVEDAD]&#xA;LEFT JOIN  [PAR].[SUBTIPOS_NOVEDADES_OPERATIVAS] PAR WITH (NOLOCK)&#xA;&#x9;ON  [TIPN].[ID_TIPO_NOVEDAD] = [PAR].[ID_TIPO_NOVEDAD]&#xA;&#x9;&#x9;AND [DETND].[ID_SUBTIPO_NOVEDAD] = [PAR].[ID_SUBTIPO_NOVEDAD]&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;/*&#xA;INSERT INTO &#xA;&#x9;[TMP].[ME_TBCL_NOVEDADES]&#xA;(&#xA;&#x9; [G_NUMERO_GUIA]&#xA;&#x9;,[G_NOMBRE_NOVEDAD]&#xA;&#x9;,[G_TIPO_NOVEDAD]&#xA;&#x9;,[G_SUBTIPO_NOVEDAD]&#xA;&#x9;,[DETND_FECHA_NOVEDAD]&#xA;)&#xA;SELECT&#xA;&#x9; TMP.G_NUMERO_GUIA &#xA;&#x9;,TIPN.NOMBRE_TIPO_NOVEDAD AS NOMBRE_NOVEDAD&#xA;&#x9;,CASE WHEN TIPN.[ES_NOVEDAD_EXTERNA] = 1 THEN 'EXTERNA' ELSE 'INTERNA' END  TIPO_NOVEDAD&#xA;&#x9;,ISNULL(PAR.NOMBRE_SUBTIPO_NOVEDAD,'NO DISPONIBLE') AS  [SUBTIPO_NOVEDAD]&#xA;&#x9;,TMP04.FECHA_HORA_MOVIMIENTO AS DETND_FECHA_NOVEDAD&#xA;FROM&#xA;&#x9;[LOG].[DOCUMENTOS_NOVEDAD_DIARIA] DOCND WITH(NOLOCK)&#xA;INNER JOIN&#xA;&#x9;[LOG].[NOVEDAD_DIARIA] ND WITH(NOLOCK)&#xA;ON&#xA;&#x9;[DOCND].[ID_PAIS_UNO] = [ND].[ID_PAIS_UNO]&#xA;AND&#xA;&#x9;[DOCND].[ID_CIUDAD_UNO] = [ND].[ID_CIUDAD_UNO]&#xA;AND&#xA;&#x9;[DOCND].[FECHA_NOVEDAD] = [ND].[FECHA_NOVEDAD]&#xA;INNER JOIN&#xA;&#x9;[TMP].[ME_TBCL_04] TMP04 WITH (NOLOCK)&#xA;ON&#xA;&#x9;[DOCND].[ID_PROCESO] = [TMP04].[ID_PROCESO]&#xA;AND &#xA;&#x9;[DOCND].[NUMERO_MOVIMI] = [TMP04].[NUMERO_MOVIMI]&#xA;AND&#xA;&#x9;[DOCND].[CONSECUT_MOVIMI] = [TMP04].[CONSECUT_MOVIMI]&#xA;INNER JOIN &#xA;&#x9;[TMP].[ME_TBCL] TMP WITH (NOLOCK)&#xA;ON &#xA;&#x9;[TMP].[G_NUMERO_GUIA] = [TMP04].[NUMERO_GUIA]&#xA;INNER JOIN &#xA;&#x9;[PAR].[TIPOSNOVEDADESOPERATIVAS] TIPN WITH (NOLOCK)&#xA;ON&#xA;&#x9;[ND].[ID_TIPO_NOVEDAD] = [TIPN].[ID_TIPO_NOVEDAD]&#xA;LEFT JOIN&#xA;&#x9;[LOG].[DETALLE_NOVEDAD_DIARIA] DETND WITH(NOLOCK)&#xA;ON&#xA;&#x9;[DOCND].[ID_PAIS_UNO] = [DETND].[ID_PAIS_UNO]&#xA;AND&#xA;&#x9;[DOCND].[ID_CIUDAD_UNO] = [DETND].[ID_CIUDAD_UNO]&#xA;AND&#xA;&#x9;[DOCND].[FECHA_NOVEDAD] = [DETND].[FECHA_NOVEDAD]&#xA;LEFT JOIN&#xA;&#x9;[PAR].[SUBTIPOS_NOVEDADES_OPERATIVAS] PAR WITH (NOLOCK)&#xA;ON&#xA;&#x9;[TIPN].[ID_TIPO_NOVEDAD] = [PAR].[ID_TIPO_NOVEDAD]&#xA;AND &#xA;&#x9;[DETND].[ID_SUBTIPO_NOVEDAD] = [PAR].[ID_SUBTIPO_NOVEDAD]&#xA;*/" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Contenedor de secuencias\Sequence Container"
          DTS:CreationName="STOCK:SEQUENCE"
          DTS:Description="Sequence Container"
          DTS:DTSID="{E6A8A02F-E0AE-4AB5-97E4-1341120930C1}"
          DTS:ExecutableType="STOCK:SEQUENCE"
          DTS:LocaleID="-1"
          DTS:ObjectName="Sequence Container">
          <DTS:Variables />
          <DTS:Executables>
            <DTS:Executable
              DTS:refId="Package\Contenedor de secuencias\Sequence Container\Paso 25 Obtener horas de red operativa de la guía"
              DTS:CreationName="Microsoft.ExecuteSQLTask"
              DTS:Description="Execute SQL Task"
              DTS:DTSID="{2CDE5FB0-9863-410B-B028-C68CDA4E5A0A}"
              DTS:ExecutableType="Microsoft.ExecuteSQLTask"
              DTS:LocaleID="-1"
              DTS:ObjectName="Paso 25 Obtener horas de red operativa de la guía"
              DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
              DTS:ThreadHint="0">
              <DTS:Variables />
              <DTS:ObjectData>
                <SQLTask:SqlTaskData
                  SQLTask:Connection="{82E3C266-AD9E-4E38-9443-8FFFA079254B}"
                  SQLTask:SqlStatementSource="INSERT INTO TMP.ME_TBCL_05&#xA;(&#xA;&#x9; G_NUMERO_GUIA&#xA;&#x9;,SE_FECHA&#xA;&#x9;,TIEMPO_OFERTA_DIA&#xA;&#x9;,SE_ID_DIA_HABIL_EZU&#xA;&#x9;,SE_FECHA_HABIL_EZU&#xA;)&#xA;SELECT &#xA;&#x9; TMP.G_NUMERO_GUIA&#xA;&#x9;,TMP.SE_FECHA&#xA;&#x9;,ISNULL(R.TIEMPO_ENTREGA_COMERCIAL_DIA,0) TIEMPO_OFERTA_DIA&#xA;&#x9;,SE_ID_DIA_HABIL_EZU&#xA;&#x9;,SE_FECHA_HABIL_EZU&#xA;FROM&#xA;&#x9;TMP.ME_TBCL TMP WITH(NOLOCK) &#xA;INNER JOIN&#xA;&#x9;TMP.ME_TBCL_RED_OPERATIVA_RUTA_ACTIVA RA WITH(NOLOCK) &#xA;ON&#xA;&#x9;TMP.G_ID_CIUDAD_ORIGEN = RA.ID_CIUDAD_ORIGEN&#xA;AND&#xA;&#x9;TMP.G_ID_CIUDAD_DESTINO = RA.ID_CIUDAD_DESTINO&#xA;AND&#xA;&#x9;CASE WHEN ISNULL(TMP.G_ID_TIEMPO,0) &lt;&gt; 0 THEN TMP.G_ID_TIEMPO ELSE 1 END = RA.ID_TIEMPO&#xA;AND&#xA;&#x9;CASE WHEN ISNULL(TMP.G_ID_MEDTRANS,0) &lt;&gt; 0 THEN TMP.G_ID_MEDTRANS ELSE 1 END = RA.ID_MEDTRANS&#xA;INNER JOIN&#xA;&#x9;SIG_COL_LOGISTICA_DW.DIM.RED_OPERATIVA_RUTA  R WITH(NOLOCK) &#xA;ON&#xA;&#x9;RA.ID_RUTA = R.ID_RUTA&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;/*&#xA;INSERT INTO TMP.ME_TBCL_05&#xA;(&#xA;&#x9; G_NUMERO_GUIA&#xA;&#x9;,SE_FECHA&#xA;&#x9;,TIEMPO_OFERTA_DIA&#xA;&#x9;,SE_ID_DIA_HABIL_EZU&#xA;&#x9;,SE_FECHA_HABIL_EZU&#xA;)&#xA;SELECT &#xA;&#x9; TMP.G_NUMERO_GUIA&#xA;&#x9;,TMP.SE_FECHA&#xA;&#x9;,ISNULL(R.TIEMPO_ENTREGA_COMERCIAL_DIA,0) TIEMPO_OFERTA_DIA&#xA;&#x9;,SE_ID_DIA_HABIL_EZU&#xA;&#x9;,SE_FECHA_HABIL_EZU&#xA;FROM&#xA;&#x9;TMP.ME_TBCL TMP WITH(NOLOCK) &#xA;INNER JOIN&#xA;&#x9;TMP.ME_TBCL_RED_OPERATIVA_RUTA_ACTIVA RA WITH(NOLOCK) &#xA;ON&#xA;&#x9;TMP.G_ID_CIUDAD_ORIGEN = RA.ID_CIUDAD_ORIGEN&#xA;AND&#xA;&#x9;TMP.G_ID_CIUDAD_DESTINO = RA.ID_CIUDAD_DESTINO&#xA;AND&#xA;&#x9;CASE WHEN ISNULL(TMP.G_ID_TIEMPO,0) &lt;&gt; 0 THEN TMP.G_ID_TIEMPO ELSE 1 END = RA.ID_TIEMPO&#xA;AND&#xA;&#x9;CASE WHEN ISNULL(TMP.G_ID_MEDTRANS,0) &lt;&gt; 0 THEN TMP.G_ID_MEDTRANS ELSE 1 END = RA.ID_MEDTRANS&#xA;INNER JOIN&#xA;&#x9;TMP.ME_TBCL_RED_OPERATIVA_RUTA R WITH(NOLOCK) &#xA;ON&#xA;&#x9;RA.ID_RUTA = R.ID_RUTA&#xA;*/" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
              </DTS:ObjectData>
            </DTS:Executable>
            <DTS:Executable
              DTS:refId="Package\Contenedor de secuencias\Sequence Container\Paso 26 Obtener la fecha de entrega Red Operativa"
              DTS:CreationName="Microsoft.ExecuteSQLTask"
              DTS:Description="Execute SQL Task"
              DTS:DTSID="{2D26D282-B90E-4BB9-8BA7-DED42F8EF107}"
              DTS:ExecutableType="Microsoft.ExecuteSQLTask"
              DTS:LocaleID="-1"
              DTS:ObjectName="Paso 26 Obtener la fecha de entrega Red Operativa"
              DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
              DTS:ThreadHint="0">
              <DTS:Variables />
              <DTS:ObjectData>
                <SQLTask:SqlTaskData
                  SQLTask:Connection="{82E3C266-AD9E-4E38-9443-8FFFA079254B}"
                  SQLTask:SqlStatementSource="WITH CTE&#xA;(&#xA;&#x9; G_NUMERO_GUIA&#xA;&#x9;,SE_ID_FECHA_ENTREGA&#xA;&#x9;,SE_FECHA_ENTREGA&#xA;&#x9;,SE_TIEMPO_MATRIZ&#xA;)&#xA;AS&#xA;&#x9;(&#xA;&#x9;&#x9;SELECT &#xA;&#x9;&#x9;&#x9; C.G_NUMERO_GUIA&#xA;&#x9;&#x9;&#x9;,F.FECHA SE_ID_FECHA_ENTREGA &#xA;&#x9;&#x9;&#x9;,F.ID_DIA_HABIL SE_FECHA_ENTREGA&#xA;&#x9;&#x9;&#x9;,C.TIEMPO_OFERTA_DIA SE_TIEMPO_MATRIZ&#xA;  &#x9;&#x9;FROM&#xA;&#x9;&#x9;&#x9;TMP.ME_TBCL_05 C WITH(NOLOCK)&#xA;&#x9;&#x9;INNER JOIN&#xA;&#x9;&#x9;&#x9;TMP.ME_TBCL_DHABIL_NO_D F WITH(NOLOCK)&#xA;&#x9;&#x9;ON&#xA;&#x9;&#x9;&#x9;CONVERT(INT,C.TIEMPO_OFERTA_DIA + C.SE_ID_DIA_HABIL_EZU) = F.ID_DIA_HABIL&#xA;&#x9;)&#xA;UPDATE &#xA;&#x9;[TMP].[ME_TBCL]&#xA;SET&#xA;&#x9; SE_ID_FECHA_ENTREGA = CTE.SE_ID_FECHA_ENTREGA&#xA;&#x9;,SE_FECHA_ENTREGA = CONVERT(VARCHAR,CTE.SE_ID_FECHA_ENTREGA,111)&#xA;&#x9;,SE_TIEMPO_MATRIZ = ISNULL(CTE.SE_TIEMPO_MATRIZ,0)&#xA;FROM&#xA;&#x9;TMP.ME_TBCL TMP WITH (NOLOCK) INNER JOIN CTE&#xA;ON&#xA;&#x9;TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
              </DTS:ObjectData>
            </DTS:Executable>
            <DTS:Executable
              DTS:refId="Package\Contenedor de secuencias\Sequence Container\Paso 27 Obtener la fecha de entrega Hoy Mismo"
              DTS:CreationName="Microsoft.ExecuteSQLTask"
              DTS:Description="Execute SQL Task"
              DTS:DTSID="{CD41F5D6-9652-4787-9A99-6AD14858D763}"
              DTS:ExecutableType="Microsoft.ExecuteSQLTask"
              DTS:LocaleID="-1"
              DTS:ObjectName="Paso 27 Obtener la fecha de entrega Hoy Mismo"
              DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
              DTS:ThreadHint="0">
              <DTS:Variables />
              <DTS:ObjectData>
                <SQLTask:SqlTaskData
                  SQLTask:Connection="{82E3C266-AD9E-4E38-9443-8FFFA079254B}"
                  SQLTask:SqlStatementSource="UPDATE &#xA;&#x9;[TMP].[ME_TBCL]&#xA;SET&#xA;&#x9; SE_ID_FECHA_ENTREGA = SE_FECHA_HABIL_EZU&#xA;&#x9;,SE_FECHA_ENTREGA = CONVERT (VARCHAR,SE_FECHA_HABIL_EZU,111)&#xA;&#x9;,SE_TIEMPO_MATRIZ = 1&#xA;FROM &#xA;&#x9;[TMP].[ME_TBCL] WITH (NOLOCK)&#xA;WHERE&#xA;&#x9;G_ID_TIEMPO = 2" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
              </DTS:ObjectData>
            </DTS:Executable>
            <DTS:Executable
              DTS:refId="Package\Contenedor de secuencias\Sequence Container\Paso 28 Obtener la fecha de entrega Cero Horas"
              DTS:CreationName="Microsoft.ExecuteSQLTask"
              DTS:Description="Execute SQL Task"
              DTS:DTSID="{535BC1D0-7649-4E56-AA8F-522126671D6D}"
              DTS:ExecutableType="Microsoft.ExecuteSQLTask"
              DTS:LocaleID="-1"
              DTS:ObjectName="Paso 28 Obtener la fecha de entrega Cero Horas"
              DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
              DTS:ThreadHint="0">
              <DTS:Variables />
              <DTS:ObjectData>
                <SQLTask:SqlTaskData
                  SQLTask:Connection="{82E3C266-AD9E-4E38-9443-8FFFA079254B}"
                  SQLTask:SqlStatementSource="WITH CTE&#xA;(&#xA;&#x9; G_NUMERO_GUIA&#xA;&#x9;,SE_ID_FECHA_ENTREGA&#xA;)&#xA;AS&#xA;&#x9;(&#xA;&#x9;&#x9;SELECT &#xA;&#x9;&#x9;&#x9; C.G_NUMERO_GUIA&#xA;&#x9;&#x9;&#x9;,F.FECHA SE_ID_FECHA_ENTREGA &#xA;&#x9;&#x9;FROM&#xA;&#x9;&#x9;&#x9;TMP.ME_TBCL C WITH(NOLOCK)&#xA;&#x9;&#x9;INNER JOIN&#xA;&#x9;&#x9;&#x9;TMP.ME_TBCL_DHABIL_NO_D F WITH(NOLOCK)&#xA;&#x9;&#x9;ON&#xA;&#x9;&#x9;&#x9;CONVERT(INT,1 + C.SE_ID_DIA_HABIL_EZU) = F.ID_DIA_HABIL&#xA;&#x9;&#x9;WHERE&#xA;&#x9;&#x9;&#x9;C.G_ID_TIEMPO = 3&#xA;&#x9;)&#xA;UPDATE &#xA;&#x9;[TMP].[ME_TBCL]&#xA;SET&#xA;&#x9; SE_ID_FECHA_ENTREGA = DATEADD(HOUR, 9, CAST(CAST(CTE.SE_ID_FECHA_ENTREGA AS DATE) AS DATETIME))&#xA;&#x9;,SE_FECHA_ENTREGA = CONVERT(VARCHAR,DATEADD(HOUR, 9, CAST(CAST(CTE.SE_ID_FECHA_ENTREGA AS DATE) AS DATETIME)),111)&#xA;&#x9;,SE_TIEMPO_MATRIZ = 2&#xA;FROM&#xA;&#x9;TMP.ME_TBCL TMP WITH (NOLOCK) INNER JOIN CTE&#xA;ON&#xA;&#x9;TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
              </DTS:ObjectData>
            </DTS:Executable>
            <DTS:Executable
              DTS:refId="Package\Contenedor de secuencias\Sequence Container\Paso 29 Calcular Cumple Eficiencia"
              DTS:CreationName="Microsoft.ExecuteSQLTask"
              DTS:Description="Execute SQL Task"
              DTS:DTSID="{275986E2-159B-45A5-AAE3-5BE91A6A7987}"
              DTS:ExecutableType="Microsoft.ExecuteSQLTask"
              DTS:LocaleID="-1"
              DTS:ObjectName="Paso 29 Calcular Cumple Eficiencia"
              DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
              DTS:ThreadHint="0">
              <DTS:Variables />
              <DTS:ObjectData>
                <SQLTask:SqlTaskData
                  SQLTask:Connection="{82E3C266-AD9E-4E38-9443-8FFFA079254B}"
                  SQLTask:SqlStatementSource="UPDATE &#xA;&#x9;[TMP].[ME_TBCL]&#xA;SET&#xA;&#x9;SE_CUMPLE_EFIC = CASE WHEN G_ID_TIEMPO = 3 AND SE_ID_FECHA_TIPO_ESTADO_ENVIO &lt;= SE_ID_FECHA_ENTREGA THEN 'SI'&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  WHEN G_ID_TIEMPO &lt;&gt; 3 AND CONVERT (DATE,SE_ID_FECHA_TIPO_ESTADO_ENVIO) &lt;= CONVERT (DATE,SE_ID_FECHA_ENTREGA) THEN 'SI' &#xA;&#x9;&#x9;&#x9;&#x9;&#x9; ELSE 'NO' END,&#xA;&#x9;SE_CUMPLE_EFIC_DEPU = CASE WHEN G_ID_TIEMPO = 3 AND SE_ID_FECHA_TIPO_ESTADO_ENVIO &lt;= SE_ID_FECHA_ENTREGA THEN 'SI'&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;   WHEN G_ID_TIEMPO &lt;&gt; 3 AND CONVERT (DATE,SE_ID_FECHA_TIPO_ESTADO_ENVIO) &lt;= CONVERT (DATE,SE_ID_FECHA_ENTREGA) THEN 'SI' &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  ELSE 'NO' END&#xA;FROM &#xA;&#x9;TMP.ME_TBCL WITH (NOLOCK)&#xA;WHERE&#xA;&#x9;SE_TIPO_ESTADO_ENVIO IN (1,2)&#xA;AND &#xA;&#x9;SE_ID_FECHA_ENTREGA  &lt;&gt; '1900-01-01'" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
              </DTS:ObjectData>
            </DTS:Executable>
            <DTS:Executable
              DTS:refId="Package\Contenedor de secuencias\Sequence Container\Paso 30 Obtener placa de promesa depurada"
              DTS:CreationName="Microsoft.ExecuteSQLTask"
              DTS:Description="Execute SQL Task"
              DTS:DTSID="{9E59E3B2-5688-4D58-84FA-A74EC32C2512}"
              DTS:ExecutableType="Microsoft.ExecuteSQLTask"
              DTS:LocaleID="-1"
              DTS:ObjectName="Paso 30 Obtener placa de promesa depurada"
              DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
              DTS:ThreadHint="0">
              <DTS:Variables />
              <DTS:ObjectData>
                <SQLTask:SqlTaskData
                  SQLTask:Connection="{82E3C266-AD9E-4E38-9443-8FFFA079254B}"
                  SQLTask:SqlStatementSource="WITH CTE&#xA;(&#xA;&#x9; G_NUMERO_GUIA&#xA;&#x9;,ID_PROCESO&#xA;&#x9;,NUMERO_MOVIMI&#xA;&#x9;,CONSECUT_MOVIMI&#xA;&#x9;,FECHA_HORA_MOVIMIENTO&#xA;)&#xA;AS&#xA;&#x9;(&#xA;&#x9;&#x9;SELECT&#xA;&#x9;&#x9;&#x9; C.G_NUMERO_GUIA&#xA;&#x9;&#x9;&#x9;,P.ID_PROCESO&#xA;&#x9;&#x9;&#x9;,P.NUMERO_MOVIMI&#xA;&#x9;&#x9;&#x9;,P.CONSECUT_MOVIMI&#xA;&#x9;&#x9;&#x9;,P.FECHA_HORA_MOVIMIENTO&#xA;&#x9;&#x9;FROM&#xA;&#x9;&#x9;&#x9;TMP.ME_TBCL C WITH(NOLOCK)&#xA;&#x9;&#x9;INNER JOIN&#xA;&#x9;&#x9;&#x9;TMP.ME_TBCL_04 P WITH(NOLOCK)&#xA;&#x9;&#x9;ON&#xA;&#x9;&#x9;&#x9;C.G_NUMERO_GUIA = P.NUMERO_GUIA&#xA;&#x9;&#x9;WHERE&#xA;&#x9;&#x9;&#x9;P.ID_PROCESO = 12&#xA;&#x9;)&#xA;INSERT INTO TMP.ME_TBCL_06&#xA;(&#xA;&#x9; G_NUMERO_GUIA&#xA;&#x9;,ID_PROCESO&#xA;&#x9;,NUMERO_MOVIMI&#xA;&#x9;,CONSECUT_MOVIMI&#xA;&#x9;,PLACA_VEHICULO_DOCU&#xA;&#x9;,FECHA_HORA_MOVIMIENTO&#xA;)&#xA;SELECT&#xA;&#x9; CTE.G_NUMERO_GUIA&#xA;&#x9;,CTE.ID_PROCESO&#xA;&#x9;,CTE.NUMERO_MOVIMI&#xA;&#x9;,CTE.CONSECUT_MOVIMI&#xA;&#x9;,D.PLACA_VEHICULO_DOCU&#xA;&#x9;,CTE.FECHA_HORA_MOVIMIENTO&#xA;FROM&#xA;&#x9;[LOG].DOCUMENTOS D  WITH(NOLOCK) INNER JOIN CTE &#xA;ON&#xA;&#x9;D.ID_PROCESO = CTE.ID_PROCESO&#xA;AND&#xA;&#x9;D.NUMERO_MOVIMI = CTE.NUMERO_MOVIMI&#xA;AND&#xA;&#x9;D.CONSECUT_MOVIMI = CTE.CONSECUT_MOVIMI" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
              </DTS:ObjectData>
            </DTS:Executable>
            <DTS:Executable
              DTS:refId="Package\Contenedor de secuencias\Sequence Container\Paso 31 Obtener guias depuradas con noveadad"
              DTS:CreationName="Microsoft.ExecuteSQLTask"
              DTS:Description="Execute SQL Task"
              DTS:DTSID="{C7EABBCA-0A5E-42A5-ACED-C828F4BE13BD}"
              DTS:ExecutableType="Microsoft.ExecuteSQLTask"
              DTS:LocaleID="-1"
              DTS:ObjectName="Paso 31 Obtener guias depuradas con noveadad"
              DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
              DTS:ThreadHint="0">
              <DTS:Variables />
              <DTS:ObjectData>
                <SQLTask:SqlTaskData
                  SQLTask:Connection="{82E3C266-AD9E-4E38-9443-8FFFA079254B}"
                  SQLTask:SqlStatementSource="INSERT INTO TMP.ME_TBCL_07&#xA;(&#xA;&#x9; G_NUMERO_GUIA&#xA;&#x9;,ID_NOVEDAD_ME_TBCL&#xA;&#x9;,NOMBRE_TIPO_NOVEDAD&#xA;&#x9;,NOMBRE_NOVEDAD&#xA;&#x9;,RESP&#xA;&#x9;,FECHA_HORA_MOVIMIENTO&#xA;)&#xA;&#x9;SELECT&#xA;&#x9; CLI.G_NUMERO_GUIA&#xA;&#x9;,'NOVE'+'-'+ CONVERT (VARCHAR,[TNO].[ID_TIPO_NOVEDAD]) ID_NOVEDAD_ME_TBCL&#xA;&#x9;,TNO.NOMBRE_TIPO_NOVEDAD&#xA;&#x9;,TNO.NOMBRE_NOVEDAD&#xA;&#x9;,TNO.RESP&#xA;&#x9;,CLI.FECHA_HORA_MOVIMIENTO&#xA;FROM&#xA;&#x9;[LOG].[DETALLE_NOVEDAD_DIARIA] DETND WITH(NOLOCK)&#xA;INNER JOIN&#xA;&#x9;[LOG].[DOCUMENTOS_NOVEDAD_DIARIA] DOCND WITH(NOLOCK)&#xA;ON&#xA;&#x9;DETND.[ID_PAIS_UNO] = DOCND.[ID_PAIS_UNO]&#xA;AND&#xA;&#x9;DETND.ID_CIUDAD_UNO = DOCND.ID_CIUDAD_UNO&#xA;INNER JOIN&#xA;&#x9;[LOG].[NOVEDAD_DIARIA] ND WITH(NOLOCK)&#xA;ON&#xA;&#x9;DETND.[ID_PAIS_UNO] = ND.[ID_PAIS_UNO]&#xA;AND&#xA;&#x9;DETND.ID_CIUDAD_UNO = ND.ID_CIUDAD_UNO&#xA;INNER JOIN&#xA;&#x9;[PAR].[TBCL_DEPU_NOVE] TNO&#xA;ON&#xA;&#x9;ND.[ID_TIPO_NOVEDAD] = TNO.ID_TIPO_NOVEDAD&#xA;INNER JOIN&#xA;&#x9;[TMP].[ME_TBCL_06] CLI&#xA;ON&#xA;&#x9;DOCND.[ID_PROCESO] = CLI.[ID_PROCESO]&#xA;AND      &#xA;&#x9;DOCND.[NUMERO_MOVIMI] = CLI.[NUMERO_MOVIMI]&#xA;AND    &#xA;&#x9;DOCND.[CONSECUT_MOVIMI] = CLI.[CONSECUT_MOVIMI]&#xA;AND&#xA;&#x9;DETND.[PLACA_VEHICULO_DOCU] = CLI.[PLACA_VEHICULO_DOCU]&#xA;WHERE&#xA;&#x9;DETND.[FECHA_NOVEDAD] = DOCND.[FECHA_NOVEDAD]&#xA;AND&#xA;&#x9;DETND.[FECHA_NOVEDAD] = ND.[FECHA_NOVEDAD]" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
              </DTS:ObjectData>
            </DTS:Executable>
            <DTS:Executable
              DTS:refId="Package\Contenedor de secuencias\Sequence Container\Paso 32 Obtener noveadades y procesos DEPURADA"
              DTS:CreationName="Microsoft.ExecuteSQLTask"
