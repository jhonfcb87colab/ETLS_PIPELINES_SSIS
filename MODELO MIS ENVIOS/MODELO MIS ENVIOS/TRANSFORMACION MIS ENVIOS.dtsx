              DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
              DTS:ThreadHint="5">
              <DTS:Variables />
              <DTS:ObjectData>
                <SQLTask:SqlTaskData
                  SQLTask:Connection="{82E3C266-AD9E-4E38-9443-8FFFA079254B}"
                  SQLTask:SqlStatementSource="UPDATE&#xA;&#x9;[TMP].[ME_TBCL]&#xA;SET&#xA;&#x9; PQR_ID_EST_INDEM =&#x9;ISNULL(PQR.[PQR_ESTADO_INDEMIZACION],-888)&#xA;&#x9;,PQR_EST_INDEM = ISNULL(PQR.[PQR_NOMBRE_ESTADO_INDEMIZACION],'NO DISPONIBLE')&#xA;&#x9;,PQR_ID_FECHA_EST_INDEM = ISNULL(PQR.[PQR_FECHA_ESTADO_INDEMIZACION],'1900-01-01')&#xA;&#x9;,PQR_FECHA_EST_INDEM = CASE WHEN PQR.[PQR_FECHA_ESTADO_INDEMIZACION] IS NULL THEN 'NO DISPONIBLE' ELSE CONVERT (VARCHAR,PQR.[PQR_FECHA_ESTADO_INDEMIZACION],111) END &#xA;FROM &#xA;&#x9;[TMP].[ME_TBCL] TMP WITH(NOLOCK)&#xA;INNER JOIN &#xA;&#x9;[TMP].[ME_TBCL_PQR_ESTADO] PQR WITH(NOLOCK)&#xA;ON&#xA;&#x9;TMP.[G_NUMERO_GUIA] = PQR.[G_NUMERO_GUIA]" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
              </DTS:ObjectData>
            </DTS:Executable>
