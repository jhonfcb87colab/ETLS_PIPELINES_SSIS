          DTS:DTSID="{685B4F39-7F1E-40FF-BF66-8468D2D32D9D}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Paso 64 Calcular Estado Inversa"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{82E3C266-AD9E-4E38-9443-8FFFA079254B}"
              SQLTask:SqlStatementSource="UPDATE &#xA;&#x9;[TMP].[ME_TBCL]&#xA;SET &#xA;&#x9;SE_LOGISTICA_INVERSA = 'RECOLECCION EN DOMICILIO'&#xA;FROM &#xA;&#x9;[TMP].[ME_TBCL] TMP  WITH (NOLOCK)&#xA;WHERE&#xA;&#x9;EXISTS (SELECT 1 FROM TMP.ME_TBCL_13 TMP13 WHERE TMP13.[NUMERO_GUIA] = TMP.[G_NUMERO_GUIA])&#xA;AND &#xA;&#x9;[GINF_EST_GUIA_INVERSA] = 'SI'&#xA;GO&#xA;UPDATE &#xA;&#x9;[TMP].[ME_TBCL]&#xA;SET &#xA;&#x9;SE_LOGISTICA_INVERSA = 'RECOLECCION EN CDS'&#xA;FROM &#xA;&#x9;[TMP].[ME_TBCL] TMP  WITH (NOLOCK)&#xA;WHERE&#xA;&#x9;NOT EXISTS (SELECT 1 FROM TMP.ME_TBCL_13 TMP13 WHERE TMP13.[NUMERO_GUIA] = TMP.[G_NUMERO_GUIA])&#xA;AND &#xA;&#x9;[GINF_EST_GUIA_INVERSA] = 'SI'" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Contenedor de secuencias 1\Paso 65 Calcular Eficiencia"
