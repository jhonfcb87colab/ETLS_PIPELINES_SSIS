        <DTS:Executable
          DTS:refId="Package\Contenedor de secuencias 1\Paso 59 Actualizar Base GRIR"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{2E56F63B-A29F-417D-B482-30D32E4E6083}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
