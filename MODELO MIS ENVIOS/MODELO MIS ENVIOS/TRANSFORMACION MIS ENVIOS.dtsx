              SQLTask:SqlStatementSource="INSERT INTO &#xA;&#x9;[TMP].[ME_TBCL_01]&#xA;(&#xA;&#x9; [NUMERO_GUIA]&#xA;&#x9;,[NUMERO_PIEZAS]&#xA;&#x9;,[ID_PRODUCTO]&#xA;&#x9;,[ID_SUBPRODUCTO]&#xA;&#x9;,[ID_TIEMPO]&#xA;&#x9;,[ID_MEDTRANS]&#xA;&#x9;,[ID_ESTADOENVIO]&#xA;&#x9;,[ID_CIUDAD_DESTINO]&#xA;&#x9;,[ID_CIUDAD_ORIGEN]&#xA;&#x9;,[NOMBRE_DESTINA_GUIA]&#xA;&#x9;,[APELLIDO_DESTINA_GUIA]&#xA;&#x9;,[TELEFONO_DESTINA_GUIA]&#xA;&#x9;,[DIRECCION_DESTINA_GUIA]&#xA;&#x9;,[ID_REMITE]&#xA;&#x9;,[NOMBRE_REMITE_GUIA]&#xA;&#x9;,[APELLIDO_REMITE_GUIA]&#xA;&#x9;,[DIRECCION_REMITE_GUIA]&#xA;&#x9;,[TELEFONO_REMITE_GUIA]&#xA;&#x9;,[CONTENIDO]&#x9;&#xA;&#x9;,[FECHA_EXTRACCION_DW]&#xA;&#x9;,[FECHA_ENVIO]&#xA;&#x9;,[VALOR_DECLARADO_GUIA]&#xA;&#x9;,[FECHA_MODIFICACION]&#xA;&#x9;,[ID_1]&#xA;&#x9;,[ID_2]&#xA;)&#xA;SELECT&#xA;&#x9; G.NUMERO_GUIA&#xA;&#x9;,G.NUMERO_PIEZAS&#xA;&#x9;,G.ID_PRODUCTO&#xA;&#x9;,G.ID_SUBPRODUCTO&#xA;&#x9;,G.ID_TIEMPO&#xA;&#x9;,G.ID_MEDTRANS&#xA;&#x9;,G.ID_ESTADOENVIO&#xA;&#x9;,G.ID_CIUDAD_DESTINO&#xA;&#x9;,G.ID_CIUDAD_ORIGEN&#xA;&#x9;,G.NOMBRE_DESTINA_GUIA&#xA;&#x9;,G.APELLIDO_DESTINA_GUIA&#xA;&#x9;,G.TELEFONO_DESTINA_GUIA&#xA;&#x9;,G.DIRECCION_DESTINA_GUIA&#xA;&#x9;,G.ID_CLIENTE ID_REMITE&#xA;&#x9;,G.NOMBRE_REMITE_GUIA&#xA;&#x9;,G.APELLIDO_REMITE_GUIA&#xA;&#x9;,G.DIRECCION_REMITE_GUIA&#xA;&#x9;,G.TELEFONO_REMITE_GUIA&#xA;&#x9;,G.CONTENIDO&#xA;&#x9;,G.FECHA_EXTRACCION_DW&#xA;&#x9;,G.FECHA_ENVIO&#xA;&#x9;,G.VALOR_DECLARADO_GUIA&#xA;&#x9;,G.FECHA_MODIFICACION_DG&#xA;&#x9;,ID_1&#xA;&#x9;,ID_2&#xA;FROM &#xA;&#x9;LOG.GUIAS G WITH(NOLOCK)&#xA;INNER JOIN&#xA;&#x9;PAR.TBCL_CLIENTES CL  WITH(NOLOCK)&#xA;ON&#xA;&#x9;G.ID_CLIENTE = CL.ID_CLIENTE&#xA;WHERE &#xA;--G.NUMERO_GUIA IN (2180005523,2180006865,2143256818,2180012795,2180029899, 2180013630,2180031496 ,2180034471)&#xA;&#x9;G.FECHA_MODIFICACION &gt;= ?&#xA;AND&#xA;&#x9;G.FECHA_MODIFICACION &lt;= ?&#xA;AND&#xA;&#x9;G.ID_ESTADOENVIO &gt; 1&#xA;-- AND  G.ID_CLIENTE IN ('900499362','901116547','830023671')&#xA;-- ORDER BY G.FECHA_MODIFICACION_DG  DESC&#xA;OPTION (RECOMPILE, MAXDOP 4)&#xA;;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
