              DTS:ThreadHint="0">
              <DTS:Variables />
              <DTS:ObjectData>
                <SQLTask:SqlTaskData
                  SQLTask:Connection="{82E3C266-AD9E-4E38-9443-8FFFA079254B}"
                  SQLTask:SqlStatementSource="INSERT INTO TMP.ME_TBCL_08&#xA;(&#xA;&#x9;G_NUMERO_GUIA&#xA;&#x9;,ID_NOVEDAD_ME_TBCL&#xA;&#x9;,SE_DESC_PROC_DEPU&#xA;&#x9;,SE_DESC_CONC_DEPU&#xA;&#x9;,SE_DEPURADO_RESP&#xA;&#x9;,FECHA_HORA_MOVIMIENTO &#xA;)&#xA;SELECT&#xA;&#x9; C.G_NUMERO_GUIA&#xA;&#x9;,N.ID_NOVEDAD_ME_TBCL&#xA;&#x9;,N.NOMBRE_TIPO_NOVEDAD SE_DESC_PROC_DEPU&#xA;&#x9;,N.NOMBRE_NOVEDAD SE_DESC_CONC_DEPU&#xA;&#x9;,N.RESP SE_DEPURADO_RESP&#xA;&#x9;,N.FECHA_HORA_MOVIMIENTO&#xA;FROM&#xA;&#x9;TMP.ME_TBCL C WITH(NOLOCK)&#xA;INNER JOIN&#xA;&#x9;TMP.ME_TBCL_07 N WITH(NOLOCK)&#xA;ON&#xA;&#x9;C.G_NUMERO_GUIA = N.G_NUMERO_GUIA" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
              </DTS:ObjectData>
