                  SQLTask:SqlStatementSource="/* 2. INSERTA DATOS BARRANQUILLA */&#xA;INSERT INTO [TMP].[ME_TBCL_03]&#xA;SELECT &#xA;&#x9; SE.[NUMERO_GUIA]&#xA;&#x9;,SE.[ID_PROCESO]&#xA;&#x9;,SE.[ID_CONCEPTO]&#xA;&#x9;,SE.[FECHA_HORA_MOVIMIENTO]&#xA;&#x9;,SE.[NUMERO_MOVIMI]&#xA;&#x9;,SE.[CONSECUT_MOVIMI]&#xA;FROM&#xA;&#x9;[LOG].[SEGUIMIENTO_ENVIO_BARR] SE WITH(NOLOCK) &#xA;&#x9;INNER JOIN [TMP].[ME_TBCL_02] TMP WITH(NOLOCK)&#xA;ON SE.NUMERO_GUIA = TMP.NUMERO_GUIA&#xA;;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
