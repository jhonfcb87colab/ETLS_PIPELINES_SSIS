TATISTICS [TMP].[ME_TBCL_10_BUCA]&#xA;UPDATE STATISTICS [TMP].[ME_TBCL_10_BUGA]&#xA;UPDATE STATISTICS [TMP].[ME_TBCL_10_CALI]&#xA;UPDATE STATISTICS [TMP].[ME_TBCL_10_CART]&#xA;UPDATE STATISTICS [TMP].[ME_TBCL_10_COTA]&#xA;UPDATE STATISTICS [TMP].[ME_TBCL_10_CUCU]&#xA;UPDATE STATISTICS [TMP].[ME_TBCL_10_DG]&#xA;UPDATE STATISTICS [TMP].[ME_TBCL_10_IBAG]&#xA;UPDATE STATISTICS [TMP].[ME_TBCL_10_MANI]&#xA;UPDATE STATISTICS [TMP].[ME_TBCL_10_MEDE]&#xA;UPDATE STATISTICS [TMP].[ME_TBCL_10_NEIV]&#xA;UPDATE STATISTICS [TMP].[ME_TBCL_10_PERE]&#xA;UPDATE STATISTICS [TMP].[ME_TBCL_10_PROV]&#xA;UPDATE STATISTICS [TMP].[ME_TBCL_10_SINC]&#xA;UPDATE STATISTICS [TMP].[ME_TBCL_10_VILL]&#xA;UPDATE STATISTICS [TMP].[ME_TBCL_11]&#xA;UPDATE STATISTICS [TMP].[ME_TBCL_12]&#xA;UPDATE STATISTICS [TMP].[ME_TBCL_13]&#xA;UPDATE STATISTICS [TMP].[ME_TBCL_CONF]&#xA;UPDATE STATISTICS [TMP].[ME_TBCL_DHABIL_NO_D]&#xA;UPDATE STATISTICS [TMP].[ME_TBCL_GREF]&#xA;UPDATE STATISTICS [TMP].[ME_TBCL_GRINFR]&#xA;UPDATE STATISTICS [TMP].[ME_TBCL_INFTBCL]&#xA;UPDATE STATISTICS [TMP].[ME_TBCL_NOVEDADES]&#xA;UPDATE STATISTICS [TMP].[ME_TBCL_PQR]&#xA;UPDATE STATISTICS [TMP].[ME_TBCL_PQR_ESTADO]&#xA;UPDATE STATISTICS [TMP].[ME_TBCL_RED_OPERATIVA_RUTA]&#xA;UPDATE STATISTICS [TMP].[ME_TBCL_RED_OPERATIVA_RUTA_ACTIVA]&#xA;UPDATE STATISTICS [TMP].[ME_TBCL_TAREAS]&#xA;UPDATE STATISTICS [TMP].[ME_TBCL_ACIDA_DIAS_DIF]&#xA;UPDATE STATISTICS [TMP].[ME_TBCL_TIEMPOFEST]" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
