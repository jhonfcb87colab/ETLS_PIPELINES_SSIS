                      description="OLE DB Source"
                      name="SOURCE  VILL"
                      usesDispositions="true"
                      version="7">
                      <properties>
                        <property
                          dataType="System.Int32"
                          description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                          name="CommandTimeout">0</property>
                        <property
                          dataType="System.String"
                          description="Specifies the name of the database object used to open a rowset."
                          name="OpenRowset"></property>
                        <property
                          dataType="System.String"
                          description="Specifies the variable that contains the name of the database object used to open a rowset."
                          name="OpenRowsetVariable"></property>
                        <property
                          dataType="System.String"
                          description="The SQL command to be executed."
                          name="SqlCommand"
                          UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT 
	 TMP.G_NUMERO_GUIA
	,DC.ID_PROCESO AS DC_ID_PROCESO
	,TMP04.ID_CONCEPTO AS SE_ID_CONCEPTO
	,DC.NUMERO_MOVIMI AS DC_NUMERO_MOVIMI
	,DC.CONSECUT_MOVIMI AS DC_CONSECUT_MOVIM
	,DC.ID_PAIS_DESTINO AS DC_ID_PAIS_DESTINO
	,DC.ID_CIUDAD_DESTINO AS DC_ID_CIUDAD_DESTINO
	,DC.ID_DIVISION_DESTINO AS DC_ID_DIVISION_DESTINO
	,DC.ID_PAIS_DIVISION_ORIGEN AS DC_ID_PAIS_DIVISION_ORIGEN
	,DC.ID_CIUDAD_DIVISION_ORIGEN AS DC_ID_CIUDAD_DIVISION_ORIGEN
	,DC.ID_DIVISION_ORIGEN AS DC_ID_DIVISION_ORIGEN
	,DC.FECHA_HORA_MOVIMI AS DC_FECHA_HORA_MOVIMIENTO
FROM 
	TMP.ME_TBCL TMP WITH (NOLOCK)
INNER JOIN 
	TMP.ME_TBCL_04 TMP04 WITH (NOLOCK)
ON 
	TMP.SE_ID_ULTI = ID
INNER JOIN 
	LOG.DOCUMENTOS_VILL DC WITH (NOLOCK)
ON
	TMP04.ID_PROCESO = DC.ID_PROCESO
AND
	TMP04.NUMERO_MOVIMI = DC.NUMERO_MOVIMI
AND
	TMP04.CONSECUT_MOVIMI = DC.CONSECUT_MOVIMI</property>
