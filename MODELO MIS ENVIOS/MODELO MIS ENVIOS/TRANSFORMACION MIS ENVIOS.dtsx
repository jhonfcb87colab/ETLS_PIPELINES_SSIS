              DTS:ObjectName="Paso 42 quitar duplicados de Manifiestos"
              DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
              DTS:ThreadHint="21">
              <DTS:Variables />
              <DTS:ObjectData>
                <SQLTask:SqlTaskData
                  SQLTask:Connection="{82E3C266-AD9E-4E38-9443-8FFFA079254B}"
                  SQLTask:SqlStatementSource="WITH CTE &#xA;(&#xA;  ID&#xA; ,[G_NUMERO_GUIA]&#xA; ,[DC_ID_PROCESO]&#xA; ,[SE_ID_CONCEPTO]&#xA; ,[DC_NUMERO_MOVIMI]&#xA; ,[DC_CONSECUT_MOVIM]&#xA; ,[DC_ID_PAIS_DESTINO]&#xA; ,[DC_ID_CIUDAD_DESTINO]&#xA; ,[DC_ID_DIVISION_DESTINO]&#xA; ,[DC_ID_PAIS_DIVISION_ORIGEN]&#xA; ,[DC_ID_CIUDAD_DIVISION_ORIGEN]&#xA; ,[DC_ID_DIVISION_ORIGEN]&#xA; ,[DC_FECHA_HORA_MOVIMIENTO]&#xA;)&#xA;AS&#xA;(&#xA;SELECT&#xA;  ROW_NUMBER() OVER(PARTITION BY [DC_ID_PROCESO],[DC_CONSECUT_MOVIM],[DC_NUMERO_MOVIMI],[G_NUMERO_GUIA] ORDER BY [DC_FECHA_HORA_MOVIMIENTO] DESC) ID&#xA; ,[G_NUMERO_GUIA]&#xA; ,[DC_ID_PROCESO]&#xA; ,[SE_ID_CONCEPTO]&#xA; ,[DC_NUMERO_MOVIMI]&#xA; ,[DC_CONSECUT_MOVIM]&#xA; ,[DC_ID_PAIS_DESTINO]&#xA; ,[DC_ID_CIUDAD_DESTINO]&#xA; ,[DC_ID_DIVISION_DESTINO]&#xA; ,[DC_ID_PAIS_DIVISION_ORIGEN]&#xA; ,[DC_ID_CIUDAD_DIVISION_ORIGEN]&#xA; ,[DC_ID_DIVISION_ORIGEN]&#xA; ,[DC_FECHA_HORA_MOVIMIENTO]&#xA;FROM &#xA; [TMP].[ME_TBCL_10] WITH (NOLOCK)&#xA;)&#xA;INSERT INTO &#xA; [TMP].[ME_TBCL_11]&#xA;(&#xA;  [G_NUMERO_GUIA]&#xA; ,[DC_ID_PROCESO]&#xA; ,[SE_ID_CONCEPTO]&#xA; ,[DC_NUMERO_MOVIMI]&#xA; ,[DC_CONSECUT_MOVIM]&#xA; ,[DC_ID_PAIS_DESTINO]&#xA; ,[DC_ID_CIUDAD_DESTINO]&#xA; ,[DC_ID_DIVISION_DESTINO]&#xA; ,[DC_ID_PAIS_DIVISION_ORIGEN]&#xA; ,[DC_ID_CIUDAD_DIVISION_ORIGEN]&#xA; ,[DC_ID_DIVISION_ORIGEN]&#xA; ,[DC_FECHA_HORA_MOVIMIENTO]&#xA;)&#xA;SELECT &#xA;  [G_NUMERO_GUIA]&#xA; ,[DC_ID_PROCESO]&#xA; ,[SE_ID_CONCEPTO]&#xA; ,[DC_NUMERO_MOVIMI]&#xA; ,[DC_CONSECUT_MOVIM]&#xA; ,[DC_ID_PAIS_DESTINO]&#xA; ,[DC_ID_CIUDAD_DESTINO]&#xA; ,[DC_ID_DIVISION_DESTINO]&#xA; ,[DC_ID_PAIS_DIVISION_ORIGEN]&#xA; ,[DC_ID_CIUDAD_DIVISION_ORIGEN]&#xA; ,[DC_ID_DIVISION_ORIGEN]&#xA; ,[DC_FECHA_HORA_MOVIMIENTO]&#xA;FROM &#xA; CTE&#xA;WHERE &#xA; CTE.ID = 1" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
              </DTS:ObjectData>
            </DTS:Executable>
          </DTS:Executables>
