      DTS:Expression="YEAR(@[$Project::DtMesFin]) &lt; 2000 || YEAR(@[$Project::DtMesIni]) &lt; 2000 ? &#xA;(YEAR( DATEADD( &quot;DD&quot;, 1  ,  GETDATE())  ) *100+    MONTH( DATEADD( &quot;DD&quot;, 1  ,  GETDATE())  ))*100+ DAY( DATEADD( &quot;DD&quot;, 1  ,  GETDATE())  ) &#xA; : &#xA;(YEAR( @[$Project::DtMesFin]  ) *100+    MONTH( @[$Project::DtMesFin] ))*100+ DAY( @[$Project::DtMesFin] )"
      DTS:IncludeInDebugDump="2345"
