          DTS:ObjectName="Paso 59 Actualizar Base GRIR"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{82E3C266-AD9E-4E38-9443-8FFFA079254B}"
              SQLTask:SqlStatementSource="WITH CTE&#xA;(&#xA;&#x9; G_NUMERO_GUIA&#xA;&#x9;,IR_NUMERO_ORDEN_SERVICIO&#xA;&#x9;,IR_NUMERO_APROBACION&#xA;&#x9;,IR_VALOR_X_RECAUDAR&#xA;&#x9;,IR_VALOR_RECAUDADO&#xA;&#x9;,IR_VALOR_SALDO&#xA;&#x9;,IR_NUMERO_CODI_EFECTY&#xA;)&#xA;AS&#xA;&#x9;(&#xA;&#x9;&#x9;SELECT &#xA;&#x9;&#x9;&#x9; TMP.G_NUMERO_GUIA&#xA;&#x9;&#x9;&#x9;,GRIR.IR_NUMERO_ORDEN_SERVICIO&#xA;&#x9;&#x9;&#x9;,GRIR.IR_NUMERO_APROBACION&#xA;&#x9;&#x9;&#x9;,GRIR.IR_VALOR_X_RECAUDAR&#xA;&#x9;&#x9;&#x9;,GRIR.IR_VALOR_RECAUDADO&#xA;&#x9;&#x9;&#x9;,GRIR.IR_VALOR_SALDO&#xA;&#x9;&#x9;&#x9;,GRIR.IR_NUMERO_CODI_EFECTY&#xA;&#x9;&#x9;FROM &#xA;&#x9;&#x9;&#x9;[TMP].[ME_TBCL] TMP WITH (NOLOCK)&#xA;&#x9;&#x9;INNER JOIN &#xA;&#x9;&#x9;&#x9;[TMP].[ME_TBCL_GRINFR] GRIR WITH (NOLOCK)&#xA;&#x9;&#x9;ON &#xA;&#x9;&#x9;&#x9;TMP.G_NUMERO_GUIA = GRIR.IR_NUMERO_GUIA&#xA;&#x9;)&#xA;UPDATE &#xA;&#x9; [TMP].[ME_TBCL]&#xA;SET &#xA;&#x9; GRIR_NUME_ORDE_SERVI = CTE.IR_NUMERO_ORDEN_SERVICIO&#xA;&#x9;,GRIR_NUMERO_APROBACION = CTE.IR_NUMERO_APROBACION&#xA;&#x9;,GRIR_VALOR_X_RECAUDAR = CTE.IR_VALOR_X_RECAUDAR&#xA;&#x9;,GRIR_VALOR_RECAUDADO = CTE.IR_VALOR_RECAUDADO&#xA;&#x9;,GRIR_VALOR_SALDO = CTE.IR_VALOR_SALDO&#xA;&#x9;,GRIR_NUMERO_CODI_EFECTY = CTE.IR_NUMERO_CODI_EFECTY&#xA;FROM &#xA;&#x9;[TMP].[ME_TBCL] TMP WITH (NOLOCK) INNER JOIN&#xA;&#x9;CTE&#xA;ON&#xA;&#x9;TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Contenedor de secuencias 1\Paso 60 Actualiza Base TC"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{7D317BB0-4695-42A4-BF29-C5826F99CE24}"
