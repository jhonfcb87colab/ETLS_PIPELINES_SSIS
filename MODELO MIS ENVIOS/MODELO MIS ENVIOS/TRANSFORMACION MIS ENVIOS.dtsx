      DTS:ObjectName="Paso 49 Actualizar Confimaciones">
      <DTS:Variables />
      <DTS:Executables>
        <DTS:Executable
          DTS:refId="Package\Paso 49 Actualizar Confimaciones\Pase 49-1 Cantidad Confirmaciones"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{e44c5171-a88f-4073-9856-260273ae93db}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Pase 49-1 Cantidad Confirmaciones"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{82E3C266-AD9E-4E38-9443-8FFFA079254B}"
              SQLTask:SqlStatementSource="WITH CTE&#xA;(&#xA;&#x9; G_NUMERO_GUIA&#xA;&#x9;,CNF_CANT_CONF&#xA;)&#xA;AS&#xA;&#x9;(&#xA;&#x9;&#x9;SELECT&#xA;&#x9;&#x9;&#x9; TMP.G_NUMERO_GUIA&#xA;&#x9;&#x9;&#x9;,COUNT (TMPCNF.G_NUMERO_GUIA) CNF_CANT_CONF&#xA;&#x9;&#x9;FROM &#xA;&#x9;&#x9;&#x9;TMP.ME_TBCL TMP WITH(NOLOCK)&#xA;&#x9;&#x9;INNER JOIN &#xA;&#x9;&#x9;&#x9;TMP.ME_TBCL_CONF TMPCNF WITH(NOLOCK)&#xA;&#x9;&#x9;ON&#xA;&#x9;&#x9;&#x9;TMP.G_NUMERO_GUIA = TMPCNF.G_NUMERO_GUIA&#xA;&#x9;&#x9;GROUP BY &#xA;&#x9;&#x9;&#x9;TMP.G_NUMERO_GUIA&#xA;&#x9;)&#xA;UPDATE &#xA;&#x9;TMP.ME_TBCL&#xA;SET &#xA;&#x9; CNF_ID_CONFIRMACION = 'SI'&#xA;&#x9;,CNF_CANT_CONFIRMACION = CTE.CNF_CANT_CONF&#xA;FROM &#xA;&#x9; TMP.ME_TBCL TMP WITH (NOLOCK)&#xA;&#x9;INNER JOIN CTE&#xA;ON &#xA;&#x9;TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Paso 49 Actualizar Confimaciones\Paso 49-2 Confirmacion 1"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{20c50393-4be7-4680-89ba-06254d1c4f40}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Paso 49-2 Confirmacion 1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{82E3C266-AD9E-4E38-9443-8FFFA079254B}"
              SQLTask:SqlStatementSource="WITH CTE&#xA;(&#xA;&#x9; G_NUMERO_GUIA&#xA;&#x9;,CNF_ID_SOLUCION_1&#xA;&#x9;,CNF_OBSERVACION_1&#xA;&#x9;,CNF_ID_FECHA_CONF_1&#xA;)&#xA;AS&#xA;&#x9;(&#xA;&#x9;&#x9;SELECT&#xA;&#x9;&#x9;&#x9; TMP.G_NUMERO_GUIA&#xA;&#x9;&#x9;&#x9;,TMPCONF.ID_SOLUCION AS  CNF_ID_SOLUCION_1&#xA;&#x9;&#x9;&#x9;,TMPCONF.OBSERVACIONES_CONFIRMACION AS CNF_OBSERVACION_1&#xA;&#x9;&#x9;&#x9;,TMPCONF.FECHA_CONFIRMACION AS CNF_ID_FECHA_CONF_1&#xA;&#x9;&#x9;FROM &#xA;&#x9;&#x9;&#x9;TMP.ME_TBCL TMP WITH(NOLOCK)&#xA;&#x9;&#x9;INNER JOIN &#xA;&#x9;&#x9;&#x9;TMP.ME_TBCL_CONF TMPCONF WITH(NOLOCK)&#xA;&#x9;&#x9;ON&#xA;&#x9;&#x9;&#x9;TMP.G_NUMERO_GUIA = TMPCONF.G_NUMERO_GUIA&#xA;&#x9;&#x9;WHERE &#xA;&#x9;&#x9;&#x9;TMPCONF.ID = 1&#xA;&#x9;)&#xA;UPDATE &#xA;&#x9;TMP.ME_TBCL&#xA;SET &#xA;&#x9; CNF_ID_SOLUCION_1 = ISNULL(CTE.CNF_ID_SOLUCION_1,-888)&#xA;&#x9;,CNF_OBSERVACION_1 = CASE WHEN CTE.CNF_OBSERVACION_1 = '' THEN 'NO DISPONIBLE' ELSE ISNULL(CTE.CNF_OBSERVACION_1,'NO DISPONIBLE') END&#xA;&#x9;,CNF_ID_FECHA_CONF_1 = ISNULL(CTE.CNF_ID_FECHA_CONF_1,'1900-01-01')&#xA;&#x9;,CNF_FECHA_CONF_1 = CASE WHEN ISNULL(CTE.CNF_ID_FECHA_CONF_1,'1900-01-01') = '1900-01-01' THEN 'NO DISPONIBLE' ELSE CONVERT (VARCHAR,CTE.CNF_ID_FECHA_CONF_1,111) END&#xA;FROM &#xA;&#x9; TMP.ME_TBCL TMP WITH (NOLOCK)&#xA;&#x9;INNER JOIN CTE&#xA;ON &#xA;&#x9;TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Paso 49 Actualizar Confimaciones\Paso 49-3 Confirmacion 2"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{fa7d0af3-f7d8-4394-990f-2f54c9c5925f}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Paso 49-3 Confirmacion 2"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{82E3C266-AD9E-4E38-9443-8FFFA079254B}"
              SQLTask:SqlStatementSource="WITH CTE&#xA;(&#xA;&#x9; G_NUMERO_GUIA&#xA;&#x9;,CNF_ID_SOLUCION_2&#xA;&#x9;,CNF_OBSERVACION_2&#xA;&#x9;,CNF_ID_FECHA_CONF_2&#xA;)&#xA;AS&#xA;&#x9;(&#xA;&#x9;&#x9;SELECT&#xA;&#x9;&#x9;&#x9; TMP.G_NUMERO_GUIA&#xA;&#x9;&#x9;&#x9;,TMPCONF.ID_SOLUCION AS  CNF_ID_SOLUCION_2&#xA;&#x9;&#x9;&#x9;,TMPCONF.OBSERVACIONES_CONFIRMACION AS CNF_OBSERVACION_2&#xA;&#x9;&#x9;&#x9;,TMPCONF.FECHA_CONFIRMACION AS CNF_ID_FECHA_CONF_2&#xA;&#x9;&#x9;FROM &#xA;&#x9;&#x9;&#x9;TMP.ME_TBCL TMP WITH(NOLOCK)&#xA;&#x9;&#x9;INNER JOIN &#xA;&#x9;&#x9;&#x9;TMP.ME_TBCL_CONF TMPCONF WITH(NOLOCK)&#xA;&#x9;&#x9;ON&#xA;&#x9;&#x9;&#x9;TMP.G_NUMERO_GUIA = TMPCONF.G_NUMERO_GUIA&#xA;&#x9;&#x9;WHERE &#xA;&#x9;&#x9;&#x9;TMPCONF.ID = 2&#xA;&#x9;)&#xA;UPDATE &#xA;&#x9;TMP.ME_TBCL&#xA;SET &#xA;&#x9; CNF_ID_SOLUCION_2 = ISNULL(CTE.CNF_ID_SOLUCION_2,-888)&#xA;&#x9;,CNF_OBSERVACION_2 = CASE WHEN CTE.CNF_OBSERVACION_2 = '' THEN 'NO DISPONIBLE' ELSE ISNULL(CTE.CNF_OBSERVACION_2,'NO DISPONIBLE') END&#xA;&#x9;,CNF_ID_FECHA_CONF_2 = ISNULL(CTE.CNF_ID_FECHA_CONF_2,'1900-01-01')&#xA;&#x9;,CNF_FECHA_CONF_2 = CASE WHEN ISNULL(CTE.CNF_ID_FECHA_CONF_2,'1900-01-01') = '1900-01-01' THEN 'NO DISPONIBLE' ELSE CONVERT (VARCHAR,CTE.CNF_ID_FECHA_CONF_2,111) END&#xA;FROM &#xA;&#x9; TMP.ME_TBCL TMP WITH (NOLOCK)&#xA;&#x9;INNER JOIN CTE&#xA;ON &#xA;&#x9;TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Paso 49 Actualizar Confimaciones\Paso 49-4 Confirmacion 3"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{79e81882-8e86-4215-bca4-202553308296}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Paso 49-4 Confirmacion 3"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{82E3C266-AD9E-4E38-9443-8FFFA079254B}"
              SQLTask:SqlStatementSource="WITH CTE&#xA;(&#xA;&#x9; G_NUMERO_GUIA&#xA;&#x9;,CNF_ID_SOLUCION_3&#xA;&#x9;,CNF_OBSERVACION_3&#xA;&#x9;,CNF_ID_FECHA_CONF_3&#xA;)&#xA;AS&#xA;&#x9;(&#xA;&#x9;&#x9;SELECT&#xA;&#x9;&#x9;&#x9; TMP.G_NUMERO_GUIA&#xA;&#x9;&#x9;&#x9;,TMPCONF.ID_SOLUCION AS  CNF_ID_SOLUCION_3&#xA;&#x9;&#x9;&#x9;,TMPCONF.OBSERVACIONES_CONFIRMACION AS CNF_OBSERVACION_3&#xA;&#x9;&#x9;&#x9;,TMPCONF.FECHA_CONFIRMACION AS CNF_ID_FECHA_CONF_3&#xA;&#x9;&#x9;FROM &#xA;&#x9;&#x9;&#x9;TMP.ME_TBCL TMP WITH(NOLOCK)&#xA;&#x9;&#x9;INNER JOIN &#xA;&#x9;&#x9;&#x9;TMP.ME_TBCL_CONF TMPCONF WITH(NOLOCK)&#xA;&#x9;&#x9;ON&#xA;&#x9;&#x9;&#x9;TMP.G_NUMERO_GUIA = TMPCONF.G_NUMERO_GUIA&#xA;&#x9;&#x9;WHERE &#xA;&#x9;&#x9;&#x9;TMPCONF.ID = 3&#xA;&#x9;)&#xA;UPDATE &#xA;&#x9;TMP.ME_TBCL&#xA;SET &#xA;&#x9; CNF_ID_SOLUCION_3 = ISNULL(CTE.CNF_ID_SOLUCION_3,-888)&#xA;&#x9;,CNF_OBSERVACION_3 = CASE WHEN CTE.CNF_OBSERVACION_3 = '' THEN 'NO DISPONIBLE' ELSE ISNULL(CTE.CNF_OBSERVACION_3,'NO DISPONIBLE') END&#xA;&#x9;,CNF_ID_FECHA_CONF_3 = ISNULL(CTE.CNF_ID_FECHA_CONF_3,'1900-01-01')&#xA;&#x9;,CNF_FECHA_CONF_3 = CASE WHEN ISNULL(CTE.CNF_ID_FECHA_CONF_3,'1900-01-01') = '1900-01-01' THEN 'NO DISPONIBLE' ELSE CONVERT (VARCHAR,CTE.CNF_ID_FECHA_CONF_3,111) END&#xA;FROM &#xA;&#x9; TMP.ME_TBCL TMP WITH (NOLOCK)&#xA;&#x9; INNER JOIN CTE&#xA;ON &#xA;&#x9;TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Paso 49 Actualizar Confimaciones\Paso 49-5 Actualizar Despriptivo Solucion"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{8656e30a-0b21-4fd2-bec2-0a53982f4909}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Paso 49-5 Actualizar Despriptivo Solucion"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{82E3C266-AD9E-4E38-9443-8FFFA079254B}"
              SQLTask:SqlStatementSource="UPDATE&#xA;&#x9;TMP.ME_TBCL&#xA;SET&#xA;&#x9;CNF_SOLUCION_1 = ISNULL(SOLU.NOMBRE_SOLUCION,'NO DISPONIBLE')&#xA;FROM &#xA;&#x9;TMP.ME_TBCL TMP WITH (NOLOCK)&#xA;INNER JOIN &#xA;&#x9;PAR.SOLUCIONESCONFIRMACIONES SOLU WITH (NOLOCK)&#xA;ON&#xA;&#x9;TMP.CNF_ID_SOLUCION_1 = SOLU.ID_SOLUCION&#xA;GO&#xA;UPDATE&#xA;&#x9;TMP.ME_TBCL&#xA;SET&#xA;&#x9;CNF_SOLUCION_2 = ISNULL(SOLU.NOMBRE_SOLUCION,'NO DISPONIBLE')&#xA;FROM &#xA;&#x9;TMP.ME_TBCL TMP WITH (NOLOCK)&#xA;INNER JOIN &#xA;&#x9;PAR.SOLUCIONESCONFIRMACIONES SOLU WITH (NOLOCK)&#xA;ON&#xA;&#x9;TMP.CNF_ID_SOLUCION_2 = SOLU.ID_SOLUCION&#xA;GO&#xA;UPDATE&#xA;&#x9;TMP.ME_TBCL&#xA;SET&#xA;&#x9;CNF_SOLUCION_3 = ISNULL(SOLU.NOMBRE_SOLUCION,'NO DISPONIBLE')&#xA;FROM &#xA;&#x9;TMP.ME_TBCL TMP WITH (NOLOCK)&#xA;INNER JOIN &#xA;&#x9;PAR.SOLUCIONESCONFIRMACIONES SOLU WITH (NOLOCK)&#xA;ON&#xA;&#x9;TMP.CNF_ID_SOLUCION_3 = SOLU.ID_SOLUCION" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Paso 49 Actualizar Confimaciones\Paso 49-6 Calcular Confirmacion Efectiva"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{af48e07f-0e94-47cc-b1be-8e44750e8e08}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Paso 49-6 Calcular Confirmacion Efectiva"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{82E3C266-AD9E-4E38-9443-8FFFA079254B}"
              SQLTask:SqlStatementSource="UPDATE &#xA;&#x9;TMP.ME_TBCL&#xA;SET&#xA;&#x9; CNF_EFECTIVA = CASE WHEN G_ID_ESTADOENVIO = 3 AND CNF_ID_CONFIRMACION = 'SI' THEN 'SI'&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9; WHEN G_ID_ESTADOENVIO = 4 AND CNF_ID_CONFIRMACION = 'SI' THEN 'NO'&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9; ELSE CNF_EFECTIVA END&#xA;FROM &#xA;&#x9;TMP.ME_TBCL TMP WITH (NOLOCK)" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
      </DTS:Executables>
      <DTS:PrecedenceConstraints>
