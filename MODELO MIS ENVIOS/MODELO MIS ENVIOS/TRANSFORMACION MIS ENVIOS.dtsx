          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{82E3C266-AD9E-4E38-9443-8FFFA079254B}"
              SQLTask:SqlStatementSource="-- SET NOCOUNT ON;&#xA;/* 16. INSERTA DATOS DG */&#xA;INSERT INTO [TMP].[ME_TBCL_03]&#xA;SELECT &#xA;&#x9; SE.[NUMERO_GUIA]&#xA;&#x9;,SE.[ID_PROCESO]&#xA;&#x9;,SE.[ID_CONCEPTO]&#xA;&#x9;,SE.[FECHA_HORA_MOVIMIENTO]&#xA;&#x9;,SE.[NUMERO_MOVIMI]&#xA;&#x9;,SE.[CONSECUT_MOVIMI]&#xA;FROM&#xA;&#x9;[LOG].[SEGUIMIENTO_ENVIO_6MESES] SE WITH(NOLOCK, INDEX(IX_NUM_GUIA_SEGUIMIENTO_ENVIO_6MESES) ) &#xA;&#x9;INNER JOIN [TMP].[ME_TBCL_02] TMP WITH(NOLOCK, INDEX(IX_NGUIAS_TMP_ME_TBCL02) )&#xA;ON SE.NUMERO_GUIA = TMP.NUMERO_GUIA&#xA;OPTION(RECOMPILE, MAXDOP 4 )&#xA;;&#xA;-- SET NOCOUNT OFF;&#xA;&#xA;&#xA;&#xA;-- SET NOCOUNT ON;&#xA;/* 16. INSERTA DATOS DG */&#xA;/*&#xA;INSERT INTO [TMP].[ME_TBCL_03]&#xA;SELECT &#xA;&#x9; SE.[NUMERO_GUIA]&#xA;&#x9;,SE.[ID_PROCESO]&#xA;&#x9;,SE.[ID_CONCEPTO]&#xA;&#x9;,SE.[FECHA_HORA_MOVIMIENTO]&#xA;&#x9;,SE.[NUMERO_MOVIMI]&#xA;&#x9;,SE.[CONSECUT_MOVIMI]&#xA;FROM&#xA;&#x9;[LOG].[SEGUIMIENTO_ENVIO] SE WITH(NOLOCK, INDEX(IX_SEGUIMIENTO_ENVIO_NUMERO_GUIA_V3) ) &#xA;&#x9;INNER JOIN [TMP].[ME_TBCL_02] TMP WITH(NOLOCK, INDEX(IX_NGUIAS_TMP_ME_TBCL02) )&#xA;ON SE.NUMERO_GUIA = TMP.NUMERO_GUIA&#xA;OPTION(RECOMPILE, MAXDOP 4 )&#xA;;&#xA;*/&#xA;-- SET NOCOUNT OFF;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\SC Paso 05 Obtener los procesos logísticos de las guías\PROCESO LOGISTICO MUNICIPIOS"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{98DA7211-725E-48C0-85DC-27AED37CBF51}"
