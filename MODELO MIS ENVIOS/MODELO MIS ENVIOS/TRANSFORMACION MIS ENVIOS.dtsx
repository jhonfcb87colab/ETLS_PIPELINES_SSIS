    <DTS:Executable
      DTS:refId="Package\Paso 53 Actualizar Informacion PQR"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{5FEAF3BA-AE32-47CE-BFC6-B5D7459D18CA}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Paso 53 Actualizar Informacion PQR"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{82E3C266-AD9E-4E38-9443-8FFFA079254B}"
          SQLTask:SqlStatementSource="WITH CTE&#xA;(&#xA;&#x9; G_NUMERO_GUIA&#xA;&#x9;,PQR_NUMERO_CUN&#xA;&#x9;,PQR_ID_FECHA_CUN&#xA;&#x9;,PQR_ID_PQR&#xA;&#x9;,PQR_ESTADO_PQR&#xA;&#x9;,PQR_ID_FECHA_EST_INDEM&#xA;)&#xA;AS&#xA;&#x9;(&#xA;&#x9;&#x9;SELECT &#xA;&#x9;&#x9;&#x9; TMP.G_NUMERO_GUIA&#xA;&#x9;&#x9;&#x9;,PQR.CUN AS PQR_NUMERO_CUN&#xA;&#x9;&#x9;&#x9;,PQR.FECHA_PQR AS PQR_ID_FECHA_CUN&#xA;&#x9;&#x9;&#x9;,PQR.ID_PQR AS PQR_ID_PQR&#xA;&#x9;&#x9;&#x9;,PQR.ESTADO_PQR AS PQR_ESTADO_PQR&#xA;&#x9;&#x9;&#x9;,PQR.FECHA_MODIFICA AS PQR_ID_FECHA_EST_INDEM&#xA;&#x9;&#x9;FROM &#xA;&#x9;&#x9;&#x9;TMP.ME_TBCL TMP WITH (NOLOCK)&#xA;&#x9;&#x9;INNER JOIN &#xA;&#x9;&#x9;&#x9;TMP.ME_TBCL_PQR PQR WITH (NOLOCK)&#xA;&#x9;&#x9;ON &#xA;&#x9;&#x9;&#x9;TMP.G_NUMERO_GUIA = PQR.NUMERO_GUIA&#xA;&#x9;)&#xA;UPDATE&#xA;&#x9;TMP.ME_TBCL&#xA;SET &#xA;&#x9; PQR_TIENE_CUN = 'SI'&#xA;&#x9;,PQR_NUMERO_CUN = ISNULL(CTE.PQR_NUMERO_CUN,0)&#xA;&#x9;,PQR_ID_FECHA_CUN = ISNULL(CTE.PQR_ID_FECHA_CUN,'1900-01-01')&#xA;&#x9;,PQR_FECHA_CUN = CASE WHEN CTE.PQR_ID_FECHA_CUN IS NULL THEN 'NO DISPONIBLE' ELSE CONVERT (VARCHAR,CTE.PQR_ID_FECHA_CUN,111) END &#xA;&#x9;,PQR_ID_PQR = ISNULL(CTE.PQR_ID_PQR,0)&#xA;&#x9;,PQR_EST_INDEM = CTE.PQR_ESTADO_PQR&#xA;&#x9;,PQR_ID_FECHA_EST_INDEM = ISNULL(CTE.PQR_ID_FECHA_EST_INDEM,'1900-01-01')&#xA;&#x9;,PQR_FECHA_EST_INDEM = CASE WHEN CTE.PQR_ID_FECHA_EST_INDEM IS NULL THEN 'NO DISPONIBLE' ELSE CONVERT (VARCHAR,CTE.PQR_ID_FECHA_EST_INDEM,111) END &#xA;FROM &#xA;&#x9; TMP.ME_TBCL TMP WITH (NOLOCK)&#xA;&#x9;INNER JOIN CTE&#xA;ON&#xA;&#x9;TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Paso 57 Actualizar Tareas"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{F3C7E1B1-9E5F-42D8-B4EF-7948D485D340}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Paso 57 Actualizar Tareas"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{82E3C266-AD9E-4E38-9443-8FFFA079254B}"
          SQLTask:SqlStatementSource="WITH CTE &#xA;(&#xA;&#x9; ID&#xA;&#x9;,G_NUMERO_GUIA&#xA;&#x9;,TAR_ID_FECHA_ASIGN_TAREA&#xA;&#x9;,TAR_ID_ESTADO_TAREA&#xA;&#x9;,TAR_RESP_TAREA&#xA;)&#xA;AS &#xA;&#x9;(&#xA;&#x9;&#x9;SELECT&#xA;&#x9;&#x9;&#x9; ROW_NUMBER() OVER(PARTITION BY G.G_NUMERO_GUIA ORDER BY T.FECHA_ASIGN_TAREA DESC) ID&#xA;&#x9;&#x9;&#x9;,G.G_NUMERO_GUIA&#xA;&#x9;&#x9;&#x9;,T.FECHA_ASIGN_TAREA AS TAR_ID_FECHA_ASIGN_TAREA&#xA;&#x9;&#x9;&#x9;,T.ID_EST_TAREA AS TAR_ID_ESTADO_TAREA&#xA;&#x9;&#x9;&#x9;,T.OBSERVACION_RESP_TAREA AS TAR_RESP_TAREA&#xA;&#x9;&#x9;FROM&#xA;&#x9;&#x9;&#x9;TMP.ME_TBCL G WITH(NOLOCK)&#xA;&#x9;&#x9;INNER JOIN&#xA;&#x9;&#x9;&#x9;TMP.ME_TBCL_TAREAS T WITH(NOLOCK) &#xA;&#x9;&#x9;ON&#xA;&#x9;&#x9;&#x9;CONVERT(CHAR(20),G.G_NUMERO_GUIA) = T.NUMERO_DOCPROBLEMA&#xA;&#x9;)&#xA;UPDATE&#xA;&#x9;TMP.ME_TBCL&#xA;SET &#xA;&#x9; TAR_TIENE_TAREA = 'SI'&#xA;&#x9;,TAR_ID_FECHA_ASIGN_TAREA = ISNULL(CTE.TAR_ID_FECHA_ASIGN_TAREA,'1900-01-01')&#xA;&#x9;,TAR_FECHA_ASIGN_TAREA = CASE WHEN CTE.TAR_ID_FECHA_ASIGN_TAREA IS NULL THEN 'NO DISPONIBLE' ELSE CONVERT (VARCHAR,CTE.TAR_ID_FECHA_ASIGN_TAREA,111) END &#xA;&#x9;,TAR_ID_ESTADO_TAREA = ISNULL(CONVERT(INT,CTE.TAR_ID_ESTADO_TAREA),-888)&#xA;&#x9;,TAR_ESTADO_TAREA = CASE WHEN CTE.TAR_ID_ESTADO_TAREA = 1 THEN 'ABIERTA' ELSE 'CERRADA' END &#xA;&#x9;,TAR_RESP_TAREA = CASE WHEN ISNULL(CTE.TAR_RESP_TAREA, '') = '' THEN 'NO DISPONIBLE' ELSE ISNULL(CTE.TAR_RESP_TAREA,'NO DISPONIBLE') END &#xA;FROM&#xA;&#x9;TMP.ME_TBCL G WITH(NOLOCK)&#xA;&#x9;INNER JOIN CTE&#xA;ON&#xA;&#x9;G.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA&#xA;WHERE&#xA;&#x9;CTE.ID = 1 " xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Paso 58 Obtener Informacion Recaudo"
      DTS:CreationName="STOCK:SEQUENCE"
