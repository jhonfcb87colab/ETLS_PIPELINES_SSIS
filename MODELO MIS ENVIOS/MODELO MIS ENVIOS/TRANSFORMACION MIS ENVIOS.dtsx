                          name="OpenRowsetVariable"></property>
                        <property
                          dataType="System.String"
                          description="The SQL command to be executed."
                          name="SqlCommand"
                          UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT
	TMP.G_NUMERO_GUIA AS G_NUMERO_GUIA,
	REI.ID_ESTADO_INDEMNIZACION_PQR AS PQR_ESTADO_INDEMIZACION,
	ESI.NOMBRE_ESTADO_INDEMNIZACION_PQR AS PQR_NOMBRE_ESTADO_INDEMIZACION,
	REI.FECHA_PROCESO_INDEM AS PQR_FECHA_ESTADO_INDEMIZACION
FROM 
	TMP.ME_TBCL TMP WITH(NOLOCK)
LEFT JOIN  
	[FAC].[PQR_RESPONSABILIDAD_INDEM] REI WITH(NOLOCK)
ON
	TMP.PQR_ID_PQR = REI.ID_PQR
LEFT  JOIN 
	DIM.PQR_ESTADOS_INDEMNIZACION ESI WITH(NOLOCK)
ON 
	REI.ID_ESTADO_INDEMNIZACION_PQR = ESI.ID_ESTADO_INDEMNIZACION_PQR</property>
