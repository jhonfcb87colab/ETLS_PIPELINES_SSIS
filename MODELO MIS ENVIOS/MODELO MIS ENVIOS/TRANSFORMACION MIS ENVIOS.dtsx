          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{82E3C266-AD9E-4E38-9443-8FFFA079254B}"
              SQLTask:SqlStatementSource="UPDATE&#xA;&#x9;TMP.ME_TBCL&#xA;SET &#xA;&#x9;SE_EFICIENCIA = CASE WHEN PYM.SE_CUMPLE_EFIC_DEPU = 'SI' AND PYM.SE_ESTADO_ENVIO_HOMOLOGADO = 'ENTREGADO A DESTINATARIO' THEN 'A TIEMPO' ELSE 'TARDE' END&#xA;FROM &#xA;&#x9;TMP.ME_TBCL PYM WITH (NOLOCK)" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
