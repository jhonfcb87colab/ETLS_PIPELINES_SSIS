      DTS:EvaluateAsExpression="True"
      DTS:Expression="YEAR(@[$Project::DtMesFin]) &lt; 2000 || YEAR(@[$Project::DtMesIni]) &lt; 2000 ? &#xA;(YEAR( DATEADD( &quot;DD&quot;, -@[$Project::Incremental]  ,  GETDATE())  ) *100+    MONTH( DATEADD( &quot;DD&quot;, -@[$Project::Incremental]  ,  GETDATE())  ))*100+ DAY( DATEADD( &quot;DD&quot;, -@[$Project::Incremental]  ,  GETDATE())  ) &#xA; : &#xA;(YEAR( @[$Project::DtMesIni]  ) *100+    MONTH( @[$Project::DtMesIni] ))*100+ DAY( @[$Project::DtMesIni] )"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="AUX_01_MES_INI">
