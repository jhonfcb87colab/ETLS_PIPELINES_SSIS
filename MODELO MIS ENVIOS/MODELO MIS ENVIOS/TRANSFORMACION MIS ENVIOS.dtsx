        <SQLTask:SqlTaskData
          SQLTask:Connection="{82E3C266-AD9E-4E38-9443-8FFFA079254B}"
          SQLTask:SqlStatementSource="WITH CTE(&#xA;&#x9;G_NUMERO_GUIA&#xA;&#x9;,EFIC_DIF_DIAS_ENTREGA&#xA;&#x9;,EFIC_DIF_DIAS&#xA;&#x9;,SE_EFICIENCIA_ACIDA&#xA;)AS(&#xA;SELECT&#xA;&#x9;&#x9;TMP.G_NUMERO_GUIA,&#xA;&#x9;&#x9;--TMP.SE_ID_FECHA_INGRESO_CIL,&#xA;&#x9;&#x9;--TMP.SE_ID_FECHA_EV,&#xA;&#x9;&#x9;--TMP.SE_TIEMPO_MATRIZ,&#xA;&#x9;&#x9;DIF.VALOR,&#xA;&#x9;&#x9;DIF.VALOR-TMP.SE_TIEMPO_MATRIZ EFIC_DIF_DIAS,&#xA;&#x9;&#x9;CASE &#xA;&#x9;&#x9;WHEN TMP.SE_ID_FECHA_EV = '1900-01-01 00:00:00.000' AND DIF.VALOR - TMP.SE_TIEMPO_MATRIZ &lt;= 0 THEN 'PENDIENTE' ELSE CASE WHEN DIF.VALOR - TMP.SE_TIEMPO_MATRIZ &gt; 0  THEN 'TARDE' ELSE 'A TIEMPO' END END &#xA;&#x9;&#x9;--TMP.SE_FECHA_EV = '1900-01-01 00:00:00.000' AND  &#xA;&#x9;&#x9;--CASE WHEN ISNULL(SE_ID_FECHA_ENTREGA,'1900-01-01 00:00:00.000') = '1900-01-01 00:00:00.000' THEN 0 ELSE DATEDIFF(DAY,CONVERT(DATE,SE_ID_FECHA_INGRESO_CIL),CONVERT(DATE,SE_ID_FECHA_ENTREGA)) END DIAS_DIF&#xA;FROM &#xA;&#x9;[TMP].[ME_TBCL] TMP WITH(NOLOCK)&#xA;&#x9;INNER JOIN TMP.ME_TBCL_ACIDA_DIAS_DIF DIF WITH(NOLOCK)&#xA;&#x9;ON TMP.G_NUMERO_GUIA = DIF.G_NUMERO_GUIA&#xA;&#xA;)&#xA;UPDATE&#xA;&#x9;[TMP].[ME_TBCL]&#xA;SET&#xA;&#x9;EFIC_DIF_DIAS_ENTREGA = CTE.EFIC_DIF_DIAS_ENTREGA&#xA;&#x9;,EFIC_DIF_DIAS = CTE.EFIC_DIF_DIAS&#xA;&#x9;,SE_EFICIENCIA_ACIDA = CTE.SE_EFICIENCIA_ACIDA&#xA;FROM &#xA;&#x9;TMP.ME_TBCL TMP WITH(NOLOCK), CTE&#xA;WHERE&#xA;&#x9;TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Paso 70 Actualizar Fecha_Entrega"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{0E478306-1569-4C5F-B219-7D53DFA5C2BC}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Paso 70 Actualizar Fecha_Entrega"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{82E3C266-AD9E-4E38-9443-8FFFA079254B}"
          SQLTask:SqlStatementSource="WITH CTE(&#xA;G_NUMERO_GUIA,&#xA;FECHA_ENTREGA&#xA;)AS(&#xA;SELECT &#xA;G_NUMERO_GUIA,&#xA;CASE &#xA;&#x9;WHEN CONVERT(DATETIME,CONVERT(DATE,SE_ID_FECHA_RE)) = '1900-01-01 00:00:00.000' AND CONVERT(DATETIME,CONVERT(DATE,SE_ID_FECHA_EV)) = '1900-01-01 00:00:00.000' THEN 'NO DISPONIBLE'&#xA;&#xA;&#x9;--Validación Escenario 3&#xA;&#x9;WHEN SE_REVERSION = 'SI' AND CONVERT(DATETIME,CONVERT(DATE,SE_ID_FECHA_RE)) &lt;&gt; '1900-01-01 00:00:00.000' &#xA;&#x9;AND CONVERT(DATETIME,CONVERT(DATE,SE_ID_FECHA_RE)) &lt; CONVERT(DATETIME,CONVERT(DATE,SE_ID_FECHA_EV))&#xA;                AND CONVERT(DATETIME,CONVERT(DATE,SE_ID_FECHA_RE_RRE)) &gt;= CONVERT(DATETIME,CONVERT(DATE,SE_ID_FECHA_RRE))&#xA;&#x9;THEN CONVERT(VARCHAR,CONVERT(DATETIME,CONVERT(DATE,SE_ID_FECHA_RE_RRE)),111) &#xA;&#xA;&#x9;--Validación Escenario 8 &#xA;&#x9;WHEN SE_REVERSION = 'SI' AND CONVERT(DATETIME,CONVERT(DATE,SE_ID_FECHA_RE)) &lt;&gt; '1900-01-01 00:00:00.000' &#xA;&#x9;AND CONVERT(DATETIME,CONVERT(DATE,SE_ID_FECHA_EV)) = '1900-01-01 00:00:00.000' &#xA;&#x9;AND CONVERT(DATETIME,CONVERT(DATE,SE_ID_FECHA_RE_RRE)) &gt;= CONVERT(DATETIME,CONVERT(DATE,SE_ID_FECHA_RRE))&#xA;&#x9;THEN CONVERT(VARCHAR,CONVERT(DATETIME,CONVERT(DATE,SE_ID_FECHA_RE_RRE)),111)&#xA;&#xA;&#x9;WHEN SE_REVERSION = 'NO' AND CONVERT(DATETIME,CONVERT(DATE,SE_ID_FECHA_RE)) &lt;&gt; '1900-01-01 00:00:00.000' &#xA;&#x9;AND CONVERT(DATETIME,CONVERT(DATE,SE_ID_FECHA_RE)) &gt;= CONVERT(DATETIME,CONVERT(DATE,SE_ID_FECHA_EV)) &#xA;&#x9;THEN CONVERT(VARCHAR,CONVERT(DATETIME,CONVERT(DATE,SE_ID_FECHA_RE)),111)&#xA;&#xA;&#x9;WHEN SE_REVERSION = 'NO' AND CONVERT(DATETIME,CONVERT(DATE,SE_ID_FECHA_RE)) &lt;&gt; '1900-01-01 00:00:00.000' &#xA;&#x9;AND CONVERT(DATETIME,CONVERT(DATE,SE_ID_FECHA_RE)) &lt;= CONVERT(DATETIME,CONVERT(DATE,SE_ID_FECHA_EV)) &#xA;&#x9;THEN CONVERT(VARCHAR,CONVERT(DATETIME,CONVERT(DATE,SE_ID_FECHA_RE)),111)&#xA;&#xA;&#x9;WHEN SE_REVERSION = 'NO' AND CONVERT(DATETIME,CONVERT(DATE,SE_ID_FECHA_RE)) = '1900-01-01 00:00:00.000' &#xA;&#x9;AND CONVERT(DATETIME,CONVERT(DATE,SE_ID_FECHA_RE)) &lt;= CONVERT(DATETIME,CONVERT(DATE,SE_ID_FECHA_EV)) &#xA;&#x9;THEN CONVERT(VARCHAR,CONVERT(DATETIME,CONVERT(DATE,SE_ID_FECHA_EV)),111)&#xA;ELSE 'NO DISPONIBLE' END FECHA_ENTREGA&#xA;&#xA;&#xA;FROM [TMP].[ME_TBCL] WITH(NOLOCK)&#xA;)&#xA;UPDATE&#xA;&#x9;TMP.ME_TBCL&#xA;SET&#xA;&#x9; FECHA_ENTREGA = CTE.FECHA_ENTREGA&#xA;&#x9;&#xA;FROM&#xA;&#x9;TMP.ME_TBCL BASE&#xA;INNER JOIN&#xA;&#x9;CTE&#xA;ON&#xA;BASE.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;/*&#xA;WITH CTE(&#xA;G_NUMERO_GUIA,&#xA;FECHA_ENTREGA&#xA;)AS(&#xA;SELECT &#xA;G_NUMERO_GUIA,&#xA;CASE &#xA;&#x9;WHEN CONVERT(DATETIME,CONVERT(DATE,SE_ID_FECHA_RE)) = '1900-01-01 00:00:00.000' AND CONVERT(DATETIME,CONVERT(DATE,SE_ID_FECHA_EV)) = '1900-01-01 00:00:00.000' THEN 'NO DISPONIBLE'&#xA;&#xA;&#x9;--Validación Escenario 3&#xA;&#x9;WHEN SE_REVERSION = 'SI' AND CONVERT(DATETIME,CONVERT(DATE,SE_ID_FECHA_RE)) &lt;&gt; '1900-01-01 00:00:00.000' &#xA;&#x9;AND CONVERT(DATETIME,CONVERT(DATE,SE_ID_FECHA_RE)) &lt; CONVERT(DATETIME,CONVERT(DATE,SE_ID_FECHA_EV))&#xA;&#x9;THEN CONVERT(VARCHAR,CONVERT(DATETIME,CONVERT(DATE,SE_ID_FECHA_RE_RRE)),111) &#xA;&#xA;&#x9;--Validación Escenario 8 &#xA;&#x9;WHEN SE_REVERSION = 'SI' AND CONVERT(DATETIME,CONVERT(DATE,SE_ID_FECHA_RE)) &lt;&gt; '1900-01-01 00:00:00.000' &#xA;&#x9;AND CONVERT(DATETIME,CONVERT(DATE,SE_ID_FECHA_EV)) = '1900-01-01 00:00:00.000' &#xA;&#x9;THEN CONVERT(VARCHAR,CONVERT(DATETIME,CONVERT(DATE,SE_ID_FECHA_RE_RRE)),111)&#xA;&#xA;&#x9;WHEN SE_REVERSION = 'NO' AND CONVERT(DATETIME,CONVERT(DATE,SE_ID_FECHA_RE)) &lt;&gt; '1900-01-01 00:00:00.000' &#xA;&#x9;AND CONVERT(DATETIME,CONVERT(DATE,SE_ID_FECHA_RE)) &gt;= CONVERT(DATETIME,CONVERT(DATE,SE_ID_FECHA_EV)) &#xA;&#x9;THEN CONVERT(VARCHAR,CONVERT(DATETIME,CONVERT(DATE,SE_ID_FECHA_RE)),111)&#xA;&#xA;&#x9;WHEN SE_REVERSION = 'NO' AND CONVERT(DATETIME,CONVERT(DATE,SE_ID_FECHA_RE)) &lt;&gt; '1900-01-01 00:00:00.000' &#xA;&#x9;AND CONVERT(DATETIME,CONVERT(DATE,SE_ID_FECHA_RE)) &lt;= CONVERT(DATETIME,CONVERT(DATE,SE_ID_FECHA_EV)) &#xA;&#x9;THEN CONVERT(VARCHAR,CONVERT(DATETIME,CONVERT(DATE,SE_ID_FECHA_RE)),111)&#xA;&#xA;&#x9;WHEN SE_REVERSION = 'NO' AND CONVERT(DATETIME,CONVERT(DATE,SE_ID_FECHA_RE)) = '1900-01-01 00:00:00.000' &#xA;&#x9;AND CONVERT(DATETIME,CONVERT(DATE,SE_ID_FECHA_RE)) &lt;= CONVERT(DATETIME,CONVERT(DATE,SE_ID_FECHA_EV)) &#xA;&#x9;THEN CONVERT(VARCHAR,CONVERT(DATETIME,CONVERT(DATE,SE_ID_FECHA_EV)),111)&#xA;ELSE 'NO DISPONIBLE' END FECHA_ENTREGA&#xA;&#xA;&#xA;FROM [TMP].[ME_TBCL] WITH(NOLOCK)&#xA;)&#xA;UPDATE&#xA;&#x9;TMP.ME_TBCL&#xA;SET&#xA;&#x9; FECHA_ENTREGA = CTE.FECHA_ENTREGA&#xA;&#x9;&#xA;FROM&#xA;&#x9;TMP.ME_TBCL BASE&#xA;INNER JOIN&#xA;&#x9;CTE&#xA;ON&#xA;BASE.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA&#xA;&#xA;*/" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
