          DTS:ObjectName="Paso 61 Actualizar Base EF"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{82E3C266-AD9E-4E38-9443-8FFFA079254B}"
              SQLTask:SqlStatementSource="WITH CTE&#xA;(&#xA;&#x9; G_NUMERO_GUIA&#xA;&#x9;,EF_PROYECTO &#xA;&#x9;,EF_ORDEN_SERVICIO&#xA;&#x9;,EF_VALOR&#xA;)&#xA;AS&#xA;&#x9;(&#xA;&#x9;&#x9;SELECT &#xA;&#x9;&#x9;&#x9; TMP.G_NUMERO_GUIA&#xA;&#x9;&#x9;&#x9;,GREF.EF_PROYECTO&#xA;&#x9;&#x9;&#x9;,GREF.EF_ORDEN_SERVICIO&#xA;&#x9;&#x9;&#x9;,GREF.EF_VALOR&#xA;&#x9;&#x9;FROM &#xA;&#x9;&#x9;&#x9;[TMP].[ME_TBCL] TMP WITH (NOLOCK)&#xA;&#x9;&#x9;INNER JOIN &#xA;&#x9;&#x9;&#x9;[TMP].[ME_TBCL_GREF] GREF WITH (NOLOCK)&#xA;&#x9;&#x9;ON &#xA;&#x9;&#x9;&#x9;TMP.G_NUMERO_GUIA = GREF.EF_NUMERO_GUIA&#xA;&#x9;)&#xA;UPDATE &#xA;&#x9; [TMP].[ME_TBCL]&#xA;SET &#xA;&#x9; EF_PROYECTO = CTE.EF_PROYECTO&#xA;&#x9;,EF_ORDEN_SERVICIO = CTE.EF_ORDEN_SERVICIO&#xA;&#x9;,EF_VALOR = CTE.EF_VALOR&#xA;FROM &#xA;&#x9;[TMP].[ME_TBCL] TMP WITH (NOLOCK) INNER JOIN&#xA;&#x9;CTE&#xA;ON&#xA;&#x9;TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
