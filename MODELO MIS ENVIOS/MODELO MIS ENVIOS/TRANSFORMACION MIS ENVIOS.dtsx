    <DTS:Executable
      DTS:refId="Package\Paso 67 Calcula estado actual DEV RMTE"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{03bd1d33-f52f-4bc1-ac7a-aa87a39d3a71}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Paso 67 Calcula estado actual DEV RMTE"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{82E3C266-AD9E-4E38-9443-8FFFA079254B}"
          SQLTask:SqlStatementSource="WITH CTE&#xA;(&#xA;&#x9;ID&#xA;&#x9;,G_NUMERO_GUIA&#xA;&#x9;,ID_PROCESO&#xA;&#x9;,ID_CONCEPTO&#xA;)&#xA;AS&#xA;(&#xA;&#x9;SELECT &#xA;&#x9;&#x9; ROW_NUMBER() OVER (PARTITION BY CONF.NUMERO_GUIA ORDER BY CONF.FECHA_CONFIRMACION ) ID&#xA;&#x9;&#x9;,TBCL.G_NUMERO_GUIA&#xA;&#x9;&#x9;,CONF.ID_PROCESO&#xA;&#x9;&#x9;,CONF.ID_CONCEPTO&#xA;&#x9;FROM&#xA;&#x9;&#x9; TMP.ME_TBCL TBCL WITH(NOLOCK) &#xA;&#x9;&#x9;INNER JOIN [LOG].CONFIRMACIONES CONF WITH(NOLOCK)&#xA;&#x9;ON&#xA;&#x9;&#x9;TBCL.G_NUMERO_GUIA = CONF.NUMERO_GUIA&#xA;&#x9;WHERE&#xA;&#x9;&#x9;CONF.ID_SOLUCION IN (3,19)&#xA;&#x9;AND&#xA;&#x9;&#x9;TBCL.SE_TIPO_ESTADO_ENVIO = 1&#xA;)&#xA;&#xA;UPDATE &#xA;&#x9;TMP.ME_TBCL&#xA;SET&#xA;&#x9; SE_TIPO_ESTADO_ENVIO = 2&#xA;&#x9;,SE_NOVE_DEV_REM = PRO.NOMBRE_PROCESO_LOG + ' - ' +  CASE WHEN ICO.NOMBRE_CONCEPTO IS NULL THEN 'NO DISPONIBLE' ELSE ICO.NOMBRE_CONCEPTO END &#xA;FROM&#xA;&#x9; TMP.ME_TBCL TMP WITH(NOLOCK)&#xA;&#x9;,CTE&#xA;INNER JOIN &#xA;&#x9;PAR.PROCESOS PRO&#xA;ON &#xA;&#x9;CTE.ID_PROCESO = PRO.ID_PROCESO &#xA;LEFT JOIN &#xA;&#x9;PAR.ITEM_CONCEPTO ICO&#xA;ON&#xA;&#x9;CTE.ID_PROCESO = ICO.ID_PROCESO&#xA;AND&#xA;&#x9;CTE.ID_CONCEPTO = ICO.ID_CONCEPTO&#xA;WHERE&#xA;&#x9;TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA&#xA;AND &#xA;&#x9;CTE.ID = 1" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
