    <DTS:Executable
      DTS:refId="Package\Paso 48 Obtener Guias Confirmadas"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{d34daeac-4db7-4209-b859-1b37f942161e}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Paso 48 Obtener Guias Confirmadas"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{82E3C266-AD9E-4E38-9443-8FFFA079254B}"
          SQLTask:SqlStatementSource="WITH CTE &#xA;(&#xA;&#x9; ID&#xA;&#x9;,NUMERO_GUIA&#xA;&#x9;,FECHA_CONFIRMACION&#xA;&#x9;,ID_SOLUCION&#xA;&#x9;,OBSERVACIONES_CONFIRMACION&#xA;)&#xA;AS&#xA;&#x9;(&#xA;&#x9;&#x9;SELECT &#xA;&#x9;&#x9;&#x9; ROW_NUMBER() OVER(PARTITION BY NUMERO_GUIA ORDER BY FECHA_CONFIRMACION ASC) ID&#xA;&#x9;&#x9;&#x9;,CONF.NUMERO_GUIA&#xA;&#x9;&#x9;&#x9;,CONF.FECHA_CONFIRMACION&#xA;&#x9;&#x9;&#x9;,CONF.ID_SOLUCION&#xA;&#x9;&#x9;&#x9;,CONF.OBSERVACIONES_CONFIRMACION&#xA;&#x9;&#x9;FROM &#xA;&#x9;&#x9;&#x9;LOG.CONFIRMACIONES CONF WITH (NOLOCK)&#xA;&#x9;&#x9;INNER JOIN &#xA;&#x9;&#x9;&#x9;TMP.ME_TBCL TMP WITH (NOLOCK)&#xA;&#x9;&#x9;ON &#xA;&#x9;&#x9;&#x9;CONF.NUMERO_GUIA = TMP.G_NUMERO_GUIA&#xA;&#x9;)&#xA;INSERT INTO TMP.ME_TBCL_CONF&#xA;(&#xA;&#x9; ID&#xA;&#x9;,G_NUMERO_GUIA&#xA;&#x9;,FECHA_CONFIRMACION&#xA;&#x9;,ID_SOLUCION&#xA;&#x9;,OBSERVACIONES_CONFIRMACION&#xA;)&#xA;SELECT &#xA;&#x9; CTE.ID&#xA;&#x9;,CTE.NUMERO_GUIA&#xA;&#x9;,CTE.FECHA_CONFIRMACION&#xA;&#x9;,CTE.ID_SOLUCION&#xA;&#x9;,CTE.OBSERVACIONES_CONFIRMACION&#xA;FROM &#xA;&#x9;CTE" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Paso 49 Actualizar Confimaciones"
