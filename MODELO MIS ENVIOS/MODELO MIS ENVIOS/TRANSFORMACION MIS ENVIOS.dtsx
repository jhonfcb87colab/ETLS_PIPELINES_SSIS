      DTS:ObjectName="Sequence Container">
      <DTS:Variables />
      <DTS:Executables>
        <DTS:Executable
          DTS:refId="Package\Sequence Container\Paso 08 Actualizar fecha"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{F2A17804-400F-418E-837C-3CC94886DC82}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Paso 08 Actualizar fecha"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{82E3C266-AD9E-4E38-9443-8FFFA079254B}"
              SQLTask:SqlStatementSource="WITH CTE&#xA;(&#xA;&#x9; NUMERO_GUIA&#xA;&#x9;,SE_FECHA&#xA;)&#xA;AS&#xA;&#x9;(&#xA;&#x9;&#x9;SELECT&#xA;&#x9;&#x9;&#x9;NUMERO_GUIA&#xA;&#x9;&#x9;&#x9;,MIN(FECHA_HORA_MOVIMIENTO) SE_FECHA&#xA;&#x9;&#x9;FROM&#xA;&#x9;&#x9;&#x9;TMP.ME_TBCL_04 WITH(NOLOCK)&#xA;&#x9;&#x9;WHERE&#xA;&#x9;&#x9;&#x9;ID_PROCESO IN (5,6,8,14)&#xA;&#x9;&#x9;GROUP BY&#xA;&#x9;&#x9;&#x9;NUMERO_GUIA&#xA;&#x9;)&#xA;&#xA;UPDATE &#xA;&#x9;TMP.ME_TBCL_02&#xA;SET&#xA;&#x9;SE_FECHA = CTE.SE_FECHA&#xA;FROM&#xA;&#x9;TMP.ME_TBCL_02 AS TMP&#xA;INNER JOIN&#xA;&#x9;CTE&#xA;ON&#xA;&#x9;TMP.NUMERO_GUIA = CTE.NUMERO_GUIA" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Sequence Container\Paso 09 Armar Base ME_TBCL"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{5D787D67-EBF0-414D-AD39-55AF7B8189DC}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Paso 09 Armar Base ME_TBCL"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{82E3C266-AD9E-4E38-9443-8FFFA079254B}"
              SQLTask:SqlStatementSource="INSERT INTO &#xA;&#x9;[TMP].[ME_TBCL]&#xA;(&#xA;&#x9; G_NUMERO_GUIA&#xA;&#x9;,G_NUMERO_PIEZAS&#xA;&#x9;,G_ID_PROD_SUBPRO&#xA;&#x9;,G_ID_TIEMPO&#xA;&#x9;,G_ID_MEDTRANS&#xA;&#x9;,G_ID_ESTADOENVIO&#xA;&#x9;,G_ID_CIUDAD_ORIGEN&#xA;&#x9;,G_ID_CIUDAD_DESTINO&#xA;&#x9;,SE_ID_FECHA&#xA;&#x9;,SE_FECHA_HORA&#xA;&#x9;,SE_FECHA&#xA;&#x9;,SE_HORA&#xA;&#x9;,SE_DIA&#xA;&#x9;,G_NOMBRE_DESTINATARIO&#xA;&#x9;,G_TELEFONO_DESTINATARIO&#xA;&#x9;,G_DIRECCION_DESTINATARIO&#xA;&#x9;,G_ID_CLIENTE&#xA;&#x9;,G_NOMBRE_REMITENTE&#xA;&#x9;,G_DIRECCION_REMITENTE&#xA;&#x9;,G_TELEFONO_REMITENTE&#xA;&#x9;,G_CONTENIDO&#xA;&#x9;,G_FECHA_ENVIO&#xA;&#x9;,G_HORA_ENVIO&#xA;&#x9;,G_DIA_ENVIO&#xA;&#x9;,G_VALOR_DECLARADO&#xA;&#x9;,G_ID_FECHA_ESTADO&#xA;&#x9;,G_FECHA_ESTADO&#xA;&#x9;,G_ID_1&#xA;&#x9;,G_ID_2&#xA;&#x9;,SE_ID_FECHA_INGRESO_CIL&#xA;&#x9;,SE_FECHA_INGRESO_CIL&#xA;&#x9;,SE_HORA_INGRESO_CIL&#xA;&#x9;,SE_DIA_INGRESO_CIL&#xA;)&#xA;SELECT &#xA;&#x9; NUMERO_GUIA AS G_NUMERO_GUIA&#xA;&#x9;,ISNULL(NUMERO_PIEZAS,1) AS G_NUMERO_PIEZAS&#xA;&#x9;,ISNULL(CONVERT (VARCHAR,ID_PRODUCTO) +'-'+ CONVERT (VARCHAR,ID_SUBPRODUCTO),'-888') G_ID_PROD_SUBPRO&#xA;&#x9;,ISNULL(ID_TIEMPO,-888) G_ID_TIEMPO&#xA;&#x9;,ISNULL(ID_MEDTRANS,-888) G_ID_MEDTRANS&#xA;&#x9;,ISNULL(ID_ESTADOENVIO,-888) G_ID_ESTADOENVIO&#xA;&#x9;,ISNULL(ID_CIUDAD_ORIGEN,-888) G_ID_CIUDAD_ORIGEN&#xA;&#x9;,ISNULL(ID_CIUDAD_DESTINO,-888) G_ID_CIUDAD_DESTINO&#xA;&#x9;,CONVERT(INT,CONVERT(NUMERIC,CONVERT(DATETIME,CONVERT(CHAR(11),SE_FECHA)))) SE_ID_FECHA&#xA;&#x9;,SE_FECHA AS SE_FECHA_HORA &#xA;&#x9;,CASE WHEN SE_FECHA = '1900-01-01' THEN 'NO DISPONIBLE' ELSE CONVERT (VARCHAR,SE_FECHA,111) END AS SE_FECHA&#xA;&#x9;,CASE WHEN SE_FECHA = '1900-01-01' THEN 'NO DISPONIBLE' ELSE CONVERT(VARCHAR(8),SE_FECHA,114) END AS SE_HORA&#xA;&#x9;,CASE WHEN SE_FECHA = '1900-01-01' THEN 'NO DISPONIBLE' ELSE CASE DATEPART(dw,SE_FECHA) WHEN 2 THEN 'Lunes' WHEN 3 THEN 'Martes' WHEN 4 THEN 'Miércoles' WHEN 5 THEN 'Jueves' WHEN 6 THEN 'Viernes' WHEN 7 THEN 'Sábado' WHEN 1 THEN 'Domingo' END END AS SE_DIA&#xA;&#x9;,CASE WHEN ISNULL(NOMBRE_DESTINA_GUIA,'') = '' AND ISNULL(APELLIDO_DESTINA_GUIA,'') = '' THEN  'NO DISPONIBLE' ELSE ISNULL(NOMBRE_DESTINA_GUIA,'') + ' ' + ISNULL(APELLIDO_DESTINA_GUIA,'') END G_NOMBRE_DESTINATARIO&#xA;&#x9;,CASE WHEN ISNULL(TELEFONO_DESTINA_GUIA,'') = '' THEN  'NO DISPONIBLE' ELSE TELEFONO_DESTINA_GUIA END G_TELEFONO_DESTINATARIO&#xA;&#x9;,CASE WHEN ISNULL(DIRECCION_DESTINA_GUIA,'') = '' THEN  'NO DISPONIBLE' ELSE DIRECCION_DESTINA_GUIA END G_DIRECCION_DESTINATARIO&#xA;&#x9;,ISNULL(ID_REMITE,'-888') AS G_ID_CLIENTE&#xA;&#x9;,CASE WHEN ISNULL(NOMBRE_REMITE_GUIA,'') = '' AND ISNULL(APELLIDO_REMITE_GUIA,'') = '' THEN  'NO DISPONIBLE' ELSE ISNULL(NOMBRE_REMITE_GUIA,'') + ' ' + ISNULL(APELLIDO_REMITE_GUIA,'') END G_NOMBRE_REMITENTE&#xA;&#x9;,CASE WHEN ISNULL(DIRECCION_REMITE_GUIA,'') = '' THEN  'NO DISPONIBLE' ELSE DIRECCION_REMITE_GUIA END G_DIRECCION_REMITENTE&#xA;&#x9;,CASE WHEN ISNULL(TELEFONO_REMITE_GUIA,'') = '' THEN  'NO DISPONIBLE' ELSE TELEFONO_REMITE_GUIA END G_TELEFONO_REMITENTE&#xA;&#x9;,CASE WHEN ISNULL(CONTENIDO,'') = '' THEN  'NO DISPONIBLE' ELSE CONTENIDO END G_CONTENIDO&#xA;&#x9;,CASE WHEN FECHA_ENVIO = '1900-01-01' THEN 'NO DISPONIBLE' ELSE CONVERT(VARCHAR,FECHA_ENVIO,111) END AS G_FECHA_ENVIO&#xA;&#x9;,CASE WHEN FECHA_ENVIO = '1900-01-01' THEN 'NO DISPONIBLE' ELSE CONVERT(VARCHAR(8),FECHA_ENVIO,114) END AS G_HORA_ENVIO&#xA;&#x9;,CASE WHEN FECHA_ENVIO = '1900-01-01' THEN 'NO DISPONIBLE' ELSE CASE DATEPART(dw,FECHA_ENVIO) WHEN 2 THEN 'LUNES' WHEN 3 THEN 'MARTES' WHEN 4 THEN 'MIERCOLES' WHEN 5 THEN 'JUEVES' WHEN 6 THEN 'VIERNES' WHEN 7 THEN 'SABADO' WHEN 1 THEN 'DOMINGO' END END AS G_DIA_ENVIO&#xA;&#x9;,ISNULL(VALOR_DECLARADO_GUIA,0) AS G_VALOR_DECLARADO&#xA;&#x9;,ISNULL(FECHA_MODIFICACION,'1900-01-01') AS G_ID_FECHA_ESTADO&#xA;&#x9;,CASE WHEN FECHA_MODIFICACION = '1900-01-01' THEN 'NO DISPONIBLE' ELSE CONVERT (VARCHAR,FECHA_MODIFICACION,111) END AS G_FECHA_ESTADO&#xA;&#x9;,ISNULL(ID_1,0) AS G_ID_1&#xA;&#x9;,ISNULL(ID_2,0) AS G_ID_2&#xA;&#x9;,ISNULL(FECHA_ENVIO,'1900-01-01') AS SE_ID_FECHA_INGRESO_CIL&#xA;&#x9;,CASE WHEN FECHA_ENVIO = '1900-01-01' THEN 'NO DISPONIBLE' ELSE CONVERT(VARCHAR,FECHA_ENVIO,111) END AS SE_FECHA_INGRESO_CIL&#xA;&#x9;,CASE WHEN FECHA_ENVIO = '1900-01-01' THEN 'NO DISPONIBLE' ELSE CONVERT(VARCHAR(8),FECHA_ENVIO,114) END AS SE_HORA_INGRESO_CIL&#xA;&#x9;,CASE WHEN FECHA_ENVIO = '1900-01-01' THEN 'NO DISPONIBLE' ELSE CASE DATEPART(dw,FECHA_ENVIO) WHEN 2 THEN 'LUNES' WHEN 3 THEN 'MARTES' WHEN 4 THEN 'MIERCOLES' WHEN 5 THEN 'JUEVES' WHEN 6 THEN 'VIERNES' WHEN 7 THEN 'SABADO' WHEN 1 THEN 'DOMINGO' END END AS SE_DIA_INGRESO_CIL&#xA;FROM&#xA;&#x9;TMP.ME_TBCL_02 WITH (NOLOCK)" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Sequence Container\Paso 10 Actualizar Codigo Ser"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{07D36F31-53C5-4941-B79A-16CCB19DE51F}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Paso 10 Actualizar Codigo Ser"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{82E3C266-AD9E-4E38-9443-8FFFA079254B}"
              SQLTask:SqlStatementSource="SET STATISTICS IO, TIME ON;&#xA;&#xA;UPDATE TMP&#xA;SET   G_COD_SER = ISNULL(PAR.ID_CLIENTE_PS, 'NO DISPONIBLE')&#xA;FROM TMP.ME_TBCL AS TMP&#xA;INNER JOIN PAR.CLIENTES_SUCURSALES_DEPENDEN AS PAR&#xA;  ON  TMP.G_ID_CLIENTE = PAR.ID_CLIENTE&#xA;  AND TMP.G_ID_1       = PAR.ID_SUCURSAL&#xA;  AND TMP.G_ID_2       = PAR.ID_DEPENDEN&#xA;WHERE ISNULL(TMP.G_COD_SER, '') &lt;&gt; ISNULL(PAR.ID_CLIENTE_PS, 'NO DISPONIBLE');  -- evita escrituras innecesarias&#xA;&#xA;SET STATISTICS IO, TIME OFF;&#xA;&#xA;&#xA;&#xA;&#xA;/*&#xA;UPDATE      TMP&#xA;&#x9;SET   G_COD_SER = ISNULL(PAR.ID_CLIENTE_PS, 'NO DISPONIBLE')&#xA;FROM&#xA;&#x9;TMP.ME_TBCL AS TMP WITH (NOLOCK)&#xA;INNER JOIN&#xA;&#x9;PAR.CLIENTES_SUCURSALES_DEPENDEN AS PAR WITH (NOLOCK)&#xA;ON &#xA;&#x9;TMP.G_ID_CLIENTE = PAR.ID_CLIENTE&#xA;AND&#xA;&#x9;TMP.G_ID_1 = PAR.ID_SUCURSAL&#xA;AND&#xA;&#x9;TMP.G_ID_2 = PAR.ID_DEPENDEN&#xA;*/" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Sequence Container\Paso 11 Obtener Info Adicional"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{A5A2F8FB-6862-4FEB-819B-E55B268D9926}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Paso 11 Obtener Info Adicional"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{82E3C266-AD9E-4E38-9443-8FFFA079254B}"
              SQLTask:SqlStatementSource="INSERT INTO [TMP].[ME_TBCL_09]&#xA;(&#xA;&#x9; G_NUMERO_GUIA&#xA;&#x9;,ID_FORMAPAGO_GUIA&#xA;&#x9;,CODIGO_POSTAL_REMITENTE&#xA;&#x9;,GENERA_LOGISTICA_INVERSA&#xA;&#x9;,NUMERO_GUIA_ASOCIADA&#xA;)&#xA;SELECT &#xA;&#x9; A.G_NUMERO_GUIA&#xA;&#x9;,B.ID_FORMAPAGO_GUIA&#xA;&#x9;,B.CODIGO_POSTAL_REMITENTE&#xA;&#x9;,B.GENERA_LOGISTICA_INVERSA&#xA;&#x9;,B.NUMERO_GUIA_ASOCIADA&#xA;FROM &#xA;&#x9;[TMP].[ME_TBCL] AS [A] WITH (NOLOCK)&#xA;INNER JOIN &#xA;&#x9;[LOG].[GUIAS_INF_ADICIONAL] AS [B] WITH (NOLOCK) &#xA;ON&#xA;&#x9;[A].[G_NUMERO_GUIA] = [B].[NUMERO_GUIA]" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Sequence Container\Paso 12 Actualizar CodPostal, Id_ForPago"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{28376694-CBA5-4312-9A6D-E713D80CC451}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Paso 12 Actualizar CodPostal, Id_ForPago"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{82E3C266-AD9E-4E38-9443-8FFFA079254B}"
              SQLTask:SqlStatementSource="UPDATE &#xA;&#x9;[TMP].[ME_TBCL]&#xA;SET &#xA;&#x9;GINF_ID_FORMAPAGO = ISNULL(CONVERT(INT,B.ID_FORMAPAGO_GUIA),-888),&#xA;&#x9;GINF_CODPOSTAL_REMITENTE = &#x9;ISNULL(B.CODIGO_POSTAL_REMITENTE,'NO DISPONIBLE')&#xA;FROM &#xA;&#x9; [TMP].[ME_TBCL] AS A  &#xA;INNER JOIN&#xA;&#x9; [TMP].[ME_TBCL_09] AS B &#xA;ON&#xA;&#x9;A.G_NUMERO_GUIA = B.G_NUMERO_GUIA" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Sequence Container\Paso 13 Actualizar Estado Guia Inversa"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{8B904B1B-36D0-4D7F-AE20-462973C2B640}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Paso 13 Actualizar Estado Guia Inversa"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{82E3C266-AD9E-4E38-9443-8FFFA079254B}"
              SQLTask:SqlStatementSource="WITH CTE &#xA;(&#xA;&#x9; G_NUMERO_GUIA&#xA;&#x9;,GENERA_LOGISTICA_INVERSA&#xA;)&#xA;AS&#xA;(&#xA;&#x9;SELECT &#xA;&#x9;&#x9; T.G_NUMERO_GUIA&#xA;&#x9;&#x9;,A.GENERA_LOGISTICA_INVERSA&#xA;&#x9;FROM&#xA;&#x9;&#x9;[TMP].[ME_TBCL]  AS T WITH (NOLOCK)&#xA;&#x9;INNER JOIN &#xA;&#x9;&#x9;[TMP].[ME_TBCL_09] AS A WITH (NOLOCK)&#xA;&#x9;ON&#xA;&#x9;&#x9;T.G_NUMERO_GUIA = A.G_NUMERO_GUIA&#xA;&#x9;INNER JOIN &#xA;&#x9;&#x9;LOG.GUIAS_6MESES AS B WITH (NOLOCK)&#xA;&#x9;ON &#xA;&#x9;&#x9;A.NUMERO_GUIA_ASOCIADA = B.NUMERO_GUIA&#x9;&#xA;&#x9;WHERE &#xA;&#x9;&#x9;A.GENERA_LOGISTICA_INVERSA = 1&#xA;)&#xA;&#xA;&#xA;UPDATE &#xA;&#x9;[TMP].[ME_TBCL]&#xA;SET &#xA;&#x9;GINF_EST_GUIA_INVERSA = CASE WHEN CTE.GENERA_LOGISTICA_INVERSA = 1 THEN 'SI' ELSE GINF_EST_GUIA_INVERSA END &#xA;FROM &#xA;&#x9;[TMP].[ME_TBCL] AS A WITH (NOLOCK) &#xA;INNER JOIN  CTE&#xA;&#x9;ON  A.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Sequence Container\Paso 14 Actualizar Sobreporte"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{4e01d149-7add-487e-b162-f543012a491d}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Paso 14 Actualizar Sobreporte"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{82E3C266-AD9E-4E38-9443-8FFFA079254B}"
              SQLTask:SqlStatementSource="WITH CTE &#xA;(&#xA;&#x9; G_NUMERO_GUIA&#xA;&#x9;,GENERA_LOGISTICA_INVERSA&#xA;&#x9;,NUMERO_GUIA_ASOCIADA&#xA;&#x9;,ID_ESTADOENVIO&#xA;)&#xA;AS&#xA;&#x9;(&#xA;&#x9;&#x9;SELECT &#xA;&#x9;&#x9;&#x9; T.G_NUMERO_GUIA&#xA;&#x9;&#x9;&#x9;,A.GENERA_LOGISTICA_INVERSA&#xA;&#x9;&#x9;&#x9;,A.NUMERO_GUIA_ASOCIADA&#xA;&#x9;&#x9;&#x9;,B.ID_ESTADOENVIO&#xA;&#x9;&#x9;FROM&#xA;&#x9;&#x9;&#x9;[TMP].[ME_TBCL]  T WITH (NOLOCK)&#xA;&#x9;&#x9;INNER JOIN &#xA;&#x9;&#x9;&#x9;[TMP].[ME_TBCL_09] A WITH (NOLOCK)&#xA;&#x9;&#x9;ON&#xA;&#x9;&#x9;&#x9;T.G_NUMERO_GUIA = A.G_NUMERO_GUIA&#xA;&#x9;&#x9;INNER JOIN &#xA;&#x9;&#x9;&#x9;LOG.GUIAS B WITH (NOLOCK)&#xA;&#x9;&#x9;ON &#xA;&#x9;&#x9;&#x9;A.NUMERO_GUIA_ASOCIADA = B.NUMERO_GUIA&#x9;&#xA;&#x9;&#x9;WHERE &#xA;&#x9;&#x9;&#x9;A.GENERA_LOGISTICA_INVERSA = 1&#xA;&#x9;&#x9;AND&#xA;&#x9;&#x9;&#x9;B.ID_PRODUCTO = 52&#xA;&#x9;)&#xA;&#xA;UPDATE &#xA;&#x9;[TMP].[ME_TBCL]&#xA;SET &#xA;&#x9; GINF_SOBREPORTE = CASE WHEN CTE.GENERA_LOGISTICA_INVERSA = 1 THEN 'SI' ELSE GINF_SOBREPORTE  END &#xA;&#x9;,GINF_GUIA_RETORNO  = CASE WHEN CTE.GENERA_LOGISTICA_INVERSA = 1 THEN CTE.NUMERO_GUIA_ASOCIADA ELSE GINF_GUIA_RETORNO END&#xA;&#x9;,GINF_GUIA_RETORNO_ID_ESTADO = CASE WHEN CTE.GENERA_LOGISTICA_INVERSA = 1 THEN ISNULL(CONVERT(INT,CTE.ID_ESTADOENVIO),-888) ELSE GINF_GUIA_RETORNO_ID_ESTADO END&#xA;FROM &#xA;&#x9;[TMP].[ME_TBCL] A WITH (NOLOCK) INNER  JOIN  CTE&#xA;ON &#xA;&#x9;A.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA&#xA;GO&#xA;&#xA;UPDATE &#xA;&#x9;[TMP].[ME_TBCL]&#xA;SET &#xA;&#x9;GINF_GUIA_RETORNO_ESTADO = ISNULL(NOMBRE_ESTADOENVIO,'NO DISPONIBLE')&#xA;FROM &#xA;&#x9;[TMP].[ME_TBCL] A WITH (NOLOCK)&#xA;INNER JOIN&#xA;&#x9;PAR.ESTADOSENVIO B WITH (NOLOCK)&#xA;ON &#xA;&#x9;A.GINF_GUIA_RETORNO_ID_ESTADO = B.ID_ESTADOENVIO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Sequence Container\Paso 15 Actualizar Bolsa Seguridad"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{8BD07DF0-6B73-45A5-A258-EE09711762A7}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Paso 15 Actualizar Bolsa Seguridad"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{82E3C266-AD9E-4E38-9443-8FFFA079254B}"
              SQLTask:SqlStatementSource="WITH CTE &#xA;(&#xA;&#x9; G_NUMERO_GUIA&#xA;&#x9;,MARCA&#xA;)&#xA;AS&#xA;(&#xA;SELECT   &#xA;&#x9; PYM.G_NUMERO_GUIA&#xA;&#x9;,'SI' MARCA&#xA;FROM            &#xA;&#x9;[TMP].[ME_TBCL] PYM WITH (NOLOCK)&#xA;INNER JOIN  &#xA;&#x9;RTW.GUIDE AS G WITH (NOLOCK)&#xA;ON&#xA;&#x9;G.Number = PYM.G_NUMERO_GUIA&#x9;&#xA;INNER JOIN &#xA;&#x9;RTW.INVOICEDETAIL AS D WITH (NOLOCK)&#xA;ON &#xA;&#x9;G.InvoiceDetailId = D.Id&#xA;WHERE&#xA;&#x9;D.ReferenceNumber IS NOT NULL&#xA;)&#xA;&#xA;UPDATE &#xA;&#x9;[TMP].[ME_TBCL]&#xA;SET &#xA;&#x9;RTW_BOLSA_SEGURIDAD = CTE.MARCA&#xA;FROM &#xA;&#x9;[TMP].[ME_TBCL] A WITH (NOLOCK) INNER JOIN CTE&#xA;ON&#xA;&#x9;A.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Sequence Container\Paso 16 Actualizar FormaPago"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{7F87EA70-72EF-4299-8082-78AD3A2666FA}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
