    <DTS:Executable
      DTS:refId="Package\Paso 50 Actualizar Vejez"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{8754C0BA-8BBE-4A88-97F4-2AECB2FD9692}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Paso 50 Actualizar Vejez"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{82E3C266-AD9E-4E38-9443-8FFFA079254B}"
          SQLTask:SqlStatementSource="UPDATE&#xA;&#x9;[TMP].[ME_TBCL]&#xA;SET&#xA;&#x9;SE_VEJEZ_ENVIO = CONVERT(VARCHAR,DATEDIFF(DD,SE_ID_FECHA_INGRESO_CIL,SE_ID_ULTI_FECHA) )&#xA;FROM&#xA;&#x9;[TMP].[ME_TBCL] NOLOCK&#xA;WHERE&#xA;&#x9;SE_ID_FECHA_TIPO_ESTADO_ENVIO = '1900-01-01'&#xA;AND&#xA;&#x9;SE_ID_ULTI_FECHA &lt;&gt; '1900-01-01'&#xA;AND&#xA;&#x9;DATEDIFF(DD,SE_ID_FECHA_INGRESO_CIL,SE_ID_ULTI_FECHA) &gt;= 0" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Paso 51 Calcular Diferencia y Dias Entrega"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{EEDB261F-07C4-4790-B67F-B70A6631C54C}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Paso 51 Calcular Diferencia y Dias Entrega"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{82E3C266-AD9E-4E38-9443-8FFFA079254B}"
          SQLTask:SqlStatementSource="WITH CTE&#xA;(&#xA;&#x9; G_NUMERO_GUIA  &#xA;&#x9;,SE_ID_DIA_HABIL&#xA;&#x9;,SE_FECHA_HABIL&#xA;)&#xA;AS&#xA;&#x9;(&#xA;&#x9;&#x9;SELECT&#xA;&#x9;&#x9;&#x9; C.G_NUMERO_GUIA G_NUMERO_GUIA  &#xA;&#x9;&#x9;&#x9;,F.ID_DIA_HABIL SE_ID_DIA_HABIL&#xA;&#x9;&#x9;&#x9;,F.FECHA SE_FECHA_HABIL&#xA;&#x9;&#x9;FROM&#xA;&#x9;&#x9;&#x9;TMP.ME_TBCL C WITH(NOLOCK)&#xA;&#x9;&#x9;INNER JOIN&#xA;&#x9;&#x9;&#x9;TMP.ME_TBCL_DHABIL_NO_D F WITH(NOLOCK)&#xA;&#x9;&#x9;ON&#xA;&#x9;&#x9;&#x9;CONVERT(DATE,C.SE_ID_FECHA_TIPO_ESTADO_ENVIO) =  F.FECHA&#xA;&#x9;)&#xA;UPDATE &#xA;&#x9;[TMP].[ME_TBCL]&#xA;SET&#xA;&#x9; SE_ID_DIA_HABIL_TIPO_ESTADO_ENVIO = CTE.SE_ID_DIA_HABIL&#xA;&#x9;,SE_ID_FECHA_HABIL_TIPO_ESTADO_ENVIO = CTE.SE_FECHA_HABIL&#xA;FROM&#xA;&#x9;TMP.ME_TBCL TMP WITH(NOLOCK) INNER JOIN CTE&#xA;ON&#xA;&#x9;TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA&#xA;GO&#xA;&#xA;WITH CTE&#xA;(&#xA;&#x9; G_NUMERO_GUIA  &#xA;&#x9;,SE_ID_DIA_HABIL&#xA;&#x9;,SE_FECHA_HABIL&#xA;)&#xA;AS&#xA;&#x9;(&#xA;&#x9;&#x9;SELECT &#xA;&#x9;&#x9;&#x9; C.G_NUMERO_GUIA G_NUMERO_GUIA&#xA;&#x9;&#x9;&#x9;,(SELECT TOP 1 ID_DIA_HABIL FROM TMP.ME_TBCL_DHABIL_NO_D F WITH(NOLOCK) WHERE F.FECHA &gt;= CONVERT(DATE,C.SE_ID_FECHA_TIPO_ESTADO_ENVIO)) SE_ID_DIA_HABIL&#xA;&#x9;&#x9;&#x9;,(SELECT TOP 1 F.FECHA FROM TMP.ME_TBCL_DHABIL_NO_D F WITH(NOLOCK) WHERE F.FECHA &gt;= CONVERT(DATE,C.SE_ID_FECHA_TIPO_ESTADO_ENVIO)) SE_FECHA_HABIL&#xA;&#x9;&#x9;FROM&#xA;&#x9;&#x9;&#x9;TMP.ME_TBCL C WITH(NOLOCK)&#xA;&#x9;&#x9;WHERE&#xA;&#x9;&#x9;&#x9;SE_ID_DIA_HABIL_TIPO_ESTADO_ENVIO = 0&#xA;&#x9;)&#xA;UPDATE &#xA;&#x9;[TMP].[ME_TBCL]&#xA;SET&#xA;&#x9; SE_ID_DIA_HABIL_TIPO_ESTADO_ENVIO = CTE.SE_ID_DIA_HABIL&#xA;&#x9;,SE_ID_FECHA_HABIL_TIPO_ESTADO_ENVIO = CTE.SE_FECHA_HABIL&#xA;FROM&#xA;&#x9;TMP.ME_TBCL TMP WITH(NOLOCK) INNER JOIN CTE&#xA;ON&#xA;&#x9;TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA&#xA;GO&#xA;&#xA;UPDATE&#xA;    [TMP].[ME_TBCL]&#xA;SET&#xA;    SE_DIAS_ENTREGA = SE_ID_DIA_HABIL_TIPO_ESTADO_ENVIO - [SE_ID_DIA_HABIL_EZU]&#xA;FROM&#xA;    TMP.ME_TBCL WITH (NOLOCK)&#xA;WHERE&#xA;    [SE_ID_DIA_HABIL_EZU] &lt;&gt; 0&#xA;AND &#xA;&#x9;-- TIENE QUE ESTAR ENTREGADO&#xA;&#x9;SE_ID_DIA_HABIL_TIPO_ESTADO_ENVIO &lt;&gt; 0&#xA;GO&#xA;&#xA;UPDATE&#xA;    [TMP].[ME_TBCL]&#xA;SET&#xA;     SE_DIFERENCIA = SE_DIAS_ENTREGA - SE_TIEMPO_MATRIZ&#xA;FROM&#xA;    [TMP].[ME_TBCL] TMP WITH (NOLOCK)&#xA;WHERE&#xA;&#x9;-- TIENE QUE ESTAR ENTREGADO&#xA;&#x9;SE_ID_DIA_HABIL_TIPO_ESTADO_ENVIO &lt;&gt; 0&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
