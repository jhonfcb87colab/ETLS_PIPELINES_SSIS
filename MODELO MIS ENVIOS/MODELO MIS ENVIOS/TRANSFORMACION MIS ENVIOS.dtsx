            <DTS:Executable
              DTS:refId="Package\SCRIPTS - PROCESOS - TAREAS COMENTARIADAS\MANIFIESTOS UNICOS 1\Paso 42 quitar duplicados de Manifiestos"
              DTS:CreationName="Microsoft.ExecuteSQLTask"
              DTS:Description="Execute SQL Task"
              DTS:DTSID="{109d4ce0-be0c-4fdc-ad34-a8989341ccf1}"
              DTS:ExecutableType="Microsoft.ExecuteSQLTask"
