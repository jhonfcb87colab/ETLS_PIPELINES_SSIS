                <component
                  refId="Package\Paso 68 Calculo dias EFICIENCIA ACIDA\FECHA HABIL - FESTIVA\OLE DB Source"
                  componentClassID="Microsoft.OLEDBSource"
                  contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                  description="OLE DB Source"
                  name="OLE DB Source"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">DECLARE @MES_INI DATETIME = ? ;

;WITH TIEMPOFEST AS(

SELECT 
DIM.TIME_ID, 
DIM.DATE, 
IIF(DIM.DATE = PAR.FECHA_FESTIVA,'FESTIVO', IIF(DIM.DAY IN ( 'Domingo','Sabado'), 'FESTIVO', 'HABIL')) as DIAS_FES
FROM DIM.TIEMPO DIM
LEFT JOIN PAR.FESTIVOSNACIONALES PAR
ON DIM.TIME_ID = CONVERT(INT,CONVERT(DATETIME,CONVERT(CHAR(11),PAR.FECHA_FESTIVA)))
WHERE DIM.DATE &gt;= DATEADD(yy,-2,DATEADD(yy,DATEDIFF(yy,0, @MES_INI  ),0))
OR DIM.TIME_ID = 0
)
SELECT 
TIME_ID, DATE, DIAS_FES
FROM 
TIEMPOFEST

/*
WITH TIEMPOFEST AS(

SELECT 
DIM.TIME_ID, 
DIM.DATE, 
IIF(DIM.DATE = PAR.FECHA_FESTIVA,'FESTIVO', IIF(DIM.DAY IN ( 'Domingo','Sabado'), 'FESTIVO', 'HABIL')) as DIAS_FES
FROM DIM.TIEMPO DIM
LEFT JOIN PAR.FESTIVOSNACIONALES PAR
ON DIM.TIME_ID = CONVERT(INT,CONVERT(DATETIME,CONVERT(CHAR(11),PAR.FECHA_FESTIVA)))

)
SELECT 
*
FROM 
TIEMPOFEST
*/</property>
