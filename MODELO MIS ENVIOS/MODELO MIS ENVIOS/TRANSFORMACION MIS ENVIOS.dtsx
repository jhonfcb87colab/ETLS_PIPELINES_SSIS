      DTS:Expression="@[$Project::DtMesIni] == (DT_DATE) &quot;01-01-1900&quot; ?   &#xA;(DT_DATE) DATEADD( &quot;DD&quot;, -@[$Project::Incremental]  ,  GETDATE())  :  @[$Project::DtMesIni]"
      DTS:IncludeInDebugDump="2345"
