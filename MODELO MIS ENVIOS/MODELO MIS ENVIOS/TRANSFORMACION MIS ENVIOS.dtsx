          DTS:Disabled="True"
          DTS:DTSID="{5a83647e-96a8-4a60-b7e5-cb0d04ebaf4b}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Paso 20 Actualizar RE Sin RRE"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{82E3C266-AD9E-4E38-9443-8FFFA079254B}"
              SQLTask:SqlStatementSource="UPDATE&#xA;&#xA;&#x9;TMP.ME_TBCL&#xA;&#xA;SET &#xA;&#x9;SE_ID_FECHA_RE = '1900-01-01' &#xA;&#x9;,SE_FECHA_RE = 'NO DISPONIBLE'&#xA;&#xA;WHERE&#xA;&#x9;&#xA;&#x9;(SE_ID_FECHA_RE &lt;&gt; '1900-01-01' &#xA;&#xA;AND &#xA;&#x9;SE_ID_FECHA_RRE &lt;&gt; '1900-01-01')&#xA;&#xA;AND&#xA;&#x9;&#xA;&#x9;(SE_ID_FECHA_RRE &gt; SE_ID_FECHA_RE)" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Sequence Container\Paso 21 Actualizar Base con Ultimo Estado Envio Proceso Concepto"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{849CB377-E0CF-4FFD-9A77-2FB62CADB2A3}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Paso 21 Actualizar Base con Ultimo Estado Envio Proceso Concepto"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{82E3C266-AD9E-4E38-9443-8FFFA079254B}"
              SQLTask:SqlStatementSource="WITH CTE&#xA;(&#xA;&#x9; G_NUMERO_GUIA&#xA;&#x9;,SE_ID_ULTI_PROC_CONCP&#xA;&#x9;,SE_ESTADO_ENVIO_HOMOLOGADO&#xA;)&#xA;AS&#xA;&#x9;(&#xA;&#x9;&#x9;SELECT&#xA;&#x9;&#x9;&#x9; TMP.G_NUMERO_GUIA&#xA;&#x9;&#x9;&#x9;,ISNULL(CONVERT(VARCHAR,TMP.G_ID_ESTADOENVIO) + '-' + CONVERT (VARCHAR,TMP.SE_ID_PROCESO) + '-' + CONVERT (VARCHAR,TMP.SE_ID_CONCEPTO),'-888') SE_ID_ULTI_PROC_CONCP&#xA;&#x9;&#x9;&#x9;,PAR.ESTADO_ENVIO_HOMOLOGADO SE_ESTADO_ENVIO_HOMOLOGADO&#xA;&#x9;&#x9;FROM&#xA;&#x9;&#x9;&#x9;TMP.ME_TBCL TMP WITH (NOLOCK)&#xA;&#x9;&#x9;INNER JOIN&#xA;&#x9;&#x9;&#x9;PAR.TBCL_HOMOLOGA_PROCESOS_ESTADOS PAR WITH (NOLOCK)&#xA;&#x9;&#x9;ON&#xA;&#x9;&#x9;&#x9;TMP.G_ID_ESTADOENVIO = PAR.ID_ESTADOENVIO &#xA;&#x9;&#x9;AND &#xA;&#x9;&#x9;&#x9;TMP.SE_ID_PROCESO = PAR.ID_PROCESO&#xA;&#x9;&#x9;AND&#xA;&#x9;&#x9;&#x9;PAR.ID_CONCEPTO = -888&#xA;&#x9;)&#xA;&#xA;UPDATE &#xA;&#x9;[TMP].[ME_TBCL] &#xA;SET &#xA;&#x9; SE_ID_ULTI_PROC_CONCP = CTE.SE_ID_ULTI_PROC_CONCP&#xA;&#x9;,SE_ESTADO_ENVIO_HOMOLOGADO = CTE.SE_ESTADO_ENVIO_HOMOLOGADO&#xA;FROM&#xA;&#x9;TMP.[ME_TBCL] TMP WITH (NOLOCK) INNER JOIN CTE&#xA;ON&#xA;&#x9;TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA&#xA;GO&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;WITH CTE&#xA;(&#xA;&#x9; G_NUMERO_GUIA&#xA;&#x9;,SE_ID_ULTI_PROC_CONCP&#xA;&#x9;,SE_ESTADO_ENVIO_HOMOLOGADO&#xA;)&#xA;AS&#xA;&#x9;(&#xA;&#x9;&#x9;SELECT&#xA;&#x9;&#x9;&#x9; TMP.G_NUMERO_GUIA&#xA;&#x9;&#x9;&#x9;,ISNULL(CONVERT(VARCHAR,TMP.G_ID_ESTADOENVIO) + '-' + CONVERT (VARCHAR,TMP.SE_ID_PROCESO) + '-' + CONVERT (VARCHAR,TMP.SE_ID_CONCEPTO),'-888') SE_ID_ULTI_PROC_CONCP&#xA;&#x9;&#x9;&#x9;,PAR.ESTADO_ENVIO_HOMOLOGADO SE_ESTADO_ENVIO_HOMOLOGADO&#xA;&#x9;&#x9;FROM&#xA;&#x9;&#x9;&#x9;TMP.ME_TBCL TMP WITH (NOLOCK)&#xA;&#x9;&#x9;INNER JOIN&#xA;&#x9;&#x9;&#x9;PAR.TBCL_HOMOLOGA_PROCESOS_ESTADOS PAR WITH (NOLOCK)&#xA;&#x9;&#x9;ON&#xA;&#x9;&#x9;&#x9;TMP.G_ID_ESTADOENVIO = PAR.ID_ESTADOENVIO &#xA;&#x9;&#x9;AND &#xA;&#x9;&#x9;&#x9;TMP.SE_ID_PROCESO = PAR.ID_PROCESO&#xA;&#x9;&#x9;AND&#xA;&#x9;&#x9;&#x9;TMP.SE_ID_CONCEPTO = PAR.ID_CONCEPTO&#xA;&#x9;)&#xA;&#xA;UPDATE &#xA;&#x9;[TMP].[ME_TBCL] &#xA;SET &#xA;&#x9; SE_ID_ULTI_PROC_CONCP = CTE.SE_ID_ULTI_PROC_CONCP&#xA;&#x9;,SE_ESTADO_ENVIO_HOMOLOGADO = CTE.SE_ESTADO_ENVIO_HOMOLOGADO&#xA;FROM&#xA;&#x9;TMP.[ME_TBCL] TMP WITH (NOLOCK) INNER  JOIN  CTE&#xA;ON&#xA;&#x9;TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Sequence Container\Paso 22 Calcula estado actual RE"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{73CAE6C6-AB18-436D-B18C-2C1084242933}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Paso 22 Calcula estado actual RE"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{82E3C266-AD9E-4E38-9443-8FFFA079254B}"
              SQLTask:SqlStatementSource="WITH CTE &#xA;(&#xA;&#x9; ID&#xA;&#x9;,G_NUMERO_GUIA&#xA;&#x9;,SE_TIPO_ESTADO_ENVIO&#xA;&#x9;,SE_ID_FECHA_TIPO_ESTADO_ENVIO&#xA;&#x9;,SE_FECHA_TIPO_ESTADO_ENVIO&#xA;)&#xA;AS&#xA;(&#xA;&#x9;SELECT &#xA;&#x9;&#x9; ROW_NUMBER() OVER(PARTITION BY G_NUMERO_GUIA ORDER BY FECHA) ID&#xA;&#x9;&#x9;,G_NUMERO_GUIA&#xA;&#x9;&#x9;,PROCESO SE_TIPO_ESTADO_ENVIO&#xA;&#x9;&#x9;,FECHA SE_ID_FECHA_TIPO_ESTADO_ENVIO&#xA;&#x9;&#x9;,ISNULL(CONVERT(VARCHAR,FECHA,111),'NO DISPONIBLE') SE_FECHA_TIPO_ESTADO_ENVIO&#xA;&#x9;FROM   &#xA;&#x9;   (&#xA;&#x9;&#x9;SELECT &#xA;&#x9;&#x9;&#x9; [G_NUMERO_GUIA]&#xA;&#x9;&#x9;&#x9;,[SE_ID_FECHA_RE] [REPORTADO ENTREGADO]&#xA;&#x9;&#x9;&#x9;,[SE_ID_FECHA_EV] [ENTREGA VERIFICADA]&#xA;&#x9;&#x9;FROM&#xA;&#x9;&#x9;&#x9;[TMP].[ME_TBCL]&#xA;&#x9;&#x9;WHERE&#xA;&#x9;&#x9;&#x9;[SE_FECHA_RE] &lt;&gt; 'NO DISPONIBLE'&#xA;&#x9;&#x9;OR&#xA;&#x9;&#x9;&#x9;[SE_FECHA_EV] &lt;&gt; 'NO DISPONIBLE'&#xA;&#x9;&#x9;) p  &#xA;&#x9;UNPIVOT (FECHA FOR PROCESO IN   &#xA;&#x9;&#x9;(&#xA;&#x9;&#x9;&#x9; [REPORTADO ENTREGADO]&#xA;&#x9;&#x9;&#x9;,[ENTREGA VERIFICADA]&#xA;&#x9;&#x9;)  &#xA;&#x9;)AS UNPVT&#xA;&#x9;WHERE&#xA;&#x9;&#x9;FECHA &lt;&gt; '1900-01-01'&#xA;)&#xA;&#xA;UPDATE [TMP].[ME_TBCL]&#xA;SET&#xA;&#x9; SE_TIPO_ESTADO_ENVIO = CASE CTE.SE_TIPO_ESTADO_ENVIO WHEN 'REPORTADO ENTREGADO' THEN 1 WHEN 'ENTREGA VERIFICADA' THEN 1 ELSE 3 END&#xA;&#x9;,SE_ID_FECHA_TIPO_ESTADO_ENVIO = CTE.SE_ID_FECHA_TIPO_ESTADO_ENVIO&#xA;&#x9;,SE_FECHA_TIPO_ESTADO_ENVIO = CTE.SE_FECHA_TIPO_ESTADO_ENVIO&#xA;FROM&#xA;&#x9;TMP.ME_TBCL TMP INNER JOIN  CTE&#xA;ON&#xA;&#x9;TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA&#xA;WHERE&#xA;&#x9;CTE.ID = 1" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
      </DTS:Executables>
