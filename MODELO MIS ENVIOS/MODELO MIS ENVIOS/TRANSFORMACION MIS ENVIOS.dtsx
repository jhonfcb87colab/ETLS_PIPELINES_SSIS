                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT 
	 SE.[NUMERO_GUIA]
	,SE.[ID_PROCESO]
	,SE.[ID_CONCEPTO]
	,SE.[FECHA_HORA_MOVIMIENTO]
	,SE.[NUMERO_MOVIMI]
	,SE.[CONSECUT_MOVIMI]
FROM
	[LOG].[SEGUIMIENTO_ENVIO_BARR] SE WITH(NOLOCK) INNER JOIN [TMP].[ME_TBCL_02] TMP WITH(NOLOCK)
ON SE.NUMERO_GUIA = TMP.NUMERO_GUIA</property>
