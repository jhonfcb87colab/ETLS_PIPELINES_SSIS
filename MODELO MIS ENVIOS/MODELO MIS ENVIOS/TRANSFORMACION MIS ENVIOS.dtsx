    <DTS:Executable
      DTS:refId="Package\Paso 07 Quitar duplicados de procesos"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{EFFDAC0D-7D63-4FA0-AF0C-F59489DFD123}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Paso 07 Quitar duplicados de procesos"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{82E3C266-AD9E-4E38-9443-8FFFA079254B}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;&#xA;WITH CTE&#xA;(&#xA;&#x9; ID&#xA;&#x9;,[NUMERO_GUIA]&#xA;&#x9;,[ID_PROCESO]&#xA;&#x9;,[ID_CONCEPTO]&#xA;&#x9;,[FECHA_HORA_MOVIMIENTO]&#xA;&#x9;,[NUMERO_MOVIMI]&#xA;&#x9;,[CONSECUT_MOVIMI]&#xA;)&#xA;AS&#xA;&#x9;(&#xA;&#x9;&#x9;SELECT &#xA;&#x9;&#x9;&#x9; ROW_NUMBER() OVER(PARTITION BY [ID_PROCESO], [NUMERO_MOVIMI], [CONSECUT_MOVIMI], [NUMERO_GUIA] ORDER BY [FECHA_HORA_MOVIMIENTO]  ) ID&#xA;&#x9;&#x9;&#x9;,[NUMERO_GUIA]&#xA;&#x9;&#x9;&#x9;,[ID_PROCESO]&#xA;&#x9;&#x9;&#x9;,CASE WHEN ISNULL(CONVERT(INT,[ID_CONCEPTO]),-888) = 0 THEN -888 ELSE ISNULL(CONVERT(INT,[ID_CONCEPTO]),-888) END ID_CONCEPTO&#xA;&#x9;&#x9;&#x9;,[FECHA_HORA_MOVIMIENTO]&#xA;&#x9;&#x9;&#x9;,[NUMERO_MOVIMI]&#xA;&#x9;&#x9;&#x9;,[CONSECUT_MOVIMI]&#xA;&#x9;&#x9;FROM &#xA;&#x9;&#x9;&#x9;[TMP].[ME_TBCL_03] WITH(NOLOCK)&#xA;&#x9;&#x9;WHERE&#xA;&#x9;&#x9;&#x9;ID_PROCESO IS NOT NULL&#xA;&#x9;&#x9;OR &#xA;&#x9;&#x9;&#x9;FECHA_HORA_MOVIMIENTO IS NOT NULL&#xA;&#x9;)&#xA;INSERT INTO TMP.ME_TBCL_04&#xA;(&#xA;&#x9; NUMERO_GUIA&#xA;&#x9;,ID_PROCESO&#xA;&#x9;,ID_CONCEPTO&#xA;&#x9;,FECHA_HORA_MOVIMIENTO&#xA;&#x9;,NUMERO_MOVIMI&#xA;&#x9;,CONSECUT_MOVIMI&#xA;)&#xA;SELECT&#xA;&#x9; [NUMERO_GUIA]&#xA;&#x9;,[ID_PROCESO]&#xA;&#x9;,[ID_CONCEPTO]&#xA;&#x9;,[FECHA_HORA_MOVIMIENTO]&#xA;&#x9;,[NUMERO_MOVIMI]&#xA;&#x9;,[CONSECUT_MOVIMI]&#xA;FROM&#xA;&#x9;CTE&#xA;WHERE&#xA;&#x9;ID = 1&#xA;-- ORDER  BY  [NUMERO_GUIA]  ,[FECHA_HORA_MOVIMIENTO]&#xA;;&#xA;&#xA;SET NOCOUNT OFF;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Paso 47 Actualizar Novedades"
      DTS:CreationName="STOCK:SEQUENCE"
      DTS:Description="Sequence Container"
      DTS:DTSID="{d75acd6a-dd61-478b-9db1-30be503f10f7}"
      DTS:ExecutableType="STOCK:SEQUENCE"
      DTS:LocaleID="-1"
      DTS:ObjectName="Paso 47 Actualizar Novedades">
      <DTS:Variables />
      <DTS:Executables>
        <DTS:Executable
          DTS:refId="Package\Paso 47 Actualizar Novedades\Paso 47-1 Obtener Novedad"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{be582384-1b72-4d99-a1e4-f73762dc0c26}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Paso 47-1 Obtener Novedad"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{82E3C266-AD9E-4E38-9443-8FFFA079254B}"
              SQLTask:SqlStatementSource="WITH CTE &#xA;(&#xA;&#x9; ID&#xA;&#x9;,G_NUMERO_GUIA&#xA;&#x9;,G_NOVEDAD&#xA;&#x9;,G_TIPO_NOVEDAD&#xA;&#x9;,G_FECHA_NOVEDAD&#xA;)&#xA;AS&#xA;&#x9;(&#xA;&#x9;&#x9;SELECT &#xA;&#x9;&#x9;&#x9; ROW_NUMBER() OVER(PARTITION BY NOV.G_NUMERO_GUIA ORDER BY NOV.DETND_FECHA_NOVEDAD ASC) ID&#xA;&#x9;&#x9;&#x9;,TMP.G_NUMERO_GUIA&#xA;&#x9;&#x9;&#x9;,NOV.G_NOMBRE_NOVEDAD + ' - ' + NOV.G_SUBTIPO_NOVEDAD AS G_NOVEDAD&#xA;&#x9;&#x9;&#x9;,NOV.G_TIPO_NOVEDAD AS G_TIPO_NOVEDAD&#xA;&#x9;&#x9;&#x9;,NOV.DETND_FECHA_NOVEDAD&#xA; &#x9;&#x9;FROM &#xA;&#x9;&#x9;&#x9;TMP.ME_TBCL_NOVEDADES NOV WITH (NOLOCK)&#xA;&#x9;&#x9;INNER JOIN &#xA;&#x9;&#x9;&#x9;TMP.ME_TBCL TMP WITH (NOLOCK)&#xA;&#x9;&#x9;ON &#xA;&#x9;&#x9;&#x9;NOV.G_NUMERO_GUIA = TMP.G_NUMERO_GUIA&#xA;&#x9;)&#xA;INSERT INTO TMP.ME_TBCL_12&#xA;(&#xA;&#x9; ID&#xA;&#x9;,G_NUMERO_GUIA&#xA;&#x9;,G_NOVEDAD&#xA;&#x9;,G_TIPO_NOVEDAD&#xA;&#x9;,G_FECHA_NOVEDAD&#xA;)&#xA;SELECT &#xA;&#x9; CTE.ID&#xA;&#x9;,CTE.G_NUMERO_GUIA&#xA;&#x9;,CTE.G_NOVEDAD&#xA;&#x9;,CTE.G_TIPO_NOVEDAD&#xA;&#x9;,CTE.G_FECHA_NOVEDAD&#xA;FROM &#xA;&#x9;CTE" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Paso 47 Actualizar Novedades\Paso 47-2 Novedad Operativa 1"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{c6da318f-74e8-4d31-a246-f75cc5c343a9}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Paso 47-2 Novedad Operativa 1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{82E3C266-AD9E-4E38-9443-8FFFA079254B}"
              SQLTask:SqlStatementSource="WITH CTE&#xA;(&#xA;&#x9; G_NUMERO_GUIA&#xA;&#x9;,SE_NOVD_OPERATIVA_1&#xA;&#x9;,SE_RESP_NOVD_OPERATIVA_1&#xA;&#x9;,SE_FECHA_NOVD_OPERATIVA_1&#xA;)&#xA;AS&#xA;&#x9;(&#xA;&#x9;&#x9;SELECT&#xA;&#x9;&#x9;&#x9; TMP.G_NUMERO_GUIA&#xA;&#x9;&#x9;&#x9;,TMP12.G_NOVEDAD AS SE_NOVD_OPERATIVA_1&#xA;&#x9;&#x9;&#x9;,TMP12.G_TIPO_NOVEDAD AS SE_RESP_NOVD_OPERATIVA_1&#xA;&#x9;&#x9;&#x9;,TMP12.G_FECHA_NOVEDAD AS SE_FECHA_NOVD_OPERATIVA_1&#xA;&#x9;&#x9;FROM &#xA;&#x9;&#x9;&#x9;TMP.ME_TBCL TMP WITH(NOLOCK)&#xA;&#x9;&#x9;INNER JOIN &#xA;&#x9;&#x9;&#x9;TMP.ME_TBCL_12 TMP12 WITH(NOLOCK)&#xA;&#x9;&#x9;ON&#xA;&#x9;&#x9;&#x9;TMP.G_NUMERO_GUIA = TMP12.G_NUMERO_GUIA&#xA;&#x9;&#x9;WHERE &#xA;&#x9;&#x9;&#x9;TMP12.ID = 1&#xA;&#x9;)&#xA;UPDATE &#xA;&#x9;TMP.ME_TBCL&#xA;SET &#xA;&#x9; SE_NOVD_OPERATIVA_1 = ISNULL(CTE.SE_NOVD_OPERATIVA_1,'NO DISPONIBLE')&#xA;&#x9;,SE_RESP_NOVD_OPERATIVA_1 = ISNULL(CTE.SE_RESP_NOVD_OPERATIVA_1,'NO DISPONIBLE')&#xA;&#x9;,SE_ID_FECHA_NOVD_OPERATIVA_1 = ISNULL(CTE.SE_FECHA_NOVD_OPERATIVA_1,'1900-01-01')&#xA;&#x9;,SE_FECHA_NOVD_OPERATIVA_1 = CASE WHEN ISNULL(CTE.SE_FECHA_NOVD_OPERATIVA_1,'1900-01-01') = '1900-01-01' THEN 'NO DISPONIBLE' ELSE CONVERT (VARCHAR,CTE.SE_FECHA_NOVD_OPERATIVA_1,111) END&#xA;FROM &#xA;&#x9; TMP.ME_TBCL TMP WITH (NOLOCK)&#xA;&#x9; INNER JOIN CTE&#xA;ON &#xA;&#x9;TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Paso 47 Actualizar Novedades\Paso 47-3 Novedad Operativa 2"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{6a207f00-6688-4940-a75f-1441a2b517b9}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Paso 47-3 Novedad Operativa 2"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{82E3C266-AD9E-4E38-9443-8FFFA079254B}"
              SQLTask:SqlStatementSource="WITH CTE&#xA;(&#xA;&#x9; G_NUMERO_GUIA&#xA;&#x9;,SE_NOVD_OPERATIVA_2&#xA;&#x9;,SE_RESP_NOVD_OPERATIVA_2&#xA;&#x9;,SE_FECHA_NOVD_OPERATIVA_2&#xA;)&#xA;AS&#xA;&#x9;(&#xA;&#x9;&#x9;SELECT&#xA;&#x9;&#x9;&#x9; TMP.G_NUMERO_GUIA&#xA;&#x9;&#x9;&#x9;,TMP12.G_NOVEDAD AS SE_NOVD_OPERATIVA_2&#xA;&#x9;&#x9;&#x9;,TMP12.G_TIPO_NOVEDAD AS SE_RESP_NOVD_OPERATIVA_2&#xA;&#x9;&#x9;&#x9;,TMP12.G_FECHA_NOVEDAD AS SE_FECHA_NOVD_OPERATIVA_2&#xA;&#x9;&#x9;FROM &#xA;&#x9;&#x9;&#x9;TMP.ME_TBCL TMP WITH(NOLOCK)&#xA;&#x9;&#x9;INNER JOIN &#xA;&#x9;&#x9;&#x9;TMP.ME_TBCL_12 TMP12 WITH(NOLOCK)&#xA;&#x9;&#x9;ON&#xA;&#x9;&#x9;&#x9;TMP.G_NUMERO_GUIA = TMP12.G_NUMERO_GUIA&#xA;&#x9;&#x9;WHERE &#xA;&#x9;&#x9;&#x9;TMP12.ID = 2&#xA;&#x9;)&#xA;UPDATE &#xA;&#x9;TMP.ME_TBCL&#xA;SET &#xA;&#x9; SE_NOVD_OPERATIVA_2 = ISNULL(CTE.SE_NOVD_OPERATIVA_2,'NO DISPONIBLE')&#xA;&#x9;,SE_RESP_NOVD_OPERATIVA_2 = ISNULL(CTE.SE_RESP_NOVD_OPERATIVA_2,'NO DISPONIBLE')&#xA;&#x9;,SE_ID_FECHA_NOVD_OPERATIVA_2 = ISNULL(CTE.SE_FECHA_NOVD_OPERATIVA_2,'1900-01-01')&#xA;&#x9;,SE_FECHA_NOVD_OPERATIVA_2 = CASE WHEN ISNULL(CTE.SE_FECHA_NOVD_OPERATIVA_2,'1900-01-01') = '1900-01-01' THEN 'NO DISPONIBLE' ELSE CONVERT (VARCHAR,CTE.SE_FECHA_NOVD_OPERATIVA_2,111) END&#xA;FROM &#xA;&#x9; TMP.ME_TBCL TMP WITH (NOLOCK)&#xA;&#x9; INNER JOIN CTE&#xA;ON&#xA;&#x9;TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
