          DTS:LocaleID="-1"
          DTS:ObjectName="PROCESO LOGISTICO MUNICIPIOS"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="1">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{82E3C266-AD9E-4E38-9443-8FFFA079254B}"
              SQLTask:SqlStatementSource="/* 1.  INSERTA DATOS PROVINCIA */&#xA;INSERT INTO [TMP].[ME_TBCL_03] WITH (TABLOCK)&#xA;(&#xA;    NUMERO_GUIA,&#xA;    ID_PROCESO,&#xA;    ID_CONCEPTO,&#xA;    FECHA_HORA_MOVIMIENTO,&#xA;    NUMERO_MOVIMI,&#xA;    CONSECUT_MOVIMI&#xA;)&#xA;SELECT &#xA;&#x9; SE.[NUMERO_GUIA]&#xA;&#x9;,SE.[ID_PROCESO]&#xA;&#x9;,SE.[ID_CONCEPTO]&#xA;&#x9;,SE.[FECHA_HORA_MOVIMIENTO]&#xA;&#x9;,SE.[NUMERO_MOVIMI]&#xA;&#x9;,SE.[CONSECUT_MOVIMI]&#xA;FROM&#xA;&#x9;[LOG].[SEGUIMIENTO_ENVIO_PROV] SE WITH (READUNCOMMITTED)&#xA;INNER JOIN  [TMP].[ME_TBCL_02] TMP WITH(READUNCOMMITTED, INDEX(IX_NGUIAS_TMP_ME_TBCL02) )&#xA;ON  SE.NUMERO_GUIA = TMP.NUMERO_GUIA&#xA;OPTION(RECOMPILE, MAXDOP 4 )&#xA;;&#xA;&#xA;&#xA;&#xA;/*&#xA;INSERT INTO [TMP].[ME_TBCL_03]&#xA;SELECT &#xA;&#x9; SE.[NUMERO_GUIA]&#xA;&#x9;,SE.[ID_PROCESO]&#xA;&#x9;,SE.[ID_CONCEPTO]&#xA;&#x9;,SE.[FECHA_HORA_MOVIMIENTO]&#xA;&#x9;,SE.[NUMERO_MOVIMI]&#xA;&#x9;,SE.[CONSECUT_MOVIMI]&#xA;FROM&#xA;&#x9;[LOG].[SEGUIMIENTO_ENVIO_PROV] SE WITH(NOLOCK) &#xA;INNER JOIN  [TMP].[ME_TBCL_02] TMP WITH(NOLOCK, INDEX(IX_NGUIAS_TMP_ME_TBCL02) )&#xA;ON&#xA;&#x9;SE.NUMERO_GUIA = TMP.NUMERO_GUIA&#xA;OPTION(RECOMPILE, MAXDOP 4 )&#xA;;&#xA;*/" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
      </DTS:Executables>
    </DTS:Executable>
