                          UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT DR.ID_RUTA, DR.ID_CIUDAD_ORIGEN, DR.ID_CIUDAD_DESTINO, DR.ID_TIEMPO, DR.ID_MEDTRANS
