      <DTS:Variables />
      <DTS:Executables>
        <DTS:Executable
          DTS:refId="Package\CONSULTA GUIAS\Paso 03 Obtener Guias"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:DelayValidation="True"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{EDE1557E-753A-4F47-A427-37BE25563F1A}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Paso 03 Obtener Guias"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{82E3C266-AD9E-4E38-9443-8FFFA079254B}"
              SQLTask:SqlStatementSource="DECLARE @FECHA_INI DATETIME = ? ;&#xA;DECLARE @FECHA_FIN DATETIME = ? ;&#xA;&#xA;&#xA;DROP TABLE IF EXISTS  #GUIAS_EXTR;&#xA;SELECT&#xA;&#x9; G.NUMERO_GUIA&#xA;&#x9;,G.NUMERO_PIEZAS&#xA;&#x9;,G.ID_PRODUCTO&#xA;&#x9;,G.ID_SUBPRODUCTO&#xA;&#x9;,G.ID_TIEMPO&#xA;&#x9;,G.ID_MEDTRANS&#xA;&#x9;,G.ID_ESTADOENVIO&#xA;&#x9;,G.ID_CIUDAD_DESTINO&#xA;&#x9;,G.ID_CIUDAD_ORIGEN&#xA;&#x9;,G.NOMBRE_DESTINA_GUIA&#xA;&#x9;,G.APELLIDO_DESTINA_GUIA&#xA;&#x9;,G.TELEFONO_DESTINA_GUIA&#xA;&#x9;,G.DIRECCION_DESTINA_GUIA&#xA;&#x9;,G.ID_CLIENTE&#xA;&#x9;,G.NOMBRE_REMITE_GUIA&#xA;&#x9;,G.APELLIDO_REMITE_GUIA&#xA;&#x9;,G.DIRECCION_REMITE_GUIA&#xA;&#x9;,G.TELEFONO_REMITE_GUIA&#xA;&#x9;,G.CONTENIDO&#xA;&#x9;,G.FECHA_EXTRACCION_DW&#xA;&#x9;,G.FECHA_ENVIO&#xA;&#x9;,G.VALOR_DECLARADO_GUIA&#xA;&#x9;,G.FECHA_MODIFICACION_DG&#xA;&#x9;,ID_1&#xA;&#x9;,ID_2&#xA;  INTO  #GUIAS_EXTR&#xA;FROM &#xA;&#x9;LOG.GUIAS_6MESES G WITH(NOLOCK, INDEX(IX_FECHA_MOD_GUIAS_6MESES)  )&#xA;WHERE  G.FECHA_MODIFICACION &gt;= @FECHA_INI &#xA;AND   G.FECHA_MODIFICACION &lt;= @FECHA_FIN &#xA;OPTION (RECOMPILE)&#xA;;&#xA;&#xA;CREATE NONCLUSTERED INDEX IX_TMP_GUIAS_EXTR ON #GUIAS_EXTR(ID_CLIENTE);&#xA;&#xA;INSERT INTO [TMP].[ME_TBCL_01]&#xA;(&#xA;&#x9; [NUMERO_GUIA]&#xA;&#x9;,[NUMERO_PIEZAS]&#xA;&#x9;,[ID_PRODUCTO]&#xA;&#x9;,[ID_SUBPRODUCTO]&#xA;&#x9;,[ID_TIEMPO]&#xA;&#x9;,[ID_MEDTRANS]&#xA;&#x9;,[ID_ESTADOENVIO]&#xA;&#x9;,[ID_CIUDAD_DESTINO]&#xA;&#x9;,[ID_CIUDAD_ORIGEN]&#xA;&#x9;,[NOMBRE_DESTINA_GUIA]&#xA;&#x9;,[APELLIDO_DESTINA_GUIA]&#xA;&#x9;,[TELEFONO_DESTINA_GUIA]&#xA;&#x9;,[DIRECCION_DESTINA_GUIA]&#xA;&#x9;,[ID_REMITE]&#xA;&#x9;,[NOMBRE_REMITE_GUIA]&#xA;&#x9;,[APELLIDO_REMITE_GUIA]&#xA;&#x9;,[DIRECCION_REMITE_GUIA]&#xA;&#x9;,[TELEFONO_REMITE_GUIA]&#xA;&#x9;,[CONTENIDO]&#x9;&#xA;&#x9;,[FECHA_EXTRACCION_DW]&#xA;&#x9;,[FECHA_ENVIO]&#xA;&#x9;,[VALOR_DECLARADO_GUIA]&#xA;&#x9;,[FECHA_MODIFICACION]&#xA;&#x9;,[ID_1]&#xA;&#x9;,[ID_2]&#xA;)&#xA;SELECT&#xA;&#x9; G.NUMERO_GUIA&#xA;&#x9;,G.NUMERO_PIEZAS&#xA;&#x9;,G.ID_PRODUCTO&#xA;&#x9;,G.ID_SUBPRODUCTO&#xA;&#x9;,G.ID_TIEMPO&#xA;&#x9;,G.ID_MEDTRANS&#xA;&#x9;,G.ID_ESTADOENVIO&#xA;&#x9;,G.ID_CIUDAD_DESTINO&#xA;&#x9;,G.ID_CIUDAD_ORIGEN&#xA;&#x9;,G.NOMBRE_DESTINA_GUIA&#xA;&#x9;,G.APELLIDO_DESTINA_GUIA&#xA;&#x9;,G.TELEFONO_DESTINA_GUIA&#xA;&#x9;,G.DIRECCION_DESTINA_GUIA&#xA;&#x9;,G.ID_CLIENTE ID_REMITE&#xA;&#x9;,G.NOMBRE_REMITE_GUIA&#xA;&#x9;,G.APELLIDO_REMITE_GUIA&#xA;&#x9;,G.DIRECCION_REMITE_GUIA&#xA;&#x9;,G.TELEFONO_REMITE_GUIA&#xA;&#x9;,G.CONTENIDO&#xA;&#x9;,G.FECHA_EXTRACCION_DW&#xA;&#x9;,G.FECHA_ENVIO&#xA;&#x9;,G.VALOR_DECLARADO_GUIA&#xA;&#x9;,G.FECHA_MODIFICACION_DG&#xA;&#x9;,ID_1&#xA;&#x9;,ID_2&#xA;FROM &#xA;&#x9;#GUIAS_EXTR AS  G &#xA;INNER JOIN&#xA;&#x9;PAR.TBCL_CLIENTES  AS CL &#xA;ON&#xA;&#x9;G.ID_CLIENTE = CL.ID_CLIENTE&#xA;AND G.ID_ESTADOENVIO &gt; 1&#xA;AND G.FECHA_ENVIO IS NOT NULL&#xA;;&#xA;&#xA;DROP TABLE IF EXISTS  #GUIAS_EXTR;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="0"
                SQLTask:DtsVariableName="User::AUX_01_MES_INI"
                SQLTask:ParameterDirection="Input"
                SQLTask:DataType="131"
                SQLTask:ParameterSize="-1" />
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="1"
                SQLTask:DtsVariableName="User::AUX_02_MES_FIN"
                SQLTask:ParameterDirection="Input"
                SQLTask:DataType="131"
                SQLTask:ParameterSize="-1" />
            </SQLTask:SqlTaskData>
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\CONSULTA GUIAS\Paso 04 Quitar Duplicados"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:DelayValidation="True"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{110EE9CA-D0F9-4339-9509-09094C04AA29}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Paso 04 Quitar Duplicados"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{82E3C266-AD9E-4E38-9443-8FFFA079254B}"
              SQLTask:SqlStatementSource="DROP TABLE IF EXISTS  #ME_TBCL01; &#xA;SELECT &#xA;&#x9;&#x9;ROW_NUMBER () OVER (PARTITION BY [NUMERO_GUIA] ORDER BY [FECHA_MODIFICACION] DESC ) ID&#xA;&#x9;,[NUMERO_GUIA]&#xA;&#x9;,[NUMERO_PIEZAS]&#xA;&#x9;,[ID_PRODUCTO]&#xA;&#x9;,[ID_SUBPRODUCTO]&#xA;&#x9;,[ID_TIEMPO]&#xA;&#x9;,[ID_MEDTRANS]&#xA;&#x9;,[ID_ESTADOENVIO]&#xA;&#x9;,[ID_CIUDAD_DESTINO]&#xA;&#x9;,[ID_CIUDAD_ORIGEN]&#xA;&#x9;,[NOMBRE_DESTINA_GUIA]&#xA;&#x9;,[APELLIDO_DESTINA_GUIA]&#xA;&#x9;,[TELEFONO_DESTINA_GUIA]&#xA;&#x9;,[DIRECCION_DESTINA_GUIA]&#xA;&#x9;,[ID_REMITE]&#xA;&#x9;,[NOMBRE_REMITE_GUIA]&#xA;&#x9;,[APELLIDO_REMITE_GUIA]&#xA;&#x9;,[DIRECCION_REMITE_GUIA]&#xA;&#x9;,[TELEFONO_REMITE_GUIA]&#xA;&#x9;,[CONTENIDO]&#xA;&#x9;,[FECHA_ENVIO]&#xA;&#x9;,[VALOR_DECLARADO_GUIA]&#xA;&#x9;,[FECHA_MODIFICACION]&#xA;&#x9;,[ID_1]&#xA;&#x9;,[ID_2]&#xA;  INTO #ME_TBCL01&#x9;&#xA;FROM &#xA;&#x9;[TMP].[ME_TBCL_01] WITH (NOLOCK)&#xA;WHERE&#xA;&#x9;FECHA_ENVIO IS NOT NULL&#x9;&#x9;&#xA;;&#xA;&#xA;CREATE NONCLUSTERED INDEX IX_TMP_ME_TBCL01 ON #ME_TBCL01(ID);&#xA;&#xA;INSERT &#xA;&#x9;INTO [TMP].[ME_TBCL_02]&#xA;(&#xA;&#x9; [NUMERO_GUIA]&#xA;&#x9;,[NUMERO_PIEZAS]&#xA;&#x9;,[ID_PRODUCTO]&#xA;&#x9;,[ID_SUBPRODUCTO]&#xA;&#x9;,[ID_TIEMPO]&#xA;&#x9;,[ID_MEDTRANS]&#xA;&#x9;,[ID_ESTADOENVIO]&#xA;&#x9;,[ID_CIUDAD_DESTINO]&#xA;&#x9;,[ID_CIUDAD_ORIGEN]&#xA;&#x9;,[NOMBRE_DESTINA_GUIA]&#xA;&#x9;,[APELLIDO_DESTINA_GUIA]&#xA;&#x9;,[TELEFONO_DESTINA_GUIA]&#xA;&#x9;,[DIRECCION_DESTINA_GUIA]&#xA;&#x9;,[ID_REMITE]&#xA;&#x9;,[NOMBRE_REMITE_GUIA]&#xA;&#x9;,[APELLIDO_REMITE_GUIA]&#xA;&#x9;,[DIRECCION_REMITE_GUIA]&#xA;&#x9;,[TELEFONO_REMITE_GUIA]&#xA;&#x9;,[CONTENIDO]&#xA;&#x9;,[FECHA_ENVIO]&#xA;&#x9;,[VALOR_DECLARADO_GUIA]&#xA;&#x9;,[FECHA_MODIFICACION]&#xA;&#x9;,[ID_1]&#xA;&#x9;,[ID_2]&#xA;)&#xA;SELECT &#xA;&#x9; [NUMERO_GUIA]&#xA;&#x9;,[NUMERO_PIEZAS]&#xA;&#x9;,[ID_PRODUCTO]&#xA;&#x9;,[ID_SUBPRODUCTO]&#xA;&#x9;,[ID_TIEMPO]&#xA;&#x9;,[ID_MEDTRANS]&#xA;&#x9;,[ID_ESTADOENVIO]&#xA;&#x9;,[ID_CIUDAD_DESTINO]&#xA;&#x9;,[ID_CIUDAD_ORIGEN]&#xA;&#x9;,[NOMBRE_DESTINA_GUIA]&#xA;&#x9;,[APELLIDO_DESTINA_GUIA]&#xA;&#x9;,[TELEFONO_DESTINA_GUIA]&#xA;&#x9;,[DIRECCION_DESTINA_GUIA]&#xA;&#x9;,[ID_REMITE]&#xA;&#x9;,[NOMBRE_REMITE_GUIA]&#xA;&#x9;,[APELLIDO_REMITE_GUIA]&#xA;&#x9;,[DIRECCION_REMITE_GUIA]&#xA;&#x9;,[TELEFONO_REMITE_GUIA]&#xA;&#x9;,[CONTENIDO]&#xA;&#x9;,[FECHA_ENVIO]&#xA;&#x9;,[VALOR_DECLARADO_GUIA]&#xA;&#x9;,[FECHA_MODIFICACION]&#xA;&#x9;,[ID_1]&#xA;&#x9;,[ID_2]&#xA;FROM &#xA;&#x9;#ME_TBCL01 AS CTE&#xA;WHERE &#xA;&#x9;CTE.ID = 1&#xA;;&#xA;&#xA;DROP TABLE IF EXISTS  #ME_TBCL01;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
      </DTS:Executables>
