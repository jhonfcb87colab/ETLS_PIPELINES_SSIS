          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{82E3C266-AD9E-4E38-9443-8FFFA079254B}"
              SQLTask:SqlStatementSource="WITH CTE&#xA;(&#xA;&#x9; G_NUMERO_GUIA&#xA;&#x9;,TC_ID_PROCESO&#xA;)&#xA;AS&#xA;&#x9;(&#xA;&#x9;&#x9;SELECT &#xA;&#x9;&#x9;&#x9; TMP.G_NUMERO_GUIA&#xA;&#x9;&#x9;&#x9;,INFTBCL.TC_ID_PROCESO&#xA;&#x9;&#x9;FROM &#xA;&#x9;&#x9;&#x9;[TMP].[ME_TBCL] TMP WITH (NOLOCK)&#xA;&#x9;&#x9;INNER JOIN &#xA;&#x9;&#x9;&#x9;[TMP].[ME_TBCL_INFTBCL] INFTBCL WITH (NOLOCK)&#xA;&#x9;&#x9;ON &#xA;&#x9;&#x9;&#x9;TMP.G_NUMERO_GUIA = INFTBCL.TC_NUMERO_GUIA&#xA;&#x9;)&#xA;UPDATE &#xA;&#x9; [TMP].[ME_TBCL]&#xA;SET &#xA;&#x9; TC_ID_PROCESO =  CTE.TC_ID_PROCESO&#xA;FROM &#xA;&#x9;[TMP].[ME_TBCL] TMP WITH (NOLOCK)   INNER JOIN&#xA;&#x9;CTE&#xA;ON&#xA;&#x9;TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Contenedor de secuencias 1\Paso 61 Actualizar Base EF"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{FCC37B74-4723-4A20-BC37-B2F94AB2828B}"
