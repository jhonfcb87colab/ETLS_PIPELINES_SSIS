        <DTS:Executable
          DTS:refId="Package\Contenedor de secuencias\Paso 24 Calcular el día hábil EZU"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{C7B1A572-7930-45F5-ACCD-9A971A3E0C5E}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Paso 24 Calcular el día hábil EZU"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{82E3C266-AD9E-4E38-9443-8FFFA079254B}"
              SQLTask:SqlStatementSource="WITH CTE&#xA;(&#xA;&#x9; G_NUMERO_GUIA  &#xA;&#x9;,SE_ID_DIA_HABIL_EZU&#xA;&#x9;,SE_FECHA_HABIL_EZU&#xA;)&#xA;AS&#xA;&#x9;(&#xA;&#x9;&#x9;SELECT&#xA;&#x9;&#x9;&#x9; C.G_NUMERO_GUIA G_NUMERO_GUIA  &#xA;&#x9;&#x9;&#x9;,F.ID_DIA_HABIL SE_ID_DIA_HABIL_EZU_EZU&#xA;&#x9;&#x9;&#x9;,F.FECHA SE_FECHA_HABIL_EZU&#xA;&#x9;&#x9;FROM&#xA;&#x9;&#x9;&#x9;TMP.ME_TBCL C WITH(NOLOCK)&#xA;&#x9;&#x9;INNER JOIN&#xA;&#x9;&#x9;&#x9;TMP.ME_TBCL_DHABIL_NO_D F WITH(NOLOCK)&#xA;&#x9;&#x9;ON&#xA;&#x9;&#x9;&#x9;CONVERT(DATE,C.SE_FECHA_HORA) =  F.FECHA&#xA;&#x9;)&#xA;UPDATE &#xA;&#x9;[TMP].[ME_TBCL]&#xA;SET&#xA;&#x9; SE_ID_DIA_HABIL_EZU = CTE.SE_ID_DIA_HABIL_EZU&#xA;&#x9;,SE_FECHA_HABIL_EZU = CTE.SE_FECHA_HABIL_EZU&#xA;FROM&#xA;&#x9;TMP.ME_TBCL TMP INNER JOIN CTE&#xA;ON&#xA;&#x9;TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA&#xA;GO&#xA;WITH CTE&#xA;(&#xA;&#x9; G_NUMERO_GUIA  &#xA;&#x9;,SE_ID_DIA_HABIL_EZU&#xA;&#x9;,SE_FECHA_HABIL_EZU&#xA;)&#xA;AS&#xA;&#x9;(&#xA;&#x9;&#x9;SELECT &#xA;&#x9;&#x9;&#x9; C.G_NUMERO_GUIA G_NUMERO_GUIA&#xA;&#x9;&#x9;&#x9;,(SELECT TOP 1 ID_DIA_HABIL FROM TMP.ME_TBCL_DHABIL_NO_D F WITH(NOLOCK) WHERE F.FECHA &gt;= CONVERT(DATE,C.SE_FECHA_HORA)) SE_ID_DIA_HABIL_EZU&#xA;&#x9;&#x9;&#x9;,(SELECT TOP 1 F.FECHA FROM TMP.ME_TBCL_DHABIL_NO_D F WITH(NOLOCK) WHERE F.FECHA &gt;= CONVERT(DATE,C.SE_FECHA_HORA)) SE_FECHA_HABIL_EZU&#xA;&#x9;&#x9;FROM&#xA;&#x9;&#x9;&#x9;TMP.ME_TBCL C WITH(NOLOCK)&#xA;&#x9;&#x9;WHERE&#xA;&#x9;&#x9;&#x9;SE_ID_DIA_HABIL_EZU = 0&#xA;&#x9;)&#xA;UPDATE &#xA;&#x9;[TMP].[ME_TBCL]&#xA;SET&#xA;&#x9; SE_ID_DIA_HABIL_EZU = CTE.SE_ID_DIA_HABIL_EZU&#xA;&#x9;,SE_FECHA_HABIL_EZU = CTE.SE_FECHA_HABIL_EZU&#xA;FROM&#xA;&#x9;TMP.ME_TBCL TMP INNER JOIN CTE&#xA;ON&#xA;&#x9;TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
