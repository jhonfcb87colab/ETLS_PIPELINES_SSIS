          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Paso 58-3 Obtener Guias Informacion Adicional TBCL"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="1">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{82E3C266-AD9E-4E38-9443-8FFFA079254B}"
              SQLTask:SqlStatementSource="WITH CTE &#xA;(&#xA;&#x9; TC_NUMERO_GUIA&#xA;&#x9;,TC_ID_PROCESO&#xA;)&#xA;&#x9;AS&#xA;&#x9;&#x9;(&#xA;&#x9;&#x9;&#x9;SELECT&#xA;&#x9;&#x9;&#x9;&#x9; TC.NUMERO_GUIA TC_NUMERO_GUIA&#xA;&#x9;&#x9;&#x9;&#x9;,ISNULL(TC.ID_PROCESO,-888) TC_ID_PROCESO&#xA;&#x9;&#x9;&#x9;FROM&#xA;&#x9;&#x9;&#x9;&#x9;LOG.GUIA_INFORMACION_ADICIONAL_TABLERO_CONTROL TC WITH(NOLOCK)&#xA;&#x9;&#x9;&#x9;INNER JOIN&#xA;&#x9;&#x9;&#x9;&#x9;TMP.ME_TBCL TMP  WITH(NOLOCK)&#xA;&#x9;&#x9;&#x9;ON&#xA;&#x9;&#x9;&#x9;&#x9;TC.NUMERO_GUIA = TMP.G_NUMERO_GUIA&#xA;&#x9;&#x9;)&#xA;INSERT INTO&#xA;&#x9;TMP.ME_TBCL_INFTBCL&#xA;(&#xA;&#x9; TC_NUMERO_GUIA&#xA;&#x9;,TC_ID_PROCESO&#xA;)&#xA;SELECT &#xA;&#x9; TC_NUMERO_GUIA&#xA;&#x9;,TC_ID_PROCESO&#xA;FROM &#xA;&#x9;CTE" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Paso 58 Obtener Informacion Recaudo\Paso 58-4 Obtener Guias Recaudo Informacion Recaudo"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{A7EF8266-0938-441D-AF9E-66192E212C1B}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Paso 58-4 Obtener Guias Recaudo Informacion Recaudo"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="2">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{82E3C266-AD9E-4E38-9443-8FFFA079254B}"
              SQLTask:SqlStatementSource="WITH CTE &#xA;(&#xA;&#x9; IR_NUMERO_GUIA&#xA;&#x9;,IR_NUMERO_ORDEN_SERVICIO&#xA;&#x9;,IR_NUMERO_APROBACION&#xA;&#x9;,IR_VALOR_X_RECAUDAR&#xA;&#x9;,IR_VALOR_RECAUDADO&#xA;&#x9;,IR_NUMERO_CODI_EFECTY&#xA;)&#xA;&#x9;AS&#xA;&#x9;&#x9;( &#xA;&#x9;&#x9;&#x9;SELECT&#xA;&#x9;&#x9;&#x9;&#x9; IR.NUMERO_GUIA IR_NUMERO_GUIA&#xA;&#x9;&#x9;&#x9;&#x9;,ISNULL(CASE WHEN IR.NUMERO_ORDEN_SERVICIO = '' THEN NULL ELSE IR.NUMERO_ORDEN_SERVICIO END,'NO DISPONIBLE') IR_NUMERO_ORDEN_SERVICIO&#xA;&#x9;&#x9;&#x9;&#x9;,ISNULL(CASE WHEN IR.NUMERO_APROBACION = '' THEN NULL ELSE IR.NUMERO_APROBACION END, 'NO DISPONIBLE') IR_NUMERO_APROBACION&#xA;&#x9;&#x9;&#x9;&#x9;,ISNULL(IR.VALOR_PRODUCTO,0) IR_VALOR_X_RECAUDAR&#xA;&#x9;&#x9;&#x9;&#x9;,ISNULL(IR.VALOR_RECAUDADO,0) IR_VALOR_RECAUDADO&#xA;&#x9;&#x9;&#x9;&#x9;,ISNULL(IR.NUMERO_CODIGO_EFECTY,-888) IR_NUMERO_CODI_EFECTY&#xA;&#x9;&#x9;&#x9;FROM&#xA;&#x9;&#x9;&#x9;&#x9;LOG.GUIA_RECAUDO_INFORMACION_RECAUDO IR WITH(NOLOCK)&#xA;&#x9;&#x9;&#x9;INNER JOIN&#xA;&#x9;&#x9;&#x9;&#x9;[TMP].[ME_TBCL] TMP WITH(NOLOCK)&#xA;&#x9;&#x9;&#x9;ON&#xA;&#x9;&#x9;&#x9;&#x9;IR.NUMERO_GUIA = TMP.G_NUMERO_GUIA&#xA;&#x9;&#x9;)&#xA;&#xA;INSERT INTO&#xA;&#x9;TMP.ME_TBCL_GRINFR&#xA;(&#xA;&#x9; IR_NUMERO_GUIA&#xA;&#x9;,IR_NUMERO_ORDEN_SERVICIO&#xA;&#x9;,IR_NUMERO_APROBACION&#xA;&#x9;,IR_VALOR_X_RECAUDAR&#xA;&#x9;,IR_VALOR_RECAUDADO&#xA;&#x9;,IR_VALOR_SALDO&#xA;&#x9;,IR_NUMERO_CODI_EFECTY&#xA;)&#xA;SELECT &#xA;&#x9; IR_NUMERO_GUIA&#xA;&#x9;,IR_NUMERO_ORDEN_SERVICIO&#xA;&#x9;,IR_NUMERO_APROBACION&#xA;&#x9;,IR_VALOR_X_RECAUDAR&#xA;&#x9;,IR_VALOR_RECAUDADO&#xA;&#x9;,(IR_VALOR_X_RECAUDAR - IR_VALOR_RECAUDADO) AS IR_VALOR_SALDO&#xA;&#x9;,IR_NUMERO_CODI_EFECTY&#xA;FROM &#xA;&#x9;CTE&#x9;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
