      <DTS:Executables>
        <DTS:Executable
          DTS:refId="Package\66 Actualizar Descriptivos\66-1 Actualizar Tiempo Entrega"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{278B1031-6014-4C5F-9019-D85275874639}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="66-1 Actualizar Tiempo Entrega"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{82E3C266-AD9E-4E38-9443-8FFFA079254B}"
              SQLTask:SqlStatementSource="UPDATE&#xA;&#x9;TMP.ME_TBCL&#xA;SET &#xA;&#x9;G_NOMBRE_TIEMPO = ISNULL(PAR.NOMBRE_TIEMPO,'NO DISPONIBLE')&#xA;FROM &#xA;&#x9;TMP.ME_TBCL PYM WITH (NOLOCK)&#xA;INNER JOIN &#xA;&#x9;PAR.TIEMPOSENTREGA PAR WITH (NOLOCK)&#xA;ON&#x9;&#xA;&#x9;PYM.G_ID_TIEMPO = PAR.ID_TIEMPO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\66 Actualizar Descriptivos\66-2 Actualizar Medio Transporte"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{11f18fb3-c367-4ed5-82c1-e553229c1219}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="66-2 Actualizar Medio Transporte"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{82E3C266-AD9E-4E38-9443-8FFFA079254B}"
              SQLTask:SqlStatementSource="UPDATE&#xA;&#x9;TMP.ME_TBCL&#xA;SET &#xA;&#x9;G_NOMBRE_MEDTRANS = ISNULL(PAR.NOMBRE_MEDTRANS,'NO DISPONIBLE')&#xA;FROM &#xA;&#x9;TMP.ME_TBCL PYM WITH (NOLOCK)&#xA;INNER JOIN &#xA;&#x9;PAR.MEDIOTRANSPORTE PAR WITH (NOLOCK)&#xA;ON&#x9;&#xA;&#x9;PYM.G_ID_MEDTRANS = PAR.ID_MEDTRANS" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\66 Actualizar Descriptivos\66-3 Actualizar Estado Envio"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{65ee4523-146f-4ade-8d0b-ff9923657be1}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="66-3 Actualizar Estado Envio"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{82E3C266-AD9E-4E38-9443-8FFFA079254B}"
              SQLTask:SqlStatementSource="UPDATE&#xA;&#x9;TMP.ME_TBCL&#xA;SET &#xA;&#x9;G_NOMBRE_ESTADOENVIO = ISNULL(PAR.NOMBRE_ESTADOENVIO,'NO DISPONIBLE')&#xA;FROM &#xA;&#x9;TMP.ME_TBCL PYM WITH (NOLOCK)&#xA;INNER JOIN &#xA;&#x9;PAR.ESTADOSENVIO PAR WITH (NOLOCK)&#xA;ON&#x9;&#xA;&#x9;PYM.G_ID_ESTADOENVIO = PAR.ID_ESTADOENVIO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\66 Actualizar Descriptivos\66-4 Actualizar UEN"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{08afe3cf-aaf2-49e2-983b-84cd14375ea2}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="66-4 Actualizar UEN"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{82E3C266-AD9E-4E38-9443-8FFFA079254B}"
              SQLTask:SqlStatementSource="WITH CTE&#xA;(&#xA;&#x9; CLAVE_DIMENSION&#xA;&#x9;,ID_UEN&#xA;&#x9;,NOMBRE_UEN&#xA;&#x9;,ID_PRODUCTO&#xA;&#x9;,NOMBRE_PRODUCTO&#xA;&#x9;,ID_SUBPRODUCTO&#xA;&#x9;,NOMBRE_SUBPRODUCTO&#xA;)&#xA;AS&#xA;(&#xA;SELECT&#xA;&#x9;CONVERT(VARCHAR,P.ID_PRODUCTO) + '-' + CONVERT(VARCHAR, S.ID_SUBPRODUCTO) CLAVE_DIMENSION,&#xA;&#x9;U.ID_UEN,&#xA;&#x9;U.NOMBRE_UEN,&#xA;&#x9;P.ID_PRODUCTO,&#xA;&#x9;P.NOMBRE_PRODUCTO,&#xA;&#x9;S.ID_SUBPRODUCTO,&#xA;&#x9;S.NOMBRE_SUBPRODUCTO&#xA;FROM&#xA;&#x9;[PAR].[SUBPRODUCTOS] S WITH(NOLOCK)&#xA;INNER JOIN&#xA;(&#xA;SELECT&#xA;&#x9;[P].[ID_PRODUCTO],&#xA;&#x9;[P].[NOMBRE_PRODUCTO],&#xA;&#x9;[C].[ID_CATEGPROD],&#xA;&#x9;[C].[NOMBRE_CATEGPROD],&#xA;&#x9;[P].[ID_UEN]&#xA;FROM&#xA;&#x9;[PAR].[PRODUCTOS] [P]&#xA;INNER JOIN&#xA;&#x9;[PAR].[CATEGORIA_PRODUCTO] [C]&#xA;ON&#xA;&#x9;[C].[ID_CATEGPROD] = [P].[ID_CATEGPROD]&#xA;)P&#xA;ON&#xA;&#x9;S.ID_PRODUCTO = P.ID_PRODUCTO&#xA;INNER JOIN&#xA;(&#xA;&#x9;SELECT&#xA;&#x9;&#x9;[ID_UEN],&#xA;&#x9;&#x9;[NOMBRE_UEN],&#xA;&#x9;&#x9;[ID_EST_UEN],&#xA;&#x9;&#x9;[LOGIN_EMPLEADO],&#xA;&#x9;&#x9;[FECHA_CREACION],&#xA;&#x9;&#x9;[FECHA_MODIFICACION]&#xA;&#x9;FROM&#xA;&#x9;&#x9;[PAR].[U_E_N] WITH(NOLOCK)&#xA;)U&#xA;ON&#xA;&#x9;U.ID_UEN = P.ID_UEN&#xA;)&#xA;UPDATE&#xA;&#x9;[TMP].[ME_TBCL]&#xA;SET&#xA;&#x9; G_PROD_SUBPRO= ISNULL(CTE.NOMBRE_PRODUCTO,'NO DISPONIBLE')&#xA;FROM&#xA;&#x9; [TMP].[ME_TBCL] TMP WITH (NOLOCK)&#xA;&#x9;INNER JOIN CTE&#xA;ON &#xA;&#x9;TMP.G_ID_PROD_SUBPRO = CTE.CLAVE_DIMENSION" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\66 Actualizar Descriptivos\66-5 Actualizar Geografia Destino"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{ab22e758-7a81-4111-b4cc-85853c84c7a6}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="66-5 Actualizar Geografia Destino"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{82E3C266-AD9E-4E38-9443-8FFFA079254B}"
              SQLTask:SqlStatementSource="WITH CTE&#xA;(&#xA;&#x9; ID&#xA;&#x9;,ID_CIUDAD&#xA;&#x9;,NOMBRE_CIUDAD&#xA;&#x9;,ID_CIUDAD_CABECERA&#xA;&#x9;,NOMBRE_CIUDAD_CABECERA&#xA;&#x9;,ID_REGIONAL&#xA;&#x9;,NOMBRE_REGIONAL&#xA;&#x9;,ID_DEPARTAMENTO&#xA;&#x9;,NOMBRE_DEPARTAMENTO&#xA;)&#xA;AS&#xA;(&#xA;&#x9;SELECT &#xA;&#x9;&#x9; ROW_NUMBER() OVER(PARTITION BY C.ID_CIUDAD ORDER BY CA.FECHA_CREACION DESC) ID&#xA;&#x9;&#x9;,C.ID_CIUDAD&#xA;&#x9;&#x9;,C.NOMBRE_CIUDAD&#xA;&#x9;&#x9;,ISNULL(CASE WHEN R.ID_REGIONAL = RC.ID_REGIONAL THEN CC.ID_CIUDAD ELSE P.ID_CIUDAD END,-888) AS ID_CIUDAD_CABECERA&#xA;&#x9;&#x9;,ISNULL(CASE WHEN R.ID_REGIONAL = RC.ID_REGIONAL THEN CC.NOMBRE_CIUDAD ELSE P.NOMBRE_CIUDAD END,'NO DISPONIBLE') AS NOMBRE_CIUDAD_CABECERA&#xA;&#x9;&#x9;,ISNULL(CONVERT(INT,R.ID_REGIONAL),-888) AS ID_REGIONAL&#xA;&#x9;&#x9;,ISNULL(R.NOMBRE_REGIONAL,'NO DISPONIBLE') AS NOMBRE_REGIONAL&#xA;&#x9;&#x9;,ISNULL(CONVERT(INT,DP.ID_DEPARTAMENTO),-888) AS ID_DEPARTAMENTO&#xA;&#x9;&#x9;,ISNULL(DP.NOMBRE_DEPARTAMENTO,'NO DISPONIBLE') AS NOMBRE_DEPARTAMENTO&#xA;&#x9;FROM &#xA;&#x9;&#x9;PAR.CIUDADES C WITH(NOLOCK)&#xA;&#x9;LEFT JOIN&#xA;&#x9;&#x9;PAR.CIUDADES_ANEXAS CA WITH(NOLOCK)&#xA;&#x9;ON&#xA;&#x9;&#x9;C.ID_CIUDAD = CA.ID_CIUDAD_ANEXA&#xA;&#x9;AND&#xA;&#x9;&#x9;C.ID_PAIS = CA.ID_PAIS_ANEXA&#xA;&#x9;LEFT JOIN&#xA;&#x9;&#x9;PAR.CIUDADES CC WITH(NOLOCK)&#xA;&#x9;ON&#xA;&#x9;&#x9;CA.ID_CIUDAD = CC.ID_CIUDAD&#xA;&#x9;AND&#xA;&#x9;&#x9;CA.ID_PAIS = CC.ID_PAIS&#xA;&#x9;LEFT JOIN&#xA;&#x9;&#x9;PAR.REGIONALES_PAIS R WITH(NOLOCK)&#xA;&#x9;ON&#xA;&#x9;&#x9;C.ID_REGIONAL = R.ID_REGIONAL&#xA;&#x9;AND&#xA;&#x9;&#x9;C.ID_PAIS =R.ID_PAIS&#xA;&#x9;LEFT JOIN&#xA;&#x9;&#x9;(&#xA;&#x9;&#x9;&#x9;SELECT &#xA;&#x9;&#x9;&#x9;&#x9; C.ID_CIUDAD&#xA;&#x9;&#x9;&#x9;&#x9;,C.NOMBRE_CIUDAD&#xA;&#x9;&#x9;&#x9;&#x9;,R.ID_REGIONAL&#xA;&#x9;&#x9;&#x9;&#x9;,R.NOMBRE_REGIONAL&#xA;&#x9;&#x9;&#x9;FROM &#xA;&#x9;&#x9;&#x9;&#x9;PAR.CIUDADES C WITH(NOLOCK)&#xA;&#x9;&#x9;&#x9;INNER JOIN&#xA;&#x9;&#x9;&#x9;&#x9;PAR.REGIONALES_PAIS R WITH(NOLOCK)&#xA;&#x9;&#x9;&#x9;ON&#xA;&#x9;&#x9;&#x9;&#x9;C.ID_REGIONAL = R.ID_REGIONAL&#xA;&#x9;&#x9;&#x9;AND&#xA;&#x9;&#x9;&#x9;&#x9;C.ID_PAIS =R.ID_PAIS&#xA;&#x9;&#x9;&#x9;WHERE&#xA;&#x9;&#x9;&#x9;&#x9;C.ID_PAIS = 1&#xA;&#x9;&#x9;&#x9;AND&#xA;&#x9;&#x9;&#x9;&#x9;C.ID_CIUDAD IN (10,20,5,60,15,85,288,90,50,40)&#xA;&#x9;&#x9;&#x9;&#xA;&#x9;&#x9;) P&#xA;&#x9;ON&#xA;&#x9;&#x9;R.ID_REGIONAL = P.ID_REGIONAL&#xA;&#x9;LEFT JOIN&#xA;&#x9;&#x9;PAR.REGIONALES_PAIS RC WITH(NOLOCK)&#xA;&#x9;ON&#xA;&#x9;&#x9;CC.ID_REGIONAL = RC.ID_REGIONAL&#xA;&#x9;AND&#xA;&#x9;&#x9;CC.ID_PAIS =RC.ID_PAIS&#xA;&#x9;LEFT JOIN &#xA;&#x9;&#x9;PAR.DEPARTAMENTOS DP&#xA;&#x9;ON&#xA;&#x9;&#x9;C.ID_DEPARTAMENTO = DP.ID_DEPARTAMENTO&#xA;&#x9;WHERE&#xA;&#x9;&#x9;C.ID_PAIS = 1&#xA;)&#xA;UPDATE&#xA;&#x9;[TMP].[ME_TBCL]&#xA;SET &#xA;&#x9; G_CIUDAD_DESTINO = ISNULL(CTE.NOMBRE_CIUDAD,'NO DISPONIBLE')&#xA;&#x9;,G_DEPARTAMENTO_DESTINO = ISNULL(CTE.NOMBRE_DEPARTAMENTO,'NO DISPONIBLE')&#xA;&#x9;,G_REGIONAL_DESTINO = ISNULL(CTE.NOMBRE_REGIONAL,'NO DISPONIBLE')&#xA;FROM &#xA;&#x9; [TMP].[ME_TBCL] TMP WITH (NOLOCK)&#xA;&#x9; INNER JOIN CTE&#xA;ON&#x9; &#xA;&#x9;TMP.G_ID_CIUDAD_DESTINO = CTE.ID_CIUDAD&#xA;WHERE &#xA;&#x9;CTE.ID = 1" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\66 Actualizar Descriptivos\66-6 Actualizar Geografia Origen"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{312e32ba-4a8a-4491-aac4-d7877ff0f856}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="66-6 Actualizar Geografia Origen"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{82E3C266-AD9E-4E38-9443-8FFFA079254B}"
              SQLTask:SqlStatementSource="WITH CTE&#xA;(&#xA;&#x9; ID&#xA;&#x9;,ID_CIUDAD&#xA;&#x9;,NOMBRE_CIUDAD&#xA;&#x9;,ID_CIUDAD_CABECERA&#xA;&#x9;,NOMBRE_CIUDAD_CABECERA&#xA;&#x9;,ID_REGIONAL&#xA;&#x9;,NOMBRE_REGIONAL&#xA;&#x9;,ID_DEPARTAMENTO&#xA;&#x9;,NOMBRE_DEPARTAMENTO&#xA;)&#xA;AS&#xA;(&#xA;&#x9;SELECT &#xA;&#x9;&#x9; ROW_NUMBER() OVER(PARTITION BY C.ID_CIUDAD ORDER BY CA.FECHA_CREACION DESC) ID&#xA;&#x9;&#x9;,C.ID_CIUDAD&#xA;&#x9;&#x9;,C.NOMBRE_CIUDAD&#xA;&#x9;&#x9;,ISNULL(CASE WHEN R.ID_REGIONAL = RC.ID_REGIONAL THEN CC.ID_CIUDAD ELSE P.ID_CIUDAD END,-888) AS ID_CIUDAD_CABECERA&#xA;&#x9;&#x9;,ISNULL(CASE WHEN R.ID_REGIONAL = RC.ID_REGIONAL THEN CC.NOMBRE_CIUDAD ELSE P.NOMBRE_CIUDAD END,'NO DISPONIBLE') AS NOMBRE_CIUDAD_CABECERA&#xA;&#x9;&#x9;,ISNULL(CONVERT(INT,R.ID_REGIONAL),-888) AS ID_REGIONAL&#xA;&#x9;&#x9;,ISNULL(R.NOMBRE_REGIONAL,'NO DISPONIBLE') AS NOMBRE_REGIONAL&#xA;&#x9;&#x9;,ISNULL(CONVERT(INT,DP.ID_DEPARTAMENTO),-888) AS ID_DEPARTAMENTO&#xA;&#x9;&#x9;,ISNULL(DP.NOMBRE_DEPARTAMENTO,'NO DISPONIBLE') AS NOMBRE_DEPARTAMENTO&#xA;&#x9;FROM &#xA;&#x9;&#x9;PAR.CIUDADES C WITH(NOLOCK)&#xA;&#x9;LEFT JOIN&#xA;&#x9;&#x9;PAR.CIUDADES_ANEXAS CA WITH(NOLOCK)&#xA;&#x9;ON&#xA;&#x9;&#x9;C.ID_CIUDAD = CA.ID_CIUDAD_ANEXA&#xA;&#x9;AND&#xA;&#x9;&#x9;C.ID_PAIS = CA.ID_PAIS_ANEXA&#xA;&#x9;LEFT JOIN&#xA;&#x9;&#x9;PAR.CIUDADES CC WITH(NOLOCK)&#xA;&#x9;ON&#xA;&#x9;&#x9;CA.ID_CIUDAD = CC.ID_CIUDAD&#xA;&#x9;AND&#xA;&#x9;&#x9;CA.ID_PAIS = CC.ID_PAIS&#xA;&#x9;LEFT JOIN&#xA;&#x9;&#x9;PAR.REGIONALES_PAIS R WITH(NOLOCK)&#xA;&#x9;ON&#xA;&#x9;&#x9;C.ID_REGIONAL = R.ID_REGIONAL&#xA;&#x9;AND&#xA;&#x9;&#x9;C.ID_PAIS =R.ID_PAIS&#xA;&#x9;LEFT JOIN&#xA;&#x9;&#x9;(&#xA;&#x9;&#x9;&#x9;SELECT &#xA;&#x9;&#x9;&#x9;&#x9; C.ID_CIUDAD&#xA;&#x9;&#x9;&#x9;&#x9;,C.NOMBRE_CIUDAD&#xA;&#x9;&#x9;&#x9;&#x9;,R.ID_REGIONAL&#xA;&#x9;&#x9;&#x9;&#x9;,R.NOMBRE_REGIONAL&#xA;&#x9;&#x9;&#x9;FROM &#xA;&#x9;&#x9;&#x9;&#x9;PAR.CIUDADES C WITH(NOLOCK)&#xA;&#x9;&#x9;&#x9;INNER JOIN&#xA;&#x9;&#x9;&#x9;&#x9;PAR.REGIONALES_PAIS R WITH(NOLOCK)&#xA;&#x9;&#x9;&#x9;ON&#xA;&#x9;&#x9;&#x9;&#x9;C.ID_REGIONAL = R.ID_REGIONAL&#xA;&#x9;&#x9;&#x9;AND&#xA;&#x9;&#x9;&#x9;&#x9;C.ID_PAIS =R.ID_PAIS&#xA;&#x9;&#x9;&#x9;WHERE&#xA;&#x9;&#x9;&#x9;&#x9;C.ID_PAIS = 1&#xA;&#x9;&#x9;&#x9;AND&#xA;&#x9;&#x9;&#x9;&#x9;C.ID_CIUDAD IN (10,20,5,60,15,85,288,90,50,40)&#xA;&#x9;&#x9;&#x9;&#xA;&#x9;&#x9;) P&#xA;&#x9;ON&#xA;&#x9;&#x9;R.ID_REGIONAL = P.ID_REGIONAL&#xA;&#x9;LEFT JOIN&#xA;&#x9;&#x9;PAR.REGIONALES_PAIS RC WITH(NOLOCK)&#xA;&#x9;ON&#xA;&#x9;&#x9;CC.ID_REGIONAL = RC.ID_REGIONAL&#xA;&#x9;AND&#xA;&#x9;&#x9;CC.ID_PAIS =RC.ID_PAIS&#xA;&#x9;LEFT JOIN &#xA;&#x9;&#x9;PAR.DEPARTAMENTOS DP&#xA;&#x9;ON&#xA;&#x9;&#x9;C.ID_DEPARTAMENTO = DP.ID_DEPARTAMENTO&#xA;&#x9;WHERE&#xA;&#x9;&#x9;C.ID_PAIS = 1&#xA;)&#xA;UPDATE&#xA;&#x9;[TMP].[ME_TBCL]&#xA;SET &#xA;&#x9; G_CIUDAD_ORIGEN = ISNULL(CTE.NOMBRE_CIUDAD,'NO DISPONIBLE')&#xA;&#x9;,G_DEPARTAMENTO_ORIGEN = ISNULL(CTE.NOMBRE_DEPARTAMENTO,'NO DISPONIBLE')&#xA;&#x9;,G_REGIONAL_ORIGEN = ISNULL(CTE.NOMBRE_REGIONAL,'NO DISPONIBLE')&#xA;FROM &#xA;&#x9; [TMP].[ME_TBCL] TMP WITH (NOLOCK)&#xA;&#x9;,CTE&#xA;WHERE &#xA;&#x9;TMP.G_ID_CIUDAD_ORIGEN = CTE.ID_CIUDAD&#xA;AND &#xA;&#x9;CTE.ID = 1" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
      </DTS:Executables>
      <DTS:PrecedenceConstraints>
        <DTS:PrecedenceConstraint
          DTS:refId="Package\66 Actualizar Descriptivos.PrecedenceConstraints[Constraint]"
