              DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
              DTS:ThreadHint="0">
              <DTS:Variables />
              <DTS:ObjectData>
                <SQLTask:SqlTaskData
                  SQLTask:Connection="{82E3C266-AD9E-4E38-9443-8FFFA079254B}"
                  SQLTask:SqlStatementSource="INSERT INTO TMP.ME_TBCL_08&#xA;(&#xA;&#x9; G_NUMERO_GUIA&#xA;&#x9;,ID_NOVEDAD_ME_TBCL&#xA;&#x9;,SE_DESC_PROC_DEPU&#xA;&#x9;,SE_DESC_CONC_DEPU&#xA;&#x9;,SE_DEPURADO_RESP&#xA;&#x9;,FECHA_HORA_MOVIMIENTO&#xA;)&#xA;SELECT&#xA;&#x9; C.G_NUMERO_GUIA&#xA;&#x9;,'PROC'+'-'+ D.ID_PROCESO_CONCEPTO AS ID_NOVEDAD_ME_TBCL&#xA;&#x9;,D.NOMBRE_PROCESO SE_DESC_PROC_DEPU&#xA;&#x9;,D.NOMBRE_CONCEPTO SE_DESC_CONC_DEPU  ------- &#xA;&#x9;,D.RESP SE_DEPURADO_RESP&#xA;&#x9;,P.FECHA_HORA_MOVIMIENTO&#xA;FROM&#xA;&#x9;TMP.ME_TBCL C WITH(NOLOCK)&#xA;INNER JOIN&#xA;&#x9;TMP.ME_TBCL_04 P WITH(NOLOCK)&#xA;ON&#xA;&#x9;C.G_NUMERO_GUIA = P.NUMERO_GUIA&#xA;INNER JOIN&#xA;&#x9;PAR.TBCL_DEPU D&#xA;ON&#xA;&#x9;P.ID_PROCESO = D.ID_PROCESO&#xA;AND&#xA;&#x9;P.ID_CONCEPTO = D.ID_CONCEPTO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
              </DTS:ObjectData>
            </DTS:Executable>
