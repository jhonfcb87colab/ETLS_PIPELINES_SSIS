          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{82E3C266-AD9E-4E38-9443-8FFFA079254B}"
              SQLTask:SqlStatementSource="UPDATE &#xA;&#x9; [TMP].[ME_TBCL]&#xA;SET&#xA;&#x9; GR_ESTADO_RECAUDO = 'SI'&#xA;WHERE&#xA;&#x9;TC_ID_PROCESO &lt;&gt; -888&#xA;AND&#xA;&#x9;GRIR_NUME_ORDE_SERVI &lt;&gt; 'NO DISPONIBLE'" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
