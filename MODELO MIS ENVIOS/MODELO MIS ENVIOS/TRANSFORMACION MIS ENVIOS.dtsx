      DTS:Expression="@[$Project::DtMesFin] == (DT_DATE) &quot;01-01-1900&quot; ? (DT_DATE) DATEADD( &quot;DD&quot;, 1  ,  GETDATE()) :  @[$Project::DtMesFin]"
      DTS:IncludeInDebugDump="2345"
