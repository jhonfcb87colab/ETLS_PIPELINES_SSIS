          DTS:TaskContact="Performs high-performance data extraction, transformation and loading;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1">
          <DTS:Variables />
          <DTS:ObjectData>
            <pipeline
              version="1">
              <components>
                <component
                  refId="Package\Paso 52 Obtener Tareas y Pqr\Paso 52-1 Obtener Tareas\TAREAS"
                  componentClassID="Microsoft.OLEDBSource"
                  contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                  description="OLE DB Source"
                  name="TAREAS"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">DECLARE @FECHA_INI DATE = ?;
DECLARE @FECHA_FIN DATE = ?;

--DECLARE @FECHA_INI DATETIME = '2023-05-01';
--DECLARE @FECHA_FIN DATETIME = '2023-05-03';


SELECT  
	 T.[ID_TAREA]
	,T.[ID_LLAMADA]
	,T.[ID_TIPOSERVICIO]
	,T.[ID_SECUENCIASERVICIO]
	,T.[ID_TIPOTAREA]
	,T.[ID_PAIS]
	,T.[ID_CIUDAD]
	,T.[ID_DIVISION]
	,T.[ID_EMPLEADO]
	,T.[ID_EMPLEADO_REGISTRA]
	,T.[FECHA_ASIGN_TAREA]
	,T.[OBSERVACION_TAREA]
	,T.[ID_RESPUESTA_TAREA]
	,T.[FECHA_RESPUESTA_TAREA]
	,T.[OBSERVACION_RESP_TAREA]
	,T.[MEDIO_RESPUESTA_FAX]
	,T.[MEDIO_RESPUESTA_TELEFONO]
	,T.[MEDIO_RESPUESTA_EMAIL]
	,T.[MEDIO_RESPUESTA_DIRECCION]
	,T.[NUMERO_DOCPROBLEMA]
	,T.[ID_CIUDAD_A_QUE_PERTENECE]
	,T.[ID_TIPOIDP]
	,T.[ID_EMPLEADO_ASIGNADO]
	,T.[ID_EST_TAREA]
	,T.[RESPONSABLE_TIPOIDP]
	,T.[RESPONSABLE_PAIS]
	,T.[RESPONSABLE_CIUDAD]
	,T.[RESPONSABLE_TIPO]
	,T.[RESPONSABLE_CODIGO]
	,T.[LOGIN_EMPLEADO]
	,T.[FECHA_CREACION]
	,T.[FECHA_MODIFICACION]
	,T.[ORIGEN_TAREA]
	,T.[ID_CARGA]
	,T.[DOCUMENTO_ASOCIADO_SDM]
	,T.[TIPO_SDM]
	,T.[ID_CLIENTE_PS]
	,T.[TIPO_DOCUMENTO]
	,T.[DES_RESP_CLIENTE]
	,T.[RECIBE_CORREO]
	,T.[TELEFONO_TAREA]
	,T.[NUMERO_GUIA_SDM]
	,T.[ID_TIPORESPUESTA]
	,T.[ID_RESPUESTA_CONFIRMACION]
FROM 
	[dbo].[TAREAS] T WITH (NOLOCK)
INNER JOIN
	[dbo].GUIAS G WITH(NOLOCK)
ON
	RTRIM(T.[NUMERO_DOCPROBLEMA]) = CONVERT(VARCHAR,G.NUMERO_GUIA)
WHERE 	G.FECHA_MODIFICACION_DG &gt;= @FECHA_INI
AND 	G.FECHA_MODIFICACION_DG &lt;= @FECHA_FIN


--T.FECHA_MODIFICACION  BETWEEN  DATEADD(d,-20,GETDATE()) 
--AND	 GETDATE()</property>
