      <DTS:Variables />
      <DTS:Executables>
        <DTS:Executable
          DTS:refId="Package\Paso 58 Obtener Informacion Recaudo\Paso 58-1 Obtener Guias Recaudo Efecty"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{4AE2BF74-DC9A-4F04-B9FD-D120D70DEBB1}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Paso 58-1 Obtener Guias Recaudo Efecty"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{82E3C266-AD9E-4E38-9443-8FFFA079254B}"
              SQLTask:SqlStatementSource="WITH CTE&#xA;(&#xA;&#x9; EF_ID&#xA;&#x9;,EF_NUMERO_GUIA&#xA;&#x9;,EF_ORDEN_SERVICIO&#xA;&#x9;,EF_PROYECTO&#xA;&#x9;,EF_VALOR&#xA;)&#xA;AS&#xA;(&#x9;&#xA;&#x9;SELECT&#xA;&#x9;&#x9; ROW_NUMBER() OVER(PARTITION BY EF.NUMERO_GUIA ORDER BY EF.ID DESC) EF_ID&#xA;&#x9;&#x9;,EF.NUMERO_GUIA EF_NUMERO_GUIA&#xA;&#x9;&#x9;,ISNULL(EF.ORDEN_SERVICIO,'NO DISPONIBLE') EF_ORDEN_SERVICIO&#xA;&#x9;&#x9;,ISNULL(EF.PROYECTO,'NO DISPONIBLE') EF_PROYECTO&#xA;&#x9;&#x9;,ISNULL(EF.VALOR,0) EF_VALOR&#xA;&#x9;FROM&#xA;&#x9;&#x9;LOG.GUIA_RECAUDO_INFORMACION_EFECTY EF WITH(NOLOCK)&#xA;&#x9;INNER JOIN&#xA;&#x9;&#x9;TMP.ME_TBCL TMP  WITH(NOLOCK)&#xA;&#x9;ON&#xA;&#x9;&#x9;EF.NUMERO_GUIA = TMP.G_NUMERO_GUIA&#xA;)&#xA;INSERT INTO &#xA;&#x9;TMP.ME_TBCL_GREF&#xA;(&#xA;&#x9; EF_NUMERO_GUIA&#xA;&#x9;,EF_PROYECTO&#xA;&#x9;,EF_ORDEN_SERVICIO&#xA;&#x9;,EF_VALOR&#xA;)&#xA;SELECT&#xA;&#x9; A.EF_NUMERO_GUIA&#xA;&#x9;,A.EF_PROYECTO&#xA;&#x9;,A.EF_ORDEN_SERVICIO&#xA;&#x9;,A.EF_VALOR&#xA;FROM&#xA;&#x9;CTE A&#xA;WHERE &#xA;&#x9;A.EF_ID = 1" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Paso 58 Obtener Informacion Recaudo\Paso 58-2 Obtener Guias Recaudo Efecty TR"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{E13AA055-C4F1-4D4E-BF7B-D0BA55E5EC48}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Paso 58-2 Obtener Guias Recaudo Efecty TR"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{82E3C266-AD9E-4E38-9443-8FFFA079254B}"
              SQLTask:SqlStatementSource="WITH CTE&#xA;(&#xA;&#x9; EF_ID&#xA;&#x9;,EF_NUMERO_GUIA&#xA;&#x9;,EF_ORDEN_SERVICIO&#xA;&#x9;,EF_PROYECTO&#xA;&#x9;,EF_VALOR&#xA;)&#xA;AS&#xA;(&#xA;&#x9;SELECT&#xA;&#x9;&#x9; ROW_NUMBER() OVER(PARTITION BY EF.NUMERO_GUIA ORDER BY EF.ID DESC) EF_ID&#xA;&#x9;&#x9;,EF.NUMERO_GUIA EF_NUMERO_GUIA&#xA;&#x9;&#x9;,ISNULL(EF.NUMERO_ORDEN_SERVICIO,'NO DISPONIBLE') EF_ORDEN_SERVICIO&#xA;&#x9;&#x9;,ISNULL(EF.CODIGO_PROYECTO,'NO DISPONIBLE') EF_PROYECTO&#xA;&#x9;&#x9;,ISNULL(EF.VALOR_TOTAL,0) EF_VALOR&#xA;&#x9;FROM&#xA;&#x9;&#x9;LOG.COD_CONTROL_TRANSMISION_RECAUDO EF WITH(NOLOCK)&#xA;&#x9;INNER JOIN&#xA;&#x9;&#x9;(SELECT B.G_NUMERO_GUIA FROM TMP.ME_TBCL B WITH(NOLOCK) WHERE B.G_NUMERO_GUIA NOT IN (SELECT A.EF_NUMERO_GUIA FROM  TMP.ME_TBCL_GREF A WITH(NOLOCK))) TR&#xA;&#x9;ON&#xA;&#x9;&#x9;EF.NUMERO_GUIA = TR.G_NUMERO_GUIA&#xA;)&#xA;INSERT INTO&#xA;&#x9;TMP.ME_TBCL_GREF&#xA;(&#xA;&#x9; EF_NUMERO_GUIA&#xA;&#x9;,EF_PROYECTO&#xA;&#x9;,EF_ORDEN_SERVICIO&#xA;&#x9;,EF_VALOR&#xA;)&#xA;SELECT&#xA;&#x9; A.EF_NUMERO_GUIA&#xA;&#x9;,A.EF_PROYECTO&#xA;&#x9;,A.EF_ORDEN_SERVICIO&#xA;&#x9;,A.EF_VALOR&#xA;FROM&#xA;&#x9;CTE A&#xA;WHERE &#xA;&#x9;A.EF_ID = 1" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Paso 58 Obtener Informacion Recaudo\Paso 58-3 Obtener Guias Informacion Adicional TBCL"
