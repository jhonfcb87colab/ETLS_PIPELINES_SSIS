                <component
                  refId="Package\RED_OPERATIVA_RUTA\EXTRAER\OLE DB Source"
                  componentClassID="Microsoft.OLEDBSource"
                  contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                  description="OLE DB Source"
                  name="OLE DB Source"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT 
	 R.ID_RUTA
	,GEO.NOMBRE_REGIONAL REGIONAL_ORIGEN
	,GEO.NOMBRE_CIUDAD CIUDAD_ORIGEN
	,R.ID_CIUDAD_ORIGEN
	,GED.NOMBRE_REGIONAL REGIONAL_DESTINO
	,GED.NOMBRE_CIUDAD CIUDAD_DESTINO
	,R.ID_CIUDAD_DESTINO
	,TE.NOMBRE_TIEMPO
	,R.ID_TIEMPO
	,MT.NOMBRE_MEDTRANS
	,R.ID_MEDTRANS
	,IM.NOMBRE_IMPEDANCIA
	,R.ID_IMPEDANCIA
	,FC.NOMBRE_FILTRO
	,R.ID_FILTRO_CRITICIDAD
	,R.VALOR_FILTRO_CRITICIDAD
	,R.VALOR_FILTRO_MODO_TRANSPORTE
	,R.TOTAL_TIEMPO_OPERATIVO
	,R.TOTAL_TIEMPO_OPERATIVO_REF
	,R.TOTAL_DISTANCIA
	,R.TOTAL_COSTO
	,R.TOTAL_ID_CRITICIDAD
	,R.TOTAL_ID_PESOCATEG
	,R.LOGIN_EMPLEADO_MODIFICACION
	,R.FECHA_MODIFICACION
	,R.ID_ESTADO_RUTA
	,R.ID_RUTA_NET
	,R.TOTAL_TIEMPO_OPERATIVO_REF_CALCULO
	,R.TOTAL_DISTANCIA_CALCULO
	-- REGLA DEL NEGOCIO TOMADA DE RDO_FUN_TIEMPO_ENTREGA_COMERCIAL DE REDOPERATIVA
	,CASE WHEN
			R.ID_CIUDAD_ORIGEN = R.ID_CIUDAD_DESTINO
		THEN
			CASE WHEN R.ID_TIEMPO = 2 THEN 0 ELSE 24 END
		ELSE
			ISNULL(R.TOTAL_TIEMPO_OPERATIVO_REF/60,0)
		END [TIEMPO_ENTREGA_COMERCIAL_HOR]
	,CASE WHEN
			R.ID_CIUDAD_ORIGEN = R.ID_CIUDAD_DESTINO
		THEN
			CASE WHEN R.ID_TIEMPO = 2 THEN 0 ELSE 1 END
		ELSE
			ISNULL(R.TOTAL_TIEMPO_OPERATIVO_REF/1440,0)
		END [TIEMPO_ENTREGA_COMERCIAL_DIA]
	,R.LOGIN_MODIFICACION_MANUAL
	,R.FECHA_EXTRACCION_DW
FROM 
	TMP.RUTA R
LEFT JOIN
	DIM.CIUDADES_MOVIMIENTOS_MOVILIZADOS GEO
ON
	R.ID_CIUDAD_ORIGEN = GEO.ID_CIUDAD
LEFT JOIN
	DIM.CIUDADES_MOVIMIENTOS_MOVILIZADOS GED
ON
	R.ID_CIUDAD_DESTINO = GED.ID_CIUDAD
LEFT JOIN
	DIM.TIEMPOS_ENTREGA TE
ON
	R.ID_TIEMPO = TE.ID_TIEMPO
LEFT JOIN
	DIM.MEDIO_TRANSPORTE MT
ON
	R.ID_MEDTRANS = MT.ID_MEDTRANS
LEFT JOIN
	TMP.IMPEDANCIA IM
ON
	R.ID_IMPEDANCIA = IM.ID_IMPEDANCIA
LEFT JOIN
	TMP.FILTROCRITICIDAD FC
ON
	R.ID_FILTRO_CRITICIDAD = FC.ID_FILTRO_CRITICIDAD
WHERE 
	(R.ID_PAIS_ORIGEN = 1 AND R.ID_PAIS_DESTINO = 1)</property>
