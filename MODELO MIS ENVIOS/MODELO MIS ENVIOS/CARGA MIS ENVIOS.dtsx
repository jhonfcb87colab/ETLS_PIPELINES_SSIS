      DTS:ObjectName="Borrado de Guias"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{A07AAE32-AD2C-4D61-803C-B98BB3D4B38F}"
          SQLTask:SqlStatementSource="DELETE  FROM &#xA;&#x9;[FAC].[MIS_ENVIOS] &#xA;WHERE&#xA;&#x9;[G_NUMERO_GUIA] IN (&#xA;&#x9;&#x9;SELECT [G_NUMERO_GUIA] FROM [TMP].[MIS_ENVIOS] WITH(NOLOCK)&#xA;&#x9;)" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
