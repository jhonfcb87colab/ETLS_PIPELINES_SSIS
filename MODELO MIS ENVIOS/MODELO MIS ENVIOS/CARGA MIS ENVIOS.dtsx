  <DTS:Executables>
    <DTS:Executable
      DTS:refId="Package\AUDITORIA GUIAS A DEPURAR MOVILIZAR A TABLA DE SEGUIMEINTO"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{AD0ECD8F-ABC4-4586-8CEC-FBDB57F0C8A9}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="AUDITORIA GUIAS A DEPURAR MOVILIZAR A TABLA DE SEGUIMEINTO"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{82E3C266-AD9E-4E38-9443-8FFFA079254B}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;&#xA;-- ============================================================&#xA;-- DEPURACION FAC.MIS_ENVIOS — GUIAS ANULADAS&#xA;-- Flujo por lote:&#xA;--   1. Limpiar duplicados previos en AUDITORIA (re-ejecucion segura)&#xA;--   2. Backup de registros vigentes en MIS_ENVIOS → AUDITORIA&#xA;--   3. Eliminar registros anulados de MIS_ENVIOS (depuracion real)&#xA;-- Cada lote es atomico: si cualquier paso falla se hace ROLLBACK&#xA;-- y el bucle se detiene preservando integridad.&#xA;-- ============================================================&#xA;&#xA;DECLARE @LOTE       INT = 5000;   -- Lote reducido a 5k: discos degradados necesitan escrituras cortas&#xA;DECLARE @MIN_ID     INT = 1;&#xA;DECLARE @MAX_ID_LOTE INT;&#xA;DECLARE @MAX_ID_TOTAL INT = (&#xA;    SELECT ISNULL(MAX(ID_INTERNO), 0)&#xA;    FROM [SIG_COLOMBIA_DW].[TMP].[MIS_ENVIOS_GUIAS_ANULADAS]&#xA;);&#xA;DECLARE @FILAS_BACKUP  INT = 0;&#xA;DECLARE @FILAS_DELETE  INT = 0;&#xA;DECLARE @TOTAL_BACKUP  INT = 0;&#xA;DECLARE @TOTAL_DELETE  INT = 0;&#xA;DECLARE @MSG           NVARCHAR(500);&#xA;&#xA;PRINT CONCAT(CHAR(10), '=== INICIO DEPURACION MIS_ENVIOS | Total IDs a procesar: ', @MAX_ID_TOTAL, ' | Lote: ', @LOTE, ' ===');&#xA;&#xA;WHILE @MIN_ID &lt;= @MAX_ID_TOTAL&#xA;BEGIN&#xA;    SET @MAX_ID_LOTE = @MIN_ID + @LOTE - 1;&#xA;&#xA;    BEGIN TRY&#xA;        BEGIN TRANSACTION;&#xA;&#xA;        -- PASO 1: Limpiar registros previos en AUDITORIA para este rango&#xA;        --         Solo borra de AUDITORIA si la guia sigue en MIS_ENVIOS:&#xA;        --         garantiza que no se pierda el backup de guias ya depuradas&#xA;        --         que vuelvan a aparecer en TMP en una re-ejecucion.&#xA;        DELETE [AUD]&#xA;        FROM [SIG_COLOMBIA_DW].[TMP].[MIS_ENVIOS_GUIAS_ANULADAS] [TMP_ANUL]&#xA;        INNER JOIN [SIG_COL_SCN_DM].[FAC].[MIS_ENVIOS_AUDITORIA_GUIAS_ANULADAS] [AUD]&#xA;            ON [TMP_ANUL].[NUMERO_GUIA] = [AUD].[G_NUMERO_GUIA]&#xA;        INNER JOIN [SIG_COL_SCN_DM].[FAC].[MIS_ENVIOS] [FAC]&#xA;            ON [TMP_ANUL].[NUMERO_GUIA] = [FAC].[G_NUMERO_GUIA]&#xA;        WHERE [TMP_ANUL].[ID_INTERNO] &gt;= @MIN_ID&#xA;          AND [TMP_ANUL].[ID_INTERNO] &lt;= @MAX_ID_LOTE&#xA;        OPTION (RECOMPILE);  -- Fuerza reestimacion: MIS_ENVIOS encoge lote a lote&#xA;&#xA;        -- PASO 2: Backup — copiar desde MIS_ENVIOS hacia AUDITORIA&#xA;        INSERT INTO [SIG_COL_SCN_DM].[FAC].[MIS_ENVIOS_AUDITORIA_GUIAS_ANULADAS]&#xA;        SELECT [FAC].*&#xA;        FROM [SIG_COLOMBIA_DW].[TMP].[MIS_ENVIOS_GUIAS_ANULADAS] [TMP_ANUL]&#xA;        INNER JOIN [SIG_COL_SCN_DM].[FAC].[MIS_ENVIOS] [FAC]&#xA;            ON [TMP_ANUL].[NUMERO_GUIA] = [FAC].[G_NUMERO_GUIA]&#xA;        WHERE [TMP_ANUL].[ID_INTERNO] &gt;= @MIN_ID&#xA;          AND [TMP_ANUL].[ID_INTERNO] &lt;= @MAX_ID_LOTE&#xA;        OPTION (RECOMPILE);&#xA;&#xA;        SET @FILAS_BACKUP = @@ROWCOUNT;&#xA;&#xA;        -- PASO 3: Depuracion — eliminar guias anuladas de FAC.MIS_ENVIOS&#xA;        DELETE [FAC]&#xA;        FROM [SIG_COLOMBIA_DW].[TMP].[MIS_ENVIOS_GUIAS_ANULADAS] [TMP_ANUL]&#xA;        INNER JOIN [SIG_COL_SCN_DM].[FAC].[MIS_ENVIOS] [FAC]&#xA;            ON [TMP_ANUL].[NUMERO_GUIA] = [FAC].[G_NUMERO_GUIA]&#xA;        WHERE [TMP_ANUL].[ID_INTERNO] &gt;= @MIN_ID&#xA;          AND [TMP_ANUL].[ID_INTERNO] &lt;= @MAX_ID_LOTE&#xA;        OPTION (RECOMPILE);&#xA;&#xA;        SET @FILAS_DELETE = @@ROWCOUNT;&#xA;&#xA;        COMMIT TRANSACTION;&#xA;&#xA;        SET @TOTAL_BACKUP += @FILAS_BACKUP;&#xA;        SET @TOTAL_DELETE += @FILAS_DELETE;&#xA;&#xA;        SET @MSG = CONCAT(&#xA;            'Lote OK | IDs [', @MIN_ID, ' - ', @MAX_ID_LOTE, ']',&#xA;            ' | Backup: ', @FILAS_BACKUP,&#xA;            ' | Eliminados: ', @FILAS_DELETE,&#xA;            ' | Acum.Backup: ', @TOTAL_BACKUP,&#xA;            ' | Acum.Elim: ', @TOTAL_DELETE&#xA;        );&#xA;        PRINT @MSG;&#xA;&#xA;    END TRY&#xA;    BEGIN CATCH&#xA;        IF @@TRANCOUNT &gt; 0 ROLLBACK TRANSACTION;&#xA;&#xA;        PRINT CONCAT(&#xA;            '*** ERROR en lote IDs [', @MIN_ID, ' - ', @MAX_ID_LOTE, '] ***',&#xA;            CHAR(10), 'Mensaje : ', ERROR_MESSAGE(),&#xA;            CHAR(10), 'Linea   : ', ERROR_LINE(),&#xA;            CHAR(10), 'Proceso detenido. Ultimo lote exitoso hasta ID: ', @MIN_ID - 1&#xA;        );&#xA;        -- Detener el bucle ante cualquier fallo para no comprometer integridad&#xA;        SET @MIN_ID = @MAX_ID_TOTAL + 1;&#xA;        RETURN;&#xA;    END CATCH;&#xA;&#xA;    SET @MIN_ID = @MAX_ID_LOTE + 1;&#xA;END;&#xA;&#xA;PRINT CONCAT(&#xA;    CHAR(10), '=== FIN DEPURACION ===',&#xA;    CHAR(10), 'Total registros en AUDITORIA : ', @TOTAL_BACKUP,&#xA;    CHAR(10), 'Total eliminados de MIS_ENVIOS: ', @TOTAL_DELETE&#xA;);&#xA;&#xA;SET NOCOUNT OFF;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Borrado de Guias"
