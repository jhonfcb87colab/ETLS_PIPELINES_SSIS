      <DTS:Variables />
      <DTS:Executables>
        <DTS:Executable
          DTS:refId="Package\DIMENSION VENCIMIENTO\GENERACION BASE VENCIMIENTOS"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Tarea Ejecutar SQL"
          DTS:DTSID="{A12B24E9-2886-4C46-825B-C35B68E21319}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="GENERACION BASE VENCIMIENTOS"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{680D323D-BE30-458E-A7C7-26A5BA37EE6B}"
              SQLTask:SqlStatementSource="USE SIG_COLOMBIA_DW;&#xA;&#xA;DECLARE @TABLA_VENCIMIENTOS AS TABLE(ID INT,VENCIMIENTO VARCHAR(50))&#xA;INSERT INTO @TABLA_VENCIMIENTOS(ID,VENCIMIENTO)&#xA;VALUES&#xA;(0,'NO DISPONIBLE'),&#xA;(1,'MENOR A 3 DIAS DE VENCIDO'),&#xA;(2,'2 DIAS DE VENCIDO'),&#xA;(3,'1 DIA DE VENCIDO'),&#xA;(4,'CUMPLIDA'),&#xA;(5,'VENCE HOY'),&#xA;(6,'1 DIA PARA VENCERSE'),&#xA;(7,'2 DIAS PARA VENCERSE'),&#xA;(8,'MAYOR A 3 DIAS POR VENCERSE')&#xA;&#xA;&#xA;TRUNCATE TABLE [TMP].[RCOLEO_GM_DIM_VENCIMIENTO];&#xA;&#xA;INSERT INTO [TMP].[RCOLEO_GM_DIM_VENCIMIENTO]&#xA;SELECT ID, VENCIMIENTO FROM @TABLA_VENCIMIENTOS&#xA;&#xA;&#xA;---------SELECT * FROM [TMP].[RCOLEO_GM_DIM_VENCIMIENTO]" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\DIMENSION VENCIMIENTO\MPCCO_DIM_TIEMPO"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{5FED40A0-010E-4B55-87AB-3D52C0E9C716}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="MPCCO_DIM_TIEMPO"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{0988B2E2-E797-41B5-BFF5-ADA2373F701E}"
              SQLTask:SqlStatementSource="TRUNCATE TABLE [DIM].[MPCCO_DIM_TIEMPO_GENERICA];&#xA;WITH CTE AS(&#xA;            SELECT &#xA;            id = ROW_NUMBER() OVER(order BY ([YEAR]*100)+[WEEK_OF_YEAR] DESC)&#xA;            ,[YEAR] AS ANIO&#xA;            ,[WEEK_OF_YEAR] AS SEMANA&#xA;            FROM [SIG_COL_LOGISTICA_DW].[DIM].[TIEMPO] WITH(NOLOCK)&#xA;            WHERE &#xA;&#x9;&#x9;&#x9;[DATE] BETWEEN &#xA;                (&#xA;                    SELECT MIN(FECHA)&#xA;                    FROM (&#xA;                        SELECT MIN(FECHA) AS FECHA FROM [FAC].[RCOLEO_GM_RECOLECCION_HISTORICO] WITH(NOLOCK)&#xA;&#xA;                        UNION ALL&#xA;                        SELECT MIN(FECHA) FROM [FAC].[RCOLEO_GM_RECOLECCION] WITH(NOLOCK)&#xA;&#xA;                    ) AS FECHAS&#xA;                )&#xA;                AND CONVERT(DATETIME, CONVERT(DATE, DATEADD(DAY, 0, GETDATE())))&#xA;            GROUP BY [YEAR], [WEEK_OF_YEAR]&#xA;)&#xA;INSERT INTO [DIM].[MPCCO_DIM_TIEMPO_GENERICA]&#xA;SELECT &#xA;       [TIME_ID]&#xA;      ,[DATE]&#xA;      ,[DAY]&#xA;      ,[MONTH]&#xA;      ,[YEAR]&#xA;      ,[DAY_OF_MONTH]&#xA;      ,[WEEK_OF_YEAR]&#xA;      ,ORDEN_SEMANA = SEMANA.id&#xA;      ,NUMERO_SEMANA = CONCAT('SEM ',[WEEK_OF_YEAR])&#xA;      ,ANIO = [YEAR]&#xA;      ,[MONTH_OF_YEAR]&#xA;      ,[QUARTER_OF_YEAR]&#xA;      ,IIF(&#xA;            DAY(GETDATE())=DAY([DATE]) &#xA;            AND MONTH(GETDATE())=MONTH([DATE]) &#xA;            AND YEAR(GETDATE())=YEAR([DATE]),&#xA;            CONCAT('HOY',' ',[DAY],' ',[DAY_OF_MONTH],' de ',[MONTH]),&#xA;            CONCAT([DAY],' ',[DAY_OF_MONTH],' de ',[MONTH],' ',[YEAR])&#xA;        ) AS FECHA_LABEL&#xA;FROM [SIG_COL_LOGISTICA_DW].[DIM].[TIEMPO] DIM WITH(NOLOCK)&#xA;INNER JOIN CTE AS SEMANA &#xA;            ON SEMANA.ANIO= DIM.YEAR AND SEMANA.SEMANA=DIM.WEEK_OF_YEAR&#xA;WHERE [DATE]&lt;=GETDATE() AND&#xA;[DATE] BETWEEN &#xA;    (&#xA;        SELECT MIN(FECHA)&#xA;        FROM (&#xA;            SELECT MIN(FECHA) AS FECHA FROM [FAC].[RCOLEO_GM_RECOLECCION_HISTORICO] WITH(NOLOCK)&#xA;&#xA;            UNION ALL&#xA;            SELECT MIN(FECHA) FROM [FAC].[RCOLEO_GM_RECOLECCION] WITH(NOLOCK)&#xA;&#xA;        ) AS FECHAS&#xA;    )&#xA;    AND CONVERT(DATETIME, CONVERT(DATE, DATEADD(DAY, 5, GETDATE())))&#xA;ORDER BY TIME_ID DESC;&#xA;GO&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;/*&#xA;TRUNCATE TABLE [DIM].[MPCCO_DIM_TIEMPO_GENERICA];&#xA;WITH CTE AS(&#xA;            SELECT &#xA;            id = ROW_NUMBER() OVER(order BY [WEEK_OF_YEAR] DESC)&#xA;            ,[YEAR] AS ANIO&#xA;            ,[WEEK_OF_YEAR] AS SEMANA&#xA;            FROM [SIG_COL_LOGISTICA_DW].[DIM].[TIEMPO] WITH(NOLOCK)&#xA;            WHERE [DATE] BETWEEN &#xA;                (&#xA;                    SELECT MIN(FECHA)&#xA;                    FROM (&#xA;                        SELECT MIN(FECHA) AS FECHA FROM [FAC].[RCOLEO_GM_RECOLECCION_HISTORICO] WITH(NOLOCK)&#xA;&#xA;                        UNION ALL&#xA;                        SELECT MIN(FECHA) FROM [FAC].[RCOLEO_GM_RECOLECCION] WITH(NOLOCK)&#xA;&#xA;                    ) AS FECHAS&#xA;                )&#xA;                AND CONVERT(DATETIME, CONVERT(DATE, DATEADD(DAY, 5, GETDATE())))&#xA;            GROUP BY [YEAR], [WEEK_OF_YEAR]&#xA;)&#xA;INSERT INTO [DIM].[MPCCO_DIM_TIEMPO_GENERICA]&#xA;SELECT &#xA;       [TIME_ID]&#xA;      ,[DATE]&#xA;      ,[DAY]&#xA;      ,[MONTH]&#xA;      ,[YEAR]&#xA;      ,[DAY_OF_MONTH]&#xA;      ,[WEEK_OF_YEAR]&#xA;      ,ORDEN_SEMANA = SEMANA.id&#xA;      ,NUMERO_SEMANA = CONCAT('SEM ',[WEEK_OF_YEAR])&#xA;      ,ANIO = [YEAR]&#xA;      ,[MONTH_OF_YEAR]&#xA;      ,[QUARTER_OF_YEAR]&#xA;      ,IIF(&#xA;            DAY(GETDATE())=DAY([DATE]) &#xA;            AND MONTH(GETDATE())=MONTH([DATE]) &#xA;            AND YEAR(GETDATE())=YEAR([DATE]),&#xA;            CONCAT('HOY',' ',[DAY],' ',[DAY_OF_MONTH],' de ',[MONTH]),&#xA;            CONCAT([DAY],' ',[DAY_OF_MONTH],' de ',[MONTH],' ',[YEAR])&#xA;        ) AS FECHA_LABEL&#xA;FROM [SIG_COL_LOGISTICA_DW].[DIM].[TIEMPO] DIM WITH(NOLOCK)&#xA;INNER JOIN CTE AS SEMANA &#xA;            ON SEMANA.ANIO= DIM.YEAR AND SEMANA.SEMANA=DIM.WEEK_OF_YEAR&#xA;WHERE [DATE] BETWEEN &#xA;    (&#xA;        SELECT MIN(FECHA)&#xA;        FROM (&#xA;            SELECT MIN(FECHA) AS FECHA FROM [FAC].[RCOLEO_GM_RECOLECCION_HISTORICO] WITH(NOLOCK)&#xA;&#xA;            UNION ALL&#xA;            SELECT MIN(FECHA) FROM [FAC].[RCOLEO_GM_RECOLECCION] WITH(NOLOCK)&#xA;&#xA;        ) AS FECHAS&#xA;    )&#xA;    AND CONVERT(DATETIME, CONVERT(DATE, DATEADD(DAY, 5, GETDATE())))&#xA;ORDER BY TIME_ID DESC;&#xA;GO&#xA;*/" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
