          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{25F48698-08A8-4803-B1AC-4DC2B8165B50}"
              SQLTask:SqlStatementSource="UPDATE&#xA;&#x9;FAC.RCOLEO_GM_RECOLECCION&#xA;SET&#xA;&#x9;ID_GEOGRAFIA = CONVERT(VARCHAR(37),RIGHT( '0000' +  CONVERT(VARCHAR,ID_CIUDAD_ZONA_URBA),4) + CONVERT(VARCHAR,'0') + RIGHT( '000' +  CONVERT(VARCHAR,'0'),3)) &#xA;FROM&#xA;&#x9;FAC.RCOLEO_GM_RECOLECCION F WITH (NOLOCK)&#xA;LEFT JOIN&#xA;&#x9; [SIG_COL_LOGISTICA_DW].DIM.CIUDADES_ZONA_URBA C WITH (NOLOCK)&#xA;ON&#xA;&#x9;F.ID_GEOGRAFIA = CONVERT(VARCHAR(37),RIGHT( '0000' +  CONVERT(VARCHAR,C.ID_CIUDAD),4) + CONVERT(VARCHAR,C.ID_TIPO_ZONA_URBA) + RIGHT( '000' +  CONVERT(VARCHAR,C.ID_ZONA_URBA),3)) &#xA;WHERE&#xA;&#x9;C.ID_CIUDAD IS NULL&#xA;&#xA;&#xA;&#xA;/* UPDATE&#xA;&#x9;FAC.RCOLEO_GM_RECOLECCION&#xA;SET&#xA;&#x9;ID_GEOGRAFIA = CONVERT(VARCHAR(37),RIGHT( '0000' +  CONVERT(VARCHAR,ID_CIUDAD_ZONA_URBA),4) + CONVERT(VARCHAR,'0') + RIGHT( '000' +  CONVERT(VARCHAR,'0'),3)) &#xA;FROM&#xA;&#x9;FAC.RCOLEO_GM_RECOLECCION F WITH (NOLOCK)&#xA;LEFT JOIN&#xA;&#x9; [SIG_COLOMBIA_DW].DIM.CIUDADES_ZONA_URBA C WITH (NOLOCK)&#xA;ON&#xA;&#x9;F.ID_GEOGRAFIA = CONVERT(VARCHAR(37),RIGHT( '0000' +  CONVERT(VARCHAR,C.ID_CIUDAD),4) + CONVERT(VARCHAR,C.ID_TIPO_ZONA_URBA) + RIGHT( '000' +  CONVERT(VARCHAR,C.ID_ZONA_URBA),3)) &#xA;WHERE&#xA;&#x9;C.ID_CIUDAD IS NULL&#xA;AND&#xA;&#x9;F.TIME_ID IN&#xA;(&#xA;&#xA;&#x9;SELECT DISTINCT&#xA;&#x9;&#x9;CONVERT(INT,CONVERT(NUMERIC,CONVERT(DATETIME,CONVERT(CHAR(11),S_ID_FECHA_RECOLECCION))))&#xA;&#x9;FROM &#xA;&#x9;&#x9;[TMP].[RCOLEO_GM_SOLICITUDRECOLECCION]  WITH(NOLOCK)&#xA;)*/" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
