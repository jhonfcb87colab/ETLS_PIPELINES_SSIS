                <component
                  refId="Package\CARGA RECOLECCION GUIA\Extraer GM SolicitudRecoleccion Guias\OLE DB Source"
                  componentClassID="Microsoft.OLEDBSource"
                  contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                  description="OLE DB Source"
                  name="OLE DB Source"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT 
	 CONVERT(INT,CONVERT(NUMERIC,CONVERT(DATETIME,CONVERT(CHAR(11),S_GUI.S_ID_FECHA_RECOLECCION)))) AS TIME_ID
	,S_GUI.S_ID_FECHA_RECOLECCION FECHA
	,DAY(S_GUI.S_ID_FECHA_RECOLECCION) DIA
	,MONTH(S_GUI.S_ID_FECHA_RECOLECCION) MES
	,YEAR(S_GUI.S_ID_FECHA_RECOLECCION) AÑO
	,CASE WHEN (S_GUI.S_ID_TIPO_ZONA_URBA = -888 OR S_GUI.S_ID_ZONA_URBA = -888) THEN
		CONVERT(VARCHAR(37),RIGHT( '0000' +  CONVERT(VARCHAR,S_GUI.S_ID_CIUDAD_ZONA_URBA),4) + CONVERT(VARCHAR,'0') + RIGHT( '000' +  CONVERT(VARCHAR,'0'),3)) 
	 ELSE
		CONVERT(VARCHAR(37),RIGHT( '0000' +  CONVERT(VARCHAR,S_GUI.S_ID_CIUDAD_ZONA_URBA),4) + CONVERT(VARCHAR,S_GUI.S_ID_TIPO_ZONA_URBA) + RIGHT( '000' +  CONVERT(VARCHAR,S_GUI.S_ID_ZONA_URBA),3)) 
	 END ID_GEOGRAFIA
	,S_GUI.S_ID_CIUDAD_ZONA_URBA ID_CIUDAD_ZONA_URBA
	,CASE WHEN S_GUI.S_ID_TIPO_ZONA_URBA = -888 THEN 0 ELSE S_GUI.S_ID_TIPO_ZONA_URBA END ID_TIPO_ZONA_URBA
	,CASE WHEN S_GUI.S_ID_ZONA_URBA = -888 THEN 0 ELSE S_GUI.S_ID_ZONA_URBA END ID_ZONA_URBA
	,S_GUI.S_ID_CONFIRM_SOLICITUD ID_CONFIRM_SOLICITUD
	,S_GUI.S_ID_TIPO_SOLICITUD ID_TIPO_SOLICITUD
	,CONVERT(INT,S_GUI.S_ID_MOTIVO_RECHAZO) ID_MOTIVO_RECHAZO
	,CONVERT(CHAR(20),CASE WHEN S_GUI.S_ID_CLIENTE = '-888' THEN '0' ELSE S_GUI.S_ID_CLIENTE END) ID_CLIENTE
	,CASE WHEN S_GUI.S_ID_TIEMPO_ENTREGAR = -888 THEN 0 ELSE S_GUI.S_ID_TIEMPO_ENTREGAR END ID_TIEMPO_ENTREGA
	,CASE WHEN S_GUI.S_ID_PRODUCTO = -888 OR S_GUI.S_ID_SUBPRODUCTO = -888 THEN CONVERT(VARCHAR(6),'000000') ELSE CONVERT(VARCHAR(6),RIGHT('00' + CONVERT(VARCHAR,S_GUI.S_ID_PRODUCTO),2) + RIGHT( '0000' +  CONVERT(VARCHAR, S_GUI.S_ID_SUBPRODUCTO),4)) END ID_UEN_PROD_SUBPROD
	,CASE WHEN S_GUI.S_ID_PRODUCTO = -888 THEN 0 ELSE S_GUI.S_ID_PRODUCTO END ID_PRODUCTO
	,CASE WHEN S_GUI.S_ID_SUBPRODUCTO = -888 THEN 0 ELSE S_GUI.S_ID_SUBPRODUCTO END ID_SUBPRODUCTO
	,S_GUI.S_NUMERO_SOLICITUD NUMERO_SOLICITUD
	,S_GUI.G_NUMERO_GUIA NUMERO_GUIA
    ,S_GUI.GM_MARCA
	,S_GUI.ID_PROCESO
	,S_GUI.S_ID_FECHA_RECOLECCION S_FECHA_RECOLECCION
	,CASE WHEN S_GUI.S_ID_FECHA_RECOLECCION = '1900-01-01' THEN 'NO DISPONIBLE' ELSE CONVERT(VARCHAR,S_GUI.S_ID_FECHA_RECOLECCION,121) END S_FECHA_HORA_RECOLECCION
	,CONVERT(INT,CONVERT(NUMERIC,CONVERT(DATETIME,CONVERT(CHAR(11),S_GUI.FECHA_HORA_EZU)))) AS M_TIMEID_EZU
	,S_GUI.FECHA_HORA_EZU FECHA_RECOLECCION_EZU
	,CASE WHEN S_GUI.FECHA_HORA_EZU = '1900-01-01' THEN 'NO DISPONIBLE' ELSE CONVERT(VARCHAR,S_GUI.FECHA_HORA_EZU,121) END FECHA_HORA_RECOLECCION_EZU
	,CONVERT(INT,CONVERT(NUMERIC,CONVERT(DATETIME,CONVERT(CHAR(11),S_GUI.FECHA_HORA_RECOLECCION_REGIS)))) AS M_TIMEID_REGIS
	,S_GUI.FECHA_HORA_RECOLECCION_REGIS FECHA_RECOLECCION_REGIS
	,CASE WHEN S_GUI.FECHA_HORA_RECOLECCION_REGIS = '1900-01-01' THEN 'NO DISPONIBLE' ELSE CONVERT(VARCHAR,S_GUI.FECHA_HORA_RECOLECCION_REGIS,121) END FECHA_HORA_RECOLECCION_REGIS
	,CONVERT(INT,CONVERT(NUMERIC,CONVERT(DATETIME,CONVERT(CHAR(11),S_GUI.FECHA_HORA_RECOLECCION_ZONIF)))) AS M_TIMEID_ZONIF
	,S_GUI.FECHA_HORA_RECOLECCION_ZONIF FECHA_RECOLECCION_ZONIF
	,CASE WHEN S_GUI.FECHA_HORA_RECOLECCION_ZONIF = '1900-01-01' THEN 'NO DISPONIBLE' ELSE CONVERT(VARCHAR,S_GUI.FECHA_HORA_RECOLECCION_ZONIF,121) END FECHA_HORA_RECOLECCION_ZONIF	
	,CONVERT(INT,CONVERT(NUMERIC,CONVERT(DATETIME,CONVERT(CHAR(11),S_GUI.FECHA_HORA_RECOLECCION_ASIGN)))) AS M_TIMEID_ASIGN
	,S_GUI.FECHA_HORA_RECOLECCION_ASIGN FECHA_RECOLECCION_ASIGN
	,CASE WHEN S_GUI.FECHA_HORA_RECOLECCION_ASIGN = '1900-01-01' THEN 'NO DISPONIBLE' ELSE CONVERT(VARCHAR,S_GUI.FECHA_HORA_RECOLECCION_ASIGN,121) END FECHA_HORA_RECOLECCION_ASIGN
	,CONVERT(INT,CONVERT(NUMERIC,CONVERT(DATETIME,CONVERT(CHAR(11),S_GUI.FECHA_HORA_RECOLECCION_VERIF)))) AS M_TIMEID_VERIF
	,S_GUI.FECHA_HORA_RECOLECCION_VERIF FECHA_RECOLECCION_VERIF
	,CASE WHEN S_GUI.FECHA_HORA_RECOLECCION_VERIF = '1900-01-01' THEN 'NO DISPONIBLE' ELSE CONVERT(VARCHAR,S_GUI.FECHA_HORA_RECOLECCION_VERIF,121) END FECHA_HORA_RECOLECCION_VERIF	
	,CONVERT(INT,CONVERT(NUMERIC,CONVERT(DATETIME,CONVERT(CHAR(11),S_GUI.FECHA_HORA_RECOLECCION_CANCEL)))) AS M_TIMEID_CANCEL
	,S_GUI.FECHA_HORA_RECOLECCION_CANCEL FECHA_RECOLECCION_CANCEL
	,CASE WHEN S_GUI.FECHA_HORA_RECOLECCION_CANCEL = '1900-01-01' THEN 'NO DISPONIBLE' ELSE CONVERT(VARCHAR,S_GUI.FECHA_HORA_RECOLECCION_CANCEL,121) END FECHA_HORA_RECOLECCION_CANCEL
	,CONVERT(INT,CONVERT(NUMERIC,CONVERT(DATETIME,CONVERT(CHAR(11),S_GUI.FECHA_HORA_RECOLECCION_RR)))) AS M_TIMEID_RR
	,S_GUI.FECHA_HORA_RECOLECCION_RR FECHA_RECOLECCION_RR
	,CASE WHEN S_GUI.FECHA_HORA_RECOLECCION_RR = '1900-01-01' THEN 'NO DISPONIBLE' ELSE CONVERT(VARCHAR,S_GUI.FECHA_HORA_RECOLECCION_RR,121) END FECHA_HORA_RECOLECCION_RR
	,S_GUI.ID_ESTADO_ASIGNADA
	,S_GUI.ID_ESTADO_ASIGNADA_EZU
	,S_GUI.ID_ESTADO_ASIGNADA_EZU_HOY
	,S_GUI.ID_ESTADO_VEJEZ
	,S_GUI.ID_RANGO_VEJEZ
	,CASE WHEN S_GUI.OBSERVACIONES IS NULL OR S_GUI.OBSERVACIONES = '' THEN 'NO DISPONIBLE' ELSE S_GUI.OBSERVACIONES  END OBSERVACIONES
	,S_GUI.OBSERVACIONES_GM
    ,CASE WHEN S_GUI.LOGIN_CREACION IS NULL OR S_GUI.LOGIN_CREACION = '' THEN '-888' ELSE S_GUI.LOGIN_CREACION END LOGIN_CREACION
    ,S_GUI.EMAIL_CREACION
	,S_GUI.EVIDENCIA_FOTOGRAFICA
	,S_GUI.DIAS_NOVEDAD	
	,S_REC.CODSER
	,S_REC.ID_SUCURSAL
	,S_REC.ID_DEPENDEN
FROM 
	TMP.RCOLEO_GM_SOLICITUDRECOLECCION_GUIAS S_GUI WITH (NOLOCK)
	INNER JOIN TMP.RCOLEO_GM_SOLICITUDRECOLECCION S_REC WITH (NOLOCK)
	ON S_GUI.S_NUMERO_SOLICITUD=S_REC.S_NUMERO_SOLICITUD</property>
