          DTS:ThreadHint="1">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{19887262-0DBD-4B78-A8A5-A7538F01C808}"
              SQLTask:SqlStatementSource="DROP TABLE IF EXISTS #TMP_FAC_MPCCO_RCOLEO_GM_RECOLECCION_HISTORICO&#xA;&#x9;&#x9;&#x9;SELECT&#xA;&#x9;&#x9;&#x9;&#x9; CONVERT(INT,CONVERT(NUMERIC,CONVERT(DATETIME,CONVERT(CHAR(11),S_ID_FECHA_RECOLECCION)))) AS TIME_ID&#xA;&#x9;&#x9;&#x9;&#x9;,S_ID_FECHA_RECOLECCION FECHA&#xA;&#x9;&#x9;&#x9;&#x9;,DAY(S_ID_FECHA_RECOLECCION) DIA&#xA;&#x9;&#x9;&#x9;&#x9;,MONTH(S_ID_FECHA_RECOLECCION) MES&#xA;&#x9;&#x9;&#x9;&#x9;,YEAR(S_ID_FECHA_RECOLECCION) AÑO&#xA;&#x9;&#x9;&#x9;&#x9;,CASE WHEN  ZU.ID_CIUDAD IS NULL &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;THEN  '00000000' &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN (S_ID_TIPO_ZONA_URBA = -888 OR S_ID_ZONA_URBA = -888) &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;THEN CONVERT(VARCHAR(37),RIGHT( '0000' +  CONVERT(VARCHAR,S_ID_CIUDAD_ZONA_URBA),4) + CONVERT(VARCHAR,'0') + RIGHT( '000' +  CONVERT(VARCHAR,'0'),3)) &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9; ELSE&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;CONVERT(VARCHAR(37),RIGHT( '0000' +  CONVERT(VARCHAR,S_ID_CIUDAD_ZONA_URBA),4) + CONVERT(VARCHAR,S_ID_TIPO_ZONA_URBA) + RIGHT( '000' +  CONVERT(VARCHAR,S_ID_ZONA_URBA),3)) &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9; END ID_GEOGRAFIA&#xA;&#x9;&#x9;&#x9;&#x9;,RGS.S_ID_CIUDAD_ZONA_URBA ID_CIUDAD_ZONA_URBA&#xA;&#x9;&#x9;&#x9;&#x9;,CASE WHEN RGS.S_ID_TIPO_ZONA_URBA = -888 THEN 0 ELSE RGS.S_ID_TIPO_ZONA_URBA END ID_TIPO_ZONA_URBA&#xA;&#x9;&#x9;&#x9;&#x9;,CASE WHEN RGS.S_ID_ZONA_URBA = -888 THEN 0 ELSE RGS.S_ID_ZONA_URBA END ID_ZONA_URBA&#xA;&#x9;&#x9;&#x9;&#x9;,RGS.S_ID_CONFIRM_SOLICITUD ID_CONFIRM_SOLICITUD&#xA;&#x9;&#x9;&#x9;&#x9;,RGS.S_ID_TIPO_SOLICITUD ID_TIPO_SOLICITUD&#xA;&#x9;&#x9;&#x9;&#x9;,CONVERT(INT,RGS.S_ID_MOTIVO_RECHAZO) ID_MOTIVO_RECHAZO&#xA;&#x9;&#x9;&#x9;&#x9;,CONVERT(CHAR(20),CASE WHEN RGS.S_ID_CLIENTE = '-888' THEN '0' ELSE RGS.S_ID_CLIENTE END) ID_CLIENTE&#xA;&#x9;&#x9;&#x9;&#x9;,CASE WHEN RGS.S_ID_TIEMPO_ENTREGAR = -888 THEN 0 ELSE RGS.S_ID_TIEMPO_ENTREGAR END ID_TIEMPO_ENTREGA&#xA;&#x9;&#x9;&#x9;&#x9;,CASE WHEN RGS.S_ID_PRODUCTO = -888 OR RGS.S_ID_SUBPRODUCTO = -888&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;THEN CONVERT(VARCHAR(6),'000000')&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9; ELSE&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;CONVERT(VARCHAR(6),RIGHT('00' + CONVERT(VARCHAR,RGS.S_ID_PRODUCTO),2) + RIGHT( '0000' +  CONVERT(VARCHAR, RGS.S_ID_SUBPRODUCTO),4))&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;END ID_UEN_PROD_SUBPROD&#xA;&#x9;&#x9;&#x9;&#x9;,CASE WHEN RGS.S_ID_PRODUCTO = -888 THEN 0 ELSE RGS.S_ID_PRODUCTO END ID_PRODUCTO&#xA;&#x9;&#x9;&#x9;&#x9;,CASE WHEN RGS.S_ID_SUBPRODUCTO = -888 THEN 0 ELSE RGS.S_ID_SUBPRODUCTO END ID_SUBPRODUCTO&#xA;&#x9;&#x9;&#x9;&#x9;,RGS.S_NUMERO_SOLICITUD NUMERO_SOLICITUD&#xA;&#x9;&#x9;&#x9;&#x9;,RGS.GM_MARCA&#xA;&#x9;&#x9;&#x9;&#x9;,RGS.S_ID_FECHA_RECOLECCION S_FECHA_RECOLECCION&#xA;&#x9;&#x9;&#x9;&#x9;,CASE WHEN RGS.S_ID_FECHA_RECOLECCION = '1900-01-01' THEN 'NO DISPONIBLE' ELSE CONVERT(VARCHAR,RGS.S_ID_FECHA_RECOLECCION,121) END S_FECHA_HORA_RECOLECCION&#xA;&#x9;&#x9;&#x9;&#x9;,CONVERT(INT,CONVERT(NUMERIC,CONVERT(DATETIME,CONVERT(CHAR(11),RGS.FECHA_HORA_RECOLECCION_REGIS)))) AS M_TIMEID_REGIS&#xA;&#x9;&#x9;&#x9;&#x9;,RGS.FECHA_HORA_RECOLECCION_REGIS FECHA_RECOLECCION_REGIS&#xA;&#x9;&#x9;&#x9;&#x9;,CASE WHEN RGS.FECHA_HORA_RECOLECCION_REGIS = '1900-01-01' THEN 'NO DISPONIBLE' ELSE CONVERT(VARCHAR,RGS.FECHA_HORA_RECOLECCION_REGIS,121) END FECHA_HORA_RECOLECCION_REGIS&#xA;&#x9;&#x9;&#x9;&#x9;,CONVERT(INT,CONVERT(NUMERIC,CONVERT(DATETIME,CONVERT(CHAR(11),RGS.FECHA_HORA_RECOLECCION_ZONIF)))) AS M_TIMEID_ZONIF&#xA;&#x9;&#x9;&#x9;&#x9;,RGS.FECHA_HORA_RECOLECCION_ZONIF FECHA_RECOLECCION_ZONIF&#xA;&#x9;&#x9;&#x9;&#x9;,CASE WHEN RGS.FECHA_HORA_RECOLECCION_ZONIF = '1900-01-01' THEN 'NO DISPONIBLE' ELSE CONVERT(VARCHAR,RGS.FECHA_HORA_RECOLECCION_ZONIF,121) END FECHA_HORA_RECOLECCION_ZONIF&#x9;&#xA;&#x9;&#x9;&#x9;&#x9;,CONVERT(INT,CONVERT(NUMERIC,CONVERT(DATETIME,CONVERT(CHAR(11),RGS.FECHA_HORA_RECOLECCION_ASIGN)))) AS M_TIMEID_ASIGN&#xA;&#x9;&#x9;&#x9;&#x9;,RGS.FECHA_HORA_RECOLECCION_ASIGN FECHA_RECOLECCION_ASIGN&#xA;&#x9;&#x9;&#x9;&#x9;,CASE WHEN RGS.FECHA_HORA_RECOLECCION_ASIGN = '1900-01-01' THEN 'NO DISPONIBLE' ELSE CONVERT(VARCHAR,RGS.FECHA_HORA_RECOLECCION_ASIGN,121) END FECHA_HORA_RECOLECCION_ASIGN&#xA;&#x9;&#x9;&#x9;&#x9;,CONVERT(INT,CONVERT(NUMERIC,CONVERT(DATETIME,CONVERT(CHAR(11),RGS.FECHA_HORA_RECOLECCION_VERIF)))) AS M_TIMEID_VERIF&#xA;&#x9;&#x9;&#x9;&#x9;,RGS.FECHA_HORA_RECOLECCION_VERIF FECHA_RECOLECCION_VERIF&#xA;&#x9;&#x9;&#x9;&#x9;,CASE WHEN RGS.FECHA_HORA_RECOLECCION_VERIF = '1900-01-01' THEN 'NO DISPONIBLE' ELSE  CONVERT(VARCHAR,RGS.FECHA_HORA_RECOLECCION_VERIF,121) END  FECHA_HORA_RECOLECCION_VERIF&#x9;&#xA;&#x9;&#x9;&#x9;&#x9;,CONVERT(INT,CONVERT(NUMERIC,CONVERT(DATETIME,CONVERT(CHAR(11),RGS.FECHA_HORA_RECOLECCION_CANCEL)))) AS M_TIMEID_CANCEL&#xA;&#x9;&#x9;&#x9;&#x9;,RGS.FECHA_HORA_RECOLECCION_CANCEL FECHA_RECOLECCION_CANCEL&#xA;&#x9;&#x9;&#x9;&#x9;,CASE WHEN RGS.FECHA_HORA_RECOLECCION_CANCEL = '1900-01-01' THEN 'NO DISPONIBLE' ELSE CONVERT(VARCHAR,RGS.FECHA_HORA_RECOLECCION_CANCEL,121) END FECHA_HORA_RECOLECCION_CANCEL&#xA;&#x9;&#x9;&#x9;&#x9;,RGS.ID_ESTADO_ASIGNADA&#xA;&#x9;&#x9;&#x9;&#x9;,RGS.ID_ESTADO_ASIGNADA_EZU&#xA;&#x9;&#x9;&#x9;&#x9;,RGS.ID_ESTADO_ASIGNADA_EZU_HOY&#xA;&#x9;&#x9;&#x9;&#x9;,RGS.ID_ESTADO_VEJEZ&#xA;&#x9;&#x9;&#x9;&#x9;,RGS.ID_RANGO_VEJEZ&#x9;&#xA;&#x9;&#x9;&#x9;&#x9;,CASE WHEN RGS.OBSERVACIONES IS NULL OR RGS.OBSERVACIONES = '' THEN 'NO DISPONIBLE' &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;ELSE RGS.OBSERVACIONES  END OBSERVACIONES&#xA;&#x9;&#x9;&#x9;&#x9;,OBSERVACIONES_GM&#xA;&#x9;&#x9;&#x9;&#x9;,CASE WHEN RGS.LOGIN_CREACION IS NULL OR RGS.LOGIN_CREACION = '' THEN '-888' ELSE RGS.LOGIN_CREACION END LOGIN_CREACION&#xA;&#x9;&#x9;&#x9;&#x9;,RGS.EMAIL_CREACION&#xA;&#x9;&#x9;&#x9;&#x9;,ISNULL(RGS.EVIDENCIA_FOTOGRAFICA, 'NO DISPONIBLE') AS EVIDENCIA_FOTOGRAFICA&#xA;&#x9;&#x9;&#x9;&#x9;,RGS.DIAS_NOVEDAD&#xA;&#x9;&#x9;&#x9;&#x9;,RGS.CDS&#xA;&#x9;&#x9;&#x9;&#x9;,RGS.ID_CDS&#xA;&#x9;&#x9;&#x9;&#x9;,RGS.CODSER&#xA;&#x9;&#x9;&#x9;&#x9;,RGS.ID_SUCURSAL&#xA;&#x9;&#x9;&#x9;&#x9;,RGS.ID_DEPENDEN&#xA;&#x9;&#x9;&#x9;&#x9;,ISNULL(RGS.CANTIDAD_ENVIOS,1) AS CANTIDAD_ENVIOS&#xA;&#x9;&#x9;&#x9;&#x9;,RGS.[ID_PAIS]&#xA;&#x9;&#x9;&#x9;&#x9;,RGS.[ID_CIUDAD]&#xA;&#x9;&#x9;&#x9;&#x9;,RGS.[PAIS_CIUDAD_DIVISION]&#xA;&#x9;&#x9;&#x9;&#x9;, CASE WHEN CP_RECHAZO.KEY_ESTADO_RCOLEO IS NULL &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;THEN '0--888'&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;ELSE CONCAT(CONVERT(VARCHAR(10),RGS.S_ID_CONFIRM_SOLICITUD),'-',CONVERT(VARCHAR(10),RGS.S_ID_MOTIVO_RECHAZO))&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;END KEY_ESTADO_RCOLEO&#xA;&#x9;&#x9;&#x9;&#x9;,RGS.[DIRECCION_RECOLECCION]&#xA;&#x9;&#x9;&#x9;&#x9;,RGS.[VENCIMIENTO]&#xA;&#x9;&#x9;&#x9;,RGS.ID_TIPO_SOLICITANTE&#xA;&#x9;&#x9;&#x9;,RGS.FECHA_CREACION_SOLICITUD &#xA;&#x9;&#x9;&#x9;,GETDATE() AS FECHA_EXTRACCION_DW&#xA;&#x9;&#x9;&#x9;INTO #TMP_FAC_MPCCO_RCOLEO_GM_RECOLECCION_HISTORICO&#xA;&#x9;&#x9;&#x9;FROM &#xA;&#x9;&#x9;&#x9;&#x9;[SIG_COLOMBIA_DW].TMP.RCOLEO_GM_SOLICITUDRECOLECCION RGS WITH (NOLOCK)&#xA;&#x9;&#x9;&#x9;LEFT JOIN SIG_COLOMBIA_DW.PAR.ZONASURBANAS ZU WITH(NOLOCK) ----ORDER BY FECHA_CREACION DESC&#xA;&#x9;&#x9;&#x9;ON(&#xA;&#x9;&#x9;&#x9;&#x9;ZU.ID_CIUDAD=RGS.ID_CIUDAD&#x9;&#xA;&#x9;&#x9;&#x9;AND ZU.ID_TIPO_ZONA_URBA=RGS.S_ID_TIPO_ZONA_URBA&#x9;&#xA;&#x9;&#x9;&#x9;AND ZU.ID_ZONA_URBA=RGS.S_ID_ZONA_URBA&#xA;&#x9;&#x9;&#x9;AND ZU.ID_PAIS=1&#xA;&#x9;&#x9;&#x9;)&#xA;&#x9;&#x9;&#x9;LEFT JOIN [SIG_LOGISTICA_DM].[DIM].[RCOLEO_GM_RECOLECCION_RECHAZOS_CONCEPTOS] CP_RECHAZO WITH (NOLOCK)&#xA;&#x9;&#x9;&#x9;ON &#xA;&#x9;&#x9;&#x9;CONCAT(CONVERT(VARCHAR(10),RGS.S_ID_CONFIRM_SOLICITUD),'-',CONVERT(VARCHAR(10),RGS.S_ID_MOTIVO_RECHAZO))=CP_RECHAZO.KEY_ESTADO_RCOLEO&#xA;&#xA;&#xA;&#xA;&#xA;MERGE [SIG_LOGISTICA_DM].[FAC].[MPCCO_GM_RECOLECCION_HISTORICO] AS TARGET  -- TABLA OBJETIVO (TABLA PARA INSERTAR DATOS)    /**/&#xA;USING #TMP_FAC_MPCCO_RCOLEO_GM_RECOLECCION_HISTORICO AS SOURCE ---TABLA FUENTE (TABLA TEMPORAL)&#xA;&#x9;ON TARGET.NUMERO_SOLICITUD = SOURCE.NUMERO_SOLICITUD&#x9;&#x9;------COLUMNAS LLAVE&#xA;WHEN MATCHED &#xA;&#x9;&#x9;--------AND TARGET.NUMERO_SOLICITUD = SOURCE.NUMERO_SOLICITUD   --- OPCIONAL SI SE NECESITAN MAS CONDICIONES&#xA;&#x9;&#x9;THEN        &#xA;UPDATE SET &#xA; TARGET.TIME_ID = SOURCE.TIME_ID&#xA;,TARGET.FECHA = SOURCE.FECHA&#xA;,TARGET.DIA = SOURCE.DIA&#xA;,TARGET.MES = SOURCE.MES&#xA;,TARGET.AÑO = SOURCE.AÑO&#xA;,TARGET.ID_GEOGRAFIA = SOURCE.ID_GEOGRAFIA&#xA;,TARGET.ID_CIUDAD_ZONA_URBA = SOURCE.ID_CIUDAD_ZONA_URBA&#xA;,TARGET.ID_TIPO_ZONA_URBA = SOURCE.ID_TIPO_ZONA_URBA&#xA;,TARGET.ID_ZONA_URBA = SOURCE.ID_ZONA_URBA&#xA;,TARGET.ID_CONFIRM_SOLICITUD = SOURCE.ID_CONFIRM_SOLICITUD&#xA;,TARGET.ID_TIPO_SOLICITUD = SOURCE.ID_TIPO_SOLICITUD&#xA;,TARGET.ID_MOTIVO_RECHAZO = SOURCE.ID_MOTIVO_RECHAZO&#xA;,TARGET.ID_CLIENTE = SOURCE.ID_CLIENTE&#xA;,TARGET.ID_TIEMPO_ENTREGA = SOURCE.ID_TIEMPO_ENTREGA&#xA;,TARGET.ID_UEN_PROD_SUBPROD = SOURCE.ID_UEN_PROD_SUBPROD&#xA;,TARGET.ID_PRODUCTO = SOURCE.ID_PRODUCTO&#xA;,TARGET.ID_SUBPRODUCTO = SOURCE.ID_SUBPRODUCTO&#xA;,TARGET.NUMERO_SOLICITUD = SOURCE.NUMERO_SOLICITUD&#xA;,TARGET.GM_MARCA = SOURCE.GM_MARCA&#xA;,TARGET.S_FECHA_RECOLECCION = SOURCE.S_FECHA_RECOLECCION&#xA;,TARGET.S_FECHA_HORA_RECOLECCION = SOURCE.S_FECHA_HORA_RECOLECCION&#xA;,TARGET.M_TIMEID_REGIS = SOURCE.M_TIMEID_REGIS&#xA;,TARGET.FECHA_RECOLECCION_REGIS = SOURCE.FECHA_RECOLECCION_REGIS&#xA;,TARGET.FECHA_HORA_RECOLECCION_REGIS = SOURCE.FECHA_HORA_RECOLECCION_REGIS&#xA;,TARGET.M_TIMEID_ZONIF = SOURCE.M_TIMEID_ZONIF&#xA;,TARGET.FECHA_RECOLECCION_ZONIF = SOURCE.FECHA_RECOLECCION_ZONIF&#xA;,TARGET.FECHA_HORA_RECOLECCION_ZONIF = SOURCE.FECHA_HORA_RECOLECCION_ZONIF&#xA;,TARGET.M_TIMEID_ASIGN = SOURCE.M_TIMEID_ASIGN&#xA;,TARGET.FECHA_RECOLECCION_ASIGN = SOURCE.FECHA_RECOLECCION_ASIGN&#xA;,TARGET.FECHA_HORA_RECOLECCION_ASIGN = SOURCE.FECHA_HORA_RECOLECCION_ASIGN&#xA;,TARGET.M_TIMEID_VERIF = SOURCE.M_TIMEID_VERIF&#xA;,TARGET.FECHA_RECOLECCION_VERIF = SOURCE.FECHA_RECOLECCION_VERIF&#x