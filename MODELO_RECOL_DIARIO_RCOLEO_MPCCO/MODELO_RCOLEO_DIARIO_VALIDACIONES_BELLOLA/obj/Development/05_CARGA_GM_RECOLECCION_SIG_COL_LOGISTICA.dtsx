                        <externalMetadataColumn
                          refId="Package\CARGA SOLICITUD RECOLECCION\Extraer GM Recoleccion\OLE DB Destination.Inputs[OLE DB Destination Input].ExternalColumns[FECHA_CREACION_SOLICITUD]"
                          dataType="dbTimeStamp"
                          name="FECHA_CREACION_SOLICITUD" />
