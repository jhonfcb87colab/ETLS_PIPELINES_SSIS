            <component
              refId="Package\EXTRAER GM_RECOLECCION\OLE DB Source"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
              description="OLE DB Source"
              name="OLE DB Source"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">WITH CTE AS(
SELECT 
	 CONVERT(INT,CONVERT(NUMERIC,CONVERT(DATETIME,CONVERT(CHAR(11),S_ID_FECHA_RECOLECCION)))) AS S_TIME_ID
	,CASE WHEN (S_ID_TIPO_ZONA_URBA = -888 OR S_ID_ZONA_URBA = -888) THEN
		CONVERT(VARCHAR(37),'-888')
	 ELSE
		CONVERT(VARCHAR(37),CONVERT(VARCHAR,S_ID_CIUDAD_ZONA_URBA) + '-'+ CONVERT(VARCHAR,S_ID_TIPO_ZONA_URBA) + '-' +  CONVERT(VARCHAR,S_ID_ZONA_URBA)) 
	 END S_ID_GEOGRAFIA
	 ,S_ID_CIUDAD_ZONA_URBA
	 ,S_ID_TIEMPO_ENTREGAR S_ID_TIEMPO_ENTREGA
	 ,CASE WHEN S_ID_PRODUCTO = -888 OR S_ID_SUBPRODUCTO = -888
		THEN CONVERT(VARCHAR(6),'-888')
	 ELSE
		CONVERT(VARCHAR(6),CONVERT(VARCHAR,S_ID_PRODUCTO) + '-' + CONVERT(VARCHAR, S_ID_SUBPRODUCTO))
	 END S_ID_UEN_PROD_SUBPROD
	,CONVERT(INT,S_ID_MOTIVO_RECHAZO) S_ID_MOTIVO_RECHAZO	
	,S_ID_TIPO_SOLICITUD ID_TIPO_SOLICITUD
	,S_ID_CONFIRM_SOLICITUD ID_CONFIRM_SOLICITUD
	,CASE WHEN S_ID_CLIENTE = ' ' THEN '-888' ELSE S_ID_CLIENTE END S_ID_CLIENTE  	
	,S_NUMERO_SOLICITUD
	,GM_MARCA
	,CODSER
	,ID_SUCURSAL
	,ID_DEPENDEN
FROM TMP.RCOLEO_GM_SOLICITUDRECOLECCION WITH (NOLOCK)
)
SELECT 
      CT.S_TIME_ID	 
	 ,CONVERT(VARCHAR(37),CASE WHEN ZU.CLAVE_DIMENSION IS NULL THEN CONVERT(VARCHAR,CT.S_ID_CIUDAD_ZONA_URBA) + '-'+ CONVERT(VARCHAR,'-888') + '-'+ CONVERT(VARCHAR,'-888') ELSE  CT.S_ID_GEOGRAFIA END) S_ID_GEOGRAFIA	  	 
	 ,CT.S_ID_TIEMPO_ENTREGA
	 ,CT.S_ID_UEN_PROD_SUBPROD
	 ,CT.S_ID_MOTIVO_RECHAZO
	 ,CT.ID_TIPO_SOLICITUD
	 ,CT.ID_CONFIRM_SOLICITUD
	 ,CT.S_ID_CLIENTE  	
	 ,CT.S_NUMERO_SOLICITUD 
	 ,CT.GM_MARCA
	 ,CT.CODSER
	 ,CT.ID_SUCURSAL
	 ,CT.ID_DEPENDEN
from SIG_LOGISTICA_DM.DIM.CIUDADES_ZONA_URBA ZU WITH (NOLOCK)
RIGHT JOIN CTE CT ON CT.S_ID_GEOGRAFIA = ZU.CLAVE_DIMENSION</property>
                <property
                  dataType="System.String"
                  description="The variable that contains the SQL command to be executed."
                  name="SqlCommandVariable"></property>
                <property
                  dataType="System.Int32"
                  description="Specifies the column code page to use when code page information is unavailable from the data source."
                  name="DefaultCodePage">1252</property>
