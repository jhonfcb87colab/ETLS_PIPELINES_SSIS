          SQLTask:SqlStatementSource="--Truncar Tablas&#xA;TRUNCATE TABLE [TMP].[RCOLEO_GM_SOLICITUDRECOLECCION]&#xA;TRUNCATE TABLE [TMP].[RCOLEO_GM_SOLICITUDRECOLECCION_01]&#xA;TRUNCATE TABLE [TMP].[RCOLEO_GM_SOLICITUDRECOLECCION_GETP]&#xA;TRUNCATE TABLE [TMP].[RCOLEO_GM_SOLICITUDRECOLECCION_SE]&#xA;TRUNCATE TABLE [TMP].[RCOLEO_GM_SOLICITUDRECOLECCION_SE_BARR]&#xA;TRUNCATE TABLE [TMP].[RCOLEO_GM_SOLICITUDRECOLECCION_SE_BOGO]&#xA;TRUNCATE TABLE [TMP].[RCOLEO_GM_SOLICITUDRECOLECCION_SE_DG]&#xA;TRUNCATE TABLE [TMP].[RCOLEO_GM_SOLICITUDRECOLECCION_SE_MEDE]&#xA;TRUNCATE TABLE [TMP].[RCOLEO_GM_SOLICITUDRECOLECCION_SE_NEIV]&#xA;TRUNCATE TABLE [TMP].[RCOLEO_GM_SOLICITUDRECOLECCION_SE_UNIR]&#xA;TRUNCATE TABLE [TMP].[RCOLEO_GM_SOLICITUDRECOLECCION_SE_EZU]&#xA;TRUNCATE TABLE [TMP].[RCOLEO_GM_SOLICITUDRECOLECCION_G]&#xA;TRUNCATE TABLE [TMP].[RCOLEO_GM_SOLICITUDRECOLECCION_DHABIL_NO_D]&#xA;TRUNCATE TABLE [TMP].[RCOLEO_GM_SOLICITUDRECOLECCION_GUIAS]&#xA;--Actualizar Estadisticas&#xA;UPDATE STATISTICS [TMP].[RCOLEO_GM_SOLICITUDRECOLECCION]&#xA;UPDATE STATISTICS [TMP].[RCOLEO_GM_SOLICITUDRECOLECCION_01]&#xA;UPDATE STATISTICS [TMP].[RCOLEO_GM_SOLICITUDRECOLECCION_GETP]&#xA;UPDATE STATISTICS [TMP].[RCOLEO_GM_SOLICITUDRECOLECCION_SE]&#xA;UPDATE STATISTICS [TMP].[RCOLEO_GM_SOLICITUDRECOLECCION_SE_BARR]&#xA;UPDATE STATISTICS [TMP].[RCOLEO_GM_SOLICITUDRECOLECCION_SE_BOGO]&#xA;UPDATE STATISTICS [TMP].[RCOLEO_GM_SOLICITUDRECOLECCION_SE_BUCA]&#xA;UPDATE STATISTICS [TMP].[RCOLEO_GM_SOLICITUDRECOLECCION_SE_DG]&#xA;UPDATE STATISTICS [TMP].[RCOLEO_GM_SOLICITUDRECOLECCION_SE_MEDE]&#xA;UPDATE STATISTICS [TMP].[RCOLEO_GM_SOLICITUDRECOLECCION_SE_NEIV]&#xA;UPDATE STATISTICS [TMP].[RCOLEO_GM_SOLICITUDRECOLECCION_SE_UNIR]&#xA;UPDATE STATISTICS [TMP].[RCOLEO_GM_SOLICITUDRECOLECCION_SE_EZU]&#xA;UPDATE STATISTICS [TMP].[RCOLEO_GM_SOLICITUDRECOLECCION_G]&#xA;UPDATE STATISTICS [TMP].[RCOLEO_GM_SOLICITUDRECOLECCION_DHABIL_NO_D]&#xA;UPDATE STATISTICS [TMP].[RCOLEO_GM_SOLICITUDRECOLECCION_GUIAS]" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
