      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{680D323D-BE30-458E-A7C7-26A5BA37EE6B}"
          SQLTask:SqlStatementSource="WITH CTE&#xA;(&#xA;&#x9; G_NUMERO_GUIA&#xA;&#x9;,ID_PROCESO&#xA;)&#xA;AS&#xA;(&#xA;SELECT &#xA;&#x9;A.G_NUMERO_GUIA,&#xA;&#x9;B.ID_PROCESO&#xA;FROM &#xA;&#x9;[TMP].[RCOLEO_GM_SOLICITUDRECOLECCION_G] A  WITH (NOLOCK)&#xA;INNER JOIN &#xA;&#x9;[TMP].[RCOLEO_GM_SOLICITUDRECOLECCION_SE] B WITH (NOLOCK)&#xA;ON &#xA;&#x9;A.SE_ID_ULTI = B.ID&#xA;)&#xA;UPDATE&#xA;&#x9;[TMP].[RCOLEO_GM_SOLICITUDRECOLECCION_GUIAS]&#xA;SET &#xA;&#x9;ID_PROCESO = CTE.ID_PROCESO&#xA;FROM &#xA;&#x9;[TMP].[RCOLEO_GM_SOLICITUDRECOLECCION_GUIAS] A WITH (NOLOCK), CTE&#xA;WHERE &#xA;&#x9;A.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
