      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{680D323D-BE30-458E-A7C7-26A5BA37EE6B}"
          SQLTask:SqlStatementSource="WITH CTE&#xA;(&#xA;&#x9; G_NUMERO_GUIA&#xA;&#x9;,SE_ID_FECHA_RR&#xA;&#xA;)&#xA;AS&#xA;(&#xA;&#x9;SELECT &#xA;&#x9;&#x9; NUMERO_GUIA G_NUMERO_GUIA&#xA;&#x9;&#x9;,ISNULL(MIN(CASE WHEN ID_PROCESO = 28 THEN FECHA_HORA_MOVIMIENTO ELSE NULL END ),'1900-01-01') SE_ID_FECHA_RR&#xA;&#x9;FROM &#xA;&#x9;&#x9;[TMP] .[RCOLEO_GM_SOLICITUDRECOLECCION_SE] WITH(NOLOCK)&#xA;&#x9;GROUP BY &#xA;&#x9;&#x9;NUMERO_GUIA&#xA;)&#xA;UPDATE &#xA;&#x9;[TMP].[RCOLEO_GM_SOLICITUDRECOLECCION_GUIAS]&#xA;SET&#xA;&#x9;FECHA_HORA_RECOLECCION_RR = CTE.SE_ID_FECHA_RR&#xA;FROM&#xA;&#x9;TMP.RCOLEO_GM_SOLICITUDRECOLECCION_GUIAS TMP, CTE&#xA;WHERE&#xA;&#x9;TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
