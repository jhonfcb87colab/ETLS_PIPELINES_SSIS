      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{680D323D-BE30-458E-A7C7-26A5BA37EE6B}"
          SQLTask:SqlStatementSource="WITH CTE&#xA;(&#xA;&#x9;G_NUMERO_GUIA,&#xA;&#x9;FECHA_HORA_EZU&#xA;)&#xA;AS&#xA;&#x9;(&#xA;&#x9;&#x9;SELECT &#xA;&#x9;&#x9;&#x9;A.G_NUMERO_GUIA,&#xA;&#x9;&#x9;&#x9;B.FECHA_HORA_EZU&#xA;&#x9;&#x9;FROM &#xA;&#x9;&#x9;&#x9;TMP.RCOLEO_GM_SOLICITUDRECOLECCION_GUIAS A WITH (NOLOCK)&#xA;&#x9;&#x9;INNER JOIN &#xA;&#x9;&#x9;&#x9;TMP.RCOLEO_GM_SOLICITUDRECOLECCION_SE_EZU  B WITH (NOLOCK)&#xA;&#x9;&#x9;ON &#xA;&#x9;&#x9;&#x9;A.S_NUMERO_SOLICITUD = B.NUMERO_SOLICITUD&#xA;&#x9;)&#xA;UPDATE TMP.RCOLEO_GM_SOLICITUDRECOLECCION_GUIAS&#xA;SET&#xA;&#x9;FECHA_HORA_EZU = CTE.FECHA_HORA_EZU&#xA;FROM &#xA;&#x9;TMP.RCOLEO_GM_SOLICITUDRECOLECCION_GUIAS A WITH (NOLOCK), CTE&#xA;WHERE &#xA;&#x9;A.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
