        <SQLTask:SqlTaskData
          SQLTask:Connection="{680D323D-BE30-458E-A7C7-26A5BA37EE6B}"
          SQLTask:SqlStatementSource="WITH CTE&#xA;(&#xA;&#x9; NUMERO_SOLICITUD&#xA;&#x9;,NUMERO_GUIA&#xA;&#x9;,FECHA_HORA_EZU&#xA;)&#xA;AS&#xA;&#x9;(&#xA;&#x9;&#x9;SELECT  &#xA;&#x9;&#x9;&#x9;B.NUMERO_SOLICITUD_RECOLECCION AS NUMERO_SOLICITUD,&#xA;&#x9;&#x9;&#x9;A.NUMERO_GUIA,&#xA;&#x9;&#x9;&#x9;A.FECHA_HORA_MOVIMIENTO AS FECHA_HORA_EZU&#xA;&#x9;&#x9;FROM &#xA;&#x9;&#x9;&#x9;[TMP].[RCOLEO_GM_SOLICITUDRECOLECCION_SE] A WITH (NOLOCK)&#xA;&#x9;&#x9;INNER  JOIN &#xA;&#x9;&#x9;&#x9;[GM].[RCOLEO_GUIAS_POR_SOLICITUDRECOLECCION] B WITH (NOLOCK)&#xA;&#x9;&#x9;ON&#xA;&#x9;&#x9;&#x9;A.NUMERO_GUIA = B.NUMERO_GUIA&#xA;&#x9;&#x9;WHERE&#xA;&#x9;&#x9;&#x9;A.NUMERO_GUIA NOT IN (SELECT G.NUMERO_GUIA FROM [TMP].[GM_SOLICITUDRECOLECCION_GETP] G WITH (NOLOCK))&#xA;&#x9;&#x9;AND &#xA;&#x9;&#x9;&#x9;A.ID_PROCESO IN (5,6)&#xA;&#x9;)&#xA;INSERT INTO &#xA;&#x9;[TMP].[RCOLEO_GM_SOLICITUDRECOLECCION_SE_EZU]&#xA;(&#xA;&#x9; NUMERO_SOLICITUD&#xA;&#x9;,NUMERO_GUIA&#xA;&#x9;,FECHA_HORA_EZU&#xA;)&#xA;SELECT&#xA;&#x9; NUMERO_SOLICITUD&#xA;&#x9;,NUMERO_GUIA&#xA;&#x9;,FECHA_HORA_EZU&#xA;FROM &#xA;&#x9;CTE" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Paso 09 Obtener Ultimo Movimiento"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{2C30DEB9-5EE4-43F3-8A89-D97605596822}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Paso 09 Obtener Ultimo Movimiento"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{680D323D-BE30-458E-A7C7-26A5BA37EE6B}"
          SQLTask:SqlStatementSource="WITH CTE&#xA;(&#xA;&#x9; G_NUMERO_GUIA&#xA;&#x9;,SE_ID_ULTI&#xA;)&#xA;AS&#xA;(&#xA;&#x9;SELECT &#xA;&#x9;&#x9; NUMERO_GUIA G_NUMERO_GUIA&#xA;&#x9;&#x9;,ISNULL(MAX(ID),-888) SE_ID_ULTI&#xA;&#x9;FROM &#xA;&#x9;&#x9;[TMP].[RCOLEO_GM_SOLICITUDRECOLECCION_SE] WITH(NOLOCK)&#xA;&#x9;GROUP BY &#xA;&#x9;&#x9;NUMERO_GUIA&#xA;)&#xA;INSERT INTO &#xA;&#x9;[TMP].[RCOLEO_GM_SOLICITUDRECOLECCION_G]&#xA;(&#xA;&#x9; G_NUMERO_GUIA&#xA;&#x9;,SE_ID_ULTI&#xA;)&#xA;SELECT &#xA;&#x9; G_NUMERO_GUIA&#xA;&#x9;,SE_ID_ULTI&#xA;FROM &#xA;&#x9;CTE" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Paso 10 Actualizar recoleccion"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{3c6efb92-02a4-4333-af3e-471053fc482d}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Paso 10 Actualizar recoleccion"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{680D323D-BE30-458E-A7C7-26A5BA37EE6B}"
          SQLTask:SqlStatementSource="UPDATE &#xA;&#x9;A    &#xA;SET &#xA;&#x9;A.ID_ESTADO_ASIGNADA = 'SI'&#xA;FROM &#xA;&#x9;TMP.RCOLEO_GM_SOLICITUDRECOLECCION A WITH (NOLOCK)&#xA;INNER JOIN  &#xA;&#x9;GM.RCOLEO_GUIAS_POR_SOLICITUDRECOLECCION B WITH (NOLOCK)&#xA;ON &#xA;&#x9;A.S_NUMERO_SOLICITUD = B.NUMERO_SOLICITUD_RECOLECCION" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Paso 11 Actualizar recoleccion GETP"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{D7CDE6EE-E86D-4FCF-BAFA-A150B08C9484}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Paso 11 Actualizar recoleccion GETP"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{680D323D-BE30-458E-A7C7-26A5BA37EE6B}"
          SQLTask:SqlStatementSource="UPDATE &#xA;&#x9;A    &#xA;SET &#xA;&#x9; A.ID_ESTADO_ASIGNADA_EZU = 'SI'&#xA;&#x9;,A.FECHA_HORA_EZU = B.FECHA_HORA_EZU&#xA;FROM &#xA;&#x9;TMP.RCOLEO_GM_SOLICITUDRECOLECCION A WITH (NOLOCK)&#xA;INNER JOIN  &#xA;&#x9;TMP.RCOLEO_GM_SOLICITUDRECOLECCION_GETP B WITH (NOLOCK)&#xA;ON &#xA;&#x9;A.S_NUMERO_SOLICITUD = B.NUMERO_SOLICITUD&#xA;GO&#xA;&#xA;UPDATE &#xA;&#x9;A    &#xA;SET &#xA;&#x9; A.FECHA_HORA_EZU = B.FECHA_HORA_EZU&#xA;&#x9;,A.ID_ESTADO_ASIGNADA_EZU_HOY = 'SI'&#xA;FROM &#xA;&#x9;TMP.RCOLEO_GM_SOLICITUDRECOLECCION A WITH (NOLOCK)&#xA;INNER JOIN  &#xA;&#x9;TMP.RCOLEO_GM_SOLICITUDRECOLECCION_GETP B WITH (NOLOCK)&#xA;ON &#xA;&#x9;A.S_NUMERO_SOLICITUD = B.NUMERO_SOLICITUD&#xA;WHERE&#xA;&#x9;CASE WHEN CONVERT(DATE,B.FECHA_HORA_EZU) = CONVERT(DATE,A.FECHA_HORA_RECOLECCION_VERIF) THEN 'SI' ELSE 'NO' END = 'SI'" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Paso 12 Actualizar recoleccion SE"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{89211ed8-86eb-482a-b10a-2453d1fff0fc}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Paso 12 Actualizar recoleccion SE"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{680D323D-BE30-458E-A7C7-26A5BA37EE6B}"
          SQLTask:SqlStatementSource="UPDATE &#xA;&#x9;A    &#xA;SET &#xA;&#x9;A.ID_ESTADO_ASIGNADA_EZU = 'SI',&#xA;&#x9;A.FECHA_HORA_EZU = B.FECHA_HORA_EZU&#xA;FROM &#xA;&#x9;TMP.RCOLEO_GM_SOLICITUDRECOLECCION A WITH (NOLOCK)&#xA;INNER JOIN  &#xA;&#x9;TMP.RCOLEO_GM_SOLICITUDRECOLECCION_SE_EZU B WITH (NOLOCK)&#xA;ON &#xA;&#x9;A.S_NUMERO_SOLICITUD = B.NUMERO_SOLICITUD&#xA;GO&#xA;&#xA;UPDATE &#xA;&#x9;A    &#xA;SET&#xA;&#x9;A.FECHA_HORA_EZU = B.FECHA_HORA_EZU,      &#xA;&#x9;A.ID_ESTADO_ASIGNADA_EZU_HOY = 'SI'&#xA;FROM &#xA;&#x9;TMP.RCOLEO_GM_SOLICITUDRECOLECCION A WITH (NOLOCK)&#xA;INNER JOIN  &#xA;&#x9;TMP.RCOLEO_GM_SOLICITUDRECOLECCION_SE_EZU B WITH (NOLOCK)&#xA;ON &#xA;&#x9;A.S_NUMERO_SOLICITUD = B.NUMERO_SOLICITUD&#xA;WHERE&#xA;&#x9;CASE WHEN CONVERT(DATE,B.FECHA_HORA_EZU) = CONVERT(DATE,A.FECHA_HORA_RECOLECCION_VERIF) THEN 'SI' ELSE 'NO' END = 'SI'&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Paso 13 GM DHABIL NO D"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{610881A1-045F-4FC7-A605-1F89FB47D470}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Paso 13 GM DHABIL NO D"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{680D323D-BE30-458E-A7C7-26A5BA37EE6B}"
          SQLTask:SqlStatementSource="WITH CTE &#xA;(&#xA;&#x9; ID_DIA_HABIL&#xA;&#x9;,TIME_ID&#xA;&#x9;,FECHA&#xA;)&#xA;AS &#xA;(&#xA;SELECT&#xA;&#x9; ROW_NUMBER() OVER(ORDER BY T.TIME_ID) ID_DIA_HABIL&#xA;&#x9;,T.TIME_ID&#xA;&#x9;,[DATE] AS FECHA&#xA;FROM &#xA;&#x9;[DIM].[TIEMPO] T WITH (NOLOCK)&#xA;LEFT JOIN&#xA;&#x9; [SIG_COLOMBIA_DW].PAR.FESTIVOSNACIONALES F WITH (NOLOCK)&#xA;ON&#xA;&#x9;T.[DATE] = F.[FECHA_FESTIVA]&#xA;WHERE&#xA;&#x9;CASE WHEN T.[DAY] = 'Domingo' THEN 1 ELSE CASE WHEN F.FECHA_FESTIVA IS NOT NULL THEN 1 ELSE 0 END END = 0&#xA;)&#xA;INSERT INTO &#xA;&#x9;[TMP].[RCOLEO_GM_SOLICITUDRECOLECCION_DHABIL_NO_D]&#xA;(&#xA;&#x9; ID_DIA_HABIL&#xA;&#x9;,TIME_ID&#xA;&#x9;,FECHA&#xA;)&#xA;SELECT &#xA;&#x9; ID_DIA_HABIL&#xA;&#x9;,TIME_ID&#xA;&#x9;,FECHA&#xA;FROM &#xA;&#x9;CTE" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Paso 14 Actualizar Fecha Val"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{C1033CEC-A1FE-400A-87A9-AA1EE35CDBA5}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Paso 14 Actualizar Fecha Val"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{680D323D-BE30-458E-A7C7-26A5BA37EE6B}"
          SQLTask:SqlStatementSource="WITH CTE &#xA;(&#xA;&#x9; ID&#xA;&#x9;,S_NUMERO_SOLICITUD&#xA;&#x9;,FECHA_RECOLECCION&#xA;&#x9;,FECHA_VALIDACION&#xA;)&#xA;AS&#xA;&#x9;(&#xA;&#x9;SELECT &#xA;&#x9;&#x9; ROW_NUMBER() OVER(PARTITION BY S_NUMERO_SOLICITUD ORDER BY FECHA DESC) ID&#xA;&#x9;&#x9;,S_NUMERO_SOLICITUD&#xA;&#x9;&#x9;,FECHA_VALOR FECHA_RECOLECCION&#xA;&#x9;&#x9;,FECHA FECHA_VALIDACION&#xA;&#x9;FROM&#xA;&#x9;&#x9;(&#xA;&#x9;&#x9;&#x9;SELECT &#xA;&#x9;&#x9;&#x9;&#x9; S_NUMERO_SOLICITUD&#xA;&#x9;&#x9;&#x9;&#x9;,FECHA_HORA_RECOLECCION_CANCEL&#xA;&#x9;&#x9;&#x9;&#x9;,FECHA_HORA_RECOLECCION_VERIF&#xA;&#x9;&#x9;&#x9;FROM&#xA;&#x9;&#x9;&#x9;&#x9;TMP.RCOLEO_GM_SOLICITUDRECOLECCION WITH (NOLOCK)&#xA;&#x9;&#x9;)T&#xA;&#x9;&#x9;&#x9;UNPIVOT &#xA;&#x9;&#x9;&#x9;&#x9;(&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;FECHA FOR FECHA_VALOR IN&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;(&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9; FECHA_HORA_RECOLECCION_CANCEL&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;,FECHA_HORA_RECOLECCION_VERIF&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;)&#xA;&#x9;&#x9;&#x9;&#x9;)AS UNPVT&#xA;&#x9;WHERE &#xA;&#x9;&#x9;FECHA &lt;&gt; '1900-01-01'&#xA;)&#xA;UPDATE &#xA;&#x9;TMP.RCOLEO_GM_SOLICITUDRECOLECCION&#xA;SET&#xA;&#x9;FECHA_VAL = B.FECHA_VALIDACION&#xA;FROM &#xA;&#x9;TMP.RCOLEO_GM_SOLICITUDRECOLECCION A WITH (NOLOCK)&#xA;INNER JOIN &#xA;&#x9;CTE B&#xA;ON&#xA;&#x9;A.S_NUMERO_SOLICITUD = B.S_NUMERO_SOLICITUD&#xA;WHERE &#xA;&#x9;B.ID = 1 " xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Paso 15 Calcular Dia Habil RE"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{5976F509-90A7-4B51-A3E7-DA13F5AE8013}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Paso 15 Calcular Dia Habil RE"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{680D323D-BE30-458E-A7C7-26A5BA37EE6B}"
          SQLTask:SqlStatementSource="WITH CTE&#xA;(&#xA;&#x9; S_NUMERO_SOLICITUD&#xA;&#x9;,ID_DIA_HABIL&#xA;)&#xA;AS&#xA;(&#xA;SELECT &#xA;&#x9; A.S_NUMERO_SOLICITUD&#xA;&#x9;,B.ID_DIA_HABIL&#xA;FROM &#xA;&#x9;TMP.RCOLEO_GM_SOLICITUDRECOLECCION A WITH (NOLOCK)&#xA;INNER JOIN &#xA;&#x9;TMP.RCOLEO_GM_SOLICITUDRECOLECCION_DHABIL_NO_D B WITH (NOLOCK)&#xA;ON &#xA;&#x9;CONVERT(DATE,A.S_ID_FECHA_RECOLECCION) = B.FECHA&#xA;)&#xA;UPDATE [TMP].[RCOLEO_GM_SOLICITUDRECOLECCION]&#xA;SET&#xA;&#x9; ID_DIA_HABIL_RE = CTE.ID_DIA_HABIL&#xA;FROM&#xA;&#x9;TMP.RCOLEO_GM_SOLICITUDRECOLECCION TMP, CTE&#xA;WHERE&#xA;&#x9;TMP.S_NUMERO_SOLICITUD = CTE.S_NUMERO_SOLICITUD&#xA;GO&#xA;&#xA;WITH CTE&#xA;(&#xA;&#x9; S_NUMERO_SOLICITUD&#xA;&#x9;,ID_DIA_HABIL&#xA;)&#xA;AS&#xA;(&#xA;&#x9;SELECT &#xA;&#x9;&#x9; C.S_NUMERO_SOLICITUD &#xA;&#x9;&#x9;,(SELECT TOP 1 ID_DIA_HABIL FROM TMP.RCOLEO_GM_SOLICITUDRECOLECCION_DHABIL_NO_D F WITH(NOLOCK) WHERE F.FECHA &gt;= CONVERT(DATE,C.S_ID_FECHA_RECOLECCION)) ID_DIA_HABIL&#xA;&#x9;FROM&#xA;&#x9;&#x9;TMP.RCOLEO_GM_SOLICITUDRECOLECCION C WITH(NOLOCK)&#xA;&#x9;WHERE&#xA;&#x9;&#x9;ID_DIA_HABIL_RE = 0&#xA;)&#xA;UPDATE &#xA;&#x9;[TMP].[RCOLEO_GM_SOLICITUDRECOLECCION]&#xA;SET&#xA;&#x9; ID_DIA_HABIL_RE = CTE.ID_DIA_HABIL&#xA;FROM&#xA;&#x9;TMP.RCOLEO_GM_SOLICITUDRECOLECCION TMP, CTE&#xA;WHERE&#xA;&#x9;TMP.S_NUMERO_SOLICITUD = CTE.S_NUMERO_SOLICITUD" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Paso 16 Calcular Dia Habil VAL"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{10ca220c-407f-4318-a754-eb2aa7cd7813}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Paso 16 Calcular Dia Habil VAL"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{680D323D-BE30-458E-A7C7-26A5BA37EE6B}"
          SQLTask:SqlStatementSource="WITH CTE&#xA;(&#xA;&#x9; S_NUMERO_SOLICITUD&#xA;&#x9;,ID_DIA_HABIL&#xA;)&#xA;AS&#xA;(&#xA;SELECT &#xA;&#x9; A.S_NUMERO_SOLICITUD&#xA;&#x9;,B.ID_DIA_HABIL&#xA;FROM &#xA;&#x9;TMP.RCOLEO_GM_SOLICITUDRECOLECCION A WITH (NOLOCK)&#xA;INNER JOIN &#xA;&#x9;TMP.RCOLEO_GM_SOLICITUDRECOLECCION_DHABIL_NO_D B WITH (NOLOCK)&#xA;ON &#xA;&#x9;CONVERT(DATE,A.FECHA_VAL) = B.FECHA&#xA;)&#xA;UPDATE [TMP].[RCOLEO_GM_SOLICITUDRECOLECCION]&#xA;SET&#xA;&#x9; ID_DIA_HABIL_VAL = CTE.ID_DIA_HABIL&#xA;FROM&#xA;&#x9;TMP.RCOLEO_GM_SOLICITUDRECOLECCION TMP, CTE&#xA;WHERE&#xA;&#x9;TMP.S_NUMERO_SOLICITUD = CTE.S_NUMERO_SOLICITUD&#xA;GO&#xA;&#xA;WITH CTE&#xA;(&#xA;&#x9; S_NUMERO_SOLICITUD&#xA;&#x9;,ID_DIA_HABIL&#xA;)&#xA;AS&#xA;(&#xA;&#x9;SELECT &#xA;&#x9;&#x9; C.S_NUMERO_SOLICITUD &#xA;&#x9;&#x9;,(SELECT TOP 1 ID_DIA_HABIL FROM TMP.RCOLEO_GM_SOLICITUDRECOLECCION_DHABIL_NO_D F WITH(NOLOCK) WHERE F.FECHA &gt;= CONVERT(DATE,C.FECHA_VAL)) ID_DIA_HABIL&#xA;&#x9;FROM&#xA;&#x9;&#x9;TMP.RCOLEO_GM_SOLICITUDRECOLECCION C WITH(NOLOCK)&#xA;&#x9;WHERE&#xA;&#x9;&#x9;ID_DIA_HABIL_VAL = 0&#xA;)&#xA;UPDATE &#xA;&#x9;[TMP].[RCOLEO_GM_SOLICITUDRECOLECCION]&#xA;SET&#xA;&#x9; ID_DIA_HABIL_VAL = CTE.ID_DIA_HABIL&#xA;FROM&#xA;&#x9;TMP.RCOLEO_GM_SOLICITUDRECOLECCION TMP, CTE&#xA;WHERE&#xA;&#x9;TMP.S_NUMERO_SOLICITUD = CTE.S_NUMERO_SOLICITUD" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Paso 17 Calcular Rango Vejez"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{3CA7ED3F-C210-4241-AE8F-1F2E351F56F8}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Paso 17 Calcular Rango Vejez"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{680D323D-BE30-458E-A7C7-26A5BA37EE6B}"
          SQLTask:SqlStatementSource="WITH CTE &#xA;(&#xA;&#x9; S_NUMERO_SOLICITUD&#xA;&#x9;,DH&#xA;)&#xA;AS&#xA;&#x9;(&#xA;&#x9;&#x9;SELECT &#xA;&#x9;&#x9;&#x9;S_NUMERO_SOLICITUD,&#xA;&#x9;&#x9;&#x9;ID_DIA_HABIL_VAL - ID_DIA_HABIL_RE AS DH&#xA;&#x9;&#x9;FROM &#xA;&#x9;&#x9;&#x9;[TMP].[RCOLEO_GM_SOLICITUDRECOLECCION] WITH (NOLOCK)&#xA;&#x9;)&#xA;UPDATE&#xA;&#x9;[TMP].[RCOLEO_GM_SOLICITUDRECOLECCION]&#xA;SET&#xA;&#x9;ID_ESTADO_VEJEZ = CASE WHEN S_ID_CONFIRM_SOLICITUD IN (4,5) THEN 'NO' ELSE 'SI' END, &#xA;&#x9;--A.FECHA_HORA_RECOLECCION_VERIF &lt;&gt; '1900-01-01' OR  A.FECHA_HORA_RECOLECCION_CANCEL &lt;&gt; '1900-01-01' THEN 'NO' ELSE 'SI' END,&#xA;&#x9;ID_RANGO_VEJEZ = CASE WHEN CTE.DH &lt; 0 THEN -888 &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  WHEN CTE.DH = 0 THEN 0 &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  WHEN CTE.DH = 1 THEN 1&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  WHEN CTE.DH &gt;= 2 AND CTE.DH &lt;= 3 THEN 2&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  WHEN CTE.DH &gt;= 4 AND CTE.DH &lt;= 5 THEN 3&#xA;&#x9;&#x9;&#x9;&#x9;&#x9; ELSE 4 END,&#xA;&#x9;DIAS_NOVEDAD = CASE WHEN CTE.DH &lt; 0 THEN 0 ELSE CTE.DH END&#xA;FROM &#xA;&#x9;[TMP].[RCOLEO_GM_SOLICITUDRECOLECCION] A WITH (NOLOCK), CTE&#xA;WHERE&#xA;&#x9;A.S_NUMERO_SOLICITUD = CTE.S_NUMERO_SOLICITUD" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Paso 18 Obtener Evidencia Fotografica"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{f9494a6b-29d2-41d3-b568-16f16d12c3c1}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Paso 18 Obtener Evidencia Fotografica"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{680D323D-BE30-458E-A7C7-26A5BA37EE6B}"
          SQLTask:SqlStatementSource="WITH CTE&#xA;(&#xA;&#x9; S_NUMERO_SOLICITUD&#xA;&#x9;,LOGIN_CREACION&#xA;&#x9;,EVIDENCIA_FOTOGRAFICA&#xA;&#x9;&#xA;)&#xA;AS&#xA;&#x9;(&#xA;&#x9;&#x9;SELECT &#xA;&#x9;&#x9;&#x9; S.S_NUMERO_SOLICITUD&#xA;&#x9;&#x9;&#x9;,R.LOGIN_CREACION  &#xA;&#x9;&#x9;&#x9;,CASE WHEN R.RUTA_IMAGEN_FOTO IS NULL THEN 'NO'&#xA;&#x9;&#x9;&#x9;&#x9;WHEN R.RUTA_IMAGEN_FOTO = '' THEN 'NO'&#xA;&#x9;&#x9;&#x9;&#x9;ELSE 'SI' &#xA;&#x9;&#x9;&#x9; END EVIDENCIA_FOTOGRAFICA&#xA;&#x9;&#x9;&#x9; &#xA;&#x9;&#x9;FROM &#xA;&#x9;&#x9;&#x9;TMP.RCOLEO_GM_SOLICITUDRECOLECCION  S WITH (NOLOCK)&#xA;&#x9;&#x9;LEFT JOIN&#xA;&#x9;&#x9;&#x9;GM.RCOLEO_SOLICITUDRECOLECCION_DETALLE_RECOGIDO R WITH (NOLOCK)&#xA;&#x9;&#x9;ON&#xA;&#x9;&#x9;&#x9;S.S_NUMERO_SOLICITUD = R.NUMERO_SOLICITUD&#xA;&#x9;) &#xA;UPDATE &#xA;&#x9;A    &#xA;SET &#xA;&#x9; A.LOGIN_CREACION = ISNULL(B.LOGIN_CREACION,'-888')&#xA;&#x9;,A.EVIDENCIA_FOTOGRAFICA = B.EVIDENCIA_FOTOGRAFICA&#xA;&#x9;&#xA;FROM &#xA;&#x9;TMP.RCOLEO_GM_SOLICITUDRECOLECCION A WITH (NOLOCK)&#xA;INNER JOIN  &#xA;&#x9;CTE B WITH (NOLOCK)&#xA;ON &#xA;&#x9;A.S_NUMERO_SOLICITUD = B.S_NUMERO_SOLICITUD" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Paso 19 Actualizar Usuario Creacion"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{CC888A80-2A3D-486D-AFD7-4E4C8EFBA7B4}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Paso 19 Actualizar Usuario Creacion"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{680D323D-BE30-458E-A7C7-26A5BA37EE6B}"
          SQLTask:SqlStatementSource="WITH CTE&#xA;(&#xA;&#x9; S_NUMERO_SOLICITUD&#xA;&#x9;,LOGIN_CREACION&#xA;&#x9;,EMAIL_EMPLEADO&#xA;)&#xA;AS&#xA;&#x9;(&#xA;&#x9;&#x9;SELECT &#xA;&#x9;&#x9;&#x9; A.S_NUMERO_SOLICITUD&#xA;&#x9;&#x9;&#x9;,A.LOGIN_CREACION&#xA;&#x9;&#x9;&#x9;,B.EMAIL_EMPLEADO&#xA;&#x9;&#x9;FROM &#xA;&#x9;&#x9;&#x9;TMP.RCOLEO_GM_SOLICITUDRECOLECCION A WITH (NOLOCK)&#xA;&#x9;&#x9;INNER JOIN &#xA;&#x9;&#x9;&#x9; [SIG_COLOMBIA_DW].PAR.EMPLEADOS B WITH (NOLOCK)&#xA;&#x9;&#x9;ON&#xA;&#x9;&#x9;&#x9;A.LOGIN_CREACION COLLATE SQL_Latin1_General_CP850_CI_AI = B.ID_EMPLEADO&#xA;&#x9;)&#xA;UPDATE &#xA;&#x9;TMP.RCOLEO_GM_SOLICITUDRECOLECCION&#xA;SET &#xA;&#x9;EMAIL_CREACION = CASE WHEN CTE.EMAIL_EMPLEADO = '' THEN 'NO DISPONIBLE' ELSE ISNULL(CTE.EMAIL_EMPLEADO,'NO DISPONIBLE') END&#xA;FROM &#xA;&#x9;TMP.RCOLEO_GM_SOLICITUDRECOLECCION A WITH (NOLOCK), CTE&#xA;WHERE &#xA;&#x9;A.S_NUMERO_SOLICITUD = CTE.S_NUMERO_SOLICITUD" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Paso 20 Actualizar Observaciones GM"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{DB8B4DA1-B383-4449-9135-F95A979DCD9D}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Paso 20 Actualizar Observaciones GM"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{680D323D-BE30-458E-A7C7-26A5BA37EE6B}"
          SQLTask:SqlStatementSource="DROP TABLE TMP.RCOLEO_RECO_CTE &#xA;GO&#xA;WITH CTE(&#xA;&#x9; NUMERO_SOLICITUD&#xA;&#x9;,OBSERVACIONES_GM&#xA;)&#xA;AS &#xA;&#x9;(&#xA;&#x9;SELECT&#xA;&#x9;&#x9;NUMERO_SOLICITUD,&#xA;&#x9;&#x9;STUFF((&#xA;&#x9;&#x9;&#x9;SELECT&#xA;&#x9;&#x9;&#x9;&#x9;'| ' + CONVERT (VARCHAR,FECHA_MOVIMIENTO,121) + ' : ' +  [SIG_COL_LOGISTICA_DW].[dbo].[VALIDA_CARACTERS_MAX](ISNULL(REPLACE(OBSERVACION_SOLICITUD,'#','No'), ''), '-')&#xA;&#x9;&#x9;&#x9;FROM &#xA;&#x9;&#x9;&#x9;&#x9;GM.RCOLEO_MOVIMIENTO_SOLICITUD_RECOLECCION WITH (NOLOCK) &#xA;&#x9;&#x9;&#x9;WHERE &#xA;&#x9;&#x9;&#x9;&#x9;(NUMERO_SOLICITUD = MOV.NUMERO_SOLICITUD) &#xA;&#x9;&#x9;&#x9;FOR XML PATH(''),TYPE).value('(./text())[1]','NVARCHAR(MAX)')&#xA;&#x9;&#x9;&#x9;&#x9;,1,2,'') AS OBSERVACIONES_GM&#xA;&#x9;&#x9;&#x9;FROM &#xA;&#x9;&#x9;&#x9;&#x9;GM.RCOLEO_MOVIMIENTO_SOLICITUD_RECOLECCION MOV&#xA;&#x9;&#x9;&#x9;WHERE &#xA;&#x9;&#x9;&#x9;&#x9;ISNULL(OBSERVACION_SOLICITUD,'') &lt;&gt; ''&#xA;&#x9;&#x9;&#x9;GROUP BY NUMERO_SOLICITUD&#xA;&#x9;)&#xA;SELECT NUMERO_SOLICITUD, CONVERT(NVARCHAR(MAX),OBSERVACIONES_GM)as OBSERVACION_SOLICITUD &#xA;INTO TMP.RCOLEO_RECO_CTE &#xA;FROM CTE&#xA;&#xA;&#xA;&#xA;&#xA;UPDATE &#xA;&#x9;[TMP].[RCOLEO_GM_SOLICITUDRECOLECCION]&#xA;SET&#xA;&#x9;[OBSERVACIONES_GM] = CTE.OBSERVACION_SOLICITUD&#xA;FROM &#xA;&#x9;[TMP].[RCOLEO_GM_SOLICITUDRECOLECCION] TMP, TMP.RCOLEO_RECO_CTE cte&#xA;WHERE &#xA;&#x9;TMP.S_NUMERO_SOLICITUD = CTE.NUMERO_SOLICITUD &#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Paso 21 Insertar Recoleccion"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{63CE57C9-5E2C-413B-AD95-B3F3E91E2AA5}"
