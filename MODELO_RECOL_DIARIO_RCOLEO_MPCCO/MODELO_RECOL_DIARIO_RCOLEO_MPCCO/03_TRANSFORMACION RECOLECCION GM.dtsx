      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{680D323D-BE30-458E-A7C7-26A5BA37EE6B}"
          SQLTask:SqlStatementSource="WITH CTE&#xA;(&#xA;  G_NUMERO_GUIA&#xA; ,ID_PROCESO&#xA;)&#xA;AS&#xA;(&#xA;SELECT &#xA; A.G_NUMERO_GUIA,&#xA; B.ID_PROCESO&#xA;FROM &#xA; [TMP].[RCOLEO_GM_SOLICITUDRECOLECCION_G] A  WITH (NOLOCK)&#xA;INNER JOIN &#xA; [TMP].[RCOLEO_GM_SOLICITUDRECOLECCION_SE] B WITH (NOLOCK)&#xA;ON &#xA; A.SE_ID_ULTI = B.ID&#xA;)&#xA;UPDATE&#xA; [TMP].[RCOLEO_GM_SOLICITUDRECOLECCION_GUIAS]&#xA;SET &#xA; ID_PROCESO = CTE.ID_PROCESO&#xA;FROM &#xA; [TMP].[RCOLEO_GM_SOLICITUDRECOLECCION_GUIAS] A WITH (NOLOCK), CTE&#xA;WHERE &#xA; A.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Paso 28 Actualizar DIRECCION CLIENTE"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{f8b7e420-d433-47ad-9e95-1c2c628ef6a3}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Paso 28 Actualizar DIRECCION CLIENTE"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{680D323D-BE30-458E-A7C7-26A5BA37EE6B}"
          SQLTask:SqlStatementSource="WITH CTE AS (&#xA;    SELECT R.DIRECCION_RECOLECCION, S.S_NUMERO_SOLICITUD&#xA;    FROM [SIG_COLOMBIA_DW].[GM].[RCOLEO_SOLICITUDRECOLECCION] R WITH (NOLOCK)&#xA;    LEFT JOIN [SIG_COLOMBIA_DW].[TMP].[RCOLEO_GM_SOLICITUDRECOLECCION] S WITH (NOLOCK)&#xA;    ON R.NUMERO_SOLICITUD = S.S_NUMERO_SOLICITUD&#xA;)&#xA;&#xA;UPDATE S&#xA;SET S.DIRECCION_RECOLECCION = CTE.DIRECCION_RECOLECCION&#xA;FROM [SIG_COLOMBIA_DW].[TMP].[RCOLEO_GM_SOLICITUDRECOLECCION] S&#xA;INNER JOIN CTE ON S.S_NUMERO_SOLICITUD = CTE.S_NUMERO_SOLICITUD&#xA;WHERE CTE.DIRECCION_RECOLECCION IS NOT NULL;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Paso 29 Actualizar Días Vencidos"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{3cf593bb-4f5d-4556-99af-45c0ec139dac}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Paso 29 Actualizar Días Vencidos"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{680D323D-BE30-458E-A7C7-26A5BA37EE6B}"
          SQLTask:SqlStatementSource="USE SIG_COLOMBIA_DW;&#xA; &#xA;DROP TABLE IF EXISTS #CALCULO_VEJEZ_RECOLEO&#xA;SELECT &#xA;S_NUMERO_SOLICITUD AS NUMERO_SOLICITUD,&#xA;S_ID_CONFIRM_SOLICITUD AS ID_CONFIRM_SOLICITUD,&#xA;CONVERT(DATETIME,FECHA_RECOLECCION) AS FECHA_RECOLECCION_PROGRAMADA,&#xA;CONVERT(DATETIME,GETDATE()) AS FECHA_HOY&#xA;INTO #CALCULO_VEJEZ_RECOLEO&#xA;FROM TMP.RCOLEO_GM_SOLICITUDRECOLECCION WITH(NOLOCK)&#xA; &#xA;;WITH CTE AS(&#xA;SELECT &#xA;*,&#xA;DATEDIFF(DAY,FECHA_HOY,FECHA_RECOLECCION_PROGRAMADA) AS DIAS_VENCIODOS &#xA;FROM #CALCULO_VEJEZ_RECOLEO&#xA;)&#xA;--SELECT CT.*, &#xA;UPDATE RG SET&#xA;RG.VENCIMIENTO = IIF( CT.ID_CONFIRM_SOLICITUD=4,'CUMPLIDA',&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;CASE &#x9;&#x9;&#x9;&#x9; &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;                WHEN CT.DIAS_VENCIODOS &gt; 2 THEN 'MAYOR A 3 DIAS POR VENCERSE'&#xA;                                                                                                WHEN CT.DIAS_VENCIODOS = 2 THEN '2 DIAS PARA VENCERSE' &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN CT.DIAS_VENCIODOS = 1 THEN '1 DIA PARA VENCERSE'&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN CT.DIAS_VENCIODOS = 0  THEN 'VENCE HOY'&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9; WHEN CT.DIAS_VENCIODOS = -1 THEN '1 DIA DE VENCIDO'&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9; WHEN CT.DIAS_VENCIODOS = -2 THEN '2 DIAS DE VENCIDO'&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9; WHEN CT.DIAS_VENCIODOS &lt; -2 THEN 'MENOR A 3 DIAS DE VENCIDO'&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;ELSE 'NO DISPONIBLE' END&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;)&#xA;FROM CTE CT&#xA;INNER JOIN TMP.RCOLEO_GM_SOLICITUDRECOLECCION RG WITH(NOLOCK)&#xA;ON CT.NUMERO_SOLICITUD=RG.S_NUMERO_SOLICITUD&#xA;&#xA;&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
