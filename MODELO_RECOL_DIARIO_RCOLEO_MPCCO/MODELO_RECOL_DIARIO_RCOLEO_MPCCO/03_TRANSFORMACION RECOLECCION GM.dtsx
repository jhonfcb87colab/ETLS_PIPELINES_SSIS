    <DTS:Executable
      DTS:refId="Package\Bakup20260420 Paso 01 Insertar Recoleccion"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{a39d16be-95b8-4d9f-8005-fc9eb3c8abd3}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Bakup20260420 Paso 01 Insertar Recoleccion"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{680D323D-BE30-458E-A7C7-26A5BA37EE6B}"
          SQLTask:SqlStatementSource="DROP TABLE IF EXISTS #TEMPORAL_TABLE_PAR_DIVISIONES&#xA;SELECT * INTO #TEMPORAL_TABLE_PAR_DIVISIONES&#xA;FROM  [SIG_COLOMBIA_DW].PAR.DIVISIONES D WITH(NOLOCK)&#xA;DROP TABLE IF EXISTS #TEMPORAL_TABLE_PAR_FESTIVOSNACIONALES&#xA;SELECT * INTO #TEMPORAL_TABLE_PAR_FESTIVOSNACIONALES&#xA;FROM  [SIG_COLOMBIA_DW].[PAR].[FESTIVOSNACIONALES] WITH (NOLOCK)&#xA;TRUNCATE TABLE [TMP].[RCOLEO_GM_SOLICITUDRECOLECCION]&#xA;;WITH CTE_RCOLEO_SOLICITUDRECOLECCION AS (&#xA; SELECT&#xA;  ROW_NUMBER() OVER(PARTITION BY S.NUMERO_SOLICITUD ORDER BY S.FECHA_SOLICITUD_REC DESC) AS #ROW_ID&#xA;  ,S.NUMERO_SOLICITUD S_NUMERO_SOLICITUD&#xA;  ,S.FECHA_RECOLECCION S_ID_FECHA_RECOLECCION&#xA;                                ,ISNULL(S.ID_CIUDAD,-888) S_ID_CIUDAD_ZONA_URBA&#xA;  ,ISNULL(CONVERT(INT,S.ID_TIPO_ZONA_URBA),-888) S_ID_TIPO_ZONA_URBA&#xA;  ,ISNULL(CONVERT(INT,S.ID_ZONA_URBA),-888) S_ID_ZONA_URBA&#xA;  ,ISNULL(CONVERT(INT,S.ID_CONFIRM_SOLICITUD),-888) S_ID_CONFIRM_SOLICITUD &#xA;  ,ISNULL(CONVERT(INT,S.ID_TIPO_SOLICITUD),-888) S_ID_TIPO_SOLICITUD&#xA;  ,ISNULL(S.ID_MOTIVO_RECHAZO,-888) S_ID_MOTIVO_RECHAZO&#xA;  ,CASE WHEN S.ID_CLIENTE = '' THEN '-888' ELSE ISNULL(CONVERT (VARCHAR,S.ID_CLIENTE),'-888') END S_ID_CLIENTE&#xA;  ,ISNULL(CONVERT(INT,S.ID_PRODUCTO),-888) S_ID_PRODUCTO&#xA;  ,ISNULL(CONVERT(INT,S.ID_SUBPRODUCTO),-888) S_ID_SUBPRODUCTO&#xA;  ,ISNULL(CONVERT(INT,S.ID_TIEMPO),-888) S_ID_TIEMPO_ENTREGAR&#xA;  ,S.GM_MARCA&#xA;  ,S.FECHA_SOLICITUD_REC&#xA;                                ,FECHA_RECOLECCION&#xA;  ,CASE WHEN S.OBSERVACION_SOLICITUD = '' THEN 'NO DISPONIBLE' ELSE ISNULL(S.OBSERVACION_SOLICITUD,'NO DISPONIBLE') END OBSERVACIONES&#xA;  ,D.NOMBRE_DIVISION AS CDS&#xA;  ,D.ID_PAIS*100+D.ID_CIUDAD*100+ISNULL(S.ID_DIVISION,S.ID_ZONA_URBA) AS ID_CDS&#xA;  ,S.ID_PAIS AS ID_PAIS&#xA;  ,S.ID_CIUDAD AS ID_CIUDAD&#xA;  ,CONCAT(D.ID_PAIS, '-', D.ID_CIUDAD, '-', D.ID_DIVISION) AS PAIS_CIUDAD_DIVISION&#xA;  ,ISNULL(CODSER.ID_CLIENTE_PS,'NO DISPONIBLE') AS CODSER&#xA;  ,ISNULL(S.ID_SUCURSAL,-888) AS ID_SUCURSAL&#xA;  ,ISNULL(S.ID_DEPENDEN,-888) AS ID_DEPENDEN&#xA;                                ,ISNULL([CANTIDAD_ENVIOS], 0) AS CANTIDAD_ENVIOS  ---------------SE ACLARA EN LA REUNION DE ENTREGA QUE SI UNA SOLICITUD ES NULA SE DEBERA DEJAR 0 LA CANTIDAD DE ENVIOS&#xA;  ---,ISNULL(S.ID_DIVISION,S.ID_ZONA_URBA) AS ID_DIVISION&#xA;  ,ISNULL(S.ID_TIPO_SOLICITANTE,0) AS ID_TIPO_SOLICITANTE&#xA;  ,FECHA_CREACION_SOLICITUD =  S.FECHA_CREACION&#xA; FROM&#xA;  [GM].[RCOLEO_SOLICITUDRECOLECCION] S WITH(NOLOCK)&#xA;  LEFT JOIN #TEMPORAL_TABLE_PAR_DIVISIONES D WITH(NOLOCK)&#xA;   ON S.ID_PAIS = D.ID_PAIS&#xA;   AND S.ID_CIUDAD = D.ID_CIUDAD&#xA;   AND ISNULL(S.ID_DIVISION,S.ID_ZONA_URBA) = D.ID_DIVISION&#xA;  LEFT JOIN [TMP].[RCOLEO_CLIENTES_COD_SER_SUCURSALES] CODSER WITH(NOLOCK)&#xA;   ON  S.ID_CLIENTE=CODSER.ID_CLIENTE&#xA;   AND S.ID_SUCURSAL=CODSER.ID_SUCURSAL&#xA;   AND S.ID_DEPENDEN=CODSER.ID_DEPENDEN&#xA;   ---AND S.ID_CIUDAD=CODSER.ID_CIUDAD_ZONA&#xA; WHERE &#xA;  S.ID_TIPO_SOLICITUD IN (1,2)&#xA; AND&#xA;  CONVERT(DATETIME,CONVERT(DATE,S.FECHA_RECOLECCION)) &#xA;       NOT IN (SELECT [FECHA_FESTIVA] &#xA;         FROM #TEMPORAL_TABLE_PAR_FESTIVOSNACIONALES WITH (NOLOCK))&#xA;)&#xA;INSERT INTO [TMP].[RCOLEO_GM_SOLICITUDRECOLECCION]&#xA;(&#xA; S_NUMERO_SOLICITUD&#xA; ,S_ID_FECHA_RECOLECCION&#xA; ,S_ID_CIUDAD_ZONA_URBA&#xA; ,S_ID_TIPO_ZONA_URBA&#xA; ,S_ID_ZONA_URBA&#xA; ,S_ID_CONFIRM_SOLICITUD&#xA; ,S_ID_TIPO_SOLICITUD&#xA; ,S_ID_MOTIVO_RECHAZO&#xA; ,S_ID_CLIENTE&#xA; ,S_ID_PRODUCTO&#xA; ,S_ID_SUBPRODUCTO&#xA; ,S_ID_TIEMPO_ENTREGAR&#xA; ,GM_MARCA&#xA; ,FECHA_SOLICITUD_REC&#xA; ,FECHA_RECOLECCION&#xA; ,OBSERVACIONES&#xA; ,CDS&#xA; ,ID_CDS&#xA; ,CODSER&#xA; ,ID_SUCURSAL&#xA; ,ID_DEPENDEN&#xA;                ,[CANTIDAD_ENVIOS]&#xA; ,ID_PAIS&#xA; ,ID_CIUDAD&#xA; ,PAIS_CIUDAD_DIVISION&#xA; ,ID_TIPO_SOLICITANTE&#xA; ,FECHA_CREACION_SOLICITUD &#xA;)&#xA;SELECT &#xA;  S_NUMERO_SOLICITUD &#xA;  ,S_ID_FECHA_RECOLECCION &#xA;  ,S_ID_CIUDAD_ZONA_URBA &#xA;  ,S_ID_TIPO_ZONA_URBA &#xA;  ,S_ID_ZONA_URBA &#xA;  ,S_ID_CONFIRM_SOLICITUD &#xA;  ,S_ID_TIPO_SOLICITUD &#xA;  ,S_ID_MOTIVO_RECHAZO &#xA;  ,S_ID_CLIENTE &#xA;  ,S_ID_PRODUCTO &#xA;  ,S_ID_SUBPRODUCTO &#xA;  ,S_ID_TIEMPO_ENTREGAR &#xA;  ,GM_MARCA &#xA;  ,FECHA_SOLICITUD_REC &#xA;                                ,FECHA_RECOLECCION&#xA;  ,OBSERVACIONES &#xA;  ,CDS &#xA;  ,ID_CDS &#xA;  ,CODSER &#xA;  ,ID_SUCURSAL &#xA;  ,ID_DEPENDEN&#xA;                                ,[CANTIDAD_ENVIOS]&#xA;  ,ID_PAIS&#xA;  ,ID_CIUDAD&#xA;                 ,PAIS_CIUDAD_DIVISION&#xA;  ,ID_TIPO_SOLICITANTE&#xA;  ,FECHA_CREACION_SOLICITUD &#xA;FROM CTE_RCOLEO_SOLICITUDRECOLECCION WHERE #ROW_ID=1&#xA;&#xA;--select * from [GM].[RCOLEO_SOLICITUDRECOLECCION]&#xA;--select * from [GM].[RCOLEO_GUIAS_POR_SOLICITUDRECOLECCION]&#xA;----SELECT * FROM [TMP].[RCOLEO_GM_SOLICITUDRECOLECCION]&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
