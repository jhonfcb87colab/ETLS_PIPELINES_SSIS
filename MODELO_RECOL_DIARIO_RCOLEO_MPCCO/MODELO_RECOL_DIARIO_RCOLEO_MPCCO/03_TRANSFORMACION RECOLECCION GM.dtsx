          SQLTask:SqlStatementSource="UPDATE  [TMP].[RCOLEO_GM_SOLICITUDRECOLECCION_GUIAS]&#xA;SET &#xA;&#x9;FECHA_HORA_RECOLECCION_REGIS = B.FECHA_HORA_RECOLECCION_REGIS,&#xA;&#x9;FECHA_HORA_RECOLECCION_ZONIF = B.FECHA_HORA_RECOLECCION_ZONIF,&#xA;&#x9;FECHA_HORA_RECOLECCION_ASIGN = B.FECHA_HORA_RECOLECCION_ASIGN,&#xA;&#x9;FECHA_HORA_RECOLECCION_VERIF = B.FECHA_HORA_RECOLECCION_VERIF,&#xA;&#x9;FECHA_HORA_RECOLECCION_CANCEL = B.FECHA_HORA_RECOLECCION_CANCEL,&#xA;&#x9;ID_ESTADO_ASIGNADA = B.ID_ESTADO_ASIGNADA,&#xA;&#x9;ID_ESTADO_ASIGNADA_EZU = B.ID_ESTADO_ASIGNADA_EZU,&#xA;&#x9;ID_ESTADO_ASIGNADA_EZU_HOY= B.ID_ESTADO_ASIGNADA_EZU_HOY,&#xA;&#x9;ID_ESTADO_VEJEZ = B.ID_ESTADO_VEJEZ,&#xA;&#x9;ID_RANGO_VEJEZ = B.ID_RANGO_VEJEZ,&#xA;&#x9;LOGIN_CREACION = B.LOGIN_CREACION,&#xA;&#x9;EMAIL_CREACION = b.EMAIL_CREACION,&#xA;&#x9;EVIDENCIA_FOTOGRAFICA = B.EVIDENCIA_FOTOGRAFICA,&#xA;&#x9;FECHA_VAL = B.FECHA_VAL,&#xA;&#x9;ID_DIA_HABIL_RE = B.ID_DIA_HABIL_RE,&#xA;&#x9;ID_DIA_HABIL_VAL = B.ID_DIA_HABIL_VAL,&#xA;&#x9;DIAS_NOVEDAD = B.DIAS_NOVEDAD,&#xA;&#x9;OBSERVACIONES_GM = B.OBSERVACIONES_GM&#xA;FROM &#xA;&#x9;[TMP].[RCOLEO_GM_SOLICITUDRECOLECCION_GUIAS] A &#xA;INNER JOIN &#xA;&#x9;[TMP].[RCOLEO_GM_SOLICITUDRECOLECCION] B &#xA;ON&#xA;&#x9;A.S_NUMERO_SOLICITUD = B.S_NUMERO_SOLICITUD" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
