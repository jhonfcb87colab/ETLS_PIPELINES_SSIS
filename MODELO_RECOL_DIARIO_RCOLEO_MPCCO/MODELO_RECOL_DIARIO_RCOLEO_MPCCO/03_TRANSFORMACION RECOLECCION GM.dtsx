          SQLTask:Connection="{680D323D-BE30-458E-A7C7-26A5BA37EE6B}"
          SQLTask:SqlStatementSource="WITH CTE&#xA;(&#xA;&#x9;  ID&#xA;&#x9; ,[NUMERO_GUIA]&#xA;&#x9; ,[ID_PROCESO]&#xA;&#x9; ,[FECHA_HORA_MOVIMIENTO]&#xA;)&#xA;AS&#xA;&#x9;(&#xA;&#x9;&#x9; SELECT &#xA;&#x9;&#x9;&#x9; ROW_NUMBER() OVER(PARTITION BY [ID_PROCESO],[NUMERO_GUIA] ORDER BY [FECHA_HORA_MOVIMIENTO]) ID&#xA;&#x9;&#x9;&#x9;,[NUMERO_GUIA]&#xA;&#x9;&#x9;&#x9;,[ID_PROCESO]&#xA;&#x9;&#x9;&#x9;,[FECHA_HORA_MOVIMIENTO]&#xA;&#x9;&#x9; FROM &#xA;&#x9;&#x9;&#x9;[TMP].[RCOLEO_GM_SOLICITUDRECOLECCION_SE_UNIR] WITH(NOLOCK)&#xA;&#x9;)&#xA;INSERT INTO [TMP].[RCOLEO_GM_SOLICITUDRECOLECCION_SE]&#xA;(&#xA;&#x9; NUMERO_GUIA&#xA;&#x9;,ID_PROCESO&#xA;&#x9;,FECHA_HORA_MOVIMIENTO&#xA;)&#xA;SELECT&#xA;&#x9; [NUMERO_GUIA]&#xA;&#x9;,[ID_PROCESO]&#xA;&#x9;,[FECHA_HORA_MOVIMIENTO]&#xA;FROM&#xA;&#x9;CTE&#xA;WHERE&#xA;&#x9;ID = 1&#xA;ORDER  BY  &#xA;&#x9; [NUMERO_GUIA]&#xA;&#x9;,[FECHA_HORA_MOVIMIENTO]" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
