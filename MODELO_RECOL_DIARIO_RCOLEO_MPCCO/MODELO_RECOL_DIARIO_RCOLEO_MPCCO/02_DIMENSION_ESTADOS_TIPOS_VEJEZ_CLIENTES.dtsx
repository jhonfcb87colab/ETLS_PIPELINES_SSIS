                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">DECLARE  @dbo_CLIENTES_SUCURSALES AS TABLE (
	[ID_PAIS] [smallint] NOT NULL,
	[ID_TIPO_IDENTIFIC] [tinyint] NOT NULL,
	[ID_CLIENTE] [char](20) NOT NULL,
	[ID_SUCURSAL] [smallint] NOT NULL,
	[ID_PAIS_SUCURSAL] [smallint] NULL,
	[ID_CIUDAD] [int] NOT NULL,
	[NOMBRE_SUCURSAL] [varchar](150) NOT NULL,
	[DIRECCION_PRINCIPAL_SUCURSAL] [varchar](150) NULL,
	[MANEJA_CONTACTOS_GENERAL] [bit] NULL,
	[ID_FACILITADOR_RESPONSABLE] [char](20) NULL,
	[ACTIVO] [bit] NULL,
	[LOGIN_EMPLEADO] [varchar](15) NOT NULL,
	[FECHA_CREACION] [datetime] NOT NULL,
	[LOGIN_MODIFICACION] [varchar](15) NOT NULL,
	[FECHA_MODIFICACION] [datetime] NOT NULL,
	[LONGITUD] [decimal](18, 8) NULL,
	[LATITUD] [decimal](18, 8) NULL,
	[CODIGO_POSTAL] [nvarchar](20) NULL,
	[DIRECCION_ESTANDARIZADA] [nvarchar](400) NULL
)

;WITH CTE_AUX AS (SELECT ROW_NUMBER() OVER(PARTITION BY CS.ID_CLIENTE,ID_SUCURSAL,CS.ID_PAIS_SUCURSAL,CS.ID_CIUDAD 
							ORDER BY CS.FECHA_MODIFICACION DESC) AS ROW_ID, 
					* FROM [PARAMETROS].[DBO].[CLIENTES_SUCURSALES] CS WITH(NOLOCK))
INSERT INTO @dbo_CLIENTES_SUCURSALES
(
		[ID_PAIS] 
		,[ID_TIPO_IDENTIFIC] 
		,[ID_CLIENTE]
		,[ID_SUCURSAL] 
		,[ID_PAIS_SUCURSAL] 
		,[ID_CIUDAD] 
		,[NOMBRE_SUCURSAL] 
		,[DIRECCION_PRINCIPAL_SUCURSAL]
		,[MANEJA_CONTACTOS_GENERAL]
		,[ID_FACILITADOR_RESPONSABLE]
		,[ACTIVO] 
		,[LOGIN_EMPLEADO] 
		,[FECHA_CREACION] 
		,[LOGIN_MODIFICACION] 
		,[FECHA_MODIFICACION] 
		,[LONGITUD] 
		,[LATITUD] 
		,[CODIGO_POSTAL] 
		,[DIRECCION_ESTANDARIZADA]
)
SELECT 
		[ID_PAIS] 
		,[ID_TIPO_IDENTIFIC] 
		,[ID_CLIENTE]
		,[ID_SUCURSAL] 
		,[ID_PAIS_SUCURSAL] 
		,[ID_CIUDAD] 
		,[NOMBRE_SUCURSAL] 
		,[DIRECCION_PRINCIPAL_SUCURSAL]
		,[MANEJA_CONTACTOS_GENERAL]
		,[ID_FACILITADOR_RESPONSABLE]
		,[ACTIVO] 
		,[LOGIN_EMPLEADO] 
		,[FECHA_CREACION] 
		,[LOGIN_MODIFICACION] 
		,[FECHA_MODIFICACION] 
		,[LONGITUD] 
		,[LATITUD] 
		,[CODIGO_POSTAL] 
		,[DIRECCION_ESTANDARIZADA]
FROM CTE_AUX WHERE ROW_ID=1

---SELECT * FROM @dbo_CLIENTES_SUCURSALES ---WHERE ID_CLIENTE = '52057968'

;WITH  CTE_CODSER AS(
			SELECT 
					#ROW_ID = ROW_NUMBER() OVER(PARTITION BY 
												CSD.ID_CLIENTE,CSD.ID_SUCURSAL,CSD.ID_DEPENDEN --,CSD.ID_CIUDAD_ZONA--,CSD.ID_ZONA
												ORDER BY CSD.ID_CLIENTE,CS.FECHA_MODIFICACION DESC)
					,CSD.ID_CLIENTE
					,ID_CLIENTE_PS = ISNULL(CSD.ID_CLIENTE_PS,'NO DISPONIBLE')
					,CSD.ID_SUCURSAL
					,CSD.ID_DEPENDEN
					,CSD.ID_PAIS_ZONA
					,CSD.ID_CIUDAD_ZONA
					,CSD.ID_ZONA
					,CSD.ID_TIPO_ZONA
					,CSD.FECHA_MODIFICACION
				FROM [PARAMETROS].[DBO].[CLIENTES_SUCURSALES_DEPENDEN] CSD WITH(NOLOCK)
				INNER JOIN @dbo_CLIENTES_SUCURSALES CS 
				ON CSD.ID_CLIENTE=CS.ID_CLIENTE AND CSD.ID_SUCURSAL=CS.ID_SUCURSAL AND CSD.ID_CIUDAD_ZONA=CS.ID_CIUDAD 
				WHERE ---CS.[ID_CLIENTE]='890900943' AND 
				CS.[ACTIVO] =1
				--ORDER BY 1,3,4,5
)
SELECT 
		ID_CLIENTE	
		,ID_CLIENTE_PS	
		,ID_SUCURSAL	
		,ID_DEPENDEN	
		,ID_PAIS_ZONA	
		,ID_CIUDAD_ZONA	
		,ID_ZONA	
		,ID_TIPO_ZONA	
		,FECHA_MODIFICACION
FROM CTE_CODSER WHERE #ROW_ID=1</property>
