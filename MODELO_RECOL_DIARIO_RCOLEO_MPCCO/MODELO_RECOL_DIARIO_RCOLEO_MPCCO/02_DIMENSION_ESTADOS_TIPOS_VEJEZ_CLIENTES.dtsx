                  description="OLE DB Source"
                  name="OLE DB Source"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT
       [ID_ESTADO_MOVIMIENTO]
      ,[NOMBRE_ESTADO]
      ,[ID_EST_ESTADO_MOVIMIENTO]
      ,[LOGIN_EMPLEADO]
      ,[FECHA_CREACION]
      ,[FECHA_MODIFICACION]	 
      ,CASE WHEN GRUPO_EFECTIVIDAD =  'RECOLECCION NO REPORTADA' THEN 1 WHEN GRUPO_EFECTIVIDAD = 'RECOLECCION EXITOSA' THEN 2 WHEN GRUPO_EFECTIVIDAD =  'RECOLECCION NO EXITOSA' THEN 3 ELSE 4 END ID_GRUPO_EFECTIVIDAD	  
	  ,GRUPO_EFECTIVIDAD
	  ,CASE WHEN ASIGNACION = 'SI' THEN 1 ELSE 2 END ID_ASIGNACION
	  ,ASIGNACION	  

FROM
(
SELECT [ID_ESTADO_MOVIMIENTO]
      ,[NOMBRE_ESTADO]
      ,[ID_EST_ESTADO_MOVIMIENTO]
      ,[LOGIN_EMPLEADO]
      ,[FECHA_CREACION]
      ,[FECHA_MODIFICACION]	  
	  ,CASE WHEN [ID_ESTADO_MOVIMIENTO] = 3 THEN 'RECOLECCION NO REPORTADA' WHEN [ID_ESTADO_MOVIMIENTO] = 4 THEN 'RECOLECCION EXITOSA' WHEN [ID_ESTADO_MOVIMIENTO] = 5 THEN 'RECOLECCION NO EXITOSA' ELSE  'SIN ASIGNACION' END GRUPO_EFECTIVIDAD	  
	  ,CASE WHEN [ID_ESTADO_MOVIMIENTO] = 3 THEN 'SI' WHEN [ID_ESTADO_MOVIMIENTO] = 4 THEN 'SI' WHEN [ID_ESTADO_MOVIMIENTO] = 5 THEN 'SI' ELSE 'NO' END ASIGNACION
  FROM [dbo].[ESTADO_MOVIMIENTO_RECOLECCION] WITH (NOLOCK)
) ESTADO_MOVIMIENTO_RECOLECCION</property>
                    <property
