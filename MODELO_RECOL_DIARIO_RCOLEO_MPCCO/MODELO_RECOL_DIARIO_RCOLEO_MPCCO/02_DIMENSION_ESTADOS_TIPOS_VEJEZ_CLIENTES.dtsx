        <DTS:Executable
          DTS:refId="Package\GM RECOLECCION TIPO\DIM RECOLECCION ESTADOS GRIPO EFECTIVIDAD"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Tarea Ejecutar SQL"
          DTS:DTSID="{C5BB2AF6-0991-43FB-99D4-A89E68BCBEC2}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="DIM RECOLECCION ESTADOS GRIPO EFECTIVIDAD"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="1">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{19887262-0DBD-4B78-A8A5-A7538F01C808}"
              SQLTask:SqlStatementSource="USE SIG_LOGISTICA_DM;&#xA;TRUNCATE TABLE [DIM].[RCOLEO_GM_RECOLECCION_ESTADOS];&#xA;INSERT INTO [DIM].[RCOLEO_GM_RECOLECCION_ESTADOS]&#xA;SELECT &#xA;ID_ESTADO_MOVIMIENTO =-888&#x9;&#xA;,NOMBRE_ESTADO = 'NO DISPONIBLE'&#x9;&#xA;,ID_EST_ESTADO_MOVIMIENTO = -888&#x9;&#xA;,LOGIN_EMPLEADO = 'NO DISPONIBLE'&#x9;&#xA;,ID_GRUPO_EFECTIVIDAD = -888&#xA;,GRUPO_EFECTIVIDAD = 'NO DISPONIBLE'&#x9;&#xA;,ID_ASIGNACION = -888&#xA;,ASIGNACION = 'NO DISPONIBLE'&#x9;&#xA;,FECHA_CREACION = '1900-01-01 00:00:00.000'&#x9;&#xA;,FECHA_MODIFICACION = '1900-01-01 00:00:00.000'&#x9;&#xA;,FECHA_EXTRACCION_DW = '1900-01-01 00:00:00.000'&#xA;UNION ALL&#xA;SELECT &#xA;      [ID_ESTADO_SOLICITUD] AS [ID_ESTADO_MOVIMIENTO]&#xA;      ,[NOMBRE_ESTADO_SOLICITUD] AS [NOMBRE_ESTADO]&#xA;      ,[ESTADO_ESTADO_SOLICITUD] AS [ID_EST_ESTADO_MOVIMIENTO]&#xA;      ,[LOGIN_EMPLEADO_MODIFICACION] AS [LOGIN_EMPLEADO]&#xA;&#x9;  ,[ID_GRUPO_EFECTIVIDAD] = CASE WHEN [ID_ESTADO_SOLICITUD] IN (1,2) THEN 4&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN [ID_ESTADO_SOLICITUD] IN (3) THEN 1&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN [ID_ESTADO_SOLICITUD] IN (4) THEN 2&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN [ID_ESTADO_SOLICITUD] IN (5) THEN 3&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN [ID_ESTADO_SOLICITUD] IN (6,7,97,98,99) THEN 4 &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;ELSE 0 end&#xA;&#x9;  ,[GRUPO_EFECTIVIDAD] = CASE WHEN [ID_ESTADO_SOLICITUD] IN (1,2) THEN 'SIN ASIGNACION'&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN [ID_ESTADO_SOLICITUD] IN (3) THEN 'RECOLECCION NO REPORTADA'&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN [ID_ESTADO_SOLICITUD] IN (4) THEN 'RECOLECCION EXITOSA'&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN [ID_ESTADO_SOLICITUD] IN (5) THEN 'RECOLECCION NO EXITOSA'&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN [ID_ESTADO_SOLICITUD] IN (6,7,97,98,99) THEN 'SIN ASIGNACION' &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;ELSE 'NO DISPONIBLE' end&#xA;&#x9;  ,[ID_ASIGNACION] = CASE WHEN [ID_ESTADO_SOLICITUD] IN (1,2) THEN 2&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN [ID_ESTADO_SOLICITUD] IN (3) THEN 1&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN [ID_ESTADO_SOLICITUD] IN (4) THEN 1&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN [ID_ESTADO_SOLICITUD] IN (5) THEN 1&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN [ID_ESTADO_SOLICITUD] IN (6,7,97,98,99) THEN 2 &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;ELSE 0 end&#xA;&#x9;  ,[ASIGNACION] = CASE WHEN [ID_ESTADO_SOLICITUD] IN (1,2) THEN 'NO'&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN [ID_ESTADO_SOLICITUD] IN (3) THEN 'SI'&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN [ID_ESTADO_SOLICITUD] IN (4) THEN 'SI'&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN [ID_ESTADO_SOLICITUD] IN (5) THEN 'SI'&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN [ID_ESTADO_SOLICITUD] IN (6,7,97,98,99) THEN 'NO'&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;ELSE 'NO DISPONIBLE' END&#xA;      ,[FECHA_CREACION]&#xA;      ,[FECHA_MODIFICACION]&#xA;      ,[FECHA_EXTRACCION_DW]&#xA;  FROM [SIG_COLOMBIA_DW].[PAR].[ESTADOS_SOLICITUDES_RECOLECCION]&#xA;  WHERE ID_PAIS=1" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
