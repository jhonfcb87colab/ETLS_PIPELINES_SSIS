                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">WITH CTE_G_RECOLECCION AS(	
   SELECT 
		ROW_NUMBER ( )   OVER ( PARTITION BY DIV.ID_PAIS,DIV.ID_CIUDAD,DIV.ID_DIVISION  order by DIV.FECHA_MODIFICACION desc )  ROWid
	   ,''  AS SR_ID_CLIENTE
	   ,'' AS G_ID_CLIENTE	
	   ,'' AS NOMBRE_CLIENTE
   	   ,DIV.ID_PAIS AS SR_ID_PAIS
   	   ,DIV.ID_CIUDAD AS SR_ID_CIUDAD
	   ,DIV.ID_DIVISION AS SR_ID_DIVISION 
   	   ,DIV.FECHA_MODIFICACION
	   ,DIV.NOMBRE_DIVISION AS NOMBRE_CDS
	   ,DIV.ID_DIVISION AS G_ID_CDS
	   ,DIV.ID_EST_DIVISION AS ESTADO_CDS
	   ,CONCAT(DIV.ID_PAIS , '-' , DIV.ID_CIUDAD , '-' ,DIV.ID_DIVISION  ) AS PAIS_CIUDAD_DIVISION
   FROM PARAMETROS..DIVISIONES DIV WITH(NOLOCK)
)
   SELECT 
	   CTE.* 
   FROM CTE_G_RECOLECCION CTE WHERE ROWid=1</property>
