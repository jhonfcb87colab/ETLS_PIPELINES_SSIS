                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT [ID_MOTIVO_RECHAZO]
      ,[NOMBRE_MOTIVO_RECHAZO]
      ,[ID_EST_MOTIVO_RECHAZO]
      ,[ID_ESTADO_SOLICITUD]
      ,[LOGIN_EMPLEADO]
      ,[FECHA_CREACION]
      ,[FECHA_MODIFICACION]
	    ,CASE ID_RESPONSABILIDAD 
		WHEN 1 THEN 'SERVIENTREGA'
		WHEN 2 THEN 'CLIENTE'
		WHEN 3 THEN 'EXTERNO'
	ELSE 'NO DISPONIBLE'
	END  AS RESPONSABILIDAD
  FROM [dbo].[Motivos_Rechazos_SolicRecol] WITH (NOLOCK)</property>
