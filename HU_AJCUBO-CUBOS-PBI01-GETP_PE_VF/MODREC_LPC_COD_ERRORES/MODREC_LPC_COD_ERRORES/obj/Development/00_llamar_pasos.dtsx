                          UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=15.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">with cte as(
SELECT
ROWID = ROW_NUMBER() OVER(PARTITION by ID_CLIENTE order by FECHA_MODIFICACION desc )
,ID_CLIENTE
,RAZON_SOCIAL_CORTA
,ID_TIPO_CLIENTE
,TIPO_CLIENTE = 0
,FECHA_CREACION_DW = GETDATE()
FROM [SIG_COLOMBIA_DW].PAR.CLIENTES WITH(NOLOCK)
)
select 
 ID_CLIENTE
,RAZON_SOCIAL_CORTA
,ID_TIPO_CLIENTE
,TIPO_CLIENTE = 0
,FECHA_CREACION_DW
from cte where ROWID=1</property>
