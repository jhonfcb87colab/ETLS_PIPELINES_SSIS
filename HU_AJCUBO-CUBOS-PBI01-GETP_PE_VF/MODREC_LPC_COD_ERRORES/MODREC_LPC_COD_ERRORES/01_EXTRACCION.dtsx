      DTS:DTSID="{1C1E2F3A-2E29-48F6-AD90-9B932420F1F9}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Pruebas data Recudo LPC COD"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="1">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{20AF370D-4C8E-4E05-91E7-8F81200FAADC}"
          SQLTask:SqlStatementSource="DECLARE @FECH_INI DATETIME =  '20260520' ;&#x9;/*---&#x9;&#x9;&#x9;'20260101';&#x9;&#x9;&#x9;*/&#xA;DECLARE @FECH_FIN DATETIME =  '20260527' ;&#x9;/*---&#x9;&#x9;&#x9;'20260101';&#x9;&#x9;&#x9;*/&#xA;&#xA;IF OBJECT_ID('tempdb..#COD_PENDIENTE_POR_RECAUDO') IS NOT NULL &#xA;    DROP TABLE #COD_PENDIENTE_POR_RECAUDO&#xA;&#xA;IF OBJECT_ID('tempdb..#TMP_GUIAS_PENDIENTE_RECAUDO') IS NOT NULL &#xA;    DROP TABLE #TMP_GUIAS_PENDIENTE_RECAUDO&#xA;&#xA;CREATE TABLE #TMP_GUIAS_PENDIENTE_RECAUDO(&#xA;&#x9;NUMERO_GUIA numeric(20, 0) NOT NULL,&#xA;&#x9;ID_ESTADOENVIO smallint DEFAULT 0,&#xA;&#x9;NOMBRE_ESTADOENVIO varchar(40) DEFAULT '',&#xA;&#x9;FORMA_PAGO varchar(40) DEFAULT '',&#xA;&#x9;VALOR_A_RECAUDAR numeric(12, 2) NULL,&#xA;&#x9;ID_REMITE [varchar](40) DEFAULT '',&#xA;&#x9;NOMBRE_REMITE_GUIA  [varchar](200) DEFAULT '',&#xA;&#x9;-- ID_CIUDAD INT DEFAULT 0,&#xA;&#x9;-- [NOMBRE_CIUDAD] [varchar](50) DEFAULT '',&#xA;&#x9;FECHA_ENVIO datetime NULL,&#xA;&#x9;[VALOR_RECAUDADO] [numeric](11, 2) DEFAULT 0,&#xA;&#x9;FECHA_RECAUDO datetime NULL,&#xA;&#x9;NUMERO_ORDEN_SERVICIO varchar(20) DEFAULT '',&#xA;&#x9;FECHA_RECAUDO_EFECTY datetime NULL,&#xA;&#x9;ESTADO_ENTREGA varchar(70) DEFAULT 'A TIEMPO',--A TIEMPO O VENCIDO&#xA;&#x9;--NOMBRE_RESPONSABLE_ULT_MOV VARCHAR(100) DEFAULT '',&#xA;&#x9;ID_PROCESO_ULT_MOV int DEFAULT 0,&#xA;&#x9;NOMBRE_PROCESO_ULT_MOV varchar(70) DEFAULT '',&#xA;&#x9;ID_CONCEPTO_ULT_MOV int DEFAULT 0,&#xA;&#x9;NOMBRE_CONCEPTO_ULT_MOV varchar(70) DEFAULT '',&#xA;&#x9;NUMERO_MOVIMI_ULT_MOV char(30) DEFAULT '',&#xA;&#x9;CONSECUT_MOVIMI_ULT_MOV numeric(7, 0) DEFAULT 0,&#xA;&#x9;FECHA_HORA_MOVIMI_ULT_MOV datetime NULL,&#xA;&#x9;ID_PAIS_ZONA_URBA_ULT_MOV SMALLINT NULL,&#xA;&#x9;ID_CIUDAD_ZONA_URBA_ULT_MOV INT NULL,&#xA;&#x9;ID_TIPO_ZONA_URBA_ULT_MOV SMALLINT NULL,&#xA;&#x9;ID_ZONA_URBA_ULT_MOV SMALLINT NULL,&#xA;&#x9;NOMBRE_CDS_ULT_MOV varchar(100) DEFAULT '',&#xA;&#x9;TIPO_CANAL_ULT_MOV varchar(40) DEFAULT '',&#xA;&#x9;ID_CONDUCTOR_ULT_MOV varchar(40) DEFAULT '',&#xA;&#x9;CONDUCTOR_ULT_MOV  varchar(200) DEFAULT '',&#xA;&#x9;ID_AUXILIAR_ULT_MOV varchar(40) DEFAULT '',&#xA;&#x9;AUXILIAR_ULT_MOV varchar(200) DEFAULT '',&#xA;&#x9;ID_CLIENTE [char](20) NOT NULL,&#xA;&#x9;NOMBRE_TIPO_CANAL varchar(100) DEFAULT '',&#xA;&#x9;NOMBRE_CLASE_TIPO_CANAL varchar(100) DEFAULT '',&#xA;&#x9;[G_ID_CIUDAD_ORIGEN] [int] NULL,&#xA;&#x9;[G_ID_CIUDAD_DESTINO] [int] NULL&#xA;) ON [PRIMARY]&#xA;CREATE NONCLUSTERED INDEX [IX_NUMERO_GUIA] ON #TMP_GUIAS_PENDIENTE_RECAUDO ([NUMERO_GUIA] ASC)&#xA;CREATE NONCLUSTERED INDEX [IX_ZONA] ON #TMP_GUIAS_PENDIENTE_RECAUDO (ID_PAIS_ZONA_URBA_ULT_MOV,ID_CIUDAD_ZONA_URBA_ULT_MOV, ID_TIPO_ZONA_URBA_ULT_MOV,ID_ZONA_URBA_ULT_MOV ASC)&#xA;CREATE NONCLUSTERED INDEX [IX_MANIFIESTO] ON #TMP_GUIAS_PENDIENTE_RECAUDO (ID_PROCESO_ULT_MOV,NUMERO_MOVIMI_ULT_MOV,CONSECUT_MOVIMI_ULT_MOV ASC)&#xA;&#xA;&#xA;IF OBJECT_ID('tempdb..#TMP_CIUDADES_ANEXAS') IS NOT NULL &#xA;    DROP TABLE #TMP_CIUDADES_ANEXAS&#xA;&#xA;---CIUDADES ANEXAS&#xA;SELECT CAD.* &#xA;INTO #TMP_CIUDADES_ANEXAS FROM PARAMETROS.DBO.CIUDADES_ANEXAS CAD (NOLOCK) &#xA;WHERE CAD.ID_PAIS=1 AND CAD.RECOLECCION=1&#xA;&#xA;INSERT INTO #TMP_CIUDADES_ANEXAS&#xA;SELECT CAD.* FROM PARAMETROS.DBO.CIUDADES_ANEXAS CAD (NOLOCK) &#xA;LEFT JOIN #TMP_CIUDADES_ANEXAS TCAD ON TCAD.ID_CIUDAD_ANEXA=CAD.ID_CIUDAD_ANEXA&#xA;WHERE CAD.ID_PAIS=1 AND CAD.RECOLECCION=0 AND TCAD.ID_CIUDAD_ANEXA IS NULL&#xA;&#xA;DELETE T FROM (SELECT *, &#xA;    DupRank = ROW_NUMBER() OVER (PARTITION BY ID_CIUDAD_ANEXA ORDER BY FECHA_CREACION DESC) &#xA;     FROM #TMP_CIUDADES_ANEXAS) AS T&#xA;WHERE DupRank &gt; 1&#xA;&#xA;&#xA;&#xA;SELECT CPR.*&#xA;,G.ID_CLIENTE,G.ID_REMITE,G.NOMBRE_REMITE_GUIA&#xA;,G.ID_PRODUCTO AS ID_PRODUCTO_GUIA&#xA;,G.ID_ESTADOENVIO&#xA;,G.ID_ESTADOGUIA&#xA;,ISNULL(G.VALOR_SEG_MAN_GUIAS,0)+ISNULL(G.VALOR_FLETES_GUIAS,0) AS VALOR_ENVIO_GUIA&#xA;,ISNULL(GIA.VALOR_RECAUDAR_PRODUCTO,0) AS VALOR_RECAUDAR_PRODUCTO_GUIA&#xA;,CAST('' AS nvarchar(50)) AS NOMBRE_ESTADOENVIO,G.FECHA_ENVIO&#xA;,TCAN.NOMBRE_TIPO_CANAL&#xA;,CTCAN.NOMBRE_CLASE_TIPO_CANAL&#xA;,G.[ID_CIUDAD_ORIGEN]&#x9;&#x9;&#x9;AS G_ID_CIUDAD_ORIGEN&#xA;,G.[ID_CIUDAD_DESTINO]&#x9;&#x9;&#x9;AS G_ID_CIUDAD_DESTINO&#xA;INTO #COD_PENDIENTE_POR_RECAUDO&#xA;FROM [Mece_Logistico].[dbo].[COD_PENDIENTE_POR_RECAUDO] CPR (NOLOCK)&#xA;INNER JOIN [Mece_Logistico].[dbo].[GUIAS] G (nolock) ON G.NUMERO_GUIA=CPR.NUMERO_GUIA&#xA;LEFT JOIN [Mece_Logistico].[dbo].[GUIAS_INF_ADICIONAL] GIA (nolock) ON GIA.NUMERO_GUIA=CPR.NUMERO_GUIA&#xA;LEFT JOIN [tmp_borrar_local].dbo.LPC_GUIAS_SOLUCIONADAS LGS (NOLOCK) ON LGS.NUMERO_GUIA=CPR.NUMERO_GUIA&#xA;LEFT JOIN [Mece_Logistico].[dbo].[CANALES] CAN (NOLOCK) ON CAN.id_pais=G.ID_1 and CAN.id_ciudad=G.ID_2 and CAN.[ID_DIVISION]=G.ID_CANAL&#xA;LEFT JOIN [Mece_Logistico].[dbo].[TIPOS_CANAL] TCAN (NOLOCK) ON TCAN.ID_TIPO_CANAL=CAN.ID_TIPO_CANAL AND TCAN.ID_EST_TIPO_CANAL=1&#xA;LEFT JOIN PARAMETROS.[dbo].[CLASE_TIPO_CANAL] CTCAN (NOLOCK) ON CTCAN.ID_CLASE_TIPO_CANAL=TCAN.CLASE_TIPO_CANAL&#xA;WHERE LGS.NUMERO_GUIA IS NULL &#xA;/*AND ISNULL(CPR.ESTADO_COD,1)=1-- RECAUDO ESTA ACTIVO*/---&gt;(se descarta por solicitud de luis gabriel rodriguez y Holman Salamanca el dia 2026-04-09 11:44am )&#xA;AND ISNULL(CPR.ESTA_RECAUDADO,0)=0 -- NO ESTA RECAUDADO&#xA;--AND G.ID_ESTADOGUIA!=4-- NO ESTA ANULADA&#xA;AND ISNULL(CPR.NUMERO_ORDEN_SERVICIO,'')='' -- NO TIENE ORDEN DE RECAUDO DE EFECTY&#xA;AND ISNULL(CPR.ESTA_ANULADO,0)=0 -- NO DEBE ESTAR ANULADA&#xA;--AND G.ID_DIVISION_PROV IS NULL&#xA;AND isnull(G.ID_DIVISION_PROV,0) = 0&#xA;--AND CPR.FECHA_CREACION &gt;= @FECHA_INI &#xA;--AND CPR.FECHA_CREACION &lt; @FECHA_FIN&#xA;AND CPR.FECHA_CREACION BETWEEN convert(datetime,@FECH_INI) AND convert(datetime,@FECH_FIN)&#xA;--AND CPR.NUMERO_GUIA= 2276053288&#xA;&#xA;&#xA;/*&#xA;AND CPR.FECHA_CREACION BETWEEN&#x9;convert(datetime,'20251201') &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;AND convert(datetime,'20260201')&#xA;*/&#xA;&#xA;&#xA;INSERT INTO #COD_PENDIENTE_POR_RECAUDO&#xA;/*&#xA;SELECT CPR.*,G.ID_CLIENTE,G.ID_REMITE,G.NOMBRE_REMITE_GUIA,G.ID_PRODUCTO AS ID_PRODUCTO_GUIA,G.ID_ESTADOENVIO,G.ID_ESTADOGUIA,ISNULL(G.VALOR_SEG_MAN_GUIAS,0)+ISNULL(G.VALOR_FLETES_GUIAS,0) AS VALOR_ENVIO_GUIA,ISNULL(GIA.VALOR_RECAUDAR_PRODUCTO,0) AS VALOR_RECAUDAR_PRODUCTO_GUIA&#xA;,CAST('' AS nvarchar(50)) AS NOMBRE_ESTADOENVIO,G.FECHA_ENVIO&#xA;*/&#xA;SELECT CPR.*&#xA;,G.ID_CLIENTE,G.ID_REMITE,G.NOMBRE_REMITE_GUIA&#xA;,G.ID_PRODUCTO AS ID_PRODUCTO_GUIA&#xA;,G.ID_ESTADOENVIO&#xA;,G.ID_ESTADOGUIA&#xA;,ISNULL(G.VALOR_SEG_MAN_GUIAS,0)+ISNULL(G.VALOR_FLETES_GUIAS,0) AS VALOR_ENVIO_GUIA&#xA;,ISNULL(GIA.VALOR_RECAUDAR_PRODUCTO,0) AS VALOR_RECAUDAR_PRODUCTO_GUIA&#xA;,CAST('' AS nvarchar(50)) AS NOMBRE_ESTADOENVIO,G.FECHA_ENVIO&#xA;,TCAN.NOMBRE_TIPO_CANAL&#xA;,CTCAN.NOMBRE_CLASE_TIPO_CANAL&#xA;,G.[ID_CIUDAD_ORIGEN]&#x9;&#x9;&#x9;AS G_ID_CIUDAD_ORIGEN&#xA;,G.[ID_CIUDAD_DESTINO]&#x9;&#x9;&#x9;AS G_ID_CIUDAD_DESTINO&#xA;FROM [Mece_Logistico].[dbo].[COD_PENDIENTE_POR_RECAUDO] CPR (NOLOCK)&#xA;INNER JOIN [Mece_Logistico].[dbo].[GUIAS] G (nolock) ON G.NUMERO_GUIA=CPR.NUMERO_GUIA&#xA;LEFT JOIN [Mece_Logistico].[dbo].[GUIAS_INF_ADICIONAL] GIA (nolock) ON GIA.NUMERO_GUIA=CPR.NUMERO_GUIA&#xA;LEFT JOIN [tmp_borrar_local].dbo.LPC_GUIAS_SOLUCIONADAS LGS (NOLOCK) ON LGS.NUMERO_GUIA=CPR.NUMERO_GUIA&#xA;LEFT JOIN [Mece_Logistico].[dbo].[CANALES] CAN (NOLOCK) ON CAN.id_pais=G.ID_1 and CAN.id_ciudad=G.ID_2 and CAN.[ID_DIVISION]=G.ID_CANAL&#xA;LEFT JOIN [Mece_Logistico].[dbo].[TIPOS_CANAL] TCAN (NOLOCK) ON TCAN.ID_TIPO_CANAL=CAN.ID_TIPO_CANAL AND TCAN.ID_EST_TIPO_CANAL=1&#xA;LEFT JOIN PARAMETROS.[dbo].[CLASE_TIPO_CANAL] CTCAN (NOLOCK) ON CTCAN.ID_CLASE_TIPO_CANAL=TCAN.CLASE_TIPO_CANAL&#xA;WHERE LGS.NUMERO_GUIA IS NULL AND&#xA;ISNULL(CPR.ESTADO_COD,1)=1-- RECAUDO ESTA ACTIVO&#xA;AND ISNULL(CPR.ESTA_ANULADO,0)=0 -- NO DEBE ESTAR ANULADA&#xA;AND ISNULL(CPR.ESTA_RECAUDADO,0)=1 -- RECAUDADO EN RECAUDOS PERO NO TIENE LA FORMADE RECAUDO&#xA;AND (ISNULL(CPR.NUMERO_ORDEN_SERVICIO,'')='' AND ISNULL(CPR.ID_MODALPAGO,0)=0 AND ISNULL(RTRIM(LTRIM(CPR.NUMERO_APROBACION)),'')='' AND ISNULL(INGRESO_MANUAL,0)=0)&#xA;--AND G.ID_DIVISION_PROV IS NULL&#xA;AND isnull(G.ID_DIVISION_PROV,0) = 0&#xA;--AND CPR.FECHA_CREACION&gt;=DATEADD(YEAR, -1,GETDATE())&#xA;AND CPR.FECHA_CREACION BETWEEN convert(datetime,@FECH_INI) AND convert(datetime,@FECH_FIN)&#xA;--AND CPR.NUMERO_GUIA= 2276053288&#xA;&#xA;&#xA;&#xA;; WITH CTE_DELL AS ( SELECT ROW_NUMBER() OVER(PARTITION BY NUMERO_GUIA ORDER BY FECHA_ACTUALIZACION DESC) AS ROWID,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;NUMERO_GUIA FROM #COD_PENDIENTE_POR_RECAUDO) DELETE CTE_DELL WHERE ROWID&gt;1&#xA;&#xA;---SELECT TOP 100 * FROM #COD_PENDIENTE_POR_RECAUDO&#xA;&#xA;&#xA;--Id_Cod&#x9;NUMERO_GUIA&#x9;ID_PAIS&#x9;ID_CIUDAD&#x9;ID_AUXILIAR&#x9;ID_DIVISION_RECAUDADORA&#x9;ID_CIUDAD_ORIGEN&#x9;ID_CIUDAD_ENTREGA&#x9;FECHA_ASIGNACION_AL_AUXILIAR&#x9;ESTADO_COD&#x9;ESTA_RECAUDADO&#x9;FECHA_RECAUDO&#x9;ESTA_DEVUELTO&#x9;FECHA_DEVOLUCION&#x9;ESTA_ANULADO&#x9;FECHA_ANULACION&#x9;CAUSAL_DEVOLUCION&#x9;VALOR_ENVIO&#x9;ES_COD_CORPORATIVO&#x9;NUMERO_FACTURA&#x9;VALOR_RECAUDADO&#x9;VALOR_IMPUESTO&#x9;CARGAR_A_LA_CUENTA&#x9;ESTA_CARGADO_A_LA_CUENTA&#x9;ID_CLIENTE_PS_A_FACTURAR&#x9;ID_TIPO_COD&#x9;ID_ACTUALIZADO&#x9;FECHA_ACTUALIZACION&#x9;LOGIN_EMPLEADO_CREACION&#x9;FECHA_CREACION&#x9;LOGIN_EMPLEADO_MODIFICACION&#x9;FECHA_MODIFICACION&#x9;ID_PRODUCTO&#x9;ID_SUBPRODUCTO&#x9;ID_FORMA_PAGO&#x9;ID_TIEMPO_ENTREGA&#x9;ID_MEDIO_TRANSPORTE&#x9;PESO_FISICO_GUIA&#x9;NUMERO_PIEZAS&#x9;VALOR_DECLARADO&#x9;VALOR_FLETE&#x9;VALOR_OTROS&#x9;VALOR_TOTAL&#x9;ID_MOVIMIENTO&#x9;VALOR_PRODUCTO&#x9;NUMERO_CODIGO_EFECTY&#x9;INGRESO_MANUAL&#x9;NUMERO_ORDEN_SERVICIO&#x9;ID_PUNTO_RECAUDO&#x9;FECHA_RECAUDO_EFECTY&#x9;NUMERO_ORDEN_SERVICIO2&#x9;ID_MODALPAGO&#x9;NUMERO_APROBACION&#x9;FRANQUICIA&#x9;ID_CLIENTE&#x9;ID_REMITE&#x9;NOMBRE_REMITE_GUIA&#x9;ID_PRODUCTO_GUIA&#x9;ID_ESTADOENVIO&#x9;ID_ESTADOGUIA&#x9;VALOR_ENVIO_GUIA&#x9;VALOR_RECAUDAR_PRODUCTO_GUIA&#x9;NOMBRE_ESTADOENVIO&#x9;FECHA_ENVIO&#x9;NOMBRE_TIPO_CANAL&#x9;NOMBRE_CLASE_TIPO_CANAL&#x9;G_ID_CIUDAD_ORIGEN&#x9;G_ID_CIUDAD_DESTINO&#xA;&#xA;/*&#xA;select G.NUMERO_GUIA&#xA;,TCAN.NOMBRE_TIPO_CANAL&#xA;,CTCAN.NOMBRE_CLASE_TIPO_CANAL&#xA;from Mece_Logistico.dbo.guias G (nolock)&#xA;left JOIN [Mece_Logistico].[dbo].[CANALES] CAN (NOLOCK) ON CAN.id_pais=G.ID_1 and CAN.id_ciudad=G.ID_2 and CAN.[ID_DIVISION]=G.ID_CANAL&#xA;left JOIN [Mece_Logistico].[dbo].[TIPOS_CANAL] TCAN (NOLOCK) ON TCAN.ID_TIPO_CANAL=CAN.ID_TIPO_CANAL AND TCAN.ID_EST_TIPO_CANAL=1&#xA;left JOIN PARAMETROS.[dbo].[CLASE_TIPO_CANAL] CTCAN (NOLOCK) ON CTCAN.ID_CLASE_TIPO_CANAL=TCAN.CLASE_TIPO_CANAL&#xA;where G.ID_CANAL IS NOT NULL&#xA;AND FECHA_ENVIO&gt;='20260120 00:00:00'&#xA;*/&#xA;&#xA;CREATE NONCLUSTERED INDEX [IX_NUMERO_GUIA] ON #COD_PENDIENTE_POR_RECAUDO ([NUMERO_GUIA] ASC)&#xA;&#xA;&#xA;--Se quitan envios siniestrados&#xA;DELETE GPR FROM #COD_PENDIENTE_POR_RECAUDO GPR&#xA;WHERE ID_ESTADOENVIO in(5,4)&#xA;&#xA;--Quita las guias son del canal retail y no son COD y no contraentrega ecommerce&#xA;DELETE GPR FROM #COD_PENDIENTE_POR_RECAUDO GPR&#xA;WHERE ID_FORMA_PAGO=1 AND ISNULL(ID_PRODUCTO_GUIA,999) !=86&#xA;--WHERE ID_FORMA_PAGO=1 AND ISNULL(ID_PRODUCTO,999) !=86&#xA;&#xA;&#xA;--Quita las guias CREDICONTADO (Solicitud de luis gabriel rodriguez y Holman Salamanca el dia 2026-04-09 11:44am )&#xA;/*&#xA;&#xA;ID_FORMAPAGO&#x9;NOMBRE_FORMAPAGO&#xA;1&#x9;CONTADO&#xA;2&#x9;CREDITO&#xA;3&#x9;PREPAGO DIGITAL&#xA;4&#x9;C.O.D. &#xA;5&#x9;CHEQUE&#xA;6&#x9;TARJETAS FINANCIERAS&#xA;7&#x9;CREDI CONTADO&#xA;9&#x9;QR&#xA;10&#x9;TARJETA&#xA;*/&#xA;DELETE GPR FROM #COD_PENDIENTE_POR_RECAUDO GPR&#xA;WHERE ID_FORMA_PAGO=7&#xA;&#xA;/*&#xA;--&gt;credicontado --9175427260&#xA;--&gt;contado --9177482665&#xA;SELECT * FROM [Mece_Logistico].[dbo].[COD_PENDIENTE_POR_RECAUDO] CPR (NOLOCK)&#xA;WHERE ID_FORMA_PAGO=7&#xA;AND NUMERO_GUIA=9177482665&#xA;*/&#xA;&#xA;--SELECT * FROM #COD_PENDIENTE_POR_RECAUDO CPR (NOLOCK)&#xA;--WHERE --NUMERO_GUIA=2143658629&#xA;--ID_PRODUCTO=86&#xA;--INSERT INTO #TMP_GUIAS_PENDIENTE_RECAUDO&#xA;&#xA;UPDATE CPR SET CPR.NOMBRE_ESTADOENVIO=E.NOMBRE_ESTADOENVIO&#xA;FROM #COD_PENDIENTE_POR_RECAUDO CPR&#xA;INNER JOIN PARAMETROS.DBO.ESTADOSENVIO E (NOLOCK)ON E.ID_ESTADOENVIO=CPR.ID_ESTADOENVIO&#xA;&#xA;--TRUNCATE TABLE #TMP_GUIAS_PENDIENTE_RECAUDO&#xA;INSERT INTO #TMP_GUIAS_PENDIENTE_RECAUDO(&#xA;NUMERO_GUIA,&#xA;ID_ESTADOENVIO,&#xA;NOMBRE_ESTADOENVIO,&#xA;FORMA_PAGO,&#xA;VALOR_A_RECAUDAR,&#xA;ID_REMITE,&#xA;NOMBRE_REMITE_GUIA,&#xA;FECHA_ENVIO,&#xA;VALOR_RECAUDADO,&#xA;FECHA_RECAUDO,&#xA;NUMERO_ORDEN_SERVICIO,&#xA;FECHA_RECAUDO_EFECTY,&#xA;ID_CLIENTE,&#xA;NOMBRE_TIPO_CANAL,&#xA;NOMBRE_CLASE_TIPO_CANAL,&#xA;G_ID_CIUDAD_ORIGEN,&#xA;G_ID_CIUDAD_DESTINO&#xA;)&#xA;SELECT CPR.NUMERO_GUIA,CPR.ID_ESTADOENVIO,CPR.NOMBRE_ESTADOENVIO,&#xA;CASE WHEN CPR.ID_FORMA_PAGO=4 AND CPR.ID_CLIENTE IS NULL THEN 'C.O.D.' WHEN ISNULL(CPR.ID_PRODUCTO,CPR.ID_PRODUCTO_GUIA)=86 THEN 'CONTRAENTREGA ECOMMERCE' WHEN (CPR.ID_FORMA_PAGO=2 OR CPR.ID_CLIENTE IS NOT NULL) THEN 'LPC' ELSE '' END AS FORMA_PAGO,&#xA;CASE WHEN ISNULL(CPR.VALOR_TOTAL,0)!=0 THEN CPR.VALOR_TOTAL&#xA;WHEN CPR.ID_FORMA_PAGO=4 AND VALOR_FLETE IS NOT NULL THEN ISNULL(CPR.VALOR_FLETE,0) + ISNULL(CPR.VALOR_OTROS,0)&#xA;WHEN CPR.ID_FORMA_PAGO=4 AND VALOR_FLETE IS NULL THEN ISNULL(CPR.VALOR_ENVIO_GUIA,0)&#xA;WHEN ISNULL(CPR.ID_PRODUCTO,CPR.ID_PRODUCTO_GUIA)=86 THEN ISNULL(CPR.VALOR_DECLARADO,CPR.VALOR_PRODUCTO)&#xA;WHEN (CPR.ID_FORMA_PAGO=2 OR CPR.ID_CLIENTE IS NOT NULL) THEN ISNULL(CPR.VALOR_DECLARADO,CPR.VALOR_PRODUCTO) ELSE 0 END AS VALOR_A_RECAUDAR&#xA;,CPR.ID_REMITE&#xA;,CPR.NOMBRE_REMITE_GUIA&#xA;,CPR.FECHA_ENVIO&#xA;,ISNULL(CPR.VALOR_RECAUDADO,0)&#xA;,CPR.FECHA_RECAUDO&#xA;,ISNULL(CPR.NUMERO_ORDEN_SERVICIO,0)&#xA;,CPR.FECHA_RECAUDO_EFECTY&#xA;,isnull(CPR.ID_CLIENTE,'0') ID_CLIENTE&#xA;,CPR.NOMBRE_TIPO_CANAL&#xA;,CPR.NOMBRE_CLASE_TIPO_CANAL&#xA;,G_ID_CIUDAD_ORIGEN&#xA;,G_ID_CIUDAD_DESTINO&#xA;--,CPR.VALOR_TOTAL&#xA;--INTO #TMP_GUIAS_PENDIENTE_RECAUDO_1&#xA;FROM #COD_PENDIENTE_POR_RECAUDO CPR (NOLOCK)&#xA;WHERE LEN(CPR.NUMERO_GUIA)&gt;7&#xA;--INNER JOIN [Mece_Logistico].[dbo].[GUIAS] G (nolock) ON G.NUMERO_GUIA=CPR.NUMERO_GUIA&#xA;&#xA;--CREATE NONCLUSTERED INDEX [IX_NUMERO_GUIA] ON #TMP_GUIAS_PENDIENTE_RECAUDO_1 ([NUMERO_GUIA] ASC)&#xA;&#xA;--select GPR.* from #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA;&#xA;&#xA;UPDATE GPR SET&#xA; --GPR.NOMBRE_RESPONSABLE_ULT_MOV='SERVIENTREGA S.A.'&#xA; GPR.ID_PROCESO_ULT_MOV=SE.ID_PROCESO&#xA; ,GPR.NOMBRE_PROCESO_ULT_MOV=PRO.NOMBRE_PROCESO_LOG&#xA; ,GPR.ID_CONCEPTO_ULT_MOV=ISNULL(SE.ID_CONCEPTO,0)&#xA; ,GPR.NOMBRE_CONCEPTO_ULT_MOV=ISNULL(ICON.NOMBRE_CONCEPTO,'')&#xA; ,GPR.NUMERO_MOVIMI_ULT_MOV=SE.NUMERO_MOVIMI&#xA; ,GPR.CONSECUT_MOVIMI_ULT_MOV=SE.CONSECUT_MOVIMI&#xA; ,GPR.FECHA_HORA_MOVIMI_ULT_MOV=SE.FECHA_HORA_MOVIMIENTO&#xA; --,GPR.ID_CONDUCTOR_ULT_MOV=DOC.ID_COURIER_CONDUCTOR&#xA; --,GPR.ID_AUXILIAR_ULT_MOV=DOC.ID_AUXILIAR1_VEHICULO&#xA; --,GPR.ID_PAIS_ZONA_URBA_ULT_MOV=DOC.ID_PAIS_ZONA_URBA  &#xA; --,GPR.ID_CIUDAD_ZONA_URBA_ULT_MOV=DOC.ID_CIUDAD_ZONA_URBA &#xA; --,GPR.ID_TIPO_ZONA_URBA_ULT_MOV=DOC.ID_TIPO_ZONA_URBA&#xA; --,GPR.ID_ZONA_URBA_ULT_MOV=DOC.ID_ZONA_URBA&#xA; FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; INNER JOIN MECE_LOGISTICO.dbo.SEGUIMIENTO_ENVIO SE WITH(NOLOCK) on se.NUMERO_GUIA=GPR.NUMERO_GUIA&#xA; --INNER JOIN MECE_LOGISTICO.dbo.DOCUMENTOS DOC (NOLOCK) ON&#xA; --DOC.ID_PROCESO=GPR.[ID_PROCESO_ULT_MOV] AND DOC.NUMERO_MOVIMI=GPR.[NUMERO_MOVIMI_ULT_MOV] AND DOC.CONSECUT_MOVIMI=GPR.[CONSECUT_MOVIMI_ULT_MOV]&#xA; INNER JOIN PARAMETROS.DBO.PROCESOS PRO (NOLOCK) ON PRO.ID_PROCESO=SE.ID_PROCESO&#xA; LEFT JOIN PARAMETROS.DBO.ITEM_CONCEPTO ICON (NOLOCK) ON ICON.ID_PAIS=1 AND ICON.ID_PROCESO=SE.ID_PROCESO AND ICON.ID_CONCEPTO=SE.ID_CONCEPTO&#xA; WHERE se.FECHA_HORA_MOVIMIENTO= (select MAX(se1.FECHA_HORA_MOVIMIENTO) from MECE_LOGISTICO.dbo.SEGUIMIENTO_ENVIO SE1 WITH(NOLOCK)&#xA;          where SE1.numero_guia=GPR.NUMERO_GUIA)&#xA; &#xA; UPDATE GPR SET&#xA; GPR.ID_CONDUCTOR_ULT_MOV=DOC.ID_COURIER_CONDUCTOR&#xA; ,GPR.ID_AUXILIAR_ULT_MOV=DOC.ID_AUXILIAR1_VEHICULO&#xA; ,GPR.ID_PAIS_ZONA_URBA_ULT_MOV=DOC.ID_PAIS_ZONA_URBA  &#xA; ,GPR.ID_CIUDAD_ZONA_URBA_ULT_MOV=DOC.ID_CIUDAD_ZONA_URBA &#xA; ,GPR.ID_TIPO_ZONA_URBA_ULT_MOV=DOC.ID_TIPO_ZONA_URBA&#xA; ,GPR.ID_ZONA_URBA_ULT_MOV=DOC.ID_ZONA_URBA&#xA; FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; INNER JOIN MECE_LOGISTICO.DBO.DOCUMENTOS DOC (NOLOCK) ON&#xA; DOC.ID_PROCESO=GPR.[ID_PROCESO_ULT_MOV] AND DOC.NUMERO_MOVIMI=GPR.[NUMERO_MOVIMI_ULT_MOV] AND DOC.CONSECUT_MOVIMI=GPR.[CONSECUT_MOVIMI_ULT_MOV]&#xA;&#xA; --SELECT GPR.ID_CONDUCTOR_ULT_MOV&#xA; &#xA; UPDATE GPR SET&#xA; GPR.ID_CONDUCTOR_ULT_MOV=ISNULL(RTRIM(LTRIM(EC.ID_EMPLEADO)),'')&#xA; ,GPR.CONDUCTOR_ULT_MOV =ISNULL(RTRIM(LTRIM(EC.NOMBRE_EMPLEADO)) +' '+ RTRIM(LTRIM(EC.APELLIDO_EMPLEADO)),'') &#xA; ,GPR.ID_AUXILIAR_ULT_MOV=ISNULL(RTRIM(LTRIM(EA.ID_EMPLEADO)),'')&#xA; ,GPR.AUXILIAR_ULT_MOV=ISNULL(RTRIM(LTRIM(EA.NOMBRE_EMPLEADO)) +' '+ RTRIM(LTRIM(EA.APELLIDO_EMPLEADO)),'') &#xA; FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; LEFT JOIN PARAMETROS.DBO.EMPLEADOS EC (NOLOCK) ON EC.ID_EMPLEADO=GPR.ID_CONDUCTOR_ULT_MOV&#xA; LEFT JOIN PARAMETROS.DBO.EMPLEADOS EA (NOLOCK) ON EA.ID_EMPLEADO=GPR.ID_AUXILIAR_ULT_MOV&#xA;&#xA;&#xA; --SELECT GPR.NUMERO_GUIA,ISNULL(DIV.NOMBRE_DIVISION,'') AS NOMBRE_CDS, ISNULL(CTCAN.[NOMBRE_CLASE_TIPO_CANAL],'') as TIPO_CANAL&#xA;UPDATE GPR SET NOMBRE_CDS_ULT_MOV=ISNULL(DIV.NOMBRE_DIVISION,''),&#xA; TIPO_CANAL_ULT_MOV=ISNULL(CTCAN.[NOMBRE_CLASE_TIPO_CANAL],'')&#xA; FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; --INNER JOIN MECE_LOGISTICO.DBO.DOCUMENTOS DOC (NOLOCK) ON&#xA; --DOC.ID_PROCESO=GPR.[ID_PROCESO_ULT_MOV] AND DOC.NUMERO_MOVIMI=GPR.[NUMERO_MOVIMI_ULT_MOV] AND DOC.CONSECUT_MOVIMI=GPR.[CONSECUT_MOVIMI_ULT_MOV]&#xA; INNER JOIN PARAMETROS.DBO.ZONASURBANAS Z (NOLOCK) &#xA; ON Z.ID_PAIS = GPR.ID_PAIS_ZONA_URBA_ULT_MOV AND Z.ID_CIUDAD = GPR.ID_CIUDAD_ZONA_URBA_ULT_MOV &#xA;  AND Z.ID_TIPO_ZONA_URBA = GPR.ID_TIPO_ZONA_URBA_ULT_MOV AND Z.ID_ZONA_URBA = GPR.ID_ZONA_URBA_ULT_MOV --AND Z.CATEGORIA_ZONA_URBA = 8 --CLICOH&#xA; INNER JOIN PARAMETROS.DBO.DIVISIONES DIV (NOLOCK) ON DIV.ID_PAIS = Z.ID_PAIS_CANAL AND DIV.ID_CIUDAD = Z.ID_CIUDAD_CANAL AND DIV.ID_DIVISION = Z.ID_CANAL&#xA; INNER JOIN [Mece_Logistico].[dbo].[CANALES] CAN (NOLOCK) ON CAN.id_pais=DIV.ID_PAIS and CAN.id_ciudad=DIV.ID_CIUDAD and CAN.[ID_DIVISION]=DIV.ID_DIVISION&#xA; INNER JOIN [Mece_Logistico].[dbo].[TIPOS_CANAL] TCAN (NOLOCK) ON TCAN.ID_TIPO_CANAL=CAN.ID_TIPO_CANAL AND TCAN.ID_EST_TIPO_CANAL=1&#xA; INNER JOIN PARAMETROS.[dbo].[CLASE_TIPO_CANAL] CTCAN (NOLOCK) ON CTCAN.ID_CLASE_TIPO_CANAL=TCAN.CLASE_TIPO_CANAL&#xA;&#xA;&#xA; --UPDATE GPR SET ESTADO_ENTREGA='VENCIDO'&#xA; --SELECT * FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; UPDATE GPR SET ESTADO_ENTREGA='VENCIDO'&#xA; FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; WHERE GPR.ID_PROCESO_ULT_MOV=9 AND ID_CONCEPTO_ULT_MOV IN(9,7,2,4)--9 ENTREGAS OFIC  C.O.D. Y/O LPC EMPRESARIO --7 EMPRESARIO SATELITE ENTREGA EN OFICINA&#xA; --2 RECLAMO OFICINA Y 4 C.O.D RECLAMO OFICINA&#xA; AND DATEDIFF(DAY, FECHA_HORA_MOVIMI_ULT_MOV,GETDATE())&gt;8 -- MAS DE 8 DIAS&#xA; &#xA; UPDATE GPR SET ESTADO_ENTREGA='VENCIDO'&#xA; FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; WHERE GPR.ID_PROCESO_ULT_MOV=31 --ENVIO PARA ENTREGA EN OFICINA&#xA; AND DATEDIFF(DAY, FECHA_HORA_MOVIMI_ULT_MOV,GETDATE())&gt;8 -- MAS DE 8 DIAS&#xA;&#xA; UPDATE GPR SET ESTADO_ENTREGA='VENCIDO'&#xA; FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; WHERE GPR.ID_PROCESO_ULT_MOV=9 AND ID_CONCEPTO_ULT_MOV IN(10,8) --10 ENTR A DOMICI  LPC / COD EMPRESARIOS SAT --8 EMPRESARIO SATELITE ENTREGA EN DOMICILIO&#xA; AND DATEDIFF(DAY, FECHA_HORA_MOVIMI_ULT_MOV,GETDATE())&gt;3-- MAS DE 3 DIAS&#xA; &#xA; UPDATE GPR SET ESTADO_ENTREGA='VENCIDO'&#xA; FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; WHERE GPR.ID_PROCESO_ULT_MOV=32 --ENVIO PARA ENTREGA A DOMICILIO&#xA; AND DATEDIFF(DAY, FECHA_HORA_MOVIMI_ULT_MOV,GETDATE())&gt;3-- MAS DE 3 DIAS&#xA;&#xA; UPDATE GPR SET ESTADO_ENTREGA='VENCIDO'&#xA; FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; WHERE GPR.ID_PROCESO_ULT_MOV=9 AND ID_CONCEPTO_ULT_MOV IN(1,3) --SALIDA A ZONA Y C.O.D EN DISTRIBUCION&#xA; AND DATEDIFF(DAY, FECHA_HORA_MOVIMI_ULT_MOV,GETDATE())&gt;1 --MAS DE UN DIA&#xA;&#xA;&#xA;&#xA;DROP TABLE IF EXISTS #TMP_GUIAS_PENDIENTE_RECAUDO_SZU&#xA; SELECT &#xA; TMP.NUMERO_GUIA&#xA; ,(SE.CONSECUT_MOVIMI)&#x9;&#x9;&#x9;AS CONSECUT_MOVIMI_SZU&#xA; ,(SE.NUMERO_MOVIMI)&#x9;&#x9;&#x9;&#x9;AS NUMERO_MOVIMI_SZU&#xA; ,(SE.FECHA_HORA_MOVIMIENTO)&#x9;&#x9;AS FECHA_HORA_MOVIMI_ULT_MOV_SZU&#xA;INTO #TMP_GUIAS_PENDIENTE_RECAUDO_SZU&#xA;FROM #TMP_GUIAS_PENDIENTE_RECAUDO TMP&#xA;INNER JOIN Mece_Logistico..SEGUIMIENTO_ENVIO SE&#xA;ON SE.NUMERO_GUIA=TMP.NUMERO_GUIA&#xA;WHERE SE.ID_PROCESO=9&#xA;---GROUP BY  TMP.NUMERO_GUIA&#xA;&#xA;;WITH CTE AS(&#xA;SELECT &#xA;ROWID = ROW_NUMBER() OVER(PARTITION BY NUMERO_GUIA ORDER BY FECHA_HORA_MOVIMI_ULT_MOV_SZU DESC)&#xA;,NUMERO_GUIA,FECHA_HORA_MOVIMI_ULT_MOV_SZU&#xA;FROM #TMP_GUIAS_PENDIENTE_RECAUDO_SZU&#xA;)&#xA;DELETE CTE WHERE ROWID&gt;1&#xA;&#xA;&#xA;&#xA;--SELECT * FROM #TMP_GUIAS_PENDIENTE_RECAUDO TMP&#xA;&#xA;&#xA;&#xA;DROP TABLE IF EXISTS #TMP_GUIAS_CON_TAREAS &#xA; SELECT &#xA; TMP.NUMERO_GUIA,&#xA; COUNT(TAR.NUMERO_DOCPROBLEMA) AS NUMERO_TAREAS&#xA;INTO #TMP_GUIAS_CON_TAREAS&#xA;FROM #TMP_GUIAS_PENDIENTE_RECAUDO TMP&#xA;INNER JOIN Mece_Logistico..TAREAS TAR WITH(NOLOCK)&#xA;ON TAR.NUMERO_DOCPROBLEMA=CONVERT(CHAR(20),TMP.NUMERO_GUIA)&#xA;GROUP BY TMP.NUMERO_GUIA&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;DROP TABLE IF EXISTS ##TMP_GUIAS_PENDIENTE_RECAUDO_FINAL_PBI;&#xA;SELECT --GPR.*&#xA;GPR.NUMERO_GUIA &#xA;--GPR.ID_ESTADOENVIO &#xA;,GPR.NOMBRE_ESTADOENVIO &#xA;,GPR.FORMA_PAGO &#xA;,GPR.VALOR_A_RECAUDAR &#xA;,GPR.ID_REMITE &#xA;,GPR.NOMBRE_REMITE_GUIA &#xA;,GPR.FECHA_ENVIO&#xA;,GPR.VALOR_RECAUDADO&#xA;,GPR.FECHA_RECAUDO&#xA;,GPR.NUMERO_ORDEN_SERVICIO&#xA;,GPR.FECHA_RECAUDO_EFECTY&#xA;,GPR.ESTADO_ENTREGA&#xA;--,GPR.NOMBRE_RESPONSABLE_ULT_MOV &#xA;--ID_PROCESO_ULT_MOV &#xA;--NOMBRE_PROCESO_ULT_MOV &#xA;--NUMERO_MOVIMI_ULT_MOV &#xA;--CONSECUT_MOVIMI_ULT_MOV &#xA;--FECHA_HORA_MOVIMI_ULT_MOV&#xA;&#xA;--,ISNULL(ISNULL(CLO.CENTRO_LOGISTICO,CLD.CENTRO_LOGISTICO),'')  AS CPL_ORIGEN_ULT_MOV&#xA;--,ISNULL(ISNULL(RO.NOMBRE_REGIONAL,RD.NOMBRE_REGIONAL),'')  AS REGIONAL_ORIGEN_ULT_MOV&#xA;--,ISNULL(ISNULL(CO.NOMBRE_CIUDAD,CD.NOMBRE_CIUDAD),'')  AS CIUDAD_ORIGEN_ULT_MOV&#xA;--,ISNULL(ISNULL(CLD.CENTRO_LOGISTICO,CLO.CENTRO_LOGISTICO),'') AS CPL_DESTINO_ULT_MOV&#xA;--,ISNULL(ISNULL(RD.NOMBRE_REGIONAL,RO.NOMBRE_REGIONAL),'') AS REGIONAL_DESTINO_ULT_MOV&#xA;--,ISNULL(ISNULL(CD.NOMBRE_CIUDAD,CO.NOMBRE_CIUDAD),'') AS CIUDAD_DESTINO_MOV&#xA;,CASE WHEN ID_PROCESO!=14 THEN &#xA;ISNULL(ISNULL(CLO.CENTRO_LOGISTICO,CLD.CENTRO_LOGISTICO),'')  ELSE ISNULL(ISNULL(CLD.CENTRO_LOGISTICO,CLO.CENTRO_LOGISTICO),'') END AS CPL_ULT_MOV&#xA;,CASE WHEN ID_PROCESO!=14 THEN &#xA;ISNULL(ISNULL(RO.NOMBRE_REGIONAL,RD.NOMBRE_REGIONAL),'') ELSE ISNULL(ISNULL(RD.NOMBRE_REGIONAL,RO.NOMBRE_REGIONAL),'') END  AS REGIONAL_ULT_MOV&#xA;,CASE WHEN ID_PROCESO!=14 THEN &#xA;ISNULL(ISNULL(CO.NOMBRE_CIUDAD,CD.NOMBRE_CIUDAD),'')  ELSE ISNULL(ISNULL(CD.NOMBRE_CIUDAD,CO.NOMBRE_CIUDAD),'') END  AS CIUDAD_ULT_MOV&#xA;,ISNULL(CASE &#xA; WHEN ISNULL(DOC.ID_CIUDAD_ZONA_URBA,0) !=0 THEN&#xA; ROZ.NOMBRE_REGIONAL+' - '+ DCOZ.NOMBRE_DEPARTAMENTO +' - '+ COZ.NOMBRE_CIUDAD &#xA; WHEN  ISNULL(DOC.ID_CIUDAD_DIVISION_ORIGEN,0) !=0 AND DOC.ID_PROCESO!=14 THEN&#xA; ROM.NOMBRE_REGIONAL+' - '+ DCOM.NOMBRE_DEPARTAMENTO +' - '+ COM.NOMBRE_CIUDAD&#xA; ELSE&#xA; ROD.NOMBRE_REGIONAL+' - '+ DCOD.NOMBRE_DEPARTAMENTO +' - '+ COD.NOMBRE_CIUDAD &#xA; END,'') AS REG_DEPART_CIUDAD_ULTIMO_MOV&#xA;&#xA;,ISNULL(DOC.PLACA_VEHICULO_DOCU,'') as PLACA_VEHICULO_ULTIMO_MOV&#xA;,ISNULL(O.[NOMBRE_OPERATIVO],'') AS NOMBRE_OPERATIVO_ULTIMO_MOV&#xA;,ISNULL(Z.NOMBRE_ZONA_URBA,'') AS ZONA_URBANA_ULTIMO_MOV&#xA;,ISNULL(CZ.NOMBRE_CATEGORIA,'') AS CATEGORIA_ZONA_ULTIMO_MOV&#xA;,ISNULL(TZU.NOMBRE_TIPO_ZONA_URBA,'') AS TIPO_ZONA_ULTIMO_MOV&#xA;,ISNULL(GPR.NOMBRE_CDS_ULT_MOV,'') AS NOMBRE_CDS_ULT_MOV&#xA;,ISNULL(TIPO_CANAL_ULT_MOV,'') AS TIPO_CANAL_ULT_MOV&#xA;--,GR.ID_PROCESO &#xA;,ISNULL(GPR.NOMBRE_PROCESO_ULT_MOV,'') AS PROCESO_LOG_ULTIMO_MOV  &#xA;,ISNULL(GPR.NOMBRE_CONCEPTO_ULT_MOV,'') AS CONCEPTO_ULT_MOV&#xA;--,GR.ID_CONCEPTO  &#xA;--,GR.FECHA_HORA_MOVIMIENTO&#xA;,ISNULL(cast(GPR.ID_PROCESO_ULT_MOV as nvarchar) +' - '+ RTRIM(GPR.NOMBRE_PROCESO_ULT_MOV),'') AS NOMBRE_ULTIMO_MOV&#xA;,ISNULL(CASE WHEN DIO.ID_DIVISION IS NOT NULL THEN cast(DIO.ID_DIVISION as nvarchar) +' - '+ RTRIM(DIO.NOMBRE_DIVISION)&#xA;ELSE cast(DID.ID_DIVISION as nvarchar) +' - '+ RTRIM(DID.NOMBRE_DIVISION) END,'') AS BODEGA_ULTIMO_MOV&#xA;,ISNULL(cast(GPR.ID_PROCESO_ULT_MOV as nvarchar) +' - '+ RTRIM(GPR.[NUMERO_MOVIMI_ULT_MOV])+' - '+  cast(GPR.[CONSECUT_MOVIMI_ULT_MOV] as nvarchar),'') as ULTIMO_MOV_LOGISTICO&#xA;,ISNULL(CONVERT(nvarchar(20),GPR.FECHA_HORA_MOVIMI_ULT_MOV,120),'') AS FECHA_ULTIMO_MOV&#xA;,GPR.ID_CONDUCTOR_ULT_MOV&#xA;,GPR.CONDUCTOR_ULT_MOV&#xA;,GPR.ID_AUXILIAR_ULT_MOV&#xA;,GPR.AUXILIAR_ULT_MOV&#xA;,GPR.ID_CLIENTE&#xA;,SZU.CONSECUT_MOVIMI_SZU&#xA;,SZU.NUMERO_MOVIMI_SZU&#xA;,SZU.FECHA_HORA_MOVIMI_ULT_MOV_SZU&#xA;,GPR.NOMBRE_TIPO_CANAL&#xA;,GPR.NOMBRE_CLASE_TIPO_CANAL&#xA;,TAR.NUMERO_TAREAS&#xA;,G_ID_CIUDAD_ORIGEN&#xA;,G_ID_CIUDAD_DESTINO&#xA;,CNF_ID_CONFIRMACION = 0&#xA;--,DOC.*&#xA;INTO ##TMP_GUIAS_PENDIENTE_RECAUDO_FINAL_PBI&#xA;&#xA;FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA;--------------------------- CIUDAD ULTIMO MOV ZONA&#xA;  LEFT JOIN MECE_LOGISTICO.DBO.DOCUMENTOS DOC (NOLOCK) ON&#xA; DOC.ID_PROCESO=GPR.[ID_PROCESO_ULT_MOV] AND DOC.NUMERO_MOVIMI=GPR.[NUMERO_MOVIMI_ULT_MOV] AND DOC.CONSECUT_MOVIMI=GPR.[CONSECUT_MOVIMI_ULT_MOV]&#xA; --AND DOC.ID_DIVISION_DESTINO IN (9311, 9308, 9304, 9313, 9310, 9312, 9711, 9710)&#xA;  LEFT JOIN PARAMETROS.DBO.CIUDADES COZ (NOLOCK) ON  COZ.ID_PAIS=1 AND COZ.ID_CIUDAD=DOC.ID_CIUDAD_ZONA_URBA&#xA;  LEFT JOIN PARAMETROS.DBO.REGIONALES_PAIS ROZ (NOLOCK) ON  ROZ.ID_PAIS=COZ.ID_PAIS AND ROZ.ID_REGIONAL=COZ.ID_REGIONAL&#xA;  LEFT JOIN PARAMETROS.DBO.DEPARTAMENTOS DCOZ (NOLOCK) ON  DCOZ.ID_PAIS=COZ.ID_PAIS AND DCOZ.ID_DEPARTAMENTO=COZ.ID_DEPARTAMENTO&#xA;   LEFT JOIN PARAMETROS.DBO.ZONASURBANAS Z (NOLOCK) &#xA; ON Z.ID_PAIS = DOC.ID_PAIS_ZONA_URBA AND Z.ID_CIUDAD = DOC.ID_CIUDAD_ZONA_URBA AND Z.ID_TIPO_ZONA_URBA = DOC.ID_TIPO_ZONA_URBA AND Z.ID_ZONA_URBA = DOC.ID_ZONA_URBA --AND Z.CATEGORIA_ZONA_URBA = 8 --CLICOH&#xA;  LEFT JOIN [PARAMETROS].[dbo].[CATEGORIAZONASURBANAS] CZ (NOLOCK) ON CZ.Id_Categoria=Z.CATEGORIA_ZONA_URBA&#xA;  LEFT JOIN [PARAMETROS].[dbo].[TIPOSZONASURBANAS] TZU (NOLOCK) ON TZU.ID_TIPO_ZONA_URBA=Z.ID_TIPO_ZONA_URBA&#xA; --------------------------- CIUDAD ULTIMO MOV DOCUMENTO&#xA;  LEFT JOIN PARAMETROS.DBO.CIUDADES COM (NOLOCK) ON  COM.ID_PAIS=1 AND COM.ID_CIUDAD=DOC.ID_CIUDAD_DIVISION_ORIGEN&#xA;  LEFT JOIN PARAMETROS.DBO.REGIONALES_PAIS ROM (NOLOCK) ON  ROM.ID_PAIS=COM.ID_PAIS AND ROM.ID_REGIONAL=COM.ID_REGIONAL&#xA;  LEFT JOIN PARAMETROS.DBO.DEPARTAMENTOS DCOM (NOLOCK) ON  DCOM.ID_PAIS=COM.ID_PAIS AND DCOM.ID_DEPARTAMENTO=COM.ID_DEPARTAMENTO&#xA;  --------------------------- CIUDAD DESTINO ULTIMO MOV DOCUMENTO&#xA;  LEFT JOIN PARAMETROS.DBO.CIUDADES COD(NOLOCK) ON  COD.ID_PAIS=1 AND COD.ID_CIUDAD=DOC.ID_CIUDAD_DESTINO&#xA;  LEFT JOIN PARAMETROS.DBO.REGIONALES_PAIS ROD (NOLOCK) ON  ROD.ID_PAIS=COD.ID_PAIS AND ROD.ID_REGIONAL=COD.ID_REGIONAL&#xA;  LEFT JOIN PARAMETROS.DBO.DEPARTAMENTOS DCOD (NOLOCK) ON  DCOD.ID_PAIS=COD.ID_PAIS AND DCOD.ID_DEPARTAMENTO=COD.ID_DEPARTAMENTO&#xA;  --------------------------- DIVISION ORIGEN ULTIMO MOV DOCUMENTO&#xA;  LEFT JOIN PARAMETROS.DBO.DIVISIONES DIO(NOLOCK) ON DIO.ID_PAIS=DOC.ID_PAIS_DIVISION_ORIGEN&#xA; AND DIO.ID_CIUDAD=DOC.ID_CIUDAD_DIVISION_ORIGEN AND DIO.ID_DIVISION=DOC.ID_DIVISION_ORIGEN&#xA;  --------------------------- DIVISION DESTINO ULTIMO MOV DOCUMENTO&#xA;  LEFT JOIN PARAMETROS.DBO.DIVISIONES DID(NOLOCK) ON DID.ID_PAIS=DOC.ID_PAIS_DESTINO&#xA; AND DID.ID_CIUDAD=DOC.ID_CIUDAD_DESTINO AND DID.ID_DIVISION=DOC.ID_DIVISION_DESTINO&#xA;-------------------------------------------------------------&#xA;  LEFT JOIN [PARAMETROS].[dbo].CIUDADES CO (NOLOCK) ON CO.ID_PAIS=ID_PAIS_DIVISION_ORIGEN AND CO.ID_CIUDAD=DOC.ID_CIUDAD_DIVISION_ORIGEN&#xA;  LEFT JOIN [PARAMETROS].[dbo].REGIONALES_PAIS RO (NOLOCK) ON RO.ID_PAIS=1 AND RO.ID_REGIONAL=CO.[ID_REGIONAL]&#xA;  LEFT JOIN [PARAMETROS].[dbo].CIUDADES CD (NOLOCK) ON CD.ID_PAIS=DOC.ID_PAIS_DESTINO AND CD.ID_CIUDAD=DOC.ID_CIUDAD_DESTINO&#xA;  LEFT JOIN [PARAMETROS].[dbo].REGIONALES_PAIS RD (NOLOCK) ON RD.ID_PAIS=1 AND RD.ID_REGIONAL=CD.[ID_REGIONAL]&#xA;  LEFT JOIN [PARAMETROS].[dbo].[OPERATIVOS] O (NOLOCK) ON O.[ID_PAIS_ORIGEN]=DOC.ID_PAIS_OPERATIVO AND O.[ID_CIUDAD_ORIGEN]=DOC.ID_CIUDAD_OPERATIVO&#xA; AND O.[ID_OPERATIVO]=DOC.ID_OPERATIVO&#xA;  LEFT JOIN #TMP_CIUDADES_ANEXAS CAO (NOLOCK) ON CAO.ID_PAIS=1 AND CAO.[ID_CIUDAD_ANEXA]=CO.ID_CIUDAD --AND CAO.RECOLECCION=1&#xA;  LEFT JOIN PARAMETROS.DBO.CENTROS_LOGISTICOS CLO (NOLOCK) ON CLO.ID_PAIS=1 AND CLO.ID_CIUDAD=CAO.ID_CIUDAD AND CLO.ID_CENTRO_LOGISTICO=1 AND CLO.ID_ESTADO=1&#xA;  LEFT JOIN #TMP_CIUDADES_ANEXAS CAD (NOLOCK) ON CAD.ID_PAIS=1 AND CAD.[ID_CIUDAD_ANEXA]=CD.ID_CIUDAD --AND CAD.RECOLECCION=1&#xA;  LEFT JOIN PARAMETROS.DBO.CENTROS_LOGISTICOS CLD (NOLOCK) ON CLD.ID_PAIS=1 AND CLD.ID_CIUDAD=CAD.ID_CIUDAD AND CLD.ID_CENTRO_LOGISTICO=1 AND CLD.ID_ESTADO=1&#xA;LEFT JOIN #TMP_GUIAS_PENDIENTE_RECAUDO_SZU SZU ON SZU.NUMERO_GUIA=GPR.NUMERO_GUIA&#xA;LEFT JOIN #TMP_GUIAS_CON_TAREAS TAR ON TAR.NUMERO_GUIA=GPR.NUMERO_GUIA&#xA;&#xA;&#xA;UPDATE G SET &#xA;CNF_ID_CONFIRMACION=1&#xA;from ##TMP_GUIAS_PENDIENTE_RECAUDO_FINAL_PBI G&#xA;INNER JOIN [Mece_Logistico].[dbo].[CONFIRMACIONES] GC (NOLOCK) ON GC.NUMERO_GUIA=G.NUMERO_GUIA  &#xA;  WHERE GC.ID_SOLUCION IN (3,13,19)--DEVOLUCION A REMITENTE&#xA;  AND GC.FECHA_CONFIRMACION = (SELECT MAX(GC1.FECHA_CONFIRMACION) &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;FROM [Mece_Logistico].[dbo].[CONFIRMACIONES] GC1 (NOLOCK) &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHERE GC1.NUMERO_GUIA=G.NUMERO_GUIA AND GC1.ID_SOLUCION IN (3,13,19))&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;--select  * from ##TMP_GUIAS_PENDIENTE_RECAUDO_FINAL_PBI&#xA;&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Tareas Backap"
      DTS:CreationName="STOCK:SEQUENCE"
      DTS:Description="Sequence Container"
      DTS:Disabled="True"
      DTS:DTSID="{886B145C-1883-4A0C-B12B-352DC815BE7E}"
      DTS:ExecutableType="STOCK:SEQUENCE"
      DTS:LocaleID="-1"
      DTS:ObjectName="Tareas Backap">
      <DTS:Variables />
      <DTS:Executables>
        <DTS:Executable
          DTS:refId="Package\Tareas Backap\BACKUP AJUSTES 20260427"
          DTS:CreationName="STOCK:SEQUENCE"
          DTS:Description="Sequence Container"
          DTS:Disabled="True"
          DTS:DTSID="{4DF1AC55-269C-4DF6-AC53-4BFF205E0A10}"
          DTS:ExecutableType="STOCK:SEQUENCE"
          DTS:LocaleID="-1"
          DTS:ObjectName="BACKUP AJUSTES 20260427">
          <DTS:Variables />
          <DTS:Executables>
            <DTS:Executable
              DTS:refId="Package\Tareas Backap\BACKUP AJUSTES 20260427\Prepatacion data Recudo LPC COD 1"
              DTS:CreationName="Microsoft.ExecuteSQLTask"
              DTS:Description="Execute SQL Task"
              DTS:Disabled="True"
              DTS:DTSID="{2db18fae-f06b-4f6c-9e5d-a7f194810d12}"
              DTS:ExecutableType="Microsoft.ExecuteSQLTask"
              DTS:LocaleID="-1"
              DTS:ObjectName="Prepatacion data Recudo LPC COD 1"
              DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
              DTS:ThreadHint="1">
              <DTS:Variables />
              <DTS:ObjectData>
                <SQLTask:SqlTaskData
                  SQLTask:Connection="{20AF370D-4C8E-4E05-91E7-8F81200FAADC}"
                  SQLTask:SqlStatementSource="DECLARE @FECH_INI DATETIME =  ? ; /*---   '20260101';   */&#xA;DECLARE @FECH_FIN DATETIME =  ? ; /*---   '20260101';   */&#xA;&#xA;IF OBJECT_ID('tempdb..#COD_PENDIENTE_POR_RECAUDO') IS NOT NULL &#xA;    DROP TABLE #COD_PENDIENTE_POR_RECAUDO&#xA;&#xA;IF OBJECT_ID('tempdb..#TMP_GUIAS_PENDIENTE_RECAUDO') IS NOT NULL &#xA;    DROP TABLE #TMP_GUIAS_PENDIENTE_RECAUDO&#xA;&#xA;CREATE TABLE #TMP_GUIAS_PENDIENTE_RECAUDO(&#xA; NUMERO_GUIA numeric(20, 0) NOT NULL,&#xA; ID_ESTADOENVIO smallint DEFAULT 0,&#xA; NOMBRE_ESTADOENVIO varchar(40) DEFAULT '',&#xA; FORMA_PAGO varchar(40) DEFAULT '',&#xA; VALOR_A_RECAUDAR numeric(12, 2) NULL,&#xA; ID_REMITE [varchar](40) DEFAULT '',&#xA; NOMBRE_REMITE_GUIA  [varchar](200) DEFAULT '',&#xA; -- ID_CIUDAD INT DEFAULT 0,&#xA; -- [NOMBRE_CIUDAD] [varchar](50) DEFAULT '',&#xA; FECHA_ENVIO datetime NULL,&#xA; [VALOR_RECAUDADO] [numeric](11, 2) DEFAULT 0,&#xA; FECHA_RECAUDO datetime NULL,&#xA; NUMERO_ORDEN_SERVICIO varchar(20) DEFAULT '',&#xA; FECHA_RECAUDO_EFECTY datetime NULL,&#xA; ESTADO_ENTREGA varchar(70) DEFAULT 'A TIEMPO',--A TIEMPO O VENCIDO&#xA; --NOMBRE_RESPONSABLE_ULT_MOV VARCHAR(100) DEFAULT '',&#xA; ID_PROCESO_ULT_MOV int DEFAULT 0,&#xA; NOMBRE_PROCESO_ULT_MOV varchar(70) DEFAULT '',&#xA; ID_CONCEPTO_ULT_MOV int DEFAULT 0,&#xA; NOMBRE_CONCEPTO_ULT_MOV varchar(70) DEFAULT '',&#xA; NUMERO_MOVIMI_ULT_MOV char(30) DEFAULT '',&#xA; CONSECUT_MOVIMI_ULT_MOV numeric(7, 0) DEFAULT 0,&#xA; FECHA_HORA_MOVIMI_ULT_MOV datetime NULL,&#xA; ID_PAIS_ZONA_URBA_ULT_MOV SMALLINT NULL,&#xA; ID_CIUDAD_ZONA_URBA_ULT_MOV INT NULL,&#xA; ID_TIPO_ZONA_URBA_ULT_MOV SMALLINT NULL,&#xA; ID_ZONA_URBA_ULT_MOV SMALLINT NULL,&#xA; NOMBRE_CDS_ULT_MOV varchar(100) DEFAULT '',&#xA; TIPO_CANAL_ULT_MOV varchar(40) DEFAULT '',&#xA; ID_CONDUCTOR_ULT_MOV varchar(40) DEFAULT '',&#xA; CONDUCTOR_ULT_MOV  varchar(200) DEFAULT '',&#xA; ID_AUXILIAR_ULT_MOV varchar(40) DEFAULT '',&#xA; AUXILIAR_ULT_MOV varchar(200) DEFAULT '',&#xA; ID_CLIENTE [char](20) NOT NULL,&#xA; NOMBRE_TIPO_CANAL varchar(100) DEFAULT '',&#xA; NOMBRE_CLASE_TIPO_CANAL varchar(100) DEFAULT '',&#xA; [G_ID_CIUDAD_ORIGEN] [int] NULL,&#xA; [G_ID_CIUDAD_DESTINO] [int] NULL&#xA;) ON [PRIMARY]&#xA;CREATE NONCLUSTERED INDEX [IX_NUMERO_GUIA] ON #TMP_GUIAS_PENDIENTE_RECAUDO ([NUMERO_GUIA] ASC)&#xA;CREATE NONCLUSTERED INDEX [IX_ZONA] ON #TMP_GUIAS_PENDIENTE_RECAUDO (ID_PAIS_ZONA_URBA_ULT_MOV,ID_CIUDAD_ZONA_URBA_ULT_MOV, ID_TIPO_ZONA_URBA_ULT_MOV,ID_ZONA_URBA_ULT_MOV ASC)&#xA;CREATE NONCLUSTERED INDEX [IX_MANIFIESTO] ON #TMP_GUIAS_PENDIENTE_RECAUDO (ID_PROCESO_ULT_MOV,NUMERO_MOVIMI_ULT_MOV,CONSECUT_MOVIMI_ULT_MOV ASC)&#xA;&#xA;&#xA;IF OBJECT_ID('tempdb..#TMP_CIUDADES_ANEXAS') IS NOT NULL &#xA;    DROP TABLE #TMP_CIUDADES_ANEXAS&#xA;&#xA;---CIUDADES ANEXAS&#xA;SELECT CAD.* &#xA;INTO #TMP_CIUDADES_ANEXAS FROM PARAMETROS.DBO.CIUDADES_ANEXAS CAD (NOLOCK) &#xA;WHERE CAD.ID_PAIS=1 AND CAD.RECOLECCION=1&#xA;&#xA;INSERT INTO #TMP_CIUDADES_ANEXAS&#xA;SELECT CAD.* FROM PARAMETROS.DBO.CIUDADES_ANEXAS CAD (NOLOCK) &#xA;LEFT JOIN #TMP_CIUDADES_ANEXAS TCAD ON TCAD.ID_CIUDAD_ANEXA=CAD.ID_CIUDAD_ANEXA&#xA;WHERE CAD.ID_PAIS=1 AND CAD.RECOLECCION=0 AND TCAD.ID_CIUDAD_ANEXA IS NULL&#xA;&#xA;DELETE T FROM (SELECT *, &#xA;    DupRank = ROW_NUMBER() OVER (PARTITION BY ID_CIUDAD_ANEXA ORDER BY FECHA_CREACION DESC) &#xA;     FROM #TMP_CIUDADES_ANEXAS) AS T&#xA;WHERE DupRank &gt; 1&#xA;&#xA;&#xA;&#xA;SELECT CPR.*&#xA;,G.ID_CLIENTE,G.ID_REMITE,G.NOMBRE_REMITE_GUIA&#xA;,G.ID_PRODUCTO AS ID_PRODUCTO_GUIA&#xA;,G.ID_ESTADOENVIO&#xA;,G.ID_ESTADOGUIA&#xA;,ISNULL(G.VALOR_SEG_MAN_GUIAS,0)+ISNULL(G.VALOR_FLETES_GUIAS,0) AS VALOR_ENVIO_GUIA&#xA;,ISNULL(GIA.VALOR_RECAUDAR_PRODUCTO,0) AS VALOR_RECAUDAR_PRODUCTO_GUIA&#xA;,CAST('' AS nvarchar(50)) AS NOMBRE_ESTADOENVIO,G.FECHA_ENVIO&#xA;,TCAN.NOMBRE_TIPO_CANAL&#xA;,CTCAN.NOMBRE_CLASE_TIPO_CANAL&#xA;,G.[ID_CIUDAD_ORIGEN]   AS G_ID_CIUDAD_ORIGEN&#xA;,G.[ID_CIUDAD_DESTINO]   AS G_ID_CIUDAD_DESTINO&#xA;INTO #COD_PENDIENTE_POR_RECAUDO&#xA;FROM [Mece_Logistico].[dbo].[COD_PENDIENTE_POR_RECAUDO] CPR (NOLOCK)&#xA;INNER JOIN [Mece_Logistico].[dbo].[GUIAS] G (nolock) ON G.NUMERO_GUIA=CPR.NUMERO_GUIA&#xA;LEFT JOIN [Mece_Logistico].[dbo].[GUIAS_INF_ADICIONAL] GIA (nolock) ON GIA.NUMERO_GUIA=CPR.NUMERO_GUIA&#xA;LEFT JOIN [tmp_borrar_local].dbo.LPC_GUIAS_SOLUCIONADAS LGS (NOLOCK) ON LGS.NUMERO_GUIA=CPR.NUMERO_GUIA&#xA;LEFT JOIN [Mece_Logistico].[dbo].[CANALES] CAN (NOLOCK) ON CAN.id_pais=G.ID_1 and CAN.id_ciudad=G.ID_2 and CAN.[ID_DIVISION]=G.ID_CANAL&#xA;LEFT JOIN [Mece_Logistico].[dbo].[TIPOS_CANAL] TCAN (NOLOCK) ON TCAN.ID_TIPO_CANAL=CAN.ID_TIPO_CANAL AND TCAN.ID_EST_TIPO_CANAL=1&#xA;LEFT JOIN PARAMETROS.[dbo].[CLASE_TIPO_CANAL] CTCAN (NOLOCK) ON CTCAN.ID_CLASE_TIPO_CANAL=TCAN.CLASE_TIPO_CANAL&#xA;WHERE LGS.NUMERO_GUIA IS NULL &#xA;/*AND ISNULL(CPR.ESTADO_COD,1)=1-- RECAUDO ESTA ACTIVO*/---&gt;(se descarta por solicitud de luis gabriel rodriguez y Holman Salamanca el dia 2026-04-09 11:44am )&#xA;AND ISNULL(CPR.ESTA_RECAUDADO,0)=0 -- NO ESTA RECAUDADO&#xA;--AND G.ID_ESTADOGUIA!=4-- NO ESTA ANULADA&#xA;AND ISNULL(CPR.NUMERO_ORDEN_SERVICIO,'')='' -- NO TIENE ORDEN DE RECAUDO DE EFECTY&#xA;AND ISNULL(CPR.ESTA_ANULADO,0)=0 -- NO DEBE ESTAR ANULADA&#xA;AND G.ID_DIVISION_PROV IS NULL&#xA;--AND CPR.FECHA_CREACION &gt;= @FECHA_INI &#xA;--AND CPR.FECHA_CREACION &lt; @FECHA_FIN&#xA;AND CPR.FECHA_CREACION BETWEEN convert(datetime,@FECH_INI) AND convert(datetime,@FECH_FIN)&#xA;--AND CPR.NUMERO_GUIA= 2276053288&#xA;&#xA;&#xA;/*&#xA;AND CPR.FECHA_CREACION BETWEEN convert(datetime,'20251201') &#xA;       AND convert(datetime,'20260201')&#xA;*/&#xA;&#xA;&#xA;INSERT INTO #COD_PENDIENTE_POR_RECAUDO&#xA;/*&#xA;SELECT CPR.*,G.ID_CLIENTE,G.ID_REMITE,G.NOMBRE_REMITE_GUIA,G.ID_PRODUCTO AS ID_PRODUCTO_GUIA,G.ID_ESTADOENVIO,G.ID_ESTADOGUIA,ISNULL(G.VALOR_SEG_MAN_GUIAS,0)+ISNULL(G.VALOR_FLETES_GUIAS,0) AS VALOR_ENVIO_GUIA,ISNULL(GIA.VALOR_RECAUDAR_PRODUCTO,0) AS VALOR_RECAUDAR_PRODUCTO_GUIA&#xA;,CAST('' AS nvarchar(50)) AS NOMBRE_ESTADOENVIO,G.FECHA_ENVIO&#xA;*/&#xA;SELECT CPR.*&#xA;,G.ID_CLIENTE,G.ID_REMITE,G.NOMBRE_REMITE_GUIA&#xA;,G.ID_PRODUCTO AS ID_PRODUCTO_GUIA&#xA;,G.ID_ESTADOENVIO&#xA;,G.ID_ESTADOGUIA&#xA;,ISNULL(G.VALOR_SEG_MAN_GUIAS,0)+ISNULL(G.VALOR_FLETES_GUIAS,0) AS VALOR_ENVIO_GUIA&#xA;,ISNULL(GIA.VALOR_RECAUDAR_PRODUCTO,0) AS VALOR_RECAUDAR_PRODUCTO_GUIA&#xA;,CAST('' AS nvarchar(50)) AS NOMBRE_ESTADOENVIO,G.FECHA_ENVIO&#xA;,TCAN.NOMBRE_TIPO_CANAL&#xA;,CTCAN.NOMBRE_CLASE_TIPO_CANAL&#xA;,G.[ID_CIUDAD_ORIGEN]   AS G_ID_CIUDAD_ORIGEN&#xA;,G.[ID_CIUDAD_DESTINO]   AS G_ID_CIUDAD_DESTINO&#xA;FROM [Mece_Logistico].[dbo].[COD_PENDIENTE_POR_RECAUDO] CPR (NOLOCK)&#xA;INNER JOIN [Mece_Logistico].[dbo].[GUIAS] G (nolock) ON G.NUMERO_GUIA=CPR.NUMERO_GUIA&#xA;LEFT JOIN [Mece_Logistico].[dbo].[GUIAS_INF_ADICIONAL] GIA (nolock) ON GIA.NUMERO_GUIA=CPR.NUMERO_GUIA&#xA;LEFT JOIN [tmp_borrar_local].dbo.LPC_GUIAS_SOLUCIONADAS LGS (NOLOCK) ON LGS.NUMERO_GUIA=CPR.NUMERO_GUIA&#xA;LEFT JOIN [Mece_Logistico].[dbo].[CANALES] CAN (NOLOCK) ON CAN.id_pais=G.ID_1 and CAN.id_ciudad=G.ID_2 and CAN.[ID_DIVISION]=G.ID_CANAL&#xA;LEFT JOIN [Mece_Logistico].[dbo].[TIPOS_CANAL] TCAN (NOLOCK) ON TCAN.ID_TIPO_CANAL=CAN.ID_TIPO_CANAL AND TCAN.ID_EST_TIPO_CANAL=1&#xA;LEFT JOIN PARAMETROS.[dbo].[CLASE_TIPO_CANAL] CTCAN (NOLOCK) ON CTCAN.ID_CLASE_TIPO_CANAL=TCAN.CLASE_TIPO_CANAL&#xA;WHERE LGS.NUMERO_GUIA IS NULL AND&#xA;ISNULL(CPR.ESTADO_COD,1)=1-- RECAUDO ESTA ACTIVO&#xA;AND ISNULL(CPR.ESTA_ANULADO,0)=0 -- NO DEBE ESTAR ANULADA&#xA;AND ISNULL(CPR.ESTA_RECAUDADO,0)=1 -- RECAUDADO EN RECAUDOS PERO NO TIENE LA FORMADE RECAUDO&#xA;AND (ISNULL(CPR.NUMERO_ORDEN_SERVICIO,'')='' AND ISNULL(CPR.ID_MODALPAGO,0)=0 AND ISNULL(RTRIM(LTRIM(CPR.NUMERO_APROBACION)),'')='' AND ISNULL(INGRESO_MANUAL,0)=0)&#xA;AND G.ID_DIVISION_PROV IS NULL&#xA;--AND CPR.FECHA_CREACION&gt;=DATEADD(YEAR, -1,GETDATE())&#xA;AND CPR.FECHA_CREACION BETWEEN convert(datetime,@FECH_INI) AND convert(datetime,@FECH_FIN)&#xA;--AND CPR.NUMERO_GUIA= 2276053288&#xA;&#xA;&#xA;&#xA;; WITH CTE_DELL AS ( SELECT ROW_NUMBER() OVER(PARTITION BY NUMERO_GUIA ORDER BY FECHA_ACTUALIZACION DESC) AS ROWID,&#xA;      NUMERO_GUIA FROM #COD_PENDIENTE_POR_RECAUDO) DELETE CTE_DELL WHERE ROWID&gt;1&#xA;&#xA;---SELECT TOP 100 * FROM #COD_PENDIENTE_POR_RECAUDO&#xA;&#xA;&#xA;--Id_Cod NUMERO_GUIA ID_PAIS ID_CIUDAD ID_AUXILIAR ID_DIVISION_RECAUDADORA ID_CIUDAD_ORIGEN ID_CIUDAD_ENTREGA FECHA_ASIGNACION_AL_AUXILIAR ESTADO_COD ESTA_RECAUDADO FECHA_RECAUDO ESTA_DEVUELTO FECHA_DEVOLUCION ESTA_ANULADO FECHA_ANULACION CAUSAL_DEVOLUCION VALOR_ENVIO ES_COD_CORPORATIVO NUMERO_FACTURA VALOR_RECAUDADO VALOR_IMPUESTO CARGAR_A_LA_CUENTA ESTA_CARGADO_A_LA_CUENTA ID_CLIENTE_PS_A_FACTURAR ID_TIPO_COD ID_ACTUALIZADO FECHA_ACTUALIZACION LOGIN_EMPLEADO_CREACION FECHA_CREACION LOGIN_EMPLEADO_MODIFICACION FECHA_MODIFICACION ID_PRODUCTO ID_SUBPRODUCTO ID_FORMA_PAGO ID_TIEMPO_ENTREGA ID_MEDIO_TRANSPORTE PESO_FISICO_GUIA NUMERO_PIEZAS VALOR_DECLARADO VALOR_FLETE VALOR_OTROS VALOR_TOTAL ID_MOVIMIENTO VALOR_PRODUCTO NUMERO_CODIGO_EFECTY INGRESO_MANUAL NUMERO_ORDEN_SERVICIO ID_PUNTO_RECAUDO FECHA_RECAUDO_EFECTY NUMERO_ORDEN_SERVICIO2 ID_MODALPAGO NUMERO_APROBACION FRANQUICIA ID_CLIENTE ID_REMITE NOMBRE_REMITE_GUIA ID_PRODUCTO_GUIA ID_ESTADOENVIO ID_ESTADOGUIA VALOR_ENVIO_GUIA VALOR_RECAUDAR_PRODUCTO_GUIA NOMBRE_ESTADOENVIO FECHA_ENVIO NOMBRE_TIPO_CANAL NOMBRE_CLASE_TIPO_CANAL G_ID_CIUDAD_ORIGEN G_ID_CIUDAD_DESTINO&#xA;&#xA;/*&#xA;select G.NUMERO_GUIA&#xA;,TCAN.NOMBRE_TIPO_CANAL&#xA;,CTCAN.NOMBRE_CLASE_TIPO_CANAL&#xA;from Mece_Logistico.dbo.guias G (nolock)&#xA;left JOIN [Mece_Logistico].[dbo].[CANALES] CAN (NOLOCK) ON CAN.id_pais=G.ID_1 and CAN.id_ciudad=G.ID_2 and CAN.[ID_DIVISION]=G.ID_CANAL&#xA;left JOIN [Mece_Logistico].[dbo].[TIPOS_CANAL] TCAN (NOLOCK) ON TCAN.ID_TIPO_CANAL=CAN.ID_TIPO_CANAL AND TCAN.ID_EST_TIPO_CANAL=1&#xA;left JOIN PARAMETROS.[dbo].[CLASE_TIPO_CANAL] CTCAN (NOLOCK) ON CTCAN.ID_CLASE_TIPO_CANAL=TCAN.CLASE_TIPO_CANAL&#xA;where G.ID_CANAL IS NOT NULL&#xA;AND FECHA_ENVIO&gt;='20260120 00:00:00'&#xA;*/&#xA;&#xA;CREATE NONCLUSTERED INDEX [IX_NUMERO_GUIA] ON #COD_PENDIENTE_POR_RECAUDO ([NUMERO_GUIA] ASC)&#xA;&#xA;&#xA;--Se quitan envios siniestrados&#xA;DELETE GPR FROM #COD_PENDIENTE_POR_RECAUDO GPR&#xA;WHERE ID_ESTADOENVIO in(5,4)&#xA;&#xA;--Quita las guias son del canal retail y no son COD y no contraentrega ecommerce&#xA;DELETE GPR FROM #COD_PENDIENTE_POR_RECAUDO GPR&#xA;WHERE ID_FORMA_PAGO=1 AND ISNULL(ID_PRODUCTO_GUIA,999) !=86&#xA;--WHERE ID_FORMA_PAGO=1 AND ISNULL(ID_PRODUCTO,999) !=86&#xA;&#xA;&#xA;--Quita las guias CREDICONTADO (Solicitud de luis gabriel rodriguez y Holman Salamanca el dia 2026-04-09 11:44am )&#xA;/*&#xA;&#xA;ID_FORMAPAGO NOMBRE_FORMAPAGO&#xA;1 CONTADO&#xA;2 CREDITO&#xA;3 PREPAGO DIGITAL&#xA;4 C.O.D. &#xA;5 CHEQUE&#xA;6 TARJETAS FINANCIERAS&#xA;7 CREDI CONTADO&#xA;9 QR&#xA;10 TARJETA&#xA;*/&#xA;DELETE GPR FROM #COD_PENDIENTE_POR_RECAUDO GPR&#xA;WHERE ID_FORMA_PAGO=7&#xA;&#xA;/*&#xA;--&gt;credicontado --9175427260&#xA;--&gt;contado --9177482665&#xA;SELECT * FROM [Mece_Logistico].[dbo].[COD_PENDIENTE_POR_RECAUDO] CPR (NOLOCK)&#xA;WHERE ID_FORMA_PAGO=7&#xA;AND NUMERO_GUIA=9177482665&#xA;*/&#xA;&#xA;--SELECT * FROM #COD_PENDIENTE_POR_RECAUDO CPR (NOLOCK)&#xA;--WHERE --NUMERO_GUIA=2143658629&#xA;--ID_PRODUCTO=86&#xA;--INSERT INTO #TMP_GUIAS_PENDIENTE_RECAUDO&#xA;&#xA;UPDATE CPR SET CPR.NOMBRE_ESTADOENVIO=E.NOMBRE_ESTADOENVIO&#xA;FROM #COD_PENDIENTE_POR_RECAUDO CPR&#xA;INNER JOIN PARAMETROS.DBO.ESTADOSENVIO E (NOLOCK)ON E.ID_ESTADOENVIO=CPR.ID_ESTADOENVIO&#xA;&#xA;--TRUNCATE TABLE #TMP_GUIAS_PENDIENTE_RECAUDO&#xA;INSERT INTO #TMP_GUIAS_PENDIENTE_RECAUDO(&#xA;NUMERO_GUIA,&#xA;ID_ESTADOENVIO,&#xA;NOMBRE_ESTADOENVIO,&#xA;FORMA_PAGO,&#xA;VALOR_A_RECAUDAR,&#xA;ID_REMITE,&#xA;NOMBRE_REMITE_GUIA,&#xA;FECHA_ENVIO,&#xA;VALOR_RECAUDADO,&#xA;FECHA_RECAUDO,&#xA;NUMERO_ORDEN_SERVICIO,&#xA;FECHA_RECAUDO_EFECTY,&#xA;ID_CLIENTE,&#xA;NOMBRE_TIPO_CANAL,&#xA;NOMBRE_CLASE_TIPO_CANAL,&#xA;G_ID_CIUDAD_ORIGEN,&#xA;G_ID_CIUDAD_DESTINO&#xA;)&#xA;SELECT CPR.NUMERO_GUIA,CPR.ID_ESTADOENVIO,CPR.NOMBRE_ESTADOENVIO,&#xA;CASE WHEN CPR.ID_FORMA_PAGO=4 AND CPR.ID_CLIENTE IS NULL THEN 'C.O.D.' WHEN ISNULL(CPR.ID_PRODUCTO,CPR.ID_PRODUCTO_GUIA)=86 THEN 'CONTRAENTREGA ECOMMERCE' WHEN (CPR.ID_FORMA_PAGO=2 OR CPR.ID_CLIENTE IS NOT NULL) THEN 'LPC' ELSE '' END AS FORMA_PAGO,&#xA;CASE WHEN ISNULL(CPR.VALOR_TOTAL,0)!=0 THEN CPR.VALOR_TOTAL&#xA;WHEN CPR.ID_FORMA_PAGO=4 AND VALOR_FLETE IS NOT NULL THEN ISNULL(CPR.VALOR_FLETE,0) + ISNULL(CPR.VALOR_OTROS,0)&#xA;WHEN CPR.ID_FORMA_PAGO=4 AND VALOR_FLETE IS NULL THEN ISNULL(CPR.VALOR_ENVIO_GUIA,0)&#xA;WHEN ISNULL(CPR.ID_PRODUCTO,CPR.ID_PRODUCTO_GUIA)=86 THEN ISNULL(CPR.VALOR_DECLARADO,CPR.VALOR_PRODUCTO)&#xA;WHEN (CPR.ID_FORMA_PAGO=2 OR CPR.ID_CLIENTE IS NOT NULL) THEN ISNULL(CPR.VALOR_DECLARADO,CPR.VALOR_PRODUCTO) ELSE 0 END AS VALOR_A_RECAUDAR&#xA;,CPR.ID_REMITE&#xA;,CPR.NOMBRE_REMITE_GUIA&#xA;,CPR.FECHA_ENVIO&#xA;,ISNULL(CPR.VALOR_RECAUDADO,0)&#xA;,CPR.FECHA_RECAUDO&#xA;,ISNULL(CPR.NUMERO_ORDEN_SERVICIO,0)&#xA;,CPR.FECHA_RECAUDO_EFECTY&#xA;,isnull(CPR.ID_CLIENTE,'0') ID_CLIENTE&#xA;,CPR.NOMBRE_TIPO_CANAL&#xA;,CPR.NOMBRE_CLASE_TIPO_CANAL&#xA;,G_ID_CIUDAD_ORIGEN&#xA;,G_ID_CIUDAD_DESTINO&#xA;--,CPR.VALOR_TOTAL&#xA;--INTO #TMP_GUIAS_PENDIENTE_RECAUDO_1&#xA;FROM #COD_PENDIENTE_POR_RECAUDO CPR (NOLOCK)&#xA;WHERE LEN(CPR.NUMERO_GUIA)&gt;7&#xA;--INNER JOIN [Mece_Logistico].[dbo].[GUIAS] G (nolock) ON G.NUMERO_GUIA=CPR.NUMERO_GUIA&#xA;&#xA;--CREATE NONCLUSTERED INDEX [IX_NUMERO_GUIA] ON #TMP_GUIAS_PENDIENTE_RECAUDO_1 ([NUMERO_GUIA] ASC)&#xA;&#xA;--select GPR.* from #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA;&#xA;&#xA;UPDATE GPR SET&#xA; --GPR.NOMBRE_RESPONSABLE_ULT_MOV='SERVIENTREGA S.A.'&#xA; GPR.ID_PROCESO_ULT_MOV=SE.ID_PROCESO&#xA; ,GPR.NOMBRE_PROCESO_ULT_MOV=PRO.NOMBRE_PROCESO_LOG&#xA; ,GPR.ID_CONCEPTO_ULT_MOV=ISNULL(SE.ID_CONCEPTO,0)&#xA; ,GPR.NOMBRE_CONCEPTO_ULT_MOV=ISNULL(ICON.NOMBRE_CONCEPTO,'')&#xA; ,GPR.NUMERO_MOVIMI_ULT_MOV=SE.NUMERO_MOVIMI&#xA; ,GPR.CONSECUT_MOVIMI_ULT_MOV=SE.CONSECUT_MOVIMI&#xA; ,GPR.FECHA_HORA_MOVIMI_ULT_MOV=SE.FECHA_HORA_MOVIMIENTO&#xA; --,GPR.ID_CONDUCTOR_ULT_MOV=DOC.ID_COURIER_CONDUCTOR&#xA; --,GPR.ID_AUXILIAR_ULT_MOV=DOC.ID_AUXILIAR1_VEHICULO&#xA; --,GPR.ID_PAIS_ZONA_URBA_ULT_MOV=DOC.ID_PAIS_ZONA_URBA  &#xA; --,GPR.ID_CIUDAD_ZONA_URBA_ULT_MOV=DOC.ID_CIUDAD_ZONA_URBA &#xA; --,GPR.ID_TIPO_ZONA_URBA_ULT_MOV=DOC.ID_TIPO_ZONA_URBA&#xA; --,GPR.ID_ZONA_URBA_ULT_MOV=DOC.ID_ZONA_URBA&#xA; FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; INNER JOIN MECE_LOGISTICO.dbo.SEGUIMIENTO_ENVIO SE WITH(NOLOCK) on se.NUMERO_GUIA=GPR.NUMERO_GUIA&#xA; --INNER JOIN MECE_LOGISTICO.dbo.DOCUMENTOS DOC (NOLOCK) ON&#xA; --DOC.ID_PROCESO=GPR.[ID_PROCESO_ULT_MOV] AND DOC.NUMERO_MOVIMI=GPR.[NUMERO_MOVIMI_ULT_MOV] AND DOC.CONSECUT_MOVIMI=GPR.[CONSECUT_MOVIMI_ULT_MOV]&#xA; INNER JOIN PARAMETROS.DBO.PROCESOS PRO (NOLOCK) ON PRO.ID_PROCESO=SE.ID_PROCESO&#xA; LEFT JOIN PARAMETROS.DBO.ITEM_CONCEPTO ICON (NOLOCK) ON ICON.ID_PAIS=1 AND ICON.ID_PROCESO=SE.ID_PROCESO AND ICON.ID_CONCEPTO=SE.ID_CONCEPTO&#xA; WHERE se.FECHA_HORA_MOVIMIENTO= (select MAX(se1.FECHA_HORA_MOVIMIENTO) from MECE_LOGISTICO.dbo.SEGUIMIENTO_ENVIO SE1 WITH(NOLOCK)&#xA;          where SE1.numero_guia=GPR.NUMERO_GUIA)&#xA; &#xA; UPDATE GPR SET&#xA; GPR.ID_CONDUCTOR_ULT_MOV=DOC.ID_COURIER_CONDUCTOR&#xA; ,GPR.ID_AUXILIAR_ULT_MOV=DOC.ID_AUXILIAR1_VEHICULO&#xA; ,GPR.ID_PAIS_ZONA_URBA_ULT_MOV=DOC.ID_PAIS_ZONA_URBA  &#xA; ,GPR.ID_CIUDAD_ZONA_URBA_ULT_MOV=DOC.ID_CIUDAD_ZONA_URBA &#xA; ,GPR.ID_TIPO_ZONA_URBA_ULT_MOV=DOC.ID_TIPO_ZONA_URBA&#xA; ,GPR.ID_ZONA_URBA_ULT_MOV=DOC.ID_ZONA_URBA&#xA; FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; INNER JOIN MECE_LOGISTICO.DBO.DOCUMENTOS DOC (NOLOCK) ON&#xA; DOC.ID_PROCESO=GPR.[ID_PROCESO_ULT_MOV] AND DOC.NUMERO_MOVIMI=GPR.[NUMERO_MOVIMI_ULT_MOV] AND DOC.CONSECUT_MOVIMI=GPR.[CONSECUT_MOVIMI_ULT_MOV]&#xA;&#xA; --SELECT GPR.ID_CONDUCTOR_ULT_MOV&#xA; &#xA; UPDATE GPR SET&#xA; GPR.ID_CONDUCTOR_ULT_MOV=ISNULL(RTRIM(LTRIM(EC.ID_EMPLEADO)),'')&#xA; ,GPR.CONDUCTOR_ULT_MOV =ISNULL(RTRIM(LTRIM(EC.NOMBRE_EMPLEADO)) +' '+ RTRIM(LTRIM(EC.APELLIDO_EMPLEADO)),'') &#xA; ,GPR.ID_AUXILIAR_ULT_MOV=ISNULL(RTRIM(LTRIM(EA.ID_EMPLEADO)),'')&#xA; ,GPR.AUXILIAR_ULT_MOV=ISNULL(RTRIM(LTRIM(EA.NOMBRE_EMPLEADO)) +' '+ RTRIM(LTRIM(EA.APELLIDO_EMPLEADO)),'') &#xA; FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; LEFT JOIN PARAMETROS.DBO.EMPLEADOS EC (NOLOCK) ON EC.ID_EMPLEADO=GPR.ID_CONDUCTOR_ULT_MOV&#xA; LEFT JOIN PARAMETROS.DBO.EMPLEADOS EA (NOLOCK) ON EA.ID_EMPLEADO=GPR.ID_AUXILIAR_ULT_MOV&#xA;&#xA;&#xA; --SELECT GPR.NUMERO_GUIA,ISNULL(DIV.NOMBRE_DIVISION,'') AS NOMBRE_CDS, ISNULL(CTCAN.[NOMBRE_CLASE_TIPO_CANAL],'') as TIPO_CANAL&#xA;UPDATE GPR SET NOMBRE_CDS_ULT_MOV=ISNULL(DIV.NOMBRE_DIVISION,''),&#xA; TIPO_CANAL_ULT_MOV=ISNULL(CTCAN.[NOMBRE_CLASE_TIPO_CANAL],'')&#xA; FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; --INNER JOIN MECE_LOGISTICO.DBO.DOCUMENTOS DOC (NOLOCK) ON&#xA; --DOC.ID_PROCESO=GPR.[ID_PROCESO_ULT_MOV] AND DOC.NUMERO_MOVIMI=GPR.[NUMERO_MOVIMI_ULT_MOV] AND DOC.CONSECUT_MOVIMI=GPR.[CONSECUT_MOVIMI_ULT_MOV]&#xA; INNER JOIN PARAMETROS.DBO.ZONASURBANAS Z (NOLOCK) &#xA; ON Z.ID_PAIS = GPR.ID_PAIS_ZONA_URBA_ULT_MOV AND Z.ID_CIUDAD = GPR.ID_CIUDAD_ZONA_URBA_ULT_MOV &#xA;  AND Z.ID_TIPO_ZONA_URBA = GPR.ID_TIPO_ZONA_URBA_ULT_MOV AND Z.ID_ZONA_URBA = GPR.ID_ZONA_URBA_ULT_MOV --AND Z.CATEGORIA_ZONA_URBA = 8 --CLICOH&#xA; INNER JOIN PARAMETROS.DBO.DIVISIONES DIV (NOLOCK) ON DIV.ID_PAIS = Z.ID_PAIS_CANAL AND DIV.ID_CIUDAD = Z.ID_CIUDAD_CANAL AND DIV.ID_DIVISION = Z.ID_CANAL&#xA; INNER JOIN [Mece_Logistico].[dbo].[CANALES] CAN (NOLOCK) ON CAN.id_pais=DIV.ID_PAIS and CAN.id_ciudad=DIV.ID_CIUDAD and CAN.[ID_DIVISION]=DIV.ID_DIVISION&#xA; INNER JOIN [Mece_Logistico].[dbo].[TIPOS_CANAL] TCAN (NOLOCK) ON TCAN.ID_TIPO_CANAL=CAN.ID_TIPO_CANAL AND TCAN.ID_EST_TIPO_CANAL=1&#xA; INNER JOIN PARAMETROS.[dbo].[CLASE_TIPO_CANAL] CTCAN (NOLOCK) ON CTCAN.ID_CLASE_TIPO_CANAL=TCAN.CLASE_TIPO_CANAL&#xA;&#xA;&#xA; --UPDATE GPR SET ESTADO_ENTREGA='VENCIDO'&#xA; --SELECT * FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; UPDATE GPR SET ESTADO_ENTREGA='VENCIDO'&#xA; FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; WHERE GPR.ID_PROCESO_ULT_MOV=9 AND ID_CONCEPTO_ULT_MOV IN(9,7,2,4)--9 ENTREGAS OFIC  C.O.D. Y/O LPC EMPRESARIO --7 EMPRESARIO SATELITE ENTREGA EN OFICINA&#xA; --2 RECLAMO OFICINA Y 4 C.O.D RECLAMO OFICINA&#xA; AND DATEDIFF(DAY, FECHA_HORA_MOVIMI_ULT_MOV,GETDATE())&gt;8 -- MAS DE 8 DIAS&#xA; &#xA; UPDATE GPR SET ESTADO_ENTREGA='VENCIDO'&#xA; FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; WHERE GPR.ID_PROCESO_ULT_MOV=31 --ENVIO PARA ENTREGA EN OFICINA&#xA; AND DATEDIFF(DAY, FECHA_HORA_MOVIMI_ULT_MOV,GETDATE())&gt;8 -- MAS DE 8 DIAS&#xA;&#xA; UPDATE GPR SET ESTADO_ENTREGA='VENCIDO'&#xA; FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; WHERE GPR.ID_PROCESO_ULT_MOV=9 AND ID_CONCEPTO_ULT_MOV IN(10,8) --10 ENTR A DOMICI  LPC / COD EMPRESARIOS SAT --8 EMPRESARIO SATELITE ENTREGA EN DOMICILIO&#xA; AND DATEDIFF(DAY, FECHA_HORA_MOVIMI_ULT_MOV,GETDATE())&gt;3-- MAS DE 3 DIAS&#xA; &#xA; UPDATE GPR SET ESTADO_ENTREGA='VENCIDO'&#xA; FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; WHERE GPR.ID_PROCESO_ULT_MOV=32 --ENVIO PARA ENTREGA A DOMICILIO&#xA; AND DATEDIFF(DAY, FECHA_HORA_MOVIMI_ULT_MOV,GETDATE())&gt;3-- MAS DE 3 DIAS&#xA;&#xA; UPDATE GPR SET ESTADO_ENTREGA='VENCIDO'&#xA; FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; WHERE GPR.ID_PROCESO_ULT_MOV=9 AND ID_CONCEPTO_ULT_MOV IN(1,3) --SALIDA A ZONA Y C.O.D EN DISTRIBUCION&#xA; AND DATEDIFF(DAY, FECHA_HORA_MOVIMI_ULT_MOV,GETDATE())&gt;1 --MAS DE UN DIA&#xA;&#xA;&#xA;&#xA;DROP TABLE IF EXISTS #TMP_GUIAS_PENDIENTE_RECAUDO_SZU&#xA; SELECT &#xA; TMP.NUMERO_GUIA&#xA; ,(SE.CONSECUT_MOVIMI)   AS CONSECUT_MOVIMI_SZU&#xA; ,(SE.NUMERO_MOVIMI)    AS NUMERO_MOVIMI_SZU&#xA; ,(SE.FECHA_HORA_MOVIMIENTO)  AS FECHA_HORA_MOVIMI_ULT_MOV_SZU&#xA;INTO #TMP_GUIAS_PENDIENTE_RECAUDO_SZU&#xA;FROM #TMP_GUIAS_PENDIENTE_RECAUDO TMP&#xA;INNER JOIN Mece_Logistico..SEGUIMIENTO_ENVIO SE&#xA;ON SE.NUMERO_GUIA=TMP.NUMERO_GUIA&#xA;WHERE SE.ID_PROCESO=9&#xA;---GROUP BY  TMP.NUMERO_GUIA&#xA;&#xA;;WITH CTE AS(&#xA;SELECT &#xA;ROWID = ROW_NUMBER() OVER(PARTITION BY NUMERO_GUIA ORDER BY FECHA_HORA_MOVIMI_ULT_MOV_SZU DESC)&#xA;,NUMERO_GUIA,FECHA_HORA_MOVIMI_ULT_MOV_SZU&#xA;FROM #TMP_GUIAS_PENDIENTE_RECAUDO_SZU&#xA;)&#xA;DELETE CTE WHERE ROWID&gt;1&#xA;&#xA;&#xA;&#xA;--SELECT * FROM #TMP_GUIAS_PENDIENTE_RECAUDO TMP&#xA;&#xA;&#xA;&#xA;DROP TABLE IF EXISTS #TMP_GUIAS_CON_TAREAS &#xA; SELECT &#xA; TMP.NUMERO_GUIA,&#xA; COUNT(TAR.NUMERO_DOCPROBLEMA) AS NUMERO_TAREAS&#xA;INTO #TMP_GUIAS_CON_TAREAS&#xA;FROM #TMP_GUIAS_PENDIENTE_RECAUDO TMP&#xA;INNER JOIN Mece_Logistico..TAREAS TAR WITH(NOLOCK)&#xA;ON TAR.NUMERO_DOCPROBLEMA=CONVERT(CHAR(20),TMP.NUMERO_GUIA)&#xA;GROUP BY TMP.NUMERO_GUIA&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;DROP TABLE IF EXISTS ##TMP_GUIAS_PENDIENTE_RECAUDO_FINAL_PBI;&#xA;SELECT --GPR.*&#xA;GPR.NUMERO_GUIA &#xA;--GPR.ID_ESTADOENVIO &#xA;,GPR.NOMBRE_ESTADOENVIO &#xA;,GPR.FORMA_PAGO &#xA;,GPR.VALOR_A_RECAUDAR &#xA;,GPR.ID_REMITE &#xA;,GPR.NOMBRE_REMITE_GUIA &#xA;,GPR.FECHA_ENVIO&#xA;,GPR.VALOR_RECAUDADO&#xA;,GPR.FECHA_RECAUDO&#xA;,GPR.NUMERO_ORDEN_SERVICIO&#xA;,GPR.FECHA_RECAUDO_EFECTY&#xA;,GPR.ESTADO_ENTREGA&#xA;--,GPR.NOMBRE_RESPONSABLE_ULT_MOV &#xA;--ID_PROCESO_ULT_MOV &#xA;--NOMBRE_PROCESO_ULT_MOV &#xA;--NUMERO_MOVIMI_ULT_MOV &#xA;--CONSECUT_MOVIMI_ULT_MOV &#xA;--FECHA_HORA_MOVIMI_ULT_MOV&#xA;&#xA;--,ISNULL(ISNULL(CLO.CENTRO_LOGISTICO,CLD.CENTRO_LOGISTICO),'')  AS CPL_ORIGEN_ULT_MOV&#xA;--,ISNULL(ISNULL(RO.NOMBRE_REGIONAL,RD.NOMBRE_REGIONAL),'')  AS REGIONAL_ORIGEN_ULT_MOV&#xA;--,ISNULL(ISNULL(CO.NOMBRE_CIUDAD,CD.NOMBRE_CIUDAD),'')  AS CIUDAD_ORIGEN_ULT_MOV&#xA;--,ISNULL(ISNULL(CLD.CENTRO_LOGISTICO,CLO.CENTRO_LOGISTICO),'') AS CPL_DESTINO_ULT_MOV&#xA;--,ISNULL(ISNULL(RD.NOMBRE_REGIONAL,RO.NOMBRE_REGIONAL),'') AS REGIONAL_DESTINO_ULT_MOV&#xA;--,ISNULL(ISNULL(CD.NOMBRE_CIUDAD,CO.NOMBRE_CIUDAD),'') AS CIUDAD_DESTINO_MOV&#xA;,CASE WHEN ID_PROCESO!=14 THEN &#xA;ISNULL(ISNULL(CLO.CENTRO_LOGISTICO,CLD.CENTRO_LOGISTICO),'')  ELSE ISNULL(ISNULL(CLD.CENTRO_LOGISTICO,CLO.CENTRO_LOGISTICO),'') END AS CPL_ULT_MOV&#xA;,CASE WHEN ID_PROCESO!=14 THEN &#xA;ISNULL(ISNULL(RO.NOMBRE_REGIONAL,RD.NOMBRE_REGIONAL),'') ELSE ISNULL(ISNULL(RD.NOMBRE_REGIONAL,RO.NOMBRE_REGIONAL),'') END  AS REGIONAL_ULT_MOV&#xA;,CASE WHEN ID_PROCESO!=14 THEN &#xA;ISNULL(ISNULL(CO.NOMBRE_CIUDAD,CD.NOMBRE_CIUDAD),'')  ELSE ISNULL(ISNULL(CD.NOMBRE_CIUDAD,CO.NOMBRE_CIUDAD),'') END  AS CIUDAD_ULT_MOV&#xA;,ISNULL(CASE &#xA; WHEN ISNULL(DOC.ID_CIUDAD_ZONA_URBA,0) !=0 THEN&#xA; ROZ.NOMBRE_REGIONAL+' - '+ DCOZ.NOMBRE_DEPARTAMENTO +' - '+ COZ.NOMBRE_CIUDAD &#xA; WHEN  ISNULL(DOC.ID_CIUDAD_DIVISION_ORIGEN,0) !=0 AND DOC.ID_PROCESO!=14 THEN&#xA; ROM.NOMBRE_REGIONAL+' - '+ DCOM.NOMBRE_DEPARTAMENTO +' - '+ COM.NOMBRE_CIUDAD&#xA; ELSE&#xA; ROD.NOMBRE_REGIONAL+' - '+ DCOD.NOMBRE_DEPARTAMENTO +' - '+ COD.NOMBRE_CIUDAD &#xA; END,'') AS REG_DEPART_CIUDAD_ULTIMO_MOV&#xA;&#xA;,ISNULL(DOC.PLACA_VEHICULO_DOCU,'') as PLACA_VEHICULO_ULTIMO_MOV&#xA;,ISNULL(O.[NOMBRE_OPERATIVO],'') AS NOMBRE_OPERATIVO_ULTIMO_MOV&#xA;,ISNULL(Z.NOMBRE_ZONA_URBA,'') AS ZONA_URBANA_ULTIMO_MOV&#xA;,ISNULL(CZ.NOMBRE_CATEGORIA,'') AS CATEGORIA_ZONA_ULTIMO_MOV&#xA;,ISNULL(TZU.NOMBRE_TIPO_ZONA_URBA,'') AS TIPO_ZONA_ULTIMO_MOV&#xA;,ISNULL(GPR.NOMBRE_CDS_ULT_MOV,'') AS NOMBRE_CDS_ULT_MOV&#xA;,ISNULL(TIPO_CANAL_ULT_MOV,'') AS TIPO_CANAL_ULT_MOV&#xA;--,GR.ID_PROCESO &#xA;,ISNULL(GPR.NOMBRE_PROCESO_ULT_MOV,'') AS PROCESO_LOG_ULTIMO_MOV  &#xA;,ISNULL(GPR.NOMBRE_CONCEPTO_ULT_MOV,'') AS CONCEPTO_ULT_MOV&#xA;--,GR.ID_CONCEPTO  &#xA;--,GR.FECHA_HORA_MOVIMIENTO&#xA;,ISNULL(cast(GPR.ID_PROCESO_ULT_MOV as nvarchar) +' - '+ RTRIM(GPR.NOMBRE_PROCESO_ULT_MOV),'') AS NOMBRE_ULTIMO_MOV&#xA;,ISNULL(CASE WHEN DIO.ID_DIVISION IS NOT NULL THEN cast(DIO.ID_DIVISION as nvarchar) +' - '+ RTRIM(DIO.NOMBRE_DIVISION)&#xA;ELSE cast(DID.ID_DIVISION as nvarchar) +' - '+ RTRIM(DID.NOMBRE_DIVISION) END,'') AS BODEGA_ULTIMO_MOV&#xA;,ISNULL(cast(GPR.ID_PROCESO_ULT_MOV as nvarchar) +' - '+ RTRIM(GPR.[NUMERO_MOVIMI_ULT_MOV])+' - '+  cast(GPR.[CONSECUT_MOVIMI_ULT_MOV] as nvarchar),'') as ULTIMO_MOV_LOGISTICO&#xA;,ISNULL(CONVERT(nvarchar(20),GPR.FECHA_HORA_MOVIMI_ULT_MOV,120),'') AS FECHA_ULTIMO_MOV&#xA;,GPR.ID_CONDUCTOR_ULT_MOV&#xA;,GPR.CONDUCTOR_ULT_MOV&#xA;,GPR.ID_AUXILIAR_ULT_MOV&#xA;,GPR.AUXILIAR_ULT_MOV&#xA;,GPR.ID_CLIENTE&#xA;,SZU.CONSECUT_MOVIMI_SZU&#xA;,SZU.NUMERO_MOVIMI_SZU&#xA;,SZU.FECHA_HORA_MOVIMI_ULT_MOV_SZU&#xA;,GPR.NOMBRE_TIPO_CANAL&#xA;,GPR.NOMBRE_CLASE_TIPO_CANAL&#xA;,TAR.NUMERO_TAREAS&#xA;,G_ID_CIUDAD_ORIGEN&#xA;,G_ID_CIUDAD_DESTINO&#xA;--,DOC.*&#xA;INTO ##TMP_GUIAS_PENDIENTE_RECAUDO_FINAL_PBI&#xA;&#xA;FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA;--------------------------- CIUDAD ULTIMO MOV ZONA&#xA;  LEFT JOIN MECE_LOGISTICO.DBO.DOCUMENTOS DOC (NOLOCK) ON&#xA; DOC.ID_PROCESO=GPR.[ID_PROCESO_ULT_MOV] AND DOC.NUMERO_MOVIMI=GPR.[NUMERO_MOVIMI_ULT_MOV] AND DOC.CONSECUT_MOVIMI=GPR.[CONSECUT_MOVIMI_ULT_MOV]&#xA; --AND DOC.ID_DIVISION_DESTINO IN (9311, 9308, 9304, 9313, 9310, 9312, 9711, 9710)&#xA;  LEFT JOIN PARAMETROS.DBO.CIUDADES COZ (NOLOCK) ON  COZ.ID_PAIS=1 AND COZ.ID_CIUDAD=DOC.ID_CIUDAD_ZONA_URBA&#xA;  LEFT JOIN PARAMETROS.DBO.REGIONALES_PAIS ROZ (NOLOCK) ON  ROZ.ID_PAIS=COZ.ID_PAIS AND ROZ.ID_REGIONAL=COZ.ID_REGIONAL&#xA;  LEFT JOIN PARAMETROS.DBO.DEPARTAMENTOS DCOZ (NOLOCK) ON  DCOZ.ID_PAIS=COZ.ID_PAIS AND DCOZ.ID_DEPARTAMENTO=COZ.ID_DEPARTAMENTO&#xA;   LEFT JOIN PARAMETROS.DBO.ZONASURBANAS Z (NOLOCK) &#xA; ON Z.ID_PAIS = DOC.ID_PAIS_ZONA_URBA AND Z.ID_CIUDAD = DOC.ID_CIUDAD_ZONA_URBA AND Z.ID_TIPO_ZONA_URBA = DOC.ID_TIPO_ZONA_URBA AND Z.ID_ZONA_URBA = DOC.ID_ZONA_URBA --AND Z.CATEGORIA_ZONA_URBA = 8 --CLICOH&#xA;  LEFT JOIN [PARAMETROS].[dbo].[CATEGORIAZONASURBANAS] CZ (NOLOCK) ON CZ.Id_Categoria=Z.CATEGORIA_ZONA_URBA&#xA;  LEFT JOIN [PARAMETROS].[dbo].[TIPOSZONASURBANAS] TZU (NOLOCK) ON TZU.ID_TIPO_ZONA_URBA=Z.ID_TIPO_ZONA_URBA&#xA; --------------------------- CIUDAD ULTIMO MOV DOCUMENTO&#xA;  LEFT JOIN PARAMETROS.DBO.CIUDADES COM (NOLOCK) ON  COM.ID_PAIS=1 AND COM.ID_CIUDAD=DOC.ID_CIUDAD_DIVISION_ORIGEN&#xA;  LEFT JOIN PARAMETROS.DBO.REGIONALES_PAIS ROM (NOLOCK) ON  ROM.ID_PAIS=COM.ID_PAIS AND ROM.ID_REGIONAL=COM.ID_REGIONAL&#xA;  LEFT JOIN PARAMETROS.DBO.DEPARTAMENTOS DCOM (NOLOCK) ON  DCOM.ID_PAIS=COM.ID_PAIS AND DCOM.ID_DEPARTAMENTO=COM.ID_DEPARTAMENTO&#xA;  --------------------------- CIUDAD DESTINO ULTIMO MOV DOCUMENTO&#xA;  LEFT JOIN PARAMETROS.DBO.CIUDADES COD(NOLOCK) ON  COD.ID_PAIS=1 AND COD.ID_CIUDAD=DOC.ID_CIUDAD_DESTINO&#xA;  LEFT JOIN PARAMETROS.DBO.REGIONALES_PAIS ROD (NOLOCK) ON  ROD.ID_PAIS=COD.ID_PAIS AND ROD.ID_REGIONAL=COD.ID_REGIONAL&#xA;  LEFT JOIN PARAMETROS.DBO.DEPARTAMENTOS DCOD (NOLOCK) ON  DCOD.ID_PAIS=COD.ID_PAIS AND DCOD.ID_DEPARTAMENTO=COD.ID_DEPARTAMENTO&#xA;  --------------------------- DIVISION ORIGEN ULTIMO MOV DOCUMENTO&#xA;  LEFT JOIN PARAMETROS.DBO.DIVISIONES DIO(NOLOCK) ON DIO.ID_PAIS=DOC.ID_PAIS_DIVISION_ORIGEN&#xA; AND DIO.ID_CIUDAD=DOC.ID_CIUDAD_DIVISION_ORIGEN AND DIO.ID_DIVISION=DOC.ID_DIVISION_ORIGEN&#xA;  --------------------------- DIVISION DESTINO ULTIMO MOV DOCUMENTO&#xA;  LEFT JOIN PARAMETROS.DBO.DIVISIONES DID(NOLOCK) ON DID.ID_PAIS=DOC.ID_PAIS_DESTINO&#xA; AND DID.ID_CIUDAD=DOC.ID_CIUDAD_DESTINO AND DID.ID_DIVISION=DOC.ID_DIVISION_DESTINO&#xA;-------------------------------------------------------------&#xA;  LEFT JOIN [PARAMETROS].[dbo].CIUDADES CO (NOLOCK) ON CO.ID_PAIS=ID_PAIS_DIVISION_ORIGEN AND CO.ID_CIUDAD=DOC.ID_CIUDAD_DIVISION_ORIGEN&#xA;  LEFT JOIN [PARAMETROS].[dbo].REGIONALES_PAIS RO (NOLOCK) ON RO.ID_PAIS=1 AND RO.ID_REGIONAL=CO.[ID_REGIONAL]&#xA;  LEFT JOIN [PARAMETROS].[dbo].CIUDADES CD (NOLOCK) ON CD.ID_PAIS=DOC.ID_PAIS_DESTINO AND CD.ID_CIUDAD=DOC.ID_CIUDAD_DESTINO&#xA;  LEFT JOIN [PARAMETROS].[dbo].REGIONALES_PAIS RD (NOLOCK) ON RD.ID_PAIS=1 AND RD.ID_REGIONAL=CD.[ID_REGIONAL]&#xA;  LEFT JOIN [PARAMETROS].[dbo].[OPERATIVOS] O (NOLOCK) ON O.[ID_PAIS_ORIGEN]=DOC.ID_PAIS_OPERATIVO AND O.[ID_CIUDAD_ORIGEN]=DOC.ID_CIUDAD_OPERATIVO&#xA; AND O.[ID_OPERATIVO]=DOC.ID_OPERATIVO&#xA;  LEFT JOIN #TMP_CIUDADES_ANEXAS CAO (NOLOCK) ON CAO.ID_PAIS=1 AND CAO.[ID_CIUDAD_ANEXA]=CO.ID_CIUDAD --AND CAO.RECOLECCION=1&#xA;  LEFT JOIN PARAMETROS.DBO.CENTROS_LOGISTICOS CLO (NOLOCK) ON CLO.ID_PAIS=1 AND CLO.ID_CIUDAD=CAO.ID_CIUDAD AND CLO.ID_CENTRO_LOGISTICO=1 AND CLO.ID_ESTADO=1&#xA;  LEFT JOIN #TMP_CIUDADES_ANEXAS CAD (NOLOCK) ON CAD.ID_PAIS=1 AND CAD.[ID_CIUDAD_ANEXA]=CD.ID_CIUDAD --AND CAD.RECOLECCION=1&#xA;  LEFT JOIN PARAMETROS.DBO.CENTROS_LOGISTICOS CLD (NOLOCK) ON CLD.ID_PAIS=1 AND CLD.ID_CIUDAD=CAD.ID_CIUDAD AND CLD.ID_CENTRO_LOGISTICO=1 AND CLD.ID_ESTADO=1&#xA;LEFT JOIN #TMP_GUIAS_PENDIENTE_RECAUDO_SZU SZU ON SZU.NUMERO_GUIA=GPR.NUMERO_GUIA&#xA;LEFT JOIN #TMP_GUIAS_CON_TAREAS TAR ON TAR.NUMERO_GUIA=GPR.NUMERO_GUIA&#xA;--WHERE &#xA;--NUMERO_GUIA=2273736466&#xA;--ID_PROCESO=32&#xA;&#xA;--DELETE CPR FROM #TMP_GUIAS_PENDIENTE_RECAUDO CPR &#xA;--WHERE&#xA;--NOT EXISTS (SELECT TOP 1 SE.NUMERO_GUIA FROM Mece_Logistico.DBO.SEGUIMIENTO_ENVIO SE (NOLOCK) WHERE SE.NUMERO_GUIA=CPR.NUMERO_GUIA AND SE.ID_PROCESO&gt;=5 AND  SE.ID_PROCESO&lt;27)&#xA;&#xA;&#xA;&#xA;--select  COUNT(1) from #TMP_GUIAS_PENDIENTE_RECAUDO&#xA;--select  COUNT(1) from ##TMP_GUIAS_PENDIENTE_RECAUDO_FINAL_PBI&#xA;&#xA;----select  * from ##TMP_GUIAS_PENDIENTE_RECAUDO_FINAL_PBI&#xA;&#xA;&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
                  <SQLTask:ParameterBinding
                    SQLTask:ParameterName="0"
                    SQLTask:DtsVariableName="User::STR_FechaIni"
                    SQLTask:ParameterDirection="Input"
                    SQLTask:DataType="129"
                    SQLTask:ParameterSize="-1" />
                  <SQLTask:ParameterBinding
                    SQLTask:ParameterName="1"
                    SQLTask:DtsVariableName="User::STR_FechaFin"
                    SQLTask:ParameterDirection="Input"
                    SQLTask:DataType="129"
                    SQLTask:ParameterSize="-1" />
                </SQLTask:SqlTaskData>
              </DTS:ObjectData>
            </DTS:Executable>
            <DTS:Executable
              DTS:refId="Package\Tareas Backap\BACKUP AJUSTES 20260427\Prepatacion data Recudo LPC COD REPOBLAR 1"
              DTS:CreationName="Microsoft.ExecuteSQLTask"
              DTS:Description="Execute SQL Task"
              DTS:Disabled="True"
              DTS:DTSID="{8a65e310-cbe4-4bb5-8d81-68d5e9769a40}"
              DTS:ExecutableType="Microsoft.ExecuteSQLTask"
              DTS:LocaleID="-1"
              DTS:ObjectName="Prepatacion data Recudo LPC COD REPOBLAR 1"
              DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
              DTS:ThreadHint="2">
              <DTS:Variables />
              <DTS:ObjectData>
                <SQLTask:SqlTaskData
                  SQLTask:Connection="{20AF370D-4C8E-4E05-91E7-8F81200FAADC}"
                  SQLTask:SqlStatementSource="DECLARE @FECH_INI DATETIME =  ? ; /*---   '20260101';   */&#xA;DECLARE @FECH_FIN DATETIME =  ? ; /*---   '20260101';   */&#xA;&#xA;IF OBJECT_ID('tempdb..#COD_PENDIENTE_POR_RECAUDO') IS NOT NULL &#xA;    DROP TABLE #COD_PENDIENTE_POR_RECAUDO&#xA;&#xA;IF OBJECT_ID('tempdb..#TMP_GUIAS_PENDIENTE_RECAUDO') IS NOT NULL &#xA;    DROP TABLE #TMP_GUIAS_PENDIENTE_RECAUDO&#xA;&#xA;CREATE TABLE #TMP_GUIAS_PENDIENTE_RECAUDO(&#xA; NUMERO_GUIA numeric(20, 0) NOT NULL,&#xA; ID_ESTADOENVIO smallint DEFAULT 0,&#xA; NOMBRE_ESTADOENVIO varchar(40) DEFAULT '',&#xA; FORMA_PAGO varchar(40) DEFAULT '',&#xA; VALOR_A_RECAUDAR numeric(12, 2) NULL,&#xA; ID_REMITE [varchar](40) DEFAULT '',&#xA; NOMBRE_REMITE_GUIA  [varchar](200) DEFAULT '',&#xA; -- ID_CIUDAD INT DEFAULT 0,&#xA; -- [NOMBRE_CIUDAD] [varchar](50) DEFAULT '',&#xA; FECHA_ENVIO datetime NULL,&#xA; [VALOR_RECAUDADO] [numeric](11, 2) DEFAULT 0,&#xA; FECHA_RECAUDO datetime NULL,&#xA; NUMERO_ORDEN_SERVICIO varchar(20) DEFAULT '',&#xA; FECHA_RECAUDO_EFECTY datetime NULL,&#xA; ESTADO_ENTREGA varchar(70) DEFAULT 'A TIEMPO',--A TIEMPO O VENCIDO&#xA; --NOMBRE_RESPONSABLE_ULT_MOV VARCHAR(100) DEFAULT '',&#xA; ID_PROCESO_ULT_MOV int DEFAULT 0,&#xA; NOMBRE_PROCESO_ULT_MOV varchar(70) DEFAULT '',&#xA; ID_CONCEPTO_ULT_MOV int DEFAULT 0,&#xA; NOMBRE_CONCEPTO_ULT_MOV varchar(70) DEFAULT '',&#xA; NUMERO_MOVIMI_ULT_MOV char(30) DEFAULT '',&#xA; CONSECUT_MOVIMI_ULT_MOV numeric(7, 0) DEFAULT 0,&#xA; FECHA_HORA_MOVIMI_ULT_MOV datetime NULL,&#xA; ID_PAIS_ZONA_URBA_ULT_MOV SMALLINT NULL,&#xA; ID_CIUDAD_ZONA_URBA_ULT_MOV INT NULL,&#xA; ID_TIPO_ZONA_URBA_ULT_MOV SMALLINT NULL,&#xA; ID_ZONA_URBA_ULT_MOV SMALLINT NULL,&#xA; NOMBRE_CDS_ULT_MOV varchar(100) DEFAULT '',&#xA; TIPO_CANAL_ULT_MOV varchar(40) DEFAULT '',&#xA; ID_CONDUCTOR_ULT_MOV varchar(40) DEFAULT '',&#xA; CONDUCTOR_ULT_MOV  varchar(200) DEFAULT '',&#xA; ID_AUXILIAR_ULT_MOV varchar(40) DEFAULT '',&#xA; AUXILIAR_ULT_MOV varchar(200) DEFAULT '',&#xA; ID_CLIENTE [char](20) NOT NULL,&#xA; NOMBRE_TIPO_CANAL varchar(100) DEFAULT '',&#xA; NOMBRE_CLASE_TIPO_CANAL varchar(100) DEFAULT '',&#xA; [G_ID_CIUDAD_ORIGEN] [int] NULL,&#xA; [G_ID_CIUDAD_DESTINO] [int] NULL&#xA;) ON [PRIMARY]&#xA;CREATE NONCLUSTERED INDEX [IX_NUMERO_GUIA] ON #TMP_GUIAS_PENDIENTE_RECAUDO ([NUMERO_GUIA] ASC)&#xA;CREATE NONCLUSTERED INDEX [IX_ZONA] ON #TMP_GUIAS_PENDIENTE_RECAUDO (ID_PAIS_ZONA_URBA_ULT_MOV,ID_CIUDAD_ZONA_URBA_ULT_MOV, ID_TIPO_ZONA_URBA_ULT_MOV,ID_ZONA_URBA_ULT_MOV ASC)&#xA;CREATE NONCLUSTERED INDEX [IX_MANIFIESTO] ON #TMP_GUIAS_PENDIENTE_RECAUDO (ID_PROCESO_ULT_MOV,NUMERO_MOVIMI_ULT_MOV,CONSECUT_MOVIMI_ULT_MOV ASC)&#xA;&#xA;&#xA;IF OBJECT_ID('tempdb..#TMP_CIUDADES_ANEXAS') IS NOT NULL &#xA;    DROP TABLE #TMP_CIUDADES_ANEXAS&#xA;&#xA;---CIUDADES ANEXAS&#xA;SELECT CAD.* &#xA;INTO #TMP_CIUDADES_ANEXAS FROM PARAMETROS.DBO.CIUDADES_ANEXAS CAD (NOLOCK) &#xA;WHERE CAD.ID_PAIS=1 AND CAD.RECOLECCION=1&#xA;&#xA;INSERT INTO #TMP_CIUDADES_ANEXAS&#xA;SELECT CAD.* FROM PARAMETROS.DBO.CIUDADES_ANEXAS CAD (NOLOCK) &#xA;LEFT JOIN #TMP_CIUDADES_ANEXAS TCAD ON TCAD.ID_CIUDAD_ANEXA=CAD.ID_CIUDAD_ANEXA&#xA;WHERE CAD.ID_PAIS=1 AND CAD.RECOLECCION=0 AND TCAD.ID_CIUDAD_ANEXA IS NULL&#xA;&#xA;DELETE T FROM (SELECT *, &#xA;    DupRank = ROW_NUMBER() OVER (PARTITION BY ID_CIUDAD_ANEXA ORDER BY FECHA_CREACION DESC) &#xA;     FROM #TMP_CIUDADES_ANEXAS) AS T&#xA;WHERE DupRank &gt; 1&#xA;&#xA;&#xA;&#xA;SELECT CPR.*&#xA;,G.ID_CLIENTE,G.ID_REMITE,G.NOMBRE_REMITE_GUIA&#xA;,G.ID_PRODUCTO AS ID_PRODUCTO_GUIA&#xA;,G.ID_ESTADOENVIO&#xA;,G.ID_ESTADOGUIA&#xA;,ISNULL(G.VALOR_SEG_MAN_GUIAS,0)+ISNULL(G.VALOR_FLETES_GUIAS,0) AS VALOR_ENVIO_GUIA&#xA;,ISNULL(GIA.VALOR_RECAUDAR_PRODUCTO,0) AS VALOR_RECAUDAR_PRODUCTO_GUIA&#xA;,CAST('' AS nvarchar(50)) AS NOMBRE_ESTADOENVIO,G.FECHA_ENVIO&#xA;,TCAN.NOMBRE_TIPO_CANAL&#xA;,CTCAN.NOMBRE_CLASE_TIPO_CANAL&#xA;,G.[ID_CIUDAD_ORIGEN]   AS G_ID_CIUDAD_ORIGEN&#xA;,G.[ID_CIUDAD_DESTINO]   AS G_ID_CIUDAD_DESTINO&#xA;INTO #COD_PENDIENTE_POR_RECAUDO&#xA;FROM [Mece_Logistico].[dbo].[COD_PENDIENTE_POR_RECAUDO] CPR (NOLOCK)&#xA;INNER JOIN [Mece_Logistico].[dbo].[GUIAS] G (nolock) ON G.NUMERO_GUIA=CPR.NUMERO_GUIA&#xA;LEFT JOIN [Mece_Logistico].[dbo].[GUIAS_INF_ADICIONAL] GIA (nolock) ON GIA.NUMERO_GUIA=CPR.NUMERO_GUIA&#xA;LEFT JOIN [tmp_borrar_local].dbo.LPC_GUIAS_SOLUCIONADAS LGS (NOLOCK) ON LGS.NUMERO_GUIA=CPR.NUMERO_GUIA&#xA;LEFT JOIN [Mece_Logistico].[dbo].[CANALES] CAN (NOLOCK) ON CAN.id_pais=G.ID_1 and CAN.id_ciudad=G.ID_2 and CAN.[ID_DIVISION]=G.ID_CANAL&#xA;LEFT JOIN [Mece_Logistico].[dbo].[TIPOS_CANAL] TCAN (NOLOCK) ON TCAN.ID_TIPO_CANAL=CAN.ID_TIPO_CANAL AND TCAN.ID_EST_TIPO_CANAL=1&#xA;LEFT JOIN PARAMETROS.[dbo].[CLASE_TIPO_CANAL] CTCAN (NOLOCK) ON CTCAN.ID_CLASE_TIPO_CANAL=TCAN.CLASE_TIPO_CANAL&#xA;WHERE LGS.NUMERO_GUIA IS NULL &#xA;/*AND ISNULL(CPR.ESTADO_COD,1)=1-- RECAUDO ESTA ACTIVO*/---&gt;(se descarta por solicitud de luis gabriel rodriguez y Holman Salamanca el dia 2026-04-09 11:44am )&#xA;AND ISNULL(CPR.ESTA_RECAUDADO,0)=0 -- NO ESTA RECAUDADO&#xA;--AND G.ID_ESTADOGUIA!=4-- NO ESTA ANULADA&#xA;AND ISNULL(CPR.NUMERO_ORDEN_SERVICIO,'')='' -- NO TIENE ORDEN DE RECAUDO DE EFECTY&#xA;AND ISNULL(CPR.ESTA_ANULADO,0)=0 -- NO DEBE ESTAR ANULADA&#xA;AND G.ID_DIVISION_PROV IS NULL&#xA;--AND CPR.FECHA_CREACION &gt;= @FECHA_INI &#xA;--AND CPR.FECHA_CREACION &lt; @FECHA_FIN&#xA;AND CPR.FECHA_CREACION BETWEEN convert(datetime,@FECH_INI) AND convert(datetime,@FECH_FIN)&#xA;--AND CPR.NUMERO_GUIA= 2276053288&#xA;&#xA;&#xA;/*&#xA;AND CPR.FECHA_CREACION BETWEEN convert(datetime,'20251201') &#xA;       AND convert(datetime,'20260201')&#xA;*/&#xA;&#xA;&#xA;INSERT INTO #COD_PENDIENTE_POR_RECAUDO&#xA;/*&#xA;SELECT CPR.*,G.ID_CLIENTE,G.ID_REMITE,G.NOMBRE_REMITE_GUIA,G.ID_PRODUCTO AS ID_PRODUCTO_GUIA,G.ID_ESTADOENVIO,G.ID_ESTADOGUIA,ISNULL(G.VALOR_SEG_MAN_GUIAS,0)+ISNULL(G.VALOR_FLETES_GUIAS,0) AS VALOR_ENVIO_GUIA,ISNULL(GIA.VALOR_RECAUDAR_PRODUCTO,0) AS VALOR_RECAUDAR_PRODUCTO_GUIA&#xA;,CAST('' AS nvarchar(50)) AS NOMBRE_ESTADOENVIO,G.FECHA_ENVIO&#xA;*/&#xA;SELECT CPR.*&#xA;,G.ID_CLIENTE,G.ID_REMITE,G.NOMBRE_REMITE_GUIA&#xA;,G.ID_PRODUCTO AS ID_PRODUCTO_GUIA&#xA;,G.ID_ESTADOENVIO&#xA;,G.ID_ESTADOGUIA&#xA;,ISNULL(G.VALOR_SEG_MAN_GUIAS,0)+ISNULL(G.VALOR_FLETES_GUIAS,0) AS VALOR_ENVIO_GUIA&#xA;,ISNULL(GIA.VALOR_RECAUDAR_PRODUCTO,0) AS VALOR_RECAUDAR_PRODUCTO_GUIA&#xA;,CAST('' AS nvarchar(50)) AS NOMBRE_ESTADOENVIO,G.FECHA_ENVIO&#xA;,TCAN.NOMBRE_TIPO_CANAL&#xA;,CTCAN.NOMBRE_CLASE_TIPO_CANAL&#xA;,G.[ID_CIUDAD_ORIGEN]   AS G_ID_CIUDAD_ORIGEN&#xA;,G.[ID_CIUDAD_DESTINO]   AS G_ID_CIUDAD_DESTINO&#xA;FROM [Mece_Logistico].[dbo].[COD_PENDIENTE_POR_RECAUDO] CPR (NOLOCK)&#xA;INNER JOIN [Mece_Logistico].[dbo].[GUIAS] G (nolock) ON G.NUMERO_GUIA=CPR.NUMERO_GUIA&#xA;LEFT JOIN [Mece_Logistico].[dbo].[GUIAS_INF_ADICIONAL] GIA (nolock) ON GIA.NUMERO_GUIA=CPR.NUMERO_GUIA&#xA;LEFT JOIN [tmp_borrar_local].dbo.LPC_GUIAS_SOLUCIONADAS LGS (NOLOCK) ON LGS.NUMERO_GUIA=CPR.NUMERO_GUIA&#xA;LEFT JOIN [Mece_Logistico].[dbo].[CANALES] CAN (NOLOCK) ON CAN.id_pais=G.ID_1 and CAN.id_ciudad=G.ID_2 and CAN.[ID_DIVISION]=G.ID_CANAL&#xA;LEFT JOIN [Mece_Logistico].[dbo].[TIPOS_CANAL] TCAN (NOLOCK) ON TCAN.ID_TIPO_CANAL=CAN.ID_TIPO_CANAL AND TCAN.ID_EST_TIPO_CANAL=1&#xA;LEFT JOIN PARAMETROS.[dbo].[CLASE_TIPO_CANAL] CTCAN (NOLOCK) ON CTCAN.ID_CLASE_TIPO_CANAL=TCAN.CLASE_TIPO_CANAL&#xA;WHERE LGS.NUMERO_GUIA IS NULL AND&#xA;ISNULL(CPR.ESTADO_COD,1)=1-- RECAUDO ESTA ACTIVO&#xA;AND ISNULL(CPR.ESTA_ANULADO,0)=0 -- NO DEBE ESTAR ANULADA&#xA;AND ISNULL(CPR.ESTA_RECAUDADO,0)=1 -- RECAUDADO EN RECAUDOS PERO NO TIENE LA FORMADE RECAUDO&#xA;AND (ISNULL(CPR.NUMERO_ORDEN_SERVICIO,'')='' AND ISNULL(CPR.ID_MODALPAGO,0)=0 AND ISNULL(RTRIM(LTRIM(CPR.NUMERO_APROBACION)),'')='' AND ISNULL(INGRESO_MANUAL,0)=0)&#xA;AND G.ID_DIVISION_PROV IS NULL&#xA;--AND CPR.FECHA_CREACION&gt;=DATEADD(YEAR, -1,GETDATE())&#xA;AND CPR.FECHA_CREACION BETWEEN convert(datetime,@FECH_INI) AND convert(datetime,@FECH_FIN)&#xA;--AND CPR.NUMERO_GUIA= 2276053288&#xA;&#xA;&#xA;&#xA;; WITH CTE_DELL AS ( SELECT ROW_NUMBER() OVER(PARTITION BY NUMERO_GUIA ORDER BY FECHA_ACTUALIZACION DESC) AS ROWID,&#xA;      NUMERO_GUIA FROM #COD_PENDIENTE_POR_RECAUDO) DELETE CTE_DELL WHERE ROWID&gt;1&#xA;&#xA;---SELECT TOP 100 * FROM #COD_PENDIENTE_POR_RECAUDO&#xA;&#xA;&#xA;--Id_Cod NUMERO_GUIA ID_PAIS ID_CIUDAD ID_AUXILIAR ID_DIVISION_RECAUDADORA ID_CIUDAD_ORIGEN ID_CIUDAD_ENTREGA FECHA_ASIGNACION_AL_AUXILIAR ESTADO_COD ESTA_RECAUDADO FECHA_RECAUDO ESTA_DEVUELTO FECHA_DEVOLUCION ESTA_ANULADO FECHA_ANULACION CAUSAL_DEVOLUCION VALOR_ENVIO ES_COD_CORPORATIVO NUMERO_FACTURA VALOR_RECAUDADO VALOR_IMPUESTO CARGAR_A_LA_CUENTA ESTA_CARGADO_A_LA_CUENTA ID_CLIENTE_PS_A_FACTURAR ID_TIPO_COD ID_ACTUALIZADO FECHA_ACTUALIZACION LOGIN_EMPLEADO_CREACION FECHA_CREACION LOGIN_EMPLEADO_MODIFICACION FECHA_MODIFICACION ID_PRODUCTO ID_SUBPRODUCTO ID_FORMA_PAGO ID_TIEMPO_ENTREGA ID_MEDIO_TRANSPORTE PESO_FISICO_GUIA NUMERO_PIEZAS VALOR_DECLARADO VALOR_FLETE VALOR_OTROS VALOR_TOTAL ID_MOVIMIENTO VALOR_PRODUCTO NUMERO_CODIGO_EFECTY INGRESO_MANUAL NUMERO_ORDEN_SERVICIO ID_PUNTO_RECAUDO FECHA_RECAUDO_EFECTY NUMERO_ORDEN_SERVICIO2 ID_MODALPAGO NUMERO_APROBACION FRANQUICIA ID_CLIENTE ID_REMITE NOMBRE_REMITE_GUIA ID_PRODUCTO_GUIA ID_ESTADOENVIO ID_ESTADOGUIA VALOR_ENVIO_GUIA VALOR_RECAUDAR_PRODUCTO_GUIA NOMBRE_ESTADOENVIO FECHA_ENVIO NOMBRE_TIPO_CANAL NOMBRE_CLASE_TIPO_CANAL G_ID_CIUDAD_ORIGEN G_ID_CIUDAD_DESTINO&#xA;&#xA;/*&#xA;select G.NUMERO_GUIA&#xA;,TCAN.NOMBRE_TIPO_CANAL&#xA;,CTCAN.NOMBRE_CLASE_TIPO_CANAL&#xA;from Mece_Logistico.dbo.guias G (nolock)&#xA;left JOIN [Mece_Logistico].[dbo].[CANALES] CAN (NOLOCK) ON CAN.id_pais=G.ID_1 and CAN.id_ciudad=G.ID_2 and CAN.[ID_DIVISION]=G.ID_CANAL&#xA;left JOIN [Mece_Logistico].[dbo].[TIPOS_CANAL] TCAN (NOLOCK) ON TCAN.ID_TIPO_CANAL=CAN.ID_TIPO_CANAL AND TCAN.ID_EST_TIPO_CANAL=1&#xA;left JOIN PARAMETROS.[dbo].[CLASE_TIPO_CANAL] CTCAN (NOLOCK) ON CTCAN.ID_CLASE_TIPO_CANAL=TCAN.CLASE_TIPO_CANAL&#xA;where G.ID_CANAL IS NOT NULL&#xA;AND FECHA_ENVIO&gt;='20260120 00:00:00'&#xA;*/&#xA;&#xA;CREATE NONCLUSTERED INDEX [IX_NUMERO_GUIA] ON #COD_PENDIENTE_POR_RECAUDO ([NUMERO_GUIA] ASC)&#xA;&#xA;&#xA;--Se quitan envios siniestrados&#xA;DELETE GPR FROM #COD_PENDIENTE_POR_RECAUDO GPR&#xA;WHERE ID_ESTADOENVIO in(5,4)&#xA;&#xA;--Quita las guias son del canal retail y no son COD y no contraentrega ecommerce&#xA;DELETE GPR FROM #COD_PENDIENTE_POR_RECAUDO GPR&#xA;WHERE ID_FORMA_PAGO=1 AND ISNULL(ID_PRODUCTO_GUIA,999) !=86&#xA;--WHERE ID_FORMA_PAGO=1 AND ISNULL(ID_PRODUCTO,999) !=86&#xA;&#xA;&#xA;--Quita las guias CREDICONTADO (Solicitud de luis gabriel rodriguez y Holman Salamanca el dia 2026-04-09 11:44am )&#xA;/*&#xA;&#xA;ID_FORMAPAGO NOMBRE_FORMAPAGO&#xA;1 CONTADO&#xA;2 CREDITO&#xA;3 PREPAGO DIGITAL&#xA;4 C.O.D. &#xA;5 CHEQUE&#xA;6 TARJETAS FINANCIERAS&#xA;7 CREDI CONTADO&#xA;9 QR&#xA;10 TARJETA&#xA;*/&#xA;DELETE GPR FROM #COD_PENDIENTE_POR_RECAUDO GPR&#xA;WHERE ID_FORMA_PAGO=7&#xA;&#xA;/*&#xA;--&gt;credicontado --9175427260&#xA;--&gt;contado --9177482665&#xA;SELECT * FROM [Mece_Logistico].[dbo].[COD_PENDIENTE_POR_RECAUDO] CPR (NOLOCK)&#xA;WHERE ID_FORMA_PAGO=7&#xA;AND NUMERO_GUIA=9177482665&#xA;*/&#xA;&#xA;--SELECT * FROM #COD_PENDIENTE_POR_RECAUDO CPR (NOLOCK)&#xA;--WHERE --NUMERO_GUIA=2143658629&#xA;--ID_PRODUCTO=86&#xA;--INSERT INTO #TMP_GUIAS_PENDIENTE_RECAUDO&#xA;&#xA;UPDATE CPR SET CPR.NOMBRE_ESTADOENVIO=E.NOMBRE_ESTADOENVIO&#xA;FROM #COD_PENDIENTE_POR_RECAUDO CPR&#xA;INNER JOIN PARAMETROS.DBO.ESTADOSENVIO E (NOLOCK)ON E.ID_ESTADOENVIO=CPR.ID_ESTADOENVIO&#xA;&#xA;--TRUNCATE TABLE #TMP_GUIAS_PENDIENTE_RECAUDO&#xA;INSERT INTO #TMP_GUIAS_PENDIENTE_RECAUDO(&#xA;NUMERO_GUIA,&#xA;ID_ESTADOENVIO,&#xA;NOMBRE_ESTADOENVIO,&#xA;FORMA_PAGO,&#xA;VALOR_A_RECAUDAR,&#xA;ID_REMITE,&#xA;NOMBRE_REMITE_GUIA,&#xA;FECHA_ENVIO,&#xA;VALOR_RECAUDADO,&#xA;FECHA_RECAUDO,&#xA;NUMERO_ORDEN_SERVICIO,&#xA;FECHA_RECAUDO_EFECTY,&#xA;ID_CLIENTE,&#xA;NOMBRE_TIPO_CANAL,&#xA;NOMBRE_CLASE_TIPO_CANAL,&#xA;G_ID_CIUDAD_ORIGEN,&#xA;G_ID_CIUDAD_DESTINO&#xA;)&#xA;SELECT CPR.NUMERO_GUIA,CPR.ID_ESTADOENVIO,CPR.NOMBRE_ESTADOENVIO,&#xA;CASE WHEN CPR.ID_FORMA_PAGO=4 AND CPR.ID_CLIENTE IS NULL THEN 'C.O.D.' WHEN ISNULL(CPR.ID_PRODUCTO,CPR.ID_PRODUCTO_GUIA)=86 THEN 'CONTRAENTREGA ECOMMERCE' WHEN (CPR.ID_FORMA_PAGO=2 OR CPR.ID_CLIENTE IS NOT NULL) THEN 'LPC' ELSE '' END AS FORMA_PAGO,&#xA;CASE WHEN ISNULL(CPR.VALOR_TOTAL,0)!=0 THEN CPR.VALOR_TOTAL&#xA;WHEN CPR.ID_FORMA_PAGO=4 AND VALOR_FLETE IS NOT NULL THEN ISNULL(CPR.VALOR_FLETE,0) + ISNULL(CPR.VALOR_OTROS,0)&#xA;WHEN CPR.ID_FORMA_PAGO=4 AND VALOR_FLETE IS NULL THEN ISNULL(CPR.VALOR_ENVIO_GUIA,0)&#xA;WHEN ISNULL(CPR.ID_PRODUCTO,CPR.ID_PRODUCTO_GUIA)=86 THEN ISNULL(CPR.VALOR_DECLARADO,CPR.VALOR_PRODUCTO)&#xA;WHEN (CPR.ID_FORMA_PAGO=2 OR CPR.ID_CLIENTE IS NOT NULL) THEN ISNULL(CPR.VALOR_DECLARADO,CPR.VALOR_PRODUCTO) ELSE 0 END AS VALOR_A_RECAUDAR&#xA;,CPR.ID_REMITE&#xA;,CPR.NOMBRE_REMITE_GUIA&#xA;,CPR.FECHA_ENVIO&#xA;,ISNULL(CPR.VALOR_RECAUDADO,0)&#xA;,CPR.FECHA_RECAUDO&#xA;,ISNULL(CPR.NUMERO_ORDEN_SERVICIO,0)&#xA;,CPR.FECHA_RECAUDO_EFECTY&#xA;,isnull(CPR.ID_CLIENTE,'0') ID_CLIENTE&#xA;,CPR.NOMBRE_TIPO_CANAL&#xA;,CPR.NOMBRE_CLASE_TIPO_CANAL&#xA;,G_ID_CIUDAD_ORIGEN&#xA;,G_ID_CIUDAD_DESTINO&#xA;--,CPR.VALOR_TOTAL&#xA;--INTO #TMP_GUIAS_PENDIENTE_RECAUDO_1&#xA;FROM #COD_PENDIENTE_POR_RECAUDO CPR (NOLOCK)&#xA;WHERE LEN(CPR.NUMERO_GUIA)&gt;7&#xA;--INNER JOIN [Mece_Logistico].[dbo].[GUIAS] G (nolock) ON G.NUMERO_GUIA=CPR.NUMERO_GUIA&#xA;&#xA;--CREATE NONCLUSTERED INDEX [IX_NUMERO_GUIA] ON #TMP_GUIAS_PENDIENTE_RECAUDO_1 ([NUMERO_GUIA] ASC)&#xA;&#xA;--select GPR.* from #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA;&#xA;&#xA;UPDATE GPR SET&#xA; --GPR.NOMBRE_RESPONSABLE_ULT_MOV='SERVIENTREGA S.A.'&#xA; GPR.ID_PROCESO_ULT_MOV=SE.ID_PROCESO&#xA; ,GPR.NOMBRE_PROCESO_ULT_MOV=PRO.NOMBRE_PROCESO_LOG&#xA; ,GPR.ID_CONCEPTO_ULT_MOV=ISNULL(SE.ID_CONCEPTO,0)&#xA; ,GPR.NOMBRE_CONCEPTO_ULT_MOV=ISNULL(ICON.NOMBRE_CONCEPTO,'')&#xA; ,GPR.NUMERO_MOVIMI_ULT_MOV=SE.NUMERO_MOVIMI&#xA; ,GPR.CONSECUT_MOVIMI_ULT_MOV=SE.CONSECUT_MOVIMI&#xA; ,GPR.FECHA_HORA_MOVIMI_ULT_MOV=SE.FECHA_HORA_MOVIMIENTO&#xA; --,GPR.ID_CONDUCTOR_ULT_MOV=DOC.ID_COURIER_CONDUCTOR&#xA; --,GPR.ID_AUXILIAR_ULT_MOV=DOC.ID_AUXILIAR1_VEHICULO&#xA; --,GPR.ID_PAIS_ZONA_URBA_ULT_MOV=DOC.ID_PAIS_ZONA_URBA  &#xA; --,GPR.ID_CIUDAD_ZONA_URBA_ULT_MOV=DOC.ID_CIUDAD_ZONA_URBA &#xA; --,GPR.ID_TIPO_ZONA_URBA_ULT_MOV=DOC.ID_TIPO_ZONA_URBA&#xA; --,GPR.ID_ZONA_URBA_ULT_MOV=DOC.ID_ZONA_URBA&#xA; FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; INNER JOIN MECE_LOGISTICO.dbo.SEGUIMIENTO_ENVIO SE WITH(NOLOCK) on se.NUMERO_GUIA=GPR.NUMERO_GUIA&#xA; --INNER JOIN MECE_LOGISTICO.dbo.DOCUMENTOS DOC (NOLOCK) ON&#xA; --DOC.ID_PROCESO=GPR.[ID_PROCESO_ULT_MOV] AND DOC.NUMERO_MOVIMI=GPR.[NUMERO_MOVIMI_ULT_MOV] AND DOC.CONSECUT_MOVIMI=GPR.[CONSECUT_MOVIMI_ULT_MOV]&#xA; INNER JOIN PARAMETROS.DBO.PROCESOS PRO (NOLOCK) ON PRO.ID_PROCESO=SE.ID_PROCESO&#xA; LEFT JOIN PARAMETROS.DBO.ITEM_CONCEPTO ICON (NOLOCK) ON ICON.ID_PAIS=1 AND ICON.ID_PROCESO=SE.ID_PROCESO AND ICON.ID_CONCEPTO=SE.ID_CONCEPTO&#xA; WHERE se.FECHA_HORA_MOVIMIENTO= (select MAX(se1.FECHA_HORA_MOVIMIENTO) from MECE_LOGISTICO.dbo.SEGUIMIENTO_ENVIO SE1 WITH(NOLOCK)&#xA;          where SE1.numero_guia=GPR.NUMERO_GUIA)&#xA; &#xA; UPDATE GPR SET&#xA; GPR.ID_CONDUCTOR_ULT_MOV=DOC.ID_COURIER_CONDUCTOR&#xA; ,GPR.ID_AUXILIAR_ULT_MOV=DOC.ID_AUXILIAR1_VEHICULO&#xA; ,GPR.ID_PAIS_ZONA_URBA_ULT_MOV=DOC.ID_PAIS_ZONA_URBA  &#xA; ,GPR.ID_CIUDAD_ZONA_URBA_ULT_MOV=DOC.ID_CIUDAD_ZONA_URBA &#xA; ,GPR.ID_TIPO_ZONA_URBA_ULT_MOV=DOC.ID_TIPO_ZONA_URBA&#xA; ,GPR.ID_ZONA_URBA_ULT_MOV=DOC.ID_ZONA_URBA&#xA; FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; INNER JOIN MECE_LOGISTICO.DBO.DOCUMENTOS DOC (NOLOCK) ON&#xA; DOC.ID_PROCESO=GPR.[ID_PROCESO_ULT_MOV] AND DOC.NUMERO_MOVIMI=GPR.[NUMERO_MOVIMI_ULT_MOV] AND DOC.CONSECUT_MOVIMI=GPR.[CONSECUT_MOVIMI_ULT_MOV]&#xA;&#xA; --SELECT GPR.ID_CONDUCTOR_ULT_MOV&#xA; &#xA; UPDATE GPR SET&#xA; GPR.ID_CONDUCTOR_ULT_MOV=ISNULL(RTRIM(LTRIM(EC.ID_EMPLEADO)),'')&#xA; ,GPR.CONDUCTOR_ULT_MOV =ISNULL(RTRIM(LTRIM(EC.NOMBRE_EMPLEADO)) +' '+ RTRIM(LTRIM(EC.APELLIDO_EMPLEADO)),'') &#xA; ,GPR.ID_AUXILIAR_ULT_MOV=ISNULL(RTRIM(LTRIM(EA.ID_EMPLEADO)),'')&#xA; ,GPR.AUXILIAR_ULT_MOV=ISNULL(RTRIM(LTRIM(EA.NOMBRE_EMPLEADO)) +' '+ RTRIM(LTRIM(EA.APELLIDO_EMPLEADO)),'') &#xA; FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; LEFT JOIN PARAMETROS.DBO.EMPLEADOS EC (NOLOCK) ON EC.ID_EMPLEADO=GPR.ID_CONDUCTOR_ULT_MOV&#xA; LEFT JOIN PARAMETROS.DBO.EMPLEADOS EA (NOLOCK) ON EA.ID_EMPLEADO=GPR.ID_AUXILIAR_ULT_MOV&#xA;&#xA;&#xA; --SELECT GPR.NUMERO_GUIA,ISNULL(DIV.NOMBRE_DIVISION,'') AS NOMBRE_CDS, ISNULL(CTCAN.[NOMBRE_CLASE_TIPO_CANAL],'') as TIPO_CANAL&#xA;UPDATE GPR SET NOMBRE_CDS_ULT_MOV=ISNULL(DIV.NOMBRE_DIVISION,''),&#xA; TIPO_CANAL_ULT_MOV=ISNULL(CTCAN.[NOMBRE_CLASE_TIPO_CANAL],'')&#xA; FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; --INNER JOIN MECE_LOGISTICO.DBO.DOCUMENTOS DOC (NOLOCK) ON&#xA; --DOC.ID_PROCESO=GPR.[ID_PROCESO_ULT_MOV] AND DOC.NUMERO_MOVIMI=GPR.[NUMERO_MOVIMI_ULT_MOV] AND DOC.CONSECUT_MOVIMI=GPR.[CONSECUT_MOVIMI_ULT_MOV]&#xA; INNER JOIN PARAMETROS.DBO.ZONASURBANAS Z (NOLOCK) &#xA; ON Z.ID_PAIS = GPR.ID_PAIS_ZONA_URBA_ULT_MOV AND Z.ID_CIUDAD = GPR.ID_CIUDAD_ZONA_URBA_ULT_MOV &#xA;  AND Z.ID_TIPO_ZONA_URBA = GPR.ID_TIPO_ZONA_URBA_ULT_MOV AND Z.ID_ZONA_URBA = GPR.ID_ZONA_URBA_ULT_MOV --AND Z.CATEGORIA_ZONA_URBA = 8 --CLICOH&#xA; INNER JOIN PARAMETROS.DBO.DIVISIONES DIV (NOLOCK) ON DIV.ID_PAIS = Z.ID_PAIS_CANAL AND DIV.ID_CIUDAD = Z.ID_CIUDAD_CANAL AND DIV.ID_DIVISION = Z.ID_CANAL&#xA; INNER JOIN [Mece_Logistico].[dbo].[CANALES] CAN (NOLOCK) ON CAN.id_pais=DIV.ID_PAIS and CAN.id_ciudad=DIV.ID_CIUDAD and CAN.[ID_DIVISION]=DIV.ID_DIVISION&#xA; INNER JOIN [Mece_Logistico].[dbo].[TIPOS_CANAL] TCAN (NOLOCK) ON TCAN.ID_TIPO_CANAL=CAN.ID_TIPO_CANAL AND TCAN.ID_EST_TIPO_CANAL=1&#xA; INNER JOIN PARAMETROS.[dbo].[CLASE_TIPO_CANAL] CTCAN (NOLOCK) ON CTCAN.ID_CLASE_TIPO_CANAL=TCAN.CLASE_TIPO_CANAL&#xA;&#xA;&#xA; --UPDATE GPR SET ESTADO_ENTREGA='VENCIDO'&#xA; --SELECT * FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; UPDATE GPR SET ESTADO_ENTREGA='VENCIDO'&#xA; FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; WHERE GPR.ID_PROCESO_ULT_MOV=9 AND ID_CONCEPTO_ULT_MOV IN(9,7,2,4)--9 ENTREGAS OFIC  C.O.D. Y/O LPC EMPRESARIO --7 EMPRESARIO SATELITE ENTREGA EN OFICINA&#xA; --2 RECLAMO OFICINA Y 4 C.O.D RECLAMO OFICINA&#xA; AND DATEDIFF(DAY, FECHA_HORA_MOVIMI_ULT_MOV,GETDATE())&gt;8 -- MAS DE 8 DIAS&#xA; &#xA; UPDATE GPR SET ESTADO_ENTREGA='VENCIDO'&#xA; FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; WHERE GPR.ID_PROCESO_ULT_MOV=31 --ENVIO PARA ENTREGA EN OFICINA&#xA; AND DATEDIFF(DAY, FECHA_HORA_MOVIMI_ULT_MOV,GETDATE())&gt;8 -- MAS DE 8 DIAS&#xA;&#xA; UPDATE GPR SET ESTADO_ENTREGA='VENCIDO'&#xA; FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; WHERE GPR.ID_PROCESO_ULT_MOV=9 AND ID_CONCEPTO_ULT_MOV IN(10,8) --10 ENTR A DOMICI  LPC / COD EMPRESARIOS SAT --8 EMPRESARIO SATELITE ENTREGA EN DOMICILIO&#xA; AND DATEDIFF(DAY, FECHA_HORA_MOVIMI_ULT_MOV,GETDATE())&gt;3-- MAS DE 3 DIAS&#xA; &#xA; UPDATE GPR SET ESTADO_ENTREGA='VENCIDO'&#xA; FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; WHERE GPR.ID_PROCESO_ULT_MOV=32 --ENVIO PARA ENTREGA A DOMICILIO&#xA; AND DATEDIFF(DAY, FECHA_HORA_MOVIMI_ULT_MOV,GETDATE())&gt;3-- MAS DE 3 DIAS&#xA;&#xA; UPDATE GPR SET ESTADO_ENTREGA='VENCIDO'&#xA; FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; WHERE GPR.ID_PROCESO_ULT_MOV=9 AND ID_CONCEPTO_ULT_MOV IN(1,3) --SALIDA A ZONA Y C.O.D EN DISTRIBUCION&#xA; AND DATEDIFF(DAY, FECHA_HORA_MOVIMI_ULT_MOV,GETDATE())&gt;1 --MAS DE UN DIA&#xA;&#xA;&#xA;&#xA;DROP TABLE IF EXISTS #TMP_GUIAS_PENDIENTE_RECAUDO_SZU&#xA; SELECT &#xA; TMP.NUMERO_GUIA&#xA; ,(SE.CONSECUT_MOVIMI)   AS CONSECUT_MOVIMI_SZU&#xA; ,(SE.NUMERO_MOVIMI)    AS NUMERO_MOVIMI_SZU&#xA; ,(SE.FECHA_HORA_MOVIMIENTO)  AS FECHA_HORA_MOVIMI_ULT_MOV_SZU&#xA;INTO #TMP_GUIAS_PENDIENTE_RECAUDO_SZU&#xA;FROM #TMP_GUIAS_PENDIENTE_RECAUDO TMP&#xA;INNER JOIN Mece_Logistico..SEGUIMIENTO_ENVIO SE&#xA;ON SE.NUMERO_GUIA=TMP.NUMERO_GUIA&#xA;WHERE SE.ID_PROCESO=9&#xA;---GROUP BY  TMP.NUMERO_GUIA&#xA;&#xA;;WITH CTE AS(&#xA;SELECT &#xA;ROWID = ROW_NUMBER() OVER(PARTITION BY NUMERO_GUIA ORDER BY FECHA_HORA_MOVIMI_ULT_MOV_SZU DESC)&#xA;,NUMERO_GUIA,FECHA_HORA_MOVIMI_ULT_MOV_SZU&#xA;FROM #TMP_GUIAS_PENDIENTE_RECAUDO_SZU&#xA;)&#xA;DELETE CTE WHERE ROWID&gt;1&#xA;&#xA;&#xA;&#xA;--SELECT * FROM #TMP_GUIAS_PENDIENTE_RECAUDO TMP&#xA;&#xA;&#xA;&#xA;DROP TABLE IF EXISTS #TMP_GUIAS_CON_TAREAS &#xA; SELECT &#xA; TMP.NUMERO_GUIA,&#xA; COUNT(TAR.NUMERO_DOCPROBLEMA) AS NUMERO_TAREAS&#xA;INTO #TMP_GUIAS_CON_TAREAS&#xA;FROM #TMP_GUIAS_PENDIENTE_RECAUDO TMP&#xA;INNER JOIN Mece_Logistico..TAREAS TAR WITH(NOLOCK)&#xA;ON TAR.NUMERO_DOCPROBLEMA=CONVERT(CHAR(20),TMP.NUMERO_GUIA)&#xA;GROUP BY TMP.NUMERO_GUIA&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;DROP TABLE IF EXISTS ##TMP_GUIAS_PENDIENTE_RECAUDO_FINAL_PBI;&#xA;SELECT --GPR.*&#xA;GPR.NUMERO_GUIA &#xA;--GPR.ID_ESTADOENVIO &#xA;,GPR.NOMBRE_ESTADOENVIO &#xA;,GPR.FORMA_PAGO &#xA;,GPR.VALOR_A_RECAUDAR &#xA;,GPR.ID_REMITE &#xA;,GPR.NOMBRE_REMITE_GUIA &#xA;,GPR.FECHA_ENVIO&#xA;,GPR.VALOR_RECAUDADO&#xA;,GPR.FECHA_RECAUDO&#xA;,GPR.NUMERO_ORDEN_SERVICIO&#xA;,GPR.FECHA_RECAUDO_EFECTY&#xA;,GPR.ESTADO_ENTREGA&#xA;--,GPR.NOMBRE_RESPONSABLE_ULT_MOV &#xA;--ID_PROCESO_ULT_MOV &#xA;--NOMBRE_PROCESO_ULT_MOV &#xA;--NUMERO_MOVIMI_ULT_MOV &#xA;--CONSECUT_MOVIMI_ULT_MOV &#xA;--FECHA_HORA_MOVIMI_ULT_MOV&#xA;&#xA;--,ISNULL(ISNULL(CLO.CENTRO_LOGISTICO,CLD.CENTRO_LOGISTICO),'')  AS CPL_ORIGEN_ULT_MOV&#xA;--,ISNULL(ISNULL(RO.NOMBRE_REGIONAL,RD.NOMBRE_REGIONAL),'')  AS REGIONAL_ORIGEN_ULT_MOV&#xA;--,ISNULL(ISNULL(CO.NOMBRE_CIUDAD,CD.NOMBRE_CIUDAD),'')  AS CIUDAD_ORIGEN_ULT_MOV&#xA;--,ISNULL(ISNULL(CLD.CENTRO_LOGISTICO,CLO.CENTRO_LOGISTICO),'') AS CPL_DESTINO_ULT_MOV&#xA;--,ISNULL(ISNULL(RD.NOMBRE_REGIONAL,RO.NOMBRE_REGIONAL),'') AS REGIONAL_DESTINO_ULT_MOV&#xA;--,ISNULL(ISNULL(CD.NOMBRE_CIUDAD,CO.NOMBRE_CIUDAD),'') AS CIUDAD_DESTINO_MOV&#xA;,CASE WHEN ID_PROCESO!=14 THEN &#xA;ISNULL(ISNULL(CLO.CENTRO_LOGISTICO,CLD.CENTRO_LOGISTICO),'')  ELSE ISNULL(ISNULL(CLD.CENTRO_LOGISTICO,CLO.CENTRO_LOGISTICO),'') END AS CPL_ULT_MOV&#xA;,CASE WHEN ID_PROCESO!=14 THEN &#xA;ISNULL(ISNULL(RO.NOMBRE_REGIONAL,RD.NOMBRE_REGIONAL),'') ELSE ISNULL(ISNULL(RD.NOMBRE_REGIONAL,RO.NOMBRE_REGIONAL),'') END  AS REGIONAL_ULT_MOV&#xA;,CASE WHEN ID_PROCESO!=14 THEN &#xA;ISNULL(ISNULL(CO.NOMBRE_CIUDAD,CD.NOMBRE_CIUDAD),'')  ELSE ISNULL(ISNULL(CD.NOMBRE_CIUDAD,CO.NOMBRE_CIUDAD),'') END  AS CIUDAD_ULT_MOV&#xA;,ISNULL(CASE &#xA; WHEN ISNULL(DOC.ID_CIUDAD_ZONA_URBA,0) !=0 THEN&#xA; ROZ.NOMBRE_REGIONAL+' - '+ DCOZ.NOMBRE_DEPARTAMENTO +' - '+ COZ.NOMBRE_CIUDAD &#xA; WHEN  ISNULL(DOC.ID_CIUDAD_DIVISION_ORIGEN,0) !=0 AND DOC.ID_PROCESO!=14 THEN&#xA; ROM.NOMBRE_REGIONAL+' - '+ DCOM.NOMBRE_DEPARTAMENTO +' - '+ COM.NOMBRE_CIUDAD&#xA; ELSE&#xA; ROD.NOMBRE_REGIONAL+' - '+ DCOD.NOMBRE_DEPARTAMENTO +' - '+ COD.NOMBRE_CIUDAD &#xA; END,'') AS REG_DEPART_CIUDAD_ULTIMO_MOV&#xA;&#xA;,ISNULL(DOC.PLACA_VEHICULO_DOCU,'') as PLACA_VEHICULO_ULTIMO_MOV&#xA;,ISNULL(O.[NOMBRE_OPERATIVO],'') AS NOMBRE_OPERATIVO_ULTIMO_MOV&#xA;,ISNULL(Z.NOMBRE_ZONA_URBA,'') AS ZONA_URBANA_ULTIMO_MOV&#xA;,ISNULL(CZ.NOMBRE_CATEGORIA,'') AS CATEGORIA_ZONA_ULTIMO_MOV&#xA;,ISNULL(TZU.NOMBRE_TIPO_ZONA_URBA,'') AS TIPO_ZONA_ULTIMO_MOV&#xA;,ISNULL(GPR.NOMBRE_CDS_ULT_MOV,'') AS NOMBRE_CDS_ULT_MOV&#xA;,ISNULL(TIPO_CANAL_ULT_MOV,'') AS TIPO_CANAL_ULT_MOV&#xA;--,GR.ID_PROCESO &#xA;,ISNULL(GPR.NOMBRE_PROCESO_ULT_MOV,'') AS PROCESO_LOG_ULTIMO_MOV  &#xA;,ISNULL(GPR.NOMBRE_CONCEPTO_ULT_MOV,'') AS CONCEPTO_ULT_MOV&#xA;--,GR.ID_CONCEPTO  &#xA;--,GR.FECHA_HORA_MOVIMIENTO&#xA;,ISNULL(cast(GPR.ID_PROCESO_ULT_MOV as nvarchar) +' - '+ RTRIM(GPR.NOMBRE_PROCESO_ULT_MOV),'') AS NOMBRE_ULTIMO_MOV&#xA;,ISNULL(CASE WHEN DIO.ID_DIVISION IS NOT NULL THEN cast(DIO.ID_DIVISION as nvarchar) +' - '+ RTRIM(DIO.NOMBRE_DIVISION)&#xA;ELSE cast(DID.ID_DIVISION as nvarchar) +' - '+ RTRIM(DID.NOMBRE_DIVISION) END,'') AS BODEGA_ULTIMO_MOV&#xA;,ISNULL(cast(GPR.ID_PROCESO_ULT_MOV as nvarchar) +' - '+ RTRIM(GPR.[NUMERO_MOVIMI_ULT_MOV])+' - '+  cast(GPR.[CONSECUT_MOVIMI_ULT_MOV] as nvarchar),'') as ULTIMO_MOV_LOGISTICO&#xA;,ISNULL(CONVERT(nvarchar(20),GPR.FECHA_HORA_MOVIMI_ULT_MOV,120),'') AS FECHA_ULTIMO_MOV&#xA;,GPR.ID_CONDUCTOR_ULT_MOV&#xA;,GPR.CONDUCTOR_ULT_MOV&#xA;,GPR.ID_AUXILIAR_ULT_MOV&#xA;,GPR.AUXILIAR_ULT_MOV&#xA;,GPR.ID_CLIENTE&#xA;,SZU.CONSECUT_MOVIMI_SZU&#xA;,SZU.NUMERO_MOVIMI_SZU&#xA;,SZU.FECHA_HORA_MOVIMI_ULT_MOV_SZU&#xA;,GPR.NOMBRE_TIPO_CANAL&#xA;,GPR.NOMBRE_CLASE_TIPO_CANAL&#xA;,TAR.NUMERO_TAREAS&#xA;,G_ID_CIUDAD_ORIGEN&#xA;,G_ID_CIUDAD_DESTINO&#xA;--,DOC.*&#xA;INTO ##TMP_GUIAS_PENDIENTE_RECAUDO_FINAL_PBI&#xA;&#xA;FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA;--------------------------- CIUDAD ULTIMO MOV ZONA&#xA;  LEFT JOIN MECE_LOGISTICO.DBO.DOCUMENTOS DOC (NOLOCK) ON&#xA; DOC.ID_PROCESO=GPR.[ID_PROCESO_ULT_MOV] AND DOC.NUMERO_MOVIMI=GPR.[NUMERO_MOVIMI_ULT_MOV] AND DOC.CONSECUT_MOVIMI=GPR.[CONSECUT_MOVIMI_ULT_MOV]&#xA; --AND DOC.ID_DIVISION_DESTINO IN (9311, 9308, 9304, 9313, 9310, 9312, 9711, 9710)&#xA;  LEFT JOIN PARAMETROS.DBO.CIUDADES COZ (NOLOCK) ON  COZ.ID_PAIS=1 AND COZ.ID_CIUDAD=DOC.ID_CIUDAD_ZONA_URBA&#xA;  LEFT JOIN PARAMETROS.DBO.REGIONALES_PAIS ROZ (NOLOCK) ON  ROZ.ID_PAIS=COZ.ID_PAIS AND ROZ.ID_REGIONAL=COZ.ID_REGIONAL&#xA;  LEFT JOIN PARAMETROS.DBO.DEPARTAMENTOS DCOZ (NOLOCK) ON  DCOZ.ID_PAIS=COZ.ID_PAIS AND DCOZ.ID_DEPARTAMENTO=COZ.ID_DEPARTAMENTO&#xA;   LEFT JOIN PARAMETROS.DBO.ZONASURBANAS Z (NOLOCK) &#xA; ON Z.ID_PAIS = DOC.ID_PAIS_ZONA_URBA AND Z.ID_CIUDAD = DOC.ID_CIUDAD_ZONA_URBA AND Z.ID_TIPO_ZONA_URBA = DOC.ID_TIPO_ZONA_URBA AND Z.ID_ZONA_URBA = DOC.ID_ZONA_URBA --AND Z.CATEGORIA_ZONA_URBA = 8 --CLICOH&#xA;  LEFT JOIN [PARAMETROS].[dbo].[CATEGORIAZONASURBANAS] CZ (NOLOCK) ON CZ.Id_Categoria=Z.CATEGORIA_ZONA_URBA&#xA;  LEFT JOIN [PARAMETROS].[dbo].[TIPOSZONASURBANAS] TZU (NOLOCK) ON TZU.ID_TIPO_ZONA_URBA=Z.ID_TIPO_ZONA_URBA&#xA; --------------------------- CIUDAD ULTIMO MOV DOCUMENTO&#xA;  LEFT JOIN PARAMETROS.DBO.CIUDADES COM (NOLOCK) ON  COM.ID_PAIS=1 AND COM.ID_CIUDAD=DOC.ID_CIUDAD_DIVISION_ORIGEN&#xA;  LEFT JOIN PARAMETROS.DBO.REGIONALES_PAIS ROM (NOLOCK) ON  ROM.ID_PAIS=COM.ID_PAIS AND ROM.ID_REGIONAL=COM.ID_REGIONAL&#xA;  LEFT JOIN PARAMETROS.DBO.DEPARTAMENTOS DCOM (NOLOCK) ON  DCOM.ID_PAIS=COM.ID_PAIS AND DCOM.ID_DEPARTAMENTO=COM.ID_DEPARTAMENTO&#xA;  --------------------------- CIUDAD DESTINO ULTIMO MOV DOCUMENTO&#xA;  LEFT JOIN PARAMETROS.DBO.CIUDADES COD(NOLOCK) ON  COD.ID_PAIS=1 AND COD.ID_CIUDAD=DOC.ID_CIUDAD_DESTINO&#xA;  LEFT JOIN PARAMETROS.DBO.REGIONALES_PAIS ROD (NOLOCK) ON  ROD.ID_PAIS=COD.ID_PAIS AND ROD.ID_REGIONAL=COD.ID_REGIONAL&#xA;  LEFT JOIN PARAMETROS.DBO.DEPARTAMENTOS DCOD (NOLOCK) ON  DCOD.ID_PAIS=COD.ID_PAIS AND DCOD.ID_DEPARTAMENTO=COD.ID_DEPARTAMENTO&#xA;  --------------------------- DIVISION ORIGEN ULTIMO MOV DOCUMENTO&#xA;  LEFT JOIN PARAMETROS.DBO.DIVISIONES DIO(NOLOCK) ON DIO.ID_PAIS=DOC.ID_PAIS_DIVISION_ORIGEN&#xA; AND DIO.ID_CIUDAD=DOC.ID_CIUDAD_DIVISION_ORIGEN AND DIO.ID_DIVISION=DOC.ID_DIVISION_ORIGEN&#xA;  --------------------------- DIVISION DESTINO ULTIMO MOV DOCUMENTO&#xA;  LEFT JOIN PARAMETROS.DBO.DIVISIONES DID(NOLOCK) ON DID.ID_PAIS=DOC.ID_PAIS_DESTINO&#xA; AND DID.ID_CIUDAD=DOC.ID_CIUDAD_DESTINO AND DID.ID_DIVISION=DOC.ID_DIVISION_DESTINO&#xA;-------------------------------------------------------------&#xA;  LEFT JOIN [PARAMETROS].[dbo].CIUDADES CO (NOLOCK) ON CO.ID_PAIS=ID_PAIS_DIVISION_ORIGEN AND CO.ID_CIUDAD=DOC.ID_CIUDAD_DIVISION_ORIGEN&#xA;  LEFT JOIN [PARAMETROS].[dbo].REGIONALES_PAIS RO (NOLOCK) ON RO.ID_PAIS=1 AND RO.ID_REGIONAL=CO.[ID_REGIONAL]&#xA;  LEFT JOIN [PARAMETROS].[dbo].CIUDADES CD (NOLOCK) ON CD.ID_PAIS=DOC.ID_PAIS_DESTINO AND CD.ID_CIUDAD=DOC.ID_CIUDAD_DESTINO&#xA;  LEFT JOIN [PARAMETROS].[dbo].REGIONALES_PAIS RD (NOLOCK) ON RD.ID_PAIS=1 AND RD.ID_REGIONAL=CD.[ID_REGIONAL]&#xA;  LEFT JOIN [PARAMETROS].[dbo].[OPERATIVOS] O (NOLOCK) ON O.[ID_PAIS_ORIGEN]=DOC.ID_PAIS_OPERATIVO AND O.[ID_CIUDAD_ORIGEN]=DOC.ID_CIUDAD_OPERATIVO&#xA; AND O.[ID_OPERATIVO]=DOC.ID_OPERATIVO&#xA;  LEFT JOIN #TMP_CIUDADES_ANEXAS CAO (NOLOCK) ON CAO.ID_PAIS=1 AND CAO.[ID_CIUDAD_ANEXA]=CO.ID_CIUDAD --AND CAO.RECOLECCION=1&#xA;  LEFT JOIN PARAMETROS.DBO.CENTROS_LOGISTICOS CLO (NOLOCK) ON CLO.ID_PAIS=1 AND CLO.ID_CIUDAD=CAO.ID_CIUDAD AND CLO.ID_CENTRO_LOGISTICO=1 AND CLO.ID_ESTADO=1&#xA;  LEFT JOIN #TMP_CIUDADES_ANEXAS CAD (NOLOCK) ON CAD.ID_PAIS=1 AND CAD.[ID_CIUDAD_ANEXA]=CD.ID_CIUDAD --AND CAD.RECOLECCION=1&#xA;  LEFT JOIN PARAMETROS.DBO.CENTROS_LOGISTICOS CLD (NOLOCK) ON CLD.ID_PAIS=1 AND CLD.ID_CIUDAD=CAD.ID_CIUDAD AND CLD.ID_CENTRO_LOGISTICO=1 AND CLD.ID_ESTADO=1&#xA;LEFT JOIN #TMP_GUIAS_PENDIENTE_RECAUDO_SZU SZU ON SZU.NUMERO_GUIA=GPR.NUMERO_GUIA&#xA;LEFT JOIN #TMP_GUIAS_CON_TAREAS TAR ON TAR.NUMERO_GUIA=GPR.NUMERO_GUIA&#xA;--WHERE &#xA;--NUMERO_GUIA=2273736466&#xA;--ID_PROCESO=32&#xA;&#xA;--DELETE CPR FROM #TMP_GUIAS_PENDIENTE_RECAUDO CPR &#xA;--WHERE&#xA;--NOT EXISTS (SELECT TOP 1 SE.NUMERO_GUIA FROM Mece_Logistico.DBO.SEGUIMIENTO_ENVIO SE (NOLOCK) WHERE SE.NUMERO_GUIA=CPR.NUMERO_GUIA AND SE.ID_PROCESO&gt;=5 AND  SE.ID_PROCESO&lt;27)&#xA;&#xA;&#xA;&#xA;--select  COUNT(1) from #TMP_GUIAS_PENDIENTE_RECAUDO&#xA;--select  COUNT(1) from ##TMP_GUIAS_PENDIENTE_RECAUDO_FINAL_PBI&#xA;&#xA;----select  * from ##TMP_GUIAS_PENDIENTE_RECAUDO_FINAL_PBI&#xA;&#xA;&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
                  <SQLTask:ParameterBinding
                    SQLTask:ParameterName="0"
                    SQLTask:DtsVariableName="User::STR_FechaIni_REPOBLAR"
                    SQLTask:ParameterDirection="Input"
                    SQLTask:DataType="129"
                    SQLTask:ParameterSize="-1" />
                  <SQLTask:ParameterBinding
                    SQLTask:ParameterName="1"
                    SQLTask:DtsVariableName="User::STR_FechaFin"
                    SQLTask:ParameterDirection="Input"
                    SQLTask:DataType="129"
                    SQLTask:ParameterSize="-1" />
                </SQLTask:SqlTaskData>
              </DTS:ObjectData>
            </DTS:Executable>
          </DTS:Executables>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Tareas Backap\bk20260409 Prepatacion data Recudo LPC COD"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:Disabled="True"
          DTS:DTSID="{832fe735-dc2c-444b-8985-8ebdd9893691}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="bk20260409 Prepatacion data Recudo LPC COD"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="3">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{20AF370D-4C8E-4E05-91E7-8F81200FAADC}"
              SQLTask:SqlStatementSource="&#xA;IF OBJECT_ID('tempdb..#COD_PENDIENTE_POR_RECAUDO') IS NOT NULL &#xA;    DROP TABLE #COD_PENDIENTE_POR_RECAUDO&#xA;&#xA;IF OBJECT_ID('tempdb..#TMP_GUIAS_PENDIENTE_RECAUDO') IS NOT NULL &#xA;    DROP TABLE #TMP_GUIAS_PENDIENTE_RECAUDO&#xA;&#xA;CREATE TABLE #TMP_GUIAS_PENDIENTE_RECAUDO(&#xA; NUMERO_GUIA numeric(20, 0) NOT NULL,&#xA; ID_ESTADOENVIO smallint DEFAULT 0,&#xA; NOMBRE_ESTADOENVIO varchar(40) DEFAULT '',&#xA; FORMA_PAGO varchar(40) DEFAULT '',&#xA; VALOR_A_RECAUDAR numeric(12, 2) NULL,&#xA; ID_REMITE [varchar](40) DEFAULT '',&#xA; NOMBRE_REMITE_GUIA  [varchar](200) DEFAULT '',&#xA; -- ID_CIUDAD INT DEFAULT 0,&#xA; -- [NOMBRE_CIUDAD] [varchar](50) DEFAULT '',&#xA; FECHA_ENVIO datetime NULL,&#xA; [VALOR_RECAUDADO] [numeric](11, 2) DEFAULT 0,&#xA; FECHA_RECAUDO datetime NULL,&#xA; NUMERO_ORDEN_SERVICIO varchar(20) DEFAULT '',&#xA; FECHA_RECAUDO_EFECTY datetime NULL,&#xA; ESTADO_ENTREGA varchar(70) DEFAULT 'A TIEMPO',--A TIEMPO O VENCIDO&#xA; --NOMBRE_RESPONSABLE_ULT_MOV VARCHAR(100) DEFAULT '',&#xA; ID_PROCESO_ULT_MOV int DEFAULT 0,&#xA; NOMBRE_PROCESO_ULT_MOV varchar(70) DEFAULT '',&#xA; ID_CONCEPTO_ULT_MOV int DEFAULT 0,&#xA; NOMBRE_CONCEPTO_ULT_MOV varchar(70) DEFAULT '',&#xA; NUMERO_MOVIMI_ULT_MOV char(30) DEFAULT '',&#xA; CONSECUT_MOVIMI_ULT_MOV numeric(7, 0) DEFAULT 0,&#xA; FECHA_HORA_MOVIMI_ULT_MOV datetime NULL,&#xA; ID_PAIS_ZONA_URBA_ULT_MOV SMALLINT NULL,&#xA; ID_CIUDAD_ZONA_URBA_ULT_MOV INT NULL,&#xA; ID_TIPO_ZONA_URBA_ULT_MOV SMALLINT NULL,&#xA; ID_ZONA_URBA_ULT_MOV SMALLINT NULL,&#xA; NOMBRE_CDS_ULT_MOV varchar(100) DEFAULT '',&#xA; TIPO_CANAL_ULT_MOV varchar(40) DEFAULT '',&#xA; ID_CONDUCTOR_ULT_MOV varchar(40) DEFAULT '',&#xA; CONDUCTOR_ULT_MOV  varchar(200) DEFAULT '',&#xA; ID_AUXILIAR_ULT_MOV varchar(40) DEFAULT '',&#xA; AUXILIAR_ULT_MOV varchar(200) DEFAULT '',&#xA; ID_CLIENTE [char](20) NOT NULL,&#xA; NOMBRE_TIPO_CANAL varchar(100) DEFAULT '',&#xA; NOMBRE_CLASE_TIPO_CANAL varchar(100) DEFAULT '',&#xA; [G_ID_CIUDAD_ORIGEN] [int] NULL,&#xA; [G_ID_CIUDAD_DESTINO] [int] NULL&#xA;) ON [PRIMARY]&#xA;CREATE NONCLUSTERED INDEX [IX_NUMERO_GUIA] ON #TMP_GUIAS_PENDIENTE_RECAUDO ([NUMERO_GUIA] ASC)&#xA;CREATE NONCLUSTERED INDEX [IX_ZONA] ON #TMP_GUIAS_PENDIENTE_RECAUDO (ID_PAIS_ZONA_URBA_ULT_MOV,ID_CIUDAD_ZONA_URBA_ULT_MOV, ID_TIPO_ZONA_URBA_ULT_MOV,ID_ZONA_URBA_ULT_MOV ASC)&#xA;CREATE NONCLUSTERED INDEX [IX_MANIFIESTO] ON #TMP_GUIAS_PENDIENTE_RECAUDO (ID_PROCESO_ULT_MOV,NUMERO_MOVIMI_ULT_MOV,CONSECUT_MOVIMI_ULT_MOV ASC)&#xA;&#xA;&#xA;IF OBJECT_ID('tempdb..#TMP_CIUDADES_ANEXAS') IS NOT NULL &#xA;    DROP TABLE #TMP_CIUDADES_ANEXAS&#xA;&#xA;---CIUDADES ANEXAS&#xA;SELECT CAD.* &#xA;INTO #TMP_CIUDADES_ANEXAS FROM PARAMETROS.DBO.CIUDADES_ANEXAS CAD (NOLOCK) &#xA;WHERE CAD.ID_PAIS=1 AND CAD.RECOLECCION=1&#xA;&#xA;INSERT INTO #TMP_CIUDADES_ANEXAS&#xA;SELECT CAD.* FROM PARAMETROS.DBO.CIUDADES_ANEXAS CAD (NOLOCK) &#xA;LEFT JOIN #TMP_CIUDADES_ANEXAS TCAD ON TCAD.ID_CIUDAD_ANEXA=CAD.ID_CIUDAD_ANEXA&#xA;WHERE CAD.ID_PAIS=1 AND CAD.RECOLECCION=0 AND TCAD.ID_CIUDAD_ANEXA IS NULL&#xA;&#xA;DELETE T FROM (SELECT *, &#xA;    DupRank = ROW_NUMBER() OVER (PARTITION BY ID_CIUDAD_ANEXA ORDER BY FECHA_CREACION DESC) &#xA;     FROM #TMP_CIUDADES_ANEXAS) AS T&#xA;WHERE DupRank &gt; 1&#xA;&#xA;&#xA;&#xA;SELECT CPR.*,G.ID_CLIENTE,G.ID_REMITE,G.NOMBRE_REMITE_GUIA,G.ID_PRODUCTO AS ID_PRODUCTO_GUIA,G.ID_ESTADOENVIO,G.ID_ESTADOGUIA,ISNULL(G.VALOR_SEG_MAN_GUIAS,0)+ISNULL(G.VALOR_FLETES_GUIAS,0) AS VALOR_ENVIO_GUIA,ISNULL(GIA.VALOR_RECAUDAR_PRODUCTO,0) AS VALOR_RECAUDAR_PRODUCTO_GUIA&#xA;,CAST('' AS nvarchar(50)) AS NOMBRE_ESTADOENVIO,G.FECHA_ENVIO&#xA;,TCAN.NOMBRE_TIPO_CANAL&#xA;,CTCAN.NOMBRE_CLASE_TIPO_CANAL&#xA;,G.[ID_CIUDAD_ORIGEN]   AS G_ID_CIUDAD_ORIGEN&#xA;,G.[ID_CIUDAD_DESTINO]   AS G_ID_CIUDAD_DESTINO&#xA;INTO #COD_PENDIENTE_POR_RECAUDO&#xA;FROM [Mece_Logistico].[dbo].[COD_PENDIENTE_POR_RECAUDO] CPR (NOLOCK)&#xA;INNER JOIN [Mece_Logistico].[dbo].[GUIAS] G (nolock) ON G.NUMERO_GUIA=CPR.NUMERO_GUIA&#xA;LEFT JOIN [Mece_Logistico].[dbo].[GUIAS_INF_ADICIONAL] GIA (nolock) ON GIA.NUMERO_GUIA=CPR.NUMERO_GUIA&#xA;LEFT JOIN [tmp_borrar_local].dbo.LPC_GUIAS_SOLUCIONADAS LGS (NOLOCK) ON LGS.NUMERO_GUIA=CPR.NUMERO_GUIA&#xA;LEFT JOIN [Mece_Logistico].[dbo].[CANALES] CAN (NOLOCK) ON CAN.id_pais=G.ID_1 and CAN.id_ciudad=G.ID_2 and CAN.[ID_DIVISION]=G.ID_CANAL&#xA;LEFT JOIN [Mece_Logistico].[dbo].[TIPOS_CANAL] TCAN (NOLOCK) ON TCAN.ID_TIPO_CANAL=CAN.ID_TIPO_CANAL AND TCAN.ID_EST_TIPO_CANAL=1&#xA;LEFT JOIN PARAMETROS.[dbo].[CLASE_TIPO_CANAL] CTCAN (NOLOCK) ON CTCAN.ID_CLASE_TIPO_CANAL=TCAN.CLASE_TIPO_CANAL&#xA;WHERE LGS.NUMERO_GUIA IS NULL AND&#xA;ISNULL(CPR.ESTADO_COD,1)=1-- RECAUDO ESTA ACTIVO&#xA;AND ISNULL(CPR.ESTA_RECAUDADO,0)=0 -- NO ESTA RECAUDADO&#xA;--AND G.ID_ESTADOGUIA!=4-- NO ESTA ANULADA&#xA;AND ISNULL(CPR.NUMERO_ORDEN_SERVICIO,'')='' -- NO TIENE ORDEN DE RECAUDO DE EFECTY&#xA;AND ISNULL(CPR.ESTA_ANULADO,0)=0 -- NO DEBE ESTAR ANULADA&#xA;AND G.ID_DIVISION_PROV IS NULL&#xA;--AND CPR.FECHA_CREACION &gt;= @FECHA_INI &#xA;--AND CPR.FECHA_CREACION &lt; @FECHA_FIN&#xA;&#xA;AND CPR.FECHA_CREACION BETWEEN convert(datetime,?) AND convert(datetime,?)&#xA;/*&#xA;AND CPR.FECHA_CREACION BETWEEN convert(datetime,'20251201') &#xA;       AND convert(datetime,'20260201')&#xA;*/&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;/*&#xA;select G.NUMERO_GUIA&#xA;,TCAN.NOMBRE_TIPO_CANAL&#xA;,CTCAN.NOMBRE_CLASE_TIPO_CANAL&#xA;from Mece_Logistico.dbo.guias G (nolock)&#xA;left JOIN [Mece_Logistico].[dbo].[CANALES] CAN (NOLOCK) ON CAN.id_pais=G.ID_1 and CAN.id_ciudad=G.ID_2 and CAN.[ID_DIVISION]=G.ID_CANAL&#xA;left JOIN [Mece_Logistico].[dbo].[TIPOS_CANAL] TCAN (NOLOCK) ON TCAN.ID_TIPO_CANAL=CAN.ID_TIPO_CANAL AND TCAN.ID_EST_TIPO_CANAL=1&#xA;left JOIN PARAMETROS.[dbo].[CLASE_TIPO_CANAL] CTCAN (NOLOCK) ON CTCAN.ID_CLASE_TIPO_CANAL=TCAN.CLASE_TIPO_CANAL&#xA;where G.ID_CANAL IS NOT NULL&#xA;AND FECHA_ENVIO&gt;='20260120 00:00:00'&#xA;*/&#xA;&#xA;CREATE NONCLUSTERED INDEX [IX_NUMERO_GUIA] ON #COD_PENDIENTE_POR_RECAUDO ([NUMERO_GUIA] ASC)&#xA;&#xA;&#xA;--Se quitan envios siniestrados&#xA;DELETE GPR FROM #COD_PENDIENTE_POR_RECAUDO GPR&#xA;WHERE ID_ESTADOENVIO in(5,4)&#xA;&#xA;--Quita las guias son del canal retail y no son COD y no contraentrega ecommerce&#xA;DELETE GPR FROM #COD_PENDIENTE_POR_RECAUDO GPR&#xA;WHERE ID_FORMA_PAGO=1 AND ID_PRODUCTO!=86&#xA;&#xA;&#xA;--SELECT * FROM #COD_PENDIENTE_POR_RECAUDO CPR (NOLOCK)&#xA;--WHERE --NUMERO_GUIA=2143658629&#xA;--ID_PRODUCTO=86&#xA;--INSERT INTO #TMP_GUIAS_PENDIENTE_RECAUDO&#xA;&#xA;UPDATE CPR SET CPR.NOMBRE_ESTADOENVIO=E.NOMBRE_ESTADOENVIO&#xA;FROM #COD_PENDIENTE_POR_RECAUDO CPR&#xA;INNER JOIN PARAMETROS.DBO.ESTADOSENVIO E (NOLOCK)ON E.ID_ESTADOENVIO=CPR.ID_ESTADOENVIO&#xA;&#xA;--TRUNCATE TABLE #TMP_GUIAS_PENDIENTE_RECAUDO&#xA;INSERT INTO #TMP_GUIAS_PENDIENTE_RECAUDO(&#xA;NUMERO_GUIA,&#xA;ID_ESTADOENVIO,&#xA;NOMBRE_ESTADOENVIO,&#xA;FORMA_PAGO,&#xA;VALOR_A_RECAUDAR,&#xA;ID_REMITE,&#xA;NOMBRE_REMITE_GUIA,&#xA;FECHA_ENVIO,&#xA;VALOR_RECAUDADO,&#xA;FECHA_RECAUDO,&#xA;NUMERO_ORDEN_SERVICIO,&#xA;FECHA_RECAUDO_EFECTY,&#xA;ID_CLIENTE,&#xA;NOMBRE_TIPO_CANAL,&#xA;NOMBRE_CLASE_TIPO_CANAL,&#xA;G_ID_CIUDAD_ORIGEN,&#xA;G_ID_CIUDAD_DESTINO&#xA;)&#xA;SELECT CPR.NUMERO_GUIA,CPR.ID_ESTADOENVIO,CPR.NOMBRE_ESTADOENVIO,&#xA;CASE WHEN CPR.ID_FORMA_PAGO=4 AND CPR.ID_CLIENTE IS NULL THEN 'C.O.D.' WHEN ISNULL(CPR.ID_PRODUCTO,CPR.ID_PRODUCTO_GUIA)=86 THEN 'CONTRAENTREGA ECOMMERCE' WHEN (CPR.ID_FORMA_PAGO=2 OR CPR.ID_CLIENTE IS NOT NULL) THEN 'LPC' ELSE '' END AS FORMA_PAGO,&#xA;CASE WHEN ISNULL(CPR.VALOR_TOTAL,0)!=0 THEN CPR.VALOR_TOTAL&#xA;WHEN CPR.ID_FORMA_PAGO=4 AND VALOR_FLETE IS NOT NULL THEN ISNULL(CPR.VALOR_FLETE,0) + ISNULL(CPR.VALOR_OTROS,0)&#xA;WHEN CPR.ID_FORMA_PAGO=4 AND VALOR_FLETE IS NULL THEN ISNULL(CPR.VALOR_ENVIO_GUIA,0)&#xA;WHEN ISNULL(CPR.ID_PRODUCTO,CPR.ID_PRODUCTO_GUIA)=86 THEN ISNULL(CPR.VALOR_DECLARADO,CPR.VALOR_PRODUCTO)&#xA;WHEN (CPR.ID_FORMA_PAGO=2 OR CPR.ID_CLIENTE IS NOT NULL) THEN ISNULL(CPR.VALOR_DECLARADO,CPR.VALOR_PRODUCTO) ELSE 0 END AS VALOR_A_RECAUDAR&#xA;,CPR.ID_REMITE&#xA;,CPR.NOMBRE_REMITE_GUIA&#xA;,CPR.FECHA_ENVIO&#xA;,ISNULL(CPR.VALOR_RECAUDADO,0)&#xA;,CPR.FECHA_RECAUDO&#xA;,ISNULL(CPR.NUMERO_ORDEN_SERVICIO,0)&#xA;,CPR.FECHA_RECAUDO_EFECTY&#xA;,isnull(CPR.ID_CLIENTE,'0') ID_CLIENTE&#xA;,CPR.NOMBRE_TIPO_CANAL&#xA;,CPR.NOMBRE_CLASE_TIPO_CANAL&#xA;,G_ID_CIUDAD_ORIGEN&#xA;,G_ID_CIUDAD_DESTINO&#xA;--,CPR.VALOR_TOTAL&#xA;--INTO #TMP_GUIAS_PENDIENTE_RECAUDO_1&#xA;FROM #COD_PENDIENTE_POR_RECAUDO CPR (NOLOCK)&#xA;WHERE LEN(CPR.NUMERO_GUIA)&gt;7&#xA;--INNER JOIN [Mece_Logistico].[dbo].[GUIAS] G (nolock) ON G.NUMERO_GUIA=CPR.NUMERO_GUIA&#xA;&#xA;--CREATE NONCLUSTERED INDEX [IX_NUMERO_GUIA] ON #TMP_GUIAS_PENDIENTE_RECAUDO_1 ([NUMERO_GUIA] ASC)&#xA;&#xA;--select GPR.* from #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA;&#xA;&#xA;UPDATE GPR SET&#xA; --GPR.NOMBRE_RESPONSABLE_ULT_MOV='SERVIENTREGA S.A.'&#xA; GPR.ID_PROCESO_ULT_MOV=SE.ID_PROCESO&#xA; ,GPR.NOMBRE_PROCESO_ULT_MOV=PRO.NOMBRE_PROCESO_LOG&#xA; ,GPR.ID_CONCEPTO_ULT_MOV=ISNULL(SE.ID_CONCEPTO,0)&#xA; ,GPR.NOMBRE_CONCEPTO_ULT_MOV=ISNULL(ICON.NOMBRE_CONCEPTO,'')&#xA; ,GPR.NUMERO_MOVIMI_ULT_MOV=SE.NUMERO_MOVIMI&#xA; ,GPR.CONSECUT_MOVIMI_ULT_MOV=SE.CONSECUT_MOVIMI&#xA; ,GPR.FECHA_HORA_MOVIMI_ULT_MOV=SE.FECHA_HORA_MOVIMIENTO&#xA; --,GPR.ID_CONDUCTOR_ULT_MOV=DOC.ID_COURIER_CONDUCTOR&#xA; --,GPR.ID_AUXILIAR_ULT_MOV=DOC.ID_AUXILIAR1_VEHICULO&#xA; --,GPR.ID_PAIS_ZONA_URBA_ULT_MOV=DOC.ID_PAIS_ZONA_URBA  &#xA; --,GPR.ID_CIUDAD_ZONA_URBA_ULT_MOV=DOC.ID_CIUDAD_ZONA_URBA &#xA; --,GPR.ID_TIPO_ZONA_URBA_ULT_MOV=DOC.ID_TIPO_ZONA_URBA&#xA; --,GPR.ID_ZONA_URBA_ULT_MOV=DOC.ID_ZONA_URBA&#xA; FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; INNER JOIN MECE_LOGISTICO.dbo.SEGUIMIENTO_ENVIO SE WITH(NOLOCK) on se.NUMERO_GUIA=GPR.NUMERO_GUIA&#xA; --INNER JOIN MECE_LOGISTICO.dbo.DOCUMENTOS DOC (NOLOCK) ON&#xA; --DOC.ID_PROCESO=GPR.[ID_PROCESO_ULT_MOV] AND DOC.NUMERO_MOVIMI=GPR.[NUMERO_MOVIMI_ULT_MOV] AND DOC.CONSECUT_MOVIMI=GPR.[CONSECUT_MOVIMI_ULT_MOV]&#xA; INNER JOIN PARAMETROS.DBO.PROCESOS PRO (NOLOCK) ON PRO.ID_PROCESO=SE.ID_PROCESO&#xA; LEFT JOIN PARAMETROS.DBO.ITEM_CONCEPTO ICON (NOLOCK) ON ICON.ID_PAIS=1 AND ICON.ID_PROCESO=SE.ID_PROCESO AND ICON.ID_CONCEPTO=SE.ID_CONCEPTO&#xA; WHERE se.FECHA_HORA_MOVIMIENTO= (select MAX(se1.FECHA_HORA_MOVIMIENTO) from MECE_LOGISTICO.dbo.SEGUIMIENTO_ENVIO SE1 WITH(NOLOCK)&#xA;          where SE1.numero_guia=GPR.NUMERO_GUIA)&#xA; &#xA; UPDATE GPR SET&#xA; GPR.ID_CONDUCTOR_ULT_MOV=DOC.ID_COURIER_CONDUCTOR&#xA; ,GPR.ID_AUXILIAR_ULT_MOV=DOC.ID_AUXILIAR1_VEHICULO&#xA; ,GPR.ID_PAIS_ZONA_URBA_ULT_MOV=DOC.ID_PAIS_ZONA_URBA  &#xA; ,GPR.ID_CIUDAD_ZONA_URBA_ULT_MOV=DOC.ID_CIUDAD_ZONA_URBA &#xA; ,GPR.ID_TIPO_ZONA_URBA_ULT_MOV=DOC.ID_TIPO_ZONA_URBA&#xA; ,GPR.ID_ZONA_URBA_ULT_MOV=DOC.ID_ZONA_URBA&#xA; FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; INNER JOIN MECE_LOGISTICO.DBO.DOCUMENTOS DOC (NOLOCK) ON&#xA; DOC.ID_PROCESO=GPR.[ID_PROCESO_ULT_MOV] AND DOC.NUMERO_MOVIMI=GPR.[NUMERO_MOVIMI_ULT_MOV] AND DOC.CONSECUT_MOVIMI=GPR.[CONSECUT_MOVIMI_ULT_MOV]&#xA;&#xA; --SELECT GPR.ID_CONDUCTOR_ULT_MOV&#xA; &#xA; UPDATE GPR SET&#xA; GPR.ID_CONDUCTOR_ULT_MOV=ISNULL(RTRIM(LTRIM(EC.ID_EMPLEADO)),'')&#xA; ,GPR.CONDUCTOR_ULT_MOV =ISNULL(RTRIM(LTRIM(EC.NOMBRE_EMPLEADO)) +' '+ RTRIM(LTRIM(EC.APELLIDO_EMPLEADO)),'') &#xA; ,GPR.ID_AUXILIAR_ULT_MOV=ISNULL(RTRIM(LTRIM(EA.ID_EMPLEADO)),'')&#xA; ,GPR.AUXILIAR_ULT_MOV=ISNULL(RTRIM(LTRIM(EA.NOMBRE_EMPLEADO)) +' '+ RTRIM(LTRIM(EA.APELLIDO_EMPLEADO)),'') &#xA; FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; LEFT JOIN PARAMETROS.DBO.EMPLEADOS EC (NOLOCK) ON EC.ID_EMPLEADO=GPR.ID_CONDUCTOR_ULT_MOV&#xA; LEFT JOIN PARAMETROS.DBO.EMPLEADOS EA (NOLOCK) ON EA.ID_EMPLEADO=GPR.ID_AUXILIAR_ULT_MOV&#xA;&#xA;&#xA; --SELECT GPR.NUMERO_GUIA,ISNULL(DIV.NOMBRE_DIVISION,'') AS NOMBRE_CDS, ISNULL(CTCAN.[NOMBRE_CLASE_TIPO_CANAL],'') as TIPO_CANAL&#xA;UPDATE GPR SET NOMBRE_CDS_ULT_MOV=ISNULL(DIV.NOMBRE_DIVISION,''),&#xA; TIPO_CANAL_ULT_MOV=ISNULL(CTCAN.[NOMBRE_CLASE_TIPO_CANAL],'')&#xA; FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; --INNER JOIN MECE_LOGISTICO.DBO.DOCUMENTOS DOC (NOLOCK) ON&#xA; --DOC.ID_PROCESO=GPR.[ID_PROCESO_ULT_MOV] AND DOC.NUMERO_MOVIMI=GPR.[NUMERO_MOVIMI_ULT_MOV] AND DOC.CONSECUT_MOVIMI=GPR.[CONSECUT_MOVIMI_ULT_MOV]&#xA; INNER JOIN PARAMETROS.DBO.ZONASURBANAS Z (NOLOCK) &#xA; ON Z.ID_PAIS = GPR.ID_PAIS_ZONA_URBA_ULT_MOV AND Z.ID_CIUDAD = GPR.ID_CIUDAD_ZONA_URBA_ULT_MOV &#xA;  AND Z.ID_TIPO_ZONA_URBA = GPR.ID_TIPO_ZONA_URBA_ULT_MOV AND Z.ID_ZONA_URBA = GPR.ID_ZONA_URBA_ULT_MOV --AND Z.CATEGORIA_ZONA_URBA = 8 --CLICOH&#xA; INNER JOIN PARAMETROS.DBO.DIVISIONES DIV (NOLOCK) ON DIV.ID_PAIS = Z.ID_PAIS_CANAL AND DIV.ID_CIUDAD = Z.ID_CIUDAD_CANAL AND DIV.ID_DIVISION = Z.ID_CANAL&#xA; INNER JOIN [Mece_Logistico].[dbo].[CANALES] CAN (NOLOCK) ON CAN.id_pais=DIV.ID_PAIS and CAN.id_ciudad=DIV.ID_CIUDAD and CAN.[ID_DIVISION]=DIV.ID_DIVISION&#xA; INNER JOIN [Mece_Logistico].[dbo].[TIPOS_CANAL] TCAN (NOLOCK) ON TCAN.ID_TIPO_CANAL=CAN.ID_TIPO_CANAL AND TCAN.ID_EST_TIPO_CANAL=1&#xA; INNER JOIN PARAMETROS.[dbo].[CLASE_TIPO_CANAL] CTCAN (NOLOCK) ON CTCAN.ID_CLASE_TIPO_CANAL=TCAN.CLASE_TIPO_CANAL&#xA;&#xA;&#xA; --UPDATE GPR SET ESTADO_ENTREGA='VENCIDO'&#xA; --SELECT * FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; UPDATE GPR SET ESTADO_ENTREGA='VENCIDO'&#xA; FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; WHERE GPR.ID_PROCESO_ULT_MOV=9 AND ID_CONCEPTO_ULT_MOV IN(9,7,2,4)--9 ENTREGAS OFIC  C.O.D. Y/O LPC EMPRESARIO --7 EMPRESARIO SATELITE ENTREGA EN OFICINA&#xA; --2 RECLAMO OFICINA Y 4 C.O.D RECLAMO OFICINA&#xA; AND DATEDIFF(DAY, FECHA_HORA_MOVIMI_ULT_MOV,GETDATE())&gt;8 -- MAS DE 8 DIAS&#xA; &#xA; UPDATE GPR SET ESTADO_ENTREGA='VENCIDO'&#xA; FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; WHERE GPR.ID_PROCESO_ULT_MOV=31 --ENVIO PARA ENTREGA EN OFICINA&#xA; AND DATEDIFF(DAY, FECHA_HORA_MOVIMI_ULT_MOV,GETDATE())&gt;8 -- MAS DE 8 DIAS&#xA;&#xA; UPDATE GPR SET ESTADO_ENTREGA='VENCIDO'&#xA; FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; WHERE GPR.ID_PROCESO_ULT_MOV=9 AND ID_CONCEPTO_ULT_MOV IN(10,8) --10 ENTR A DOMICI  LPC / COD EMPRESARIOS SAT --8 EMPRESARIO SATELITE ENTREGA EN DOMICILIO&#xA; AND DATEDIFF(DAY, FECHA_HORA_MOVIMI_ULT_MOV,GETDATE())&gt;3-- MAS DE 3 DIAS&#xA; &#xA; UPDATE GPR SET ESTADO_ENTREGA='VENCIDO'&#xA; FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; WHERE GPR.ID_PROCESO_ULT_MOV=32 --ENVIO PARA ENTREGA A DOMICILIO&#xA; AND DATEDIFF(DAY, FECHA_HORA_MOVIMI_ULT_MOV,GETDATE())&gt;3-- MAS DE 3 DIAS&#xA;&#xA; UPDATE GPR SET ESTADO_ENTREGA='VENCIDO'&#xA; FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; WHERE GPR.ID_PROCESO_ULT_MOV=9 AND ID_CONCEPTO_ULT_MOV IN(1,3) --SALIDA A ZONA Y C.O.D EN DISTRIBUCION&#xA; AND DATEDIFF(DAY, FECHA_HORA_MOVIMI_ULT_MOV,GETDATE())&gt;1 --MAS DE UN DIA&#xA;&#xA;&#xA;&#xA;DROP TABLE IF EXISTS #TMP_GUIAS_PENDIENTE_RECAUDO_SZU&#xA; SELECT &#xA; TMP.NUMERO_GUIA&#xA; ,(SE.CONSECUT_MOVIMI)   AS CONSECUT_MOVIMI_SZU&#xA; ,(SE.NUMERO_MOVIMI)    AS NUMERO_MOVIMI_SZU&#xA; ,(SE.FECHA_HORA_MOVIMIENTO)  AS FECHA_HORA_MOVIMI_ULT_MOV_SZU&#xA;INTO #TMP_GUIAS_PENDIENTE_RECAUDO_SZU&#xA;FROM #TMP_GUIAS_PENDIENTE_RECAUDO TMP&#xA;INNER JOIN Mece_Logistico..SEGUIMIENTO_ENVIO SE&#xA;ON SE.NUMERO_GUIA=TMP.NUMERO_GUIA&#xA;WHERE SE.ID_PROCESO=9&#xA;---GROUP BY  TMP.NUMERO_GUIA&#xA;&#xA;;WITH CTE AS(&#xA;SELECT &#xA;ROWID = ROW_NUMBER() OVER(PARTITION BY NUMERO_GUIA ORDER BY FECHA_HORA_MOVIMI_ULT_MOV_SZU DESC)&#xA;,NUMERO_GUIA,FECHA_HORA_MOVIMI_ULT_MOV_SZU&#xA;FROM #TMP_GUIAS_PENDIENTE_RECAUDO_SZU&#xA;)&#xA;DELETE CTE WHERE ROWID&gt;1&#xA;&#xA;&#xA;&#xA;--SELECT * FROM #TMP_GUIAS_PENDIENTE_RECAUDO TMP&#xA;&#xA;&#xA;&#xA;DROP TABLE IF EXISTS #TMP_GUIAS_CON_TAREAS &#xA; SELECT &#xA; TMP.NUMERO_GUIA,&#xA; COUNT(TAR.NUMERO_DOCPROBLEMA) AS NUMERO_TAREAS&#xA;INTO #TMP_GUIAS_CON_TAREAS&#xA;FROM #TMP_GUIAS_PENDIENTE_RECAUDO TMP&#xA;INNER JOIN Mece_Logistico..TAREAS TAR WITH(NOLOCK)&#xA;ON TAR.NUMERO_DOCPROBLEMA=CONVERT(CHAR(20),TMP.NUMERO_GUIA)&#xA;GROUP BY TMP.NUMERO_GUIA&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;DROP TABLE IF EXISTS ##TMP_GUIAS_PENDIENTE_RECAUDO_FINAL_PBI;&#xA;SELECT --GPR.*&#xA;GPR.NUMERO_GUIA &#xA;--GPR.ID_ESTADOENVIO &#xA;,GPR.NOMBRE_ESTADOENVIO &#xA;,GPR.FORMA_PAGO &#xA;,GPR.VALOR_A_RECAUDAR &#xA;,GPR.ID_REMITE &#xA;,GPR.NOMBRE_REMITE_GUIA &#xA;,GPR.FECHA_ENVIO&#xA;,GPR.VALOR_RECAUDADO&#xA;,GPR.FECHA_RECAUDO&#xA;,GPR.NUMERO_ORDEN_SERVICIO&#xA;,GPR.FECHA_RECAUDO_EFECTY&#xA;,GPR.ESTADO_ENTREGA&#xA;--,GPR.NOMBRE_RESPONSABLE_ULT_MOV &#xA;--ID_PROCESO_ULT_MOV &#xA;--NOMBRE_PROCESO_ULT_MOV &#xA;--NUMERO_MOVIMI_ULT_MOV &#xA;--CONSECUT_MOVIMI_ULT_MOV &#xA;--FECHA_HORA_MOVIMI_ULT_MOV&#xA;&#xA;--,ISNULL(ISNULL(CLO.CENTRO_LOGISTICO,CLD.CENTRO_LOGISTICO),'')  AS CPL_ORIGEN_ULT_MOV&#xA;--,ISNULL(ISNULL(RO.NOMBRE_REGIONAL,RD.NOMBRE_REGIONAL),'')  AS REGIONAL_ORIGEN_ULT_MOV&#xA;--,ISNULL(ISNULL(CO.NOMBRE_CIUDAD,CD.NOMBRE_CIUDAD),'')  AS CIUDAD_ORIGEN_ULT_MOV&#xA;--,ISNULL(ISNULL(CLD.CENTRO_LOGISTICO,CLO.CENTRO_LOGISTICO),'') AS CPL_DESTINO_ULT_MOV&#xA;--,ISNULL(ISNULL(RD.NOMBRE_REGIONAL,RO.NOMBRE_REGIONAL),'') AS REGIONAL_DESTINO_ULT_MOV&#xA;--,ISNULL(ISNULL(CD.NOMBRE_CIUDAD,CO.NOMBRE_CIUDAD),'') AS CIUDAD_DESTINO_MOV&#xA;,CASE WHEN ID_PROCESO!=14 THEN &#xA;ISNULL(ISNULL(CLO.CENTRO_LOGISTICO,CLD.CENTRO_LOGISTICO),'')  ELSE ISNULL(ISNULL(CLD.CENTRO_LOGISTICO,CLO.CENTRO_LOGISTICO),'') END AS CPL_ULT_MOV&#xA;,CASE WHEN ID_PROCESO!=14 THEN &#xA;ISNULL(ISNULL(RO.NOMBRE_REGIONAL,RD.NOMBRE_REGIONAL),'') ELSE ISNULL(ISNULL(RD.NOMBRE_REGIONAL,RO.NOMBRE_REGIONAL),'') END  AS REGIONAL_ULT_MOV&#xA;,CASE WHEN ID_PROCESO!=14 THEN &#xA;ISNULL(ISNULL(CO.NOMBRE_CIUDAD,CD.NOMBRE_CIUDAD),'')  ELSE ISNULL(ISNULL(CD.NOMBRE_CIUDAD,CO.NOMBRE_CIUDAD),'') END  AS CIUDAD_ULT_MOV&#xA;,ISNULL(CASE &#xA; WHEN ISNULL(DOC.ID_CIUDAD_ZONA_URBA,0) !=0 THEN&#xA; ROZ.NOMBRE_REGIONAL+' - '+ DCOZ.NOMBRE_DEPARTAMENTO +' - '+ COZ.NOMBRE_CIUDAD &#xA; WHEN  ISNULL(DOC.ID_CIUDAD_DIVISION_ORIGEN,0) !=0 AND DOC.ID_PROCESO!=14 THEN&#xA; ROM.NOMBRE_REGIONAL+' - '+ DCOM.NOMBRE_DEPARTAMENTO +' - '+ COM.NOMBRE_CIUDAD&#xA; ELSE&#xA; ROD.NOMBRE_REGIONAL+' - '+ DCOD.NOMBRE_DEPARTAMENTO +' - '+ COD.NOMBRE_CIUDAD &#xA; END,'') AS REG_DEPART_CIUDAD_ULTIMO_MOV&#xA;&#xA;,ISNULL(DOC.PLACA_VEHICULO_DOCU,'') as PLACA_VEHICULO_ULTIMO_MOV&#xA;,ISNULL(O.[NOMBRE_OPERATIVO],'') AS NOMBRE_OPERATIVO_ULTIMO_MOV&#xA;,ISNULL(Z.NOMBRE_ZONA_URBA,'') AS ZONA_URBANA_ULTIMO_MOV&#xA;,ISNULL(CZ.NOMBRE_CATEGORIA,'') AS CATEGORIA_ZONA_ULTIMO_MOV&#xA;,ISNULL(TZU.NOMBRE_TIPO_ZONA_URBA,'') AS TIPO_ZONA_ULTIMO_MOV&#xA;,ISNULL(GPR.NOMBRE_CDS_ULT_MOV,'') AS NOMBRE_CDS_ULT_MOV&#xA;,ISNULL(TIPO_CANAL_ULT_MOV,'') AS TIPO_CANAL_ULT_MOV&#xA;--,GR.ID_PROCESO &#xA;,ISNULL(GPR.NOMBRE_PROCESO_ULT_MOV,'') AS PROCESO_LOG_ULTIMO_MOV  &#xA;,ISNULL(GPR.NOMBRE_CONCEPTO_ULT_MOV,'') AS CONCEPTO_ULT_MOV&#xA;--,GR.ID_CONCEPTO  &#xA;--,GR.FECHA_HORA_MOVIMIENTO&#xA;,ISNULL(cast(GPR.ID_PROCESO_ULT_MOV as nvarchar) +' - '+ RTRIM(GPR.NOMBRE_PROCESO_ULT_MOV),'') AS NOMBRE_ULTIMO_MOV&#xA;,ISNULL(CASE WHEN DIO.ID_DIVISION IS NOT NULL THEN cast(DIO.ID_DIVISION as nvarchar) +' - '+ RTRIM(DIO.NOMBRE_DIVISION)&#xA;ELSE cast(DID.ID_DIVISION as nvarchar) +' - '+ RTRIM(DID.NOMBRE_DIVISION) END,'') AS BODEGA_ULTIMO_MOV&#xA;,ISNULL(cast(GPR.ID_PROCESO_ULT_MOV as nvarchar) +' - '+ RTRIM(GPR.[NUMERO_MOVIMI_ULT_MOV])+' - '+  cast(GPR.[CONSECUT_MOVIMI_ULT_MOV] as nvarchar),'') as ULTIMO_MOV_LOGISTICO&#xA;,ISNULL(CONVERT(nvarchar(20),GPR.FECHA_HORA_MOVIMI_ULT_MOV,120),'') AS FECHA_ULTIMO_MOV&#xA;,GPR.ID_CONDUCTOR_ULT_MOV&#xA;,GPR.CONDUCTOR_ULT_MOV&#xA;,GPR.ID_AUXILIAR_ULT_MOV&#xA;,GPR.AUXILIAR_ULT_MOV&#xA;,GPR.ID_CLIENTE&#xA;,SZU.CONSECUT_MOVIMI_SZU&#xA;,SZU.NUMERO_MOVIMI_SZU&#xA;,SZU.FECHA_HORA_MOVIMI_ULT_MOV_SZU&#xA;,GPR.NOMBRE_TIPO_CANAL&#xA;,GPR.NOMBRE_CLASE_TIPO_CANAL&#xA;,TAR.NUMERO_TAREAS&#xA;,G_ID_CIUDAD_ORIGEN&#xA;,G_ID_CIUDAD_DESTINO&#xA;--,DOC.*&#xA;INTO ##TMP_GUIAS_PENDIENTE_RECAUDO_FINAL_PBI&#xA;&#xA;FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA;--------------------------- CIUDAD ULTIMO MOV ZONA&#xA;  LEFT JOIN MECE_LOGISTICO.DBO.DOCUMENTOS DOC (NOLOCK) ON&#xA; DOC.ID_PROCESO=GPR.[ID_PROCESO_ULT_MOV] AND DOC.NUMERO_MOVIMI=GPR.[NUMERO_MOVIMI_ULT_MOV] AND DOC.CONSECUT_MOVIMI=GPR.[CONSECUT_MOVIMI_ULT_MOV]&#xA; --AND DOC.ID_DIVISION_DESTINO IN (9311, 9308, 9304, 9313, 9310, 9312, 9711, 9710)&#xA;  LEFT JOIN PARAMETROS.DBO.CIUDADES COZ (NOLOCK) ON  COZ.ID_PAIS=1 AND COZ.ID_CIUDAD=DOC.ID_CIUDAD_ZONA_URBA&#xA;  LEFT JOIN PARAMETROS.DBO.REGIONALES_PAIS ROZ (NOLOCK) ON  ROZ.ID_PAIS=COZ.ID_PAIS AND ROZ.ID_REGIONAL=COZ.ID_REGIONAL&#xA;  LEFT JOIN PARAMETROS.DBO.DEPARTAMENTOS DCOZ (NOLOCK) ON  DCOZ.ID_PAIS=COZ.ID_PAIS AND DCOZ.ID_DEPARTAMENTO=COZ.ID_DEPARTAMENTO&#xA;   LEFT JOIN PARAMETROS.DBO.ZONASURBANAS Z (NOLOCK) &#xA; ON Z.ID_PAIS = DOC.ID_PAIS_ZONA_URBA AND Z.ID_CIUDAD = DOC.ID_CIUDAD_ZONA_URBA AND Z.ID_TIPO_ZONA_URBA = DOC.ID_TIPO_ZONA_URBA AND Z.ID_ZONA_URBA = DOC.ID_ZONA_URBA --AND Z.CATEGORIA_ZONA_URBA = 8 --CLICOH&#xA;  LEFT JOIN [PARAMETROS].[dbo].[CATEGORIAZONASURBANAS] CZ (NOLOCK) ON CZ.Id_Categoria=Z.CATEGORIA_ZONA_URBA&#xA;  LEFT JOIN [PARAMETROS].[dbo].[TIPOSZONASURBANAS] TZU (NOLOCK) ON TZU.ID_TIPO_ZONA_URBA=Z.ID_TIPO_ZONA_URBA&#xA; --------------------------- CIUDAD ULTIMO MOV DOCUMENTO&#xA;  LEFT JOIN PARAMETROS.DBO.CIUDADES COM (NOLOCK) ON  COM.ID_PAIS=1 AND COM.ID_CIUDAD=DOC.ID_CIUDAD_DIVISION_ORIGEN&#xA;  LEFT JOIN PARAMETROS.DBO.REGIONALES_PAIS ROM (NOLOCK) ON  ROM.ID_PAIS=COM.ID_PAIS AND ROM.ID_REGIONAL=COM.ID_REGIONAL&#xA;  LEFT JOIN PARAMETROS.DBO.DEPARTAMENTOS DCOM (NOLOCK) ON  DCOM.ID_PAIS=COM.ID_PAIS AND DCOM.ID_DEPARTAMENTO=COM.ID_DEPARTAMENTO&#xA;  --------------------------- CIUDAD DESTINO ULTIMO MOV DOCUMENTO&#xA;  LEFT JOIN PARAMETROS.DBO.CIUDADES COD(NOLOCK) ON  COD.ID_PAIS=1 AND COD.ID_CIUDAD=DOC.ID_CIUDAD_DESTINO&#xA;  LEFT JOIN PARAMETROS.DBO.REGIONALES_PAIS ROD (NOLOCK) ON  ROD.ID_PAIS=COD.ID_PAIS AND ROD.ID_REGIONAL=COD.ID_REGIONAL&#xA;  LEFT JOIN PARAMETROS.DBO.DEPARTAMENTOS DCOD (NOLOCK) ON  DCOD.ID_PAIS=COD.ID_PAIS AND DCOD.ID_DEPARTAMENTO=COD.ID_DEPARTAMENTO&#xA;  --------------------------- DIVISION ORIGEN ULTIMO MOV DOCUMENTO&#xA;  LEFT JOIN PARAMETROS.DBO.DIVISIONES DIO(NOLOCK) ON DIO.ID_PAIS=DOC.ID_PAIS_DIVISION_ORIGEN&#xA; AND DIO.ID_CIUDAD=DOC.ID_CIUDAD_DIVISION_ORIGEN AND DIO.ID_DIVISION=DOC.ID_DIVISION_ORIGEN&#xA;  --------------------------- DIVISION DESTINO ULTIMO MOV DOCUMENTO&#xA;  LEFT JOIN PARAMETROS.DBO.DIVISIONES DID(NOLOCK) ON DID.ID_PAIS=DOC.ID_PAIS_DESTINO&#xA; AND DID.ID_CIUDAD=DOC.ID_CIUDAD_DESTINO AND DID.ID_DIVISION=DOC.ID_DIVISION_DESTINO&#xA;-------------------------------------------------------------&#xA;  LEFT JOIN [PARAMETROS].[dbo].CIUDADES CO (NOLOCK) ON CO.ID_PAIS=ID_PAIS_DIVISION_ORIGEN AND CO.ID_CIUDAD=DOC.ID_CIUDAD_DIVISION_ORIGEN&#xA;  LEFT JOIN [PARAMETROS].[dbo].REGIONALES_PAIS RO (NOLOCK) ON RO.ID_PAIS=1 AND RO.ID_REGIONAL=CO.[ID_REGIONAL]&#xA;  LEFT JOIN [PARAMETROS].[dbo].CIUDADES CD (NOLOCK) ON CD.ID_PAIS=DOC.ID_PAIS_DESTINO AND CD.ID_CIUDAD=DOC.ID_CIUDAD_DESTINO&#xA;  LEFT JOIN [PARAMETROS].[dbo].REGIONALES_PAIS RD (NOLOCK) ON RD.ID_PAIS=1 AND RD.ID_REGIONAL=CD.[ID_REGIONAL]&#xA;  LEFT JOIN [PARAMETROS].[dbo].[OPERATIVOS] O (NOLOCK) ON O.[ID_PAIS_ORIGEN]=DOC.ID_PAIS_OPERATIVO AND O.[ID_CIUDAD_ORIGEN]=DOC.ID_CIUDAD_OPERATIVO&#xA; AND O.[ID_OPERATIVO]=DOC.ID_OPERATIVO&#xA;  LEFT JOIN #TMP_CIUDADES_ANEXAS CAO (NOLOCK) ON CAO.ID_PAIS=1 AND CAO.[ID_CIUDAD_ANEXA]=CO.ID_CIUDAD --AND CAO.RECOLECCION=1&#xA;  LEFT JOIN PARAMETROS.DBO.CENTROS_LOGISTICOS CLO (NOLOCK) ON CLO.ID_PAIS=1 AND CLO.ID_CIUDAD=CAO.ID_CIUDAD AND CLO.ID_CENTRO_LOGISTICO=1 AND CLO.ID_ESTADO=1&#xA;  LEFT JOIN #TMP_CIUDADES_ANEXAS CAD (NOLOCK) ON CAD.ID_PAIS=1 AND CAD.[ID_CIUDAD_ANEXA]=CD.ID_CIUDAD --AND CAD.RECOLECCION=1&#xA;  LEFT JOIN PARAMETROS.DBO.CENTROS_LOGISTICOS CLD (NOLOCK) ON CLD.ID_PAIS=1 AND CLD.ID_CIUDAD=CAD.ID_CIUDAD AND CLD.ID_CENTRO_LOGISTICO=1 AND CLD.ID_ESTADO=1&#xA;LEFT JOIN #TMP_GUIAS_PENDIENTE_RECAUDO_SZU SZU ON SZU.NUMERO_GUIA=GPR.NUMERO_GUIA&#xA;LEFT JOIN #TMP_GUIAS_CON_TAREAS TAR ON TAR.NUMERO_GUIA=GPR.NUMERO_GUIA&#xA;--WHERE &#xA;--NUMERO_GUIA=2273736466&#xA;--ID_PROCESO=32&#xA;&#xA;--DELETE CPR FROM #TMP_GUIAS_PENDIENTE_RECAUDO CPR &#xA;--WHERE&#xA;--NOT EXISTS (SELECT TOP 1 SE.NUMERO_GUIA FROM Mece_Logistico.DBO.SEGUIMIENTO_ENVIO SE (NOLOCK) WHERE SE.NUMERO_GUIA=CPR.NUMERO_GUIA AND SE.ID_PROCESO&gt;=5 AND  SE.ID_PROCESO&lt;27)&#xA;&#xA;&#xA;&#xA;--select  COUNT(1) from #TMP_GUIAS_PENDIENTE_RECAUDO&#xA;--select  COUNT(1) from ##TMP_GUIAS_PENDIENTE_RECAUDO_FINAL_PBI&#xA;&#xA;----select  * from ##TMP_GUIAS_PENDIENTE_RECAUDO_FINAL_PBI&#xA;&#xA;&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="0"
                SQLTask:DtsVariableName="User::STR_FechaIni"
                SQLTask:ParameterDirection="Input"
                SQLTask:DataType="129"
                SQLTask:ParameterSize="-1" />
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="1"
                SQLTask:DtsVariableName="User::STR_FechaFin"
                SQLTask:ParameterDirection="Input"
                SQLTask:DataType="129"
                SQLTask:ParameterSize="-1" />
            </SQLTask:SqlTaskData>
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Tareas Backap\bk20260409 Prepatacion data Recudo LPC COD REPOBLAR"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:Disabled="True"
          DTS:DTSID="{9e7ffe08-00a7-4fff-a24d-b50fed1416a9}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="bk20260409 Prepatacion data Recudo LPC COD REPOBLAR"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="4">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{20AF370D-4C8E-4E05-91E7-8F81200FAADC}"
              SQLTask:SqlStatementSource="&#xA;IF OBJECT_ID('tempdb..#COD_PENDIENTE_POR_RECAUDO') IS NOT NULL &#xA;    DROP TABLE #COD_PENDIENTE_POR_RECAUDO&#xA;&#xA;IF OBJECT_ID('tempdb..#TMP_GUIAS_PENDIENTE_RECAUDO') IS NOT NULL &#xA;    DROP TABLE #TMP_GUIAS_PENDIENTE_RECAUDO&#xA;&#xA;CREATE TABLE #TMP_GUIAS_PENDIENTE_RECAUDO(&#xA; NUMERO_GUIA numeric(20, 0) NOT NULL,&#xA; ID_ESTADOENVIO smallint DEFAULT 0,&#xA; NOMBRE_ESTADOENVIO varchar(40) DEFAULT '',&#xA; FORMA_PAGO varchar(40) DEFAULT '',&#xA; VALOR_A_RECAUDAR numeric(12, 2) NULL,&#xA; ID_REMITE [varchar](40) DEFAULT '',&#xA; NOMBRE_REMITE_GUIA  [varchar](200) DEFAULT '',&#xA; -- ID_CIUDAD INT DEFAULT 0,&#xA; -- [NOMBRE_CIUDAD] [varchar](50) DEFAULT '',&#xA; FECHA_ENVIO datetime NULL,&#xA; [VALOR_RECAUDADO] [numeric](11, 2) DEFAULT 0,&#xA; FECHA_RECAUDO datetime NULL,&#xA; NUMERO_ORDEN_SERVICIO varchar(20) DEFAULT '',&#xA; FECHA_RECAUDO_EFECTY datetime NULL,&#xA; ESTADO_ENTREGA varchar(70) DEFAULT 'A TIEMPO',--A TIEMPO O VENCIDO&#xA; --NOMBRE_RESPONSABLE_ULT_MOV VARCHAR(100) DEFAULT '',&#xA; ID_PROCESO_ULT_MOV int DEFAULT 0,&#xA; NOMBRE_PROCESO_ULT_MOV varchar(70) DEFAULT '',&#xA; ID_CONCEPTO_ULT_MOV int DEFAULT 0,&#xA; NOMBRE_CONCEPTO_ULT_MOV varchar(70) DEFAULT '',&#xA; NUMERO_MOVIMI_ULT_MOV char(30) DEFAULT '',&#xA; CONSECUT_MOVIMI_ULT_MOV numeric(7, 0) DEFAULT 0,&#xA; FECHA_HORA_MOVIMI_ULT_MOV datetime NULL,&#xA; ID_PAIS_ZONA_URBA_ULT_MOV SMALLINT NULL,&#xA; ID_CIUDAD_ZONA_URBA_ULT_MOV INT NULL,&#xA; ID_TIPO_ZONA_URBA_ULT_MOV SMALLINT NULL,&#xA; ID_ZONA_URBA_ULT_MOV SMALLINT NULL,&#xA; NOMBRE_CDS_ULT_MOV varchar(100) DEFAULT '',&#xA; TIPO_CANAL_ULT_MOV varchar(40) DEFAULT '',&#xA; ID_CONDUCTOR_ULT_MOV varchar(40) DEFAULT '',&#xA; CONDUCTOR_ULT_MOV  varchar(200) DEFAULT '',&#xA; ID_AUXILIAR_ULT_MOV varchar(40) DEFAULT '',&#xA; AUXILIAR_ULT_MOV varchar(200) DEFAULT '',&#xA; ID_CLIENTE [char](20) NOT NULL,&#xA; NOMBRE_TIPO_CANAL varchar(100) DEFAULT '',&#xA; NOMBRE_CLASE_TIPO_CANAL varchar(100) DEFAULT '',&#xA; [G_ID_CIUDAD_ORIGEN] [int] NULL,&#xA; [G_ID_CIUDAD_DESTINO] [int] NULL&#xA;) ON [PRIMARY]&#xA;CREATE NONCLUSTERED INDEX [IX_NUMERO_GUIA] ON #TMP_GUIAS_PENDIENTE_RECAUDO ([NUMERO_GUIA] ASC)&#xA;CREATE NONCLUSTERED INDEX [IX_ZONA] ON #TMP_GUIAS_PENDIENTE_RECAUDO (ID_PAIS_ZONA_URBA_ULT_MOV,ID_CIUDAD_ZONA_URBA_ULT_MOV, ID_TIPO_ZONA_URBA_ULT_MOV,ID_ZONA_URBA_ULT_MOV ASC)&#xA;CREATE NONCLUSTERED INDEX [IX_MANIFIESTO] ON #TMP_GUIAS_PENDIENTE_RECAUDO (ID_PROCESO_ULT_MOV,NUMERO_MOVIMI_ULT_MOV,CONSECUT_MOVIMI_ULT_MOV ASC)&#xA;&#xA;&#xA;IF OBJECT_ID('tempdb..#TMP_CIUDADES_ANEXAS') IS NOT NULL &#xA;    DROP TABLE #TMP_CIUDADES_ANEXAS&#xA;&#xA;---CIUDADES ANEXAS&#xA;SELECT CAD.* &#xA;INTO #TMP_CIUDADES_ANEXAS FROM PARAMETROS.DBO.CIUDADES_ANEXAS CAD (NOLOCK) &#xA;WHERE CAD.ID_PAIS=1 AND CAD.RECOLECCION=1&#xA;&#xA;INSERT INTO #TMP_CIUDADES_ANEXAS&#xA;SELECT CAD.* FROM PARAMETROS.DBO.CIUDADES_ANEXAS CAD (NOLOCK) &#xA;LEFT JOIN #TMP_CIUDADES_ANEXAS TCAD ON TCAD.ID_CIUDAD_ANEXA=CAD.ID_CIUDAD_ANEXA&#xA;WHERE CAD.ID_PAIS=1 AND CAD.RECOLECCION=0 AND TCAD.ID_CIUDAD_ANEXA IS NULL&#xA;&#xA;DELETE T FROM (SELECT *, &#xA;    DupRank = ROW_NUMBER() OVER (PARTITION BY ID_CIUDAD_ANEXA ORDER BY FECHA_CREACION DESC) &#xA;     FROM #TMP_CIUDADES_ANEXAS) AS T&#xA;WHERE DupRank &gt; 1&#xA;&#xA;&#xA;&#xA;SELECT CPR.*,G.ID_CLIENTE,G.ID_REMITE,G.NOMBRE_REMITE_GUIA,G.ID_PRODUCTO AS ID_PRODUCTO_GUIA,G.ID_ESTADOENVIO,G.ID_ESTADOGUIA,ISNULL(G.VALOR_SEG_MAN_GUIAS,0)+ISNULL(G.VALOR_FLETES_GUIAS,0) AS VALOR_ENVIO_GUIA,ISNULL(GIA.VALOR_RECAUDAR_PRODUCTO,0) AS VALOR_RECAUDAR_PRODUCTO_GUIA&#xA;,CAST('' AS nvarchar(50)) AS NOMBRE_ESTADOENVIO,G.FECHA_ENVIO&#xA;,TCAN.NOMBRE_TIPO_CANAL&#xA;,CTCAN.NOMBRE_CLASE_TIPO_CANAL&#xA;,G.[ID_CIUDAD_ORIGEN]   AS G_ID_CIUDAD_ORIGEN&#xA;,G.[ID_CIUDAD_DESTINO]   AS G_ID_CIUDAD_DESTINO&#xA;INTO #COD_PENDIENTE_POR_RECAUDO&#xA;FROM [Mece_Logistico].[dbo].[COD_PENDIENTE_POR_RECAUDO] CPR (NOLOCK)&#xA;INNER JOIN [Mece_Logistico].[dbo].[GUIAS] G (nolock) ON G.NUMERO_GUIA=CPR.NUMERO_GUIA&#xA;LEFT JOIN [Mece_Logistico].[dbo].[GUIAS_INF_ADICIONAL] GIA (nolock) ON GIA.NUMERO_GUIA=CPR.NUMERO_GUIA&#xA;LEFT JOIN [tmp_borrar_local].dbo.LPC_GUIAS_SOLUCIONADAS LGS (NOLOCK) ON LGS.NUMERO_GUIA=CPR.NUMERO_GUIA&#xA;LEFT JOIN [Mece_Logistico].[dbo].[CANALES] CAN (NOLOCK) ON CAN.id_pais=G.ID_1 and CAN.id_ciudad=G.ID_2 and CAN.[ID_DIVISION]=G.ID_CANAL&#xA;LEFT JOIN [Mece_Logistico].[dbo].[TIPOS_CANAL] TCAN (NOLOCK) ON TCAN.ID_TIPO_CANAL=CAN.ID_TIPO_CANAL AND TCAN.ID_EST_TIPO_CANAL=1&#xA;LEFT JOIN PARAMETROS.[dbo].[CLASE_TIPO_CANAL] CTCAN (NOLOCK) ON CTCAN.ID_CLASE_TIPO_CANAL=TCAN.CLASE_TIPO_CANAL&#xA;WHERE LGS.NUMERO_GUIA IS NULL AND&#xA;ISNULL(CPR.ESTADO_COD,1)=1-- RECAUDO ESTA ACTIVO&#xA;AND ISNULL(CPR.ESTA_RECAUDADO,0)=0 -- NO ESTA RECAUDADO&#xA;--AND G.ID_ESTADOGUIA!=4-- NO ESTA ANULADA&#xA;AND ISNULL(CPR.NUMERO_ORDEN_SERVICIO,'')='' -- NO TIENE ORDEN DE RECAUDO DE EFECTY&#xA;AND ISNULL(CPR.ESTA_ANULADO,0)=0 -- NO DEBE ESTAR ANULADA&#xA;AND G.ID_DIVISION_PROV IS NULL&#xA;--AND CPR.FECHA_CREACION &gt;= @FECHA_INI &#xA;--AND CPR.FECHA_CREACION &lt; @FECHA_FIN&#xA;&#xA;AND CPR.FECHA_CREACION BETWEEN convert(datetime,?) AND convert(datetime,?)&#xA;/*&#xA;AND CPR.FECHA_CREACION BETWEEN convert(datetime,'20251201') &#xA;       AND convert(datetime,'20260201')&#xA;*/&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;/*&#xA;select G.NUMERO_GUIA&#xA;,TCAN.NOMBRE_TIPO_CANAL&#xA;,CTCAN.NOMBRE_CLASE_TIPO_CANAL&#xA;from Mece_Logistico.dbo.guias G (nolock)&#xA;left JOIN [Mece_Logistico].[dbo].[CANALES] CAN (NOLOCK) ON CAN.id_pais=G.ID_1 and CAN.id_ciudad=G.ID_2 and CAN.[ID_DIVISION]=G.ID_CANAL&#xA;left JOIN [Mece_Logistico].[dbo].[TIPOS_CANAL] TCAN (NOLOCK) ON TCAN.ID_TIPO_CANAL=CAN.ID_TIPO_CANAL AND TCAN.ID_EST_TIPO_CANAL=1&#xA;left JOIN PARAMETROS.[dbo].[CLASE_TIPO_CANAL] CTCAN (NOLOCK) ON CTCAN.ID_CLASE_TIPO_CANAL=TCAN.CLASE_TIPO_CANAL&#xA;where G.ID_CANAL IS NOT NULL&#xA;AND FECHA_ENVIO&gt;='20260120 00:00:00'&#xA;*/&#xA;&#xA;CREATE NONCLUSTERED INDEX [IX_NUMERO_GUIA] ON #COD_PENDIENTE_POR_RECAUDO ([NUMERO_GUIA] ASC)&#xA;&#xA;&#xA;--Se quitan envios siniestrados&#xA;DELETE GPR FROM #COD_PENDIENTE_POR_RECAUDO GPR&#xA;WHERE ID_ESTADOENVIO in(5,4)&#xA;&#xA;--Quita las guias son del canal retail y no son COD y no contraentrega ecommerce&#xA;DELETE GPR FROM #COD_PENDIENTE_POR_RECAUDO GPR&#xA;WHERE ID_FORMA_PAGO=1 AND ID_PRODUCTO!=86&#xA;&#xA;&#xA;--SELECT * FROM #COD_PENDIENTE_POR_RECAUDO CPR (NOLOCK)&#xA;--WHERE --NUMERO_GUIA=2143658629&#xA;--ID_PRODUCTO=86&#xA;--INSERT INTO #TMP_GUIAS_PENDIENTE_RECAUDO&#xA;&#xA;UPDATE CPR SET CPR.NOMBRE_ESTADOENVIO=E.NOMBRE_ESTADOENVIO&#xA;FROM #COD_PENDIENTE_POR_RECAUDO CPR&#xA;INNER JOIN PARAMETROS.DBO.ESTADOSENVIO E (NOLOCK)ON E.ID_ESTADOENVIO=CPR.ID_ESTADOENVIO&#xA;&#xA;--TRUNCATE TABLE #TMP_GUIAS_PENDIENTE_RECAUDO&#xA;INSERT INTO #TMP_GUIAS_PENDIENTE_RECAUDO(&#xA;NUMERO_GUIA,&#xA;ID_ESTADOENVIO,&#xA;NOMBRE_ESTADOENVIO,&#xA;FORMA_PAGO,&#xA;VALOR_A_RECAUDAR,&#xA;ID_REMITE,&#xA;NOMBRE_REMITE_GUIA,&#xA;FECHA_ENVIO,&#xA;VALOR_RECAUDADO,&#xA;FECHA_RECAUDO,&#xA;NUMERO_ORDEN_SERVICIO,&#xA;FECHA_RECAUDO_EFECTY,&#xA;ID_CLIENTE,&#xA;NOMBRE_TIPO_CANAL,&#xA;NOMBRE_CLASE_TIPO_CANAL,&#xA;G_ID_CIUDAD_ORIGEN,&#xA;G_ID_CIUDAD_DESTINO&#xA;)&#xA;SELECT CPR.NUMERO_GUIA,CPR.ID_ESTADOENVIO,CPR.NOMBRE_ESTADOENVIO,&#xA;CASE WHEN CPR.ID_FORMA_PAGO=4 AND CPR.ID_CLIENTE IS NULL THEN 'C.O.D.' WHEN ISNULL(CPR.ID_PRODUCTO,CPR.ID_PRODUCTO_GUIA)=86 THEN 'CONTRAENTREGA ECOMMERCE' WHEN (CPR.ID_FORMA_PAGO=2 OR CPR.ID_CLIENTE IS NOT NULL) THEN 'LPC' ELSE '' END AS FORMA_PAGO,&#xA;CASE WHEN ISNULL(CPR.VALOR_TOTAL,0)!=0 THEN CPR.VALOR_TOTAL&#xA;WHEN CPR.ID_FORMA_PAGO=4 AND VALOR_FLETE IS NOT NULL THEN ISNULL(CPR.VALOR_FLETE,0) + ISNULL(CPR.VALOR_OTROS,0)&#xA;WHEN CPR.ID_FORMA_PAGO=4 AND VALOR_FLETE IS NULL THEN ISNULL(CPR.VALOR_ENVIO_GUIA,0)&#xA;WHEN ISNULL(CPR.ID_PRODUCTO,CPR.ID_PRODUCTO_GUIA)=86 THEN ISNULL(CPR.VALOR_DECLARADO,CPR.VALOR_PRODUCTO)&#xA;WHEN (CPR.ID_FORMA_PAGO=2 OR CPR.ID_CLIENTE IS NOT NULL) THEN ISNULL(CPR.VALOR_DECLARADO,CPR.VALOR_PRODUCTO) ELSE 0 END AS VALOR_A_RECAUDAR&#xA;,CPR.ID_REMITE&#xA;,CPR.NOMBRE_REMITE_GUIA&#xA;,CPR.FECHA_ENVIO&#xA;,ISNULL(CPR.VALOR_RECAUDADO,0)&#xA;,CPR.FECHA_RECAUDO&#xA;,ISNULL(CPR.NUMERO_ORDEN_SERVICIO,0)&#xA;,CPR.FECHA_RECAUDO_EFECTY&#xA;,isnull(CPR.ID_CLIENTE,'0') ID_CLIENTE&#xA;,CPR.NOMBRE_TIPO_CANAL&#xA;,CPR.NOMBRE_CLASE_TIPO_CANAL&#xA;,G_ID_CIUDAD_ORIGEN&#xA;,G_ID_CIUDAD_DESTINO&#xA;--,CPR.VALOR_TOTAL&#xA;--INTO #TMP_GUIAS_PENDIENTE_RECAUDO_1&#xA;FROM #COD_PENDIENTE_POR_RECAUDO CPR (NOLOCK)&#xA;WHERE LEN(CPR.NUMERO_GUIA)&gt;7&#xA;--INNER JOIN [Mece_Logistico].[dbo].[GUIAS] G (nolock) ON G.NUMERO_GUIA=CPR.NUMERO_GUIA&#xA;&#xA;--CREATE NONCLUSTERED INDEX [IX_NUMERO_GUIA] ON #TMP_GUIAS_PENDIENTE_RECAUDO_1 ([NUMERO_GUIA] ASC)&#xA;&#xA;--select GPR.* from #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA;&#xA;&#xA;UPDATE GPR SET&#xA; --GPR.NOMBRE_RESPONSABLE_ULT_MOV='SERVIENTREGA S.A.'&#xA; GPR.ID_PROCESO_ULT_MOV=SE.ID_PROCESO&#xA; ,GPR.NOMBRE_PROCESO_ULT_MOV=PRO.NOMBRE_PROCESO_LOG&#xA; ,GPR.ID_CONCEPTO_ULT_MOV=ISNULL(SE.ID_CONCEPTO,0)&#xA; ,GPR.NOMBRE_CONCEPTO_ULT_MOV=ISNULL(ICON.NOMBRE_CONCEPTO,'')&#xA; ,GPR.NUMERO_MOVIMI_ULT_MOV=SE.NUMERO_MOVIMI&#xA; ,GPR.CONSECUT_MOVIMI_ULT_MOV=SE.CONSECUT_MOVIMI&#xA; ,GPR.FECHA_HORA_MOVIMI_ULT_MOV=SE.FECHA_HORA_MOVIMIENTO&#xA; --,GPR.ID_CONDUCTOR_ULT_MOV=DOC.ID_COURIER_CONDUCTOR&#xA; --,GPR.ID_AUXILIAR_ULT_MOV=DOC.ID_AUXILIAR1_VEHICULO&#xA; --,GPR.ID_PAIS_ZONA_URBA_ULT_MOV=DOC.ID_PAIS_ZONA_URBA  &#xA; --,GPR.ID_CIUDAD_ZONA_URBA_ULT_MOV=DOC.ID_CIUDAD_ZONA_URBA &#xA; --,GPR.ID_TIPO_ZONA_URBA_ULT_MOV=DOC.ID_TIPO_ZONA_URBA&#xA; --,GPR.ID_ZONA_URBA_ULT_MOV=DOC.ID_ZONA_URBA&#xA; FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; INNER JOIN MECE_LOGISTICO.dbo.SEGUIMIENTO_ENVIO SE WITH(NOLOCK) on se.NUMERO_GUIA=GPR.NUMERO_GUIA&#xA; --INNER JOIN MECE_LOGISTICO.dbo.DOCUMENTOS DOC (NOLOCK) ON&#xA; --DOC.ID_PROCESO=GPR.[ID_PROCESO_ULT_MOV] AND DOC.NUMERO_MOVIMI=GPR.[NUMERO_MOVIMI_ULT_MOV] AND DOC.CONSECUT_MOVIMI=GPR.[CONSECUT_MOVIMI_ULT_MOV]&#xA; INNER JOIN PARAMETROS.DBO.PROCESOS PRO (NOLOCK) ON PRO.ID_PROCESO=SE.ID_PROCESO&#xA; LEFT JOIN PARAMETROS.DBO.ITEM_CONCEPTO ICON (NOLOCK) ON ICON.ID_PAIS=1 AND ICON.ID_PROCESO=SE.ID_PROCESO AND ICON.ID_CONCEPTO=SE.ID_CONCEPTO&#xA; WHERE se.FECHA_HORA_MOVIMIENTO= (select MAX(se1.FECHA_HORA_MOVIMIENTO) from MECE_LOGISTICO.dbo.SEGUIMIENTO_ENVIO SE1 WITH(NOLOCK)&#xA;          where SE1.numero_guia=GPR.NUMERO_GUIA)&#xA; &#xA; UPDATE GPR SET&#xA; GPR.ID_CONDUCTOR_ULT_MOV=DOC.ID_COURIER_CONDUCTOR&#xA; ,GPR.ID_AUXILIAR_ULT_MOV=DOC.ID_AUXILIAR1_VEHICULO&#xA; ,GPR.ID_PAIS_ZONA_URBA_ULT_MOV=DOC.ID_PAIS_ZONA_URBA  &#xA; ,GPR.ID_CIUDAD_ZONA_URBA_ULT_MOV=DOC.ID_CIUDAD_ZONA_URBA &#xA; ,GPR.ID_TIPO_ZONA_URBA_ULT_MOV=DOC.ID_TIPO_ZONA_URBA&#xA; ,GPR.ID_ZONA_URBA_ULT_MOV=DOC.ID_ZONA_URBA&#xA; FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; INNER JOIN MECE_LOGISTICO.DBO.DOCUMENTOS DOC (NOLOCK) ON&#xA; DOC.ID_PROCESO=GPR.[ID_PROCESO_ULT_MOV] AND DOC.NUMERO_MOVIMI=GPR.[NUMERO_MOVIMI_ULT_MOV] AND DOC.CONSECUT_MOVIMI=GPR.[CONSECUT_MOVIMI_ULT_MOV]&#xA;&#xA; --SELECT GPR.ID_CONDUCTOR_ULT_MOV&#xA; &#xA; UPDATE GPR SET&#xA; GPR.ID_CONDUCTOR_ULT_MOV=ISNULL(RTRIM(LTRIM(EC.ID_EMPLEADO)),'')&#xA; ,GPR.CONDUCTOR_ULT_MOV =ISNULL(RTRIM(LTRIM(EC.NOMBRE_EMPLEADO)) +' '+ RTRIM(LTRIM(EC.APELLIDO_EMPLEADO)),'') &#xA; ,GPR.ID_AUXILIAR_ULT_MOV=ISNULL(RTRIM(LTRIM(EA.ID_EMPLEADO)),'')&#xA; ,GPR.AUXILIAR_ULT_MOV=ISNULL(RTRIM(LTRIM(EA.NOMBRE_EMPLEADO)) +' '+ RTRIM(LTRIM(EA.APELLIDO_EMPLEADO)),'') &#xA; FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; LEFT JOIN PARAMETROS.DBO.EMPLEADOS EC (NOLOCK) ON EC.ID_EMPLEADO=GPR.ID_CONDUCTOR_ULT_MOV&#xA; LEFT JOIN PARAMETROS.DBO.EMPLEADOS EA (NOLOCK) ON EA.ID_EMPLEADO=GPR.ID_AUXILIAR_ULT_MOV&#xA;&#xA;&#xA; --SELECT GPR.NUMERO_GUIA,ISNULL(DIV.NOMBRE_DIVISION,'') AS NOMBRE_CDS, ISNULL(CTCAN.[NOMBRE_CLASE_TIPO_CANAL],'') as TIPO_CANAL&#xA;UPDATE GPR SET NOMBRE_CDS_ULT_MOV=ISNULL(DIV.NOMBRE_DIVISION,''),&#xA; TIPO_CANAL_ULT_MOV=ISNULL(CTCAN.[NOMBRE_CLASE_TIPO_CANAL],'')&#xA; FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; --INNER JOIN MECE_LOGISTICO.DBO.DOCUMENTOS DOC (NOLOCK) ON&#xA; --DOC.ID_PROCESO=GPR.[ID_PROCESO_ULT_MOV] AND DOC.NUMERO_MOVIMI=GPR.[NUMERO_MOVIMI_ULT_MOV] AND DOC.CONSECUT_MOVIMI=GPR.[CONSECUT_MOVIMI_ULT_MOV]&#xA; INNER JOIN PARAMETROS.DBO.ZONASURBANAS Z (NOLOCK) &#xA; ON Z.ID_PAIS = GPR.ID_PAIS_ZONA_URBA_ULT_MOV AND Z.ID_CIUDAD = GPR.ID_CIUDAD_ZONA_URBA_ULT_MOV &#xA;  AND Z.ID_TIPO_ZONA_URBA = GPR.ID_TIPO_ZONA_URBA_ULT_MOV AND Z.ID_ZONA_URBA = GPR.ID_ZONA_URBA_ULT_MOV --AND Z.CATEGORIA_ZONA_URBA = 8 --CLICOH&#xA; INNER JOIN PARAMETROS.DBO.DIVISIONES DIV (NOLOCK) ON DIV.ID_PAIS = Z.ID_PAIS_CANAL AND DIV.ID_CIUDAD = Z.ID_CIUDAD_CANAL AND DIV.ID_DIVISION = Z.ID_CANAL&#xA; INNER JOIN [Mece_Logistico].[dbo].[CANALES] CAN (NOLOCK) ON CAN.id_pais=DIV.ID_PAIS and CAN.id_ciudad=DIV.ID_CIUDAD and CAN.[ID_DIVISION]=DIV.ID_DIVISION&#xA; INNER JOIN [Mece_Logistico].[dbo].[TIPOS_CANAL] TCAN (NOLOCK) ON TCAN.ID_TIPO_CANAL=CAN.ID_TIPO_CANAL AND TCAN.ID_EST_TIPO_CANAL=1&#xA; INNER JOIN PARAMETROS.[dbo].[CLASE_TIPO_CANAL] CTCAN (NOLOCK) ON CTCAN.ID_CLASE_TIPO_CANAL=TCAN.CLASE_TIPO_CANAL&#xA;&#xA;&#xA; --UPDATE GPR SET ESTADO_ENTREGA='VENCIDO'&#xA; --SELECT * FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; UPDATE GPR SET ESTADO_ENTREGA='VENCIDO'&#xA; FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; WHERE GPR.ID_PROCESO_ULT_MOV=9 AND ID_CONCEPTO_ULT_MOV IN(9,7,2,4)--9 ENTREGAS OFIC  C.O.D. Y/O LPC EMPRESARIO --7 EMPRESARIO SATELITE ENTREGA EN OFICINA&#xA; --2 RECLAMO OFICINA Y 4 C.O.D RECLAMO OFICINA&#xA; AND DATEDIFF(DAY, FECHA_HORA_MOVIMI_ULT_MOV,GETDATE())&gt;8 -- MAS DE 8 DIAS&#xA; &#xA; UPDATE GPR SET ESTADO_ENTREGA='VENCIDO'&#xA; FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; WHERE GPR.ID_PROCESO_ULT_MOV=31 --ENVIO PARA ENTREGA EN OFICINA&#xA; AND DATEDIFF(DAY, FECHA_HORA_MOVIMI_ULT_MOV,GETDATE())&gt;8 -- MAS DE 8 DIAS&#xA;&#xA; UPDATE GPR SET ESTADO_ENTREGA='VENCIDO'&#xA; FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; WHERE GPR.ID_PROCESO_ULT_MOV=9 AND ID_CONCEPTO_ULT_MOV IN(10,8) --10 ENTR A DOMICI  LPC / COD EMPRESARIOS SAT --8 EMPRESARIO SATELITE ENTREGA EN DOMICILIO&#xA; AND DATEDIFF(DAY, FECHA_HORA_MOVIMI_ULT_MOV,GETDATE())&gt;3-- MAS DE 3 DIAS&#xA; &#xA; UPDATE GPR SET ESTADO_ENTREGA='VENCIDO'&#xA; FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; WHERE GPR.ID_PROCESO_ULT_MOV=32 --ENVIO PARA ENTREGA A DOMICILIO&#xA; AND DATEDIFF(DAY, FECHA_HORA_MOVIMI_ULT_MOV,GETDATE())&gt;3-- MAS DE 3 DIAS&#xA;&#xA; UPDATE GPR SET ESTADO_ENTREGA='VENCIDO'&#xA; FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; WHERE GPR.ID_PROCESO_ULT_MOV=9 AND ID_CONCEPTO_ULT_MOV IN(1,3) --SALIDA A ZONA Y C.O.D EN DISTRIBUCION&#xA; AND DATEDIFF(DAY, FECHA_HORA_MOVIMI_ULT_MOV,GETDATE())&gt;1 --MAS DE UN DIA&#xA;&#xA;&#xA;&#xA;DROP TABLE IF EXISTS #TMP_GUIAS_PENDIENTE_RECAUDO_SZU&#xA; SELECT &#xA; TMP.NUMERO_GUIA&#xA; ,(SE.CONSECUT_MOVIMI)   AS CONSECUT_MOVIMI_SZU&#xA; ,(SE.NUMERO_MOVIMI)    AS NUMERO_MOVIMI_SZU&#xA; ,(SE.FECHA_HORA_MOVIMIENTO)  AS FECHA_HORA_MOVIMI_ULT_MOV_SZU&#xA;INTO #TMP_GUIAS_PENDIENTE_RECAUDO_SZU&#xA;FROM #TMP_GUIAS_PENDIENTE_RECAUDO TMP&#xA;INNER JOIN Mece_Logistico..SEGUIMIENTO_ENVIO SE&#xA;ON SE.NUMERO_GUIA=TMP.NUMERO_GUIA&#xA;WHERE SE.ID_PROCESO=9&#xA;---GROUP BY  TMP.NUMERO_GUIA&#xA;&#xA;;WITH CTE AS(&#xA;SELECT &#xA;ROWID = ROW_NUMBER() OVER(PARTITION BY NUMERO_GUIA ORDER BY FECHA_HORA_MOVIMI_ULT_MOV_SZU DESC)&#xA;,NUMERO_GUIA,FECHA_HORA_MOVIMI_ULT_MOV_SZU&#xA;FROM #TMP_GUIAS_PENDIENTE_RECAUDO_SZU&#xA;)&#xA;DELETE CTE WHERE ROWID&gt;1&#xA;&#xA;&#xA;&#xA;--SELECT * FROM #TMP_GUIAS_PENDIENTE_RECAUDO TMP&#xA;&#xA;&#xA;&#xA;DROP TABLE IF EXISTS #TMP_GUIAS_CON_TAREAS &#xA; SELECT &#xA; TMP.NUMERO_GUIA,&#xA; COUNT(TAR.NUMERO_DOCPROBLEMA) AS NUMERO_TAREAS&#xA;INTO #TMP_GUIAS_CON_TAREAS&#xA;FROM #TMP_GUIAS_PENDIENTE_RECAUDO TMP&#xA;INNER JOIN Mece_Logistico..TAREAS TAR WITH(NOLOCK)&#xA;ON TAR.NUMERO_DOCPROBLEMA=CONVERT(CHAR(20),TMP.NUMERO_GUIA)&#xA;GROUP BY TMP.NUMERO_GUIA&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;DROP TABLE IF EXISTS ##TMP_GUIAS_PENDIENTE_RECAUDO_FINAL_PBI;&#xA;SELECT --GPR.*&#xA;GPR.NUMERO_GUIA &#xA;--GPR.ID_ESTADOENVIO &#xA;,GPR.NOMBRE_ESTADOENVIO &#xA;,GPR.FORMA_PAGO &#xA;,GPR.VALOR_A_RECAUDAR &#xA;,GPR.ID_REMITE &#xA;,GPR.NOMBRE_REMITE_GUIA &#xA;,GPR.FECHA_ENVIO&#xA;,GPR.VALOR_RECAUDADO&#xA;,GPR.FECHA_RECAUDO&#xA;,GPR.NUMERO_ORDEN_SERVICIO&#xA;,GPR.FECHA_RECAUDO_EFECTY&#xA;,GPR.ESTADO_ENTREGA&#xA;--,GPR.NOMBRE_RESPONSABLE_ULT_MOV &#xA;--ID_PROCESO_ULT_MOV &#xA;--NOMBRE_PROCESO_ULT_MOV &#xA;--NUMERO_MOVIMI_ULT_MOV &#xA;--CONSECUT_MOVIMI_ULT_MOV &#xA;--FECHA_HORA_MOVIMI_ULT_MOV&#xA;&#xA;--,ISNULL(ISNULL(CLO.CENTRO_LOGISTICO,CLD.CENTRO_LOGISTICO),'')  AS CPL_ORIGEN_ULT_MOV&#xA;--,ISNULL(ISNULL(RO.NOMBRE_REGIONAL,RD.NOMBRE_REGIONAL),'')  AS REGIONAL_ORIGEN_ULT_MOV&#xA;--,ISNULL(ISNULL(CO.NOMBRE_CIUDAD,CD.NOMBRE_CIUDAD),'')  AS CIUDAD_ORIGEN_ULT_MOV&#xA;--,ISNULL(ISNULL(CLD.CENTRO_LOGISTICO,CLO.CENTRO_LOGISTICO),'') AS CPL_DESTINO_ULT_MOV&#xA;--,ISNULL(ISNULL(RD.NOMBRE_REGIONAL,RO.NOMBRE_REGIONAL),'') AS REGIONAL_DESTINO_ULT_MOV&#xA;--,ISNULL(ISNULL(CD.NOMBRE_CIUDAD,CO.NOMBRE_CIUDAD),'') AS CIUDAD_DESTINO_MOV&#xA;,CASE WHEN ID_PROCESO!=14 THEN &#xA;ISNULL(ISNULL(CLO.CENTRO_LOGISTICO,CLD.CENTRO_LOGISTICO),'')  ELSE ISNULL(ISNULL(CLD.CENTRO_LOGISTICO,CLO.CENTRO_LOGISTICO),'') END AS CPL_ULT_MOV&#xA;,CASE WHEN ID_PROCESO!=14 THEN &#xA;ISNULL(ISNULL(RO.NOMBRE_REGIONAL,RD.NOMBRE_REGIONAL),'') ELSE ISNULL(ISNULL(RD.NOMBRE_REGIONAL,RO.NOMBRE_REGIONAL),'') END  AS REGIONAL_ULT_MOV&#xA;,CASE WHEN ID_PROCESO!=14 THEN &#xA;ISNULL(ISNULL(CO.NOMBRE_CIUDAD,CD.NOMBRE_CIUDAD),'')  ELSE ISNULL(ISNULL(CD.NOMBRE_CIUDAD,CO.NOMBRE_CIUDAD),'') END  AS CIUDAD_ULT_MOV&#xA;,ISNULL(CASE &#xA; WHEN ISNULL(DOC.ID_CIUDAD_ZONA_URBA,0) !=0 THEN&#xA; ROZ.NOMBRE_REGIONAL+' - '+ DCOZ.NOMBRE_DEPARTAMENTO +' - '+ COZ.NOMBRE_CIUDAD &#xA; WHEN  ISNULL(DOC.ID_CIUDAD_DIVISION_ORIGEN,0) !=0 AND DOC.ID_PROCESO!=14 THEN&#xA; ROM.NOMBRE_REGIONAL+' - '+ DCOM.NOMBRE_DEPARTAMENTO +' - '+ COM.NOMBRE_CIUDAD&#xA; ELSE&#xA; ROD.NOMBRE_REGIONAL+' - '+ DCOD.NOMBRE_DEPARTAMENTO +' - '+ COD.NOMBRE_CIUDAD &#xA; END,'') AS REG_DEPART_CIUDAD_ULTIMO_MOV&#xA;&#xA;,ISNULL(DOC.PLACA_VEHICULO_DOCU,'') as PLACA_VEHICULO_ULTIMO_MOV&#xA;,ISNULL(O.[NOMBRE_OPERATIVO],'') AS NOMBRE_OPERATIVO_ULTIMO_MOV&#xA;,ISNULL(Z.NOMBRE_ZONA_URBA,'') AS ZONA_URBANA_ULTIMO_MOV&#xA;,ISNULL(CZ.NOMBRE_CATEGORIA,'') AS CATEGORIA_ZONA_ULTIMO_MOV&#xA;,ISNULL(TZU.NOMBRE_TIPO_ZONA_URBA,'') AS TIPO_ZONA_ULTIMO_MOV&#xA;,ISNULL(GPR.NOMBRE_CDS_ULT_MOV,'') AS NOMBRE_CDS_ULT_MOV&#xA;,ISNULL(TIPO_CANAL_ULT_MOV,'') AS TIPO_CANAL_ULT_MOV&#xA;--,GR.ID_PROCESO &#xA;,ISNULL(GPR.NOMBRE_PROCESO_ULT_MOV,'') AS PROCESO_LOG_ULTIMO_MOV  &#xA;,ISNULL(GPR.NOMBRE_CONCEPTO_ULT_MOV,'') AS CONCEPTO_ULT_MOV&#xA;--,GR.ID_CONCEPTO  &#xA;--,GR.FECHA_HORA_MOVIMIENTO&#xA;,ISNULL(cast(GPR.ID_PROCESO_ULT_MOV as nvarchar) +' - '+ RTRIM(GPR.NOMBRE_PROCESO_ULT_MOV),'') AS NOMBRE_ULTIMO_MOV&#xA;,ISNULL(CASE WHEN DIO.ID_DIVISION IS NOT NULL THEN cast(DIO.ID_DIVISION as nvarchar) +' - '+ RTRIM(DIO.NOMBRE_DIVISION)&#xA;ELSE cast(DID.ID_DIVISION as nvarchar) +' - '+ RTRIM(DID.NOMBRE_DIVISION) END,'') AS BODEGA_ULTIMO_MOV&#xA;,ISNULL(cast(GPR.ID_PROCESO_ULT_MOV as nvarchar) +' - '+ RTRIM(GPR.[NUMERO_MOVIMI_ULT_MOV])+' - '+  cast(GPR.[CONSECUT_MOVIMI_ULT_MOV] as nvarchar),'') as ULTIMO_MOV_LOGISTICO&#xA;,ISNULL(CONVERT(nvarchar(20),GPR.FECHA_HORA_MOVIMI_ULT_MOV,120),'') AS FECHA_ULTIMO_MOV&#xA;,GPR.ID_CONDUCTOR_ULT_MOV&#xA;,GPR.CONDUCTOR_ULT_MOV&#xA;,GPR.ID_AUXILIAR_ULT_MOV&#xA;,GPR.AUXILIAR_ULT_MOV&#xA;,GPR.ID_CLIENTE&#xA;,SZU.CONSECUT_MOVIMI_SZU&#xA;,SZU.NUMERO_MOVIMI_SZU&#xA;,SZU.FECHA_HORA_MOVIMI_ULT_MOV_SZU&#xA;,GPR.NOMBRE_TIPO_CANAL&#xA;,GPR.NOMBRE_CLASE_TIPO_CANAL&#xA;,TAR.NUMERO_TAREAS&#xA;,G_ID_CIUDAD_ORIGEN&#xA;,G_ID_CIUDAD_DESTINO&#xA;--,DOC.*&#xA;INTO ##TMP_GUIAS_PENDIENTE_RECAUDO_FINAL_PBI&#xA;&#xA;FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA;--------------------------- CIUDAD ULTIMO MOV ZONA&#xA;  LEFT JOIN MECE_LOGISTICO.DBO.DOCUMENTOS DOC (NOLOCK) ON&#xA; DOC.ID_PROCESO=GPR.[ID_PROCESO_ULT_MOV] AND DOC.NUMERO_MOVIMI=GPR.[NUMERO_MOVIMI_ULT_MOV] AND DOC.CONSECUT_MOVIMI=GPR.[CONSECUT_MOVIMI_ULT_MOV]&#xA; --AND DOC.ID_DIVISION_DESTINO IN (9311, 9308, 9304, 9313, 9310, 9312, 9711, 9710)&#xA;  LEFT JOIN PARAMETROS.DBO.CIUDADES COZ (NOLOCK) ON  COZ.ID_PAIS=1 AND COZ.ID_CIUDAD=DOC.ID_CIUDAD_ZONA_URBA&#xA;  LEFT JOIN PARAMETROS.DBO.REGIONALES_PAIS ROZ (NOLOCK) ON  ROZ.ID_PAIS=COZ.ID_PAIS AND ROZ.ID_REGIONAL=COZ.ID_REGIONAL&#xA;  LEFT JOIN PARAMETROS.DBO.DEPARTAMENTOS DCOZ (NOLOCK) ON  DCOZ.ID_PAIS=COZ.ID_PAIS AND DCOZ.ID_DEPARTAMENTO=COZ.ID_DEPARTAMENTO&#xA;   LEFT JOIN PARAMETROS.DBO.ZONASURBANAS Z (NOLOCK) &#xA; ON Z.ID_PAIS = DOC.ID_PAIS_ZONA_URBA AND Z.ID_CIUDAD = DOC.ID_CIUDAD_ZONA_URBA AND Z.ID_TIPO_ZONA_URBA = DOC.ID_TIPO_ZONA_URBA AND Z.ID_ZONA_URBA = DOC.ID_ZONA_URBA --AND Z.CATEGORIA_ZONA_URBA = 8 --CLICOH&#xA;  LEFT JOIN [PARAMETROS].[dbo].[CATEGORIAZONASURBANAS] CZ (NOLOCK) ON CZ.Id_Categoria=Z.CATEGORIA_ZONA_URBA&#xA;  LEFT JOIN [PARAMETROS].[dbo].[TIPOSZONASURBANAS] TZU (NOLOCK) ON TZU.ID_TIPO_ZONA_URBA=Z.ID_TIPO_ZONA_URBA&#xA; --------------------------- CIUDAD ULTIMO MOV DOCUMENTO&#xA;  LEFT JOIN PARAMETROS.DBO.CIUDADES COM (NOLOCK) ON  COM.ID_PAIS=1 AND COM.ID_CIUDAD=DOC.ID_CIUDAD_DIVISION_ORIGEN&#xA;  LEFT JOIN PARAMETROS.DBO.REGIONALES_PAIS ROM (NOLOCK) ON  ROM.ID_PAIS=COM.ID_PAIS AND ROM.ID_REGIONAL=COM.ID_REGIONAL&#xA;  LEFT JOIN PARAMETROS.DBO.DEPARTAMENTOS DCOM (NOLOCK) ON  DCOM.ID_PAIS=COM.ID_PAIS AND DCOM.ID_DEPARTAMENTO=COM.ID_DEPARTAMENTO&#xA;  --------------------------- CIUDAD DESTINO ULTIMO MOV DOCUMENTO&#xA;  LEFT JOIN PARAMETROS.DBO.CIUDADES COD(NOLOCK) ON  COD.ID_PAIS=1 AND COD.ID_CIUDAD=DOC.ID_CIUDAD_DESTINO&#xA;  LEFT JOIN PARAMETROS.DBO.REGIONALES_PAIS ROD (NOLOCK) ON  ROD.ID_PAIS=COD.ID_PAIS AND ROD.ID_REGIONAL=COD.ID_REGIONAL&#xA;  LEFT JOIN PARAMETROS.DBO.DEPARTAMENTOS DCOD (NOLOCK) ON  DCOD.ID_PAIS=COD.ID_PAIS AND DCOD.ID_DEPARTAMENTO=COD.ID_DEPARTAMENTO&#xA;  --------------------------- DIVISION ORIGEN ULTIMO MOV DOCUMENTO&#xA;  LEFT JOIN PARAMETROS.DBO.DIVISIONES DIO(NOLOCK) ON DIO.ID_PAIS=DOC.ID_PAIS_DIVISION_ORIGEN&#xA; AND DIO.ID_CIUDAD=DOC.ID_CIUDAD_DIVISION_ORIGEN AND DIO.ID_DIVISION=DOC.ID_DIVISION_ORIGEN&#xA;  --------------------------- DIVISION DESTINO ULTIMO MOV DOCUMENTO&#xA;  LEFT JOIN PARAMETROS.DBO.DIVISIONES DID(NOLOCK) ON DID.ID_PAIS=DOC.ID_PAIS_DESTINO&#xA; AND DID.ID_CIUDAD=DOC.ID_CIUDAD_DESTINO AND DID.ID_DIVISION=DOC.ID_DIVISION_DESTINO&#xA;-------------------------------------------------------------&#xA;  LEFT JOIN [PARAMETROS].[dbo].CIUDADES CO (NOLOCK) ON CO.ID_PAIS=ID_PAIS_DIVISION_ORIGEN AND CO.ID_CIUDAD=DOC.ID_CIUDAD_DIVISION_ORIGEN&#xA;  LEFT JOIN [PARAMETROS].[dbo].REGIONALES_PAIS RO (NOLOCK) ON RO.ID_PAIS=1 AND RO.ID_REGIONAL=CO.[ID_REGIONAL]&#xA;  LEFT JOIN [PARAMETROS].[dbo].CIUDADES CD (NOLOCK) ON CD.ID_PAIS=DOC.ID_PAIS_DESTINO AND CD.ID_CIUDAD=DOC.ID_CIUDAD_DESTINO&#xA;  LEFT JOIN [PARAMETROS].[dbo].REGIONALES_PAIS RD (NOLOCK) ON RD.ID_PAIS=1 AND RD.ID_REGIONAL=CD.[ID_REGIONAL]&#xA;  LEFT JOIN [PARAMETROS].[dbo].[OPERATIVOS] O (NOLOCK) ON O.[ID_PAIS_ORIGEN]=DOC.ID_PAIS_OPERATIVO AND O.[ID_CIUDAD_ORIGEN]=DOC.ID_CIUDAD_OPERATIVO&#xA; AND O.[ID_OPERATIVO]=DOC.ID_OPERATIVO&#xA;  LEFT JOIN #TMP_CIUDADES_ANEXAS CAO (NOLOCK) ON CAO.ID_PAIS=1 AND CAO.[ID_CIUDAD_ANEXA]=CO.ID_CIUDAD --AND CAO.RECOLECCION=1&#xA;  LEFT JOIN PARAMETROS.DBO.CENTROS_LOGISTICOS CLO (NOLOCK) ON CLO.ID_PAIS=1 AND CLO.ID_CIUDAD=CAO.ID_CIUDAD AND CLO.ID_CENTRO_LOGISTICO=1 AND CLO.ID_ESTADO=1&#xA;  LEFT JOIN #TMP_CIUDADES_ANEXAS CAD (NOLOCK) ON CAD.ID_PAIS=1 AND CAD.[ID_CIUDAD_ANEXA]=CD.ID_CIUDAD --AND CAD.RECOLECCION=1&#xA;  LEFT JOIN PARAMETROS.DBO.CENTROS_LOGISTICOS CLD (NOLOCK) ON CLD.ID_PAIS=1 AND CLD.ID_CIUDAD=CAD.ID_CIUDAD AND CLD.ID_CENTRO_LOGISTICO=1 AND CLD.ID_ESTADO=1&#xA;LEFT JOIN #TMP_GUIAS_PENDIENTE_RECAUDO_SZU SZU ON SZU.NUMERO_GUIA=GPR.NUMERO_GUIA&#xA;LEFT JOIN #TMP_GUIAS_CON_TAREAS TAR ON TAR.NUMERO_GUIA=GPR.NUMERO_GUIA&#xA;--WHERE &#xA;--NUMERO_GUIA=2273736466&#xA;--ID_PROCESO=32&#xA;&#xA;--DELETE CPR FROM #TMP_GUIAS_PENDIENTE_RECAUDO CPR &#xA;--WHERE&#xA;--NOT EXISTS (SELECT TOP 1 SE.NUMERO_GUIA FROM Mece_Logistico.DBO.SEGUIMIENTO_ENVIO SE (NOLOCK) WHERE SE.NUMERO_GUIA=CPR.NUMERO_GUIA AND SE.ID_PROCESO&gt;=5 AND  SE.ID_PROCESO&lt;27)&#xA;&#xA;&#xA;&#xA;--select  COUNT(1) from #TMP_GUIAS_PENDIENTE_RECAUDO&#xA;--select  COUNT(1) from ##TMP_GUIAS_PENDIENTE_RECAUDO_FINAL_PBI&#xA;&#xA;----select  * from ##TMP_GUIAS_PENDIENTE_RECAUDO_FINAL_PBI&#xA;&#xA;&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="0"
                SQLTask:DtsVariableName="User::STR_FechaIni_REPOBLAR"
                SQLTask:ParameterDirection="Input"
                SQLTask:DataType="129"
                SQLTask:ParameterSize="-1" />
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="1"
                SQLTask:DtsVariableName="User::STR_FechaFin"
                SQLTask:ParameterDirection="Input"
                SQLTask:DataType="129"
                SQLTask:ParameterSize="-1" />
            </SQLTask:SqlTaskData>
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Tareas Backap\BK20260427 Prepatacion data Recudo LPC COD REPOBLAR"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{7c9d503e-56dd-4491-812b-de157511b6c9}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="BK20260427 Prepatacion data Recudo LPC COD REPOBLAR"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="5">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{20AF370D-4C8E-4E05-91E7-8F81200FAADC}"
              SQLTask:SqlStatementSource="&#xA;IF OBJECT_ID('tempdb..#COD_PENDIENTE_POR_RECAUDO') IS NOT NULL &#xA;    DROP TABLE #COD_PENDIENTE_POR_RECAUDO&#xA;&#xA;IF OBJECT_ID('tempdb..#TMP_GUIAS_PENDIENTE_RECAUDO') IS NOT NULL &#xA;    DROP TABLE #TMP_GUIAS_PENDIENTE_RECAUDO&#xA;&#xA;CREATE TABLE #TMP_GUIAS_PENDIENTE_RECAUDO(&#xA; NUMERO_GUIA numeric(20, 0) NOT NULL,&#xA; ID_ESTADOENVIO smallint DEFAULT 0,&#xA; NOMBRE_ESTADOENVIO varchar(40) DEFAULT '',&#xA; FORMA_PAGO varchar(40) DEFAULT '',&#xA; VALOR_A_RECAUDAR numeric(12, 2) NULL,&#xA; ID_REMITE [varchar](40) DEFAULT '',&#xA; NOMBRE_REMITE_GUIA  [varchar](200) DEFAULT '',&#xA; -- ID_CIUDAD INT DEFAULT 0,&#xA; -- [NOMBRE_CIUDAD] [varchar](50) DEFAULT '',&#xA; FECHA_ENVIO datetime NULL,&#xA; [VALOR_RECAUDADO] [numeric](11, 2) DEFAULT 0,&#xA; FECHA_RECAUDO datetime NULL,&#xA; NUMERO_ORDEN_SERVICIO varchar(20) DEFAULT '',&#xA; FECHA_RECAUDO_EFECTY datetime NULL,&#xA; ESTADO_ENTREGA varchar(70) DEFAULT 'A TIEMPO',--A TIEMPO O VENCIDO&#xA; --NOMBRE_RESPONSABLE_ULT_MOV VARCHAR(100) DEFAULT '',&#xA; ID_PROCESO_ULT_MOV int DEFAULT 0,&#xA; NOMBRE_PROCESO_ULT_MOV varchar(70) DEFAULT '',&#xA; ID_CONCEPTO_ULT_MOV int DEFAULT 0,&#xA; NOMBRE_CONCEPTO_ULT_MOV varchar(70) DEFAULT '',&#xA; NUMERO_MOVIMI_ULT_MOV char(30) DEFAULT '',&#xA; CONSECUT_MOVIMI_ULT_MOV numeric(7, 0) DEFAULT 0,&#xA; FECHA_HORA_MOVIMI_ULT_MOV datetime NULL,&#xA; ID_PAIS_ZONA_URBA_ULT_MOV SMALLINT NULL,&#xA; ID_CIUDAD_ZONA_URBA_ULT_MOV INT NULL,&#xA; ID_TIPO_ZONA_URBA_ULT_MOV SMALLINT NULL,&#xA; ID_ZONA_URBA_ULT_MOV SMALLINT NULL,&#xA; NOMBRE_CDS_ULT_MOV varchar(100) DEFAULT '',&#xA; TIPO_CANAL_ULT_MOV varchar(40) DEFAULT '',&#xA; ID_CONDUCTOR_ULT_MOV varchar(40) DEFAULT '',&#xA; CONDUCTOR_ULT_MOV  varchar(200) DEFAULT '',&#xA; ID_AUXILIAR_ULT_MOV varchar(40) DEFAULT '',&#xA; AUXILIAR_ULT_MOV varchar(200) DEFAULT '',&#xA; ID_CLIENTE [char](20) NOT NULL,&#xA; NOMBRE_TIPO_CANAL varchar(100) DEFAULT '',&#xA; NOMBRE_CLASE_TIPO_CANAL varchar(100) DEFAULT '',&#xA; [G_ID_CIUDAD_ORIGEN] [int] NULL,&#xA; [G_ID_CIUDAD_DESTINO] [int] NULL&#xA;) ON [PRIMARY]&#xA;CREATE NONCLUSTERED INDEX [IX_NUMERO_GUIA] ON #TMP_GUIAS_PENDIENTE_RECAUDO ([NUMERO_GUIA] ASC)&#xA;CREATE NONCLUSTERED INDEX [IX_ZONA] ON #TMP_GUIAS_PENDIENTE_RECAUDO (ID_PAIS_ZONA_URBA_ULT_MOV,ID_CIUDAD_ZONA_URBA_ULT_MOV, ID_TIPO_ZONA_URBA_ULT_MOV,ID_ZONA_URBA_ULT_MOV ASC)&#xA;CREATE NONCLUSTERED INDEX [IX_MANIFIESTO] ON #TMP_GUIAS_PENDIENTE_RECAUDO (ID_PROCESO_ULT_MOV,NUMERO_MOVIMI_ULT_MOV,CONSECUT_MOVIMI_ULT_MOV ASC)&#xA;&#xA;&#xA;IF OBJECT_ID('tempdb..#TMP_CIUDADES_ANEXAS') IS NOT NULL &#xA;    DROP TABLE #TMP_CIUDADES_ANEXAS&#xA;&#xA;---CIUDADES ANEXAS&#xA;SELECT CAD.* &#xA;INTO #TMP_CIUDADES_ANEXAS FROM PARAMETROS.DBO.CIUDADES_ANEXAS CAD (NOLOCK) &#xA;WHERE CAD.ID_PAIS=1 AND CAD.RECOLECCION=1&#xA;&#xA;INSERT INTO #TMP_CIUDADES_ANEXAS&#xA;SELECT CAD.* FROM PARAMETROS.DBO.CIUDADES_ANEXAS CAD (NOLOCK) &#xA;LEFT JOIN #TMP_CIUDADES_ANEXAS TCAD ON TCAD.ID_CIUDAD_ANEXA=CAD.ID_CIUDAD_ANEXA&#xA;WHERE CAD.ID_PAIS=1 AND CAD.RECOLECCION=0 AND TCAD.ID_CIUDAD_ANEXA IS NULL&#xA;&#xA;DELETE T FROM (SELECT *, &#xA;    DupRank = ROW_NUMBER() OVER (PARTITION BY ID_CIUDAD_ANEXA ORDER BY FECHA_CREACION DESC) &#xA;     FROM #TMP_CIUDADES_ANEXAS) AS T&#xA;WHERE DupRank &gt; 1&#xA;&#xA;&#xA;&#xA;SELECT CPR.*&#xA;,G.ID_CLIENTE,G.ID_REMITE,G.NOMBRE_REMITE_GUIA&#xA;,G.ID_PRODUCTO AS ID_PRODUCTO_GUIA&#xA;,G.ID_ESTADOENVIO&#xA;,G.ID_ESTADOGUIA&#xA;,ISNULL(G.VALOR_SEG_MAN_GUIAS,0)+ISNULL(G.VALOR_FLETES_GUIAS,0) AS VALOR_ENVIO_GUIA&#xA;,ISNULL(GIA.VALOR_RECAUDAR_PRODUCTO,0) AS VALOR_RECAUDAR_PRODUCTO_GUIA&#xA;,CAST('' AS nvarchar(50)) AS NOMBRE_ESTADOENVIO,G.FECHA_ENVIO&#xA;,TCAN.NOMBRE_TIPO_CANAL&#xA;,CTCAN.NOMBRE_CLASE_TIPO_CANAL&#xA;,G.[ID_CIUDAD_ORIGEN]   AS G_ID_CIUDAD_ORIGEN&#xA;,G.[ID_CIUDAD_DESTINO]   AS G_ID_CIUDAD_DESTINO&#xA;INTO #COD_PENDIENTE_POR_RECAUDO&#xA;FROM [Mece_Logistico].[dbo].[COD_PENDIENTE_POR_RECAUDO] CPR (NOLOCK)&#xA;INNER JOIN [Mece_Logistico].[dbo].[GUIAS] G (nolock) ON G.NUMERO_GUIA=CPR.NUMERO_GUIA&#xA;LEFT JOIN [Mece_Logistico].[dbo].[GUIAS_INF_ADICIONAL] GIA (nolock) ON GIA.NUMERO_GUIA=CPR.NUMERO_GUIA&#xA;LEFT JOIN [tmp_borrar_local].dbo.LPC_GUIAS_SOLUCIONADAS LGS (NOLOCK) ON LGS.NUMERO_GUIA=CPR.NUMERO_GUIA&#xA;LEFT JOIN [Mece_Logistico].[dbo].[CANALES] CAN (NOLOCK) ON CAN.id_pais=G.ID_1 and CAN.id_ciudad=G.ID_2 and CAN.[ID_DIVISION]=G.ID_CANAL&#xA;LEFT JOIN [Mece_Logistico].[dbo].[TIPOS_CANAL] TCAN (NOLOCK) ON TCAN.ID_TIPO_CANAL=CAN.ID_TIPO_CANAL AND TCAN.ID_EST_TIPO_CANAL=1&#xA;LEFT JOIN PARAMETROS.[dbo].[CLASE_TIPO_CANAL] CTCAN (NOLOCK) ON CTCAN.ID_CLASE_TIPO_CANAL=TCAN.CLASE_TIPO_CANAL&#xA;WHERE LGS.NUMERO_GUIA IS NULL &#xA;/*AND ISNULL(CPR.ESTADO_COD,1)=1-- RECAUDO ESTA ACTIVO*/---&gt;(se descarta por solicitud de luis gabriel rodriguez y Holman Salamanca el dia 2026-04-09 11:44am )&#xA;AND ISNULL(CPR.ESTA_RECAUDADO,0)=0 -- NO ESTA RECAUDADO&#xA;--AND G.ID_ESTADOGUIA!=4-- NO ESTA ANULADA&#xA;AND ISNULL(CPR.NUMERO_ORDEN_SERVICIO,'')='' -- NO TIENE ORDEN DE RECAUDO DE EFECTY&#xA;AND ISNULL(CPR.ESTA_ANULADO,0)=0 -- NO DEBE ESTAR ANULADA&#xA;AND G.ID_DIVISION_PROV IS NULL&#xA;--AND CPR.FECHA_CREACION &gt;= @FECHA_INI &#xA;--AND CPR.FECHA_CREACION &lt; @FECHA_FIN&#xA;AND CPR.FECHA_CREACION BETWEEN convert(datetime,?) AND convert(datetime,?)&#xA;/*&#xA;AND CPR.FECHA_CREACION BETWEEN convert(datetime,'20251201') &#xA;       AND convert(datetime,'20260201')&#xA;*/&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;/*&#xA;select G.NUMERO_GUIA&#xA;,TCAN.NOMBRE_TIPO_CANAL&#xA;,CTCAN.NOMBRE_CLASE_TIPO_CANAL&#xA;from Mece_Logistico.dbo.guias G (nolock)&#xA;left JOIN [Mece_Logistico].[dbo].[CANALES] CAN (NOLOCK) ON CAN.id_pais=G.ID_1 and CAN.id_ciudad=G.ID_2 and CAN.[ID_DIVISION]=G.ID_CANAL&#xA;left JOIN [Mece_Logistico].[dbo].[TIPOS_CANAL] TCAN (NOLOCK) ON TCAN.ID_TIPO_CANAL=CAN.ID_TIPO_CANAL AND TCAN.ID_EST_TIPO_CANAL=1&#xA;left JOIN PARAMETROS.[dbo].[CLASE_TIPO_CANAL] CTCAN (NOLOCK) ON CTCAN.ID_CLASE_TIPO_CANAL=TCAN.CLASE_TIPO_CANAL&#xA;where G.ID_CANAL IS NOT NULL&#xA;AND FECHA_ENVIO&gt;='20260120 00:00:00'&#xA;*/&#xA;&#xA;CREATE NONCLUSTERED INDEX [IX_NUMERO_GUIA] ON #COD_PENDIENTE_POR_RECAUDO ([NUMERO_GUIA] ASC)&#xA;&#xA;&#xA;--Se quitan envios siniestrados&#xA;DELETE GPR FROM #COD_PENDIENTE_POR_RECAUDO GPR&#xA;WHERE ID_ESTADOENVIO in(5,4)&#xA;&#xA;--Quita las guias son del canal retail y no son COD y no contraentrega ecommerce&#xA;DELETE GPR FROM #COD_PENDIENTE_POR_RECAUDO GPR&#xA;WHERE ID_FORMA_PAGO=1 AND ISNULL(ID_PRODUCTO_GUIA,999) !=86&#xA;--WHERE ID_FORMA_PAGO=1 AND ISNULL(ID_PRODUCTO,999) !=86&#xA;&#xA;&#xA;--Quita las guias CREDICONTADO (Solicitud de luis gabriel rodriguez y Holman Salamanca el dia 2026-04-09 11:44am )&#xA;/*&#xA;&#xA;ID_FORMAPAGO NOMBRE_FORMAPAGO&#xA;1 CONTADO&#xA;2 CREDITO&#xA;3 PREPAGO DIGITAL&#xA;4 C.O.D. &#xA;5 CHEQUE&#xA;6 TARJETAS FINANCIERAS&#xA;7 CREDI CONTADO&#xA;9 QR&#xA;10 TARJETA&#xA;*/&#xA;DELETE GPR FROM #COD_PENDIENTE_POR_RECAUDO GPR&#xA;WHERE ID_FORMA_PAGO=7&#xA;&#xA;/*&#xA;--&gt;credicontado --9175427260&#xA;--&gt;contado --9177482665&#xA;SELECT * FROM [Mece_Logistico].[dbo].[COD_PENDIENTE_POR_RECAUDO] CPR (NOLOCK)&#xA;WHERE ID_FORMA_PAGO=7&#xA;AND NUMERO_GUIA=9177482665&#xA;*/&#xA;&#xA;--SELECT * FROM #COD_PENDIENTE_POR_RECAUDO CPR (NOLOCK)&#xA;--WHERE --NUMERO_GUIA=2143658629&#xA;--ID_PRODUCTO=86&#xA;--INSERT INTO #TMP_GUIAS_PENDIENTE_RECAUDO&#xA;&#xA;UPDATE CPR SET CPR.NOMBRE_ESTADOENVIO=E.NOMBRE_ESTADOENVIO&#xA;FROM #COD_PENDIENTE_POR_RECAUDO CPR&#xA;INNER JOIN PARAMETROS.DBO.ESTADOSENVIO E (NOLOCK)ON E.ID_ESTADOENVIO=CPR.ID_ESTADOENVIO&#xA;&#xA;--TRUNCATE TABLE #TMP_GUIAS_PENDIENTE_RECAUDO&#xA;INSERT INTO #TMP_GUIAS_PENDIENTE_RECAUDO(&#xA;NUMERO_GUIA,&#xA;ID_ESTADOENVIO,&#xA;NOMBRE_ESTADOENVIO,&#xA;FORMA_PAGO,&#xA;VALOR_A_RECAUDAR,&#xA;ID_REMITE,&#xA;NOMBRE_REMITE_GUIA,&#xA;FECHA_ENVIO,&#xA;VALOR_RECAUDADO,&#xA;FECHA_RECAUDO,&#xA;NUMERO_ORDEN_SERVICIO,&#xA;FECHA_RECAUDO_EFECTY,&#xA;ID_CLIENTE,&#xA;NOMBRE_TIPO_CANAL,&#xA;NOMBRE_CLASE_TIPO_CANAL,&#xA;G_ID_CIUDAD_ORIGEN,&#xA;G_ID_CIUDAD_DESTINO&#xA;)&#xA;SELECT CPR.NUMERO_GUIA,CPR.ID_ESTADOENVIO,CPR.NOMBRE_ESTADOENVIO,&#xA;CASE WHEN CPR.ID_FORMA_PAGO=4 AND CPR.ID_CLIENTE IS NULL THEN 'C.O.D.' WHEN ISNULL(CPR.ID_PRODUCTO,CPR.ID_PRODUCTO_GUIA)=86 THEN 'CONTRAENTREGA ECOMMERCE' WHEN (CPR.ID_FORMA_PAGO=2 OR CPR.ID_CLIENTE IS NOT NULL) THEN 'LPC' ELSE '' END AS FORMA_PAGO,&#xA;CASE WHEN ISNULL(CPR.VALOR_TOTAL,0)!=0 THEN CPR.VALOR_TOTAL&#xA;WHEN CPR.ID_FORMA_PAGO=4 AND VALOR_FLETE IS NOT NULL THEN ISNULL(CPR.VALOR_FLETE,0) + ISNULL(CPR.VALOR_OTROS,0)&#xA;WHEN CPR.ID_FORMA_PAGO=4 AND VALOR_FLETE IS NULL THEN ISNULL(CPR.VALOR_ENVIO_GUIA,0)&#xA;WHEN ISNULL(CPR.ID_PRODUCTO,CPR.ID_PRODUCTO_GUIA)=86 THEN ISNULL(CPR.VALOR_DECLARADO,CPR.VALOR_PRODUCTO)&#xA;WHEN (CPR.ID_FORMA_PAGO=2 OR CPR.ID_CLIENTE IS NOT NULL) THEN ISNULL(CPR.VALOR_DECLARADO,CPR.VALOR_PRODUCTO) ELSE 0 END AS VALOR_A_RECAUDAR&#xA;,CPR.ID_REMITE&#xA;,CPR.NOMBRE_REMITE_GUIA&#xA;,CPR.FECHA_ENVIO&#xA;,ISNULL(CPR.VALOR_RECAUDADO,0)&#xA;,CPR.FECHA_RECAUDO&#xA;,ISNULL(CPR.NUMERO_ORDEN_SERVICIO,0)&#xA;,CPR.FECHA_RECAUDO_EFECTY&#xA;,isnull(CPR.ID_CLIENTE,'0') ID_CLIENTE&#xA;,CPR.NOMBRE_TIPO_CANAL&#xA;,CPR.NOMBRE_CLASE_TIPO_CANAL&#xA;,G_ID_CIUDAD_ORIGEN&#xA;,G_ID_CIUDAD_DESTINO&#xA;--,CPR.VALOR_TOTAL&#xA;--INTO #TMP_GUIAS_PENDIENTE_RECAUDO_1&#xA;FROM #COD_PENDIENTE_POR_RECAUDO CPR (NOLOCK)&#xA;WHERE LEN(CPR.NUMERO_GUIA)&gt;7&#xA;--INNER JOIN [Mece_Logistico].[dbo].[GUIAS] G (nolock) ON G.NUMERO_GUIA=CPR.NUMERO_GUIA&#xA;&#xA;--CREATE NONCLUSTERED INDEX [IX_NUMERO_GUIA] ON #TMP_GUIAS_PENDIENTE_RECAUDO_1 ([NUMERO_GUIA] ASC)&#xA;&#xA;--select GPR.* from #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA;&#xA;&#xA;UPDATE GPR SET&#xA; --GPR.NOMBRE_RESPONSABLE_ULT_MOV='SERVIENTREGA S.A.'&#xA; GPR.ID_PROCESO_ULT_MOV=SE.ID_PROCESO&#xA; ,GPR.NOMBRE_PROCESO_ULT_MOV=PRO.NOMBRE_PROCESO_LOG&#xA; ,GPR.ID_CONCEPTO_ULT_MOV=ISNULL(SE.ID_CONCEPTO,0)&#xA; ,GPR.NOMBRE_CONCEPTO_ULT_MOV=ISNULL(ICON.NOMBRE_CONCEPTO,'')&#xA; ,GPR.NUMERO_MOVIMI_ULT_MOV=SE.NUMERO_MOVIMI&#xA; ,GPR.CONSECUT_MOVIMI_ULT_MOV=SE.CONSECUT_MOVIMI&#xA; ,GPR.FECHA_HORA_MOVIMI_ULT_MOV=SE.FECHA_HORA_MOVIMIENTO&#xA; --,GPR.ID_CONDUCTOR_ULT_MOV=DOC.ID_COURIER_CONDUCTOR&#xA; --,GPR.ID_AUXILIAR_ULT_MOV=DOC.ID_AUXILIAR1_VEHICULO&#xA; --,GPR.ID_PAIS_ZONA_URBA_ULT_MOV=DOC.ID_PAIS_ZONA_URBA  &#xA; --,GPR.ID_CIUDAD_ZONA_URBA_ULT_MOV=DOC.ID_CIUDAD_ZONA_URBA &#xA; --,GPR.ID_TIPO_ZONA_URBA_ULT_MOV=DOC.ID_TIPO_ZONA_URBA&#xA; --,GPR.ID_ZONA_URBA_ULT_MOV=DOC.ID_ZONA_URBA&#xA; FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; INNER JOIN MECE_LOGISTICO.dbo.SEGUIMIENTO_ENVIO SE WITH(NOLOCK) on se.NUMERO_GUIA=GPR.NUMERO_GUIA&#xA; --INNER JOIN MECE_LOGISTICO.dbo.DOCUMENTOS DOC (NOLOCK) ON&#xA; --DOC.ID_PROCESO=GPR.[ID_PROCESO_ULT_MOV] AND DOC.NUMERO_MOVIMI=GPR.[NUMERO_MOVIMI_ULT_MOV] AND DOC.CONSECUT_MOVIMI=GPR.[CONSECUT_MOVIMI_ULT_MOV]&#xA; INNER JOIN PARAMETROS.DBO.PROCESOS PRO (NOLOCK) ON PRO.ID_PROCESO=SE.ID_PROCESO&#xA; LEFT JOIN PARAMETROS.DBO.ITEM_CONCEPTO ICON (NOLOCK) ON ICON.ID_PAIS=1 AND ICON.ID_PROCESO=SE.ID_PROCESO AND ICON.ID_CONCEPTO=SE.ID_CONCEPTO&#xA; WHERE se.FECHA_HORA_MOVIMIENTO= (select MAX(se1.FECHA_HORA_MOVIMIENTO) from MECE_LOGISTICO.dbo.SEGUIMIENTO_ENVIO SE1 WITH(NOLOCK)&#xA;          where SE1.numero_guia=GPR.NUMERO_GUIA)&#xA; &#xA; UPDATE GPR SET&#xA; GPR.ID_CONDUCTOR_ULT_MOV=DOC.ID_COURIER_CONDUCTOR&#xA; ,GPR.ID_AUXILIAR_ULT_MOV=DOC.ID_AUXILIAR1_VEHICULO&#xA; ,GPR.ID_PAIS_ZONA_URBA_ULT_MOV=DOC.ID_PAIS_ZONA_URBA  &#xA; ,GPR.ID_CIUDAD_ZONA_URBA_ULT_MOV=DOC.ID_CIUDAD_ZONA_URBA &#xA; ,GPR.ID_TIPO_ZONA_URBA_ULT_MOV=DOC.ID_TIPO_ZONA_URBA&#xA; ,GPR.ID_ZONA_URBA_ULT_MOV=DOC.ID_ZONA_URBA&#xA; FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; INNER JOIN MECE_LOGISTICO.DBO.DOCUMENTOS DOC (NOLOCK) ON&#xA; DOC.ID_PROCESO=GPR.[ID_PROCESO_ULT_MOV] AND DOC.NUMERO_MOVIMI=GPR.[NUMERO_MOVIMI_ULT_MOV] AND DOC.CONSECUT_MOVIMI=GPR.[CONSECUT_MOVIMI_ULT_MOV]&#xA;&#xA; --SELECT GPR.ID_CONDUCTOR_ULT_MOV&#xA; &#xA; UPDATE GPR SET&#xA; GPR.ID_CONDUCTOR_ULT_MOV=ISNULL(RTRIM(LTRIM(EC.ID_EMPLEADO)),'')&#xA; ,GPR.CONDUCTOR_ULT_MOV =ISNULL(RTRIM(LTRIM(EC.NOMBRE_EMPLEADO)) +' '+ RTRIM(LTRIM(EC.APELLIDO_EMPLEADO)),'') &#xA; ,GPR.ID_AUXILIAR_ULT_MOV=ISNULL(RTRIM(LTRIM(EA.ID_EMPLEADO)),'')&#xA; ,GPR.AUXILIAR_ULT_MOV=ISNULL(RTRIM(LTRIM(EA.NOMBRE_EMPLEADO)) +' '+ RTRIM(LTRIM(EA.APELLIDO_EMPLEADO)),'') &#xA; FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; LEFT JOIN PARAMETROS.DBO.EMPLEADOS EC (NOLOCK) ON EC.ID_EMPLEADO=GPR.ID_CONDUCTOR_ULT_MOV&#xA; LEFT JOIN PARAMETROS.DBO.EMPLEADOS EA (NOLOCK) ON EA.ID_EMPLEADO=GPR.ID_AUXILIAR_ULT_MOV&#xA;&#xA;&#xA; --SELECT GPR.NUMERO_GUIA,ISNULL(DIV.NOMBRE_DIVISION,'') AS NOMBRE_CDS, ISNULL(CTCAN.[NOMBRE_CLASE_TIPO_CANAL],'') as TIPO_CANAL&#xA;UPDATE GPR SET NOMBRE_CDS_ULT_MOV=ISNULL(DIV.NOMBRE_DIVISION,''),&#xA; TIPO_CANAL_ULT_MOV=ISNULL(CTCAN.[NOMBRE_CLASE_TIPO_CANAL],'')&#xA; FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; --INNER JOIN MECE_LOGISTICO.DBO.DOCUMENTOS DOC (NOLOCK) ON&#xA; --DOC.ID_PROCESO=GPR.[ID_PROCESO_ULT_MOV] AND DOC.NUMERO_MOVIMI=GPR.[NUMERO_MOVIMI_ULT_MOV] AND DOC.CONSECUT_MOVIMI=GPR.[CONSECUT_MOVIMI_ULT_MOV]&#xA; INNER JOIN PARAMETROS.DBO.ZONASURBANAS Z (NOLOCK) &#xA; ON Z.ID_PAIS = GPR.ID_PAIS_ZONA_URBA_ULT_MOV AND Z.ID_CIUDAD = GPR.ID_CIUDAD_ZONA_URBA_ULT_MOV &#xA;  AND Z.ID_TIPO_ZONA_URBA = GPR.ID_TIPO_ZONA_URBA_ULT_MOV AND Z.ID_ZONA_URBA = GPR.ID_ZONA_URBA_ULT_MOV --AND Z.CATEGORIA_ZONA_URBA = 8 --CLICOH&#xA; INNER JOIN PARAMETROS.DBO.DIVISIONES DIV (NOLOCK) ON DIV.ID_PAIS = Z.ID_PAIS_CANAL AND DIV.ID_CIUDAD = Z.ID_CIUDAD_CANAL AND DIV.ID_DIVISION = Z.ID_CANAL&#xA; INNER JOIN [Mece_Logistico].[dbo].[CANALES] CAN (NOLOCK) ON CAN.id_pais=DIV.ID_PAIS and CAN.id_ciudad=DIV.ID_CIUDAD and CAN.[ID_DIVISION]=DIV.ID_DIVISION&#xA; INNER JOIN [Mece_Logistico].[dbo].[TIPOS_CANAL] TCAN (NOLOCK) ON TCAN.ID_TIPO_CANAL=CAN.ID_TIPO_CANAL AND TCAN.ID_EST_TIPO_CANAL=1&#xA; INNER JOIN PARAMETROS.[dbo].[CLASE_TIPO_CANAL] CTCAN (NOLOCK) ON CTCAN.ID_CLASE_TIPO_CANAL=TCAN.CLASE_TIPO_CANAL&#xA;&#xA;&#xA; --UPDATE GPR SET ESTADO_ENTREGA='VENCIDO'&#xA; --SELECT * FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; UPDATE GPR SET ESTADO_ENTREGA='VENCIDO'&#xA; FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; WHERE GPR.ID_PROCESO_ULT_MOV=9 AND ID_CONCEPTO_ULT_MOV IN(9,7,2,4)--9 ENTREGAS OFIC  C.O.D. Y/O LPC EMPRESARIO --7 EMPRESARIO SATELITE ENTREGA EN OFICINA&#xA; --2 RECLAMO OFICINA Y 4 C.O.D RECLAMO OFICINA&#xA; AND DATEDIFF(DAY, FECHA_HORA_MOVIMI_ULT_MOV,GETDATE())&gt;8 -- MAS DE 8 DIAS&#xA; &#xA; UPDATE GPR SET ESTADO_ENTREGA='VENCIDO'&#xA; FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; WHERE GPR.ID_PROCESO_ULT_MOV=31 --ENVIO PARA ENTREGA EN OFICINA&#xA; AND DATEDIFF(DAY, FECHA_HORA_MOVIMI_ULT_MOV,GETDATE())&gt;8 -- MAS DE 8 DIAS&#xA;&#xA; UPDATE GPR SET ESTADO_ENTREGA='VENCIDO'&#xA; FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; WHERE GPR.ID_PROCESO_ULT_MOV=9 AND ID_CONCEPTO_ULT_MOV IN(10,8) --10 ENTR A DOMICI  LPC / COD EMPRESARIOS SAT --8 EMPRESARIO SATELITE ENTREGA EN DOMICILIO&#xA; AND DATEDIFF(DAY, FECHA_HORA_MOVIMI_ULT_MOV,GETDATE())&gt;3-- MAS DE 3 DIAS&#xA; &#xA; UPDATE GPR SET ESTADO_ENTREGA='VENCIDO'&#xA; FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; WHERE GPR.ID_PROCESO_ULT_MOV=32 --ENVIO PARA ENTREGA A DOMICILIO&#xA; AND DATEDIFF(DAY, FECHA_HORA_MOVIMI_ULT_MOV,GETDATE())&gt;3-- MAS DE 3 DIAS&#xA;&#xA; UPDATE GPR SET ESTADO_ENTREGA='VENCIDO'&#xA; FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; WHERE GPR.ID_PROCESO_ULT_MOV=9 AND ID_CONCEPTO_ULT_MOV IN(1,3) --SALIDA A ZONA Y C.O.D EN DISTRIBUCION&#xA; AND DATEDIFF(DAY, FECHA_HORA_MOVIMI_ULT_MOV,GETDATE())&gt;1 --MAS DE UN DIA&#xA;&#xA;&#xA;&#xA;DROP TABLE IF EXISTS #TMP_GUIAS_PENDIENTE_RECAUDO_SZU&#xA; SELECT &#xA; TMP.NUMERO_GUIA&#xA; ,(SE.CONSECUT_MOVIMI)   AS CONSECUT_MOVIMI_SZU&#xA; ,(SE.NUMERO_MOVIMI)    AS NUMERO_MOVIMI_SZU&#xA; ,(SE.FECHA_HORA_MOVIMIENTO)  AS FECHA_HORA_MOVIMI_ULT_MOV_SZU&#xA;INTO #TMP_GUIAS_PENDIENTE_RECAUDO_SZU&#xA;FROM #TMP_GUIAS_PENDIENTE_RECAUDO TMP&#xA;INNER JOIN Mece_Logistico..SEGUIMIENTO_ENVIO SE&#xA;ON SE.NUMERO_GUIA=TMP.NUMERO_GUIA&#xA;WHERE SE.ID_PROCESO=9&#xA;---GROUP BY  TMP.NUMERO_GUIA&#xA;&#xA;;WITH CTE AS(&#xA;SELECT &#xA;ROWID = ROW_NUMBER() OVER(PARTITION BY NUMERO_GUIA ORDER BY FECHA_HORA_MOVIMI_ULT_MOV_SZU DESC)&#xA;,NUMERO_GUIA,FECHA_HORA_MOVIMI_ULT_MOV_SZU&#xA;FROM #TMP_GUIAS_PENDIENTE_RECAUDO_SZU&#xA;)&#xA;DELETE CTE WHERE ROWID&gt;1&#xA;&#xA;&#xA;&#xA;--SELECT * FROM #TMP_GUIAS_PENDIENTE_RECAUDO TMP&#xA;&#xA;&#xA;&#xA;DROP TABLE IF EXISTS #TMP_GUIAS_CON_TAREAS &#xA; SELECT &#xA; TMP.NUMERO_GUIA,&#xA; COUNT(TAR.NUMERO_DOCPROBLEMA) AS NUMERO_TAREAS&#xA;INTO #TMP_GUIAS_CON_TAREAS&#xA;FROM #TMP_GUIAS_PENDIENTE_RECAUDO TMP&#xA;INNER JOIN Mece_Logistico..TAREAS TAR WITH(NOLOCK)&#xA;ON TAR.NUMERO_DOCPROBLEMA=CONVERT(CHAR(20),TMP.NUMERO_GUIA)&#xA;GROUP BY TMP.NUMERO_GUIA&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;DROP TABLE IF EXISTS ##TMP_GUIAS_PENDIENTE_RECAUDO_FINAL_PBI;&#xA;SELECT --GPR.*&#xA;GPR.NUMERO_GUIA &#xA;--GPR.ID_ESTADOENVIO &#xA;,GPR.NOMBRE_ESTADOENVIO &#xA;,GPR.FORMA_PAGO &#xA;,GPR.VALOR_A_RECAUDAR &#xA;,GPR.ID_REMITE &#xA;,GPR.NOMBRE_REMITE_GUIA &#xA;,GPR.FECHA_ENVIO&#xA;,GPR.VALOR_RECAUDADO&#xA;,GPR.FECHA_RECAUDO&#xA;,GPR.NUMERO_ORDEN_SERVICIO&#xA;,GPR.FECHA_RECAUDO_EFECTY&#xA;,GPR.ESTADO_ENTREGA&#xA;--,GPR.NOMBRE_RESPONSABLE_ULT_MOV &#xA;--ID_PROCESO_ULT_MOV &#xA;--NOMBRE_PROCESO_ULT_MOV &#xA;--NUMERO_MOVIMI_ULT_MOV &#xA;--CONSECUT_MOVIMI_ULT_MOV &#xA;--FECHA_HORA_MOVIMI_ULT_MOV&#xA;&#xA;--,ISNULL(ISNULL(CLO.CENTRO_LOGISTICO,CLD.CENTRO_LOGISTICO),'')  AS CPL_ORIGEN_ULT_MOV&#xA;--,ISNULL(ISNULL(RO.NOMBRE_REGIONAL,RD.NOMBRE_REGIONAL),'')  AS REGIONAL_ORIGEN_ULT_MOV&#xA;--,ISNULL(ISNULL(CO.NOMBRE_CIUDAD,CD.NOMBRE_CIUDAD),'')  AS CIUDAD_ORIGEN_ULT_MOV&#xA;--,ISNULL(ISNULL(CLD.CENTRO_LOGISTICO,CLO.CENTRO_LOGISTICO),'') AS CPL_DESTINO_ULT_MOV&#xA;--,ISNULL(ISNULL(RD.NOMBRE_REGIONAL,RO.NOMBRE_REGIONAL),'') AS REGIONAL_DESTINO_ULT_MOV&#xA;--,ISNULL(ISNULL(CD.NOMBRE_CIUDAD,CO.NOMBRE_CIUDAD),'') AS CIUDAD_DESTINO_MOV&#xA;,CASE WHEN ID_PROCESO!=14 THEN &#xA;ISNULL(ISNULL(CLO.CENTRO_LOGISTICO,CLD.CENTRO_LOGISTICO),'')  ELSE ISNULL(ISNULL(CLD.CENTRO_LOGISTICO,CLO.CENTRO_LOGISTICO),'') END AS CPL_ULT_MOV&#xA;,CASE WHEN ID_PROCESO!=14 THEN &#xA;ISNULL(ISNULL(RO.NOMBRE_REGIONAL,RD.NOMBRE_REGIONAL),'') ELSE ISNULL(ISNULL(RD.NOMBRE_REGIONAL,RO.NOMBRE_REGIONAL),'') END  AS REGIONAL_ULT_MOV&#xA;,CASE WHEN ID_PROCESO!=14 THEN &#xA;ISNULL(ISNULL(CO.NOMBRE_CIUDAD,CD.NOMBRE_CIUDAD),'')  ELSE ISNULL(ISNULL(CD.NOMBRE_CIUDAD,CO.NOMBRE_CIUDAD),'') END  AS CIUDAD_ULT_MOV&#xA;,ISNULL(CASE &#xA; WHEN ISNULL(DOC.ID_CIUDAD_ZONA_URBA,0) !=0 THEN&#xA; ROZ.NOMBRE_REGIONAL+' - '+ DCOZ.NOMBRE_DEPARTAMENTO +' - '+ COZ.NOMBRE_CIUDAD &#xA; WHEN  ISNULL(DOC.ID_CIUDAD_DIVISION_ORIGEN,0) !=0 AND DOC.ID_PROCESO!=14 THEN&#xA; ROM.NOMBRE_REGIONAL+' - '+ DCOM.NOMBRE_DEPARTAMENTO +' - '+ COM.NOMBRE_CIUDAD&#xA; ELSE&#xA; ROD.NOMBRE_REGIONAL+' - '+ DCOD.NOMBRE_DEPARTAMENTO +' - '+ COD.NOMBRE_CIUDAD &#xA; END,'') AS REG_DEPART_CIUDAD_ULTIMO_MOV&#xA;&#xA;,ISNULL(DOC.PLACA_VEHICULO_DOCU,'') as PLACA_VEHICULO_ULTIMO_MOV&#xA;,ISNULL(O.[NOMBRE_OPERATIVO],'') AS NOMBRE_OPERATIVO_ULTIMO_MOV&#xA;,ISNULL(Z.NOMBRE_ZONA_URBA,'') AS ZONA_URBANA_ULTIMO_MOV&#xA;,ISNULL(CZ.NOMBRE_CATEGORIA,'') AS CATEGORIA_ZONA_ULTIMO_MOV&#xA;,ISNULL(TZU.NOMBRE_TIPO_ZONA_URBA,'') AS TIPO_ZONA_ULTIMO_MOV&#xA;,ISNULL(GPR.NOMBRE_CDS_ULT_MOV,'') AS NOMBRE_CDS_ULT_MOV&#xA;,ISNULL(TIPO_CANAL_ULT_MOV,'') AS TIPO_CANAL_ULT_MOV&#xA;--,GR.ID_PROCESO &#xA;,ISNULL(GPR.NOMBRE_PROCESO_ULT_MOV,'') AS PROCESO_LOG_ULTIMO_MOV  &#xA;,ISNULL(GPR.NOMBRE_CONCEPTO_ULT_MOV,'') AS CONCEPTO_ULT_MOV&#xA;--,GR.ID_CONCEPTO  &#xA;--,GR.FECHA_HORA_MOVIMIENTO&#xA;,ISNULL(cast(GPR.ID_PROCESO_ULT_MOV as nvarchar) +' - '+ RTRIM(GPR.NOMBRE_PROCESO_ULT_MOV),'') AS NOMBRE_ULTIMO_MOV&#xA;,ISNULL(CASE WHEN DIO.ID_DIVISION IS NOT NULL THEN cast(DIO.ID_DIVISION as nvarchar) +' - '+ RTRIM(DIO.NOMBRE_DIVISION)&#xA;ELSE cast(DID.ID_DIVISION as nvarchar) +' - '+ RTRIM(DID.NOMBRE_DIVISION) END,'') AS BODEGA_ULTIMO_MOV&#xA;,ISNULL(cast(GPR.ID_PROCESO_ULT_MOV as nvarchar) +' - '+ RTRIM(GPR.[NUMERO_MOVIMI_ULT_MOV])+' - '+  cast(GPR.[CONSECUT_MOVIMI_ULT_MOV] as nvarchar),'') as ULTIMO_MOV_LOGISTICO&#xA;,ISNULL(CONVERT(nvarchar(20),GPR.FECHA_HORA_MOVIMI_ULT_MOV,120),'') AS FECHA_ULTIMO_MOV&#xA;,GPR.ID_CONDUCTOR_ULT_MOV&#xA;,GPR.CONDUCTOR_ULT_MOV&#xA;,GPR.ID_AUXILIAR_ULT_MOV&#xA;,GPR.AUXILIAR_ULT_MOV&#xA;,GPR.ID_CLIENTE&#xA;,SZU.CONSECUT_MOVIMI_SZU&#xA;,SZU.NUMERO_MOVIMI_SZU&#xA;,SZU.FECHA_HORA_MOVIMI_ULT_MOV_SZU&#xA;,GPR.NOMBRE_TIPO_CANAL&#xA;,GPR.NOMBRE_CLASE_TIPO_CANAL&#xA;,TAR.NUMERO_TAREAS&#xA;,G_ID_CIUDAD_ORIGEN&#xA;,G_ID_CIUDAD_DESTINO&#xA;--,DOC.*&#xA;INTO ##TMP_GUIAS_PENDIENTE_RECAUDO_FINAL_PBI&#xA;&#xA;FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA;--------------------------- CIUDAD ULTIMO MOV ZONA&#xA;  LEFT JOIN MECE_LOGISTICO.DBO.DOCUMENTOS DOC (NOLOCK) ON&#xA; DOC.ID_PROCESO=GPR.[ID_PROCESO_ULT_MOV] AND DOC.NUMERO_MOVIMI=GPR.[NUMERO_MOVIMI_ULT_MOV] AND DOC.CONSECUT_MOVIMI=GPR.[CONSECUT_MOVIMI_ULT_MOV]&#xA; --AND DOC.ID_DIVISION_DESTINO IN (9311, 9308, 9304, 9313, 9310, 9312, 9711, 9710)&#xA;  LEFT JOIN PARAMETROS.DBO.CIUDADES COZ (NOLOCK) ON  COZ.ID_PAIS=1 AND COZ.ID_CIUDAD=DOC.ID_CIUDAD_ZONA_URBA&#xA;  LEFT JOIN PARAMETROS.DBO.REGIONALES_PAIS ROZ (NOLOCK) ON  ROZ.ID_PAIS=COZ.ID_PAIS AND ROZ.ID_REGIONAL=COZ.ID_REGIONAL&#xA;  LEFT JOIN PARAMETROS.DBO.DEPARTAMENTOS DCOZ (NOLOCK) ON  DCOZ.ID_PAIS=COZ.ID_PAIS AND DCOZ.ID_DEPARTAMENTO=COZ.ID_DEPARTAMENTO&#xA;   LEFT JOIN PARAMETROS.DBO.ZONASURBANAS Z (NOLOCK) &#xA; ON Z.ID_PAIS = DOC.ID_PAIS_ZONA_URBA AND Z.ID_CIUDAD = DOC.ID_CIUDAD_ZONA_URBA AND Z.ID_TIPO_ZONA_URBA = DOC.ID_TIPO_ZONA_URBA AND Z.ID_ZONA_URBA = DOC.ID_ZONA_URBA --AND Z.CATEGORIA_ZONA_URBA = 8 --CLICOH&#xA;  LEFT JOIN [PARAMETROS].[dbo].[CATEGORIAZONASURBANAS] CZ (NOLOCK) ON CZ.Id_Categoria=Z.CATEGORIA_ZONA_URBA&#xA;  LEFT JOIN [PARAMETROS].[dbo].[TIPOSZONASURBANAS] TZU (NOLOCK) ON TZU.ID_TIPO_ZONA_URBA=Z.ID_TIPO_ZONA_URBA&#xA; --------------------------- CIUDAD ULTIMO MOV DOCUMENTO&#xA;  LEFT JOIN PARAMETROS.DBO.CIUDADES COM (NOLOCK) ON  COM.ID_PAIS=1 AND COM.ID_CIUDAD=DOC.ID_CIUDAD_DIVISION_ORIGEN&#xA;  LEFT JOIN PARAMETROS.DBO.REGIONALES_PAIS ROM (NOLOCK) ON  ROM.ID_PAIS=COM.ID_PAIS AND ROM.ID_REGIONAL=COM.ID_REGIONAL&#xA;  LEFT JOIN PARAMETROS.DBO.DEPARTAMENTOS DCOM (NOLOCK) ON  DCOM.ID_PAIS=COM.ID_PAIS AND DCOM.ID_DEPARTAMENTO=COM.ID_DEPARTAMENTO&#xA;  --------------------------- CIUDAD DESTINO ULTIMO MOV DOCUMENTO&#xA;  LEFT JOIN PARAMETROS.DBO.CIUDADES COD(NOLOCK) ON  COD.ID_PAIS=1 AND COD.ID_CIUDAD=DOC.ID_CIUDAD_DESTINO&#xA;  LEFT JOIN PARAMETROS.DBO.REGIONALES_PAIS ROD (NOLOCK) ON  ROD.ID_PAIS=COD.ID_PAIS AND ROD.ID_REGIONAL=COD.ID_REGIONAL&#xA;  LEFT JOIN PARAMETROS.DBO.DEPARTAMENTOS DCOD (NOLOCK) ON  DCOD.ID_PAIS=COD.ID_PAIS AND DCOD.ID_DEPARTAMENTO=COD.ID_DEPARTAMENTO&#xA;  --------------------------- DIVISION ORIGEN ULTIMO MOV DOCUMENTO&#xA;  LEFT JOIN PARAMETROS.DBO.DIVISIONES DIO(NOLOCK) ON DIO.ID_PAIS=DOC.ID_PAIS_DIVISION_ORIGEN&#xA; AND DIO.ID_CIUDAD=DOC.ID_CIUDAD_DIVISION_ORIGEN AND DIO.ID_DIVISION=DOC.ID_DIVISION_ORIGEN&#xA;  --------------------------- DIVISION DESTINO ULTIMO MOV DOCUMENTO&#xA;  LEFT JOIN PARAMETROS.DBO.DIVISIONES DID(NOLOCK) ON DID.ID_PAIS=DOC.ID_PAIS_DESTINO&#xA; AND DID.ID_CIUDAD=DOC.ID_CIUDAD_DESTINO AND DID.ID_DIVISION=DOC.ID_DIVISION_DESTINO&#xA;-------------------------------------------------------------&#xA;  LEFT JOIN [PARAMETROS].[dbo].CIUDADES CO (NOLOCK) ON CO.ID_PAIS=ID_PAIS_DIVISION_ORIGEN AND CO.ID_CIUDAD=DOC.ID_CIUDAD_DIVISION_ORIGEN&#xA;  LEFT JOIN [PARAMETROS].[dbo].REGIONALES_PAIS RO (NOLOCK) ON RO.ID_PAIS=1 AND RO.ID_REGIONAL=CO.[ID_REGIONAL]&#xA;  LEFT JOIN [PARAMETROS].[dbo].CIUDADES CD (NOLOCK) ON CD.ID_PAIS=DOC.ID_PAIS_DESTINO AND CD.ID_CIUDAD=DOC.ID_CIUDAD_DESTINO&#xA;  LEFT JOIN [PARAMETROS].[dbo].REGIONALES_PAIS RD (NOLOCK) ON RD.ID_PAIS=1 AND RD.ID_REGIONAL=CD.[ID_REGIONAL]&#xA;  LEFT JOIN [PARAMETROS].[dbo].[OPERATIVOS] O (NOLOCK) ON O.[ID_PAIS_ORIGEN]=DOC.ID_PAIS_OPERATIVO AND O.[ID_CIUDAD_ORIGEN]=DOC.ID_CIUDAD_OPERATIVO&#xA; AND O.[ID_OPERATIVO]=DOC.ID_OPERATIVO&#xA;  LEFT JOIN #TMP_CIUDADES_ANEXAS CAO (NOLOCK) ON CAO.ID_PAIS=1 AND CAO.[ID_CIUDAD_ANEXA]=CO.ID_CIUDAD --AND CAO.RECOLECCION=1&#xA;  LEFT JOIN PARAMETROS.DBO.CENTROS_LOGISTICOS CLO (NOLOCK) ON CLO.ID_PAIS=1 AND CLO.ID_CIUDAD=CAO.ID_CIUDAD AND CLO.ID_CENTRO_LOGISTICO=1 AND CLO.ID_ESTADO=1&#xA;  LEFT JOIN #TMP_CIUDADES_ANEXAS CAD (NOLOCK) ON CAD.ID_PAIS=1 AND CAD.[ID_CIUDAD_ANEXA]=CD.ID_CIUDAD --AND CAD.RECOLECCION=1&#xA;  LEFT JOIN PARAMETROS.DBO.CENTROS_LOGISTICOS CLD (NOLOCK) ON CLD.ID_PAIS=1 AND CLD.ID_CIUDAD=CAD.ID_CIUDAD AND CLD.ID_CENTRO_LOGISTICO=1 AND CLD.ID_ESTADO=1&#xA;LEFT JOIN #TMP_GUIAS_PENDIENTE_RECAUDO_SZU SZU ON SZU.NUMERO_GUIA=GPR.NUMERO_GUIA&#xA;LEFT JOIN #TMP_GUIAS_CON_TAREAS TAR ON TAR.NUMERO_GUIA=GPR.NUMERO_GUIA&#xA;--WHERE &#xA;--NUMERO_GUIA=2273736466&#xA;--ID_PROCESO=32&#xA;&#xA;--DELETE CPR FROM #TMP_GUIAS_PENDIENTE_RECAUDO CPR &#xA;--WHERE&#xA;--NOT EXISTS (SELECT TOP 1 SE.NUMERO_GUIA FROM Mece_Logistico.DBO.SEGUIMIENTO_ENVIO SE (NOLOCK) WHERE SE.NUMERO_GUIA=CPR.NUMERO_GUIA AND SE.ID_PROCESO&gt;=5 AND  SE.ID_PROCESO&lt;27)&#xA;&#xA;&#xA;&#xA;--select  COUNT(1) from #TMP_GUIAS_PENDIENTE_RECAUDO&#xA;--select  COUNT(1) from ##TMP_GUIAS_PENDIENTE_RECAUDO_FINAL_PBI&#xA;&#xA;----select  * from ##TMP_GUIAS_PENDIENTE_RECAUDO_FINAL_PBI&#xA;&#xA;&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="0"
                SQLTask:DtsVariableName="User::STR_FechaIni_REPOBLAR"
                SQLTask:ParameterDirection="Input"
                SQLTask:DataType="129"
                SQLTask:ParameterSize="-1" />
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="1"
                SQLTask:DtsVariableName="User::STR_FechaFin"
                SQLTask:ParameterDirection="Input"
                SQLTask:DataType="129"
                SQLTask:ParameterSize="-1" />
            </SQLTask:SqlTaskData>
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Tareas Backap\Prepatacion data Recudo LPC COD 1"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:Disabled="True"
          DTS:DTSID="{495ff492-8b54-45c7-b9a3-8ed622684113}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Prepatacion data Recudo LPC COD 1"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="6">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{20AF370D-4C8E-4E05-91E7-8F81200FAADC}"
              SQLTask:SqlStatementSource="&#xA;IF OBJECT_ID('tempdb..#COD_PENDIENTE_POR_RECAUDO') IS NOT NULL &#xA;    DROP TABLE #COD_PENDIENTE_POR_RECAUDO&#xA;&#xA;IF OBJECT_ID('tempdb..#TMP_GUIAS_PENDIENTE_RECAUDO') IS NOT NULL &#xA;    DROP TABLE #TMP_GUIAS_PENDIENTE_RECAUDO&#xA;&#xA;CREATE TABLE #TMP_GUIAS_PENDIENTE_RECAUDO(&#xA; NUMERO_GUIA numeric(20, 0) NOT NULL,&#xA; ID_ESTADOENVIO smallint DEFAULT 0,&#xA; NOMBRE_ESTADOENVIO varchar(40) DEFAULT '',&#xA; FORMA_PAGO varchar(40) DEFAULT '',&#xA; VALOR_A_RECAUDAR numeric(12, 2) NULL,&#xA; ID_REMITE [varchar](40) DEFAULT '',&#xA; NOMBRE_REMITE_GUIA  [varchar](200) DEFAULT '',&#xA;-- ID_CIUDAD INT DEFAULT 0,&#xA;-- [NOMBRE_CIUDAD] [varchar](50) DEFAULT '',&#xA; FECHA_ENVIO datetime NULL,&#xA; [VALOR_RECAUDADO] [numeric](11, 2) DEFAULT 0,&#xA; FECHA_RECAUDO datetime NULL,&#xA; NUMERO_ORDEN_SERVICIO varchar(20) DEFAULT '',&#xA; FECHA_RECAUDO_EFECTY datetime NULL,&#xA; ESTADO_ENTREGA varchar(70) DEFAULT 'A TIEMPO',--A TIEMPO O VENCIDO&#xA; --NOMBRE_RESPONSABLE_ULT_MOV VARCHAR(100) DEFAULT '',&#xA; ID_PROCESO_ULT_MOV int DEFAULT 0,&#xA; NOMBRE_PROCESO_ULT_MOV varchar(70) DEFAULT '',&#xA; ID_CONCEPTO_ULT_MOV int DEFAULT 0,&#xA; NOMBRE_CONCEPTO_ULT_MOV varchar(70) DEFAULT '',&#xA; NUMERO_MOVIMI_ULT_MOV char(30) DEFAULT '',&#xA; CONSECUT_MOVIMI_ULT_MOV numeric(7, 0) DEFAULT 0,&#xA; FECHA_HORA_MOVIMI_ULT_MOV datetime NULL,&#xA; ID_PAIS_ZONA_URBA_ULT_MOV SMALLINT NULL,&#xA; ID_CIUDAD_ZONA_URBA_ULT_MOV INT NULL,&#xA; ID_TIPO_ZONA_URBA_ULT_MOV SMALLINT NULL,&#xA; ID_ZONA_URBA_ULT_MOV SMALLINT NULL,&#xA; NOMBRE_CDS_ULT_MOV varchar(100) DEFAULT '',&#xA; TIPO_CANAL_ULT_MOV varchar(40) DEFAULT '',&#xA; ID_CONDUCTOR_ULT_MOV varchar(40) DEFAULT '',&#xA; CONDUCTOR_ULT_MOV  varchar(200) DEFAULT '',&#xA; ID_AUXILIAR_ULT_MOV varchar(40) DEFAULT '',&#xA; AUXILIAR_ULT_MOV varchar(200) DEFAULT '',&#xA; ID_CLIENTE [char](20) NOT NULL&#xA;) ON [PRIMARY]&#xA;CREATE NONCLUSTERED INDEX [IX_NUMERO_GUIA] ON #TMP_GUIAS_PENDIENTE_RECAUDO ([NUMERO_GUIA] ASC)&#xA;CREATE NONCLUSTERED INDEX [IX_ZONA] ON #TMP_GUIAS_PENDIENTE_RECAUDO (ID_PAIS_ZONA_URBA_ULT_MOV,ID_CIUDAD_ZONA_URBA_ULT_MOV, ID_TIPO_ZONA_URBA_ULT_MOV,ID_ZONA_URBA_ULT_MOV ASC)&#xA;CREATE NONCLUSTERED INDEX [IX_MANIFIESTO] ON #TMP_GUIAS_PENDIENTE_RECAUDO (ID_PROCESO_ULT_MOV,NUMERO_MOVIMI_ULT_MOV,CONSECUT_MOVIMI_ULT_MOV ASC)&#xA;&#xA;&#xA;IF OBJECT_ID('tempdb..#TMP_CIUDADES_ANEXAS') IS NOT NULL &#xA;    DROP TABLE #TMP_CIUDADES_ANEXAS&#xA;&#xA;---CIUDADES ANEXAS&#xA;SELECT CAD.* &#xA;INTO #TMP_CIUDADES_ANEXAS FROM PARAMETROS.DBO.CIUDADES_ANEXAS CAD (NOLOCK) &#xA;WHERE CAD.ID_PAIS=1 AND CAD.RECOLECCION=1&#xA;&#xA;INSERT INTO #TMP_CIUDADES_ANEXAS&#xA;SELECT CAD.* FROM PARAMETROS.DBO.CIUDADES_ANEXAS CAD (NOLOCK) &#xA;LEFT JOIN #TMP_CIUDADES_ANEXAS TCAD ON TCAD.ID_CIUDAD_ANEXA=CAD.ID_CIUDAD_ANEXA&#xA;WHERE CAD.ID_PAIS=1 AND CAD.RECOLECCION=0 AND TCAD.ID_CIUDAD_ANEXA IS NULL&#xA;&#xA;DELETE T FROM (SELECT *, &#xA;    DupRank = ROW_NUMBER() OVER (PARTITION BY ID_CIUDAD_ANEXA ORDER BY FECHA_CREACION DESC) &#xA;     FROM #TMP_CIUDADES_ANEXAS) AS T&#xA;WHERE DupRank &gt; 1&#xA;&#xA;&#xA;&#xA;SELECT CPR.*,G.ID_CLIENTE,G.ID_REMITE,G.NOMBRE_REMITE_GUIA,G.ID_PRODUCTO AS ID_PRODUCTO_GUIA,G.ID_ESTADOENVIO,G.ID_ESTADOGUIA,ISNULL(G.VALOR_SEG_MAN_GUIAS,0)+ISNULL(G.VALOR_FLETES_GUIAS,0) AS VALOR_ENVIO_GUIA,ISNULL(GIA.VALOR_RECAUDAR_PRODUCTO,0) AS VALOR_RECAUDAR_PRODUCTO_GUIA&#xA;,CAST('' AS nvarchar(50)) AS NOMBRE_ESTADOENVIO,G.FECHA_ENVIO&#xA;INTO #COD_PENDIENTE_POR_RECAUDO&#xA;FROM [Mece_Logistico].[dbo].[COD_PENDIENTE_POR_RECAUDO] CPR (NOLOCK)&#xA;INNER JOIN [Mece_Logistico].[dbo].[GUIAS] G (nolock) ON G.NUMERO_GUIA=CPR.NUMERO_GUIA&#xA;LEFT JOIN [Mece_Logistico].[dbo].[GUIAS_INF_ADICIONAL] GIA (nolock) ON GIA.NUMERO_GUIA=CPR.NUMERO_GUIA&#xA;LEFT JOIN [tmp_borrar_local].dbo.LPC_GUIAS_SOLUCIONADAS LGS (NOLOCK) ON LGS.NUMERO_GUIA=CPR.NUMERO_GUIA&#xA;WHERE LGS.NUMERO_GUIA IS NULL AND&#xA;ISNULL(CPR.ESTADO_COD,1)=1-- RECAUDO ESTA ACTIVO&#xA;AND ISNULL(CPR.ESTA_RECAUDADO,0)=0 -- NO ESTA RECAUDADO&#xA;--AND G.ID_ESTADOGUIA!=4-- NO ESTA ANULADA&#xA;AND ISNULL(CPR.NUMERO_ORDEN_SERVICIO,'')='' -- NO TIENE ORDEN DE RECAUDO DE EFECTY&#xA;AND ISNULL(CPR.ESTA_ANULADO,0)=0 -- NO DEBE ESTAR ANULADA&#xA;AND G.ID_DIVISION_PROV IS NULL&#xA;--AND CPR.FECHA_CREACION &gt;= @FECHA_INI &#xA;--AND CPR.FECHA_CREACION &lt; @FECHA_FIN&#xA;&#xA;AND CPR.FECHA_CREACION BETWEEN convert(datetime,?) AND convert(datetime,?)&#xA;/*&#xA;AND CPR.FECHA_CREACION BETWEEN convert(datetime,'20251201') &#xA;       AND convert(datetime,'20260201')&#xA;*/&#xA;&#xA;&#xA;&#xA;&#xA;------------------------------------------------------------------------------------------------------------------------------------------------------------------&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;CREATE NONCLUSTERED INDEX [IX_NUMERO_GUIA] ON #COD_PENDIENTE_POR_RECAUDO ([NUMERO_GUIA] ASC)&#xA;&#xA;&#xA;--Se quitan envios siniestrados&#xA;DELETE GPR FROM #COD_PENDIENTE_POR_RECAUDO GPR&#xA;WHERE ID_ESTADOENVIO in(5,4)&#xA;&#xA;--Quita las guias son del canal retail y no son COD y no contraentrega ecommerce&#xA;DELETE GPR FROM #COD_PENDIENTE_POR_RECAUDO GPR&#xA;WHERE ID_FORMA_PAGO=1 AND ID_PRODUCTO!=86&#xA;&#xA;&#xA;--SELECT * FROM #COD_PENDIENTE_POR_RECAUDO CPR (NOLOCK)&#xA;--WHERE --NUMERO_GUIA=2143658629&#xA;--ID_PRODUCTO=86&#xA;--INSERT INTO #TMP_GUIAS_PENDIENTE_RECAUDO&#xA;&#xA;UPDATE CPR SET CPR.NOMBRE_ESTADOENVIO=E.NOMBRE_ESTADOENVIO&#xA;FROM #COD_PENDIENTE_POR_RECAUDO CPR&#xA;INNER JOIN PARAMETROS.DBO.ESTADOSENVIO E (NOLOCK)ON E.ID_ESTADOENVIO=CPR.ID_ESTADOENVIO&#xA;&#xA;--TRUNCATE TABLE #TMP_GUIAS_PENDIENTE_RECAUDO&#xA;INSERT INTO #TMP_GUIAS_PENDIENTE_RECAUDO(&#xA;NUMERO_GUIA,&#xA;ID_ESTADOENVIO,&#xA;NOMBRE_ESTADOENVIO,&#xA;FORMA_PAGO,&#xA;VALOR_A_RECAUDAR,&#xA;ID_REMITE,&#xA;NOMBRE_REMITE_GUIA,&#xA;FECHA_ENVIO,&#xA;VALOR_RECAUDADO,&#xA;FECHA_RECAUDO,&#xA;NUMERO_ORDEN_SERVICIO,&#xA;FECHA_RECAUDO_EFECTY,&#xA;ID_CLIENTE&#xA;)&#xA;SELECT CPR.NUMERO_GUIA,CPR.ID_ESTADOENVIO,CPR.NOMBRE_ESTADOENVIO,&#xA;CASE WHEN CPR.ID_FORMA_PAGO=4 AND CPR.ID_CLIENTE IS NULL THEN 'C.O.D.' WHEN ISNULL(CPR.ID_PRODUCTO,CPR.ID_PRODUCTO_GUIA)=86 THEN 'CONTRAENTREGA ECOMMERCE' WHEN (CPR.ID_FORMA_PAGO=2 OR CPR.ID_CLIENTE IS NOT NULL) THEN 'LPC' ELSE '' END AS FORMA_PAGO,&#xA;CASE WHEN ISNULL(CPR.VALOR_TOTAL,0)!=0 THEN CPR.VALOR_TOTAL&#xA;WHEN CPR.ID_FORMA_PAGO=4 AND VALOR_FLETE IS NOT NULL THEN ISNULL(CPR.VALOR_FLETE,0) + ISNULL(CPR.VALOR_OTROS,0)&#xA;WHEN CPR.ID_FORMA_PAGO=4 AND VALOR_FLETE IS NULL THEN ISNULL(CPR.VALOR_ENVIO_GUIA,0)&#xA;WHEN ISNULL(CPR.ID_PRODUCTO,CPR.ID_PRODUCTO_GUIA)=86 THEN ISNULL(CPR.VALOR_DECLARADO,CPR.VALOR_PRODUCTO)&#xA;WHEN (CPR.ID_FORMA_PAGO=2 OR CPR.ID_CLIENTE IS NOT NULL) THEN ISNULL(CPR.VALOR_DECLARADO,CPR.VALOR_PRODUCTO) ELSE 0 END AS VALOR_A_RECAUDAR&#xA;,CPR.ID_REMITE&#xA;,CPR.NOMBRE_REMITE_GUIA&#xA;,CPR.FECHA_ENVIO&#xA;,ISNULL(CPR.VALOR_RECAUDADO,0)&#xA;,CPR.FECHA_RECAUDO&#xA;,ISNULL(CPR.NUMERO_ORDEN_SERVICIO,0)&#xA;,CPR.FECHA_RECAUDO_EFECTY&#xA;,isnull(CPR.ID_CLIENTE,'0') ID_CLIENTE&#xA;--,CPR.VALOR_TOTAL&#xA;--INTO #TMP_GUIAS_PENDIENTE_RECAUDO_1&#xA;FROM #COD_PENDIENTE_POR_RECAUDO CPR (NOLOCK)&#xA;WHERE LEN(CPR.NUMERO_GUIA)&gt;7&#xA;--INNER JOIN [Mece_Logistico].[dbo].[GUIAS] G (nolock) ON G.NUMERO_GUIA=CPR.NUMERO_GUIA&#xA;&#xA;--CREATE NONCLUSTERED INDEX [IX_NUMERO_GUIA] ON #TMP_GUIAS_PENDIENTE_RECAUDO_1 ([NUMERO_GUIA] ASC)&#xA;&#xA;--select GPR.* from #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA;&#xA;&#xA;UPDATE GPR SET&#xA; --GPR.NOMBRE_RESPONSABLE_ULT_MOV='SERVIENTREGA S.A.'&#xA; GPR.ID_PROCESO_ULT_MOV=SE.ID_PROCESO&#xA; ,GPR.NOMBRE_PROCESO_ULT_MOV=PRO.NOMBRE_PROCESO_LOG&#xA; ,GPR.ID_CONCEPTO_ULT_MOV=ISNULL(SE.ID_CONCEPTO,0)&#xA; ,GPR.NOMBRE_CONCEPTO_ULT_MOV=ISNULL(ICON.NOMBRE_CONCEPTO,'')&#xA; ,GPR.NUMERO_MOVIMI_ULT_MOV=SE.NUMERO_MOVIMI&#xA; ,GPR.CONSECUT_MOVIMI_ULT_MOV=SE.CONSECUT_MOVIMI&#xA; ,GPR.FECHA_HORA_MOVIMI_ULT_MOV=SE.FECHA_HORA_MOVIMIENTO&#xA; --,GPR.ID_CONDUCTOR_ULT_MOV=DOC.ID_COURIER_CONDUCTOR&#xA; --,GPR.ID_AUXILIAR_ULT_MOV=DOC.ID_AUXILIAR1_VEHICULO&#xA; --,GPR.ID_PAIS_ZONA_URBA_ULT_MOV=DOC.ID_PAIS_ZONA_URBA  &#xA; --,GPR.ID_CIUDAD_ZONA_URBA_ULT_MOV=DOC.ID_CIUDAD_ZONA_URBA &#xA; --,GPR.ID_TIPO_ZONA_URBA_ULT_MOV=DOC.ID_TIPO_ZONA_URBA&#xA; --,GPR.ID_ZONA_URBA_ULT_MOV=DOC.ID_ZONA_URBA&#xA; FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; INNER JOIN MECE_LOGISTICO.dbo.SEGUIMIENTO_ENVIO SE WITH(NOLOCK) on se.NUMERO_GUIA=GPR.NUMERO_GUIA&#xA; --INNER JOIN MECE_LOGISTICO.dbo.DOCUMENTOS DOC (NOLOCK) ON&#xA; --DOC.ID_PROCESO=GPR.[ID_PROCESO_ULT_MOV] AND DOC.NUMERO_MOVIMI=GPR.[NUMERO_MOVIMI_ULT_MOV] AND DOC.CONSECUT_MOVIMI=GPR.[CONSECUT_MOVIMI_ULT_MOV]&#xA; INNER JOIN PARAMETROS.DBO.PROCESOS PRO (NOLOCK) ON PRO.ID_PROCESO=SE.ID_PROCESO&#xA; LEFT JOIN PARAMETROS.DBO.ITEM_CONCEPTO ICON (NOLOCK) ON ICON.ID_PAIS=1 AND ICON.ID_PROCESO=SE.ID_PROCESO AND ICON.ID_CONCEPTO=SE.ID_CONCEPTO&#xA; WHERE se.FECHA_HORA_MOVIMIENTO= (select MAX(se1.FECHA_HORA_MOVIMIENTO) from MECE_LOGISTICO.dbo.SEGUIMIENTO_ENVIO SE1 WITH(NOLOCK)&#xA;          where SE1.numero_guia=GPR.NUMERO_GUIA)&#xA; &#xA; UPDATE GPR SET&#xA; GPR.ID_CONDUCTOR_ULT_MOV=DOC.ID_COURIER_CONDUCTOR&#xA; ,GPR.ID_AUXILIAR_ULT_MOV=DOC.ID_AUXILIAR1_VEHICULO&#xA; ,GPR.ID_PAIS_ZONA_URBA_ULT_MOV=DOC.ID_PAIS_ZONA_URBA  &#xA; ,GPR.ID_CIUDAD_ZONA_URBA_ULT_MOV=DOC.ID_CIUDAD_ZONA_URBA &#xA; ,GPR.ID_TIPO_ZONA_URBA_ULT_MOV=DOC.ID_TIPO_ZONA_URBA&#xA; ,GPR.ID_ZONA_URBA_ULT_MOV=DOC.ID_ZONA_URBA&#xA; FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; INNER JOIN MECE_LOGISTICO.DBO.DOCUMENTOS DOC (NOLOCK) ON&#xA; DOC.ID_PROCESO=GPR.[ID_PROCESO_ULT_MOV] AND DOC.NUMERO_MOVIMI=GPR.[NUMERO_MOVIMI_ULT_MOV] AND DOC.CONSECUT_MOVIMI=GPR.[CONSECUT_MOVIMI_ULT_MOV]&#xA;&#xA; --SELECT GPR.ID_CONDUCTOR_ULT_MOV&#xA; &#xA; UPDATE GPR SET&#xA; GPR.ID_CONDUCTOR_ULT_MOV=ISNULL(RTRIM(LTRIM(EC.ID_EMPLEADO)),'')&#xA; ,GPR.CONDUCTOR_ULT_MOV =ISNULL(RTRIM(LTRIM(EC.NOMBRE_EMPLEADO)) +' '+ RTRIM(LTRIM(EC.APELLIDO_EMPLEADO)),'') &#xA; ,GPR.ID_AUXILIAR_ULT_MOV=ISNULL(RTRIM(LTRIM(EA.ID_EMPLEADO)),'')&#xA; ,GPR.AUXILIAR_ULT_MOV=ISNULL(RTRIM(LTRIM(EA.NOMBRE_EMPLEADO)) +' '+ RTRIM(LTRIM(EA.APELLIDO_EMPLEADO)),'') &#xA; FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; LEFT JOIN PARAMETROS.DBO.EMPLEADOS EC (NOLOCK) ON EC.ID_EMPLEADO=GPR.ID_CONDUCTOR_ULT_MOV&#xA; LEFT JOIN PARAMETROS.DBO.EMPLEADOS EA (NOLOCK) ON EA.ID_EMPLEADO=GPR.ID_AUXILIAR_ULT_MOV&#xA;&#xA;&#xA; --SELECT GPR.NUMERO_GUIA,ISNULL(DIV.NOMBRE_DIVISION,'') AS NOMBRE_CDS, ISNULL(CTCAN.[NOMBRE_CLASE_TIPO_CANAL],'') as TIPO_CANAL&#xA;UPDATE GPR SET NOMBRE_CDS_ULT_MOV=ISNULL(DIV.NOMBRE_DIVISION,''),&#xA; TIPO_CANAL_ULT_MOV=ISNULL(CTCAN.[NOMBRE_CLASE_TIPO_CANAL],'')&#xA; FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; --INNER JOIN MECE_LOGISTICO.DBO.DOCUMENTOS DOC (NOLOCK) ON&#xA; --DOC.ID_PROCESO=GPR.[ID_PROCESO_ULT_MOV] AND DOC.NUMERO_MOVIMI=GPR.[NUMERO_MOVIMI_ULT_MOV] AND DOC.CONSECUT_MOVIMI=GPR.[CONSECUT_MOVIMI_ULT_MOV]&#xA; INNER JOIN PARAMETROS.DBO.ZONASURBANAS Z (NOLOCK) &#xA; ON Z.ID_PAIS = GPR.ID_PAIS_ZONA_URBA_ULT_MOV AND Z.ID_CIUDAD = GPR.ID_CIUDAD_ZONA_URBA_ULT_MOV &#xA;  AND Z.ID_TIPO_ZONA_URBA = GPR.ID_TIPO_ZONA_URBA_ULT_MOV AND Z.ID_ZONA_URBA = GPR.ID_ZONA_URBA_ULT_MOV --AND Z.CATEGORIA_ZONA_URBA = 8 --CLICOH&#xA; INNER JOIN PARAMETROS.DBO.DIVISIONES DIV (NOLOCK) ON DIV.ID_PAIS = Z.ID_PAIS_CANAL AND DIV.ID_CIUDAD = Z.ID_CIUDAD_CANAL AND DIV.ID_DIVISION = Z.ID_CANAL&#xA; INNER JOIN [Mece_Logistico].[dbo].[CANALES] CAN (NOLOCK) ON CAN.id_pais=DIV.ID_PAIS and CAN.id_ciudad=DIV.ID_CIUDAD and CAN.[ID_DIVISION]=DIV.ID_DIVISION&#xA; INNER JOIN [Mece_Logistico].[dbo].[TIPOS_CANAL] TCAN (NOLOCK) ON TCAN.ID_TIPO_CANAL=CAN.ID_TIPO_CANAL AND TCAN.ID_EST_TIPO_CANAL=1&#xA; INNER JOIN PARAMETROS.[dbo].[CLASE_TIPO_CANAL] CTCAN (NOLOCK) ON CTCAN.ID_CLASE_TIPO_CANAL=TCAN.CLASE_TIPO_CANAL&#xA;&#xA;&#xA; --UPDATE GPR SET ESTADO_ENTREGA='VENCIDO'&#xA; --SELECT * FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; UPDATE GPR SET ESTADO_ENTREGA='VENCIDO'&#xA; FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; WHERE GPR.ID_PROCESO_ULT_MOV=9 AND ID_CONCEPTO_ULT_MOV IN(9,7,2,4)--9 ENTREGAS OFIC  C.O.D. Y/O LPC EMPRESARIO --7 EMPRESARIO SATELITE ENTREGA EN OFICINA&#xA; --2 RECLAMO OFICINA Y 4 C.O.D RECLAMO OFICINA&#xA; AND DATEDIFF(DAY, FECHA_HORA_MOVIMI_ULT_MOV,GETDATE())&gt;8 -- MAS DE 8 DIAS&#xA; &#xA; UPDATE GPR SET ESTADO_ENTREGA='VENCIDO'&#xA; FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; WHERE GPR.ID_PROCESO_ULT_MOV=31 --ENVIO PARA ENTREGA EN OFICINA&#xA; AND DATEDIFF(DAY, FECHA_HORA_MOVIMI_ULT_MOV,GETDATE())&gt;8 -- MAS DE 8 DIAS&#xA;&#xA; UPDATE GPR SET ESTADO_ENTREGA='VENCIDO'&#xA; FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; WHERE GPR.ID_PROCESO_ULT_MOV=9 AND ID_CONCEPTO_ULT_MOV IN(10,8) --10 ENTR A DOMICI  LPC / COD EMPRESARIOS SAT --8 EMPRESARIO SATELITE ENTREGA EN DOMICILIO&#xA; AND DATEDIFF(DAY, FECHA_HORA_MOVIMI_ULT_MOV,GETDATE())&gt;3-- MAS DE 3 DIAS&#xA; &#xA; UPDATE GPR SET ESTADO_ENTREGA='VENCIDO'&#xA; FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; WHERE GPR.ID_PROCESO_ULT_MOV=32 --ENVIO PARA ENTREGA A DOMICILIO&#xA; AND DATEDIFF(DAY, FECHA_HORA_MOVIMI_ULT_MOV,GETDATE())&gt;3-- MAS DE 3 DIAS&#xA;&#xA; UPDATE GPR SET ESTADO_ENTREGA='VENCIDO'&#xA; FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; WHERE GPR.ID_PROCESO_ULT_MOV=9 AND ID_CONCEPTO_ULT_MOV IN(1,3) --SALIDA A ZONA Y C.O.D EN DISTRIBUCION&#xA; AND DATEDIFF(DAY, FECHA_HORA_MOVIMI_ULT_MOV,GETDATE())&gt;1 --MAS DE UN DIA&#xA;&#xA;&#xA;DROP TABLE IF EXISTS ##TMP_GUIAS_PENDIENTE_RECAUDO_FINAL_PBI;&#xA;SELECT --GPR.*&#xA;GPR.NUMERO_GUIA &#xA;--GPR.ID_ESTADOENVIO &#xA;,GPR.NOMBRE_ESTADOENVIO &#xA;,GPR.FORMA_PAGO &#xA;,GPR.VALOR_A_RECAUDAR &#xA;,GPR.ID_REMITE &#xA;,GPR.NOMBRE_REMITE_GUIA &#xA;,GPR.FECHA_ENVIO&#xA;,GPR.VALOR_RECAUDADO&#xA;,GPR.FECHA_RECAUDO&#xA;,GPR.NUMERO_ORDEN_SERVICIO&#xA;,GPR.FECHA_RECAUDO_EFECTY&#xA;,GPR.ESTADO_ENTREGA&#xA;--,GPR.NOMBRE_RESPONSABLE_ULT_MOV &#xA;--ID_PROCESO_ULT_MOV &#xA;--NOMBRE_PROCESO_ULT_MOV &#xA;--NUMERO_MOVIMI_ULT_MOV &#xA;--CONSECUT_MOVIMI_ULT_MOV &#xA;--FECHA_HORA_MOVIMI_ULT_MOV&#xA;&#xA;--,ISNULL(ISNULL(CLO.CENTRO_LOGISTICO,CLD.CENTRO_LOGISTICO),'')  AS CPL_ORIGEN_ULT_MOV&#xA;--,ISNULL(ISNULL(RO.NOMBRE_REGIONAL,RD.NOMBRE_REGIONAL),'')  AS REGIONAL_ORIGEN_ULT_MOV&#xA;--,ISNULL(ISNULL(CO.NOMBRE_CIUDAD,CD.NOMBRE_CIUDAD),'')  AS CIUDAD_ORIGEN_ULT_MOV&#xA;--,ISNULL(ISNULL(CLD.CENTRO_LOGISTICO,CLO.CENTRO_LOGISTICO),'') AS CPL_DESTINO_ULT_MOV&#xA;--,ISNULL(ISNULL(RD.NOMBRE_REGIONAL,RO.NOMBRE_REGIONAL),'') AS REGIONAL_DESTINO_ULT_MOV&#xA;--,ISNULL(ISNULL(CD.NOMBRE_CIUDAD,CO.NOMBRE_CIUDAD),'') AS CIUDAD_DESTINO_MOV&#xA;,CASE WHEN ID_PROCESO!=14 THEN &#xA;ISNULL(ISNULL(CLO.CENTRO_LOGISTICO,CLD.CENTRO_LOGISTICO),'')  ELSE ISNULL(ISNULL(CLD.CENTRO_LOGISTICO,CLO.CENTRO_LOGISTICO),'') END AS CPL_ULT_MOV&#xA;,CASE WHEN ID_PROCESO!=14 THEN &#xA;ISNULL(ISNULL(RO.NOMBRE_REGIONAL,RD.NOMBRE_REGIONAL),'') ELSE ISNULL(ISNULL(RD.NOMBRE_REGIONAL,RO.NOMBRE_REGIONAL),'') END  AS REGIONAL_ULT_MOV&#xA;,CASE WHEN ID_PROCESO!=14 THEN &#xA;ISNULL(ISNULL(CO.NOMBRE_CIUDAD,CD.NOMBRE_CIUDAD),'')  ELSE ISNULL(ISNULL(CD.NOMBRE_CIUDAD,CO.NOMBRE_CIUDAD),'') END  AS CIUDAD_ULT_MOV&#xA;,ISNULL(CASE &#xA; WHEN ISNULL(DOC.ID_CIUDAD_ZONA_URBA,0) !=0 THEN&#xA; ROZ.NOMBRE_REGIONAL+' - '+ DCOZ.NOMBRE_DEPARTAMENTO +' - '+ COZ.NOMBRE_CIUDAD &#xA; WHEN  ISNULL(DOC.ID_CIUDAD_DIVISION_ORIGEN,0) !=0 AND DOC.ID_PROCESO!=14 THEN&#xA; ROM.NOMBRE_REGIONAL+' - '+ DCOM.NOMBRE_DEPARTAMENTO +' - '+ COM.NOMBRE_CIUDAD&#xA; ELSE&#xA; ROD.NOMBRE_REGIONAL+' - '+ DCOD.NOMBRE_DEPARTAMENTO +' - '+ COD.NOMBRE_CIUDAD &#xA; END,'') AS REG_DEPART_CIUDAD_ULTIMO_MOV&#xA;&#xA;,ISNULL(DOC.PLACA_VEHICULO_DOCU,'') as PLACA_VEHICULO_ULTIMO_MOV&#xA;,ISNULL(O.[NOMBRE_OPERATIVO],'') AS NOMBRE_OPERATIVO_ULTIMO_MOV&#xA;,ISNULL(Z.NOMBRE_ZONA_URBA,'') AS ZONA_URBANA_ULTIMO_MOV&#xA;,ISNULL(CZ.NOMBRE_CATEGORIA,'') AS CATEGORIA_ZONA_ULTIMO_MOV&#xA;,ISNULL(TZU.NOMBRE_TIPO_ZONA_URBA,'') AS TIPO_ZONA_ULTIMO_MOV&#xA;,ISNULL(GPR.NOMBRE_CDS_ULT_MOV,'') AS NOMBRE_CDS_ULT_MOV&#xA;,ISNULL(TIPO_CANAL_ULT_MOV,'') AS TIPO_CANAL_ULT_MOV&#xA;--,GR.ID_PROCESO &#xA;,ISNULL(GPR.NOMBRE_PROCESO_ULT_MOV,'') AS PROCESO_LOG_ULTIMO_MOV  &#xA;,ISNULL(GPR.NOMBRE_CONCEPTO_ULT_MOV,'') AS CONCEPTO_ULT_MOV&#xA;--,GR.ID_CONCEPTO  &#xA;--,GR.FECHA_HORA_MOVIMIENTO&#xA;,ISNULL(cast(GPR.ID_PROCESO_ULT_MOV as nvarchar) +' - '+ RTRIM(GPR.NOMBRE_PROCESO_ULT_MOV),'') AS NOMBRE_ULTIMO_MOV&#xA;,ISNULL(CASE WHEN DIO.ID_DIVISION IS NOT NULL THEN cast(DIO.ID_DIVISION as nvarchar) +' - '+ RTRIM(DIO.NOMBRE_DIVISION)&#xA;ELSE cast(DID.ID_DIVISION as nvarchar) +' - '+ RTRIM(DID.NOMBRE_DIVISION) END,'') AS BODEGA_ULTIMO_MOV&#xA;,ISNULL(cast(GPR.ID_PROCESO_ULT_MOV as nvarchar) +' - '+ RTRIM(GPR.[NUMERO_MOVIMI_ULT_MOV])+' - '+  cast(GPR.[CONSECUT_MOVIMI_ULT_MOV] as nvarchar),'') as ULTIMO_MOV_LOGISTICO&#xA;,ISNULL(CONVERT(nvarchar(20),GPR.FECHA_HORA_MOVIMI_ULT_MOV,120),'') AS FECHA_ULTIMO_MOV&#xA;,GPR.ID_CONDUCTOR_ULT_MOV&#xA;,GPR.CONDUCTOR_ULT_MOV&#xA;,GPR.ID_AUXILIAR_ULT_MOV&#xA;,GPR.AUXILIAR_ULT_MOV&#xA;,GPR.ID_CLIENTE&#xA;&#xA;--,DOC.*&#xA;INTO ##TMP_GUIAS_PENDIENTE_RECAUDO_FINAL_PBI&#xA;&#xA;FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA;--------------------------- CIUDAD ULTIMO MOV ZONA&#xA;  LEFT JOIN MECE_LOGISTICO.DBO.DOCUMENTOS DOC (NOLOCK) ON&#xA; DOC.ID_PROCESO=GPR.[ID_PROCESO_ULT_MOV] AND DOC.NUMERO_MOVIMI=GPR.[NUMERO_MOVIMI_ULT_MOV] AND DOC.CONSECUT_MOVIMI=GPR.[CONSECUT_MOVIMI_ULT_MOV]&#xA; --AND DOC.ID_DIVISION_DESTINO IN (9311, 9308, 9304, 9313, 9310, 9312, 9711, 9710)&#xA;  LEFT JOIN PARAMETROS.DBO.CIUDADES COZ (NOLOCK) ON  COZ.ID_PAIS=1 AND COZ.ID_CIUDAD=DOC.ID_CIUDAD_ZONA_URBA&#xA;  LEFT JOIN PARAMETROS.DBO.REGIONALES_PAIS ROZ (NOLOCK) ON  ROZ.ID_PAIS=COZ.ID_PAIS AND ROZ.ID_REGIONAL=COZ.ID_REGIONAL&#xA;  LEFT JOIN PARAMETROS.DBO.DEPARTAMENTOS DCOZ (NOLOCK) ON  DCOZ.ID_PAIS=COZ.ID_PAIS AND DCOZ.ID_DEPARTAMENTO=COZ.ID_DEPARTAMENTO&#xA;   LEFT JOIN PARAMETROS.DBO.ZONASURBANAS Z (NOLOCK) &#xA; ON Z.ID_PAIS = DOC.ID_PAIS_ZONA_URBA AND Z.ID_CIUDAD = DOC.ID_CIUDAD_ZONA_URBA AND Z.ID_TIPO_ZONA_URBA = DOC.ID_TIPO_ZONA_URBA AND Z.ID_ZONA_URBA = DOC.ID_ZONA_URBA --AND Z.CATEGORIA_ZONA_URBA = 8 --CLICOH&#xA;  LEFT JOIN [PARAMETROS].[dbo].[CATEGORIAZONASURBANAS] CZ (NOLOCK) ON CZ.Id_Categoria=Z.CATEGORIA_ZONA_URBA&#xA;  LEFT JOIN [PARAMETROS].[dbo].[TIPOSZONASURBANAS] TZU (NOLOCK) ON TZU.ID_TIPO_ZONA_URBA=Z.ID_TIPO_ZONA_URBA&#xA; --------------------------- CIUDAD ULTIMO MOV DOCUMENTO&#xA;  LEFT JOIN PARAMETROS.DBO.CIUDADES COM (NOLOCK) ON  COM.ID_PAIS=1 AND COM.ID_CIUDAD=DOC.ID_CIUDAD_DIVISION_ORIGEN&#xA;  LEFT JOIN PARAMETROS.DBO.REGIONALES_PAIS ROM (NOLOCK) ON  ROM.ID_PAIS=COM.ID_PAIS AND ROM.ID_REGIONAL=COM.ID_REGIONAL&#xA;  LEFT JOIN PARAMETROS.DBO.DEPARTAMENTOS DCOM (NOLOCK) ON  DCOM.ID_PAIS=COM.ID_PAIS AND DCOM.ID_DEPARTAMENTO=COM.ID_DEPARTAMENTO&#xA;  --------------------------- CIUDAD DESTINO ULTIMO MOV DOCUMENTO&#xA;  LEFT JOIN PARAMETROS.DBO.CIUDADES COD(NOLOCK) ON  COD.ID_PAIS=1 AND COD.ID_CIUDAD=DOC.ID_CIUDAD_DESTINO&#xA;  LEFT JOIN PARAMETROS.DBO.REGIONALES_PAIS ROD (NOLOCK) ON  ROD.ID_PAIS=COD.ID_PAIS AND ROD.ID_REGIONAL=COD.ID_REGIONAL&#xA;  LEFT JOIN PARAMETROS.DBO.DEPARTAMENTOS DCOD (NOLOCK) ON  DCOD.ID_PAIS=COD.ID_PAIS AND DCOD.ID_DEPARTAMENTO=COD.ID_DEPARTAMENTO&#xA;  --------------------------- DIVISION ORIGEN ULTIMO MOV DOCUMENTO&#xA;  LEFT JOIN PARAMETROS.DBO.DIVISIONES DIO(NOLOCK) ON DIO.ID_PAIS=DOC.ID_PAIS_DIVISION_ORIGEN&#xA; AND DIO.ID_CIUDAD=DOC.ID_CIUDAD_DIVISION_ORIGEN AND DIO.ID_DIVISION=DOC.ID_DIVISION_ORIGEN&#xA;  --------------------------- DIVISION DESTINO ULTIMO MOV DOCUMENTO&#xA;  LEFT JOIN PARAMETROS.DBO.DIVISIONES DID(NOLOCK) ON DID.ID_PAIS=DOC.ID_PAIS_DESTINO&#xA; AND DID.ID_CIUDAD=DOC.ID_CIUDAD_DESTINO AND DID.ID_DIVISION=DOC.ID_DIVISION_DESTINO&#xA;-------------------------------------------------------------&#xA;  LEFT JOIN [PARAMETROS].[dbo].CIUDADES CO (NOLOCK) ON CO.ID_PAIS=ID_PAIS_DIVISION_ORIGEN AND CO.ID_CIUDAD=DOC.ID_CIUDAD_DIVISION_ORIGEN&#xA;  LEFT JOIN [PARAMETROS].[dbo].REGIONALES_PAIS RO (NOLOCK) ON RO.ID_PAIS=1 AND RO.ID_REGIONAL=CO.[ID_REGIONAL]&#xA;  LEFT JOIN [PARAMETROS].[dbo].CIUDADES CD (NOLOCK) ON CD.ID_PAIS=DOC.ID_PAIS_DESTINO AND CD.ID_CIUDAD=DOC.ID_CIUDAD_DESTINO&#xA;  LEFT JOIN [PARAMETROS].[dbo].REGIONALES_PAIS RD (NOLOCK) ON RD.ID_PAIS=1 AND RD.ID_REGIONAL=CD.[ID_REGIONAL]&#xA;  LEFT JOIN [PARAMETROS].[dbo].[OPERATIVOS] O (NOLOCK) ON O.[ID_PAIS_ORIGEN]=DOC.ID_PAIS_OPERATIVO AND O.[ID_CIUDAD_ORIGEN]=DOC.ID_CIUDAD_OPERATIVO&#xA; AND O.[ID_OPERATIVO]=DOC.ID_OPERATIVO&#xA;  LEFT JOIN #TMP_CIUDADES_ANEXAS CAO (NOLOCK) ON CAO.ID_PAIS=1 AND CAO.[ID_CIUDAD_ANEXA]=CO.ID_CIUDAD --AND CAO.RECOLECCION=1&#xA;  LEFT JOIN PARAMETROS.DBO.CENTROS_LOGISTICOS CLO (NOLOCK) ON CLO.ID_PAIS=1 AND CLO.ID_CIUDAD=CAO.ID_CIUDAD AND CLO.ID_CENTRO_LOGISTICO=1 AND CLO.ID_ESTADO=1&#xA;  LEFT JOIN #TMP_CIUDADES_ANEXAS CAD (NOLOCK) ON CAD.ID_PAIS=1 AND CAD.[ID_CIUDAD_ANEXA]=CD.ID_CIUDAD --AND CAD.RECOLECCION=1&#xA;  LEFT JOIN PARAMETROS.DBO.CENTROS_LOGISTICOS CLD (NOLOCK) ON CLD.ID_PAIS=1 AND CLD.ID_CIUDAD=CAD.ID_CIUDAD AND CLD.ID_CENTRO_LOGISTICO=1 AND CLD.ID_ESTADO=1&#xA;--WHERE &#xA;--NUMERO_GUIA=2273736466&#xA;--ID_PROCESO=32&#xA;&#xA;--DELETE CPR FROM #TMP_GUIAS_PENDIENTE_RECAUDO CPR &#xA;--WHERE&#xA;--NOT EXISTS (SELECT TOP 1 SE.NUMERO_GUIA FROM Mece_Logistico.DBO.SEGUIMIENTO_ENVIO SE (NOLOCK) WHERE SE.NUMERO_GUIA=CPR.NUMERO_GUIA AND SE.ID_PROCESO&gt;=5 AND  SE.ID_PROCESO&lt;27)&#xA;&#xA;&#xA;&#xA;&#xA;select top 100 * from ##TMP_GUIAS_PENDIENTE_RECAUDO_FINAL_PBI&#xA;&#xA;&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="0"
                SQLTask:DtsVariableName="User::STR_FechaIni"
                SQLTask:ParameterDirection="Input"
                SQLTask:DataType="129"
                SQLTask:ParameterSize="-1" />
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="1"
                SQLTask:DtsVariableName="User::STR_FechaFin"
                SQLTask:ParameterDirection="Input"
                SQLTask:DataType="129"
                SQLTask:ParameterSize="-1" />
            </SQLTask:SqlTaskData>
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Tareas Backap\Prepatacion data Recudo LPC COD 2"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:Disabled="True"
          DTS:DTSID="{5c844dc3-507e-4fed-9041-4337833e2e56}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Prepatacion data Recudo LPC COD 2"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="8">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{20AF370D-4C8E-4E05-91E7-8F81200FAADC}"
              SQLTask:SqlStatementSource="&#xA;IF OBJECT_ID('tempdb..#COD_PENDIENTE_POR_RECAUDO') IS NOT NULL &#xA;    DROP TABLE #COD_PENDIENTE_POR_RECAUDO&#xA;&#xA;IF OBJECT_ID('tempdb..#TMP_GUIAS_PENDIENTE_RECAUDO') IS NOT NULL &#xA;    DROP TABLE #TMP_GUIAS_PENDIENTE_RECAUDO&#xA;&#xA;CREATE TABLE #TMP_GUIAS_PENDIENTE_RECAUDO(&#xA; NUMERO_GUIA numeric(20, 0) NOT NULL,&#xA; ID_ESTADOENVIO smallint DEFAULT 0,&#xA; NOMBRE_ESTADOENVIO varchar(40) DEFAULT '',&#xA; FORMA_PAGO varchar(40) DEFAULT '',&#xA; VALOR_A_RECAUDAR numeric(12, 2) NULL,&#xA; ID_REMITE [varchar](40) DEFAULT '',&#xA; NOMBRE_REMITE_GUIA  [varchar](200) DEFAULT '',&#xA;-- ID_CIUDAD INT DEFAULT 0,&#xA;-- [NOMBRE_CIUDAD] [varchar](50) DEFAULT '',&#xA; FECHA_ENVIO datetime NULL,&#xA; [VALOR_RECAUDADO] [numeric](11, 2) DEFAULT 0,&#xA; FECHA_RECAUDO datetime NULL,&#xA; NUMERO_ORDEN_SERVICIO varchar(20) DEFAULT '',&#xA; FECHA_RECAUDO_EFECTY datetime NULL,&#xA; ESTADO_ENTREGA varchar(70) DEFAULT 'A TIEMPO',--A TIEMPO O VENCIDO&#xA; --NOMBRE_RESPONSABLE_ULT_MOV VARCHAR(100) DEFAULT '',&#xA; ID_PROCESO_ULT_MOV int DEFAULT 0,&#xA; NOMBRE_PROCESO_ULT_MOV varchar(70) DEFAULT '',&#xA; ID_CONCEPTO_ULT_MOV int DEFAULT 0,&#xA; NOMBRE_CONCEPTO_ULT_MOV varchar(70) DEFAULT '',&#xA; NUMERO_MOVIMI_ULT_MOV char(30) DEFAULT '',&#xA; CONSECUT_MOVIMI_ULT_MOV numeric(7, 0) DEFAULT 0,&#xA; FECHA_HORA_MOVIMI_ULT_MOV datetime NULL,&#xA; ID_PAIS_ZONA_URBA_ULT_MOV SMALLINT NULL,&#xA; ID_CIUDAD_ZONA_URBA_ULT_MOV INT NULL,&#xA; ID_TIPO_ZONA_URBA_ULT_MOV SMALLINT NULL,&#xA; ID_ZONA_URBA_ULT_MOV SMALLINT NULL,&#xA; NOMBRE_CDS_ULT_MOV varchar(100) DEFAULT '',&#xA; TIPO_CANAL_ULT_MOV varchar(40) DEFAULT '',&#xA; ID_CONDUCTOR_ULT_MOV varchar(40) DEFAULT '',&#xA; CONDUCTOR_ULT_MOV  varchar(200) DEFAULT '',&#xA; ID_AUXILIAR_ULT_MOV varchar(40) DEFAULT '',&#xA; AUXILIAR_ULT_MOV varchar(200) DEFAULT '',&#xA; ID_CLIENTE [char](20) NOT NULL&#xA;) ON [PRIMARY]&#xA;CREATE NONCLUSTERED INDEX [IX_NUMERO_GUIA] ON #TMP_GUIAS_PENDIENTE_RECAUDO ([NUMERO_GUIA] ASC)&#xA;CREATE NONCLUSTERED INDEX [IX_ZONA] ON #TMP_GUIAS_PENDIENTE_RECAUDO (ID_PAIS_ZONA_URBA_ULT_MOV,ID_CIUDAD_ZONA_URBA_ULT_MOV, ID_TIPO_ZONA_URBA_ULT_MOV,ID_ZONA_URBA_ULT_MOV ASC)&#xA;CREATE NONCLUSTERED INDEX [IX_MANIFIESTO] ON #TMP_GUIAS_PENDIENTE_RECAUDO (ID_PROCESO_ULT_MOV,NUMERO_MOVIMI_ULT_MOV,CONSECUT_MOVIMI_ULT_MOV ASC)&#xA;&#xA;&#xA;IF OBJECT_ID('tempdb..#TMP_CIUDADES_ANEXAS') IS NOT NULL &#xA;    DROP TABLE #TMP_CIUDADES_ANEXAS&#xA;&#xA;---CIUDADES ANEXAS&#xA;SELECT CAD.* &#xA;INTO #TMP_CIUDADES_ANEXAS FROM PARAMETROS.DBO.CIUDADES_ANEXAS CAD (NOLOCK) &#xA;WHERE CAD.ID_PAIS=1 AND CAD.RECOLECCION=1&#xA;&#xA;INSERT INTO #TMP_CIUDADES_ANEXAS&#xA;SELECT CAD.* FROM PARAMETROS.DBO.CIUDADES_ANEXAS CAD (NOLOCK) &#xA;LEFT JOIN #TMP_CIUDADES_ANEXAS TCAD ON TCAD.ID_CIUDAD_ANEXA=CAD.ID_CIUDAD_ANEXA&#xA;WHERE CAD.ID_PAIS=1 AND CAD.RECOLECCION=0 AND TCAD.ID_CIUDAD_ANEXA IS NULL&#xA;&#xA;DELETE T FROM (SELECT *, &#xA;    DupRank = ROW_NUMBER() OVER (PARTITION BY ID_CIUDAD_ANEXA ORDER BY FECHA_CREACION DESC) &#xA;     FROM #TMP_CIUDADES_ANEXAS) AS T&#xA;WHERE DupRank &gt; 1&#xA;&#xA;&#xA;&#xA;SELECT CPR.*,G.ID_CLIENTE,G.ID_REMITE,G.NOMBRE_REMITE_GUIA,G.ID_PRODUCTO AS ID_PRODUCTO_GUIA,G.ID_ESTADOENVIO,G.ID_ESTADOGUIA,ISNULL(G.VALOR_SEG_MAN_GUIAS,0)+ISNULL(G.VALOR_FLETES_GUIAS,0) AS VALOR_ENVIO_GUIA,ISNULL(GIA.VALOR_RECAUDAR_PRODUCTO,0) AS VALOR_RECAUDAR_PRODUCTO_GUIA&#xA;,CAST('' AS nvarchar(50)) AS NOMBRE_ESTADOENVIO,G.FECHA_ENVIO&#xA;INTO #COD_PENDIENTE_POR_RECAUDO&#xA;FROM [Mece_Logistico].[dbo].[COD_PENDIENTE_POR_RECAUDO] CPR (NOLOCK)&#xA;INNER JOIN [Mece_Logistico].[dbo].[GUIAS] G (nolock) ON G.NUMERO_GUIA=CPR.NUMERO_GUIA&#xA;LEFT JOIN [Mece_Logistico].[dbo].[GUIAS_INF_ADICIONAL] GIA (nolock) ON GIA.NUMERO_GUIA=CPR.NUMERO_GUIA&#xA;LEFT JOIN [tmp_borrar_local].dbo.LPC_GUIAS_SOLUCIONADAS LGS (NOLOCK) ON LGS.NUMERO_GUIA=CPR.NUMERO_GUIA&#xA;WHERE LGS.NUMERO_GUIA IS NULL AND&#xA;ISNULL(CPR.ESTADO_COD,1)=1-- RECAUDO ESTA ACTIVO&#xA;AND ISNULL(CPR.ESTA_RECAUDADO,0)=0 -- NO ESTA RECAUDADO&#xA;--AND G.ID_ESTADOGUIA!=4-- NO ESTA ANULADA&#xA;AND ISNULL(CPR.NUMERO_ORDEN_SERVICIO,'')='' -- NO TIENE ORDEN DE RECAUDO DE EFECTY&#xA;AND ISNULL(CPR.ESTA_ANULADO,0)=0 -- NO DEBE ESTAR ANULADA&#xA;AND G.ID_DIVISION_PROV IS NULL&#xA;--AND CPR.FECHA_CREACION &gt;= @FECHA_INI &#xA;--AND CPR.FECHA_CREACION &lt; @FECHA_FIN&#xA;&#xA;AND CPR.FECHA_CREACION BETWEEN convert(datetime,?) AND convert(datetime,?)&#xA;/*&#xA;AND CPR.FECHA_CREACION BETWEEN convert(datetime,'20251201') &#xA;       AND convert(datetime,'20260201')&#xA;*/&#xA;&#xA;&#xA;&#xA;&#xA;------------------------------------------------------------------------------------------------------------------------------------------------------------------&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;CREATE NONCLUSTERED INDEX [IX_NUMERO_GUIA] ON #COD_PENDIENTE_POR_RECAUDO ([NUMERO_GUIA] ASC)&#xA;&#xA;&#xA;--Se quitan envios siniestrados&#xA;DELETE GPR FROM #COD_PENDIENTE_POR_RECAUDO GPR&#xA;WHERE ID_ESTADOENVIO in(5,4)&#xA;&#xA;--Quita las guias son del canal retail y no son COD y no contraentrega ecommerce&#xA;DELETE GPR FROM #COD_PENDIENTE_POR_RECAUDO GPR&#xA;WHERE ID_FORMA_PAGO=1 AND ID_PRODUCTO!=86&#xA;&#xA;&#xA;--SELECT * FROM #COD_PENDIENTE_POR_RECAUDO CPR (NOLOCK)&#xA;--WHERE --NUMERO_GUIA=2143658629&#xA;--ID_PRODUCTO=86&#xA;--INSERT INTO #TMP_GUIAS_PENDIENTE_RECAUDO&#xA;&#xA;UPDATE CPR SET CPR.NOMBRE_ESTADOENVIO=E.NOMBRE_ESTADOENVIO&#xA;FROM #COD_PENDIENTE_POR_RECAUDO CPR&#xA;INNER JOIN PARAMETROS.DBO.ESTADOSENVIO E (NOLOCK)ON E.ID_ESTADOENVIO=CPR.ID_ESTADOENVIO&#xA;&#xA;--TRUNCATE TABLE #TMP_GUIAS_PENDIENTE_RECAUDO&#xA;INSERT INTO #TMP_GUIAS_PENDIENTE_RECAUDO(&#xA;NUMERO_GUIA,&#xA;ID_ESTADOENVIO,&#xA;NOMBRE_ESTADOENVIO,&#xA;FORMA_PAGO,&#xA;VALOR_A_RECAUDAR,&#xA;ID_REMITE,&#xA;NOMBRE_REMITE_GUIA,&#xA;FECHA_ENVIO,&#xA;VALOR_RECAUDADO,&#xA;FECHA_RECAUDO,&#xA;NUMERO_ORDEN_SERVICIO,&#xA;FECHA_RECAUDO_EFECTY,&#xA;ID_CLIENTE&#xA;)&#xA;SELECT CPR.NUMERO_GUIA,CPR.ID_ESTADOENVIO,CPR.NOMBRE_ESTADOENVIO,&#xA;CASE WHEN CPR.ID_FORMA_PAGO=4 AND CPR.ID_CLIENTE IS NULL THEN 'C.O.D.' WHEN ISNULL(CPR.ID_PRODUCTO,CPR.ID_PRODUCTO_GUIA)=86 THEN 'CONTRAENTREGA ECOMMERCE' WHEN (CPR.ID_FORMA_PAGO=2 OR CPR.ID_CLIENTE IS NOT NULL) THEN 'LPC' ELSE '' END AS FORMA_PAGO,&#xA;CASE WHEN ISNULL(CPR.VALOR_TOTAL,0)!=0 THEN CPR.VALOR_TOTAL&#xA;WHEN CPR.ID_FORMA_PAGO=4 AND VALOR_FLETE IS NOT NULL THEN ISNULL(CPR.VALOR_FLETE,0) + ISNULL(CPR.VALOR_OTROS,0)&#xA;WHEN CPR.ID_FORMA_PAGO=4 AND VALOR_FLETE IS NULL THEN ISNULL(CPR.VALOR_ENVIO_GUIA,0)&#xA;WHEN ISNULL(CPR.ID_PRODUCTO,CPR.ID_PRODUCTO_GUIA)=86 THEN ISNULL(CPR.VALOR_DECLARADO,CPR.VALOR_PRODUCTO)&#xA;WHEN (CPR.ID_FORMA_PAGO=2 OR CPR.ID_CLIENTE IS NOT NULL) THEN ISNULL(CPR.VALOR_DECLARADO,CPR.VALOR_PRODUCTO) ELSE 0 END AS VALOR_A_RECAUDAR&#xA;,CPR.ID_REMITE&#xA;,CPR.NOMBRE_REMITE_GUIA&#xA;,CPR.FECHA_ENVIO&#xA;,ISNULL(CPR.VALOR_RECAUDADO,0)&#xA;,CPR.FECHA_RECAUDO&#xA;,ISNULL(CPR.NUMERO_ORDEN_SERVICIO,0)&#xA;,CPR.FECHA_RECAUDO_EFECTY&#xA;,isnull(CPR.ID_CLIENTE,'0') ID_CLIENTE&#xA;--,CPR.VALOR_TOTAL&#xA;--INTO #TMP_GUIAS_PENDIENTE_RECAUDO_1&#xA;FROM #COD_PENDIENTE_POR_RECAUDO CPR (NOLOCK)&#xA;WHERE LEN(CPR.NUMERO_GUIA)&gt;7&#xA;--INNER JOIN [Mece_Logistico].[dbo].[GUIAS] G (nolock) ON G.NUMERO_GUIA=CPR.NUMERO_GUIA&#xA;&#xA;--CREATE NONCLUSTERED INDEX [IX_NUMERO_GUIA] ON #TMP_GUIAS_PENDIENTE_RECAUDO_1 ([NUMERO_GUIA] ASC)&#xA;&#xA;--select GPR.* from #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA;&#xA;&#xA;UPDATE GPR SET&#xA; --GPR.NOMBRE_RESPONSABLE_ULT_MOV='SERVIENTREGA S.A.'&#xA; GPR.ID_PROCESO_ULT_MOV=SE.ID_PROCESO&#xA; ,GPR.NOMBRE_PROCESO_ULT_MOV=PRO.NOMBRE_PROCESO_LOG&#xA; ,GPR.ID_CONCEPTO_ULT_MOV=ISNULL(SE.ID_CONCEPTO,0)&#xA; ,GPR.NOMBRE_CONCEPTO_ULT_MOV=ISNULL(ICON.NOMBRE_CONCEPTO,'')&#xA; ,GPR.NUMERO_MOVIMI_ULT_MOV=SE.NUMERO_MOVIMI&#xA; ,GPR.CONSECUT_MOVIMI_ULT_MOV=SE.CONSECUT_MOVIMI&#xA; ,GPR.FECHA_HORA_MOVIMI_ULT_MOV=SE.FECHA_HORA_MOVIMIENTO&#xA; --,GPR.ID_CONDUCTOR_ULT_MOV=DOC.ID_COURIER_CONDUCTOR&#xA; --,GPR.ID_AUXILIAR_ULT_MOV=DOC.ID_AUXILIAR1_VEHICULO&#xA; --,GPR.ID_PAIS_ZONA_URBA_ULT_MOV=DOC.ID_PAIS_ZONA_URBA  &#xA; --,GPR.ID_CIUDAD_ZONA_URBA_ULT_MOV=DOC.ID_CIUDAD_ZONA_URBA &#xA; --,GPR.ID_TIPO_ZONA_URBA_ULT_MOV=DOC.ID_TIPO_ZONA_URBA&#xA; --,GPR.ID_ZONA_URBA_ULT_MOV=DOC.ID_ZONA_URBA&#xA; FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; INNER JOIN MECE_LOGISTICO.dbo.SEGUIMIENTO_ENVIO SE WITH(NOLOCK) on se.NUMERO_GUIA=GPR.NUMERO_GUIA&#xA; --INNER JOIN MECE_LOGISTICO.dbo.DOCUMENTOS DOC (NOLOCK) ON&#xA; --DOC.ID_PROCESO=GPR.[ID_PROCESO_ULT_MOV] AND DOC.NUMERO_MOVIMI=GPR.[NUMERO_MOVIMI_ULT_MOV] AND DOC.CONSECUT_MOVIMI=GPR.[CONSECUT_MOVIMI_ULT_MOV]&#xA; INNER JOIN PARAMETROS.DBO.PROCESOS PRO (NOLOCK) ON PRO.ID_PROCESO=SE.ID_PROCESO&#xA; LEFT JOIN PARAMETROS.DBO.ITEM_CONCEPTO ICON (NOLOCK) ON ICON.ID_PAIS=1 AND ICON.ID_PROCESO=SE.ID_PROCESO AND ICON.ID_CONCEPTO=SE.ID_CONCEPTO&#xA; WHERE se.FECHA_HORA_MOVIMIENTO= (select MAX(se1.FECHA_HORA_MOVIMIENTO) from MECE_LOGISTICO.dbo.SEGUIMIENTO_ENVIO SE1 WITH(NOLOCK)&#xA;          where SE1.numero_guia=GPR.NUMERO_GUIA)&#xA; &#xA; UPDATE GPR SET&#xA; GPR.ID_CONDUCTOR_ULT_MOV=DOC.ID_COURIER_CONDUCTOR&#xA; ,GPR.ID_AUXILIAR_ULT_MOV=DOC.ID_AUXILIAR1_VEHICULO&#xA; ,GPR.ID_PAIS_ZONA_URBA_ULT_MOV=DOC.ID_PAIS_ZONA_URBA  &#xA; ,GPR.ID_CIUDAD_ZONA_URBA_ULT_MOV=DOC.ID_CIUDAD_ZONA_URBA &#xA; ,GPR.ID_TIPO_ZONA_URBA_ULT_MOV=DOC.ID_TIPO_ZONA_URBA&#xA; ,GPR.ID_ZONA_URBA_ULT_MOV=DOC.ID_ZONA_URBA&#xA; FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; INNER JOIN MECE_LOGISTICO.DBO.DOCUMENTOS DOC (NOLOCK) ON&#xA; DOC.ID_PROCESO=GPR.[ID_PROCESO_ULT_MOV] AND DOC.NUMERO_MOVIMI=GPR.[NUMERO_MOVIMI_ULT_MOV] AND DOC.CONSECUT_MOVIMI=GPR.[CONSECUT_MOVIMI_ULT_MOV]&#xA;&#xA; --SELECT GPR.ID_CONDUCTOR_ULT_MOV&#xA; &#xA; UPDATE GPR SET&#xA; GPR.ID_CONDUCTOR_ULT_MOV=ISNULL(RTRIM(LTRIM(EC.ID_EMPLEADO)),'')&#xA; ,GPR.CONDUCTOR_ULT_MOV =ISNULL(RTRIM(LTRIM(EC.NOMBRE_EMPLEADO)) +' '+ RTRIM(LTRIM(EC.APELLIDO_EMPLEADO)),'') &#xA; ,GPR.ID_AUXILIAR_ULT_MOV=ISNULL(RTRIM(LTRIM(EA.ID_EMPLEADO)),'')&#xA; ,GPR.AUXILIAR_ULT_MOV=ISNULL(RTRIM(LTRIM(EA.NOMBRE_EMPLEADO)) +' '+ RTRIM(LTRIM(EA.APELLIDO_EMPLEADO)),'') &#xA; FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; LEFT JOIN PARAMETROS.DBO.EMPLEADOS EC (NOLOCK) ON EC.ID_EMPLEADO=GPR.ID_CONDUCTOR_ULT_MOV&#xA; LEFT JOIN PARAMETROS.DBO.EMPLEADOS EA (NOLOCK) ON EA.ID_EMPLEADO=GPR.ID_AUXILIAR_ULT_MOV&#xA;&#xA;&#xA; --SELECT GPR.NUMERO_GUIA,ISNULL(DIV.NOMBRE_DIVISION,'') AS NOMBRE_CDS, ISNULL(CTCAN.[NOMBRE_CLASE_TIPO_CANAL],'') as TIPO_CANAL&#xA;UPDATE GPR SET NOMBRE_CDS_ULT_MOV=ISNULL(DIV.NOMBRE_DIVISION,''),&#xA; TIPO_CANAL_ULT_MOV=ISNULL(CTCAN.[NOMBRE_CLASE_TIPO_CANAL],'')&#xA; FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; --INNER JOIN MECE_LOGISTICO.DBO.DOCUMENTOS DOC (NOLOCK) ON&#xA; --DOC.ID_PROCESO=GPR.[ID_PROCESO_ULT_MOV] AND DOC.NUMERO_MOVIMI=GPR.[NUMERO_MOVIMI_ULT_MOV] AND DOC.CONSECUT_MOVIMI=GPR.[CONSECUT_MOVIMI_ULT_MOV]&#xA; INNER JOIN PARAMETROS.DBO.ZONASURBANAS Z (NOLOCK) &#xA; ON Z.ID_PAIS = GPR.ID_PAIS_ZONA_URBA_ULT_MOV AND Z.ID_CIUDAD = GPR.ID_CIUDAD_ZONA_URBA_ULT_MOV &#xA;  AND Z.ID_TIPO_ZONA_URBA = GPR.ID_TIPO_ZONA_URBA_ULT_MOV AND Z.ID_ZONA_URBA = GPR.ID_ZONA_URBA_ULT_MOV --AND Z.CATEGORIA_ZONA_URBA = 8 --CLICOH&#xA; INNER JOIN PARAMETROS.DBO.DIVISIONES DIV (NOLOCK) ON DIV.ID_PAIS = Z.ID_PAIS_CANAL AND DIV.ID_CIUDAD = Z.ID_CIUDAD_CANAL AND DIV.ID_DIVISION = Z.ID_CANAL&#xA; INNER JOIN [Mece_Logistico].[dbo].[CANALES] CAN (NOLOCK) ON CAN.id_pais=DIV.ID_PAIS and CAN.id_ciudad=DIV.ID_CIUDAD and CAN.[ID_DIVISION]=DIV.ID_DIVISION&#xA; INNER JOIN [Mece_Logistico].[dbo].[TIPOS_CANAL] TCAN (NOLOCK) ON TCAN.ID_TIPO_CANAL=CAN.ID_TIPO_CANAL AND TCAN.ID_EST_TIPO_CANAL=1&#xA; INNER JOIN PARAMETROS.[dbo].[CLASE_TIPO_CANAL] CTCAN (NOLOCK) ON CTCAN.ID_CLASE_TIPO_CANAL=TCAN.CLASE_TIPO_CANAL&#xA;&#xA;&#xA; --UPDATE GPR SET ESTADO_ENTREGA='VENCIDO'&#xA; --SELECT * FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; UPDATE GPR SET ESTADO_ENTREGA='VENCIDO'&#xA; FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; WHERE GPR.ID_PROCESO_ULT_MOV=9 AND ID_CONCEPTO_ULT_MOV IN(9,7,2,4)--9 ENTREGAS OFIC  C.O.D. Y/O LPC EMPRESARIO --7 EMPRESARIO SATELITE ENTREGA EN OFICINA&#xA; --2 RECLAMO OFICINA Y 4 C.O.D RECLAMO OFICINA&#xA; AND DATEDIFF(DAY, FECHA_HORA_MOVIMI_ULT_MOV,GETDATE())&gt;8 -- MAS DE 8 DIAS&#xA; &#xA; UPDATE GPR SET ESTADO_ENTREGA='VENCIDO'&#xA; FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; WHERE GPR.ID_PROCESO_ULT_MOV=31 --ENVIO PARA ENTREGA EN OFICINA&#xA; AND DATEDIFF(DAY, FECHA_HORA_MOVIMI_ULT_MOV,GETDATE())&gt;8 -- MAS DE 8 DIAS&#xA;&#xA; UPDATE GPR SET ESTADO_ENTREGA='VENCIDO'&#xA; FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; WHERE GPR.ID_PROCESO_ULT_MOV=9 AND ID_CONCEPTO_ULT_MOV IN(10,8) --10 ENTR A DOMICI  LPC / COD EMPRESARIOS SAT --8 EMPRESARIO SATELITE ENTREGA EN DOMICILIO&#xA; AND DATEDIFF(DAY, FECHA_HORA_MOVIMI_ULT_MOV,GETDATE())&gt;3-- MAS DE 3 DIAS&#xA; &#xA; UPDATE GPR SET ESTADO_ENTREGA='VENCIDO'&#xA; FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; WHERE GPR.ID_PROCESO_ULT_MOV=32 --ENVIO PARA ENTREGA A DOMICILIO&#xA; AND DATEDIFF(DAY, FECHA_HORA_MOVIMI_ULT_MOV,GETDATE())&gt;3-- MAS DE 3 DIAS&#xA;&#xA; UPDATE GPR SET ESTADO_ENTREGA='VENCIDO'&#xA; FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; WHERE GPR.ID_PROCESO_ULT_MOV=9 AND ID_CONCEPTO_ULT_MOV IN(1,3) --SALIDA A ZONA Y C.O.D EN DISTRIBUCION&#xA; AND DATEDIFF(DAY, FECHA_HORA_MOVIMI_ULT_MOV,GETDATE())&gt;1 --MAS DE UN DIA&#xA;&#xA;&#xA;&#xA;DROP TABLE IF EXISTS #TMP_GUIAS_PENDIENTE_RECAUDO_SZU&#xA; SELECT &#xA; TMP.NUMERO_GUIA&#xA; ,MIN(SE.CONSECUT_MOVIMI)   AS CONSECUT_MOVIMI_SZU&#xA; ,MIN(SE.NUMERO_MOVIMI)    AS NUMERO_MOVIMI_SZU&#xA; ,MIN(SE.FECHA_HORA_MOVIMIENTO)  AS FECHA_HORA_MOVIMI_ULT_MOV_SZU&#xA;INTO #TMP_GUIAS_PENDIENTE_RECAUDO_SZU&#xA;FROM #TMP_GUIAS_PENDIENTE_RECAUDO TMP&#xA;INNER JOIN Mece_Logistico..SEGUIMIENTO_ENVIO SE&#xA;ON SE.NUMERO_GUIA=TMP.NUMERO_GUIA&#xA;WHERE SE.ID_PROCESO=9&#xA;GROUP BY  TMP.NUMERO_GUIA&#xA;&#xA;;WITH CTE AS(&#xA;SELECT &#xA;ROWID = ROW_NUMBER() OVER(PARTITION BY NUMERO_GUIA ORDER BY FECHA_HORA_MOVIMI_ULT_MOV_SZU DESC)&#xA;,NUMERO_GUIA,FECHA_HORA_MOVIMI_ULT_MOV_SZU&#xA;FROM #TMP_GUIAS_PENDIENTE_RECAUDO_SZU&#xA;)&#xA;DELETE CTE WHERE ROWID&gt;1&#xA;&#xA;&#xA;DROP TABLE IF EXISTS ##TMP_GUIAS_PENDIENTE_RECAUDO_FINAL_PBI;&#xA;SELECT --GPR.*&#xA;GPR.NUMERO_GUIA &#xA;--GPR.ID_ESTADOENVIO &#xA;,GPR.NOMBRE_ESTADOENVIO &#xA;,GPR.FORMA_PAGO &#xA;,GPR.VALOR_A_RECAUDAR &#xA;,GPR.ID_REMITE &#xA;,GPR.NOMBRE_REMITE_GUIA &#xA;,GPR.FECHA_ENVIO&#xA;,GPR.VALOR_RECAUDADO&#xA;,GPR.FECHA_RECAUDO&#xA;,GPR.NUMERO_ORDEN_SERVICIO&#xA;,GPR.FECHA_RECAUDO_EFECTY&#xA;,GPR.ESTADO_ENTREGA&#xA;--,GPR.NOMBRE_RESPONSABLE_ULT_MOV &#xA;--ID_PROCESO_ULT_MOV &#xA;--NOMBRE_PROCESO_ULT_MOV &#xA;--NUMERO_MOVIMI_ULT_MOV &#xA;--CONSECUT_MOVIMI_ULT_MOV &#xA;--FECHA_HORA_MOVIMI_ULT_MOV&#xA;&#xA;--,ISNULL(ISNULL(CLO.CENTRO_LOGISTICO,CLD.CENTRO_LOGISTICO),'')  AS CPL_ORIGEN_ULT_MOV&#xA;--,ISNULL(ISNULL(RO.NOMBRE_REGIONAL,RD.NOMBRE_REGIONAL),'')  AS REGIONAL_ORIGEN_ULT_MOV&#xA;--,ISNULL(ISNULL(CO.NOMBRE_CIUDAD,CD.NOMBRE_CIUDAD),'')  AS CIUDAD_ORIGEN_ULT_MOV&#xA;--,ISNULL(ISNULL(CLD.CENTRO_LOGISTICO,CLO.CENTRO_LOGISTICO),'') AS CPL_DESTINO_ULT_MOV&#xA;--,ISNULL(ISNULL(RD.NOMBRE_REGIONAL,RO.NOMBRE_REGIONAL),'') AS REGIONAL_DESTINO_ULT_MOV&#xA;--,ISNULL(ISNULL(CD.NOMBRE_CIUDAD,CO.NOMBRE_CIUDAD),'') AS CIUDAD_DESTINO_MOV&#xA;,CASE WHEN ID_PROCESO!=14 THEN &#xA;ISNULL(ISNULL(CLO.CENTRO_LOGISTICO,CLD.CENTRO_LOGISTICO),'')  ELSE ISNULL(ISNULL(CLD.CENTRO_LOGISTICO,CLO.CENTRO_LOGISTICO),'') END AS CPL_ULT_MOV&#xA;,CASE WHEN ID_PROCESO!=14 THEN &#xA;ISNULL(ISNULL(RO.NOMBRE_REGIONAL,RD.NOMBRE_REGIONAL),'') ELSE ISNULL(ISNULL(RD.NOMBRE_REGIONAL,RO.NOMBRE_REGIONAL),'') END  AS REGIONAL_ULT_MOV&#xA;,CASE WHEN ID_PROCESO!=14 THEN &#xA;ISNULL(ISNULL(CO.NOMBRE_CIUDAD,CD.NOMBRE_CIUDAD),'')  ELSE ISNULL(ISNULL(CD.NOMBRE_CIUDAD,CO.NOMBRE_CIUDAD),'') END  AS CIUDAD_ULT_MOV&#xA;,ISNULL(CASE &#xA; WHEN ISNULL(DOC.ID_CIUDAD_ZONA_URBA,0) !=0 THEN&#xA; ROZ.NOMBRE_REGIONAL+' - '+ DCOZ.NOMBRE_DEPARTAMENTO +' - '+ COZ.NOMBRE_CIUDAD &#xA; WHEN  ISNULL(DOC.ID_CIUDAD_DIVISION_ORIGEN,0) !=0 AND DOC.ID_PROCESO!=14 THEN&#xA; ROM.NOMBRE_REGIONAL+' - '+ DCOM.NOMBRE_DEPARTAMENTO +' - '+ COM.NOMBRE_CIUDAD&#xA; ELSE&#xA; ROD.NOMBRE_REGIONAL+' - '+ DCOD.NOMBRE_DEPARTAMENTO +' - '+ COD.NOMBRE_CIUDAD &#xA; END,'') AS REG_DEPART_CIUDAD_ULTIMO_MOV&#xA;&#xA;,ISNULL(DOC.PLACA_VEHICULO_DOCU,'') as PLACA_VEHICULO_ULTIMO_MOV&#xA;,ISNULL(O.[NOMBRE_OPERATIVO],'') AS NOMBRE_OPERATIVO_ULTIMO_MOV&#xA;,ISNULL(Z.NOMBRE_ZONA_URBA,'') AS ZONA_URBANA_ULTIMO_MOV&#xA;,ISNULL(CZ.NOMBRE_CATEGORIA,'') AS CATEGORIA_ZONA_ULTIMO_MOV&#xA;,ISNULL(TZU.NOMBRE_TIPO_ZONA_URBA,'') AS TIPO_ZONA_ULTIMO_MOV&#xA;,ISNULL(GPR.NOMBRE_CDS_ULT_MOV,'') AS NOMBRE_CDS_ULT_MOV&#xA;,ISNULL(TIPO_CANAL_ULT_MOV,'') AS TIPO_CANAL_ULT_MOV&#xA;--,GR.ID_PROCESO &#xA;,ISNULL(GPR.NOMBRE_PROCESO_ULT_MOV,'') AS PROCESO_LOG_ULTIMO_MOV  &#xA;,ISNULL(GPR.NOMBRE_CONCEPTO_ULT_MOV,'') AS CONCEPTO_ULT_MOV&#xA;--,GR.ID_CONCEPTO  &#xA;--,GR.FECHA_HORA_MOVIMIENTO&#xA;,ISNULL(cast(GPR.ID_PROCESO_ULT_MOV as nvarchar) +' - '+ RTRIM(GPR.NOMBRE_PROCESO_ULT_MOV),'') AS NOMBRE_ULTIMO_MOV&#xA;,ISNULL(CASE WHEN DIO.ID_DIVISION IS NOT NULL THEN cast(DIO.ID_DIVISION as nvarchar) +' - '+ RTRIM(DIO.NOMBRE_DIVISION)&#xA;ELSE cast(DID.ID_DIVISION as nvarchar) +' - '+ RTRIM(DID.NOMBRE_DIVISION) END,'') AS BODEGA_ULTIMO_MOV&#xA;,ISNULL(cast(GPR.ID_PROCESO_ULT_MOV as nvarchar) +' - '+ RTRIM(GPR.[NUMERO_MOVIMI_ULT_MOV])+' - '+  cast(GPR.[CONSECUT_MOVIMI_ULT_MOV] as nvarchar),'') as ULTIMO_MOV_LOGISTICO&#xA;,ISNULL(CONVERT(nvarchar(20),GPR.FECHA_HORA_MOVIMI_ULT_MOV,120),'') AS FECHA_ULTIMO_MOV&#xA;,GPR.ID_CONDUCTOR_ULT_MOV&#xA;,GPR.CONDUCTOR_ULT_MOV&#xA;,GPR.ID_AUXILIAR_ULT_MOV&#xA;,GPR.AUXILIAR_ULT_MOV&#xA;,GPR.ID_CLIENTE&#xA;,SZU.CONSECUT_MOVIMI_SZU&#xA;,SZU.NUMERO_MOVIMI_SZU&#xA;,SZU.FECHA_HORA_MOVIMI_ULT_MOV_SZU&#xA;--,DOC.*&#xA;INTO ##TMP_GUIAS_PENDIENTE_RECAUDO_FINAL_PBI&#xA;&#xA;FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA;--------------------------- CIUDAD ULTIMO MOV ZONA&#xA;  LEFT JOIN MECE_LOGISTICO.DBO.DOCUMENTOS DOC (NOLOCK) ON&#xA; DOC.ID_PROCESO=GPR.[ID_PROCESO_ULT_MOV] AND DOC.NUMERO_MOVIMI=GPR.[NUMERO_MOVIMI_ULT_MOV] AND DOC.CONSECUT_MOVIMI=GPR.[CONSECUT_MOVIMI_ULT_MOV]&#xA; --AND DOC.ID_DIVISION_DESTINO IN (9311, 9308, 9304, 9313, 9310, 9312, 9711, 9710)&#xA;  LEFT JOIN PARAMETROS.DBO.CIUDADES COZ (NOLOCK) ON  COZ.ID_PAIS=1 AND COZ.ID_CIUDAD=DOC.ID_CIUDAD_ZONA_URBA&#xA;  LEFT JOIN PARAMETROS.DBO.REGIONALES_PAIS ROZ (NOLOCK) ON  ROZ.ID_PAIS=COZ.ID_PAIS AND ROZ.ID_REGIONAL=COZ.ID_REGIONAL&#xA;  LEFT JOIN PARAMETROS.DBO.DEPARTAMENTOS DCOZ (NOLOCK) ON  DCOZ.ID_PAIS=COZ.ID_PAIS AND DCOZ.ID_DEPARTAMENTO=COZ.ID_DEPARTAMENTO&#xA;   LEFT JOIN PARAMETROS.DBO.ZONASURBANAS Z (NOLOCK) &#xA; ON Z.ID_PAIS = DOC.ID_PAIS_ZONA_URBA AND Z.ID_CIUDAD = DOC.ID_CIUDAD_ZONA_URBA AND Z.ID_TIPO_ZONA_URBA = DOC.ID_TIPO_ZONA_URBA AND Z.ID_ZONA_URBA = DOC.ID_ZONA_URBA --AND Z.CATEGORIA_ZONA_URBA = 8 --CLICOH&#xA;  LEFT JOIN [PARAMETROS].[dbo].[CATEGORIAZONASURBANAS] CZ (NOLOCK) ON CZ.Id_Categoria=Z.CATEGORIA_ZONA_URBA&#xA;  LEFT JOIN [PARAMETROS].[dbo].[TIPOSZONASURBANAS] TZU (NOLOCK) ON TZU.ID_TIPO_ZONA_URBA=Z.ID_TIPO_ZONA_URBA&#xA; --------------------------- CIUDAD ULTIMO MOV DOCUMENTO&#xA;  LEFT JOIN PARAMETROS.DBO.CIUDADES COM (NOLOCK) ON  COM.ID_PAIS=1 AND COM.ID_CIUDAD=DOC.ID_CIUDAD_DIVISION_ORIGEN&#xA;  LEFT JOIN PARAMETROS.DBO.REGIONALES_PAIS ROM (NOLOCK) ON  ROM.ID_PAIS=COM.ID_PAIS AND ROM.ID_REGIONAL=COM.ID_REGIONAL&#xA;  LEFT JOIN PARAMETROS.DBO.DEPARTAMENTOS DCOM (NOLOCK) ON  DCOM.ID_PAIS=COM.ID_PAIS AND DCOM.ID_DEPARTAMENTO=COM.ID_DEPARTAMENTO&#xA;  --------------------------- CIUDAD DESTINO ULTIMO MOV DOCUMENTO&#xA;  LEFT JOIN PARAMETROS.DBO.CIUDADES COD(NOLOCK) ON  COD.ID_PAIS=1 AND COD.ID_CIUDAD=DOC.ID_CIUDAD_DESTINO&#xA;  LEFT JOIN PARAMETROS.DBO.REGIONALES_PAIS ROD (NOLOCK) ON  ROD.ID_PAIS=COD.ID_PAIS AND ROD.ID_REGIONAL=COD.ID_REGIONAL&#xA;  LEFT JOIN PARAMETROS.DBO.DEPARTAMENTOS DCOD (NOLOCK) ON  DCOD.ID_PAIS=COD.ID_PAIS AND DCOD.ID_DEPARTAMENTO=COD.ID_DEPARTAMENTO&#xA;  --------------------------- DIVISION ORIGEN ULTIMO MOV DOCUMENTO&#xA;  LEFT JOIN PARAMETROS.DBO.DIVISIONES DIO(NOLOCK) ON DIO.ID_PAIS=DOC.ID_PAIS_DIVISION_ORIGEN&#xA; AND DIO.ID_CIUDAD=DOC.ID_CIUDAD_DIVISION_ORIGEN AND DIO.ID_DIVISION=DOC.ID_DIVISION_ORIGEN&#xA;  --------------------------- DIVISION DESTINO ULTIMO MOV DOCUMENTO&#xA;  LEFT JOIN PARAMETROS.DBO.DIVISIONES DID(NOLOCK) ON DID.ID_PAIS=DOC.ID_PAIS_DESTINO&#xA; AND DID.ID_CIUDAD=DOC.ID_CIUDAD_DESTINO AND DID.ID_DIVISION=DOC.ID_DIVISION_DESTINO&#xA;-------------------------------------------------------------&#xA;  LEFT JOIN [PARAMETROS].[dbo].CIUDADES CO (NOLOCK) ON CO.ID_PAIS=ID_PAIS_DIVISION_ORIGEN AND CO.ID_CIUDAD=DOC.ID_CIUDAD_DIVISION_ORIGEN&#xA;  LEFT JOIN [PARAMETROS].[dbo].REGIONALES_PAIS RO (NOLOCK) ON RO.ID_PAIS=1 AND RO.ID_REGIONAL=CO.[ID_REGIONAL]&#xA;  LEFT JOIN [PARAMETROS].[dbo].CIUDADES CD (NOLOCK) ON CD.ID_PAIS=DOC.ID_PAIS_DESTINO AND CD.ID_CIUDAD=DOC.ID_CIUDAD_DESTINO&#xA;  LEFT JOIN [PARAMETROS].[dbo].REGIONALES_PAIS RD (NOLOCK) ON RD.ID_PAIS=1 AND RD.ID_REGIONAL=CD.[ID_REGIONAL]&#xA;  LEFT JOIN [PARAMETROS].[dbo].[OPERATIVOS] O (NOLOCK) ON O.[ID_PAIS_ORIGEN]=DOC.ID_PAIS_OPERATIVO AND O.[ID_CIUDAD_ORIGEN]=DOC.ID_CIUDAD_OPERATIVO&#xA; AND O.[ID_OPERATIVO]=DOC.ID_OPERATIVO&#xA;  LEFT JOIN #TMP_CIUDADES_ANEXAS CAO (NOLOCK) ON CAO.ID_PAIS=1 AND CAO.[ID_CIUDAD_ANEXA]=CO.ID_CIUDAD --AND CAO.RECOLECCION=1&#xA;  LEFT JOIN PARAMETROS.DBO.CENTROS_LOGISTICOS CLO (NOLOCK) ON CLO.ID_PAIS=1 AND CLO.ID_CIUDAD=CAO.ID_CIUDAD AND CLO.ID_CENTRO_LOGISTICO=1 AND CLO.ID_ESTADO=1&#xA;  LEFT JOIN #TMP_CIUDADES_ANEXAS CAD (NOLOCK) ON CAD.ID_PAIS=1 AND CAD.[ID_CIUDAD_ANEXA]=CD.ID_CIUDAD --AND CAD.RECOLECCION=1&#xA;  LEFT JOIN PARAMETROS.DBO.CENTROS_LOGISTICOS CLD (NOLOCK) ON CLD.ID_PAIS=1 AND CLD.ID_CIUDAD=CAD.ID_CIUDAD AND CLD.ID_CENTRO_LOGISTICO=1 AND CLD.ID_ESTADO=1&#xA;LEFT JOIN #TMP_GUIAS_PENDIENTE_RECAUDO_SZU SZU ON SZU.NUMERO_GUIA=GPR.NUMERO_GUIA&#xA;--WHERE &#xA;--NUMERO_GUIA=2273736466&#xA;--ID_PROCESO=32&#xA;&#xA;--DELETE CPR FROM #TMP_GUIAS_PENDIENTE_RECAUDO CPR &#xA;--WHERE&#xA;--NOT EXISTS (SELECT TOP 1 SE.NUMERO_GUIA FROM Mece_Logistico.DBO.SEGUIMIENTO_ENVIO SE (NOLOCK) WHERE SE.NUMERO_GUIA=CPR.NUMERO_GUIA AND SE.ID_PROCESO&gt;=5 AND  SE.ID_PROCESO&lt;27)&#xA;&#xA;&#xA;&#xA;--select  COUNT(1) from #TMP_GUIAS_PENDIENTE_RECAUDO&#xA;--select  COUNT(1) from ##TMP_GUIAS_PENDIENTE_RECAUDO_FINAL_PBI&#xA;----select  * from ##TMP_GUIAS_PENDIENTE_RECAUDO_FINAL_PBI&#xA;&#xA;&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="0"
                SQLTask:DtsVariableName="User::STR_FechaIni"
                SQLTask:ParameterDirection="Input"
                SQLTask:DataType="129"
                SQLTask:ParameterSize="-1" />
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="1"
                SQLTask:DtsVariableName="User::STR_FechaFin"
                SQLTask:ParameterDirection="Input"
                SQLTask:DataType="129"
                SQLTask:ParameterSize="-1" />
            </SQLTask:SqlTaskData>
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Tareas Backap\Prepatacion data Recudo LPC COD 3"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:Disabled="True"
          DTS:DTSID="{76c0d570-4d50-42bd-8440-5a81febdfc75}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Prepatacion data Recudo LPC COD 3"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="9">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{20AF370D-4C8E-4E05-91E7-8F81200FAADC}"
              SQLTask:SqlStatementSource="&#xA;IF OBJECT_ID('tempdb..#COD_PENDIENTE_POR_RECAUDO') IS NOT NULL &#xA;    DROP TABLE #COD_PENDIENTE_POR_RECAUDO&#xA;&#xA;IF OBJECT_ID('tempdb..#TMP_GUIAS_PENDIENTE_RECAUDO') IS NOT NULL &#xA;    DROP TABLE #TMP_GUIAS_PENDIENTE_RECAUDO&#xA;&#xA;CREATE TABLE #TMP_GUIAS_PENDIENTE_RECAUDO(&#xA; NUMERO_GUIA numeric(20, 0) NOT NULL,&#xA; ID_ESTADOENVIO smallint DEFAULT 0,&#xA; NOMBRE_ESTADOENVIO varchar(40) DEFAULT '',&#xA; FORMA_PAGO varchar(40) DEFAULT '',&#xA; VALOR_A_RECAUDAR numeric(12, 2) NULL,&#xA; ID_REMITE [varchar](40) DEFAULT '',&#xA; NOMBRE_REMITE_GUIA  [varchar](200) DEFAULT '',&#xA;-- ID_CIUDAD INT DEFAULT 0,&#xA;-- [NOMBRE_CIUDAD] [varchar](50) DEFAULT '',&#xA; FECHA_ENVIO datetime NULL,&#xA; [VALOR_RECAUDADO] [numeric](11, 2) DEFAULT 0,&#xA; FECHA_RECAUDO datetime NULL,&#xA; NUMERO_ORDEN_SERVICIO varchar(20) DEFAULT '',&#xA; FECHA_RECAUDO_EFECTY datetime NULL,&#xA; ESTADO_ENTREGA varchar(70) DEFAULT 'A TIEMPO',--A TIEMPO O VENCIDO&#xA; --NOMBRE_RESPONSABLE_ULT_MOV VARCHAR(100) DEFAULT '',&#xA; ID_PROCESO_ULT_MOV int DEFAULT 0,&#xA; NOMBRE_PROCESO_ULT_MOV varchar(70) DEFAULT '',&#xA; ID_CONCEPTO_ULT_MOV int DEFAULT 0,&#xA; NOMBRE_CONCEPTO_ULT_MOV varchar(70) DEFAULT '',&#xA; NUMERO_MOVIMI_ULT_MOV char(30) DEFAULT '',&#xA; CONSECUT_MOVIMI_ULT_MOV numeric(7, 0) DEFAULT 0,&#xA; FECHA_HORA_MOVIMI_ULT_MOV datetime NULL,&#xA; ID_PAIS_ZONA_URBA_ULT_MOV SMALLINT NULL,&#xA; ID_CIUDAD_ZONA_URBA_ULT_MOV INT NULL,&#xA; ID_TIPO_ZONA_URBA_ULT_MOV SMALLINT NULL,&#xA; ID_ZONA_URBA_ULT_MOV SMALLINT NULL,&#xA; NOMBRE_CDS_ULT_MOV varchar(100) DEFAULT '',&#xA; TIPO_CANAL_ULT_MOV varchar(40) DEFAULT '',&#xA; ID_CONDUCTOR_ULT_MOV varchar(40) DEFAULT '',&#xA; CONDUCTOR_ULT_MOV  varchar(200) DEFAULT '',&#xA; ID_AUXILIAR_ULT_MOV varchar(40) DEFAULT '',&#xA; AUXILIAR_ULT_MOV varchar(200) DEFAULT '',&#xA; ID_CLIENTE [char](20) NOT NULL,&#xA; NOMBRE_TIPO_CANAL varchar(100) DEFAULT '',&#xA; NOMBRE_CLASE_TIPO_CANAL varchar(100) DEFAULT ''&#xA;) ON [PRIMARY]&#xA;CREATE NONCLUSTERED INDEX [IX_NUMERO_GUIA] ON #TMP_GUIAS_PENDIENTE_RECAUDO ([NUMERO_GUIA] ASC)&#xA;CREATE NONCLUSTERED INDEX [IX_ZONA] ON #TMP_GUIAS_PENDIENTE_RECAUDO (ID_PAIS_ZONA_URBA_ULT_MOV,ID_CIUDAD_ZONA_URBA_ULT_MOV, ID_TIPO_ZONA_URBA_ULT_MOV,ID_ZONA_URBA_ULT_MOV ASC)&#xA;CREATE NONCLUSTERED INDEX [IX_MANIFIESTO] ON #TMP_GUIAS_PENDIENTE_RECAUDO (ID_PROCESO_ULT_MOV,NUMERO_MOVIMI_ULT_MOV,CONSECUT_MOVIMI_ULT_MOV ASC)&#xA;&#xA;&#xA;IF OBJECT_ID('tempdb..#TMP_CIUDADES_ANEXAS') IS NOT NULL &#xA;    DROP TABLE #TMP_CIUDADES_ANEXAS&#xA;&#xA;---CIUDADES ANEXAS&#xA;SELECT CAD.* &#xA;INTO #TMP_CIUDADES_ANEXAS FROM PARAMETROS.DBO.CIUDADES_ANEXAS CAD (NOLOCK) &#xA;WHERE CAD.ID_PAIS=1 AND CAD.RECOLECCION=1&#xA;&#xA;INSERT INTO #TMP_CIUDADES_ANEXAS&#xA;SELECT CAD.* FROM PARAMETROS.DBO.CIUDADES_ANEXAS CAD (NOLOCK) &#xA;LEFT JOIN #TMP_CIUDADES_ANEXAS TCAD ON TCAD.ID_CIUDAD_ANEXA=CAD.ID_CIUDAD_ANEXA&#xA;WHERE CAD.ID_PAIS=1 AND CAD.RECOLECCION=0 AND TCAD.ID_CIUDAD_ANEXA IS NULL&#xA;&#xA;DELETE T FROM (SELECT *, &#xA;    DupRank = ROW_NUMBER() OVER (PARTITION BY ID_CIUDAD_ANEXA ORDER BY FECHA_CREACION DESC) &#xA;     FROM #TMP_CIUDADES_ANEXAS) AS T&#xA;WHERE DupRank &gt; 1&#xA;&#xA;&#xA;&#xA;SELECT CPR.*,G.ID_CLIENTE,G.ID_REMITE,G.NOMBRE_REMITE_GUIA,G.ID_PRODUCTO AS ID_PRODUCTO_GUIA,G.ID_ESTADOENVIO,G.ID_ESTADOGUIA,ISNULL(G.VALOR_SEG_MAN_GUIAS,0)+ISNULL(G.VALOR_FLETES_GUIAS,0) AS VALOR_ENVIO_GUIA,ISNULL(GIA.VALOR_RECAUDAR_PRODUCTO,0) AS VALOR_RECAUDAR_PRODUCTO_GUIA&#xA;,CAST('' AS nvarchar(50)) AS NOMBRE_ESTADOENVIO,G.FECHA_ENVIO&#xA;,TCAN.NOMBRE_TIPO_CANAL&#xA;,CTCAN.NOMBRE_CLASE_TIPO_CANAL&#xA;INTO #COD_PENDIENTE_POR_RECAUDO&#xA;FROM [Mece_Logistico].[dbo].[COD_PENDIENTE_POR_RECAUDO] CPR (NOLOCK)&#xA;INNER JOIN [Mece_Logistico].[dbo].[GUIAS] G (nolock) ON G.NUMERO_GUIA=CPR.NUMERO_GUIA&#xA;LEFT JOIN [Mece_Logistico].[dbo].[GUIAS_INF_ADICIONAL] GIA (nolock) ON GIA.NUMERO_GUIA=CPR.NUMERO_GUIA&#xA;LEFT JOIN [tmp_borrar_local].dbo.LPC_GUIAS_SOLUCIONADAS LGS (NOLOCK) ON LGS.NUMERO_GUIA=CPR.NUMERO_GUIA&#xA;LEFT JOIN [Mece_Logistico].[dbo].[CANALES] CAN (NOLOCK) ON CAN.id_pais=G.ID_1 and CAN.id_ciudad=G.ID_2 and CAN.[ID_DIVISION]=G.ID_CANAL&#xA;LEFT JOIN [Mece_Logistico].[dbo].[TIPOS_CANAL] TCAN (NOLOCK) ON TCAN.ID_TIPO_CANAL=CAN.ID_TIPO_CANAL AND TCAN.ID_EST_TIPO_CANAL=1&#xA;LEFT JOIN PARAMETROS.[dbo].[CLASE_TIPO_CANAL] CTCAN (NOLOCK) ON CTCAN.ID_CLASE_TIPO_CANAL=TCAN.CLASE_TIPO_CANAL&#xA;WHERE LGS.NUMERO_GUIA IS NULL AND&#xA;ISNULL(CPR.ESTADO_COD,1)=1-- RECAUDO ESTA ACTIVO&#xA;AND ISNULL(CPR.ESTA_RECAUDADO,0)=0 -- NO ESTA RECAUDADO&#xA;--AND G.ID_ESTADOGUIA!=4-- NO ESTA ANULADA&#xA;AND ISNULL(CPR.NUMERO_ORDEN_SERVICIO,'')='' -- NO TIENE ORDEN DE RECAUDO DE EFECTY&#xA;AND ISNULL(CPR.ESTA_ANULADO,0)=0 -- NO DEBE ESTAR ANULADA&#xA;AND G.ID_DIVISION_PROV IS NULL&#xA;--AND CPR.FECHA_CREACION &gt;= @FECHA_INI &#xA;--AND CPR.FECHA_CREACION &lt; @FECHA_FIN&#xA;&#xA;AND CPR.FECHA_CREACION BETWEEN convert(datetime,?) AND convert(datetime,?)&#xA;/*&#xA;AND CPR.FECHA_CREACION BETWEEN convert(datetime,'20251201') &#xA;       AND convert(datetime,'20260201')&#xA;*/&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;/*&#xA;select G.NUMERO_GUIA&#xA;,TCAN.NOMBRE_TIPO_CANAL&#xA;,CTCAN.NOMBRE_CLASE_TIPO_CANAL&#xA;from Mece_Logistico.dbo.guias G (nolock)&#xA;left JOIN [Mece_Logistico].[dbo].[CANALES] CAN (NOLOCK) ON CAN.id_pais=G.ID_1 and CAN.id_ciudad=G.ID_2 and CAN.[ID_DIVISION]=G.ID_CANAL&#xA;left JOIN [Mece_Logistico].[dbo].[TIPOS_CANAL] TCAN (NOLOCK) ON TCAN.ID_TIPO_CANAL=CAN.ID_TIPO_CANAL AND TCAN.ID_EST_TIPO_CANAL=1&#xA;left JOIN PARAMETROS.[dbo].[CLASE_TIPO_CANAL] CTCAN (NOLOCK) ON CTCAN.ID_CLASE_TIPO_CANAL=TCAN.CLASE_TIPO_CANAL&#xA;where G.ID_CANAL IS NOT NULL&#xA;AND FECHA_ENVIO&gt;='20260120 00:00:00'&#xA;*/&#xA;&#xA;&#xA;&#xA;&#xA;------------------------------------------------------------------------------------------------------------------------------------------------------------------&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;CREATE NONCLUSTERED INDEX [IX_NUMERO_GUIA] ON #COD_PENDIENTE_POR_RECAUDO ([NUMERO_GUIA] ASC)&#xA;&#xA;&#xA;--Se quitan envios siniestrados&#xA;DELETE GPR FROM #COD_PENDIENTE_POR_RECAUDO GPR&#xA;WHERE ID_ESTADOENVIO in(5,4)&#xA;&#xA;--Quita las guias son del canal retail y no son COD y no contraentrega ecommerce&#xA;DELETE GPR FROM #COD_PENDIENTE_POR_RECAUDO GPR&#xA;WHERE ID_FORMA_PAGO=1 AND ID_PRODUCTO!=86&#xA;&#xA;&#xA;--SELECT * FROM #COD_PENDIENTE_POR_RECAUDO CPR (NOLOCK)&#xA;--WHERE --NUMERO_GUIA=2143658629&#xA;--ID_PRODUCTO=86&#xA;--INSERT INTO #TMP_GUIAS_PENDIENTE_RECAUDO&#xA;&#xA;UPDATE CPR SET CPR.NOMBRE_ESTADOENVIO=E.NOMBRE_ESTADOENVIO&#xA;FROM #COD_PENDIENTE_POR_RECAUDO CPR&#xA;INNER JOIN PARAMETROS.DBO.ESTADOSENVIO E (NOLOCK)ON E.ID_ESTADOENVIO=CPR.ID_ESTADOENVIO&#xA;&#xA;--TRUNCATE TABLE #TMP_GUIAS_PENDIENTE_RECAUDO&#xA;INSERT INTO #TMP_GUIAS_PENDIENTE_RECAUDO(&#xA;NUMERO_GUIA,&#xA;ID_ESTADOENVIO,&#xA;NOMBRE_ESTADOENVIO,&#xA;FORMA_PAGO,&#xA;VALOR_A_RECAUDAR,&#xA;ID_REMITE,&#xA;NOMBRE_REMITE_GUIA,&#xA;FECHA_ENVIO,&#xA;VALOR_RECAUDADO,&#xA;FECHA_RECAUDO,&#xA;NUMERO_ORDEN_SERVICIO,&#xA;FECHA_RECAUDO_EFECTY,&#xA;ID_CLIENTE,&#xA;NOMBRE_TIPO_CANAL,&#xA;NOMBRE_CLASE_TIPO_CANAL&#xA;)&#xA;SELECT CPR.NUMERO_GUIA,CPR.ID_ESTADOENVIO,CPR.NOMBRE_ESTADOENVIO,&#xA;CASE WHEN CPR.ID_FORMA_PAGO=4 AND CPR.ID_CLIENTE IS NULL THEN 'C.O.D.' WHEN ISNULL(CPR.ID_PRODUCTO,CPR.ID_PRODUCTO_GUIA)=86 THEN 'CONTRAENTREGA ECOMMERCE' WHEN (CPR.ID_FORMA_PAGO=2 OR CPR.ID_CLIENTE IS NOT NULL) THEN 'LPC' ELSE '' END AS FORMA_PAGO,&#xA;CASE WHEN ISNULL(CPR.VALOR_TOTAL,0)!=0 THEN CPR.VALOR_TOTAL&#xA;WHEN CPR.ID_FORMA_PAGO=4 AND VALOR_FLETE IS NOT NULL THEN ISNULL(CPR.VALOR_FLETE,0) + ISNULL(CPR.VALOR_OTROS,0)&#xA;WHEN CPR.ID_FORMA_PAGO=4 AND VALOR_FLETE IS NULL THEN ISNULL(CPR.VALOR_ENVIO_GUIA,0)&#xA;WHEN ISNULL(CPR.ID_PRODUCTO,CPR.ID_PRODUCTO_GUIA)=86 THEN ISNULL(CPR.VALOR_DECLARADO,CPR.VALOR_PRODUCTO)&#xA;WHEN (CPR.ID_FORMA_PAGO=2 OR CPR.ID_CLIENTE IS NOT NULL) THEN ISNULL(CPR.VALOR_DECLARADO,CPR.VALOR_PRODUCTO) ELSE 0 END AS VALOR_A_RECAUDAR&#xA;,CPR.ID_REMITE&#xA;,CPR.NOMBRE_REMITE_GUIA&#xA;,CPR.FECHA_ENVIO&#xA;,ISNULL(CPR.VALOR_RECAUDADO,0)&#xA;,CPR.FECHA_RECAUDO&#xA;,ISNULL(CPR.NUMERO_ORDEN_SERVICIO,0)&#xA;,CPR.FECHA_RECAUDO_EFECTY&#xA;,isnull(CPR.ID_CLIENTE,'0') ID_CLIENTE&#xA;,CPR.NOMBRE_TIPO_CANAL&#xA;,CPR.NOMBRE_CLASE_TIPO_CANAL&#xA;--,CPR.VALOR_TOTAL&#xA;--INTO #TMP_GUIAS_PENDIENTE_RECAUDO_1&#xA;FROM #COD_PENDIENTE_POR_RECAUDO CPR (NOLOCK)&#xA;WHERE LEN(CPR.NUMERO_GUIA)&gt;7&#xA;--INNER JOIN [Mece_Logistico].[dbo].[GUIAS] G (nolock) ON G.NUMERO_GUIA=CPR.NUMERO_GUIA&#xA;&#xA;--CREATE NONCLUSTERED INDEX [IX_NUMERO_GUIA] ON #TMP_GUIAS_PENDIENTE_RECAUDO_1 ([NUMERO_GUIA] ASC)&#xA;&#xA;--select GPR.* from #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA;&#xA;&#xA;UPDATE GPR SET&#xA; --GPR.NOMBRE_RESPONSABLE_ULT_MOV='SERVIENTREGA S.A.'&#xA; GPR.ID_PROCESO_ULT_MOV=SE.ID_PROCESO&#xA; ,GPR.NOMBRE_PROCESO_ULT_MOV=PRO.NOMBRE_PROCESO_LOG&#xA; ,GPR.ID_CONCEPTO_ULT_MOV=ISNULL(SE.ID_CONCEPTO,0)&#xA; ,GPR.NOMBRE_CONCEPTO_ULT_MOV=ISNULL(ICON.NOMBRE_CONCEPTO,'')&#xA; ,GPR.NUMERO_MOVIMI_ULT_MOV=SE.NUMERO_MOVIMI&#xA; ,GPR.CONSECUT_MOVIMI_ULT_MOV=SE.CONSECUT_MOVIMI&#xA; ,GPR.FECHA_HORA_MOVIMI_ULT_MOV=SE.FECHA_HORA_MOVIMIENTO&#xA; --,GPR.ID_CONDUCTOR_ULT_MOV=DOC.ID_COURIER_CONDUCTOR&#xA; --,GPR.ID_AUXILIAR_ULT_MOV=DOC.ID_AUXILIAR1_VEHICULO&#xA; --,GPR.ID_PAIS_ZONA_URBA_ULT_MOV=DOC.ID_PAIS_ZONA_URBA  &#xA; --,GPR.ID_CIUDAD_ZONA_URBA_ULT_MOV=DOC.ID_CIUDAD_ZONA_URBA &#xA; --,GPR.ID_TIPO_ZONA_URBA_ULT_MOV=DOC.ID_TIPO_ZONA_URBA&#xA; --,GPR.ID_ZONA_URBA_ULT_MOV=DOC.ID_ZONA_URBA&#xA; FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; INNER JOIN MECE_LOGISTICO.dbo.SEGUIMIENTO_ENVIO SE WITH(NOLOCK) on se.NUMERO_GUIA=GPR.NUMERO_GUIA&#xA; --INNER JOIN MECE_LOGISTICO.dbo.DOCUMENTOS DOC (NOLOCK) ON&#xA; --DOC.ID_PROCESO=GPR.[ID_PROCESO_ULT_MOV] AND DOC.NUMERO_MOVIMI=GPR.[NUMERO_MOVIMI_ULT_MOV] AND DOC.CONSECUT_MOVIMI=GPR.[CONSECUT_MOVIMI_ULT_MOV]&#xA; INNER JOIN PARAMETROS.DBO.PROCESOS PRO (NOLOCK) ON PRO.ID_PROCESO=SE.ID_PROCESO&#xA; LEFT JOIN PARAMETROS.DBO.ITEM_CONCEPTO ICON (NOLOCK) ON ICON.ID_PAIS=1 AND ICON.ID_PROCESO=SE.ID_PROCESO AND ICON.ID_CONCEPTO=SE.ID_CONCEPTO&#xA; WHERE se.FECHA_HORA_MOVIMIENTO= (select MAX(se1.FECHA_HORA_MOVIMIENTO) from MECE_LOGISTICO.dbo.SEGUIMIENTO_ENVIO SE1 WITH(NOLOCK)&#xA;          where SE1.numero_guia=GPR.NUMERO_GUIA)&#xA; &#xA; UPDATE GPR SET&#xA; GPR.ID_CONDUCTOR_ULT_MOV=DOC.ID_COURIER_CONDUCTOR&#xA; ,GPR.ID_AUXILIAR_ULT_MOV=DOC.ID_AUXILIAR1_VEHICULO&#xA; ,GPR.ID_PAIS_ZONA_URBA_ULT_MOV=DOC.ID_PAIS_ZONA_URBA  &#xA; ,GPR.ID_CIUDAD_ZONA_URBA_ULT_MOV=DOC.ID_CIUDAD_ZONA_URBA &#xA; ,GPR.ID_TIPO_ZONA_URBA_ULT_MOV=DOC.ID_TIPO_ZONA_URBA&#xA; ,GPR.ID_ZONA_URBA_ULT_MOV=DOC.ID_ZONA_URBA&#xA; FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; INNER JOIN MECE_LOGISTICO.DBO.DOCUMENTOS DOC (NOLOCK) ON&#xA; DOC.ID_PROCESO=GPR.[ID_PROCESO_ULT_MOV] AND DOC.NUMERO_MOVIMI=GPR.[NUMERO_MOVIMI_ULT_MOV] AND DOC.CONSECUT_MOVIMI=GPR.[CONSECUT_MOVIMI_ULT_MOV]&#xA;&#xA; --SELECT GPR.ID_CONDUCTOR_ULT_MOV&#xA; &#xA; UPDATE GPR SET&#xA; GPR.ID_CONDUCTOR_ULT_MOV=ISNULL(RTRIM(LTRIM(EC.ID_EMPLEADO)),'')&#xA; ,GPR.CONDUCTOR_ULT_MOV =ISNULL(RTRIM(LTRIM(EC.NOMBRE_EMPLEADO)) +' '+ RTRIM(LTRIM(EC.APELLIDO_EMPLEADO)),'') &#xA; ,GPR.ID_AUXILIAR_ULT_MOV=ISNULL(RTRIM(LTRIM(EA.ID_EMPLEADO)),'')&#xA; ,GPR.AUXILIAR_ULT_MOV=ISNULL(RTRIM(LTRIM(EA.NOMBRE_EMPLEADO)) +' '+ RTRIM(LTRIM(EA.APELLIDO_EMPLEADO)),'') &#xA; FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; LEFT JOIN PARAMETROS.DBO.EMPLEADOS EC (NOLOCK) ON EC.ID_EMPLEADO=GPR.ID_CONDUCTOR_ULT_MOV&#xA; LEFT JOIN PARAMETROS.DBO.EMPLEADOS EA (NOLOCK) ON EA.ID_EMPLEADO=GPR.ID_AUXILIAR_ULT_MOV&#xA;&#xA;&#xA; --SELECT GPR.NUMERO_GUIA,ISNULL(DIV.NOMBRE_DIVISION,'') AS NOMBRE_CDS, ISNULL(CTCAN.[NOMBRE_CLASE_TIPO_CANAL],'') as TIPO_CANAL&#xA;UPDATE GPR SET NOMBRE_CDS_ULT_MOV=ISNULL(DIV.NOMBRE_DIVISION,''),&#xA; TIPO_CANAL_ULT_MOV=ISNULL(CTCAN.[NOMBRE_CLASE_TIPO_CANAL],'')&#xA; FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; --INNER JOIN MECE_LOGISTICO.DBO.DOCUMENTOS DOC (NOLOCK) ON&#xA; --DOC.ID_PROCESO=GPR.[ID_PROCESO_ULT_MOV] AND DOC.NUMERO_MOVIMI=GPR.[NUMERO_MOVIMI_ULT_MOV] AND DOC.CONSECUT_MOVIMI=GPR.[CONSECUT_MOVIMI_ULT_MOV]&#xA; INNER JOIN PARAMETROS.DBO.ZONASURBANAS Z (NOLOCK) &#xA; ON Z.ID_PAIS = GPR.ID_PAIS_ZONA_URBA_ULT_MOV AND Z.ID_CIUDAD = GPR.ID_CIUDAD_ZONA_URBA_ULT_MOV &#xA;  AND Z.ID_TIPO_ZONA_URBA = GPR.ID_TIPO_ZONA_URBA_ULT_MOV AND Z.ID_ZONA_URBA = GPR.ID_ZONA_URBA_ULT_MOV --AND Z.CATEGORIA_ZONA_URBA = 8 --CLICOH&#xA; INNER JOIN PARAMETROS.DBO.DIVISIONES DIV (NOLOCK) ON DIV.ID_PAIS = Z.ID_PAIS_CANAL AND DIV.ID_CIUDAD = Z.ID_CIUDAD_CANAL AND DIV.ID_DIVISION = Z.ID_CANAL&#xA; INNER JOIN [Mece_Logistico].[dbo].[CANALES] CAN (NOLOCK) ON CAN.id_pais=DIV.ID_PAIS and CAN.id_ciudad=DIV.ID_CIUDAD and CAN.[ID_DIVISION]=DIV.ID_DIVISION&#xA; INNER JOIN [Mece_Logistico].[dbo].[TIPOS_CANAL] TCAN (NOLOCK) ON TCAN.ID_TIPO_CANAL=CAN.ID_TIPO_CANAL AND TCAN.ID_EST_TIPO_CANAL=1&#xA; INNER JOIN PARAMETROS.[dbo].[CLASE_TIPO_CANAL] CTCAN (NOLOCK) ON CTCAN.ID_CLASE_TIPO_CANAL=TCAN.CLASE_TIPO_CANAL&#xA;&#xA;&#xA; --UPDATE GPR SET ESTADO_ENTREGA='VENCIDO'&#xA; --SELECT * FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; UPDATE GPR SET ESTADO_ENTREGA='VENCIDO'&#xA; FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; WHERE GPR.ID_PROCESO_ULT_MOV=9 AND ID_CONCEPTO_ULT_MOV IN(9,7,2,4)--9 ENTREGAS OFIC  C.O.D. Y/O LPC EMPRESARIO --7 EMPRESARIO SATELITE ENTREGA EN OFICINA&#xA; --2 RECLAMO OFICINA Y 4 C.O.D RECLAMO OFICINA&#xA; AND DATEDIFF(DAY, FECHA_HORA_MOVIMI_ULT_MOV,GETDATE())&gt;8 -- MAS DE 8 DIAS&#xA; &#xA; UPDATE GPR SET ESTADO_ENTREGA='VENCIDO'&#xA; FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; WHERE GPR.ID_PROCESO_ULT_MOV=31 --ENVIO PARA ENTREGA EN OFICINA&#xA; AND DATEDIFF(DAY, FECHA_HORA_MOVIMI_ULT_MOV,GETDATE())&gt;8 -- MAS DE 8 DIAS&#xA;&#xA; UPDATE GPR SET ESTADO_ENTREGA='VENCIDO'&#xA; FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; WHERE GPR.ID_PROCESO_ULT_MOV=9 AND ID_CONCEPTO_ULT_MOV IN(10,8) --10 ENTR A DOMICI  LPC / COD EMPRESARIOS SAT --8 EMPRESARIO SATELITE ENTREGA EN DOMICILIO&#xA; AND DATEDIFF(DAY, FECHA_HORA_MOVIMI_ULT_MOV,GETDATE())&gt;3-- MAS DE 3 DIAS&#xA; &#xA; UPDATE GPR SET ESTADO_ENTREGA='VENCIDO'&#xA; FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; WHERE GPR.ID_PROCESO_ULT_MOV=32 --ENVIO PARA ENTREGA A DOMICILIO&#xA; AND DATEDIFF(DAY, FECHA_HORA_MOVIMI_ULT_MOV,GETDATE())&gt;3-- MAS DE 3 DIAS&#xA;&#xA; UPDATE GPR SET ESTADO_ENTREGA='VENCIDO'&#xA; FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; WHERE GPR.ID_PROCESO_ULT_MOV=9 AND ID_CONCEPTO_ULT_MOV IN(1,3) --SALIDA A ZONA Y C.O.D EN DISTRIBUCION&#xA; AND DATEDIFF(DAY, FECHA_HORA_MOVIMI_ULT_MOV,GETDATE())&gt;1 --MAS DE UN DIA&#xA;&#xA;&#xA;&#xA;DROP TABLE IF EXISTS #TMP_GUIAS_PENDIENTE_RECAUDO_SZU&#xA; SELECT &#xA; TMP.NUMERO_GUIA&#xA; ,(SE.CONSECUT_MOVIMI)   AS CONSECUT_MOVIMI_SZU&#xA; ,(SE.NUMERO_MOVIMI)    AS NUMERO_MOVIMI_SZU&#xA; ,(SE.FECHA_HORA_MOVIMIENTO)  AS FECHA_HORA_MOVIMI_ULT_MOV_SZU&#xA;INTO #TMP_GUIAS_PENDIENTE_RECAUDO_SZU&#xA;FROM #TMP_GUIAS_PENDIENTE_RECAUDO TMP&#xA;INNER JOIN Mece_Logistico..SEGUIMIENTO_ENVIO SE&#xA;ON SE.NUMERO_GUIA=TMP.NUMERO_GUIA&#xA;WHERE SE.ID_PROCESO=9&#xA;---GROUP BY  TMP.NUMERO_GUIA&#xA;&#xA;;WITH CTE AS(&#xA;SELECT &#xA;ROWID = ROW_NUMBER() OVER(PARTITION BY NUMERO_GUIA ORDER BY FECHA_HORA_MOVIMI_ULT_MOV_SZU DESC)&#xA;,NUMERO_GUIA,FECHA_HORA_MOVIMI_ULT_MOV_SZU&#xA;FROM #TMP_GUIAS_PENDIENTE_RECAUDO_SZU&#xA;)&#xA;DELETE CTE WHERE ROWID&gt;1&#xA;&#xA;&#xA;DROP TABLE IF EXISTS ##TMP_GUIAS_PENDIENTE_RECAUDO_FINAL_PBI;&#xA;SELECT --GPR.*&#xA;GPR.NUMERO_GUIA &#xA;--GPR.ID_ESTADOENVIO &#xA;,GPR.NOMBRE_ESTADOENVIO &#xA;,GPR.FORMA_PAGO &#xA;,GPR.VALOR_A_RECAUDAR &#xA;,GPR.ID_REMITE &#xA;,GPR.NOMBRE_REMITE_GUIA &#xA;,GPR.FECHA_ENVIO&#xA;,GPR.VALOR_RECAUDADO&#xA;,GPR.FECHA_RECAUDO&#xA;,GPR.NUMERO_ORDEN_SERVICIO&#xA;,GPR.FECHA_RECAUDO_EFECTY&#xA;,GPR.ESTADO_ENTREGA&#xA;--,GPR.NOMBRE_RESPONSABLE_ULT_MOV &#xA;--ID_PROCESO_ULT_MOV &#xA;--NOMBRE_PROCESO_ULT_MOV &#xA;--NUMERO_MOVIMI_ULT_MOV &#xA;--CONSECUT_MOVIMI_ULT_MOV &#xA;--FECHA_HORA_MOVIMI_ULT_MOV&#xA;&#xA;--,ISNULL(ISNULL(CLO.CENTRO_LOGISTICO,CLD.CENTRO_LOGISTICO),'')  AS CPL_ORIGEN_ULT_MOV&#xA;--,ISNULL(ISNULL(RO.NOMBRE_REGIONAL,RD.NOMBRE_REGIONAL),'')  AS REGIONAL_ORIGEN_ULT_MOV&#xA;--,ISNULL(ISNULL(CO.NOMBRE_CIUDAD,CD.NOMBRE_CIUDAD),'')  AS CIUDAD_ORIGEN_ULT_MOV&#xA;--,ISNULL(ISNULL(CLD.CENTRO_LOGISTICO,CLO.CENTRO_LOGISTICO),'') AS CPL_DESTINO_ULT_MOV&#xA;--,ISNULL(ISNULL(RD.NOMBRE_REGIONAL,RO.NOMBRE_REGIONAL),'') AS REGIONAL_DESTINO_ULT_MOV&#xA;--,ISNULL(ISNULL(CD.NOMBRE_CIUDAD,CO.NOMBRE_CIUDAD),'') AS CIUDAD_DESTINO_MOV&#xA;,CASE WHEN ID_PROCESO!=14 THEN &#xA;ISNULL(ISNULL(CLO.CENTRO_LOGISTICO,CLD.CENTRO_LOGISTICO),'')  ELSE ISNULL(ISNULL(CLD.CENTRO_LOGISTICO,CLO.CENTRO_LOGISTICO),'') END AS CPL_ULT_MOV&#xA;,CASE WHEN ID_PROCESO!=14 THEN &#xA;ISNULL(ISNULL(RO.NOMBRE_REGIONAL,RD.NOMBRE_REGIONAL),'') ELSE ISNULL(ISNULL(RD.NOMBRE_REGIONAL,RO.NOMBRE_REGIONAL),'') END  AS REGIONAL_ULT_MOV&#xA;,CASE WHEN ID_PROCESO!=14 THEN &#xA;ISNULL(ISNULL(CO.NOMBRE_CIUDAD,CD.NOMBRE_CIUDAD),'')  ELSE ISNULL(ISNULL(CD.NOMBRE_CIUDAD,CO.NOMBRE_CIUDAD),'') END  AS CIUDAD_ULT_MOV&#xA;,ISNULL(CASE &#xA; WHEN ISNULL(DOC.ID_CIUDAD_ZONA_URBA,0) !=0 THEN&#xA; ROZ.NOMBRE_REGIONAL+' - '+ DCOZ.NOMBRE_DEPARTAMENTO +' - '+ COZ.NOMBRE_CIUDAD &#xA; WHEN  ISNULL(DOC.ID_CIUDAD_DIVISION_ORIGEN,0) !=0 AND DOC.ID_PROCESO!=14 THEN&#xA; ROM.NOMBRE_REGIONAL+' - '+ DCOM.NOMBRE_DEPARTAMENTO +' - '+ COM.NOMBRE_CIUDAD&#xA; ELSE&#xA; ROD.NOMBRE_REGIONAL+' - '+ DCOD.NOMBRE_DEPARTAMENTO +' - '+ COD.NOMBRE_CIUDAD &#xA; END,'') AS REG_DEPART_CIUDAD_ULTIMO_MOV&#xA;&#xA;,ISNULL(DOC.PLACA_VEHICULO_DOCU,'') as PLACA_VEHICULO_ULTIMO_MOV&#xA;,ISNULL(O.[NOMBRE_OPERATIVO],'') AS NOMBRE_OPERATIVO_ULTIMO_MOV&#xA;,ISNULL(Z.NOMBRE_ZONA_URBA,'') AS ZONA_URBANA_ULTIMO_MOV&#xA;,ISNULL(CZ.NOMBRE_CATEGORIA,'') AS CATEGORIA_ZONA_ULTIMO_MOV&#xA;,ISNULL(TZU.NOMBRE_TIPO_ZONA_URBA,'') AS TIPO_ZONA_ULTIMO_MOV&#xA;,ISNULL(GPR.NOMBRE_CDS_ULT_MOV,'') AS NOMBRE_CDS_ULT_MOV&#xA;,ISNULL(TIPO_CANAL_ULT_MOV,'') AS TIPO_CANAL_ULT_MOV&#xA;--,GR.ID_PROCESO &#xA;,ISNULL(GPR.NOMBRE_PROCESO_ULT_MOV,'') AS PROCESO_LOG_ULTIMO_MOV  &#xA;,ISNULL(GPR.NOMBRE_CONCEPTO_ULT_MOV,'') AS CONCEPTO_ULT_MOV&#xA;--,GR.ID_CONCEPTO  &#xA;--,GR.FECHA_HORA_MOVIMIENTO&#xA;,ISNULL(cast(GPR.ID_PROCESO_ULT_MOV as nvarchar) +' - '+ RTRIM(GPR.NOMBRE_PROCESO_ULT_MOV),'') AS NOMBRE_ULTIMO_MOV&#xA;,ISNULL(CASE WHEN DIO.ID_DIVISION IS NOT NULL THEN cast(DIO.ID_DIVISION as nvarchar) +' - '+ RTRIM(DIO.NOMBRE_DIVISION)&#xA;ELSE cast(DID.ID_DIVISION as nvarchar) +' - '+ RTRIM(DID.NOMBRE_DIVISION) END,'') AS BODEGA_ULTIMO_MOV&#xA;,ISNULL(cast(GPR.ID_PROCESO_ULT_MOV as nvarchar) +' - '+ RTRIM(GPR.[NUMERO_MOVIMI_ULT_MOV])+' - '+  cast(GPR.[CONSECUT_MOVIMI_ULT_MOV] as nvarchar),'') as ULTIMO_MOV_LOGISTICO&#xA;,ISNULL(CONVERT(nvarchar(20),GPR.FECHA_HORA_MOVIMI_ULT_MOV,120),'') AS FECHA_ULTIMO_MOV&#xA;,GPR.ID_CONDUCTOR_ULT_MOV&#xA;,GPR.CONDUCTOR_ULT_MOV&#xA;,GPR.ID_AUXILIAR_ULT_MOV&#xA;,GPR.AUXILIAR_ULT_MOV&#xA;,GPR.ID_CLIENTE&#xA;,SZU.CONSECUT_MOVIMI_SZU&#xA;,SZU.NUMERO_MOVIMI_SZU&#xA;,SZU.FECHA_HORA_MOVIMI_ULT_MOV_SZU&#xA;,GPR.NOMBRE_TIPO_CANAL&#xA;,GPR.NOMBRE_CLASE_TIPO_CANAL&#xA;--,DOC.*&#xA;INTO ##TMP_GUIAS_PENDIENTE_RECAUDO_FINAL_PBI&#xA;&#xA;FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA;--------------------------- CIUDAD ULTIMO MOV ZONA&#xA;  LEFT JOIN MECE_LOGISTICO.DBO.DOCUMENTOS DOC (NOLOCK) ON&#xA; DOC.ID_PROCESO=GPR.[ID_PROCESO_ULT_MOV] AND DOC.NUMERO_MOVIMI=GPR.[NUMERO_MOVIMI_ULT_MOV] AND DOC.CONSECUT_MOVIMI=GPR.[CONSECUT_MOVIMI_ULT_MOV]&#xA; --AND DOC.ID_DIVISION_DESTINO IN (9311, 9308, 9304, 9313, 9310, 9312, 9711, 9710)&#xA;  LEFT JOIN PARAMETROS.DBO.CIUDADES COZ (NOLOCK) ON  COZ.ID_PAIS=1 AND COZ.ID_CIUDAD=DOC.ID_CIUDAD_ZONA_URBA&#xA;  LEFT JOIN PARAMETROS.DBO.REGIONALES_PAIS ROZ (NOLOCK) ON  ROZ.ID_PAIS=COZ.ID_PAIS AND ROZ.ID_REGIONAL=COZ.ID_REGIONAL&#xA;  LEFT JOIN PARAMETROS.DBO.DEPARTAMENTOS DCOZ (NOLOCK) ON  DCOZ.ID_PAIS=COZ.ID_PAIS AND DCOZ.ID_DEPARTAMENTO=COZ.ID_DEPARTAMENTO&#xA;   LEFT JOIN PARAMETROS.DBO.ZONASURBANAS Z (NOLOCK) &#xA; ON Z.ID_PAIS = DOC.ID_PAIS_ZONA_URBA AND Z.ID_CIUDAD = DOC.ID_CIUDAD_ZONA_URBA AND Z.ID_TIPO_ZONA_URBA = DOC.ID_TIPO_ZONA_URBA AND Z.ID_ZONA_URBA = DOC.ID_ZONA_URBA --AND Z.CATEGORIA_ZONA_URBA = 8 --CLICOH&#xA;  LEFT JOIN [PARAMETROS].[dbo].[CATEGORIAZONASURBANAS] CZ (NOLOCK) ON CZ.Id_Categoria=Z.CATEGORIA_ZONA_URBA&#xA;  LEFT JOIN [PARAMETROS].[dbo].[TIPOSZONASURBANAS] TZU (NOLOCK) ON TZU.ID_TIPO_ZONA_URBA=Z.ID_TIPO_ZONA_URBA&#xA; --------------------------- CIUDAD ULTIMO MOV DOCUMENTO&#xA;  LEFT JOIN PARAMETROS.DBO.CIUDADES COM (NOLOCK) ON  COM.ID_PAIS=1 AND COM.ID_CIUDAD=DOC.ID_CIUDAD_DIVISION_ORIGEN&#xA;  LEFT JOIN PARAMETROS.DBO.REGIONALES_PAIS ROM (NOLOCK) ON  ROM.ID_PAIS=COM.ID_PAIS AND ROM.ID_REGIONAL=COM.ID_REGIONAL&#xA;  LEFT JOIN PARAMETROS.DBO.DEPARTAMENTOS DCOM (NOLOCK) ON  DCOM.ID_PAIS=COM.ID_PAIS AND DCOM.ID_DEPARTAMENTO=COM.ID_DEPARTAMENTO&#xA;  --------------------------- CIUDAD DESTINO ULTIMO MOV DOCUMENTO&#xA;  LEFT JOIN PARAMETROS.DBO.CIUDADES COD(NOLOCK) ON  COD.ID_PAIS=1 AND COD.ID_CIUDAD=DOC.ID_CIUDAD_DESTINO&#xA;  LEFT JOIN PARAMETROS.DBO.REGIONALES_PAIS ROD (NOLOCK) ON  ROD.ID_PAIS=COD.ID_PAIS AND ROD.ID_REGIONAL=COD.ID_REGIONAL&#xA;  LEFT JOIN PARAMETROS.DBO.DEPARTAMENTOS DCOD (NOLOCK) ON  DCOD.ID_PAIS=COD.ID_PAIS AND DCOD.ID_DEPARTAMENTO=COD.ID_DEPARTAMENTO&#xA;  --------------------------- DIVISION ORIGEN ULTIMO MOV DOCUMENTO&#xA;  LEFT JOIN PARAMETROS.DBO.DIVISIONES DIO(NOLOCK) ON DIO.ID_PAIS=DOC.ID_PAIS_DIVISION_ORIGEN&#xA; AND DIO.ID_CIUDAD=DOC.ID_CIUDAD_DIVISION_ORIGEN AND DIO.ID_DIVISION=DOC.ID_DIVISION_ORIGEN&#xA;  --------------------------- DIVISION DESTINO ULTIMO MOV DOCUMENTO&#xA;  LEFT JOIN PARAMETROS.DBO.DIVISIONES DID(NOLOCK) ON DID.ID_PAIS=DOC.ID_PAIS_DESTINO&#xA; AND DID.ID_CIUDAD=DOC.ID_CIUDAD_DESTINO AND DID.ID_DIVISION=DOC.ID_DIVISION_DESTINO&#xA;-------------------------------------------------------------&#xA;  LEFT JOIN [PARAMETROS].[dbo].CIUDADES CO (NOLOCK) ON CO.ID_PAIS=ID_PAIS_DIVISION_ORIGEN AND CO.ID_CIUDAD=DOC.ID_CIUDAD_DIVISION_ORIGEN&#xA;  LEFT JOIN [PARAMETROS].[dbo].REGIONALES_PAIS RO (NOLOCK) ON RO.ID_PAIS=1 AND RO.ID_REGIONAL=CO.[ID_REGIONAL]&#xA;  LEFT JOIN [PARAMETROS].[dbo].CIUDADES CD (NOLOCK) ON CD.ID_PAIS=DOC.ID_PAIS_DESTINO AND CD.ID_CIUDAD=DOC.ID_CIUDAD_DESTINO&#xA;  LEFT JOIN [PARAMETROS].[dbo].REGIONALES_PAIS RD (NOLOCK) ON RD.ID_PAIS=1 AND RD.ID_REGIONAL=CD.[ID_REGIONAL]&#xA;  LEFT JOIN [PARAMETROS].[dbo].[OPERATIVOS] O (NOLOCK) ON O.[ID_PAIS_ORIGEN]=DOC.ID_PAIS_OPERATIVO AND O.[ID_CIUDAD_ORIGEN]=DOC.ID_CIUDAD_OPERATIVO&#xA; AND O.[ID_OPERATIVO]=DOC.ID_OPERATIVO&#xA;  LEFT JOIN #TMP_CIUDADES_ANEXAS CAO (NOLOCK) ON CAO.ID_PAIS=1 AND CAO.[ID_CIUDAD_ANEXA]=CO.ID_CIUDAD --AND CAO.RECOLECCION=1&#xA;  LEFT JOIN PARAMETROS.DBO.CENTROS_LOGISTICOS CLO (NOLOCK) ON CLO.ID_PAIS=1 AND CLO.ID_CIUDAD=CAO.ID_CIUDAD AND CLO.ID_CENTRO_LOGISTICO=1 AND CLO.ID_ESTADO=1&#xA;  LEFT JOIN #TMP_CIUDADES_ANEXAS CAD (NOLOCK) ON CAD.ID_PAIS=1 AND CAD.[ID_CIUDAD_ANEXA]=CD.ID_CIUDAD --AND CAD.RECOLECCION=1&#xA;  LEFT JOIN PARAMETROS.DBO.CENTROS_LOGISTICOS CLD (NOLOCK) ON CLD.ID_PAIS=1 AND CLD.ID_CIUDAD=CAD.ID_CIUDAD AND CLD.ID_CENTRO_LOGISTICO=1 AND CLD.ID_ESTADO=1&#xA;LEFT JOIN #TMP_GUIAS_PENDIENTE_RECAUDO_SZU SZU ON SZU.NUMERO_GUIA=GPR.NUMERO_GUIA&#xA;--WHERE &#xA;--NUMERO_GUIA=2273736466&#xA;--ID_PROCESO=32&#xA;&#xA;--DELETE CPR FROM #TMP_GUIAS_PENDIENTE_RECAUDO CPR &#xA;--WHERE&#xA;--NOT EXISTS (SELECT TOP 1 SE.NUMERO_GUIA FROM Mece_Logistico.DBO.SEGUIMIENTO_ENVIO SE (NOLOCK) WHERE SE.NUMERO_GUIA=CPR.NUMERO_GUIA AND SE.ID_PROCESO&gt;=5 AND  SE.ID_PROCESO&lt;27)&#xA;&#xA;&#xA;&#xA;--select  COUNT(1) from #TMP_GUIAS_PENDIENTE_RECAUDO&#xA;--select  COUNT(1) from ##TMP_GUIAS_PENDIENTE_RECAUDO_FINAL_PBI&#xA;&#xA;--select  * from ##TMP_GUIAS_PENDIENTE_RECAUDO_FINAL_PBI&#xA;&#xA;&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="0"
                SQLTask:DtsVariableName="User::STR_FechaIni"
                SQLTask:ParameterDirection="Input"
                SQLTask:DataType="129"
                SQLTask:ParameterSize="-1" />
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="1"
                SQLTask:DtsVariableName="User::STR_FechaFin"
                SQLTask:ParameterDirection="Input"
                SQLTask:DataType="129"
                SQLTask:ParameterSize="-1" />
            </SQLTask:SqlTaskData>
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Tareas Backap\Prepatacion data Recudo LPC COD 4"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:Disabled="True"
          DTS:DTSID="{5db76241-13ef-4a11-875f-78159d13eee6}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Prepatacion data Recudo LPC COD 4"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="7">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{20AF370D-4C8E-4E05-91E7-8F81200FAADC}"
              SQLTask:SqlStatementSource="&#xA;IF OBJECT_ID('tempdb..#COD_PENDIENTE_POR_RECAUDO') IS NOT NULL &#xA;    DROP TABLE #COD_PENDIENTE_POR_RECAUDO&#xA;&#xA;IF OBJECT_ID('tempdb..#TMP_GUIAS_PENDIENTE_RECAUDO') IS NOT NULL &#xA;    DROP TABLE #TMP_GUIAS_PENDIENTE_RECAUDO&#xA;&#xA;CREATE TABLE #TMP_GUIAS_PENDIENTE_RECAUDO(&#xA; NUMERO_GUIA numeric(20, 0) NOT NULL,&#xA; ID_ESTADOENVIO smallint DEFAULT 0,&#xA; NOMBRE_ESTADOENVIO varchar(40) DEFAULT '',&#xA; FORMA_PAGO varchar(40) DEFAULT '',&#xA; VALOR_A_RECAUDAR numeric(12, 2) NULL,&#xA; ID_REMITE [varchar](40) DEFAULT '',&#xA; NOMBRE_REMITE_GUIA  [varchar](200) DEFAULT '',&#xA;-- ID_CIUDAD INT DEFAULT 0,&#xA;-- [NOMBRE_CIUDAD] [varchar](50) DEFAULT '',&#xA; FECHA_ENVIO datetime NULL,&#xA; [VALOR_RECAUDADO] [numeric](11, 2) DEFAULT 0,&#xA; FECHA_RECAUDO datetime NULL,&#xA; NUMERO_ORDEN_SERVICIO varchar(20) DEFAULT '',&#xA; FECHA_RECAUDO_EFECTY datetime NULL,&#xA; ESTADO_ENTREGA varchar(70) DEFAULT 'A TIEMPO',--A TIEMPO O VENCIDO&#xA; --NOMBRE_RESPONSABLE_ULT_MOV VARCHAR(100) DEFAULT '',&#xA; ID_PROCESO_ULT_MOV int DEFAULT 0,&#xA; NOMBRE_PROCESO_ULT_MOV varchar(70) DEFAULT '',&#xA; ID_CONCEPTO_ULT_MOV int DEFAULT 0,&#xA; NOMBRE_CONCEPTO_ULT_MOV varchar(70) DEFAULT '',&#xA; NUMERO_MOVIMI_ULT_MOV char(30) DEFAULT '',&#xA; CONSECUT_MOVIMI_ULT_MOV numeric(7, 0) DEFAULT 0,&#xA; FECHA_HORA_MOVIMI_ULT_MOV datetime NULL,&#xA; ID_PAIS_ZONA_URBA_ULT_MOV SMALLINT NULL,&#xA; ID_CIUDAD_ZONA_URBA_ULT_MOV INT NULL,&#xA; ID_TIPO_ZONA_URBA_ULT_MOV SMALLINT NULL,&#xA; ID_ZONA_URBA_ULT_MOV SMALLINT NULL,&#xA; NOMBRE_CDS_ULT_MOV varchar(100) DEFAULT '',&#xA; TIPO_CANAL_ULT_MOV varchar(40) DEFAULT '',&#xA; ID_CONDUCTOR_ULT_MOV varchar(40) DEFAULT '',&#xA; CONDUCTOR_ULT_MOV  varchar(200) DEFAULT '',&#xA; ID_AUXILIAR_ULT_MOV varchar(40) DEFAULT '',&#xA; AUXILIAR_ULT_MOV varchar(200) DEFAULT '',&#xA; ID_CLIENTE [char](20) NOT NULL,&#xA; NOMBRE_TIPO_CANAL varchar(100) DEFAULT '',&#xA; NOMBRE_CLASE_TIPO_CANAL varchar(100) DEFAULT ''&#xA;) ON [PRIMARY]&#xA;CREATE NONCLUSTERED INDEX [IX_NUMERO_GUIA] ON #TMP_GUIAS_PENDIENTE_RECAUDO ([NUMERO_GUIA] ASC)&#xA;CREATE NONCLUSTERED INDEX [IX_ZONA] ON #TMP_GUIAS_PENDIENTE_RECAUDO (ID_PAIS_ZONA_URBA_ULT_MOV,ID_CIUDAD_ZONA_URBA_ULT_MOV, ID_TIPO_ZONA_URBA_ULT_MOV,ID_ZONA_URBA_ULT_MOV ASC)&#xA;CREATE NONCLUSTERED INDEX [IX_MANIFIESTO] ON #TMP_GUIAS_PENDIENTE_RECAUDO (ID_PROCESO_ULT_MOV,NUMERO_MOVIMI_ULT_MOV,CONSECUT_MOVIMI_ULT_MOV ASC)&#xA;&#xA;&#xA;IF OBJECT_ID('tempdb..#TMP_CIUDADES_ANEXAS') IS NOT NULL &#xA;    DROP TABLE #TMP_CIUDADES_ANEXAS&#xA;&#xA;---CIUDADES ANEXAS&#xA;SELECT CAD.* &#xA;INTO #TMP_CIUDADES_ANEXAS FROM PARAMETROS.DBO.CIUDADES_ANEXAS CAD (NOLOCK) &#xA;WHERE CAD.ID_PAIS=1 AND CAD.RECOLECCION=1&#xA;&#xA;INSERT INTO #TMP_CIUDADES_ANEXAS&#xA;SELECT CAD.* FROM PARAMETROS.DBO.CIUDADES_ANEXAS CAD (NOLOCK) &#xA;LEFT JOIN #TMP_CIUDADES_ANEXAS TCAD ON TCAD.ID_CIUDAD_ANEXA=CAD.ID_CIUDAD_ANEXA&#xA;WHERE CAD.ID_PAIS=1 AND CAD.RECOLECCION=0 AND TCAD.ID_CIUDAD_ANEXA IS NULL&#xA;&#xA;DELETE T FROM (SELECT *, &#xA;    DupRank = ROW_NUMBER() OVER (PARTITION BY ID_CIUDAD_ANEXA ORDER BY FECHA_CREACION DESC) &#xA;     FROM #TMP_CIUDADES_ANEXAS) AS T&#xA;WHERE DupRank &gt; 1&#xA;&#xA;&#xA;&#xA;SELECT CPR.*,G.ID_CLIENTE,G.ID_REMITE,G.NOMBRE_REMITE_GUIA,G.ID_PRODUCTO AS ID_PRODUCTO_GUIA,G.ID_ESTADOENVIO,G.ID_ESTADOGUIA,ISNULL(G.VALOR_SEG_MAN_GUIAS,0)+ISNULL(G.VALOR_FLETES_GUIAS,0) AS VALOR_ENVIO_GUIA,ISNULL(GIA.VALOR_RECAUDAR_PRODUCTO,0) AS VALOR_RECAUDAR_PRODUCTO_GUIA&#xA;,CAST('' AS nvarchar(50)) AS NOMBRE_ESTADOENVIO,G.FECHA_ENVIO&#xA;,TCAN.NOMBRE_TIPO_CANAL&#xA;,CTCAN.NOMBRE_CLASE_TIPO_CANAL&#xA;INTO #COD_PENDIENTE_POR_RECAUDO&#xA;FROM [Mece_Logistico].[dbo].[COD_PENDIENTE_POR_RECAUDO] CPR (NOLOCK)&#xA;INNER JOIN [Mece_Logistico].[dbo].[GUIAS] G (nolock) ON G.NUMERO_GUIA=CPR.NUMERO_GUIA&#xA;LEFT JOIN [Mece_Logistico].[dbo].[GUIAS_INF_ADICIONAL] GIA (nolock) ON GIA.NUMERO_GUIA=CPR.NUMERO_GUIA&#xA;LEFT JOIN [tmp_borrar_local].dbo.LPC_GUIAS_SOLUCIONADAS LGS (NOLOCK) ON LGS.NUMERO_GUIA=CPR.NUMERO_GUIA&#xA;LEFT JOIN [Mece_Logistico].[dbo].[CANALES] CAN (NOLOCK) ON CAN.id_pais=G.ID_1 and CAN.id_ciudad=G.ID_2 and CAN.[ID_DIVISION]=G.ID_CANAL&#xA;LEFT JOIN [Mece_Logistico].[dbo].[TIPOS_CANAL] TCAN (NOLOCK) ON TCAN.ID_TIPO_CANAL=CAN.ID_TIPO_CANAL AND TCAN.ID_EST_TIPO_CANAL=1&#xA;LEFT JOIN PARAMETROS.[dbo].[CLASE_TIPO_CANAL] CTCAN (NOLOCK) ON CTCAN.ID_CLASE_TIPO_CANAL=TCAN.CLASE_TIPO_CANAL&#xA;WHERE LGS.NUMERO_GUIA IS NULL AND&#xA;ISNULL(CPR.ESTADO_COD,1)=1-- RECAUDO ESTA ACTIVO&#xA;AND ISNULL(CPR.ESTA_RECAUDADO,0)=0 -- NO ESTA RECAUDADO&#xA;--AND G.ID_ESTADOGUIA!=4-- NO ESTA ANULADA&#xA;AND ISNULL(CPR.NUMERO_ORDEN_SERVICIO,'')='' -- NO TIENE ORDEN DE RECAUDO DE EFECTY&#xA;AND ISNULL(CPR.ESTA_ANULADO,0)=0 -- NO DEBE ESTAR ANULADA&#xA;AND G.ID_DIVISION_PROV IS NULL&#xA;--AND CPR.FECHA_CREACION &gt;= @FECHA_INI &#xA;--AND CPR.FECHA_CREACION &lt; @FECHA_FIN&#xA;&#xA;AND CPR.FECHA_CREACION BETWEEN convert(datetime,?) AND convert(datetime,?)&#xA;/*&#xA;AND CPR.FECHA_CREACION BETWEEN convert(datetime,'20251201') &#xA;       AND convert(datetime,'20260201')&#xA;*/&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;/*&#xA;select G.NUMERO_GUIA&#xA;,TCAN.NOMBRE_TIPO_CANAL&#xA;,CTCAN.NOMBRE_CLASE_TIPO_CANAL&#xA;from Mece_Logistico.dbo.guias G (nolock)&#xA;left JOIN [Mece_Logistico].[dbo].[CANALES] CAN (NOLOCK) ON CAN.id_pais=G.ID_1 and CAN.id_ciudad=G.ID_2 and CAN.[ID_DIVISION]=G.ID_CANAL&#xA;left JOIN [Mece_Logistico].[dbo].[TIPOS_CANAL] TCAN (NOLOCK) ON TCAN.ID_TIPO_CANAL=CAN.ID_TIPO_CANAL AND TCAN.ID_EST_TIPO_CANAL=1&#xA;left JOIN PARAMETROS.[dbo].[CLASE_TIPO_CANAL] CTCAN (NOLOCK) ON CTCAN.ID_CLASE_TIPO_CANAL=TCAN.CLASE_TIPO_CANAL&#xA;where G.ID_CANAL IS NOT NULL&#xA;AND FECHA_ENVIO&gt;='20260120 00:00:00'&#xA;*/&#xA;&#xA;&#xA;&#xA;&#xA;------------------------------------------------------------------------------------------------------------------------------------------------------------------&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;CREATE NONCLUSTERED INDEX [IX_NUMERO_GUIA] ON #COD_PENDIENTE_POR_RECAUDO ([NUMERO_GUIA] ASC)&#xA;&#xA;&#xA;--Se quitan envios siniestrados&#xA;DELETE GPR FROM #COD_PENDIENTE_POR_RECAUDO GPR&#xA;WHERE ID_ESTADOENVIO in(5,4)&#xA;&#xA;--Quita las guias son del canal retail y no son COD y no contraentrega ecommerce&#xA;DELETE GPR FROM #COD_PENDIENTE_POR_RECAUDO GPR&#xA;WHERE ID_FORMA_PAGO=1 AND ID_PRODUCTO!=86&#xA;&#xA;&#xA;--SELECT * FROM #COD_PENDIENTE_POR_RECAUDO CPR (NOLOCK)&#xA;--WHERE --NUMERO_GUIA=2143658629&#xA;--ID_PRODUCTO=86&#xA;--INSERT INTO #TMP_GUIAS_PENDIENTE_RECAUDO&#xA;&#xA;UPDATE CPR SET CPR.NOMBRE_ESTADOENVIO=E.NOMBRE_ESTADOENVIO&#xA;FROM #COD_PENDIENTE_POR_RECAUDO CPR&#xA;INNER JOIN PARAMETROS.DBO.ESTADOSENVIO E (NOLOCK)ON E.ID_ESTADOENVIO=CPR.ID_ESTADOENVIO&#xA;&#xA;--TRUNCATE TABLE #TMP_GUIAS_PENDIENTE_RECAUDO&#xA;INSERT INTO #TMP_GUIAS_PENDIENTE_RECAUDO(&#xA;NUMERO_GUIA,&#xA;ID_ESTADOENVIO,&#xA;NOMBRE_ESTADOENVIO,&#xA;FORMA_PAGO,&#xA;VALOR_A_RECAUDAR,&#xA;ID_REMITE,&#xA;NOMBRE_REMITE_GUIA,&#xA;FECHA_ENVIO,&#xA;VALOR_RECAUDADO,&#xA;FECHA_RECAUDO,&#xA;NUMERO_ORDEN_SERVICIO,&#xA;FECHA_RECAUDO_EFECTY,&#xA;ID_CLIENTE,&#xA;NOMBRE_TIPO_CANAL,&#xA;NOMBRE_CLASE_TIPO_CANAL&#xA;)&#xA;SELECT CPR.NUMERO_GUIA,CPR.ID_ESTADOENVIO,CPR.NOMBRE_ESTADOENVIO,&#xA;CASE WHEN CPR.ID_FORMA_PAGO=4 AND CPR.ID_CLIENTE IS NULL THEN 'C.O.D.' WHEN ISNULL(CPR.ID_PRODUCTO,CPR.ID_PRODUCTO_GUIA)=86 THEN 'CONTRAENTREGA ECOMMERCE' WHEN (CPR.ID_FORMA_PAGO=2 OR CPR.ID_CLIENTE IS NOT NULL) THEN 'LPC' ELSE '' END AS FORMA_PAGO,&#xA;CASE WHEN ISNULL(CPR.VALOR_TOTAL,0)!=0 THEN CPR.VALOR_TOTAL&#xA;WHEN CPR.ID_FORMA_PAGO=4 AND VALOR_FLETE IS NOT NULL THEN ISNULL(CPR.VALOR_FLETE,0) + ISNULL(CPR.VALOR_OTROS,0)&#xA;WHEN CPR.ID_FORMA_PAGO=4 AND VALOR_FLETE IS NULL THEN ISNULL(CPR.VALOR_ENVIO_GUIA,0)&#xA;WHEN ISNULL(CPR.ID_PRODUCTO,CPR.ID_PRODUCTO_GUIA)=86 THEN ISNULL(CPR.VALOR_DECLARADO,CPR.VALOR_PRODUCTO)&#xA;WHEN (CPR.ID_FORMA_PAGO=2 OR CPR.ID_CLIENTE IS NOT NULL) THEN ISNULL(CPR.VALOR_DECLARADO,CPR.VALOR_PRODUCTO) ELSE 0 END AS VALOR_A_RECAUDAR&#xA;,CPR.ID_REMITE&#xA;,CPR.NOMBRE_REMITE_GUIA&#xA;,CPR.FECHA_ENVIO&#xA;,ISNULL(CPR.VALOR_RECAUDADO,0)&#xA;,CPR.FECHA_RECAUDO&#xA;,ISNULL(CPR.NUMERO_ORDEN_SERVICIO,0)&#xA;,CPR.FECHA_RECAUDO_EFECTY&#xA;,isnull(CPR.ID_CLIENTE,'0') ID_CLIENTE&#xA;,CPR.NOMBRE_TIPO_CANAL&#xA;,CPR.NOMBRE_CLASE_TIPO_CANAL&#xA;--,CPR.VALOR_TOTAL&#xA;--INTO #TMP_GUIAS_PENDIENTE_RECAUDO_1&#xA;FROM #COD_PENDIENTE_POR_RECAUDO CPR (NOLOCK)&#xA;WHERE LEN(CPR.NUMERO_GUIA)&gt;7&#xA;--INNER JOIN [Mece_Logistico].[dbo].[GUIAS] G (nolock) ON G.NUMERO_GUIA=CPR.NUMERO_GUIA&#xA;&#xA;--CREATE NONCLUSTERED INDEX [IX_NUMERO_GUIA] ON #TMP_GUIAS_PENDIENTE_RECAUDO_1 ([NUMERO_GUIA] ASC)&#xA;&#xA;--select GPR.* from #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA;&#xA;&#xA;UPDATE GPR SET&#xA; --GPR.NOMBRE_RESPONSABLE_ULT_MOV='SERVIENTREGA S.A.'&#xA; GPR.ID_PROCESO_ULT_MOV=SE.ID_PROCESO&#xA; ,GPR.NOMBRE_PROCESO_ULT_MOV=PRO.NOMBRE_PROCESO_LOG&#xA; ,GPR.ID_CONCEPTO_ULT_MOV=ISNULL(SE.ID_CONCEPTO,0)&#xA; ,GPR.NOMBRE_CONCEPTO_ULT_MOV=ISNULL(ICON.NOMBRE_CONCEPTO,'')&#xA; ,GPR.NUMERO_MOVIMI_ULT_MOV=SE.NUMERO_MOVIMI&#xA; ,GPR.CONSECUT_MOVIMI_ULT_MOV=SE.CONSECUT_MOVIMI&#xA; ,GPR.FECHA_HORA_MOVIMI_ULT_MOV=SE.FECHA_HORA_MOVIMIENTO&#xA; --,GPR.ID_CONDUCTOR_ULT_MOV=DOC.ID_COURIER_CONDUCTOR&#xA; --,GPR.ID_AUXILIAR_ULT_MOV=DOC.ID_AUXILIAR1_VEHICULO&#xA; --,GPR.ID_PAIS_ZONA_URBA_ULT_MOV=DOC.ID_PAIS_ZONA_URBA  &#xA; --,GPR.ID_CIUDAD_ZONA_URBA_ULT_MOV=DOC.ID_CIUDAD_ZONA_URBA &#xA; --,GPR.ID_TIPO_ZONA_URBA_ULT_MOV=DOC.ID_TIPO_ZONA_URBA&#xA; --,GPR.ID_ZONA_URBA_ULT_MOV=DOC.ID_ZONA_URBA&#xA; FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; INNER JOIN MECE_LOGISTICO.dbo.SEGUIMIENTO_ENVIO SE WITH(NOLOCK) on se.NUMERO_GUIA=GPR.NUMERO_GUIA&#xA; --INNER JOIN MECE_LOGISTICO.dbo.DOCUMENTOS DOC (NOLOCK) ON&#xA; --DOC.ID_PROCESO=GPR.[ID_PROCESO_ULT_MOV] AND DOC.NUMERO_MOVIMI=GPR.[NUMERO_MOVIMI_ULT_MOV] AND DOC.CONSECUT_MOVIMI=GPR.[CONSECUT_MOVIMI_ULT_MOV]&#xA; INNER JOIN PARAMETROS.DBO.PROCESOS PRO (NOLOCK) ON PRO.ID_PROCESO=SE.ID_PROCESO&#xA; LEFT JOIN PARAMETROS.DBO.ITEM_CONCEPTO ICON (NOLOCK) ON ICON.ID_PAIS=1 AND ICON.ID_PROCESO=SE.ID_PROCESO AND ICON.ID_CONCEPTO=SE.ID_CONCEPTO&#xA; WHERE se.FECHA_HORA_MOVIMIENTO= (select MAX(se1.FECHA_HORA_MOVIMIENTO) from MECE_LOGISTICO.dbo.SEGUIMIENTO_ENVIO SE1 WITH(NOLOCK)&#xA;          where SE1.numero_guia=GPR.NUMERO_GUIA)&#xA; &#xA; UPDATE GPR SET&#xA; GPR.ID_CONDUCTOR_ULT_MOV=DOC.ID_COURIER_CONDUCTOR&#xA; ,GPR.ID_AUXILIAR_ULT_MOV=DOC.ID_AUXILIAR1_VEHICULO&#xA; ,GPR.ID_PAIS_ZONA_URBA_ULT_MOV=DOC.ID_PAIS_ZONA_URBA  &#xA; ,GPR.ID_CIUDAD_ZONA_URBA_ULT_MOV=DOC.ID_CIUDAD_ZONA_URBA &#xA; ,GPR.ID_TIPO_ZONA_URBA_ULT_MOV=DOC.ID_TIPO_ZONA_URBA&#xA; ,GPR.ID_ZONA_URBA_ULT_MOV=DOC.ID_ZONA_URBA&#xA; FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; INNER JOIN MECE_LOGISTICO.DBO.DOCUMENTOS DOC (NOLOCK) ON&#xA; DOC.ID_PROCESO=GPR.[ID_PROCESO_ULT_MOV] AND DOC.NUMERO_MOVIMI=GPR.[NUMERO_MOVIMI_ULT_MOV] AND DOC.CONSECUT_MOVIMI=GPR.[CONSECUT_MOVIMI_ULT_MOV]&#xA;&#xA; --SELECT GPR.ID_CONDUCTOR_ULT_MOV&#xA; &#xA; UPDATE GPR SET&#xA; GPR.ID_CONDUCTOR_ULT_MOV=ISNULL(RTRIM(LTRIM(EC.ID_EMPLEADO)),'')&#xA; ,GPR.CONDUCTOR_ULT_MOV =ISNULL(RTRIM(LTRIM(EC.NOMBRE_EMPLEADO)) +' '+ RTRIM(LTRIM(EC.APELLIDO_EMPLEADO)),'') &#xA; ,GPR.ID_AUXILIAR_ULT_MOV=ISNULL(RTRIM(LTRIM(EA.ID_EMPLEADO)),'')&#xA; ,GPR.AUXILIAR_ULT_MOV=ISNULL(RTRIM(LTRIM(EA.NOMBRE_EMPLEADO)) +' '+ RTRIM(LTRIM(EA.APELLIDO_EMPLEADO)),'') &#xA; FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; LEFT JOIN PARAMETROS.DBO.EMPLEADOS EC (NOLOCK) ON EC.ID_EMPLEADO=GPR.ID_CONDUCTOR_ULT_MOV&#xA; LEFT JOIN PARAMETROS.DBO.EMPLEADOS EA (NOLOCK) ON EA.ID_EMPLEADO=GPR.ID_AUXILIAR_ULT_MOV&#xA;&#xA;&#xA; --SELECT GPR.NUMERO_GUIA,ISNULL(DIV.NOMBRE_DIVISION,'') AS NOMBRE_CDS, ISNULL(CTCAN.[NOMBRE_CLASE_TIPO_CANAL],'') as TIPO_CANAL&#xA;UPDATE GPR SET NOMBRE_CDS_ULT_MOV=ISNULL(DIV.NOMBRE_DIVISION,''),&#xA; TIPO_CANAL_ULT_MOV=ISNULL(CTCAN.[NOMBRE_CLASE_TIPO_CANAL],'')&#xA; FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; --INNER JOIN MECE_LOGISTICO.DBO.DOCUMENTOS DOC (NOLOCK) ON&#xA; --DOC.ID_PROCESO=GPR.[ID_PROCESO_ULT_MOV] AND DOC.NUMERO_MOVIMI=GPR.[NUMERO_MOVIMI_ULT_MOV] AND DOC.CONSECUT_MOVIMI=GPR.[CONSECUT_MOVIMI_ULT_MOV]&#xA; INNER JOIN PARAMETROS.DBO.ZONASURBANAS Z (NOLOCK) &#xA; ON Z.ID_PAIS = GPR.ID_PAIS_ZONA_URBA_ULT_MOV AND Z.ID_CIUDAD = GPR.ID_CIUDAD_ZONA_URBA_ULT_MOV &#xA;  AND Z.ID_TIPO_ZONA_URBA = GPR.ID_TIPO_ZONA_URBA_ULT_MOV AND Z.ID_ZONA_URBA = GPR.ID_ZONA_URBA_ULT_MOV --AND Z.CATEGORIA_ZONA_URBA = 8 --CLICOH&#xA; INNER JOIN PARAMETROS.DBO.DIVISIONES DIV (NOLOCK) ON DIV.ID_PAIS = Z.ID_PAIS_CANAL AND DIV.ID_CIUDAD = Z.ID_CIUDAD_CANAL AND DIV.ID_DIVISION = Z.ID_CANAL&#xA; INNER JOIN [Mece_Logistico].[dbo].[CANALES] CAN (NOLOCK) ON CAN.id_pais=DIV.ID_PAIS and CAN.id_ciudad=DIV.ID_CIUDAD and CAN.[ID_DIVISION]=DIV.ID_DIVISION&#xA; INNER JOIN [Mece_Logistico].[dbo].[TIPOS_CANAL] TCAN (NOLOCK) ON TCAN.ID_TIPO_CANAL=CAN.ID_TIPO_CANAL AND TCAN.ID_EST_TIPO_CANAL=1&#xA; INNER JOIN PARAMETROS.[dbo].[CLASE_TIPO_CANAL] CTCAN (NOLOCK) ON CTCAN.ID_CLASE_TIPO_CANAL=TCAN.CLASE_TIPO_CANAL&#xA;&#xA;&#xA; --UPDATE GPR SET ESTADO_ENTREGA='VENCIDO'&#xA; --SELECT * FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; UPDATE GPR SET ESTADO_ENTREGA='VENCIDO'&#xA; FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; WHERE GPR.ID_PROCESO_ULT_MOV=9 AND ID_CONCEPTO_ULT_MOV IN(9,7,2,4)--9 ENTREGAS OFIC  C.O.D. Y/O LPC EMPRESARIO --7 EMPRESARIO SATELITE ENTREGA EN OFICINA&#xA; --2 RECLAMO OFICINA Y 4 C.O.D RECLAMO OFICINA&#xA; AND DATEDIFF(DAY, FECHA_HORA_MOVIMI_ULT_MOV,GETDATE())&gt;8 -- MAS DE 8 DIAS&#xA; &#xA; UPDATE GPR SET ESTADO_ENTREGA='VENCIDO'&#xA; FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; WHERE GPR.ID_PROCESO_ULT_MOV=31 --ENVIO PARA ENTREGA EN OFICINA&#xA; AND DATEDIFF(DAY, FECHA_HORA_MOVIMI_ULT_MOV,GETDATE())&gt;8 -- MAS DE 8 DIAS&#xA;&#xA; UPDATE GPR SET ESTADO_ENTREGA='VENCIDO'&#xA; FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; WHERE GPR.ID_PROCESO_ULT_MOV=9 AND ID_CONCEPTO_ULT_MOV IN(10,8) --10 ENTR A DOMICI  LPC / COD EMPRESARIOS SAT --8 EMPRESARIO SATELITE ENTREGA EN DOMICILIO&#xA; AND DATEDIFF(DAY, FECHA_HORA_MOVIMI_ULT_MOV,GETDATE())&gt;3-- MAS DE 3 DIAS&#xA; &#xA; UPDATE GPR SET ESTADO_ENTREGA='VENCIDO'&#xA; FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; WHERE GPR.ID_PROCESO_ULT_MOV=32 --ENVIO PARA ENTREGA A DOMICILIO&#xA; AND DATEDIFF(DAY, FECHA_HORA_MOVIMI_ULT_MOV,GETDATE())&gt;3-- MAS DE 3 DIAS&#xA;&#xA; UPDATE GPR SET ESTADO_ENTREGA='VENCIDO'&#xA; FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; WHERE GPR.ID_PROCESO_ULT_MOV=9 AND ID_CONCEPTO_ULT_MOV IN(1,3) --SALIDA A ZONA Y C.O.D EN DISTRIBUCION&#xA; AND DATEDIFF(DAY, FECHA_HORA_MOVIMI_ULT_MOV,GETDATE())&gt;1 --MAS DE UN DIA&#xA;&#xA;&#xA;&#xA;DROP TABLE IF EXISTS #TMP_GUIAS_PENDIENTE_RECAUDO_SZU&#xA; SELECT &#xA; TMP.NUMERO_GUIA&#xA; ,(SE.CONSECUT_MOVIMI)   AS CONSECUT_MOVIMI_SZU&#xA; ,(SE.NUMERO_MOVIMI)    AS NUMERO_MOVIMI_SZU&#xA; ,(SE.FECHA_HORA_MOVIMIENTO)  AS FECHA_HORA_MOVIMI_ULT_MOV_SZU&#xA;INTO #TMP_GUIAS_PENDIENTE_RECAUDO_SZU&#xA;FROM #TMP_GUIAS_PENDIENTE_RECAUDO TMP&#xA;INNER JOIN Mece_Logistico..SEGUIMIENTO_ENVIO SE&#xA;ON SE.NUMERO_GUIA=TMP.NUMERO_GUIA&#xA;WHERE SE.ID_PROCESO=9&#xA;---GROUP BY  TMP.NUMERO_GUIA&#xA;&#xA;;WITH CTE AS(&#xA;SELECT &#xA;ROWID = ROW_NUMBER() OVER(PARTITION BY NUMERO_GUIA ORDER BY FECHA_HORA_MOVIMI_ULT_MOV_SZU DESC)&#xA;,NUMERO_GUIA,FECHA_HORA_MOVIMI_ULT_MOV_SZU&#xA;FROM #TMP_GUIAS_PENDIENTE_RECAUDO_SZU&#xA;)&#xA;DELETE CTE WHERE ROWID&gt;1&#xA;&#xA;&#xA;&#xA;SELECT * FROM #TMP_GUIAS_PENDIENTE_RECAUDO TMP&#xA;&#xA;&#xA;DROP TABLE IF EXISTS #TMP_GUIAS_CON_TAREAS &#xA; SELECT &#xA; TMP.NUMERO_GUIA,&#xA; COUNT(TAR.NUMERO_DOCPROBLEMA) AS NUMERO_TAREAS&#xA;INTO #TMP_GUIAS_CON_TAREAS&#xA;FROM #TMP_GUIAS_PENDIENTE_RECAUDO TMP&#xA;INNER JOIN Mece_Logistico..TAREAS TAR WITH(NOLOCK)&#xA;ON TAR.NUMERO_DOCPROBLEMA=CONVERT(CHAR(20),TMP.NUMERO_GUIA)&#xA;GROUP BY TMP.NUMERO_GUIA&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;DROP TABLE IF EXISTS ##TMP_GUIAS_PENDIENTE_RECAUDO_FINAL_PBI;&#xA;SELECT --GPR.*&#xA;GPR.NUMERO_GUIA &#xA;--GPR.ID_ESTADOENVIO &#xA;,GPR.NOMBRE_ESTADOENVIO &#xA;,GPR.FORMA_PAGO &#xA;,GPR.VALOR_A_RECAUDAR &#xA;,GPR.ID_REMITE &#xA;,GPR.NOMBRE_REMITE_GUIA &#xA;,GPR.FECHA_ENVIO&#xA;,GPR.VALOR_RECAUDADO&#xA;,GPR.FECHA_RECAUDO&#xA;,GPR.NUMERO_ORDEN_SERVICIO&#xA;,GPR.FECHA_RECAUDO_EFECTY&#xA;,GPR.ESTADO_ENTREGA&#xA;--,GPR.NOMBRE_RESPONSABLE_ULT_MOV &#xA;--ID_PROCESO_ULT_MOV &#xA;--NOMBRE_PROCESO_ULT_MOV &#xA;--NUMERO_MOVIMI_ULT_MOV &#xA;--CONSECUT_MOVIMI_ULT_MOV &#xA;--FECHA_HORA_MOVIMI_ULT_MOV&#xA;&#xA;--,ISNULL(ISNULL(CLO.CENTRO_LOGISTICO,CLD.CENTRO_LOGISTICO),'')  AS CPL_ORIGEN_ULT_MOV&#xA;--,ISNULL(ISNULL(RO.NOMBRE_REGIONAL,RD.NOMBRE_REGIONAL),'')  AS REGIONAL_ORIGEN_ULT_MOV&#xA;--,ISNULL(ISNULL(CO.NOMBRE_CIUDAD,CD.NOMBRE_CIUDAD),'')  AS CIUDAD_ORIGEN_ULT_MOV&#xA;--,ISNULL(ISNULL(CLD.CENTRO_LOGISTICO,CLO.CENTRO_LOGISTICO),'') AS CPL_DESTINO_ULT_MOV&#xA;--,ISNULL(ISNULL(RD.NOMBRE_REGIONAL,RO.NOMBRE_REGIONAL),'') AS REGIONAL_DESTINO_ULT_MOV&#xA;--,ISNULL(ISNULL(CD.NOMBRE_CIUDAD,CO.NOMBRE_CIUDAD),'') AS CIUDAD_DESTINO_MOV&#xA;,CASE WHEN ID_PROCESO!=14 THEN &#xA;ISNULL(ISNULL(CLO.CENTRO_LOGISTICO,CLD.CENTRO_LOGISTICO),'')  ELSE ISNULL(ISNULL(CLD.CENTRO_LOGISTICO,CLO.CENTRO_LOGISTICO),'') END AS CPL_ULT_MOV&#xA;,CASE WHEN ID_PROCESO!=14 THEN &#xA;ISNULL(ISNULL(RO.NOMBRE_REGIONAL,RD.NOMBRE_REGIONAL),'') ELSE ISNULL(ISNULL(RD.NOMBRE_REGIONAL,RO.NOMBRE_REGIONAL),'') END  AS REGIONAL_ULT_MOV&#xA;,CASE WHEN ID_PROCESO!=14 THEN &#xA;ISNULL(ISNULL(CO.NOMBRE_CIUDAD,CD.NOMBRE_CIUDAD),'')  ELSE ISNULL(ISNULL(CD.NOMBRE_CIUDAD,CO.NOMBRE_CIUDAD),'') END  AS CIUDAD_ULT_MOV&#xA;,ISNULL(CASE &#xA; WHEN ISNULL(DOC.ID_CIUDAD_ZONA_URBA,0) !=0 THEN&#xA; ROZ.NOMBRE_REGIONAL+' - '+ DCOZ.NOMBRE_DEPARTAMENTO +' - '+ COZ.NOMBRE_CIUDAD &#xA; WHEN  ISNULL(DOC.ID_CIUDAD_DIVISION_ORIGEN,0) !=0 AND DOC.ID_PROCESO!=14 THEN&#xA; ROM.NOMBRE_REGIONAL+' - '+ DCOM.NOMBRE_DEPARTAMENTO +' - '+ COM.NOMBRE_CIUDAD&#xA; ELSE&#xA; ROD.NOMBRE_REGIONAL+' - '+ DCOD.NOMBRE_DEPARTAMENTO +' - '+ COD.NOMBRE_CIUDAD &#xA; END,'') AS REG_DEPART_CIUDAD_ULTIMO_MOV&#xA;&#xA;,ISNULL(DOC.PLACA_VEHICULO_DOCU,'') as PLACA_VEHICULO_ULTIMO_MOV&#xA;,ISNULL(O.[NOMBRE_OPERATIVO],'') AS NOMBRE_OPERATIVO_ULTIMO_MOV&#xA;,ISNULL(Z.NOMBRE_ZONA_URBA,'') AS ZONA_URBANA_ULTIMO_MOV&#xA;,ISNULL(CZ.NOMBRE_CATEGORIA,'') AS CATEGORIA_ZONA_ULTIMO_MOV&#xA;,ISNULL(TZU.NOMBRE_TIPO_ZONA_URBA,'') AS TIPO_ZONA_ULTIMO_MOV&#xA;,ISNULL(GPR.NOMBRE_CDS_ULT_MOV,'') AS NOMBRE_CDS_ULT_MOV&#xA;,ISNULL(TIPO_CANAL_ULT_MOV,'') AS TIPO_CANAL_ULT_MOV&#xA;--,GR.ID_PROCESO &#xA;,ISNULL(GPR.NOMBRE_PROCESO_ULT_MOV,'') AS PROCESO_LOG_ULTIMO_MOV  &#xA;,ISNULL(GPR.NOMBRE_CONCEPTO_ULT_MOV,'') AS CONCEPTO_ULT_MOV&#xA;--,GR.ID_CONCEPTO  &#xA;--,GR.FECHA_HORA_MOVIMIENTO&#xA;,ISNULL(cast(GPR.ID_PROCESO_ULT_MOV as nvarchar) +' - '+ RTRIM(GPR.NOMBRE_PROCESO_ULT_MOV),'') AS NOMBRE_ULTIMO_MOV&#xA;,ISNULL(CASE WHEN DIO.ID_DIVISION IS NOT NULL THEN cast(DIO.ID_DIVISION as nvarchar) +' - '+ RTRIM(DIO.NOMBRE_DIVISION)&#xA;ELSE cast(DID.ID_DIVISION as nvarchar) +' - '+ RTRIM(DID.NOMBRE_DIVISION) END,'') AS BODEGA_ULTIMO_MOV&#xA;,ISNULL(cast(GPR.ID_PROCESO_ULT_MOV as nvarchar) +' - '+ RTRIM(GPR.[NUMERO_MOVIMI_ULT_MOV])+' - '+  cast(GPR.[CONSECUT_MOVIMI_ULT_MOV] as nvarchar),'') as ULTIMO_MOV_LOGISTICO&#xA;,ISNULL(CONVERT(nvarchar(20),GPR.FECHA_HORA_MOVIMI_ULT_MOV,120),'') AS FECHA_ULTIMO_MOV&#xA;,GPR.ID_CONDUCTOR_ULT_MOV&#xA;,GPR.CONDUCTOR_ULT_MOV&#xA;,GPR.ID_AUXILIAR_ULT_MOV&#xA;,GPR.AUXILIAR_ULT_MOV&#xA;,GPR.ID_CLIENTE&#xA;,SZU.CONSECUT_MOVIMI_SZU&#xA;,SZU.NUMERO_MOVIMI_SZU&#xA;,SZU.FECHA_HORA_MOVIMI_ULT_MOV_SZU&#xA;,GPR.NOMBRE_TIPO_CANAL&#xA;,GPR.NOMBRE_CLASE_TIPO_CANAL&#xA;,TAR.NUMERO_TAREAS&#xA;--,DOC.*&#xA;INTO ##TMP_GUIAS_PENDIENTE_RECAUDO_FINAL_PBI&#xA;&#xA;FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA;--------------------------- CIUDAD ULTIMO MOV ZONA&#xA;  LEFT JOIN MECE_LOGISTICO.DBO.DOCUMENTOS DOC (NOLOCK) ON&#xA; DOC.ID_PROCESO=GPR.[ID_PROCESO_ULT_MOV] AND DOC.NUMERO_MOVIMI=GPR.[NUMERO_MOVIMI_ULT_MOV] AND DOC.CONSECUT_MOVIMI=GPR.[CONSECUT_MOVIMI_ULT_MOV]&#xA; --AND DOC.ID_DIVISION_DESTINO IN (9311, 9308, 9304, 9313, 9310, 9312, 9711, 9710)&#xA;  LEFT JOIN PARAMETROS.DBO.CIUDADES COZ (NOLOCK) ON  COZ.ID_PAIS=1 AND COZ.ID_CIUDAD=DOC.ID_CIUDAD_ZONA_URBA&#xA;  LEFT JOIN PARAMETROS.DBO.REGIONALES_PAIS ROZ (NOLOCK) ON  ROZ.ID_PAIS=COZ.ID_PAIS AND ROZ.ID_REGIONAL=COZ.ID_REGIONAL&#xA;  LEFT JOIN PARAMETROS.DBO.DEPARTAMENTOS DCOZ (NOLOCK) ON  DCOZ.ID_PAIS=COZ.ID_PAIS AND DCOZ.ID_DEPARTAMENTO=COZ.ID_DEPARTAMENTO&#xA;   LEFT JOIN PARAMETROS.DBO.ZONASURBANAS Z (NOLOCK) &#xA; ON Z.ID_PAIS = DOC.ID_PAIS_ZONA_URBA AND Z.ID_CIUDAD = DOC.ID_CIUDAD_ZONA_URBA AND Z.ID_TIPO_ZONA_URBA = DOC.ID_TIPO_ZONA_URBA AND Z.ID_ZONA_URBA = DOC.ID_ZONA_URBA --AND Z.CATEGORIA_ZONA_URBA = 8 --CLICOH&#xA;  LEFT JOIN [PARAMETROS].[dbo].[CATEGORIAZONASURBANAS] CZ (NOLOCK) ON CZ.Id_Categoria=Z.CATEGORIA_ZONA_URBA&#xA;  LEFT JOIN [PARAMETROS].[dbo].[TIPOSZONASURBANAS] TZU (NOLOCK) ON TZU.ID_TIPO_ZONA_URBA=Z.ID_TIPO_ZONA_URBA&#xA; --------------------------- CIUDAD ULTIMO MOV DOCUMENTO&#xA;  LEFT JOIN PARAMETROS.DBO.CIUDADES COM (NOLOCK) ON  COM.ID_PAIS=1 AND COM.ID_CIUDAD=DOC.ID_CIUDAD_DIVISION_ORIGEN&#xA;  LEFT JOIN PARAMETROS.DBO.REGIONALES_PAIS ROM (NOLOCK) ON  ROM.ID_PAIS=COM.ID_PAIS AND ROM.ID_REGIONAL=COM.ID_REGIONAL&#xA;  LEFT JOIN PARAMETROS.DBO.DEPARTAMENTOS DCOM (NOLOCK) ON  DCOM.ID_PAIS=COM.ID_PAIS AND DCOM.ID_DEPARTAMENTO=COM.ID_DEPARTAMENTO&#xA;  --------------------------- CIUDAD DESTINO ULTIMO MOV DOCUMENTO&#xA;  LEFT JOIN PARAMETROS.DBO.CIUDADES COD(NOLOCK) ON  COD.ID_PAIS=1 AND COD.ID_CIUDAD=DOC.ID_CIUDAD_DESTINO&#xA;  LEFT JOIN PARAMETROS.DBO.REGIONALES_PAIS ROD (NOLOCK) ON  ROD.ID_PAIS=COD.ID_PAIS AND ROD.ID_REGIONAL=COD.ID_REGIONAL&#xA;  LEFT JOIN PARAMETROS.DBO.DEPARTAMENTOS DCOD (NOLOCK) ON  DCOD.ID_PAIS=COD.ID_PAIS AND DCOD.ID_DEPARTAMENTO=COD.ID_DEPARTAMENTO&#xA;  --------------------------- DIVISION ORIGEN ULTIMO MOV DOCUMENTO&#xA;  LEFT JOIN PARAMETROS.DBO.DIVISIONES DIO(NOLOCK) ON DIO.ID_PAIS=DOC.ID_PAIS_DIVISION_ORIGEN&#xA; AND DIO.ID_CIUDAD=DOC.ID_CIUDAD_DIVISION_ORIGEN AND DIO.ID_DIVISION=DOC.ID_DIVISION_ORIGEN&#xA;  --------------------------- DIVISION DESTINO ULTIMO MOV DOCUMENTO&#xA;  LEFT JOIN PARAMETROS.DBO.DIVISIONES DID(NOLOCK) ON DID.ID_PAIS=DOC.ID_PAIS_DESTINO&#xA; AND DID.ID_CIUDAD=DOC.ID_CIUDAD_DESTINO AND DID.ID_DIVISION=DOC.ID_DIVISION_DESTINO&#xA;-------------------------------------------------------------&#xA;  LEFT JOIN [PARAMETROS].[dbo].CIUDADES CO (NOLOCK) ON CO.ID_PAIS=ID_PAIS_DIVISION_ORIGEN AND CO.ID_CIUDAD=DOC.ID_CIUDAD_DIVISION_ORIGEN&#xA;  LEFT JOIN [PARAMETROS].[dbo].REGIONALES_PAIS RO (NOLOCK) ON RO.ID_PAIS=1 AND RO.ID_REGIONAL=CO.[ID_REGIONAL]&#xA;  LEFT JOIN [PARAMETROS].[dbo].CIUDADES CD (NOLOCK) ON CD.ID_PAIS=DOC.ID_PAIS_DESTINO AND CD.ID_CIUDAD=DOC.ID_CIUDAD_DESTINO&#xA;  LEFT JOIN [PARAMETROS].[dbo].REGIONALES_PAIS RD (NOLOCK) ON RD.ID_PAIS=1 AND RD.ID_REGIONAL=CD.[ID_REGIONAL]&#xA;  LEFT JOIN [PARAMETROS].[dbo].[OPERATIVOS] O (NOLOCK) ON O.[ID_PAIS_ORIGEN]=DOC.ID_PAIS_OPERATIVO AND O.[ID_CIUDAD_ORIGEN]=DOC.ID_CIUDAD_OPERATIVO&#xA; AND O.[ID_OPERATIVO]=DOC.ID_OPERATIVO&#xA;  LEFT JOIN #TMP_CIUDADES_ANEXAS CAO (NOLOCK) ON CAO.ID_PAIS=1 AND CAO.[ID_CIUDAD_ANEXA]=CO.ID_CIUDAD --AND CAO.RECOLECCION=1&#xA;  LEFT JOIN PARAMETROS.DBO.CENTROS_LOGISTICOS CLO (NOLOCK) ON CLO.ID_PAIS=1 AND CLO.ID_CIUDAD=CAO.ID_CIUDAD AND CLO.ID_CENTRO_LOGISTICO=1 AND CLO.ID_ESTADO=1&#xA;  LEFT JOIN #TMP_CIUDADES_ANEXAS CAD (NOLOCK) ON CAD.ID_PAIS=1 AND CAD.[ID_CIUDAD_ANEXA]=CD.ID_CIUDAD --AND CAD.RECOLECCION=1&#xA;  LEFT JOIN PARAMETROS.DBO.CENTROS_LOGISTICOS CLD (NOLOCK) ON CLD.ID_PAIS=1 AND CLD.ID_CIUDAD=CAD.ID_CIUDAD AND CLD.ID_CENTRO_LOGISTICO=1 AND CLD.ID_ESTADO=1&#xA;LEFT JOIN #TMP_GUIAS_PENDIENTE_RECAUDO_SZU SZU ON SZU.NUMERO_GUIA=GPR.NUMERO_GUIA&#xA;LEFT JOIN #TMP_GUIAS_CON_TAREAS TAR ON TAR.NUMERO_GUIA=GPR.NUMERO_GUIA&#xA;--WHERE &#xA;--NUMERO_GUIA=2273736466&#xA;--ID_PROCESO=32&#xA;&#xA;--DELETE CPR FROM #TMP_GUIAS_PENDIENTE_RECAUDO CPR &#xA;--WHERE&#xA;--NOT EXISTS (SELECT TOP 1 SE.NUMERO_GUIA FROM Mece_Logistico.DBO.SEGUIMIENTO_ENVIO SE (NOLOCK) WHERE SE.NUMERO_GUIA=CPR.NUMERO_GUIA AND SE.ID_PROCESO&gt;=5 AND  SE.ID_PROCESO&lt;27)&#xA;&#xA;&#xA;&#xA;--select  COUNT(1) from #TMP_GUIAS_PENDIENTE_RECAUDO&#xA;--select  COUNT(1) from ##TMP_GUIAS_PENDIENTE_RECAUDO_FINAL_PBI&#xA;&#xA;--select  * from ##TMP_GUIAS_PENDIENTE_RECAUDO_FINAL_PBI&#xA;&#xA;&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="0"
                SQLTask:DtsVariableName="User::STR_FechaIni"
                SQLTask:ParameterDirection="Input"
                SQLTask:DataType="129"
                SQLTask:ParameterSize="-1" />
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="1"
                SQLTask:DtsVariableName="User::STR_FechaFin"
                SQLTask:ParameterDirection="Input"
                SQLTask:DataType="129"
                SQLTask:ParameterSize="-1" />
            </SQLTask:SqlTaskData>
          </DTS:ObjectData>
        </DTS:Executable>
      </DTS:Executables>
    </DTS:Executable>
