        <pipeline
          version="1">
          <components>
            <component
              refId="Package\CARGUE MODREC DIM TIPO BODEGAS\PARAMETROS DIVISIONES"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
              description="OLE DB Source"
              name="PARAMETROS DIVISIONES"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">WITH CTE AS(
SELECT 
ROW_ID = ROW_NUMBER() OVER(PARTITION BY ID_PAIS,ID_CIUDAD,ID_DIVISION ORDER BY ID_EST_DIVISION)
,ID_PAIS
,ID_CIUDAD
,ID_DIVISION
,NOMBRE_DIVISION
,ID_EST_DIVISION
,CASE WHEN ID_DIVISION IN(9304,9308,9310,9311,9312,9313,9710,9711,9317,9367,9373,9374/* BODEGAS OTRAS*/ ,9311,9406,9304,9711,9310,9308,9710) THEN 'BODEGAS PRIMARIAS'
          WHEN ID_DIVISION IN(9321,9364,9365,9375,9377,9764,9765,9319  /* BODEGAS OTRAS*/,9312,9365,9765,9364,9364,9764,9377,9377,9319,9367,9368,9374,9373, /* se agregan dos bodegas  */ 9321,9313)                      THEN 'BODEGAS SECUNDARIAS'
          WHEN ID_DIVISION IN(9316,9318,9362,9366)                                          THEN 'BODEGAS CONTROL'
      ELSE 'OTRAS' END AS TIPO_BODEGA
FROM PARAMETROS.DBO.DIVISIONES VBS WITH(NOLOCK)
WHERE ID_EST_DIVISION&gt;=1
)
SELECT 
ID_PAIS
,ID_CIUDAD
,ID_DIVISION
,NOMBRE_DIVISION
,ID_EST_DIVISION
,TIPO_BODEGA
FROM CTE WHERE ROW_ID = 1</property>
