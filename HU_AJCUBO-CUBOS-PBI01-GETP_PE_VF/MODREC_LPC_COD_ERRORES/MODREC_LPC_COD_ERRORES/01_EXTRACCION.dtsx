    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{5E652CB6-E604-417A-A459-F6764978D3DB}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot;&#xA;DECLARE @FECHA_INI DATETIME, @FECHA_FIN DATETIME&#xA;&#xA;SET @FECHA_INI = CONVERT(DATETIME,'&quot;+ @[User::STR_FechaIni] +&quot;') --'2015-01-01 00:00:00.000' &#xA;SET @FECHA_FIN = CONVERT(DATETIME,'&quot;+ @[User::STR_FechaFin] +&quot;')&#xA;&#xA;SELECT SE.Fec_Creacion AS FECHA_CREA&#xA;&#x9;--,CONVERT(NUMERIC,CONVERT(DATETIME,CONVERT(CHAR(11),SE.Fec_Creacion)))AS TIME_ID_CREA&#xA;&#x9;--,CONVERT(DATETIME,CONVERT(CHAR(11),SE.Fec_Creacion))AS FECHA_CREA&#xA;&#x9;--,DAY (SE.Fec_Creacion) AS DIA_CREA&#xA;&#x9;--,MONTH (SE.Fec_Creacion) AS MES_CREA&#xA;&#x9;--,YEAR (SE.Fec_Creacion) AS AÑO_CREA&#xA;&#x9;,C.ID_CLIENTE AS ID_CLIENTE&#xA;&#x9;,SE.Ide_CodFacturacion AS CODSER&#xA;&#x9;,C.Id_Sucursal AS ID_SUCURSAL_SCN&#xA;&#x9;,C.Id_Dependencia AS ID_DEPENDENCIA_SCN&#xA;&#x9;,SE.Num_Guia AS NUMERO_GUIA_SCN&#xA;&#x9;,COUNT(DISTINCT SE.Num_Guia) AS CANT_GUIAS&#xA;&#x9;,SUM(CASE WHEN ISNULL(SE.Num_Piezas,0) = 0 THEN 1 ELSE SE.Num_Piezas END) AS CANT_PIEZAS&#xA;&#x9;,SE.Ide_Producto AS ID_PRODUCTO&#xA;&#x9;,SE.idePaisOrigen AS ID_PAIS_ORIGEN&#xA;&#x9;,SE.Des_CiudadRemitente AS ID_CIUDAD_ORIGEN&#xA;&#x9;,SE.idePaisDestino AS ID_PAIS_DESTINO&#xA;&#x9;,SE.Des_Ciudad AS ID_CIUDAD_DESTINO&#xA;&#x9;,G.Ide_TipoGuia AS ID_TIPO_GUIA --CRUZA CON SM Y SCN&#xA;&#x9;,SE.Des_TipoGuia AS ID_TIPO_GUIA_SCN --CRUZA SOLO CON SCN&#xA;&#x9;,SE.Est_Estado AS ID_ESTADO_GUIA&#xA;&#x9;,SE.Est_Cancelacion AS ID_ESTADO_CANCELACION&#xA;&#x9;,CASE WHEN SE.Num_Sobreporte IS NULL THEN 0 ELSE 1 END AS ID_TIENE_SOBREPORTE&#xA;&#x9;,SE.Des_TipoTrayecto AS ID_TIPO_TRAYECTO&#xA;&#x9;,SE.Ide_Transmitido AS ID_TRANSMITIDO&#xA;&#x9;,CASE WHEN SE.Ide_Manifiesto IS NULL THEN 0 ELSE 1 END AS ID_TIENE_MANIFIESTO&#xA;&#x9;,SE.Des_MedioTransporte AS  ID_MEDIO_TRANSPORTE&#x9;&#xA;&#x9;,CASE WHEN SE.Est_Estado &lt;&gt; 'I' AND SE.Fec_ImpresionEnvio IS NULL&#xA;&#x9;&#x9;&#x9;THEN 0&#xA;&#x9;&#x9;&#x9;ELSE DATEDIFF(MI,ISNULL(SE.Fec_Creacion,0), ISNULL(SE.Fec_ImpresionEnvio,0))&#xA;&#x9; END AS TIEMPO_MIN_CREA_IMPR&#xA;&#x9;,SE.Est_Reimpresion AS ID_EST_REIMPRESION&#xA;&#x9;,SE.Num_Intentos AS NUM_INTENTOS_REIMP&#xA;FROM /*SiSCliNet.*/dbo.SERT_ENVIO SE WITH (NOLOCK) --SiSCliNet_Historico.dbo.SERT_ENVIO SE WITH (NOLOCK)&#xA;&#x9;INNER JOIN SiSCliNet.dbo.SERT_CLIENTE_CODSER C WITH (NOLOCK) ON SE.Ide_CodFacturacion = C.Id_CodFacturacion&#xA;/**/INNER JOIN SiSCliNet.dbo.SERT_GuiasRango GR WITH (NOLOCK) ON SE.NUM_GUIA = GR.NUM_GUIA&#xA;&#x9;INNER JOIN SiSCliNet.dbo.SERT_Guias G WITH (NOLOCK) ON GR.IDE_RANGO = G.IDE_RANGO&#xA;WHERE SE.Fec_Creacion &gt;= @FECHA_INI --CONVERT(DATETIME,CONVERT(CHAR(11),GETDATE()-10)) --'2015-01-01 00:00:00.000'&#xA;&#x9;&#x9;AND SE.Fec_Creacion &lt; @FECHA_FIN --CONVERT(DATETIME,CONVERT(CHAR(11),GETDATE()))&#xA;&#x9;--YEAR(SE.Fec_Creacion) = 2015&#xA;&#x9;--AND MONTH(SE.Fec_Creacion) = 1  &#xA;&#x9;--and C.ID_CLIENTE = '900469230'&#xA;GROUP BY SE.Fec_Creacion&#xA;&#x9;,C.ID_CLIENTE&#xA;&#x9;,SE.Ide_CodFacturacion&#xA;&#x9;,C.Id_Sucursal&#xA;&#x9;,C.Id_Dependencia&#xA;&#x9;,SE.Num_Guia&#xA;&#x9;,SE.Ide_Producto&#xA;&#x9;,SE.idePaisOrigen&#xA;&#x9;,SE.Des_CiudadRemitente&#xA;&#x9;,SE.idePaisDestino&#xA;&#x9;,SE.Des_Ciudad&#xA;&#x9;,G.Ide_TipoGuia&#xA;&#x9;,SE.Des_TipoGuia&#xA;&#x9;,SE.Est_Estado&#xA;&#x9;,SE.Est_Cancelacion&#xA;&#x9;,CASE WHEN SE.Num_Sobreporte IS NULL THEN 0 ELSE 1 END&#xA;&#x9;,SE.Des_TipoTrayecto&#xA;&#x9;,SE.Ide_Transmitido&#xA;&#x9;,CASE WHEN SE.Ide_Manifiesto IS NULL THEN 0 ELSE 1 END&#xA;&#x9;,SE.Des_MedioTransporte&#xA;&#x9;,CASE WHEN SE.Est_Estado &lt;&gt; 'I' AND SE.Fec_ImpresionEnvio IS NULL&#xA;&#x9;&#x9;&#x9;THEN 0&#xA;&#x9;&#x9;&#x9;ELSE DATEDIFF(MI,ISNULL(SE.Fec_Creacion,0), ISNULL(SE.Fec_ImpresionEnvio,0))&#xA;&#x9; END&#xA;&#x9;,SE.Est_Reimpresion&#xA;&#x9;,SE.Num_Intentos&#xA;&#xA;&quot;"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="Z01_SCRIPT_01">
      <DTS:VariableValue
        DTS:DataType="8">
DECLARE @FECHA_INI DATETIME, @FECHA_FIN DATETIME

SET @FECHA_INI = CONVERT(DATETIME,'20251103') --'2015-01-01 00:00:00.000' 
SET @FECHA_FIN = CONVERT(DATETIME,'20261104')

SELECT SE.Fec_Creacion AS FECHA_CREA
	--,CONVERT(NUMERIC,CONVERT(DATETIME,CONVERT(CHAR(11),SE.Fec_Creacion)))AS TIME_ID_CREA
	--,CONVERT(DATETIME,CONVERT(CHAR(11),SE.Fec_Creacion))AS FECHA_CREA
	--,DAY (SE.Fec_Creacion) AS DIA_CREA
	--,MONTH (SE.Fec_Creacion) AS MES_CREA
	--,YEAR (SE.Fec_Creacion) AS AÑO_CREA
	,C.ID_CLIENTE AS ID_CLIENTE
	,SE.Ide_CodFacturacion AS CODSER
	,C.Id_Sucursal AS ID_SUCURSAL_SCN
	,C.Id_Dependencia AS ID_DEPENDENCIA_SCN
	,SE.Num_Guia AS NUMERO_GUIA_SCN
	,COUNT(DISTINCT SE.Num_Guia) AS CANT_GUIAS
	,SUM(CASE WHEN ISNULL(SE.Num_Piezas,0) = 0 THEN 1 ELSE SE.Num_Piezas END) AS CANT_PIEZAS
	,SE.Ide_Producto AS ID_PRODUCTO
	,SE.idePaisOrigen AS ID_PAIS_ORIGEN
	,SE.Des_CiudadRemitente AS ID_CIUDAD_ORIGEN
	,SE.idePaisDestino AS ID_PAIS_DESTINO
	,SE.Des_Ciudad AS ID_CIUDAD_DESTINO
	,G.Ide_TipoGuia AS ID_TIPO_GUIA --CRUZA CON SM Y SCN
	,SE.Des_TipoGuia AS ID_TIPO_GUIA_SCN --CRUZA SOLO CON SCN
	,SE.Est_Estado AS ID_ESTADO_GUIA
	,SE.Est_Cancelacion AS ID_ESTADO_CANCELACION
	,CASE WHEN SE.Num_Sobreporte IS NULL THEN 0 ELSE 1 END AS ID_TIENE_SOBREPORTE
	,SE.Des_TipoTrayecto AS ID_TIPO_TRAYECTO
	,SE.Ide_Transmitido AS ID_TRANSMITIDO
	,CASE WHEN SE.Ide_Manifiesto IS NULL THEN 0 ELSE 1 END AS ID_TIENE_MANIFIESTO
	,SE.Des_MedioTransporte AS  ID_MEDIO_TRANSPORTE	
	,CASE WHEN SE.Est_Estado &lt;&gt; 'I' AND SE.Fec_ImpresionEnvio IS NULL
			THEN 0
			ELSE DATEDIFF(MI,ISNULL(SE.Fec_Creacion,0), ISNULL(SE.Fec_ImpresionEnvio,0))
	 END AS TIEMPO_MIN_CREA_IMPR
	,SE.Est_Reimpresion AS ID_EST_REIMPRESION
	,SE.Num_Intentos AS NUM_INTENTOS_REIMP
FROM /*SiSCliNet.*/dbo.SERT_ENVIO SE WITH (NOLOCK) --SiSCliNet_Historico.dbo.SERT_ENVIO SE WITH (NOLOCK)
	INNER JOIN SiSCliNet.dbo.SERT_CLIENTE_CODSER C WITH (NOLOCK) ON SE.Ide_CodFacturacion = C.Id_CodFacturacion
/**/INNER JOIN SiSCliNet.dbo.SERT_GuiasRango GR WITH (NOLOCK) ON SE.NUM_GUIA = GR.NUM_GUIA
	INNER JOIN SiSCliNet.dbo.SERT_Guias G WITH (NOLOCK) ON GR.IDE_RANGO = G.IDE_RANGO
WHERE SE.Fec_Creacion &gt;= @FECHA_INI --CONVERT(DATETIME,CONVERT(CHAR(11),GETDATE()-10)) --'2015-01-01 00:00:00.000'
		AND SE.Fec_Creacion &lt; @FECHA_FIN --CONVERT(DATETIME,CONVERT(CHAR(11),GETDATE()))
	--YEAR(SE.Fec_Creacion) = 2015
	--AND MONTH(SE.Fec_Creacion) = 1  
	--and C.ID_CLIENTE = '900469230'
GROUP BY SE.Fec_Creacion
	,C.ID_CLIENTE
	,SE.Ide_CodFacturacion
	,C.Id_Sucursal
	,C.Id_Dependencia
	,SE.Num_Guia
	,SE.Ide_Producto
	,SE.idePaisOrigen
	,SE.Des_CiudadRemitente
	,SE.idePaisDestino
	,SE.Des_Ciudad
	,G.Ide_TipoGuia
	,SE.Des_TipoGuia
	,SE.Est_Estado
	,SE.Est_Cancelacion
	,CASE WHEN SE.Num_Sobreporte IS NULL THEN 0 ELSE 1 END
	,SE.Des_TipoTrayecto
	,SE.Ide_Transmitido
	,CASE WHEN SE.Ide_Manifiesto IS NULL THEN 0 ELSE 1 END
	,SE.Des_MedioTransporte
	,CASE WHEN SE.Est_Estado &lt;&gt; 'I' AND SE.Fec_ImpresionEnvio IS NULL
			THEN 0
			ELSE DATEDIFF(MI,ISNULL(SE.Fec_Creacion,0), ISNULL(SE.Fec_ImpresionEnvio,0))
	 END
	,SE.Est_Reimpresion
	,SE.Num_Intentos

</DTS:VariableValue>
    </DTS:Variable>
