          SQLTask:SqlStatementSource="UPDATE FAC01&#xA;SET FAC01.ID_ESTADO_NPC_SOLUCIONADA = 0&#xA;FROM  [FAC].[MODREC_LPC_COD_GUIAS] FAC01&#xA;WHERE FAC01.ID_ESTADO_NPC_SOLUCIONADA IS NULL&#xA;&#xA;&#xA;UPDATE FAC01&#xA;SET FAC01.ID_ESTADO_NPC_SOLUCIONADA = 1&#xA;FROM [FAC].[MODREC_LPC_COD_GUIAS] FAC01 WITH(NOLOCK)&#xA;INNER JOIN [FAC].[MODREC_LPC_GUIAS_SOLUCIONADAS_NO_PENDIENTES] FAC02 WITH(NOLOCK)&#xA;ON FAC01.NUMERO_GUIA=FAC02.NUMERO_GUIA &#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
