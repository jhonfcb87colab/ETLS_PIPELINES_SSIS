DECLARE @FECH_INI DATETIME =  '20251103' ;	/*---			'20260101';			*/
DECLARE @FECH_FIN DATETIME =  '20261104' ;	/*---			'20260101';			*/

IF OBJECT_ID('tempdb..#COD_PENDIENTE_POR_RECAUDO') IS NOT NULL 
    DROP TABLE #COD_PENDIENTE_POR_RECAUDO

IF OBJECT_ID('tempdb..#TMP_GUIAS_PENDIENTE_RECAUDO') IS NOT NULL 
    DROP TABLE #TMP_GUIAS_PENDIENTE_RECAUDO

CREATE TABLE #TMP_GUIAS_PENDIENTE_RECAUDO(
	NUMERO_GUIA numeric(20, 0) NOT NULL,
	ID_ESTADOENVIO smallint DEFAULT 0,
	NOMBRE_ESTADOENVIO varchar(40) DEFAULT '',
	FORMA_PAGO varchar(40) DEFAULT '',
	VALOR_A_RECAUDAR numeric(12, 2) NULL,
	ID_REMITE [varchar](40) DEFAULT '',
	NOMBRE_REMITE_GUIA  [varchar](200) DEFAULT '',
	-- ID_CIUDAD INT DEFAULT 0,
	-- [NOMBRE_CIUDAD] [varchar](50) DEFAULT '',
	FECHA_ENVIO datetime NULL,
	[VALOR_RECAUDADO] [numeric](11, 2) DEFAULT 0,
	FECHA_RECAUDO datetime NULL,
	NUMERO_ORDEN_SERVICIO varchar(20) DEFAULT '',
	FECHA_RECAUDO_EFECTY datetime NULL,
	ESTADO_ENTREGA varchar(70) DEFAULT 'A TIEMPO',--A TIEMPO O VENCIDO
	--NOMBRE_RESPONSABLE_ULT_MOV VARCHAR(100) DEFAULT '',
	ID_PROCESO_ULT_MOV int DEFAULT 0,
	NOMBRE_PROCESO_ULT_MOV varchar(70) DEFAULT '',
	ID_CONCEPTO_ULT_MOV int DEFAULT 0,
	NOMBRE_CONCEPTO_ULT_MOV varchar(70) DEFAULT '',
	NUMERO_MOVIMI_ULT_MOV char(30) DEFAULT '',
	CONSECUT_MOVIMI_ULT_MOV numeric(7, 0) DEFAULT 0,
	FECHA_HORA_MOVIMI_ULT_MOV datetime NULL,
	ID_PAIS_ZONA_URBA_ULT_MOV SMALLINT NULL,
	ID_CIUDAD_ZONA_URBA_ULT_MOV INT NULL,
	ID_TIPO_ZONA_URBA_ULT_MOV SMALLINT NULL,
	ID_ZONA_URBA_ULT_MOV SMALLINT NULL,
	NOMBRE_CDS_ULT_MOV varchar(100) DEFAULT '',
	TIPO_CANAL_ULT_MOV varchar(40) DEFAULT '',
	ID_CONDUCTOR_ULT_MOV varchar(40) DEFAULT '',
	CONDUCTOR_ULT_MOV  varchar(200) DEFAULT '',
	ID_AUXILIAR_ULT_MOV varchar(40) DEFAULT '',
	AUXILIAR_ULT_MOV varchar(200) DEFAULT '',
	ID_CLIENTE [char](20) NOT NULL,
	NOMBRE_TIPO_CANAL varchar(100) DEFAULT '',
	NOMBRE_CLASE_TIPO_CANAL varchar(100) DEFAULT '',
	[G_ID_CIUDAD_ORIGEN] [int] NULL,
	[G_ID_CIUDAD_DESTINO] [int] NULL,
	ESTA_RECAUDADO  [int] NULL
) ON [PRIMARY]
CREATE NONCLUSTERED INDEX [IX_NUMERO_GUIA] ON #TMP_GUIAS_PENDIENTE_RECAUDO ([NUMERO_GUIA] ASC)
CREATE NONCLUSTERED INDEX [IX_ZONA] ON #TMP_GUIAS_PENDIENTE_RECAUDO (ID_PAIS_ZONA_URBA_ULT_MOV,ID_CIUDAD_ZONA_URBA_ULT_MOV, ID_TIPO_ZONA_URBA_ULT_MOV,ID_ZONA_URBA_ULT_MOV ASC)
CREATE NONCLUSTERED INDEX [IX_MANIFIESTO] ON #TMP_GUIAS_PENDIENTE_RECAUDO (ID_PROCESO_ULT_MOV,NUMERO_MOVIMI_ULT_MOV,CONSECUT_MOVIMI_ULT_MOV ASC)


IF OBJECT_ID('tempdb..#TMP_CIUDADES_ANEXAS') IS NOT NULL 
    DROP TABLE #TMP_CIUDADES_ANEXAS

---CIUDADES ANEXAS
SELECT CAD.* 
INTO #TMP_CIUDADES_ANEXAS FROM PARAMETROS.DBO.CIUDADES_ANEXAS CAD (NOLOCK) 
WHERE CAD.ID_PAIS=1 AND CAD.RECOLECCION=1

INSERT INTO #TMP_CIUDADES_ANEXAS
SELECT CAD.* FROM PARAMETROS.DBO.CIUDADES_ANEXAS CAD (NOLOCK) 
LEFT JOIN #TMP_CIUDADES_ANEXAS TCAD ON TCAD.ID_CIUDAD_ANEXA=CAD.ID_CIUDAD_ANEXA
WHERE CAD.ID_PAIS=1 AND CAD.RECOLECCION=0 AND TCAD.ID_CIUDAD_ANEXA IS NULL

DELETE T FROM (SELECT *, 
    DupRank = ROW_NUMBER() OVER (PARTITION BY ID_CIUDAD_ANEXA ORDER BY FECHA_CREACION DESC) 
     FROM #TMP_CIUDADES_ANEXAS) AS T
WHERE DupRank &gt; 1



SELECT CPR.*
,G.ID_CLIENTE,G.ID_REMITE,G.NOMBRE_REMITE_GUIA
,G.ID_PRODUCTO AS ID_PRODUCTO_GUIA
,G.ID_ESTADOENVIO
,G.ID_ESTADOGUIA
,ISNULL(G.VALOR_SEG_MAN_GUIAS,0)+ISNULL(G.VALOR_FLETES_GUIAS,0) AS VALOR_ENVIO_GUIA
,ISNULL(GIA.VALOR_RECAUDAR_PRODUCTO,0) AS VALOR_RECAUDAR_PRODUCTO_GUIA
,CAST('' AS nvarchar(50)) AS NOMBRE_ESTADOENVIO,G.FECHA_ENVIO
,TCAN.NOMBRE_TIPO_CANAL
,CTCAN.NOMBRE_CLASE_TIPO_CANAL
,G.[ID_CIUDAD_ORIGEN]			AS G_ID_CIUDAD_ORIGEN
,G.[ID_CIUDAD_DESTINO]			AS G_ID_CIUDAD_DESTINO
INTO #COD_PENDIENTE_POR_RECAUDO
FROM [Mece_Logistico].[dbo].[COD_PENDIENTE_POR_RECAUDO] CPR (NOLOCK)
INNER JOIN [Mece_Logistico].[dbo].[GUIAS] G (nolock) ON G.NUMERO_GUIA=CPR.NUMERO_GUIA
LEFT JOIN [Mece_Logistico].[dbo].[GUIAS_INF_ADICIONAL] GIA (nolock) ON GIA.NUMERO_GUIA=CPR.NUMERO_GUIA
LEFT JOIN [tmp_borrar_local].dbo.LPC_GUIAS_SOLUCIONADAS LGS (NOLOCK) ON LGS.NUMERO_GUIA=CPR.NUMERO_GUIA
LEFT JOIN [Mece_Logistico].[dbo].[CANALES] CAN (NOLOCK) ON CAN.id_pais=G.ID_1 and CAN.id_ciudad=G.ID_2 and CAN.[ID_DIVISION]=G.ID_CANAL
LEFT JOIN [Mece_Logistico].[dbo].[TIPOS_CANAL] TCAN (NOLOCK) ON TCAN.ID_TIPO_CANAL=CAN.ID_TIPO_CANAL AND TCAN.ID_EST_TIPO_CANAL=1
LEFT JOIN PARAMETROS.[dbo].[CLASE_TIPO_CANAL] CTCAN (NOLOCK) ON CTCAN.ID_CLASE_TIPO_CANAL=TCAN.CLASE_TIPO_CANAL
WHERE LGS.NUMERO_GUIA IS NULL 
/*AND ISNULL(CPR.ESTADO_COD,1)=1-- RECAUDO ESTA ACTIVO*/---&gt;(se descarta por solicitud de luis gabriel rodriguez y Holman Salamanca el dia 2026-04-09 11:44am )
AND ISNULL(CPR.ESTA_RECAUDADO,0)=0 -- NO ESTA RECAUDADO
--AND G.ID_ESTADOGUIA!=4-- NO ESTA ANULADA
AND ISNULL(CPR.NUMERO_ORDEN_SERVICIO,'')='' -- NO TIENE ORDEN DE RECAUDO DE EFECTY
AND ISNULL(CPR.ESTA_ANULADO,0)=0 -- NO DEBE ESTAR ANULADA
--AND G.ID_DIVISION_PROV IS NULL
AND isnull(G.ID_DIVISION_PROV,0) = 0
--AND CPR.FECHA_CREACION &gt;= @FECHA_INI 
--AND CPR.FECHA_CREACION &lt; @FECHA_FIN
AND CPR.FECHA_CREACION BETWEEN convert(datetime,@FECH_INI) AND convert(datetime,@FECH_FIN)
--AND CPR.NUMERO_GUIA= 3047455723


/*
AND CPR.FECHA_CREACION BETWEEN	convert(datetime,'20251201') 
							AND convert(datetime,'20260201')
*/


INSERT INTO #COD_PENDIENTE_POR_RECAUDO
/*
SELECT CPR.*,G.ID_CLIENTE,G.ID_REMITE,G.NOMBRE_REMITE_GUIA,G.ID_PRODUCTO AS ID_PRODUCTO_GUIA,G.ID_ESTADOENVIO,G.ID_ESTADOGUIA,ISNULL(G.VALOR_SEG_MAN_GUIAS,0)+ISNULL(G.VALOR_FLETES_GUIAS,0) AS VALOR_ENVIO_GUIA,ISNULL(GIA.VALOR_RECAUDAR_PRODUCTO,0) AS VALOR_RECAUDAR_PRODUCTO_GUIA
,CAST('' AS nvarchar(50)) AS NOMBRE_ESTADOENVIO,G.FECHA_ENVIO
*/
SELECT CPR.*
,G.ID_CLIENTE,G.ID_REMITE,G.NOMBRE_REMITE_GUIA
,G.ID_PRODUCTO AS ID_PRODUCTO_GUIA
,G.ID_ESTADOENVIO
,G.ID_ESTADOGUIA
,ISNULL(G.VALOR_SEG_MAN_GUIAS,0)+ISNULL(G.VALOR_FLETES_GUIAS,0) AS VALOR_ENVIO_GUIA
,ISNULL(GIA.VALOR_RECAUDAR_PRODUCTO,0) AS VALOR_RECAUDAR_PRODUCTO_GUIA
,CAST('' AS nvarchar(50)) AS NOMBRE_ESTADOENVIO,G.FECHA_ENVIO
,TCAN.NOMBRE_TIPO_CANAL
,CTCAN.NOMBRE_CLASE_TIPO_CANAL
,G.[ID_CIUDAD_ORIGEN]			AS G_ID_CIUDAD_ORIGEN
,G.[ID_CIUDAD_DESTINO]			AS G_ID_CIUDAD_DESTINO
FROM [Mece_Logistico].[dbo].[COD_PENDIENTE_POR_RECAUDO] CPR (NOLOCK)
INNER JOIN [Mece_Logistico].[dbo].[GUIAS] G (nolock) ON G.NUMERO_GUIA=CPR.NUMERO_GUIA
LEFT JOIN [Mece_Logistico].[dbo].[GUIAS_INF_ADICIONAL] GIA (nolock) ON GIA.NUMERO_GUIA=CPR.NUMERO_GUIA
LEFT JOIN [tmp_borrar_local].dbo.LPC_GUIAS_SOLUCIONADAS LGS (NOLOCK) ON LGS.NUMERO_GUIA=CPR.NUMERO_GUIA
LEFT JOIN [Mece_Logistico].[dbo].[CANALES] CAN (NOLOCK) ON CAN.id_pais=G.ID_1 and CAN.id_ciudad=G.ID_2 and CAN.[ID_DIVISION]=G.ID_CANAL
LEFT JOIN [Mece_Logistico].[dbo].[TIPOS_CANAL] TCAN (NOLOCK) ON TCAN.ID_TIPO_CANAL=CAN.ID_TIPO_CANAL AND TCAN.ID_EST_TIPO_CANAL=1
LEFT JOIN PARAMETROS.[dbo].[CLASE_TIPO_CANAL] CTCAN (NOLOCK) ON CTCAN.ID_CLASE_TIPO_CANAL=TCAN.CLASE_TIPO_CANAL
WHERE LGS.NUMERO_GUIA IS NULL AND
ISNULL(CPR.ESTADO_COD,1)=1-- RECAUDO ESTA ACTIVO
AND ISNULL(CPR.ESTA_ANULADO,0)=0 -- NO DEBE ESTAR ANULADA
AND ISNULL(CPR.ESTA_RECAUDADO,0)=1 -- RECAUDADO EN RECAUDOS PERO NO TIENE LA FORMADE RECAUDO
AND (ISNULL(CPR.NUMERO_ORDEN_SERVICIO,'')='' AND ISNULL(CPR.ID_MODALPAGO,0)=0 AND ISNULL(RTRIM(LTRIM(CPR.NUMERO_APROBACION)),'')='' AND ISNULL(INGRESO_MANUAL,0)=0)
--AND G.ID_DIVISION_PROV IS NULL
AND isnull(G.ID_DIVISION_PROV,0) = 0
--AND CPR.FECHA_CREACION&gt;=DATEADD(YEAR, -1,GETDATE())
AND CPR.FECHA_CREACION BETWEEN convert(datetime,@FECH_INI) AND convert(datetime,@FECH_FIN)
----AND CPR.NUMERO_GUIA= 3047455723



; WITH CTE_DELL AS ( SELECT ROW_NUMBER() OVER(PARTITION BY NUMERO_GUIA ORDER BY FECHA_ACTUALIZACION DESC) AS ROWID,
						NUMERO_GUIA FROM #COD_PENDIENTE_POR_RECAUDO) DELETE CTE_DELL WHERE ROWID&gt;1

---SELECT TOP 100 * FROM #COD_PENDIENTE_POR_RECAUDO


--Id_Cod	NUMERO_GUIA	ID_PAIS	ID_CIUDAD	ID_AUXILIAR	ID_DIVISION_RECAUDADORA	ID_CIUDAD_ORIGEN	ID_CIUDAD_ENTREGA	FECHA_ASIGNACION_AL_AUXILIAR	ESTADO_COD	ESTA_RECAUDADO	FECHA_RECAUDO	ESTA_DEVUELTO	FECHA_DEVOLUCION	ESTA_ANULADO	FECHA_ANULACION	CAUSAL_DEVOLUCION	VALOR_ENVIO	ES_COD_CORPORATIVO	NUMERO_FACTURA	VALOR_RECAUDADO	VALOR_IMPUESTO	CARGAR_A_LA_CUENTA	ESTA_CARGADO_A_LA_CUENTA	ID_CLIENTE_PS_A_FACTURAR	ID_TIPO_COD	ID_ACTUALIZADO	FECHA_ACTUALIZACION	LOGIN_EMPLEADO_CREACION	FECHA_CREACION	LOGIN_EMPLEADO_MODIFICACION	FECHA_MODIFICACION	ID_PRODUCTO	ID_SUBPRODUCTO	ID_FORMA_PAGO	ID_TIEMPO_ENTREGA	ID_MEDIO_TRANSPORTE	PESO_FISICO_GUIA	NUMERO_PIEZAS	VALOR_DECLARADO	VALOR_FLETE	VALOR_OTROS	VALOR_TOTAL	ID_MOVIMIENTO	VALOR_PRODUCTO	NUMERO_CODIGO_EFECTY	INGRESO_MANUAL	NUMERO_ORDEN_SERVICIO	ID_PUNTO_RECAUDO	FECHA_RECAUDO_EFECTY	NUMERO_ORDEN_SERVICIO2	ID_MODALPAGO	NUMERO_APROBACION	FRANQUICIA	ID_CLIENTE	ID_REMITE	NOMBRE_REMITE_GUIA	ID_PRODUCTO_GUIA	ID_ESTADOENVIO	ID_ESTADOGUIA	VALOR_ENVIO_GUIA	VALOR_RECAUDAR_PRODUCTO_GUIA	NOMBRE_ESTADOENVIO	FECHA_ENVIO	NOMBRE_TIPO_CANAL	NOMBRE_CLASE_TIPO_CANAL	G_ID_CIUDAD_ORIGEN	G_ID_CIUDAD_DESTINO

/*
select G.NUMERO_GUIA
,TCAN.NOMBRE_TIPO_CANAL
,CTCAN.NOMBRE_CLASE_TIPO_CANAL
from Mece_Logistico.dbo.guias G (nolock)
left JOIN [Mece_Logistico].[dbo].[CANALES] CAN (NOLOCK) ON CAN.id_pais=G.ID_1 and CAN.id_ciudad=G.ID_2 and CAN.[ID_DIVISION]=G.ID_CANAL
left JOIN [Mece_Logistico].[dbo].[TIPOS_CANAL] TCAN (NOLOCK) ON TCAN.ID_TIPO_CANAL=CAN.ID_TIPO_CANAL AND TCAN.ID_EST_TIPO_CANAL=1
left JOIN PARAMETROS.[dbo].[CLASE_TIPO_CANAL] CTCAN (NOLOCK) ON CTCAN.ID_CLASE_TIPO_CANAL=TCAN.CLASE_TIPO_CANAL
where G.ID_CANAL IS NOT NULL
AND FECHA_ENVIO&gt;='20260120 00:00:00'
*/

CREATE NONCLUSTERED INDEX [IX_NUMERO_GUIA] ON #COD_PENDIENTE_POR_RECAUDO ([NUMERO_GUIA] ASC)




