      DTS:EvaluateAsExpression="True"
      DTS:Expression="(DT_WSTR, 10)&#xA;( &#xA;&#x9;(&#xA;&#x9;&#x9;(&#xA;&#x9;&#x9;&#x9;(  YEAR( @[User::FechaIni_REPOBLAR]  )*100 )   &#xA;&#x9;&#x9;&#x9;+&#xA;&#x9;&#x9;&#x9;(  MONTH( @[User::FechaIni_REPOBLAR] )  )&#xA;&#x9;&#x9;)*100&#xA;&#x9;)+ DAY( @[User::FechaIni_REPOBLAR] )&#xA;)"
