          DTS:LocaleID="-1"
          DTS:ObjectName="IDS REGIONAL ORG-DEST"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="2">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{29421002-977B-462F-97AB-580A05328076}"
              SQLTask:SqlStatementSource="&#xA;----ID_REGIONAL_DESTINO&#xA;--SELECT * &#xA;UPDATE TMP SET &#xA;[G_ID_REGIONAL_DESTINO] = CD.ID_REGIONAL&#xA;FROM [TMP].[MODREC_LPC_COD_PS01] TMP WITH(NOLOCK)&#xA;INNER JOIN PAR.CIUDADES CD WITH(NOLOCK)&#xA;ON CD.ID_CIUDAD=TMP.G_ID_CIUDAD_DESTINO AND CD.ID_PAIS=1&#xA;&#xA;----ID_REGIONAL_ORIGEN&#xA;--SELECT * &#xA;UPDATE TMP SET &#xA;[G_ID_REGIONAL_ORIGEN] = CD.ID_REGIONAL&#xA;FROM [TMP].[MODREC_LPC_COD_PS01] TMP WITH(NOLOCK)&#xA;INNER JOIN PAR.CIUDADES CD WITH(NOLOCK)&#xA;ON CD.ID_CIUDAD=TMP.G_ID_CIUDAD_ORIGEN AND CD.ID_PAIS=1&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
