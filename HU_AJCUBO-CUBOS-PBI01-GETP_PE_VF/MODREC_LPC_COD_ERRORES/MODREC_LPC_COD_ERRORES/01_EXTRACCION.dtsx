          SQLTask:Connection="{5C0C1DAF-D2DA-497C-987A-001823FDFDAE}"
          SQLTask:SqlStatementSource="use SIG_LOGISTICA_DM&#xA;&#xA;----select * from [FAC].[MODREC_LPC_COD_GUIAS]&#xA;--alter table [FAC].[MODREC_LPC_COD_GUIAS] add ID_CLIENTE varchar(20)&#xA;--alter table [FAC].[MODREC_LPC_COD_GUIAS] add [CONSECUT_MOVIMI_SZU] numeric(7,0)&#xA;--alter table [FAC].[MODREC_LPC_COD_GUIAS] add [NUMERO_MOVIMI_SZU] varchar(30)&#xA;--alter table [FAC].[MODREC_LPC_COD_GUIAS] add [FECHA_HORA_MOVIMI_ULT_MOV_SZU] datetime&#xA;--alter table [FAC].[MODREC_LPC_COD_GUIAS] add [NOMBRE_TIPO_CANAL] varchar(100)&#xA;--alter table [FAC].[MODREC_LPC_COD_GUIAS] add [NOMBRE_CLASE_TIPO_CANAL] varchar(100)&#xA;--ALTER TABLE [FAC].[MODREC_LPC_COD_GUIAS] ADD [NUMERO_TAREAS] int&#xA;&#xA;--ALTER TABLE [FAC].[MODREC_LPC_COD_GUIAS] ADD [G_ID_CIUDAD_ORIGEN] [int] NULL&#xA;--ALTER TABLE [FAC].[MODREC_LPC_COD_GUIAS] ADD [G_ID_CIUDAD_DESTINO] [int] NULL&#xA;&#xA;--ALTER TABLE [FAC].[MODREC_LPC_COD_GUIAS] ADD [G_ID_REGIONAL_ORIGEN] [int] NULL&#xA;--ALTER TABLE [FAC].[MODREC_LPC_COD_GUIAS] ADD [G_ID_REGIONAL_DESTINO] [int] NULL&#xA;----alter table [SIG_LOGISTICA_DM].[FAC].[MODREC_LPC_COD_GUIAS] add CNF_ID_CONFIRMACION&#x9;int&#xA;&#xA;&#xA;&#xA;MERGE &#xA;[FAC].[MODREC_LPC_COD_GUIAS] AS target  -- TABLA OBJETIVO (TABLA PARA INSERTAR DATOS)&#xA;USING &#x9;[SIG_COLOMBIA_DW].[TMP].[MODREC_LPC_COD_PS01] AS source ---TABLA FUENTE (TABLA TEMPORAL)&#xA;&#x9;ON target.NUMERO_GUIA = source.NUMERO_GUIA&#x9;------COLUMNAS LLAVE&#xA;WHEN MATCHED &#xA;&#x9;THEN        &#xA;&#x9;UPDATE SET &#xA;&#x9;&#x9;&#x9;&#x9;target.NUMERO_GUIA = source.NUMERO_GUIA&#xA;&#x9;&#x9;&#x9;&#x9;,target.NOMBRE_ESTADOENVIO = source.NOMBRE_ESTADOENVIO&#xA;&#x9;&#x9;&#x9;&#x9;,target.FORMA_PAGO = source.FORMA_PAGO&#xA;&#x9;&#x9;&#x9;&#x9;,target.VALOR_A_RECAUDAR = source.VALOR_A_RECAUDAR&#xA;&#x9;&#x9;&#x9;&#x9;,target.ID_REMITE = source.ID_REMITE&#xA;&#x9;&#x9;&#x9;&#x9;,target.NOMBRE_REMITE_GUIA = source.NOMBRE_REMITE_GUIA&#xA;&#x9;&#x9;&#x9;&#x9;,target.FECHA_ENVIO = source.FECHA_ENVIO&#xA;&#x9;&#x9;&#x9;&#x9;,target.VALOR_RECAUDADO = source.VALOR_RECAUDADO&#xA;&#x9;&#x9;&#x9;&#x9;,target.FECHA_RECAUDO = source.FECHA_RECAUDO&#xA;&#x9;&#x9;&#x9;&#x9;,target.NUMERO_ORDEN_SERVICIO = source.NUMERO_ORDEN_SERVICIO&#xA;&#x9;&#x9;&#x9;&#x9;,target.FECHA_RECAUDO_EFECTY = source.FECHA_RECAUDO_EFECTY&#xA;&#x9;&#x9;&#x9;&#x9;,target.ESTADO_ENTREGA = source.ESTADO_ENTREGA&#xA;&#x9;&#x9;&#x9;&#x9;,target.CPL_ULT_MOV = source.CPL_ULT_MOV&#xA;&#x9;&#x9;&#x9;&#x9;,target.REGIONAL_ULT_MOV = source.REGIONAL_ULT_MOV&#xA;&#x9;&#x9;&#x9;&#x9;,target.CIUDAD_ULT_MOV = source.CIUDAD_ULT_MOV&#xA;&#x9;&#x9;&#x9;&#x9;,target.REG_DEPART_CIUDAD_ULTIMO_MOV = source.REG_DEPART_CIUDAD_ULTIMO_MOV&#xA;&#x9;&#x9;&#x9;&#x9;,target.PLACA_VEHICULO_ULTIMO_MOV = source.PLACA_VEHICULO_ULTIMO_MOV&#xA;&#x9;&#x9;&#x9;&#x9;,target.NOMBRE_OPERATIVO_ULTIMO_MOV = source.NOMBRE_OPERATIVO_ULTIMO_MOV&#xA;&#x9;&#x9;&#x9;&#x9;,target.ZONA_URBANA_ULTIMO_MOV = source.ZONA_URBANA_ULTIMO_MOV&#xA;&#x9;&#x9;&#x9;&#x9;,target.CATEGORIA_ZONA_ULTIMO_MOV = source.CATEGORIA_ZONA_ULTIMO_MOV&#xA;&#x9;&#x9;&#x9;&#x9;,target.TIPO_ZONA_ULTIMO_MOV = source.TIPO_ZONA_ULTIMO_MOV&#xA;&#x9;&#x9;&#x9;&#x9;,target.NOMBRE_CDS_ULT_MOV = source.NOMBRE_CDS_ULT_MOV&#xA;&#x9;&#x9;&#x9;&#x9;,target.TIPO_CANAL_ULT_MOV = source.TIPO_CANAL_ULT_MOV&#xA;&#x9;&#x9;&#x9;&#x9;,target.PROCESO_LOG_ULTIMO_MOV = source.PROCESO_LOG_ULTIMO_MOV&#xA;&#x9;&#x9;&#x9;&#x9;,target.CONCEPTO_ULT_MOV = source.CONCEPTO_ULT_MOV&#xA;&#x9;&#x9;&#x9;&#x9;,target.NOMBRE_ULTIMO_MOV = source.NOMBRE_ULTIMO_MOV&#xA;&#x9;&#x9;&#x9;&#x9;,target.BODEGA_ULTIMO_MOV = source.BODEGA_ULTIMO_MOV&#xA;&#x9;&#x9;&#x9;&#x9;,target.ULTIMO_MOV_LOGISTICO = source.ULTIMO_MOV_LOGISTICO&#xA;&#x9;&#x9;&#x9;&#x9;,target.FECHA_ULTIMO_MOV = source.FECHA_ULTIMO_MOV&#xA;&#x9;&#x9;&#x9;&#x9;,target.ID_CONDUCTOR_ULT_MOV = source.ID_CONDUCTOR_ULT_MOV&#xA;&#x9;&#x9;&#x9;&#x9;,target.CONDUCTOR_ULT_MOV = source.CONDUCTOR_ULT_MOV&#xA;&#x9;&#x9;&#x9;&#x9;,target.ID_AUXILIAR_ULT_MOV = source.ID_AUXILIAR_ULT_MOV&#xA;&#x9;&#x9;&#x9;&#x9;,target.AUXILIAR_ULT_MOV = source.AUXILIAR_ULT_MOV&#xA;&#x9;&#x9;&#x9;&#x9;,target.FECHA_EXTRACCION = source.FECHA_EXTRACCION&#xA;&#x9;&#x9;&#x9;&#x9;,target.ID_CLIENTE = source.ID_CLIENTE&#xA;&#x9;&#x9;&#x9;&#x9;,target.[CONSECUT_MOVIMI_SZU] = source.[CONSECUT_MOVIMI_SZU]&#xA;&#x9;&#x9;&#x9;&#x9;,target.[NUMERO_MOVIMI_SZU] = source.[NUMERO_MOVIMI_SZU]&#xA;&#x9;&#x9;&#x9;&#x9;,target.[FECHA_HORA_MOVIMI_ULT_MOV_SZU] = source.[FECHA_HORA_MOVIMI_ULT_MOV_SZU]&#xA;&#x9;&#x9;&#x9;&#x9;,target.[NOMBRE_TIPO_CANAL] = source.[NOMBRE_TIPO_CANAL]&#xA;&#x9;&#x9;&#x9;&#x9;,target.[NOMBRE_CLASE_TIPO_CANAL] = source.[NOMBRE_CLASE_TIPO_CANAL]&#x9;&#x9;&#x9;&#xA;&#x9;&#x9;&#x9;&#x9;,target.[NUMERO_TAREAS] = source.[NUMERO_TAREAS]&#xA;&#x9;&#x9;&#x9;&#x9;,target.[G_ID_CIUDAD_ORIGEN]   =  source.[G_ID_CIUDAD_ORIGEN]&#xA;&#x9;&#x9;&#x9;&#x9;,target.[G_ID_CIUDAD_DESTINO]&#x9;= source.[G_ID_CIUDAD_DESTINO]&#x9;&#xA;&#x9;&#x9;&#x9;&#x9;,target.[G_ID_REGIONAL_ORIGEN]  = source.[G_ID_REGIONAL_ORIGEN] &#xA;&#x9;&#x9;&#x9;&#x9;,target.[G_ID_REGIONAL_DESTINO] = source.[G_ID_REGIONAL_DESTINO]&#xA;&#x9;&#x9;&#x9;&#x9;,target.[CNF_ID_CONFIRMACION] = source.[CNF_ID_CONFIRMACION]&#xA;WHEN NOT MATCHED THEN    &#xA;&#x9;INSERT (&#xA;&#x9;&#x9;&#x9;&#x9;NUMERO_GUIA&#xA;&#x9;&#x9;&#x9;&#x9;,NOMBRE_ESTADOENVIO&#xA;&#x9;&#x9;&#x9;&#x9;,FORMA_PAGO&#xA;&#x9;&#x9;&#x9;&#x9;,VALOR_A_RECAUDAR&#xA;&#x9;&#x9;&#x9;&#x9;,ID_REMITE&#xA;&#x9;&#x9;&#x9;&#x9;,NOMBRE_REMITE_GUIA&#xA;&#x9;&#x9;&#x9;&#x9;,FECHA_ENVIO&#xA;&#x9;&#x9;&#x9;&#x9;,VALOR_RECAUDADO&#xA;&#x9;&#x9;&#x9;&#x9;,FECHA_RECAUDO&#xA;&#x9;&#x9;&#x9;&#x9;,NUMERO_ORDEN_SERVICIO&#xA;&#x9;&#x9;&#x9;&#x9;,FECHA_RECAUDO_EFECTY&#xA;&#x9;&#x9;&#x9;&#x9;,ESTADO_ENTREGA&#xA;&#x9;&#x9;&#x9;&#x9;,CPL_ULT_MOV&#xA;&#x9;&#x9;&#x9;&#x9;,REGIONAL_ULT_MOV&#xA;&#x9;&#x9;&#x9;&#x9;,CIUDAD_ULT_MOV&#xA;&#x9;&#x9;&#x9;&#x9;,REG_DEPART_CIUDAD_ULTIMO_MOV&#xA;&#x9;&#x9;&#x9;&#x9;,PLACA_VEHICULO_ULTIMO_MOV&#xA;&#x9;&#x9;&#x9;&#x9;,NOMBRE_OPERATIVO_ULTIMO_MOV&#xA;&#x9;&#x9;&#x9;&#x9;,ZONA_URBANA_ULTIMO_MOV&#xA;&#x9;&#x9;&#x9;&#x9;,CATEGORIA_ZONA_ULTIMO_MOV&#xA;&#x9;&#x9;&#x9;&#x9;,TIPO_ZONA_ULTIMO_MOV&#xA;&#x9;&#x9;&#x9;&#x9;,NOMBRE_CDS_ULT_MOV&#xA;&#x9;&#x9;&#x9;&#x9;,TIPO_CANAL_ULT_MOV&#xA;&#x9;&#x9;&#x9;&#x9;,PROCESO_LOG_ULTIMO_MOV&#xA;&#x9;&#x9;&#x9;&#x9;,CONCEPTO_ULT_MOV&#xA;&#x9;&#x9;&#x9;&#x9;,NOMBRE_ULTIMO_MOV&#xA;&#x9;&#x9;&#x9;&#x9;,BODEGA_ULTIMO_MOV&#xA;&#x9;&#x9;&#x9;&#x9;,ULTIMO_MOV_LOGISTICO&#xA;&#x9;&#x9;&#x9;&#x9;,FECHA_ULTIMO_MOV&#xA;&#x9;&#x9;&#x9;&#x9;,ID_CONDUCTOR_ULT_MOV&#xA;&#x9;&#x9;&#x9;&#x9;,CONDUCTOR_ULT_MOV&#xA;&#x9;&#x9;&#x9;&#x9;,ID_AUXILIAR_ULT_MOV&#xA;&#x9;&#x9;&#x9;&#x9;,AUXILIAR_ULT_MOV&#xA;&#x9;&#x9;&#x9;&#x9;,FECHA_EXTRACCION&#xA;&#x9;&#x9;&#x9;&#x9;,ID_CLIENTE&#xA;&#x9;&#x9;&#x9;&#x9;,[CONSECUT_MOVIMI_SZU]&#xA;&#x9;&#x9;&#x9;&#x9;,[NUMERO_MOVIMI_SZU]&#xA;&#x9;&#x9;&#x9;&#x9;,[FECHA_HORA_MOVIMI_ULT_MOV_SZU]&#xA;&#x9;&#x9;&#x9;&#x9;,[NOMBRE_TIPO_CANAL]&#xA;&#x9;&#x9;&#x9;&#x9;,[NOMBRE_CLASE_TIPO_CANAL] &#xA;&#x9;&#x9;&#x9;&#x9;,[NUMERO_TAREAS]&#xA;&#x9;&#x9;&#x9;&#x9;,[G_ID_CIUDAD_ORIGEN]&#xA;&#x9;&#x9;&#x9;&#x9;,[G_ID_CIUDAD_DESTINO]&#xA;&#x9;&#x9;&#x9;&#x9;,[G_ID_REGIONAL_ORIGEN] &#xA;&#x9;&#x9;&#x9;&#x9;,[G_ID_REGIONAL_DESTINO]&#xA;&#x9;&#x9;&#x9;&#x9;,[CNF_ID_CONFIRMACION]&#xA;&#x9;)    &#xA;&#x9;VALUES (&#xA;&#x9;&#x9;&#x9;source.NUMERO_GUIA&#xA;&#x9;&#x9;&#x9;,source.NOMBRE_ESTADOENVIO&#xA;&#x9;&#x9;&#x9;,case when len(source.FORMA_PAGO)&lt;1 then 'NO DISPONIBLE' ELSE source.FORMA_PAGO END&#xA;&#x9;&#x9;&#x9;,source.VALOR_A_RECAUDAR&#xA;&#x9;&#x9;&#x9;,source.ID_REMITE&#xA;&#x9;&#x9;&#x9;,source.NOMBRE_REMITE_GUIA&#xA;&#x9;&#x9;&#x9;,source.FECHA_ENVIO&#xA;&#x9;&#x9;&#x9;,source.VALOR_RECAUDADO&#xA;&#x9;&#x9;&#x9;,source.FECHA_RECAUDO&#xA;&#x9;&#x9;&#x9;,source.NUMERO_ORDEN_SERVICIO&#xA;&#x9;&#x9;&#x9;,source.FECHA_RECAUDO_EFECTY&#xA;&#x9;&#x9;&#x9;,source.ESTADO_ENTREGA&#xA;&#x9;&#x9;&#x9;,source.CPL_ULT_MOV&#xA;&#x9;&#x9;&#x9;,source.REGIONAL_ULT_MOV&#xA;&#x9;&#x9;&#x9;,source.CIUDAD_ULT_MOV&#xA;&#x9;&#x9;&#x9;,source.REG_DEPART_CIUDAD_ULTIMO_MOV&#xA;&#x9;&#x9;&#x9;,source.PLACA_VEHICULO_ULTIMO_MOV&#xA;&#x9;&#x9;&#x9;,source.NOMBRE_OPERATIVO_ULTIMO_MOV&#xA;&#x9;&#x9;&#x9;,source.ZONA_URBANA_ULTIMO_MOV&#xA;&#x9;&#x9;&#x9;,source.CATEGORIA_ZONA_ULTIMO_MOV&#xA;&#x9;&#x9;&#x9;,source.TIPO_ZONA_ULTIMO_MOV&#xA;&#x9;&#x9;&#x9;,source.NOMBRE_CDS_ULT_MOV&#xA;&#x9;&#x9;&#x9;,source.TIPO_CANAL_ULT_MOV&#xA;&#x9;&#x9;&#x9;,source.PROCESO_LOG_ULTIMO_MOV&#xA;&#x9;&#x9;&#x9;,source.CONCEPTO_ULT_MOV&#xA;&#x9;&#x9;&#x9;,source.NOMBRE_ULTIMO_MOV&#xA;&#x9;&#x9;&#x9;,source.BODEGA_ULTIMO_MOV&#xA;&#x9;&#x9;&#x9;,source.ULTIMO_MOV_LOGISTICO&#xA;&#x9;&#x9;&#x9;,source.FECHA_ULTIMO_MOV&#xA;&#x9;&#x9;&#x9;,source.ID_CONDUCTOR_ULT_MOV&#xA;&#x9;&#x9;&#x9;,source.CONDUCTOR_ULT_MOV&#xA;&#x9;&#x9;&#x9;,source.ID_AUXILIAR_ULT_MOV&#xA;&#x9;&#x9;&#x9;,source.AUXILIAR_ULT_MOV&#xA;&#x9;&#x9;&#x9;,source.FECHA_EXTRACCION&#xA;&#x9;&#x9;&#x9;,source.ID_CLIENTE &#xA;&#x9;&#x9;&#x9;,source.[CONSECUT_MOVIMI_SZU]&#xA;&#x9;&#x9;&#x9;,source.[NUMERO_MOVIMI_SZU]&#xA;&#x9;&#x9;&#x9;,source.[FECHA_HORA_MOVIMI_ULT_MOV_SZU]&#xA;&#x9;&#x9;&#x9;,source.[NOMBRE_TIPO_CANAL]&#xA;&#x9;&#x9;&#x9;,source.[NOMBRE_CLASE_TIPO_CANAL]&#xA;&#x9;&#x9;&#x9;,source.[NUMERO_TAREAS]&#xA;&#x9;&#x9;&#x9;,source.[G_ID_CIUDAD_ORIGEN]&#xA;&#x9;&#x9;&#x9;,source.[G_ID_CIUDAD_DESTINO]&#x9;&#xA;&#x9;&#x9;&#x9;,source.[G_ID_REGIONAL_ORIGEN] &#xA;&#x9;&#x9;&#x9;,source.[G_ID_REGIONAL_DESTINO]&#xA;&#x9;&#x9;&#x9;,source.[CNF_ID_CONFIRMACION]&#xA;&#x9;);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
