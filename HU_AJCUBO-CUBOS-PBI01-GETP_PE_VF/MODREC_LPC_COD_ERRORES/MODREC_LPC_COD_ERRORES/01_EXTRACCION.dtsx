DECLARE @FECH_INI DATETIME =  '20221103' ;	/*---			'20260101';			*/
DECLARE @FECH_FIN DATETIME =  '20261104' ;	/*---			'20260101';			*/
IF OBJECT_ID('tempdb..#COD_PENDIENTE_POR_RECAUDO') IS NOT NULL 
    DROP TABLE #COD_PENDIENTE_POR_RECAUDO

IF OBJECT_ID('tempdb..#TMP_GUIAS_PENDIENTE_RECAUDO') IS NOT NULL 
    DROP TABLE #TMP_GUIAS_PENDIENTE_RECAUDO

IF OBJECT_ID('tempdb..#TMP_CIUDADES_ANEXAS') IS NOT NULL 
    DROP TABLE #TMP_CIUDADES_ANEXAS

---CIUDADES ANEXAS
SELECT CAD.* 
INTO #TMP_CIUDADES_ANEXAS FROM PARAMETROS.DBO.CIUDADES_ANEXAS CAD (NOLOCK) 
WHERE CAD.ID_PAIS=1 AND CAD.RECOLECCION=1

INSERT INTO #TMP_CIUDADES_ANEXAS
SELECT CAD.* FROM PARAMETROS.DBO.CIUDADES_ANEXAS CAD (NOLOCK) 
LEFT JOIN #TMP_CIUDADES_ANEXAS TCAD ON TCAD.ID_CIUDAD_ANEXA=CAD.ID_CIUDAD_ANEXA
WHERE CAD.ID_PAIS=1 AND CAD.RECOLECCION=0 AND TCAD.ID_CIUDAD_ANEXA IS NULL

DELETE T FROM (SELECT *, 
    DupRank = ROW_NUMBER() OVER (PARTITION BY ID_CIUDAD_ANEXA ORDER BY FECHA_CREACION DESC) 
     FROM #TMP_CIUDADES_ANEXAS) AS T
WHERE DupRank &gt; 1


DROP TABLE IF EXISTS #PARAMETROS_DBO_CIUDADES;
SELECT * 
INTO #PARAMETROS_DBO_CIUDADES
FROM PARAMETROS.DBO.CIUDADES CD WITH(NOLOCK)

DROP TABLE IF EXISTS #PARAMETROS_DBO_REGIONALES_PAIS;
SELECT * 
INTO #PARAMETROS_DBO_REGIONALES_PAIS
FROM PARAMETROS.DBO.REGIONALES_PAIS RG WITH(NOLOCK)

DROP TABLE IF EXISTS #Mece_Logistico_dbo_COD_PENDIENTE_POR_RECAUDO;
SELECT *
INTO #Mece_Logistico_dbo_COD_PENDIENTE_POR_RECAUDO
FROM [Mece_Logistico].[dbo].[COD_PENDIENTE_POR_RECAUDO] CPR WITH (NOLOCK)
WHERE 
    -- Filtros de fecha y condiciones generales obligatorias
    CPR.FECHA_ASIGNACION_AL_AUXILIAR &gt;= @FECH_INI 
    AND CPR.FECHA_ASIGNACION_AL_AUXILIAR &lt;= @FECH_FIN
    AND ISNULL(CPR.ESTA_ANULADO, 0) = 0 
    AND ISNULL(CPR.ESTA_RECAUDADO, 0) = 0
    AND (
        -- Bloque 1 (equivalente al primer SELECT)
        (
            (CPR.NUMERO_ORDEN_SERVICIO IS NULL OR CPR.NUMERO_ORDEN_SERVICIO = '')
        )
        OR
        -- Bloque 2 (equivalente al segundo SELECT)
        (
            ISNULL(CPR.ESTADO_COD, 0) = 1 
            AND (CPR.NUMERO_ORDEN_SERVICIO IS NULL OR CPR.NUMERO_ORDEN_SERVICIO = '')
            AND ISNULL(CPR.ID_MODALPAGO, 0) = 0 
            AND (CPR.NUMERO_APROBACION IS NULL OR LTRIM(RTRIM(CPR.NUMERO_APROBACION)) = '')
            AND ISNULL(CPR.INGRESO_MANUAL, 0) = 0
        )
    );

CREATE NONCLUSTERED INDEX [IX_NUMERO_GUIA_PEND_RECAUDO] ON #Mece_Logistico_dbo_COD_PENDIENTE_POR_RECAUDO
(
	[NUMERO_GUIA] ASC
)WITH (PAD_INDEX = OFF, STATISTICS_NORECOMPUTE = OFF, SORT_IN_TEMPDB = OFF, DROP_EXISTING = OFF, ONLINE = OFF, ALLOW_ROW_LOCKS = ON, ALLOW_PAGE_LOCKS = ON, FILLFACTOR = 80) ON [PRIMARY]


SELECT 
    CPR.*
    ,G.ID_CLIENTE, G.ID_REMITE
    ,G.NOMBRE_REMITE_GUIA
    ,G.ID_PRODUCTO AS ID_PRODUCTO_GUIA
    ,G.ID_ESTADOENVIO, G.ID_ESTADOGUIA
    ,ISNULL(G.VALOR_SEG_MAN_GUIAS, 0) + ISNULL(G.VALOR_FLETES_GUIAS, 0) AS VALOR_ENVIO_GUIA
    ,ISNULL(GIA.VALOR_RECAUDAR_PRODUCTO, 0) AS VALOR_RECAUDAR_PRODUCTO_GUIA
    ,CAST('' AS nvarchar(50)) AS NOMBRE_ESTADOENVIO
    ,G.FECHA_ENVIO
    ,TCAN.NOMBRE_TIPO_CANAL
    ,CTCAN.NOMBRE_CLASE_TIPO_CANAL
    ,G.[ID_CIUDAD_ORIGEN] AS G_ID_CIUDAD_ORIGEN
    ,G.[ID_CIUDAD_DESTINO] AS G_ID_CIUDAD_DESTINO
    ,CIUD.ID_REGIONAL AS ID_REGIONAL_ENTREGA_PEND_RECAUDO
    ,CPR.ID_CIUDAD_ENTREGA AS ID_CIUDAD_ENTREGA_PEND_RECAUDO
	INTO #COD_PENDIENTE_POR_RECAUDO
FROM #Mece_Logistico_dbo_COD_PENDIENTE_POR_RECAUDO CPR WITH (NOLOCK)
INNER JOIN [Mece_Logistico].[dbo].[GUIAS] G WITH (NOLOCK) 
    ON G.NUMERO_GUIA = CPR.NUMERO_GUIA
LEFT JOIN [Mece_Logistico].[dbo].[GUIAS_INF_ADICIONAL] GIA WITH (NOLOCK) 
    ON GIA.NUMERO_GUIA = CPR.NUMERO_GUIA
LEFT JOIN [Mece_Logistico].[dbo].[CANALES] CAN WITH (NOLOCK) 
    ON CAN.id_pais = G.ID_1 
   AND CAN.id_ciudad = G.ID_2 
   AND CAN.[ID_DIVISION] = G.ID_CANAL
LEFT JOIN [Mece_Logistico].[dbo].[TIPOS_CANAL] TCAN WITH (NOLOCK) 
    ON TCAN.ID_TIPO_CANAL = CAN.ID_TIPO_CANAL 
   AND TCAN.ID_EST_TIPO_CANAL = 1
LEFT JOIN PARAMETROS.[dbo].[CLASE_TIPO_CANAL] CTCAN WITH (NOLOCK) 
    ON CTCAN.ID_CLASE_TIPO_CANAL = TCAN.CLASE_TIPO_CANAL
LEFT JOIN PARAMETROS.[dbo].[CIUDADES] CIUD WITH (NOLOCK) 
    ON CIUD.ID_CIUDAD = CPR.ID_CIUDAD_ENTREGA
WHERE ISNULL(G.ID_DIVISION_PROV, 0) = 0

; WITH CTE_DELL AS ( SELECT ROW_NUMBER() OVER(PARTITION BY NUMERO_GUIA ORDER BY FECHA_ACTUALIZACION DESC) AS ROWID,
						NUMERO_GUIA FROM #COD_PENDIENTE_POR_RECAUDO) DELETE CTE_DELL WHERE ROWID&gt;1
CREATE NONCLUSTERED INDEX [IX_NUMERO_GUIA] ON #COD_PENDIENTE_POR_RECAUDO ([NUMERO_GUIA] ASC)
--Se quitan envios siniestrados
DELETE GPR FROM #COD_PENDIENTE_POR_RECAUDO GPR
WHERE ID_ESTADOENVIO in(5,4)

--Quita las guias son del canal retail y no son COD y no contraentrega ecommerce
DELETE GPR FROM #COD_PENDIENTE_POR_RECAUDO GPR
WHERE ID_FORMA_PAGO=1 AND ISNULL(ID_PRODUCTO_GUIA,999) !=86
--WHERE ID_FORMA_PAGO=1 AND ISNULL(ID_PRODUCTO,999) !=86


--Quita las guias CREDICONTADO (Solicitud de luis gabriel rodriguez y Holman Salamanca el dia 2026-04-09 11:44am )
/*

ID_FORMAPAGO	NOMBRE_FORMAPAGO
1	CONTADO
2	CREDITO
3	PREPAGO DIGITAL
4	C.O.D. 
5	CHEQUE
6	TARJETAS FINANCIERAS
7	CREDI CONTADO
9	QR
10	TARJETA
*/
DELETE GPR FROM #COD_PENDIENTE_POR_RECAUDO GPR
WHERE ID_FORMA_PAGO=7
-----ok

UPDATE CPR SET CPR.NOMBRE_ESTADOENVIO=E.NOMBRE_ESTADOENVIO
FROM #COD_PENDIENTE_POR_RECAUDO CPR
INNER JOIN PARAMETROS.DBO.ESTADOSENVIO E (NOLOCK)ON E.ID_ESTADOENVIO=CPR.ID_ESTADOENVIO
