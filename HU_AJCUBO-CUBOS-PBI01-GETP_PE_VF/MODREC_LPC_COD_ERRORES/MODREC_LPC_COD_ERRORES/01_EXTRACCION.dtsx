      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Delete periodos Antiguos 3 años"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="2">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{5C0C1DAF-D2DA-497C-987A-001823FDFDAE}"
          SQLTask:SqlStatementSource="DELETE [FAC].[MODREC_LPC_COD_GUIAS] WHERE FECHA_ULTIMO_MOV &lt;= DATEADD(YEAR,-3,DATEADD(mm,DATEDIFF(mm,0,GETDATE()),0))&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Depurar guias repetidas"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{C38F3932-53F2-4FF2-BB9E-6F76F940CD9D}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Depurar guias repetidas"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="2">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{5C0C1DAF-D2DA-497C-987A-001823FDFDAE}"
          SQLTask:SqlStatementSource="WITH CTE AS (&#xA;SELECT &#xA;ROWID = ROW_NUMBER() OVER(PARTITION BY NUMERO_GUIA ORDER BY FECHA_ULTIMO_MOV DESC),&#xA;NUMERO_GUIA,&#xA;FECHA_ULTIMO_MOV&#xA;FROM [FAC].[MODREC_LPC_COD_GUIAS] WITH(NOLOCK)&#xA;)DELETE CTE WHERE ROWID&gt;1&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
