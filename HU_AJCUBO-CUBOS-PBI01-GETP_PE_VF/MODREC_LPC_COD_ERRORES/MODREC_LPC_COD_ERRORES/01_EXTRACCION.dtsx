      <DTS:Variables />
      <DTS:Executables>
        <DTS:Executable
          DTS:refId="Package\Extraccion Datos\AJUSTRAR NULOS Y CON ESPACIOS"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{DBC35248-0992-4A66-9334-B27B4D24370F}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="AJUSTRAR NULOS Y CON ESPACIOS"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="2">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{29421002-977B-462F-97AB-580A05328076}"
              SQLTask:SqlStatementSource="&#xA;UPDATE TMP  SET &#xA;NUMERO_TAREAS = 0&#xA;FROM [TMP].[MODREC_LPC_COD_PS01] TMP&#xA;WHERE TMP.NUMERO_TAREAS IS NULL &#xA;&#xA;&#xA;&#xA;&#xA;&#xA;USE SIG_COLOMBIA_DW;&#xA;UPDATE TMP SET&#xA;TMP.FORMA_PAGO = 'NO DISPONIBLE'&#xA;FROM [TMP].[MODREC_LPC_COD_PS01] TMP WITH(NOLOCK)&#xA;WHERE LEN(FORMA_PAGO)&lt;1 &#xA;&#xA;&#xA;USE SIG_LOGISTICA_DM;&#xA;UPDATE FAC SET&#xA;FAC.FORMA_PAGO = 'NO DISPONIBLE'&#xA;FROM [FAC].[MODREC_LPC_COD_GUIAS] FAC WITH(NOLOCK)&#xA;WHERE LEN(FORMA_PAGO)&lt;1 &#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Extraccion Datos\Cargue DIM FAC_AUX"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{3CE682D6-3546-4E08-A2A4-DC82D4919EB7}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Cargue DIM FAC_AUX"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="2">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{5C0C1DAF-D2DA-497C-987A-001823FDFDAE}"
              SQLTask:SqlStatementSource="use SIG_LOGISTICA_DM;&#xA;TRUNCATE TABLE [DIM].[MODREC_CONCEPTO_SOLUCIONES]&#xA;INSERT INTO [DIM].[MODREC_CONCEPTO_SOLUCIONES]&#xA;SELECT [ID_CONCEPTO]&#xA;      ,[DESCRIPCION]&#xA;      ,[ESTADO]&#xA;      ,[LOGIN_EMPLEADO]&#xA;      ,[FECHA_CREACION]&#xA;      ,[FECHA_MODIFICACION]&#xA;      ,[LOGIN_MODIFICACION]&#xA;  FROM [SIG_COLOMBIA_DW].[PAR].[MODREC_CONCEPTO_SOLUCIONES] WITH(NOLOCK)&#xA;&#xA;&#xA;&#xA;TRUNCATE TABLE [DIM].[MODREC_MOTIVO_SOLUCIONES]&#xA;INSERT INTO [DIM].[MODREC_MOTIVO_SOLUCIONES]&#xA;SELECT [ID_MOTIVO]&#xA;      ,[DESCRIPCION]&#xA;      ,[ESTADO]&#xA;      ,[LOGIN_EMPLEADO]&#xA;      ,[FECHA_CREACION]&#xA;      ,[FECHA_MODIFICACION]&#xA;      ,[LOGIN_MODIFICACION]&#xA;  FROM [SIG_COLOMBIA_DW].[PAR].[MODREC_MOTIVO_SOLUCIONES] WITH(NOLOCK)&#xA;&#xA;&#xA;TRUNCATE TABLE [DIM].[MODREC_LPC_GUIAS_SOLUCIONADAS]&#xA;INSERT INTO [DIM].[MODREC_LPC_GUIAS_SOLUCIONADAS]&#xA;SELECT [NUMERO_GUIA]&#xA;      ,[ID_MOTIVO]&#xA;      ,[ID_CONCEPTO]&#xA;      ,[VALOR]&#xA;      ,[PERIODO_CASTIGO]&#xA;      ,[VALOR_REINTEGRADO]&#xA;      ,[NUMERO_OS_REINTEGRADA]&#xA;      ,[FECHA_OS]&#xA;      ,[PERIODO_ANIO_MES]&#xA;      ,[NUMERO_OS]&#xA;      ,[NUM_ACTA]&#xA;      ,[FECHA_CONSIGNACION]&#xA;      ,[ENTIDAD_RECAUDADORA]&#xA;      ,[CONFIRMACION_CLIENTE]&#xA;      ,[MOTIVO_ESPECIFICO]&#xA;      ,[LOGIN_EMPLEADO]&#xA;      ,[FECHA_CREACION]&#xA;      ,[ID_EMPLEADO_MODIFICACION]&#xA;      ,[FECHA_MODIFICACION]&#xA;      ,[ESTADO]&#xA;  FROM [SIG_COLOMBIA_DW].[TMP].[MODREC_LPC_GUIAS_SOLUCIONADAS] WITH(NOLOCK)&#xA;&#xA;&#xA;&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Extraccion Datos\Cargue fac guias solucionadas"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{DBC5E236-DFCD-491B-BCD1-79B4E3DB1670}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Cargue fac guias solucionadas"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="2">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{5C0C1DAF-D2DA-497C-987A-001823FDFDAE}"
              SQLTask:SqlStatementSource="DROP TABLE IF EXISTS #SIG_COLOMBIA_DW_TMP_MODREC_LPC_GUIAS_SOLUCIONADAS;&#xA;WITH  CTE AS (&#xA;SELECT &#xA;NUMERO_GUIA&#xA;,ID_MOTIVO&#xA;,ID_CONCEPTO&#xA;,VALOR&#xA;,PERIODO_CASTIGO&#xA;,VALOR_REINTEGRADO&#xA;,NUMERO_OS_REINTEGRADA&#xA;,FECHA_OS&#xA;,PERIODO_ANIO_MES&#xA;,NUMERO_OS&#xA;,NUM_ACTA&#xA;,FECHA_CONSIGNACION&#xA;,ENTIDAD_RECAUDADORA&#xA;,CONFIRMACION_CLIENTE&#xA;,MOTIVO_ESPECIFICO&#xA;,LOGIN_EMPLEADO&#xA;,FECHA_CREACION&#xA;,ID_EMPLEADO_MODIFICACION&#xA;,FECHA_MODIFICACION&#xA;,ESTADO&#xA;FROM SIG_COLOMBIA_DW.[TMP].[MODREC_LPC_GUIAS_SOLUCIONADAS] WITH(NOLOCK)&#xA;UNION ALL&#xA;SELECT &#xA;NUMERO_GUIA = CONVERT(NUMERIC(20,0),[Nº DE GUIA])&#xA;,ID_MOTIVO = NULL&#xA;,ID_CONCEPTO = NULL&#xA;,VALOR = [VR A RECAUDAR]&#x9;&#xA;,PERIODO_CASTIGO = NULL&#xA;,VALOR_REINTEGRADO = NULL&#xA;,NUMERO_OS_REINTEGRADA = NULL&#xA;,FECHA_OS = NULL&#xA;,PERIODO_ANIO_MES = NULL&#xA;,NUMERO_OS = NULL&#xA;,NUM_ACTA = NULL&#xA;,FECHA_CONSIGNACION = NULL&#xA;,ENTIDAD_RECAUDADORA = NULL&#xA;,CONFIRMACION_CLIENTE = NULL&#xA;,MOTIVO_ESPECIFICO = NULL&#xA;,LOGIN_EMPLEADO = NULL&#xA;,FECHA_CREACION = NULL&#xA;,ID_EMPLEADO_MODIFICACION = NULL&#xA;,FECHA_MODIFICACION = NULL&#xA;,ESTADO = NULL &#xA;---[ESTADO DEL ENVIO]&#x9;&#xA;--[ESTADO DE RECAUDO]&#x9;&#xA;--[OBSERVACIONES]&#xA;FROM SIG_COLOMBIA_DW.[TMP].[MODREC_GUIAS_SOLUCIONADAS_NO_PENDIENTES_CSV] WITH(NOLOCK)&#xA;)&#xA;SELECT * &#xA;INTO #SIG_COLOMBIA_DW_TMP_MODREC_LPC_GUIAS_SOLUCIONADAS&#xA;FROM CTE &#xA;&#xA;&#xA;DELETE [FAC].[MODREC_LPC_GUIAS_SOLUCIONADAS_NO_PENDIENTES]&#xA;WHERE NUMERO_GUIA IN(SELECT NUMERO_GUIA FROM #SIG_COLOMBIA_DW_TMP_MODREC_LPC_GUIAS_SOLUCIONADAS)&#xA;&#xA;&#xA;INSERT INTO [FAC].[MODREC_LPC_GUIAS_SOLUCIONADAS_NO_PENDIENTES]&#xA;SELECT * FROM #SIG_COLOMBIA_DW_TMP_MODREC_LPC_GUIAS_SOLUCIONADAS&#xA;&#xA;;WITH CTE_ROW_DEL AS (&#xA;SELECT &#xA;ROW_DEL = ROW_NUMBER() OVER(PARTITION BY NUMERO_GUIA ORDER BY NUMERO_GUIA DESC)&#xA;,NUMERO_GUIA&#xA;FROM [FAC].[MODREC_LPC_GUIAS_SOLUCIONADAS_NO_PENDIENTES]&#xA;)&#xA;DELETE CTE_ROW_DEL WHERE ROW_DEL&gt;1&#xA;&#xA;--SELECT * FROM SIG_COLOMBIA_DW.[TMP].[MODREC_LPC_GUIAS_SOLUCIONADAS] WITH(NOLOCK)&#xA;--SELECT * FROM SIG_COLOMBIA_DW.[TMP].[MODREC_GUIAS_SOLUCIONADAS_NO_PENDIENTES_CSV]&#xA;----INTO [FAC].[MODREC_LPC_GUIAS_SOLUCIONADAS_NO_PENDIENTES]&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Extraccion Datos\IDS REGIONAL ORG-DEST"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{B5870ED4-14E2-419C-B32F-A039CE18A84E}"
