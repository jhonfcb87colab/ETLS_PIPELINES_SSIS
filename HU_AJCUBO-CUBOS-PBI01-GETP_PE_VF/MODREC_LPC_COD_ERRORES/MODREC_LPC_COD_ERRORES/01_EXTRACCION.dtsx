DROP TABLE IF EXISTS ##TMP_GUIAS_PENDIENTE_RECAUDO_FINAL_PBI;
SELECT --GPR.*
GPR.NUMERO_GUIA 
--GPR.ID_ESTADOENVIO 
,GPR.NOMBRE_ESTADOENVIO 
,GPR.FORMA_PAGO 
,GPR.VALOR_A_RECAUDAR 
,GPR.ID_REMITE 
,GPR.NOMBRE_REMITE_GUIA 
,GPR.FECHA_ENVIO
,GPR.VALOR_RECAUDADO
,GPR.FECHA_RECAUDO
,GPR.NUMERO_ORDEN_SERVICIO
,GPR.FECHA_RECAUDO_EFECTY
,GPR.ESTADO_ENTREGA
--,GPR.NOMBRE_RESPONSABLE_ULT_MOV 
--ID_PROCESO_ULT_MOV 
--NOMBRE_PROCESO_ULT_MOV 
--NUMERO_MOVIMI_ULT_MOV 
--CONSECUT_MOVIMI_ULT_MOV 
--FECHA_HORA_MOVIMI_ULT_MOV

--,ISNULL(ISNULL(CLO.CENTRO_LOGISTICO,CLD.CENTRO_LOGISTICO),'')  AS CPL_ORIGEN_ULT_MOV
--,ISNULL(ISNULL(RO.NOMBRE_REGIONAL,RD.NOMBRE_REGIONAL),'')  AS REGIONAL_ORIGEN_ULT_MOV
--,ISNULL(ISNULL(CO.NOMBRE_CIUDAD,CD.NOMBRE_CIUDAD),'')  AS CIUDAD_ORIGEN_ULT_MOV
--,ISNULL(ISNULL(CLD.CENTRO_LOGISTICO,CLO.CENTRO_LOGISTICO),'') AS CPL_DESTINO_ULT_MOV
--,ISNULL(ISNULL(RD.NOMBRE_REGIONAL,RO.NOMBRE_REGIONAL),'') AS REGIONAL_DESTINO_ULT_MOV
--,ISNULL(ISNULL(CD.NOMBRE_CIUDAD,CO.NOMBRE_CIUDAD),'') AS CIUDAD_DESTINO_MOV
,CASE WHEN ID_PROCESO!=14 THEN 
ISNULL(ISNULL(CLO.CENTRO_LOGISTICO,CLD.CENTRO_LOGISTICO),'')  ELSE ISNULL(ISNULL(CLD.CENTRO_LOGISTICO,CLO.CENTRO_LOGISTICO),'') END AS CPL_ULT_MOV
,CASE WHEN ID_PROCESO!=14 THEN 
ISNULL(ISNULL(RO.NOMBRE_REGIONAL,RD.NOMBRE_REGIONAL),'') ELSE ISNULL(ISNULL(RD.NOMBRE_REGIONAL,RO.NOMBRE_REGIONAL),'') END  AS REGIONAL_ULT_MOV
,CASE WHEN ID_PROCESO!=14 THEN 
ISNULL(ISNULL(CO.NOMBRE_CIUDAD,CD.NOMBRE_CIUDAD),'')  ELSE ISNULL(ISNULL(CD.NOMBRE_CIUDAD,CO.NOMBRE_CIUDAD),'') END  AS CIUDAD_ULT_MOV
,ISNULL(CASE 
 WHEN ISNULL(DOC.ID_CIUDAD_ZONA_URBA,0) !=0 THEN
 ROZ.NOMBRE_REGIONAL+' - '+ DCOZ.NOMBRE_DEPARTAMENTO +' - '+ COZ.NOMBRE_CIUDAD 
 WHEN  ISNULL(DOC.ID_CIUDAD_DIVISION_ORIGEN,0) !=0 AND DOC.ID_PROCESO!=14 THEN
 ROM.NOMBRE_REGIONAL+' - '+ DCOM.NOMBRE_DEPARTAMENTO +' - '+ COM.NOMBRE_CIUDAD
 ELSE
 ROD.NOMBRE_REGIONAL+' - '+ DCOD.NOMBRE_DEPARTAMENTO +' - '+ COD.NOMBRE_CIUDAD 
 END,'') AS REG_DEPART_CIUDAD_ULTIMO_MOV

,ISNULL(DOC.PLACA_VEHICULO_DOCU,'') as PLACA_VEHICULO_ULTIMO_MOV
,ISNULL(O.[NOMBRE_OPERATIVO],'') AS NOMBRE_OPERATIVO_ULTIMO_MOV
,ISNULL(Z.NOMBRE_ZONA_URBA,'') AS ZONA_URBANA_ULTIMO_MOV
,ISNULL(CZ.NOMBRE_CATEGORIA,'') AS CATEGORIA_ZONA_ULTIMO_MOV
,ISNULL(TZU.NOMBRE_TIPO_ZONA_URBA,'') AS TIPO_ZONA_ULTIMO_MOV
,ISNULL(GPR.NOMBRE_CDS_ULT_MOV,'') AS NOMBRE_CDS_ULT_MOV
,ISNULL(TIPO_CANAL_ULT_MOV,'') AS TIPO_CANAL_ULT_MOV
--,GR.ID_PROCESO 
,ISNULL(GPR.NOMBRE_PROCESO_ULT_MOV,'') AS PROCESO_LOG_ULTIMO_MOV  
,ISNULL(GPR.NOMBRE_CONCEPTO_ULT_MOV,'') AS CONCEPTO_ULT_MOV
--,GR.ID_CONCEPTO  
--,GR.FECHA_HORA_MOVIMIENTO
,ISNULL(cast(GPR.ID_PROCESO_ULT_MOV as nvarchar) +' - '+ RTRIM(GPR.NOMBRE_PROCESO_ULT_MOV),'') AS NOMBRE_ULTIMO_MOV
,ISNULL(CASE WHEN DIO.ID_DIVISION IS NOT NULL THEN cast(DIO.ID_DIVISION as nvarchar) +' - '+ RTRIM(DIO.NOMBRE_DIVISION)
ELSE cast(DID.ID_DIVISION as nvarchar) +' - '+ RTRIM(DID.NOMBRE_DIVISION) END,'') AS BODEGA_ULTIMO_MOV
,ISNULL(cast(GPR.ID_PROCESO_ULT_MOV as nvarchar) +' - '+ RTRIM(GPR.[NUMERO_MOVIMI_ULT_MOV])+' - '+  cast(GPR.[CONSECUT_MOVIMI_ULT_MOV] as nvarchar),'') as ULTIMO_MOV_LOGISTICO
,ISNULL(CONVERT(nvarchar(20),GPR.FECHA_HORA_MOVIMI_ULT_MOV,120),'') AS FECHA_ULTIMO_MOV
,GPR.ID_CONDUCTOR_ULT_MOV
,GPR.CONDUCTOR_ULT_MOV
,GPR.ID_AUXILIAR_ULT_MOV
,GPR.AUXILIAR_ULT_MOV
,GPR.ID_CLIENTE
,SZU.CONSECUT_MOVIMI_SZU
,SZU.NUMERO_MOVIMI_SZU
,SZU.FECHA_HORA_MOVIMI_ULT_MOV_SZU
,GPR.NOMBRE_TIPO_CANAL
,GPR.NOMBRE_CLASE_TIPO_CANAL
,TAR.NUMERO_TAREAS
,G_ID_CIUDAD_ORIGEN
,G_ID_CIUDAD_DESTINO
,CNF_ID_CONFIRMACION = 0
--,DOC.*
INTO ##TMP_GUIAS_PENDIENTE_RECAUDO_FINAL_PBI

FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR
--------------------------- CIUDAD ULTIMO MOV ZONA
  LEFT JOIN MECE_LOGISTICO.DBO.DOCUMENTOS DOC (NOLOCK) ON
 DOC.ID_PROCESO=GPR.[ID_PROCESO_ULT_MOV] AND DOC.NUMERO_MOVIMI=GPR.[NUMERO_MOVIMI_ULT_MOV] AND DOC.CONSECUT_MOVIMI=GPR.[CONSECUT_MOVIMI_ULT_MOV]
 --AND DOC.ID_DIVISION_DESTINO IN (9311, 9308, 9304, 9313, 9310, 9312, 9711, 9710)
  LEFT JOIN PARAMETROS.DBO.CIUDADES COZ (NOLOCK) ON  COZ.ID_PAIS=1 AND COZ.ID_CIUDAD=DOC.ID_CIUDAD_ZONA_URBA
  LEFT JOIN PARAMETROS.DBO.REGIONALES_PAIS ROZ (NOLOCK) ON  ROZ.ID_PAIS=COZ.ID_PAIS AND ROZ.ID_REGIONAL=COZ.ID_REGIONAL
  LEFT JOIN PARAMETROS.DBO.DEPARTAMENTOS DCOZ (NOLOCK) ON  DCOZ.ID_PAIS=COZ.ID_PAIS AND DCOZ.ID_DEPARTAMENTO=COZ.ID_DEPARTAMENTO
   LEFT JOIN PARAMETROS.DBO.ZONASURBANAS Z (NOLOCK) 
 ON Z.ID_PAIS = DOC.ID_PAIS_ZONA_URBA AND Z.ID_CIUDAD = DOC.ID_CIUDAD_ZONA_URBA AND Z.ID_TIPO_ZONA_URBA = DOC.ID_TIPO_ZONA_URBA AND Z.ID_ZONA_URBA = DOC.ID_ZONA_URBA --AND Z.CATEGORIA_ZONA_URBA = 8 --CLICOH
  LEFT JOIN [PARAMETROS].[dbo].[CATEGORIAZONASURBANAS] CZ (NOLOCK) ON CZ.Id_Categoria=Z.CATEGORIA_ZONA_URBA
  LEFT JOIN [PARAMETROS].[dbo].[TIPOSZONASURBANAS] TZU (NOLOCK) ON TZU.ID_TIPO_ZONA_URBA=Z.ID_TIPO_ZONA_URBA
 --------------------------- CIUDAD ULTIMO MOV DOCUMENTO
  LEFT JOIN PARAMETROS.DBO.CIUDADES COM (NOLOCK) ON  COM.ID_PAIS=1 AND COM.ID_CIUDAD=DOC.ID_CIUDAD_DIVISION_ORIGEN
  LEFT JOIN PARAMETROS.DBO.REGIONALES_PAIS ROM (NOLOCK) ON  ROM.ID_PAIS=COM.ID_PAIS AND ROM.ID_REGIONAL=COM.ID_REGIONAL
  LEFT JOIN PARAMETROS.DBO.DEPARTAMENTOS DCOM (NOLOCK) ON  DCOM.ID_PAIS=COM.ID_PAIS AND DCOM.ID_DEPARTAMENTO=COM.ID_DEPARTAMENTO
  --------------------------- CIUDAD DESTINO ULTIMO MOV DOCUMENTO
  LEFT JOIN PARAMETROS.DBO.CIUDADES COD(NOLOCK) ON  COD.ID_PAIS=1 AND COD.ID_CIUDAD=DOC.ID_CIUDAD_DESTINO
  LEFT JOIN PARAMETROS.DBO.REGIONALES_PAIS ROD (NOLOCK) ON  ROD.ID_PAIS=COD.ID_PAIS AND ROD.ID_REGIONAL=COD.ID_REGIONAL
  LEFT JOIN PARAMETROS.DBO.DEPARTAMENTOS DCOD (NOLOCK) ON  DCOD.ID_PAIS=COD.ID_PAIS AND DCOD.ID_DEPARTAMENTO=COD.ID_DEPARTAMENTO
  --------------------------- DIVISION ORIGEN ULTIMO MOV DOCUMENTO
  LEFT JOIN PARAMETROS.DBO.DIVISIONES DIO(NOLOCK) ON DIO.ID_PAIS=DOC.ID_PAIS_DIVISION_ORIGEN
 AND DIO.ID_CIUDAD=DOC.ID_CIUDAD_DIVISION_ORIGEN AND DIO.ID_DIVISION=DOC.ID_DIVISION_ORIGEN
  --------------------------- DIVISION DESTINO ULTIMO MOV DOCUMENTO
  LEFT JOIN PARAMETROS.DBO.DIVISIONES DID(NOLOCK) ON DID.ID_PAIS=DOC.ID_PAIS_DESTINO
 AND DID.ID_CIUDAD=DOC.ID_CIUDAD_DESTINO AND DID.ID_DIVISION=DOC.ID_DIVISION_DESTINO
-------------------------------------------------------------
  LEFT JOIN [PARAMETROS].[dbo].CIUDADES CO (NOLOCK) ON CO.ID_PAIS=ID_PAIS_DIVISION_ORIGEN AND CO.ID_CIUDAD=DOC.ID_CIUDAD_DIVISION_ORIGEN
  LEFT JOIN [PARAMETROS].[dbo].REGIONALES_PAIS RO (NOLOCK) ON RO.ID_PAIS=1 AND RO.ID_REGIONAL=CO.[ID_REGIONAL]
  LEFT JOIN [PARAMETROS].[dbo].CIUDADES CD (NOLOCK) ON CD.ID_PAIS=DOC.ID_PAIS_DESTINO AND CD.ID_CIUDAD=DOC.ID_CIUDAD_DESTINO
  LEFT JOIN [PARAMETROS].[dbo].REGIONALES_PAIS RD (NOLOCK) ON RD.ID_PAIS=1 AND RD.ID_REGIONAL=CD.[ID_REGIONAL]
  LEFT JOIN [PARAMETROS].[dbo].[OPERATIVOS] O (NOLOCK) ON O.[ID_PAIS_ORIGEN]=DOC.ID_PAIS_OPERATIVO AND O.[ID_CIUDAD_ORIGEN]=DOC.ID_CIUDAD_OPERATIVO
 AND O.[ID_OPERATIVO]=DOC.ID_OPERATIVO
  LEFT JOIN #TMP_CIUDADES_ANEXAS CAO (NOLOCK) ON CAO.ID_PAIS=1 AND CAO.[ID_CIUDAD_ANEXA]=CO.ID_CIUDAD --AND CAO.RECOLECCION=1
  LEFT JOIN PARAMETROS.DBO.CENTROS_LOGISTICOS CLO (NOLOCK) ON CLO.ID_PAIS=1 AND CLO.ID_CIUDAD=CAO.ID_CIUDAD AND CLO.ID_CENTRO_LOGISTICO=1 AND CLO.ID_ESTADO=1
  LEFT JOIN #TMP_CIUDADES_ANEXAS CAD (NOLOCK) ON CAD.ID_PAIS=1 AND CAD.[ID_CIUDAD_ANEXA]=CD.ID_CIUDAD --AND CAD.RECOLECCION=1
  LEFT JOIN PARAMETROS.DBO.CENTROS_LOGISTICOS CLD (NOLOCK) ON CLD.ID_PAIS=1 AND CLD.ID_CIUDAD=CAD.ID_CIUDAD AND CLD.ID_CENTRO_LOGISTICO=1 AND CLD.ID_ESTADO=1
LEFT JOIN #TMP_GUIAS_PENDIENTE_RECAUDO_SZU SZU ON SZU.NUMERO_GUIA=GPR.NUMERO_GUIA
LEFT JOIN #TMP_GUIAS_CON_TAREAS TAR ON TAR.NUMERO_GUIA=GPR.NUMERO_GUIA
--WHERE 
--NUMERO_GUIA=2273736466
--ID_PROCESO=32

--DELETE CPR FROM #TMP_GUIAS_PENDIENTE_RECAUDO CPR 
--WHERE
--NOT EXISTS (SELECT TOP 1 SE.NUMERO_GUIA FROM Mece_Logistico.DBO.SEGUIMIENTO_ENVIO SE (NOLOCK) WHERE SE.NUMERO_GUIA=CPR.NUMERO_GUIA AND SE.ID_PROCESO&gt;=5 AND  SE.ID_PROCESO&lt;27)



--select  COUNT(1) from #TMP_GUIAS_PENDIENTE_RECAUDO
--select  COUNT(1) from ##TMP_GUIAS_PENDIENTE_RECAUDO_FINAL_PBI

----select  * from ##TMP_GUIAS_PENDIENTE_RECAUDO_FINAL_PBI


UPDATE G SET 
CNF_ID_CONFIRMACION=1
from ##TMP_GUIAS_PENDIENTE_RECAUDO_FINAL_PBI G
INNER JOIN [Mece_Logistico].[dbo].[CONFIRMACIONES] GC (NOLOCK) ON GC.NUMERO_GUIA=G.NUMERO_GUIA  
  WHERE GC.ID_SOLUCION IN (3,13,19)--DEVOLUCION A REMITENTE
  AND GC.FECHA_CONFIRMACION = (SELECT MAX(GC1.FECHA_CONFIRMACION) 
								FROM [Mece_Logistico].[dbo].[CONFIRMACIONES] GC1 (NOLOCK) 
								WHERE GC1.NUMERO_GUIA=G.NUMERO_GUIA AND GC1.ID_SOLUCION IN (3,13,19))


</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{54780B9D-A596-42DE-BFCC-A0B79BE3A507}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot;&#xA;DECLARE @FECH_INI DATETIME =  '&quot;+ @[User::STR_FechaIni] +&quot;' ;&#x9;/*---&#x9;&#x9;&#x9;'20260101';&#x9;&#x9;&#x9;*/&#xA;DECLARE @FECH_FIN DATETIME =  '&quot;+ @[User::STR_FechaFin] +&quot;' ;&#x9;/*---&#x9;&#x9;&#x9;'20260101';&#x9;&#x9;&#x9;*/&#xA;IF OBJECT_ID('tempdb..#COD_PENDIENTE_POR_RECAUDO') IS NOT NULL &#xA;    DROP TABLE #COD_PENDIENTE_POR_RECAUDO&#xA;&#xA;IF OBJECT_ID('tempdb..#TMP_GUIAS_PENDIENTE_RECAUDO') IS NOT NULL &#xA;    DROP TABLE #TMP_GUIAS_PENDIENTE_RECAUDO&#xA;&#xA;IF OBJECT_ID('tempdb..#TMP_CIUDADES_ANEXAS') IS NOT NULL &#xA;    DROP TABLE #TMP_CIUDADES_ANEXAS&#xA;&#xA;---CIUDADES ANEXAS&#xA;SELECT CAD.* &#xA;INTO #TMP_CIUDADES_ANEXAS FROM PARAMETROS.DBO.CIUDADES_ANEXAS CAD (NOLOCK) &#xA;WHERE CAD.ID_PAIS=1 AND CAD.RECOLECCION=1&#xA;&#xA;INSERT INTO #TMP_CIUDADES_ANEXAS&#xA;SELECT CAD.* FROM PARAMETROS.DBO.CIUDADES_ANEXAS CAD (NOLOCK) &#xA;LEFT JOIN #TMP_CIUDADES_ANEXAS TCAD ON TCAD.ID_CIUDAD_ANEXA=CAD.ID_CIUDAD_ANEXA&#xA;WHERE CAD.ID_PAIS=1 AND CAD.RECOLECCION=0 AND TCAD.ID_CIUDAD_ANEXA IS NULL&#xA;&#xA;DELETE T FROM (SELECT *, &#xA;    DupRank = ROW_NUMBER() OVER (PARTITION BY ID_CIUDAD_ANEXA ORDER BY FECHA_CREACION DESC) &#xA;     FROM #TMP_CIUDADES_ANEXAS) AS T&#xA;WHERE DupRank &gt; 1&#xA;&#xA;&#xA;DROP TABLE IF EXISTS #PARAMETROS_DBO_CIUDADES;&#xA;SELECT * &#xA;INTO #PARAMETROS_DBO_CIUDADES&#xA;FROM PARAMETROS.DBO.CIUDADES CD WITH(NOLOCK)&#xA;&#xA;DROP TABLE IF EXISTS #PARAMETROS_DBO_REGIONALES_PAIS;&#xA;SELECT * &#xA;INTO #PARAMETROS_DBO_REGIONALES_PAIS&#xA;FROM PARAMETROS.DBO.REGIONALES_PAIS RG WITH(NOLOCK)&#xA;&#xA;&#xA;&#xA;&#xA;DROP TABLE IF EXISTS #Mece_Logistico_dbo_COD_PENDIENTE_POR_RECAUDO;&#xA;SELECT *&#xA;INTO #Mece_Logistico_dbo_COD_PENDIENTE_POR_RECAUDO&#xA;FROM [Mece_Logistico].[dbo].[COD_PENDIENTE_POR_RECAUDO] CPR WITH (NOLOCK)&#xA;WHERE &#xA;    -- Filtros de fecha y condiciones generales obligatorias&#xA;    CPR.FECHA_ASIGNACION_AL_AUXILIAR &gt;= @FECH_INI &#xA;    AND CPR.FECHA_ASIGNACION_AL_AUXILIAR &lt;= @FECH_FIN&#xA;    AND ISNULL(CPR.ESTA_ANULADO, 0) = 0 &#xA;    AND ISNULL(CPR.ESTA_RECAUDADO, 0) = 0&#xA;    AND (&#xA;        -- Bloque 1 (equivalente al primer SELECT)&#xA;        (&#xA;            (CPR.NUMERO_ORDEN_SERVICIO IS NULL OR CPR.NUMERO_ORDEN_SERVICIO = '')&#xA;        )&#xA;        OR&#xA;        -- Bloque 2 (equivalente al segundo SELECT)&#xA;        (&#xA;            ISNULL(CPR.ESTADO_COD, 0) = 1 &#xA;            AND (CPR.NUMERO_ORDEN_SERVICIO IS NULL OR CPR.NUMERO_ORDEN_SERVICIO = '')&#xA;            AND ISNULL(CPR.ID_MODALPAGO, 0) = 0 &#xA;            AND (CPR.NUMERO_APROBACION IS NULL OR LTRIM(RTRIM(CPR.NUMERO_APROBACION)) = '')&#xA;            AND ISNULL(CPR.INGRESO_MANUAL, 0) = 0&#xA;        )&#xA;    );&#xA;&#xA;CREATE NONCLUSTERED INDEX [IX_NUMERO_GUIA_PEND_RECAUDO] ON #Mece_Logistico_dbo_COD_PENDIENTE_POR_RECAUDO&#xA;(&#xA;&#x9;[NUMERO_GUIA] ASC&#xA;)WITH (PAD_INDEX = OFF, STATISTICS_NORECOMPUTE = OFF, SORT_IN_TEMPDB = OFF, DROP_EXISTING = OFF, ONLINE = OFF, ALLOW_ROW_LOCKS = ON, ALLOW_PAGE_LOCKS = ON, FILLFACTOR = 80) ON [PRIMARY]&#xA;&#xA;&#xA;SELECT &#xA;    CPR.*&#xA;    ,G.ID_CLIENTE, G.ID_REMITE&#xA;    ,G.NOMBRE_REMITE_GUIA&#xA;    ,G.ID_PRODUCTO AS ID_PRODUCTO_GUIA&#xA;    ,G.ID_ESTADOENVIO, G.ID_ESTADOGUIA&#xA;    ,ISNULL(G.VALOR_SEG_MAN_GUIAS, 0) + ISNULL(G.VALOR_FLETES_GUIAS, 0) AS VALOR_ENVIO_GUIA&#xA;    ,ISNULL(GIA.VALOR_RECAUDAR_PRODUCTO, 0) AS VALOR_RECAUDAR_PRODUCTO_GUIA&#xA;    ,CAST('' AS nvarchar(50)) AS NOMBRE_ESTADOENVIO&#xA;    ,G.FECHA_ENVIO&#xA;    ,TCAN.NOMBRE_TIPO_CANAL&#xA;    ,CTCAN.NOMBRE_CLASE_TIPO_CANAL&#xA;    ,G.[ID_CIUDAD_ORIGEN] AS G_ID_CIUDAD_ORIGEN&#xA;    ,G.[ID_CIUDAD_DESTINO] AS G_ID_CIUDAD_DESTINO&#xA;    ,CIUD.ID_REGIONAL AS ID_REGIONAL_ENTREGA_PEND_RECAUDO&#xA;    ,CPR.ID_CIUDAD_ENTREGA AS ID_CIUDAD_ENTREGA_PEND_RECAUDO&#xA;&#x9;INTO #COD_PENDIENTE_POR_RECAUDO&#xA;FROM #Mece_Logistico_dbo_COD_PENDIENTE_POR_RECAUDO CPR WITH (NOLOCK)&#xA;INNER JOIN [Mece_Logistico].[dbo].[GUIAS] G WITH (NOLOCK) &#xA;    ON G.NUMERO_GUIA = CPR.NUMERO_GUIA&#xA;LEFT JOIN [Mece_Logistico].[dbo].[GUIAS_INF_ADICIONAL] GIA WITH (NOLOCK) &#xA;    ON GIA.NUMERO_GUIA = CPR.NUMERO_GUIA&#xA;LEFT JOIN [Mece_Logistico].[dbo].[CANALES] CAN WITH (NOLOCK) &#xA;    ON CAN.id_pais = G.ID_1 &#xA;   AND CAN.id_ciudad = G.ID_2 &#xA;   AND CAN.[ID_DIVISION] = G.ID_CANAL&#xA;LEFT JOIN [Mece_Logistico].[dbo].[TIPOS_CANAL] TCAN WITH (NOLOCK) &#xA;    ON TCAN.ID_TIPO_CANAL = CAN.ID_TIPO_CANAL &#xA;   AND TCAN.ID_EST_TIPO_CANAL = 1&#xA;LEFT JOIN PARAMETROS.[dbo].[CLASE_TIPO_CANAL] CTCAN WITH (NOLOCK) &#xA;    ON CTCAN.ID_CLASE_TIPO_CANAL = TCAN.CLASE_TIPO_CANAL&#xA;LEFT JOIN PARAMETROS.[dbo].[CIUDADES] CIUD WITH (NOLOCK) &#xA;    ON CIUD.ID_CIUDAD = CPR.ID_CIUDAD_ENTREGA&#xA;WHERE ISNULL(G.ID_DIVISION_PROV, 0) = 0&#xA;&#xA;; WITH CTE_DELL AS ( SELECT ROW_NUMBER() OVER(PARTITION BY NUMERO_GUIA ORDER BY FECHA_ACTUALIZACION DESC) AS ROWID,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;NUMERO_GUIA FROM #COD_PENDIENTE_POR_RECAUDO) DELETE CTE_DELL WHERE ROWID&gt;1&#xA;CREATE NONCLUSTERED INDEX [IX_NUMERO_GUIA] ON #COD_PENDIENTE_POR_RECAUDO ([NUMERO_GUIA] ASC)&#xA;--Se quitan envios siniestrados&#xA;DELETE GPR FROM #COD_PENDIENTE_POR_RECAUDO GPR&#xA;WHERE ID_ESTADOENVIO in(5,4)&#xA;&#xA;--Quita las guias son del canal retail y no son COD y no contraentrega ecommerce&#xA;DELETE GPR FROM #COD_PENDIENTE_POR_RECAUDO GPR&#xA;WHERE ID_FORMA_PAGO=1 AND ISNULL(ID_PRODUCTO_GUIA,999) !=86&#xA;--WHERE ID_FORMA_PAGO=1 AND ISNULL(ID_PRODUCTO,999) !=86&#xA;&#xA;&#xA;--Quita las guias CREDICONTADO (Solicitud de luis gabriel rodriguez y Holman Salamanca el dia 2026-04-09 11:44am )&#xA;/*&#xA;&#xA;ID_FORMAPAGO&#x9;NOMBRE_FORMAPAGO&#xA;1&#x9;CONTADO&#xA;2&#x9;CREDITO&#xA;3&#x9;PREPAGO DIGITAL&#xA;4&#x9;C.O.D. &#xA;5&#x9;CHEQUE&#xA;6&#x9;TARJETAS FINANCIERAS&#xA;7&#x9;CREDI CONTADO&#xA;9&#x9;QR&#xA;10&#x9;TARJETA&#xA;*/&#xA;DELETE GPR FROM #COD_PENDIENTE_POR_RECAUDO GPR&#xA;WHERE ID_FORMA_PAGO=7&#xA;-----ok&#xA;&#xA;UPDATE CPR SET CPR.NOMBRE_ESTADOENVIO=E.NOMBRE_ESTADOENVIO&#xA;FROM #COD_PENDIENTE_POR_RECAUDO CPR&#xA;INNER JOIN PARAMETROS.DBO.ESTADOSENVIO E (NOLOCK)ON E.ID_ESTADOENVIO=CPR.ID_ESTADOENVIO&#xA;------------------------------------------------------------------------------------------ajustar igual de para abajo &#xA;DROP TABLE IF EXISTS #TMP_GUIAS_PENDIENTE_RECAUDO;&#xA;CREATE TABLE #TMP_GUIAS_PENDIENTE_RECAUDO(&#xA;&#x9;NUMERO_GUIA numeric(20, 0) NOT NULL,&#xA;&#x9;ID_AUXILIAR_ASIGNADO_PEND_REC varchar(40) DEFAULT '',&#xA;&#x9;NOMBRE_AUXILIAR_ASIGNADO_PEND_REC varchar(200) DEFAULT '',&#xA;&#x9;FECHA_ASIGNACION_AL_AUXILIAR datetime,&#xA;&#x9;ID_ESTADOENVIO smallint DEFAULT 0,&#xA;&#x9;NOMBRE_ESTADOENVIO varchar(40) DEFAULT '',&#xA;&#x9;FORMA_PAGO varchar(40) DEFAULT '',&#xA;&#x9;VALOR_A_RECAUDAR numeric(12, 2) NULL,&#xA;&#x9;ID_REMITE [varchar](40) DEFAULT '',&#xA;&#x9;NOMBRE_REMITE_GUIA  [varchar](200) DEFAULT '',&#xA;&#x9;-- ID_CIUDAD INT DEFAULT 0,&#xA;&#x9;-- [NOMBRE_CIUDAD] [varchar](50) DEFAULT '',&#xA;&#x9;FECHA_ENVIO datetime NULL,&#xA;&#x9;[VALOR_RECAUDADO] [numeric](11, 2) DEFAULT 0,&#xA;&#x9;FECHA_RECAUDO datetime NULL,&#xA;&#x9;NUMERO_ORDEN_SERVICIO varchar(20) DEFAULT '',&#xA;&#x9;FECHA_RECAUDO_EFECTY datetime NULL,&#xA;&#x9;ESTADO_ENTREGA varchar(70) DEFAULT 'A TIEMPO',--A TIEMPO O VENCIDO&#xA;&#x9;--NOMBRE_RESPONSABLE_ULT_MOV VARCHAR(100) DEFAULT '',&#xA;&#x9;ID_PROCESO_ULT_MOV int DEFAULT 0,&#xA;&#x9;NOMBRE_PROCESO_ULT_MOV varchar(70) DEFAULT '',&#xA;&#x9;ID_CONCEPTO_ULT_MOV int DEFAULT 0,&#xA;&#x9;NOMBRE_CONCEPTO_ULT_MOV varchar(70) DEFAULT '',&#xA;&#x9;NUMERO_MOVIMI_ULT_MOV char(30) DEFAULT '',&#xA;&#x9;CONSECUT_MOVIMI_ULT_MOV numeric(7, 0) DEFAULT 0,&#xA;&#x9;FECHA_HORA_MOVIMI_ULT_MOV datetime NULL,&#xA;&#x9;ID_PAIS_ZONA_URBA_ULT_MOV SMALLINT NULL,&#xA;&#x9;ID_CIUDAD_ZONA_URBA_ULT_MOV INT NULL,&#xA;&#x9;ID_TIPO_ZONA_URBA_ULT_MOV SMALLINT NULL,&#xA;&#x9;ID_ZONA_URBA_ULT_MOV SMALLINT NULL,&#xA;&#x9;NOMBRE_CDS_ULT_MOV varchar(100) DEFAULT '',&#xA;&#x9;TIPO_CANAL_ULT_MOV varchar(40) DEFAULT '',&#xA;&#x9;ID_CONDUCTOR_ULT_MOV varchar(40) DEFAULT '',&#xA;&#x9;CONDUCTOR_ULT_MOV  varchar(200) DEFAULT '',&#xA;&#x9;ID_AUXILIAR_ULT_MOV varchar(40) DEFAULT '',&#xA;&#x9;AUXILIAR_ULT_MOV varchar(200) DEFAULT '',&#xA;&#x9;ID_CLIENTE [char](20) NOT NULL,&#xA;&#x9;NOMBRE_TIPO_CANAL varchar(100) DEFAULT '',&#xA;&#x9;NOMBRE_CLASE_TIPO_CANAL varchar(100) DEFAULT '',&#xA;&#x9;[G_ID_CIUDAD_ORIGEN] [int] NULL,&#xA;&#x9;[G_ID_CIUDAD_DESTINO] [int] NULL,&#xA;    [ID_REGIONAL_ENTREGA_PEND_RECAUDO] [int] NULL,&#xA;    [ID_CIUDAD_ENTREGA_PEND_RECAUDO] [int] NULL,&#xA;&#x9;VALOR_PRODUCTO INT NULL,&#xA;&#x9;ESTA_RECAUDADO INT NULL&#xA;) &#xA;CREATE NONCLUSTERED INDEX [IX_NUMERO_GUIA] ON #TMP_GUIAS_PENDIENTE_RECAUDO ([NUMERO_GUIA] ASC)&#xA;CREATE NONCLUSTERED INDEX [IX_ZONA] ON #TMP_GUIAS_PENDIENTE_RECAUDO (ID_PAIS_ZONA_URBA_ULT_MOV,ID_CIUDAD_ZONA_URBA_ULT_MOV, ID_TIPO_ZONA_URBA_ULT_MOV,ID_ZONA_URBA_ULT_MOV ASC)&#xA;CREATE NONCLUSTERED INDEX [IX_MANIFIESTO] ON #TMP_GUIAS_PENDIENTE_RECAUDO (ID_PROCESO_ULT_MOV,NUMERO_MOVIMI_ULT_MOV,CONSECUT_MOVIMI_ULT_MOV ASC)&#xA;&#xA;INSERT INTO #TMP_GUIAS_PENDIENTE_RECAUDO(&#xA;&#x9;NUMERO_GUIA,&#xA;&#x9;ID_AUXILIAR_ASIGNADO_PEND_REC,&#xA;&#x9;NOMBRE_AUXILIAR_ASIGNADO_PEND_REC,&#xA;&#x9;FECHA_ASIGNACION_AL_AUXILIAR,&#xA;&#x9;ID_ESTADOENVIO,&#xA;&#x9;NOMBRE_ESTADOENVIO,&#xA;&#x9;FORMA_PAGO,&#xA;&#x9;VALOR_A_RECAUDAR,&#xA;&#x9;ID_REMITE,&#xA;&#x9;NOMBRE_REMITE_GUIA,&#xA;&#x9;FECHA_ENVIO,&#xA;&#x9;VALOR_RECAUDADO,&#xA;&#x9;FECHA_RECAUDO,&#xA;&#x9;NUMERO_ORDEN_SERVICIO,&#xA;&#x9;FECHA_RECAUDO_EFECTY,&#xA;&#x9;ID_CLIENTE,&#xA;&#x9;NOMBRE_TIPO_CANAL,&#xA;&#x9;NOMBRE_CLASE_TIPO_CANAL,&#xA;&#x9;G_ID_CIUDAD_ORIGEN,&#xA;&#x9;G_ID_CIUDAD_DESTINO,&#xA;    [ID_REGIONAL_ENTREGA_PEND_RECAUDO],&#xA;    [ID_CIUDAD_ENTREGA_PEND_RECAUDO],&#xA;&#x9;VALOR_PRODUCTO,&#xA;&#x9;ESTA_RECAUDADO&#xA;&#x9;)&#xA;&#x9;SELECT &#xA;&#x9;CPR.NUMERO_GUIA AS NUMERO_GUIA,&#xA;&#x9;CPR.ID_AUXILIAR AS ID_AUXILIAR_ASIGNADO_PEND_REC,&#xA;&#x9;NOMBRE_AUXILIAR_ASIGNADO_PEND_REC = '',&#xA;&#x9;CPR.FECHA_ASIGNACION_AL_AUXILIAR,&#xA;&#x9;CPR.ID_ESTADOENVIO AS ID_ESTADOENVIO,&#xA;&#x9;CPR.NOMBRE_ESTADOENVIO AS NOMBRE_ESTADOENVIO,&#xA;&#x9;CASE WHEN CPR.ID_FORMA_PAGO=4 AND CPR.ID_CLIENTE IS NULL THEN 'C.O.D.' &#xA;&#x9;&#x9;WHEN ISNULL(CPR.ID_PRODUCTO,CPR.ID_PRODUCTO_GUIA)=86 THEN 'CONTRAENTREGA ECOMMERCE' &#xA;&#x9;&#x9;WHEN (CPR.ID_FORMA_PAGO=2 OR CPR.ID_CLIENTE IS NOT NULL) &#xA;&#x9;&#x9;THEN 'LPC' ELSE '' &#xA;&#x9;&#x9;END AS FORMA_PAGO,&#xA;&#x9;CASE WHEN ISNULL(CPR.VALOR_TOTAL,0)!=0 THEN CPR.VALOR_TOTAL&#xA;&#x9;&#x9;WHEN CPR.ID_FORMA_PAGO=4 AND VALOR_FLETE IS NOT NULL THEN ISNULL(CPR.VALOR_FLETE,0) + ISNULL(CPR.VALOR_OTROS,0)&#xA;&#x9;&#x9;WHEN CPR.ID_FORMA_PAGO=4 AND VALOR_FLETE IS NULL THEN ISNULL(CPR.VALOR_ENVIO_GUIA,0)&#xA;&#x9;&#x9;WHEN ISNULL(CPR.ID_PRODUCTO,CPR.ID_PRODUCTO_GUIA)=86 THEN ISNULL(CPR.VALOR_DECLARADO,CPR.VALOR_PRODUCTO)&#xA;&#x9;&#x9;WHEN (CPR.ID_FORMA_PAGO=2 OR CPR.ID_CLIENTE IS NOT NULL) THEN ISNULL(CPR.VALOR_DECLARADO,CPR.VALOR_PRODUCTO) ELSE 0 &#xA;&#x9;&#x9;END AS VALOR_A_RECAUDAR&#xA;&#x9;,CPR.ID_REMITE AS ID_REMITE&#xA;&#x9;,CPR.NOMBRE_REMITE_GUIA AS NOMBRE_REMITE_GUIA&#xA;&#x9;,CPR.FECHA_ENVIO AS FECHA_ENVIO&#xA;&#x9;,ISNULL(CPR.VALOR_RECAUDADO,0) AS VALOR_RECAUDADO&#xA;&#x9;,CPR.FECHA_RECAUDO AS FECHA_RECAUDO&#xA;&#x9;,ISNULL(CPR.NUMERO_ORDEN_SERVICIO,0) AS NUMERO_ORDEN_SERVICIO&#xA;&#x9;,CPR.FECHA_RECAUDO_EFECTY AS FECHA_RECAUDO_EFECTY&#xA;&#x9;,isnull(CPR.ID_CLIENTE,'0') AS ID_CLIENTE&#xA;&#x9;,CPR.NOMBRE_TIPO_CANAL AS NOMBRE_TIPO_CANAL&#xA;&#x9;,CPR.NOMBRE_CLASE_TIPO_CANAL AS NOMBRE_CLASE_TIPO_CANAL  &#xA;&#x9;,G_ID_CIUDAD_ORIGEN AS G_ID_CIUDAD_ORIGEN&#xA;&#x9;,G_ID_CIUDAD_DESTINO AS G_ID_CIUDAD_DESTINO&#xA;&#x9;--,CPR.VALOR_TOTAL&#xA;&#x9;,CPR.[ID_REGIONAL_ENTREGA_PEND_RECAUDO]&#xA;    ,CPR.[ID_CIUDAD_ENTREGA_PEND_RECAUDO]&#xA;&#x9;,CPR.VALOR_PRODUCTO&#xA;&#x9;,CPR.ESTA_RECAUDADO&#xA;&#x9;FROM #COD_PENDIENTE_POR_RECAUDO CPR (NOLOCK)&#xA;WHERE LEN(CPR.NUMERO_GUIA)&gt;7&#xA;-------------------------------------------------------&#xA;&#xA;&#xA;&#xA;UPDATE GPR SET&#xA; --GPR.NOMBRE_RESPONSABLE_ULT_MOV='SERVIENTREGA S.A.'&#xA; GPR.ID_PROCESO_ULT_MOV=SE.ID_PROCESO&#xA; ,GPR.NOMBRE_PROCESO_ULT_MOV=PRO.NOMBRE_PROCESO_LOG&#xA; ,GPR.ID_CONCEPTO_ULT_MOV=ISNULL(SE.ID_CONCEPTO,0)&#xA; ,GPR.NOMBRE_CONCEPTO_ULT_MOV=ISNULL(ICON.NOMBRE_CONCEPTO,'')&#xA; ,GPR.NUMERO_MOVIMI_ULT_MOV=SE.NUMERO_MOVIMI&#xA; ,GPR.CONSECUT_MOVIMI_ULT_MOV=SE.CONSECUT_MOVIMI&#xA; ,GPR.FECHA_HORA_MOVIMI_ULT_MOV=SE.FECHA_HORA_MOVIMIENTO&#xA; --,GPR.ID_CONDUCTOR_ULT_MOV=DOC.ID_COURIER_CONDUCTOR&#xA; --,GPR.ID_AUXILIAR_ULT_MOV=DOC.ID_AUXILIAR1_VEHICULO&#xA; --,GPR.ID_PAIS_ZONA_URBA_ULT_MOV=DOC.ID_PAIS_ZONA_URBA  &#xA; --,GPR.ID_CIUDAD_ZONA_URBA_ULT_MOV=DOC.ID_CIUDAD_ZONA_URBA &#xA; --,GPR.ID_TIPO_ZONA_URBA_ULT_MOV=DOC.ID_TIPO_ZONA_URBA&#xA; --,GPR.ID_ZONA_URBA_ULT_MOV=DOC.ID_ZONA_URBA&#xA; FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; INNER JOIN MECE_LOGISTICO.dbo.SEGUIMIENTO_ENVIO SE WITH(NOLOCK) on se.NUMERO_GUIA=GPR.NUMERO_GUIA&#xA; --INNER JOIN MECE_LOGISTICO.dbo.DOCUMENTOS DOC (NOLOCK) ON&#xA; --DOC.ID_PROCESO=GPR.[ID_PROCESO_ULT_MOV] AND DOC.NUMERO_MOVIMI=GPR.[NUMERO_MOVIMI_ULT_MOV] AND DOC.CONSECUT_MOVIMI=GPR.[CONSECUT_MOVIMI_ULT_MOV]&#xA; INNER JOIN PARAMETROS.DBO.PROCESOS PRO (NOLOCK) ON PRO.ID_PROCESO=SE.ID_PROCESO&#xA; LEFT JOIN PARAMETROS.DBO.ITEM_CONCEPTO ICON (NOLOCK) ON ICON.ID_PAIS=1 AND ICON.ID_PROCESO=SE.ID_PROCESO AND ICON.ID_CONCEPTO=SE.ID_CONCEPTO&#xA; WHERE se.FECHA_HORA_MOVIMIENTO= (select MAX(se1.FECHA_HORA_MOVIMIENTO) from MECE_LOGISTICO.dbo.SEGUIMIENTO_ENVIO SE1 WITH(NOLOCK)&#xA;          where SE1.numero_guia=GPR.NUMERO_GUIA)&#xA; UPDATE GPR SET&#xA; GPR.ID_CONDUCTOR_ULT_MOV=DOC.ID_COURIER_CONDUCTOR&#xA; ,GPR.ID_AUXILIAR_ULT_MOV=DOC.ID_AUXILIAR1_VEHICULO&#xA; ,GPR.ID_PAIS_ZONA_URBA_ULT_MOV=DOC.ID_PAIS_ZONA_URBA  &#xA; ,GPR.ID_CIUDAD_ZONA_URBA_ULT_MOV=DOC.ID_CIUDAD_ZONA_URBA &#xA; ,GPR.ID_TIPO_ZONA_URBA_ULT_MOV=DOC.ID_TIPO_ZONA_URBA&#xA; ,GPR.ID_ZONA_URBA_ULT_MOV=DOC.ID_ZONA_URBA&#xA; FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; INNER JOIN MECE_LOGISTICO.DBO.DOCUMENTOS DOC (NOLOCK) ON&#xA; DOC.ID_PROCESO=GPR.[ID_PROCESO_ULT_MOV] AND DOC.NUMERO_MOVIMI=GPR.[NUMERO_MOVIMI_ULT_MOV] AND DOC.CONSECUT_MOVIMI=GPR.[CONSECUT_MOVIMI_ULT_MOV]&#xA;&#xA; --SELECT GPR.ID_CONDUCTOR_ULT_MOV&#xA; &#xA; UPDATE GPR SET&#xA; GPR.ID_CONDUCTOR_ULT_MOV=ISNULL(RTRIM(LTRIM(EC.ID_EMPLEADO)),'')&#xA; ,GPR.CONDUCTOR_ULT_MOV =ISNULL(RTRIM(LTRIM(EC.NOMBRE_EMPLEADO)) +' '+ RTRIM(LTRIM(EC.APELLIDO_EMPLEADO)),'') &#xA; ,GPR.ID_AUXILIAR_ULT_MOV=ISNULL(RTRIM(LTRIM(EA.ID_EMPLEADO)),'')&#xA; ,GPR.AUXILIAR_ULT_MOV=ISNULL(RTRIM(LTRIM(EA.NOMBRE_EMPLEADO)) +' '+ RTRIM(LTRIM(EA.APELLIDO_EMPLEADO)),'') &#xA; ,GPR.NOMBRE_AUXILIAR_ASIGNADO_PEND_REC = ISNULL(RTRIM(LTRIM(AUXREC.NOMBRE_EMPLEADO)) +' '+ RTRIM(LTRIM(AUXREC.APELLIDO_EMPLEADO)),'')&#xA; FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; LEFT JOIN PARAMETROS.DBO.EMPLEADOS EC (NOLOCK) ON EC.ID_EMPLEADO=GPR.ID_CONDUCTOR_ULT_MOV&#xA; LEFT JOIN PARAMETROS.DBO.EMPLEADOS EA (NOLOCK) ON EA.ID_EMPLEADO=GPR.ID_AUXILIAR_ULT_MOV&#xA; LEFT JOIN PARAMETROS.DBO.EMPLEADOS AUXREC (NOLOCK) ON AUXREC.ID_EMPLEADO=GPR.ID_AUXILIAR_ASIGNADO_PEND_REC&#xA;&#xA; --SELECT GPR.NUMERO_GUIA,ISNULL(DIV.NOMBRE_DIVISION,'') AS NOMBRE_CDS, ISNULL(CTCAN.[NOMBRE_CLASE_TIPO_CANAL],'') as TIPO_CANAL&#xA;UPDATE GPR SET NOMBRE_CDS_ULT_MOV=ISNULL(DIV.NOMBRE_DIVISION,''),&#xA; TIPO_CANAL_ULT_MOV=ISNULL(CTCAN.[NOMBRE_CLASE_TIPO_CANAL],'')&#xA; FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; --INNER JOIN MECE_LOGISTICO.DBO.DOCUMENTOS DOC (NOLOCK) ON&#xA; --DOC.ID_PROCESO=GPR.[ID_PROCESO_ULT_MOV] AND DOC.NUMERO_MOVIMI=GPR.[NUMERO_MOVIMI_ULT_MOV] AND DOC.CONSECUT_MOVIMI=GPR.[CONSECUT_MOVIMI_ULT_MOV]&#xA; INNER JOIN PARAMETROS.DBO.ZONASURBANAS Z (NOLOCK) &#xA; ON Z.ID_PAIS = GPR.ID_PAIS_ZONA_URBA_ULT_MOV AND Z.ID_CIUDAD = GPR.ID_CIUDAD_ZONA_URBA_ULT_MOV &#xA;  AND Z.ID_TIPO_ZONA_URBA = GPR.ID_TIPO_ZONA_URBA_ULT_MOV AND Z.ID_ZONA_URBA = GPR.ID_ZONA_URBA_ULT_MOV --AND Z.CATEGORIA_ZONA_URBA = 8 --CLICOH&#xA; INNER JOIN PARAMETROS.DBO.DIVISIONES DIV (NOLOCK) ON DIV.ID_PAIS = Z.ID_PAIS_CANAL AND DIV.ID_CIUDAD = Z.ID_CIUDAD_CANAL AND DIV.ID_DIVISION = Z.ID_CANAL&#xA; INNER JOIN [Mece_Logistico].[dbo].[CANALES] CAN (NOLOCK) ON CAN.id_pais=DIV.ID_PAIS and CAN.id_ciudad=DIV.ID_CIUDAD and CAN.[ID_DIVISION]=DIV.ID_DIVISION&#xA; INNER JOIN [Mece_Logistico].[dbo].[TIPOS_CANAL] TCAN (NOLOCK) ON TCAN.ID_TIPO_CANAL=CAN.ID_TIPO_CANAL AND TCAN.ID_EST_TIPO_CANAL=1&#xA; INNER JOIN PARAMETROS.[dbo].[CLASE_TIPO_CANAL] CTCAN (NOLOCK) ON CTCAN.ID_CLASE_TIPO_CANAL=TCAN.CLASE_TIPO_CANAL&#xA;&#xA;&#xA; --UPDATE GPR SET ESTADO_ENTREGA='VENCIDO'&#xA; --SELECT * FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; UPDATE GPR SET ESTADO_ENTREGA='VENCIDO'&#xA; FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; WHERE GPR.ID_PROCESO_ULT_MOV=9 AND ID_CONCEPTO_ULT_MOV IN(9,7,2,4)--9 ENTREGAS OFIC  C.O.D. Y/O LPC EMPRESARIO --7 EMPRESARIO SATELITE ENTREGA EN OFICINA&#xA; --2 RECLAMO OFICINA Y 4 C.O.D RECLAMO OFICINA&#xA; AND DATEDIFF(DAY, FECHA_HORA_MOVIMI_ULT_MOV,GETDATE())&gt;8 -- MAS DE 8 DIAS&#xA; &#xA; UPDATE GPR SET ESTADO_ENTREGA='VENCIDO'&#xA; FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; WHERE GPR.ID_PROCESO_ULT_MOV=31 --ENVIO PARA ENTREGA EN OFICINA&#xA; AND DATEDIFF(DAY, FECHA_HORA_MOVIMI_ULT_MOV,GETDATE())&gt;8 -- MAS DE 8 DIAS&#xA;&#xA; UPDATE GPR SET ESTADO_ENTREGA='VENCIDO'&#xA; FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; WHERE GPR.ID_PROCESO_ULT_MOV=9 AND ID_CONCEPTO_ULT_MOV IN(10,8) --10 ENTR A DOMICI  LPC / COD EMPRESARIOS SAT --8 EMPRESARIO SATELITE ENTREGA EN DOMICILIO&#xA; AND DATEDIFF(DAY, FECHA_HORA_MOVIMI_ULT_MOV,GETDATE())&gt;3-- MAS DE 3 DIAS&#xA; &#xA; UPDATE GPR SET ESTADO_ENTREGA='VENCIDO'&#xA; FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; WHERE GPR.ID_PROCESO_ULT_MOV=32 --ENVIO PARA ENTREGA A DOMICILIO&#xA; AND DATEDIFF(DAY, FECHA_HORA_MOVIMI_ULT_MOV,GETDATE())&gt;3-- MAS DE 3 DIAS&#xA;&#xA; UPDATE GPR SET ESTADO_ENTREGA='VENCIDO'&#xA; FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA; WHERE GPR.ID_PROCESO_ULT_MOV=9 AND ID_CONCEPTO_ULT_MOV IN(1,3) --SALIDA A ZONA Y C.O.D EN DISTRIBUCION&#xA; AND DATEDIFF(DAY, FECHA_HORA_MOVIMI_ULT_MOV,GETDATE())&gt;1 --MAS DE UN DIA&#xA;&#xA;&#xA;&#xA;DROP TABLE IF EXISTS #TMP_GUIAS_PENDIENTE_RECAUDO_SZU&#xA; SELECT &#xA; TMP.NUMERO_GUIA&#xA; ,(SE.CONSECUT_MOVIMI)&#x9;&#x9;&#x9;AS CONSECUT_MOVIMI_SZU&#xA; ,(SE.NUMERO_MOVIMI)&#x9;&#x9;&#x9;&#x9;AS NUMERO_MOVIMI_SZU&#xA; ,(SE.FECHA_HORA_MOVIMIENTO)&#x9;&#x9;AS FECHA_HORA_MOVIMI_ULT_MOV_SZU&#xA;INTO #TMP_GUIAS_PENDIENTE_RECAUDO_SZU&#xA;FROM #TMP_GUIAS_PENDIENTE_RECAUDO TMP&#xA;INNER JOIN Mece_Logistico..SEGUIMIENTO_ENVIO SE&#xA;ON SE.NUMERO_GUIA=TMP.NUMERO_GUIA&#xA;WHERE SE.ID_PROCESO=9&#xA;---GROUP BY  TMP.NUMERO_GUIA&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;;WITH CTE AS(&#xA;SELECT &#xA;ROWID = ROW_NUMBER() OVER(PARTITION BY NUMERO_GUIA ORDER BY FECHA_HORA_MOVIMI_ULT_MOV_SZU DESC)&#xA;,NUMERO_GUIA,FECHA_HORA_MOVIMI_ULT_MOV_SZU&#xA;FROM #TMP_GUIAS_PENDIENTE_RECAUDO_SZU&#xA;)&#xA;DELETE CTE WHERE ROWID&gt;1&#xA;&#xA;&#xA;DROP TABLE IF EXISTS #TMP_GUIAS_CON_TAREAS &#xA; SELECT &#xA; TMP.NUMERO_GUIA,&#xA; COUNT(TAR.NUMERO_DOCPROBLEMA) AS NUMERO_TAREAS&#xA;INTO #TMP_GUIAS_CON_TAREAS&#xA;FROM #TMP_GUIAS_PENDIENTE_RECAUDO TMP&#xA;INNER JOIN Mece_Logistico..TAREAS TAR WITH(NOLOCK)&#xA;ON TAR.NUMERO_DOCPROBLEMA=CONVERT(CHAR(20),TMP.NUMERO_GUIA)&#xA;GROUP BY TMP.NUMERO_GUIA&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;-------////////&#x9;&#x9;NUEVAS REGLAS DE NEGOCIO &#x9;&#x9;\\\\&#xA;-----&gt;EXCLUSIONES ADICIONALES&#xA;DELETE PBI &#xA;FROM  #TMP_GUIAS_PENDIENTE_RECAUDO PBI&#xA;WHERE PBI.FORMA_PAGO = 'LPC' AND ISNULL(PBI.VALOR_PRODUCTO,0) = 0&#xA;&#xA;DELETE PBI &#xA;FROM  #TMP_GUIAS_PENDIENTE_RECAUDO PBI&#xA;INNER JOIN Mece_Logistico.DBO.GUIAS_INF_ADICIONAL G_INFO_AD WITH(NOLOCK)&#xA;ON G_INFO_AD.NUMERO_GUIA=PBI.NUMERO_GUIA&#xA;WHERE PBI.FORMA_PAGO = 'LPC' AND ISNULL(G_INFO_AD.VALOR_RECAUDAR_PRODUCTO,0) = 0&#xA;AND PBI.ESTA_RECAUDADO = 1&#xA;&#xA;&#xA;&#xA;DROP TABLE IF EXISTS #TMP_GUIAS_PENDIENTE_RECAUDO_FINAL&#xA;SELECT &#xA;GPR.NUMERO_GUIA &#xA;,GPR.ID_ESTADOENVIO &#xA;,GPR.NOMBRE_ESTADOENVIO &#xA;,GPR.FORMA_PAGO &#xA;,GPR.VALOR_A_RECAUDAR &#xA;,GPR.ID_REMITE &#xA;,GPR.NOMBRE_REMITE_GUIA &#xA;,GPR.FECHA_ENVIO&#xA;,GPR.VALOR_RECAUDADO&#xA;,GPR.FECHA_RECAUDO&#xA;,GPR.NUMERO_ORDEN_SERVICIO&#xA;,GPR.FECHA_RECAUDO_EFECTY&#xA;,GPR.ESTADO_ENTREGA&#xA;,CASE WHEN ID_PROCESO!=14 THEN &#xA;ISNULL(ISNULL(CLO.CENTRO_LOGISTICO,CLD.CENTRO_LOGISTICO),'')  ELSE ISNULL(ISNULL(CLD.CENTRO_LOGISTICO,CLO.CENTRO_LOGISTICO),'') END AS CPL_ULT_MOV&#xA;,CASE WHEN ID_PROCESO!=14 THEN &#xA;ISNULL(ISNULL(RO.NOMBRE_REGIONAL,RD.NOMBRE_REGIONAL),'') ELSE ISNULL(ISNULL(RD.NOMBRE_REGIONAL,RO.NOMBRE_REGIONAL),'') END  AS REGIONAL_ULT_MOV&#xA;,CASE WHEN ID_PROCESO!=14 THEN &#xA;ISNULL(ISNULL(CO.NOMBRE_CIUDAD,CD.NOMBRE_CIUDAD),'')  ELSE ISNULL(ISNULL(CD.NOMBRE_CIUDAD,CO.NOMBRE_CIUDAD),'''') END  AS CIUDAD_ULT_MOV&#xA;,ISNULL(CASE &#xA; WHEN ISNULL(DOC.ID_CIUDAD_ZONA_URBA,0) !=0 THEN&#xA; ROZ.NOMBRE_REGIONAL+' - '+ DCOZ.NOMBRE_DEPARTAMENTO +' - '+ COZ.NOMBRE_CIUDAD &#xA; WHEN  ISNULL(DOC.ID_CIUDAD_DIVISION_ORIGEN,0) !=0 AND DOC.ID_PROCESO!=14 THEN&#xA; ROM.NOMBRE_REGIONAL+' - '+ DCOM.NOMBRE_DEPARTAMENTO +' - '+ COM.NOMBRE_CIUDAD&#xA; ELSE&#xA; ROD.NOMBRE_REGIONAL+' - '+ DCOD.NOMBRE_DEPARTAMENTO +' - '+ COD.NOMBRE_CIUDAD &#xA; END,'''') AS REG_DEPART_CIUDAD_ULTIMO_MOV&#xA;&#xA;,ISNULL(DOC.PLACA_VEHICULO_DOCU,'') as PLACA_VEHICULO_ULTIMO_MOV&#xA;,ISNULL(O.[NOMBRE_OPERATIVO],'') AS NOMBRE_OPERATIVO_ULTIMO_MOV&#xA;,ISNULL(Z.NOMBRE_ZONA_URBA,'') AS ZONA_URBANA_ULTIMO_MOV&#xA;,ISNULL(CZ.NOMBRE_CATEGORIA,'') AS CATEGORIA_ZONA_ULTIMO_MOV&#xA;,ISNULL(TZU.NOMBRE_TIPO_ZONA_URBA,'') AS TIPO_ZONA_ULTIMO_MOV&#xA;,ISNULL(GPR.NOMBRE_CDS_ULT_MOV,'') AS NOMBRE_CDS_ULT_MOV&#xA;,ISNULL(TIPO_CANAL_ULT_MOV,'') AS TIPO_CANAL_ULT_MOV&#xA;--,GR.ID_PROCESO &#xA;,ISNULL(GPR.NOMBRE_PROCESO_ULT_MOV,'') AS PROCESO_LOG_ULTIMO_MOV  &#xA;,ISNULL(GPR.NOMBRE_CONCEPTO_ULT_MOV,'') AS CONCEPTO_ULT_MOV&#xA;--,GR.ID_CONCEPTO  &#xA;--,GR.FECHA_HORA_MOVIMIENTO&#xA;,ISNULL(cast(GPR.ID_PROCESO_ULT_MOV as nvarchar) +' - '+ RTRIM(GPR.NOMBRE_PROCESO_ULT_MOV),'') AS NOMBRE_ULTIMO_MOV&#xA;,ISNULL(CASE WHEN DIO.ID_DIVISION IS NOT NULL THEN cast(DIO.ID_DIVISION as nvarchar) +' - '+ RTRIM(DIO.NOMBRE_DIVISION)&#xA;ELSE cast(DID.ID_DIVISION as nvarchar) +' - '+ RTRIM(DID.NOMBRE_DIVISION) END,'') AS BODEGA_ULTIMO_MOV&#xA;,ISNULL(cast(GPR.ID_PROCESO_ULT_MOV as nvarchar) +' - '+ RTRIM(GPR.[NUMERO_MOVIMI_ULT_MOV])+' - '+  cast(GPR.[CONSECUT_MOVIMI_ULT_MOV] as nvarchar),'') as ULTIMO_MOV_LOGISTICO&#xA;,ISNULL(CONVERT(nvarchar(20),GPR.FECHA_HORA_MOVIMI_ULT_MOV,120),'') AS FECHA_ULTIMO_MOV&#xA;,ISNULL(CONVERT(nvarchar(20),GPR.FECHA_ASIGNACION_AL_AUXILIAR,120),'') AS FECHA_ASIGNACION_AL_AUXILIAR&#xA;,GPR.ID_CONDUCTOR_ULT_MOV&#xA;,GPR.CONDUCTOR_ULT_MOV&#xA;,GPR.ID_AUXILIAR_ULT_MOV&#xA;,GPR.AUXILIAR_ULT_MOV&#xA;,GPR.ID_AUXILIAR_ASIGNADO_PEND_REC &#xA;,GPR.NOMBRE_AUXILIAR_ASIGNADO_PEND_REC&#xA;,GPR.ID_CLIENTE&#xA;,SZU.CONSECUT_MOVIMI_SZU&#xA;,SZU.NUMERO_MOVIMI_SZU&#xA;,SZU.FECHA_HORA_MOVIMI_ULT_MOV_SZU&#xA;,GPR.NOMBRE_TIPO_CANAL&#xA;,GPR.NOMBRE_CLASE_TIPO_CANAL&#xA;,TAR.NUMERO_TAREAS&#xA;,G_ID_CIUDAD_ORIGEN&#xA;,G_ID_CIUDAD_DESTINO&#xA;--,DOC.*&#xA;,GPR.ID_REGIONAL_ENTREGA_PEND_RECAUDO&#x9;&#xA;,GPR.ID_CIUDAD_ENTREGA_PEND_RECAUDO&#xA;INTO #TMP_GUIAS_PENDIENTE_RECAUDO_FINAL&#xA;FROM #TMP_GUIAS_PENDIENTE_RECAUDO GPR&#xA;--------------------------- CIUDAD ULTIMO MOV ZONA&#xA;  LEFT JOIN MECE_LOGISTICO.DBO.DOCUMENTOS DOC (NOLOCK) ON&#xA; DOC.ID_PROCESO=GPR.[ID_PROCESO_ULT_MOV] AND DOC.NUMERO_MOVIMI=GPR.[NUMERO_MOVIMI_ULT_MOV] AND DOC.CONSECUT_MOVIMI=GPR.[CONSECUT_MOVIMI_ULT_MOV]&#xA; --AND DOC.ID_DIVISION_DESTINO IN (9311, 9308, 9304, 9313, 9310, 9312, 9711, 9710)&#xA;  LEFT JOIN PARAMETROS.DBO.CIUDADES COZ (NOLOCK) ON  COZ.ID_PAIS=1 AND COZ.ID_CIUDAD=DOC.ID_CIUDAD_ZONA_URBA&#xA;  LEFT JOIN PARAMETROS.DBO.REGIONALES_PAIS ROZ (NOLOCK) ON  ROZ.ID_PAIS=COZ.ID_PAIS AND ROZ.ID_REGIONAL=COZ.ID_REGIONAL&#xA;  LEFT JOIN PARAMETROS.DBO.DEPARTAMENTOS DCOZ (NOLOCK) ON  DCOZ.ID_PAIS=COZ.ID_PAIS AND DCOZ.ID_DEPARTAMENTO=COZ.ID_DEPARTAMENTO&#xA;   LEFT JOIN PARAMETROS.DBO.ZONASURBANAS Z (NOLOCK) &#xA; ON Z.ID_PAIS = DOC.ID_PAIS_ZONA_URBA AND Z.ID_CIUDAD = DOC.ID_CIUDAD_ZONA_URBA AND Z.ID_TIPO_ZONA_URBA = DOC.ID_TIPO_ZONA_URBA AND Z.ID_ZONA_URBA = DOC.ID_ZONA_URBA --AND Z.CATEGORIA_ZONA_URBA = 8 --CLICOH&#xA;  LEFT JOIN [PARAMETROS].[dbo].[CATEGORIAZONASURBANAS] CZ (NOLOCK) ON CZ.Id_Categoria=Z.CATEGORIA_ZONA_URBA&#xA;  LEFT JOIN [PARAMETROS].[dbo].[TIPOSZONASURBANAS] TZU (NOLOCK) ON TZU.ID_TIPO_ZONA_URBA=Z.ID_TIPO_ZONA_URBA&#xA; --------------------------- CIUDAD ULTIMO MOV DOCUMENTO&#xA;  LEFT JOIN PARAMETROS.DBO.CIUDADES COM (NOLOCK) ON  COM.ID_PAIS=1 AND COM.ID_CIUDAD=DOC.ID_CIUDAD_DIVISION_ORIGEN&#xA;  LEFT JOIN PARAMETROS.DBO.REGIONALES_PAIS ROM (NOLOCK) ON  ROM.ID_PAIS=COM.ID_PAIS AND ROM.ID_REGIONAL=COM.ID_REGIONAL&#xA;  LEFT JOIN PARAMETROS.DBO.DEPARTAMENTOS DCOM (NOLOCK) ON  DCOM.ID_PAIS=COM.ID_PAIS AND DCOM.ID_DEPARTAMENTO=COM.ID_DEPARTAMENTO&#xA;  --------------------------- CIUDAD DESTINO ULTIMO MOV DOCUMENTO&#xA;  LEFT JOIN PARAMETROS.DBO.CIUDADES COD(NOLOCK) ON  COD.ID_PAIS=1 AND COD.ID_CIUDAD=DOC.ID_CIUDAD_DESTINO&#xA;  LEFT JOIN PARAMETROS.DBO.REGIONALES_PAIS ROD (NOLOCK) ON  ROD.ID_PAIS=COD.ID_PAIS AND ROD.ID_REGIONAL=COD.ID_REGIONAL&#xA;  LEFT JOIN PARAMETROS.DBO.DEPARTAMENTOS DCOD (NOLOCK) ON  DCOD.ID_PAIS=COD.ID_PAIS AND DCOD.ID_DEPARTAMENTO=COD.ID_DEPARTAMENTO&#xA;  --------------------------- DIVISION ORIGEN ULTIMO MOV DOCUMENTO&#xA;  LEFT JOIN PARAMETROS.DBO.DIVISIONES DIO(NOLOCK) ON DIO.ID_PAIS=DOC.ID_PAIS_DIVISION_ORIGEN&#xA; AND DIO.ID_CIUDAD=DOC.ID_CIUDAD_DIVISION_ORIGEN AND DIO.ID_DIVISION=DOC.ID_DIVISION_ORIGEN&#xA;  --------------------------- DIVISION DESTINO ULTIMO MOV DOCUMENTO&#xA;  LEFT JOIN PARAMETROS.DBO.DIVISIONES DID(NOLOCK) ON DID.ID_PAIS=DOC.ID_PAIS_DESTINO&#xA; AND DID.ID_CIUDAD=DOC.ID_CIUDAD_DESTINO AND DID.ID_DIVISION=DOC.ID_DIVISION_DESTINO&#xA;-------------------------------------------------------------&#xA;  LEFT JOIN [PARAMETROS].[dbo].CIUDADES CO (NOLOCK) ON CO.ID_PAIS=ID_PAIS_DIVISION_ORIGEN AND CO.ID_CIUDAD=DOC.ID_CIUDAD_DIVISION_ORIGEN&#xA;  LEFT JOIN [PARAMETROS].[dbo].REGIONALES_PAIS RO (NOLOCK) ON RO.ID_PAIS=1 AND RO.ID_REGIONAL=CO.[ID_REGIONAL]&#xA;  LEFT JOIN [PARAMETROS].[dbo].CIUDADES CD (NOLOCK) ON CD.ID_PAIS=DOC.ID_PAIS_DESTINO AND CD.ID_CIUDAD=DOC.ID_CIUDAD_DESTINO&#xA;  LEFT JOIN [PARAMETROS].[dbo].REGIONALES_PAIS RD (NOLOCK) ON RD.ID_PAIS=1 AND RD.ID_REGIONAL=CD.[ID_REGIONAL]&#xA;  LEFT JOIN [PARAMETROS].[dbo].[OPERATIVOS] O (NOLOCK) ON O.[ID_PAIS_ORIGEN]=DOC.ID_PAIS_OPERATIVO AND O.[ID_CIUDAD_ORIGEN]=DOC.ID_CIUDAD_OPERATIVO&#xA; AND O.[ID_OPERATIVO]=DOC.ID_OPERATIVO&#xA;  LEFT JOIN #TMP_CIUDADES_ANEXAS CAO (NOLOCK) ON CAO.ID_PAIS=1 AND CAO.[ID_CIUDAD_ANEXA]=CO.ID_CIUDAD --AND CAO.RECOLECCION=1&#xA;  LEFT JOIN PARAMETROS.DBO.CENTROS_LOGISTICOS CLO (NOLOCK) ON CLO.ID_PAIS=1 AND CLO.ID_CIUDAD=CAO.ID_CIUDAD AND CLO.ID_CENTRO_LOGISTICO=1 AND CLO.ID_ESTADO=1&#xA;  LEFT JOIN #TMP_CIUDADES_ANEXAS CAD (NOLOCK) ON CAD.ID_PAIS=1 AND CAD.[ID_CIUDAD_ANEXA]=CD.ID_CIUDAD --AND CAD.RECOLECCION=1&#xA;  LEFT JOIN PARAMETROS.DBO.CENTROS_LOGISTICOS CLD (NOLOCK) ON CLD.ID_PAIS=1 AND CLD.ID_CIUDAD=CAD.ID_CIUDAD AND CLD.ID_CENTRO_LOGISTICO=1 AND CLD.ID_ESTADO=1&#xA;LEFT JOIN #TMP_GUIAS_PENDIENTE_RECAUDO_SZU SZU ON SZU.NUMERO_GUIA=GPR.NUMERO_GUIA&#xA;LEFT JOIN #TMP_GUIAS_CON_TAREAS TAR ON TAR.NUMERO_GUIA=GPR.NUMERO_GUIA&#xA;&#xA;&#xA;DELETE G&#xA;from #TMP_GUIAS_PENDIENTE_RECAUDO_FINAL G&#xA;INNER JOIN [Mece_Logistico].[dbo].[CONFIRMACIONES] GC (NOLOCK) ON GC.NUMERO_GUIA=G.NUMERO_GUIA  &#xA;  WHERE GC.ID_SOLUCION IN (3,13,19)--DEVOLUCION A REMITENTE&#xA;  AND GC.FECHA_CONFIRMACION = (SELECT MAX(GC1.FECHA_CONFIRMACION) &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;FROM [Mece_Logistico].[dbo].[CONFIRMACIONES] GC1 (NOLOCK) &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHERE GC1.NUMERO_GUIA=G.NUMERO_GUIA AND GC1.ID_SOLUCION IN (3,13,19))&#xA;&#xA;DROP TABLE IF EXISTS ##TMP_GUIAS_PENDIENTE_RECAUDO_FINAL_PBI&#xA;;WITH CTE AS(&#xA;SELECT&#xA;&#x9; TMP.NUMERO_GUIA&#x9;&#xA;&#x9;,TMP.ID_ESTADOENVIO&#x9;&#xA;&#x9;,TMP.NOMBRE_ESTADOENVIO&#x9;&#xA;&#x9;,TMP.FORMA_PAGO&#x9;&#xA;&#x9;,TMP.VALOR_A_RECAUDAR&#x9;&#xA;&#x9;,TMP.ID_REMITE&#x9;&#xA;&#x9;,TMP.NOMBRE_REMITE_GUIA&#x9;&#xA;&#x9;,TMP.FECHA_ENVIO&#x9;&#xA;&#x9;,TMP.VALOR_RECAUDADO&#x9;&#xA;&#x9;,TMP.FECHA_RECAUDO&#x9;&#xA;&#x9;,TMP.NUMERO_ORDEN_SERVICIO&#x9;&#xA;&#x9;,TMP.FECHA_RECAUDO_EFECTY&#x9;&#xA;&#x9;,TMP.ESTADO_ENTREGA&#x9;&#xA;&#x9;,TMP.CPL_ULT_MOV&#x9;&#xA;&#x9;,TMP.REGIONAL_ULT_MOV&#x9;&#xA;&#x9;,TMP.CIUDAD_ULT_MOV&#x9;&#xA;&#x9;,TMP.REG_DEPART_CIUDAD_ULTIMO_MOV&#x9;&#xA;&#x9;,TMP.PLACA_VEHICULO_ULTIMO_MOV&#x9;&#xA;&#x9;,TMP.NOMBRE_OPERATIVO_ULTIMO_MOV&#x9;&#xA;&#x9;,TMP.ZONA_URBANA_ULTIMO_MOV&#x9;&#xA;&#x9;,TMP.CATEGORIA_ZONA_ULTIMO_MOV&#x9;&#xA;&#x9;,TMP.TIPO_ZONA_ULTIMO_MOV&#x9;&#xA;&#x9;,TMP.NOMBRE_CDS_ULT_MOV&#x9;&#xA;&#x9;,TMP.TIPO_CANAL_ULT_MOV&#x9;&#xA;&#x9;,TMP.PROCESO_LOG_ULTIMO_MOV&#x9;&#xA;&#x9;,TMP.CONCEPTO_ULT_MOV&#x9;&#xA;&#x9;,TMP.NOMBRE_ULTIMO_MOV&#x9;&#xA;&#x9;,TMP.BODEGA_ULTIMO_MOV&#x9;&#xA;&#x9;,TMP.ULTIMO_MOV_LOGISTICO&#x9;&#xA;&#x9;,TMP.FECHA_ULTIMO_MOV&#x9;&#xA;&#x9;,TMP.FECHA_ASIGNACION_AL_AUXILIAR&#x9;&#xA;&#x9;,TMP.ID_CONDUCTOR_ULT_MOV&#x9;&#xA;&#x9;,TMP.CONDUCTOR_ULT_MOV&#x9;&#xA;&#x9;,TMP.ID_AUXILIAR_ULT_MOV&#x9;&#xA;&#x9;,TMP.AUXILIAR_ULT_MOV&#x9;&#xA;&#x9;,TMP.ID_AUXILIAR_ASIGNADO_PEND_REC&#x9;&#xA;&#x9;,NOMBRE_AUXILIAR_ASIGNADO_PEND_REC&#x9;= CASE WHEN ISNULL(TMP.ID_AUXILIAR_ASIGNADO_PEND_REC,'0') = '0' OR LEN(TMP.ID_AUXILIAR_ASIGNADO_PEND_REC)&lt;1 THEN 'AUXILIAR NO ASIGNADO' ELSE CONCAT(LTRIM(RTRIM(TMP.ID_AUXILIAR_ASIGNADO_PEND_REC)),' ',TMP.NOMBRE_AUXILIAR_ASIGNADO_PEND_REC) END&#xA;&#x9;,TMP.ID_AUXILIAR_ASIGNADO_PEND_REC&#x9;AS CEDULA&#xA;&#x9;,NOMBRE_AUXILIAR_ASIGNADO_PEND_FNL&#x9;= CASE WHEN ISNULL(TMP.ID_AUXILIAR_ASIGNADO_PEND_REC,'0') = '0' OR LEN(TMP.ID_AUXILIAR_ASIGNADO_PEND_REC)&lt;1 THEN 'AUXILIAR NO ASIGNADO' ELSE LTRIM(RTRIM(TMP.NOMBRE_AUXILIAR_ASIGNADO_PEND_REC)) END&#xA;&#x9;,TMP.ID_CLIENTE&#x9;&#xA;&#x9;,TMP.CONSECUT_MOVIMI_SZU&#x9;&#xA;&#x9;,TMP.NUMERO_MOVIMI_SZU&#x9;&#xA;&#x9;,TMP.FECHA_HORA_MOVIMI_ULT_MOV_SZU&#x9;&#xA;&#x9;,FECHA_EXTRACCION = GETDATE()&#xA;&#x9;,TMP.NOMBRE_TIPO_CANAL&#x9;&#xA;&#x9;,TMP.NOMBRE_CLASE_TIPO_CANAL&#x9;&#xA;&#x9;,TMP.NUMERO_TAREAS&#x9;&#xA;&#x9;,TMP.G_ID_CIUDAD_ORIGEN&#x9;&#xA;&#x9;,TMP.G_ID_CIUDAD_DESTINO&#xA;&#x9;,G_ID_REGIONAL_ORIGEN = CD_OR.ID_REGIONAL&#xA;&#x9;,G_ID_REGIONAL_DESTINO = CD_DS.ID_REGIONAL&#xA;&#x9;,TMP.ID_REGIONAL_ENTREGA_PEND_RECAUDO&#x9;&#xA;&#x9;,TMP.ID_CIUDAD_ENTREGA_PEND_RECAUDO&#xA;&#x9;,RG.NOMBRE_REGIONAL AS NOMBRE_REGIONAL_PEND_RECAUDO&#xA;&#x9;,CNF_ID_CONFIRMACION = 0&#xA;FROM #TMP_GUIAS_PENDIENTE_RECAUDO_FINAL TMP&#xA;LEFT JOIN #PARAMETROS_DBO_REGIONALES_PAIS  RG WITH(NOLOCK) ON RG.ID_REGIONAL=TMP.ID_REGIONAL_ENTREGA_PEND_RECAUDO AND RG.ID_PAIS=1&#xA;------&gt;ORIGEN&#xA;LEFT JOIN #PARAMETROS_DBO_CIUDADES CD_OR ON TMP.G_ID_CIUDAD_ORIGEN = CD_OR.ID_CIUDAD AND CD_OR.ID_PAIS=1&#x9;&#xA;------&gt;DESTINO&#xA;LEFT JOIN #PARAMETROS_DBO_CIUDADES CD_DS ON TMP.G_ID_CIUDAD_DESTINO = CD_DS.ID_CIUDAD AND CD_DS.ID_PAIS=1&#xA;)&#xA;SELECT &#xA;NUMERO_GUIA,NOMBRE_ESTADOENVIO,FORMA_PAGO,VALOR_A_RECAUDAR,ID_REMITE,NOMBRE_REMITE_GUIA,FECHA_ENVIO,VALOR_RECAUDADO,FECHA_RECAUDO,NUMERO_ORDEN_SERVICIO,FECHA_RECAUDO_EFECTY,ESTADO_ENTREGA,CPL_ULT_MOV,REGIONAL_ULT_MOV,CIUDAD_ULT_MOV,REG_DEPART_CIUDAD_ULTIMO_MOV,PLACA_VEHICULO_ULTIMO_MOV,NOMBRE_OPERATIVO_ULTIMO_MOV,ZONA_URBANA_ULTIMO_MOV,CATEGORIA_ZONA_ULTIMO_MOV,TIPO_ZONA_ULTIMO_MOV,NOMBRE_CDS_ULT_MOV,TIPO_CANAL_ULT_MOV,PROCESO_LOG_ULTIMO_MOV,CONCEPTO_ULT_MOV,NOMBRE_ULTIMO_MOV,BODEGA_ULTIMO_MOV,ULTIMO_MOV_LOGISTICO,FECHA_ULTIMO_MOV,ID_CONDUCTOR_ULT_MOV,CONDUCTOR_ULT_MOV,ID_AUXILIAR_ULT_MOV,AUXILIAR_ULT_MOV,ID_CLIENTE,CONSECUT_MOVIMI_SZU,NUMERO_MOVIMI_SZU,FECHA_HORA_MOVIMI_ULT_MOV_SZU,FECHA_EXTRACCION,NOMBRE_TIPO_CANAL,NOMBRE_CLASE_TIPO_CANAL,NUMERO_TAREAS,G_ID_CIUDAD_ORIGEN,G_ID_CIUDAD_DESTINO,G_ID_REGIONAL_ORIGEN,G_ID_REGIONAL_DESTINO,CNF_ID_CONFIRMACION&#xA;&#x9;&#x9;INTO ##TMP_GUIAS_PENDIENTE_RECAUDO_FINAL_PBI&#xA;FROM CTE &#xA;&quot;"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="Z_SCRIPT01_Prepatacion_data_Recudo_LPC_COD">
      <DTS:VariableValue
        DTS:DataType="8">
DECLARE @FECH_INI DATETIME =  '20251103' ;	/*---			'20260101';			*/
DECLARE @FECH_FIN DATETIME =  '20261104' ;	/*---			'20260101';			*/
IF OBJECT_ID('tempdb..#COD_PENDIENTE_POR_RECAUDO') IS NOT NULL 
    DROP TABLE #COD_PENDIENTE_POR_RECAUDO

IF OBJECT_ID('tempdb..#TMP_GUIAS_PENDIENTE_RECAUDO') IS NOT NULL 
    DROP TABLE #TMP_GUIAS_PENDIENTE_RECAUDO

IF OBJECT_ID('tempdb..#TMP_CIUDADES_ANEXAS') IS NOT NULL 
    DROP TABLE #TMP_CIUDADES_ANEXAS

---CIUDADES ANEXAS
SELECT CAD.* 
INTO #TMP_CIUDADES_ANEXAS FROM PARAMETROS.DBO.CIUDADES_ANEXAS CAD (NOLOCK) 
WHERE CAD.ID_PAIS=1 AND CAD.RECOLECCION=1

INSERT INTO #TMP_CIUDADES_ANEXAS
SELECT CAD.* FROM PARAMETROS.DBO.CIUDADES_ANEXAS CAD (NOLOCK) 
LEFT JOIN #TMP_CIUDADES_ANEXAS TCAD ON TCAD.ID_CIUDAD_ANEXA=CAD.ID_CIUDAD_ANEXA
WHERE CAD.ID_PAIS=1 AND CAD.RECOLECCION=0 AND TCAD.ID_CIUDAD_ANEXA IS NULL

DELETE T FROM (SELECT *, 
    DupRank = ROW_NUMBER() OVER (PARTITION BY ID_CIUDAD_ANEXA ORDER BY FECHA_CREACION DESC) 
     FROM #TMP_CIUDADES_ANEXAS) AS T
WHERE DupRank &gt; 1


DROP TABLE IF EXISTS #PARAMETROS_DBO_CIUDADES;
SELECT * 
INTO #PARAMETROS_DBO_CIUDADES
FROM PARAMETROS.DBO.CIUDADES CD WITH(NOLOCK)

DROP TABLE IF EXISTS #PARAMETROS_DBO_REGIONALES_PAIS;
SELECT * 
INTO #PARAMETROS_DBO_REGIONALES_PAIS
FROM PARAMETROS.DBO.REGIONALES_PAIS RG WITH(NOLOCK)




DROP TABLE IF EXISTS #Mece_Logistico_dbo_COD_PENDIENTE_POR_RECAUDO;
SELECT *
INTO #Mece_Logistico_dbo_COD_PENDIENTE_POR_RECAUDO
FROM [Mece_Logistico].[dbo].[COD_PENDIENTE_POR_RECAUDO] CPR WITH (NOLOCK)
WHERE 
    -- Filtros de fecha y condiciones generales obligatorias
    CPR.FECHA_ASIGNACION_AL_AUXILIAR &gt;= @FECH_INI 
    AND CPR.FECHA_ASIGNACION_AL_AUXILIAR &lt;= @FECH_FIN
    AND ISNULL(CPR.ESTA_ANULADO, 0) = 0 
    AND ISNULL(CPR.ESTA_RECAUDADO, 0) = 0
    AND (
        -- Bloque 1 (equivalente al primer SELECT)
        (
            (CPR.NUMERO_ORDEN_SERVICIO IS NULL OR CPR.NUMERO_ORDEN_SERVICIO = '')
        )
        OR
        -- Bloque 2 (equivalente al segundo SELECT)
        (
            ISNULL(CPR.ESTADO_COD, 0) = 1 
            AND (CPR.NUMERO_ORDEN_SERVICIO IS NULL OR CPR.NUMERO_ORDEN_SERVICIO = '')
            AND ISNULL(CPR.ID_MODALPAGO, 0) = 0 
            AND (CPR.NUMERO_APROBACION IS NULL OR LTRIM(RTRIM(CPR.NUMERO_APROBACION)) = '')
            AND ISNULL(CPR.INGRESO_MANUAL, 0) = 0
        )
    );

CREATE NONCLUSTERED INDEX [IX_NUMERO_GUIA_PEND_RECAUDO] ON #Mece_Logistico_dbo_COD_PENDIENTE_POR_RECAUDO
(
	[NUMERO_GUIA] ASC
)WITH (PAD_INDEX = OFF, STATISTICS_NORECOMPUTE = OFF, SORT_IN_TEMPDB = OFF, DROP_EXISTING = OFF, ONLINE = OFF, ALLOW_ROW_LOCKS = ON, ALLOW_PAGE_LOCKS = ON, FILLFACTOR = 80) ON [PRIMARY]


SELECT 
    CPR.*
    ,G.ID_CLIENTE, G.ID_REMITE
    ,G.NOMBRE_REMITE_GUIA
    ,G.ID_PRODUCTO AS ID_PRODUCTO_GUIA
    ,G.ID_ESTADOENVIO, G.ID_ESTADOGUIA
    ,ISNULL(G.VALOR_SEG_MAN_GUIAS, 0) + ISNULL(G.VALOR_FLETES_GUIAS, 0) AS VALOR_ENVIO_GUIA
    ,ISNULL(GIA.VALOR_RECAUDAR_PRODUCTO, 0) AS VALOR_RECAUDAR_PRODUCTO_GUIA
    ,CAST('' AS nvarchar(50)) AS NOMBRE_ESTADOENVIO
    ,G.FECHA_ENVIO
    ,TCAN.NOMBRE_TIPO_CANAL
    ,CTCAN.NOMBRE_CLASE_TIPO_CANAL
    ,G.[ID_CIUDAD_ORIGEN] AS G_ID_CIUDAD_ORIGEN
    ,G.[ID_CIUDAD_DESTINO] AS G_ID_CIUDAD_DESTINO
    ,CIUD.ID_REGIONAL AS ID_REGIONAL_ENTREGA_PEND_RECAUDO
    ,CPR.ID_CIUDAD_ENTREGA AS ID_CIUDAD_ENTREGA_PEND_RECAUDO
	INTO #COD_PENDIENTE_POR_RECAUDO
FROM #Mece_Logistico_dbo_COD_PENDIENTE_POR_RECAUDO CPR WITH (NOLOCK)
INNER JOIN [Mece_Logistico].[dbo].[GUIAS] G WITH (NOLOCK) 
    ON G.NUMERO_GUIA = CPR.NUMERO_GUIA
LEFT JOIN [Mece_Logistico].[dbo].[GUIAS_INF_ADICIONAL] GIA WITH (NOLOCK) 
    ON GIA.NUMERO_GUIA = CPR.NUMERO_GUIA
LEFT JOIN [Mece_Logistico].[dbo].[CANALES] CAN WITH (NOLOCK) 
    ON CAN.id_pais = G.ID_1 
   AND CAN.id_ciudad = G.ID_2 
   AND CAN.[ID_DIVISION] = G.ID_CANAL
LEFT JOIN [Mece_Logistico].[dbo].[TIPOS_CANAL] TCAN WITH (NOLOCK) 
    ON TCAN.ID_TIPO_CANAL = CAN.ID_TIPO_CANAL 
   AND TCAN.ID_EST_TIPO_CANAL = 1
LEFT JOIN PARAMETROS.[dbo].[CLASE_TIPO_CANAL] CTCAN WITH (NOLOCK) 
    ON CTCAN.ID_CLASE_TIPO_CANAL = TCAN.CLASE_TIPO_CANAL
LEFT JOIN PARAMETROS.[dbo].[CIUDADES] CIUD WITH (NOLOCK) 
    ON CIUD.ID_CIUDAD = CPR.ID_CIUDAD_ENTREGA
WHERE ISNULL(G.ID_DIVISION_PROV, 0) = 0

; WITH CTE_DELL AS ( SELECT ROW_NUMBER() OVER(PARTITION BY NUMERO_GUIA ORDER BY FECHA_ACTUALIZACION DESC) AS ROWID,
						NUMERO_GUIA FROM #COD_PENDIENTE_POR_RECAUDO) DELETE CTE_DELL WHERE ROWID&gt;1
CREATE NONCLUSTERED INDEX [IX_NUMERO_GUIA] ON #COD_PENDIENTE_POR_RECAUDO ([NUMERO_GUIA] ASC)
--Se quitan envios siniestrados
DELETE GPR FROM #COD_PENDIENTE_POR_RECAUDO GPR
WHERE ID_ESTADOENVIO in(5,4)

--Quita las guias son del canal retail y no son COD y no contraentrega ecommerce
DELETE GPR FROM #COD_PENDIENTE_POR_RECAUDO GPR
WHERE ID_FORMA_PAGO=1 AND ISNULL(ID_PRODUCTO_GUIA,999) !=86
--WHERE ID_FORMA_PAGO=1 AND ISNULL(ID_PRODUCTO,999) !=86


