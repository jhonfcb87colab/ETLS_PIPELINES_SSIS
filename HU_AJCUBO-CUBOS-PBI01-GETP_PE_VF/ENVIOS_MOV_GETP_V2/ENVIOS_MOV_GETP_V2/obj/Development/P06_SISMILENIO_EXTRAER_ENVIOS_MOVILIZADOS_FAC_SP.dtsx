  <DTS:Variables>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{FF19B07D-A7E4-4E55-8C65-4A2AB0DAE29C}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="(DT_DATE) @[$Project::FULL_FACH_FIN] == (DT_DATE) &quot;1900-01-01&quot;?&#xA;(DT_DATE)((DT_WSTR,4)YEAR(DATEADD(&quot;DD&quot;, 1 ,GETDATE()))+&quot;-&quot;+RIGHT(&quot;0&quot;+(DT_WSTR,2)MONTH(DATEADD(&quot;DD&quot;,1,GETDATE())),2)+&quot;-&quot;+RIGHT(&quot;0&quot;+(DT_WSTR,2)DAY(DATEADD(&quot;DD&quot;,1,GETDATE())),2))&#xA;: (DT_DATE) @[$Project::FULL_FACH_FIN]"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="FechaFin">
      <DTS:VariableValue
        DTS:DataType="7">11/1/2026</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{D14B0169-E30F-4184-8F5D-FC85DB1A9389}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="(DT_DATE)   @[$Project::FULL_FACH_INI]    == (DT_DATE) &quot;1900-01-01&quot;? &#xA;(DT_DATE)((DT_WSTR,4)YEAR(DATEADD(&quot;DD&quot;, -@[$Project::DiaIni], GETDATE()))+&quot;-&quot;&#xA;+RIGHT(&quot;0&quot;+(DT_WSTR,2)MONTH(DATEADD(&quot;DD&quot;,-@[$Project::DiaIni],GETDATE() )),2)+&quot;-&quot;&#xA;+RIGHT(&quot;0&quot;+(DT_WSTR,2)DAY(DATEADD(&quot;DD&quot;, -@[$Project::DiaIni],GETDATE() )),2))&#xA;: (DT_DATE) @[$Project::FULL_FACH_INI]"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="FechaIni">
      <DTS:VariableValue
        DTS:DataType="7">10/10/2026</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{3C74BCB9-5DF1-4731-B634-A9810E68D573}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot; DECLARE @FEC_INI  INT  =   CONVERT(INT, CONVERT( DATETIME, '&quot;+ @[User::STR_FechaIni] +&quot;' ) )&#xA;, @FEC_FIN  INT  =   CONVERT(INT, CONVERT( DATETIME, '&quot;+ @[User::STR_FechaFin] +&quot;' ) )&#xA;&#xA;-------------------------&#xA;--Ingreso Tiempo Oferta&#xA;-------------------------&#xA;&#xA;SELECT&#x9;DISTINCT EM.ID_CIUDAD_ORIGEN, &#xA;&#x9;&#x9;EM.ID_CIUDAD_DESTINO, &#xA;&#x9;&#x9;TIEMPO_EN_ENTREGA,&#xA;&#x9;&#x9;TIEMPO_ENTREGA_COMERCIAL AS T_CIAL&#xA;&#x9;&#x9;INTO #CLIENTE_CORPORATIVO_RED_OPERATIVA &#xA;FROM&#x9;FAC.ENVIOS_MOVILIZADOS  AS EM WITH(NOLOCK)&#xA;&#x9;&#x9;INNER JOIN DIM.RED_OPERATIVA_TIEMPO_TAB_F AS RED WITH(NOLOCK) ON &#xA;&#x9;( EM.TIME_ID &gt;= @FEC_INI AND  EM.TIME_ID &lt; @FEC_FIN )  AND&#xA;&#x9;EM.ID_CIUDAD_ORIGEN = RED.ID_CIUDAD_ORIGEN &#xA;&#x9;AND EM.ID_CIUDAD_DESTINO = RED.ID_CIUDAD_DESTINO&#xA;&#xA;CREATE INDEX IDX_ENVIOS_MOVILIZADOS1 ON #CLIENTE_CORPORATIVO_RED_OPERATIVA&#xA;(ID_CIUDAD_ORIGEN,ID_CIUDAD_DESTINO,TIEMPO_EN_ENTREGA)&#xA;&#xA;UPDATE&#x9;FAC.ENVIOS_MOVILIZADOS&#xA;SET&#x9;&#x9;&#xA;&#x9;TIEMPO_OFERTA = ISNULL(RO.T_CIAL,36) * CANT_GUIAS&#xA;FROM&#x9;FAC.ENVIOS_MOVILIZADOS AS EM WITH(NOLOCK)&#xA;&#x9;&#x9;INNER JOIN #CLIENTE_CORPORATIVO_RED_OPERATIVA AS RO ON&#x9;&#xA;&#x9;( EM.TIME_ID &gt;= @FEC_INI AND  EM.TIME_ID &lt; @FEC_FIN ) AND&#xA;&#x9;EM.ID_CIUDAD_ORIGEN = RO.ID_CIUDAD_ORIGEN&#xA;&#x9;AND EM.ID_CIUDAD_DESTINO = RO.ID_CIUDAD_DESTINO&#xA;&#x9;AND EM.TIEMPO_EN_ENTREGA = RO.TIEMPO_EN_ENTREGA&#xA;&#xA;&#xA;DROP TABLE IF EXISTS  #CLIENTE_CORPORATIVO_RED_OPERATIVA&#xA;&quot;"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="IngresoTiempoOferta">
      <DTS:VariableValue
        DTS:DataType="8"> DECLARE @FEC_INI  INT  =   CONVERT(INT, CONVERT( DATETIME, '20261010' ) )
, @FEC_FIN  INT  =   CONVERT(INT, CONVERT( DATETIME, '20261101' ) )

-------------------------
--Ingreso Tiempo Oferta
-------------------------

SELECT	DISTINCT EM.ID_CIUDAD_ORIGEN, 
		EM.ID_CIUDAD_DESTINO, 
		TIEMPO_EN_ENTREGA,
		TIEMPO_ENTREGA_COMERCIAL AS T_CIAL
		INTO #CLIENTE_CORPORATIVO_RED_OPERATIVA 
FROM	FAC.ENVIOS_MOVILIZADOS  AS EM WITH(NOLOCK)
		INNER JOIN DIM.RED_OPERATIVA_TIEMPO_TAB_F AS RED WITH(NOLOCK) ON 
	( EM.TIME_ID &gt;= @FEC_INI AND  EM.TIME_ID &lt; @FEC_FIN )  AND
	EM.ID_CIUDAD_ORIGEN = RED.ID_CIUDAD_ORIGEN 
	AND EM.ID_CIUDAD_DESTINO = RED.ID_CIUDAD_DESTINO

CREATE INDEX IDX_ENVIOS_MOVILIZADOS1 ON #CLIENTE_CORPORATIVO_RED_OPERATIVA
(ID_CIUDAD_ORIGEN,ID_CIUDAD_DESTINO,TIEMPO_EN_ENTREGA)

UPDATE	FAC.ENVIOS_MOVILIZADOS
SET		
	TIEMPO_OFERTA = ISNULL(RO.T_CIAL,36) * CANT_GUIAS
FROM	FAC.ENVIOS_MOVILIZADOS AS EM WITH(NOLOCK)
		INNER JOIN #CLIENTE_CORPORATIVO_RED_OPERATIVA AS RO ON	
	( EM.TIME_ID &gt;= @FEC_INI AND  EM.TIME_ID &lt; @FEC_FIN ) AND
	EM.ID_CIUDAD_ORIGEN = RO.ID_CIUDAD_ORIGEN
	AND EM.ID_CIUDAD_DESTINO = RO.ID_CIUDAD_DESTINO
	AND EM.TIEMPO_EN_ENTREGA = RO.TIEMPO_EN_ENTREGA


DROP TABLE IF EXISTS  #CLIENTE_CORPORATIVO_RED_OPERATIVA
</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{D0F0916D-15CD-49C5-A0B3-274F20909CD2}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="(DT_WSTR, 10)&#xA;( &#xA;&#x9;(&#xA;&#x9;&#x9;(&#xA;&#x9;&#x9;&#x9;(  YEAR( @[User::FechaFin] )*100 )   &#xA;&#x9;&#x9;&#x9;+&#xA;&#x9;&#x9;&#x9;(  MONTH( @[User::FechaFin] )  )&#xA;&#x9;&#x9;)*100&#xA;&#x9;)+ DAY( @[User::FechaFin] )&#xA;)"
