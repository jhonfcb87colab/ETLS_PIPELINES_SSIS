            <component
              refId="Package\Data Flow Task TMP a FAC Envios_Movilizados\OLE DB Source TMP"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SqlServer v10; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
              description="OLE DB Source"
              name="OLE DB Source TMP"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=15.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">/*************************************************************************************
	CUBO: ENVIOS MOVILIZADOS
	FECHA: 10/05/2017	POR: D. MILEIDY BELTRÁN L.
	COMO NO SE CALCULA EL TIEMPO DE PROMESA PARA ESTE CUBO (APARTE), SE DEJA SOLO 
	EL SCRIPT TENIENDO COMO FUENTE LA TABLA TMP.ENVIOS_MOV.
	IMPLEMENTACIÓN A PARTIR DE ABRIL 2017	
**************************************************************************************/

SELECT CONVERT(NUMERIC,CONVERT(DATETIME,CONVERT(CHAR(11),EM.FECHA_ENVIO)))AS TIMEID
	,CONVERT(DATETIME,CONVERT(CHAR(11),EM.FECHA_ENVIO))AS FECHA
	,DAY (EM.FECHA_ENVIO) AS DIA
	,MONTH (EM.FECHA_ENVIO) AS MES
	,YEAR (EM.FECHA_ENVIO) AS AÑO
	,ISNULL(EM.ID_PAIS_ORIGEN,0) AS ID_PAIS_ORIGEN
	,ISNULL(EM.ID_CIUDAD_ORIGEN,0) AS ID_CIUDAD_ORIGEN
	,ISNULL(EM.ID_PAIS_DESTINO,0) AS ID_PAIS_DESTINO
	,ISNULL(EM.ID_CIUDAD_DESTINO,0) AS ID_CIUDAD_DESTINO
	,ISNULL(EM.ID_TIPOGUIA,0) AS ID_TIPO_GUIA
	,ISNULL(RTRIM(EM.ID_CLIENTE),0) AS ID_CLIENTE  
	,ISNULL(EM.ID_ESTADOENVIO,0) AS ID_ESTADO_ENVIO
	,ISNULL(EM.ID_DOCU_ULT_MOVI,0) AS   ID_PROCESO
	,ISNULL(EM.ID_MEDTRANS,0) AS ID_MED_TRANS
	,ISNULL(EM.ID_PRODUCTO,0) AS ID_PRODUCTO
	,ISNULL(EM.ID_SUBPRODUCTO,0) AS ID_SUBPRODUCTO
	,ISNULL(EM.ID_ESTADOGUIA,0) AS ID_ESTADO_GUIA
	,ISNULL(EM.ID_TIEMPO_ENTREGA,0) AS ID_TIEMPO_ENTREGA
	,ISNULL(EM.ID_REQ_EMBALAJE,0) AS ID_REQ_EMBALAJE
	,COUNT(DISTINCT EM.NUMERO_GUIA) AS CANT_GUIAS
	,SUM(CASE WHEN ISNULL(EM.NUMERO_PIEZAS,0) = 0 THEN 1 ELSE EM.NUMERO_PIEZAS END) AS CANT_PIEZAS
	,CASE
		WHEN EM.ID_ESTADOENVIO &lt; 3 AND EM.FECHA_ENTREGA IS NULL 
			THEN 2880
		WHEN (EM.ID_DOCU_ULT_MOVI &lt;&gt; 11 OR EM.ID_DOCU_ULT_MOVI &lt;&gt; 24) AND EM.FECHA_ENTREGA IS NULL 
			THEN 2880
		WHEN EM.FECHA_ENTREGA &lt; EM.FECHA_ENVIO 
			THEN 2880
		WHEN DATEPART (HH, EM.FECHA_ENVIO )= 0 
			THEN (ISNULL(DATEDIFF(MI,EM.FECHA_ENVIO,EM.FECHA_ENTREGA),0) - 960)
		ELSE ISNULL(DATEDIFF(MI,EM.FECHA_ENVIO,EM.FECHA_ENTREGA),0) 
	END AS TIEMPO_ENTREGA
	,ISNULL(DATEDIFF(MI,EM.FECHA_ENTREGA,EM.FECHA_MODIFICACION),0) AS TIEMPO_EN_DIGITALIZAR
FROM SIG_COL_LOGISTICA_DW.TMP.ENVIOS_MOV EM WITH (NOLOCK)
GROUP BY CONVERT(NUMERIC,CONVERT(DATETIME,CONVERT(CHAR(11),EM.FECHA_ENVIO)))
	,CONVERT(DATETIME,CONVERT(CHAR(11),EM.FECHA_ENVIO))
	,DAY (EM.FECHA_ENVIO)
	,MONTH (EM.FECHA_ENVIO)
	,YEAR (EM.FECHA_ENVIO)
	,ISNULL(EM.ID_PAIS_ORIGEN,0)
	,ISNULL(EM.ID_CIUDAD_ORIGEN,0)
	,ISNULL(EM.ID_PAIS_DESTINO,0)
	,ISNULL(EM.ID_CIUDAD_DESTINO,0)
	,ISNULL(EM.ID_TIPOGUIA,0)
	,ISNULL(RTRIM(EM.ID_CLIENTE),0)
	,ISNULL(EM.ID_ESTADOENVIO,0)
	,ISNULL(EM.ID_DOCU_ULT_MOVI,0)
	,ISNULL(EM.ID_MEDTRANS,0)
	,ISNULL(EM.ID_PRODUCTO,0) 
	,ISNULL(EM.ID_SUBPRODUCTO,0)
	,ISNULL(EM.ID_ESTADOGUIA,0)
	,ISNULL(EM.ID_TIEMPO_ENTREGA,0) 
	,ISNULL(EM.ID_REQ_EMBALAJE,0)
	,CASE
		WHEN EM.ID_ESTADOENVIO &lt; 3 AND EM.FECHA_ENTREGA IS NULL 
			THEN 2880
		WHEN (EM.ID_DOCU_ULT_MOVI &lt;&gt; 11 OR EM.ID_DOCU_ULT_MOVI &lt;&gt; 24) AND EM.FECHA_ENTREGA IS NULL 
			THEN 2880
		WHEN EM.FECHA_ENTREGA &lt; EM.FECHA_ENVIO 
			THEN 2880
		WHEN DATEPART (HH, EM.FECHA_ENVIO )= 0 
			THEN (ISNULL(DATEDIFF(MI,EM.FECHA_ENVIO,EM.FECHA_ENTREGA),0) - 960)
		ELSE ISNULL(DATEDIFF(MI,EM.FECHA_ENVIO,EM.FECHA_ENTREGA),0) 
	END
	,ISNULL(DATEDIFF(MI,EM.FECHA_ENTREGA,EM.FECHA_MODIFICACION),0)</property>
                <property
                  dataType="System.String"
                  description="The variable that contains the SQL command to be executed."
                  name="SqlCommandVariable"></property>
                <property
                  dataType="System.Int32"
                  description="Specifies the column code page to use when code page information is unavailable from the data source."
