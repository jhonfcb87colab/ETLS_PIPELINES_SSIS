        <DTS:Executable
          DTS:refId="Package\CALCULO INDICADOR ACIDO Y DEPURADA\OBTENER PLACA DEPURADA"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{76FF70EF-89A6-4BE3-A39D-6D4A68E7DE6E}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="OBTENER PLACA DEPURADA"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{3CA246E4-2A50-48E4-8910-61693339737A}"
              SQLTask:SqlStatementSource="WITH CTE&#xA;(&#xA;&#x9; G_NUMERO_GUIA&#xA;&#x9;,ID_PROCESO&#xA;&#x9;,NUMERO_MOVIMI&#xA;&#x9;,CONSECUT_MOVIMI&#xA;&#x9;,FECHA_HORA_MOVIMIENTO&#xA;)&#xA;AS&#xA;(&#xA;&#x9;SELECT&#xA;&#x9;&#x9; C.G_NUMERO_GUIA&#xA;&#x9;&#x9;,P.ID_PROCESO&#xA;&#x9;&#x9;,P.NUMERO_MOVIMI&#xA;&#x9;&#x9;,P.CONSECUT_MOVIMI&#xA;&#x9;&#x9;,P.FECHA_HORA_MOVIMIENTO&#xA;&#x9;FROM&#xA;&#x9;&#x9;TMP.[CUMPLIMIENTO_AC_DEP] C WITH(NOLOCK)&#xA;&#x9;INNER JOIN&#xA;&#x9;&#x9;TMP.[CUMPLIMIENTO_AC_DEP_01] P WITH(NOLOCK)&#xA;&#x9;ON&#xA;&#x9;&#x9;C.G_NUMERO_GUIA = P.NUMERO_GUIA&#xA;&#x9;WHERE&#xA;&#x9;(&#xA;&#x9;&#x9;C.SE_PROMESA_CUMPLE_DEPURADA = 'NO'&#xA;&#x9;OR&#xA;&#x9;&#x9;C.SE_PROMESA_CUMPLE_DEPURADA = 'NO'&#xA;&#x9;)&#xA;&#x9;AND&#xA;&#x9;&#x9;P.ID_PROCESO = 12&#xA;)&#xA;INSERT INTO [TMP].[CUMPLIMIENTO_AC_DEP_02]&#xA;           ([G_NUMERO_GUIA]&#xA;           ,[ID_PROCESO]&#xA;           ,[NUMERO_MOVIMI]&#xA;           ,[CONSECUT_MOVIMI]&#xA;           ,[PLACA_VEHICULO_DOCU]&#xA;           ,[FECHA_HORA_MOVIMIENTO])&#xA;SELECT&#xA;&#x9; CTE.G_NUMERO_GUIA&#xA;&#x9;,CTE.ID_PROCESO&#xA;&#x9;,CTE.NUMERO_MOVIMI&#xA;&#x9;,CTE.CONSECUT_MOVIMI&#xA;&#x9;,D.PLACA_VEHICULO_DOCU&#xA;&#x9;,CTE.FECHA_HORA_MOVIMIENTO&#xA;FROM&#xA;&#x9;[SIG_COLOMBIA_DW].[LOG].DOCUMENTOS D  WITH(NOLOCK) INNER JOIN CTE&#xA;ON&#xA;&#x9;D.ID_PROCESO = CTE.ID_PROCESO&#xA;AND&#xA;&#x9;D.NUMERO_MOVIMI = CTE.NUMERO_MOVIMI&#xA;AND&#xA;&#x9;D.CONSECUT_MOVIMI = CTE.CONSECUT_MOVIMI" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\CALCULO INDICADOR ACIDO Y DEPURADA\OBTENER PRIMERA GESTIÓN"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{61FDAEB2-C965-4006-9DEC-62FC24A5E1FB}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="OBTENER PRIMERA GESTIÓN"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{3CA246E4-2A50-48E4-8910-61693339737A}"
              SQLTask:SqlStatementSource="WITH CTE(&#xA;G_NUMERO_GUIA,&#xA;SE_PROCESO_PRIMGEST,&#xA;SE_ID_FECHA_PRIMGEST,&#xA;SE_FECHA_PRIMGEST&#xA;)AS(&#xA;SELECT G_NUMERO_GUIA,&#xA;CASE WHEN SE_FECHA_RR &lt;&gt; 'NO DISPONIBLE' THEN 'REPORTADO RECOGIDO'&#xA;WHEN SE_FECHA_EZU &lt;&gt; 'NO DISPONIBLE' THEN 'ENTRADA ZONA URBANA'&#xA;WHEN SE_FECHA_EPS &lt;&gt; 'NO DISPONIBLE' THEN 'ENTRADA PUNTO SERVICIO'&#xA;ELSE 'NO DISPONIBLE' END SE_PROCESO_PRIMGEST,&#xA;CASE WHEN SE_FECHA_RR &lt;&gt; 'NO DISPONIBLE' THEN SE_ID_FECHA_RR&#xA;WHEN SE_FECHA_EZU &lt;&gt; 'NO DISPONIBLE' THEN SE_ID_FECHA_EZU&#xA;WHEN SE_FECHA_EPS &lt;&gt; 'NO DISPONIBLE' THEN SE_ID_FECHA_EPS&#xA;ELSE '1900-01-01' END SE_ID_FECHA_PRIMGEST,&#xA;CASE WHEN SE_FECHA_RR &lt;&gt; 'NO DISPONIBLE' THEN SE_FECHA_RR&#xA;WHEN SE_FECHA_EZU &lt;&gt; 'NO DISPONIBLE' THEN SE_FECHA_EZU&#xA;WHEN SE_FECHA_EPS &lt;&gt; 'NO DISPONIBLE' THEN SE_FECHA_EPS&#xA;ELSE 'NO DISPONIBLE' END SE_FECHA_PRIMGEST&#xA;FROM [TMP].CUMPLIMIENTO_AC_DEP&#xA;)&#xA;&#xA;UPDATE [TMP].CUMPLIMIENTO_AC_DEP&#xA;SET&#xA;&#x9; SE_PROCESO_PRIMGEST = CTE.SE_PROCESO_PRIMGEST&#xA;&#x9;,SE_ID_FECHA_PRIMGEST = CTE.SE_ID_FECHA_PRIMGEST&#xA;&#x9;,SE_FECHA_PRIMGEST = CTE.SE_FECHA_PRIMGEST&#xA;FROM&#xA;&#x9;TMP.CUMPLIMIENTO_AC_DEP TMP, CTE&#xA;WHERE&#xA;&#x9;TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\CALCULO INDICADOR ACIDO Y DEPURADA\OBTENER PROMESA DE RED OPERATIVA"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{7C00F7CF-257A-4D3D-962E-D744023DCA9B}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="OBTENER PROMESA DE RED OPERATIVA"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{3CA246E4-2A50-48E4-8910-61693339737A}"
              SQLTask:SqlStatementSource="&#xA;WITH CTE&#xA;(&#xA;&#x9; G_NUMERO_GUIA&#xA;&#x9;,SE_ID_FECHA_ENTREGA&#xA;&#x9;,SE_ID_DIAS_PROMESA&#xA;)&#xA;AS&#xA;(&#xA;&#x9;SELECT &#xA;&#x9;&#x9; C.G_NUMERO_GUIA&#xA;&#x9;&#x9;,C.SE_FECHA SE_ID_FECHA_ENTREGA&#xA;&#x9;&#x9;,CONVERT(INT,C.TIEMPO_OFERTA_DIA) SE_ID_DIAS_PROMESA&#xA;&#x9;FROM&#xA;&#x9;&#x9;(&#xA;&#x9;&#x9;SELECT &#xA;&#x9; TMP.G_NUMERO_GUIA&#xA;&#x9;,TMP.SE_FECHA&#xA;&#x9;,ISNULL(R.TIEMPO_ENTREGA_COMERCIAL_DIA,0) TIEMPO_OFERTA_DIA   -- segun la dim red operativa &#xA;FROM&#xA;&#x9;TMP.CUMPLIMIENTO_AC_DEP TMP WITH(NOLOCK) &#xA;INNER JOIN&#xA;&#x9;TMP.RED_OPERATIVA_RUTA RA WITH(NOLOCK) &#xA;ON&#xA;&#x9;TMP.G_ID_CIUDAD_ORIGEN = RA.ID_CIUDAD_ORIGEN&#xA;AND&#xA;&#x9;TMP.G_ID_CIUDAD_DESTINO = RA.ID_CIUDAD_DESTINO&#xA;AND&#xA;&#x9;CASE WHEN ISNULL(TMP.G_ID_TIEMPO,0) &lt;&gt; 0 THEN TMP.G_ID_TIEMPO ELSE 1 END = RA.ID_TIEMPO&#xA;AND&#xA;&#x9;CASE WHEN ISNULL(TMP.G_ID_MEDTRANS,0) &lt;&gt; 0 THEN TMP.G_ID_MEDTRANS ELSE 1 END = RA.ID_MEDTRANS&#xA;INNER JOIN&#xA;&#x9;DIM.RED_OPERATIVA_RUTA R WITH(NOLOCK) &#xA;ON&#xA;&#x9;RA.ID_RUTA = R.ID_RUTA&#xA;&#x9;&#x9;) C&#xA;)&#xA;UPDATE [TMP].CUMPLIMIENTO_AC_DEP&#xA;SET&#xA;&#x9;SE_ID_DIAS_PROMESA = CTE.SE_ID_DIAS_PROMESA&#xA;FROM&#xA;&#x9;TMP.CUMPLIMIENTO_AC_DEP TMP&#xA;INNER JOIN CTE&#xA;&#x9;ON &#x9;TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\CALCULO INDICADOR ACIDO Y DEPURADA\OBTENER RESPONSABILIDADES"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:Disabled="True"
          DTS:DTSID="{CCC8E4EF-FC3C-42F9-A2EF-7439742A7194}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="OBTENER RESPONSABILIDADES"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="1">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{3CA246E4-2A50-48E4-8910-61693339737A}"
              SQLTask:SqlStatementSource="TRUNCATE TABLE TMP.NOVEDADES_DEPURADA&#xA;GO&#xA;&#xA;INSERT INTO TMP.NOVEDADES_DEPURADA&#xA;(&#xA;&#x9; [ID_TIPO_NOVEDAD]&#xA;&#x9;,[NOMBRE_TIPO_NOVEDAD]&#xA;&#x9;,[NOMBRE_NOVEDAD]&#xA;&#x9;,[RESP]&#xA;)&#xA;SELECT &#xA;&#x9; [ID_TIPO_NOVEDAD]&#xA;&#x9;,'NOVEDAD OPERATIVA' [NOMBRE_TIPO_NOVEDAD]&#xA;&#x9;,[NOMBRE_TIPO_NOVEDAD] [NOMBRE_NOVEDAD]&#xA;&#x9;,'E' RESP&#xA;FROM &#xA;&#x9;SIG_COLOMBIA_DW.[PAR].[TIPOSNOVEDADESOPERATIVAS] WITH (NOLOCK)&#xA;WHERE&#xA;&#x9;[ID_TIPO_NOVEDAD]&#xA;IN&#xA;(&#xA;&#x9; 1&#x9;&#x9;-- NOVEDAD OPERATIVA - CIERRE DE AEROPUERTO&#xA;&#x9;,2&#x9;&#x9;-- NOVEDAD OPERATIVA - CIERRE DE AEROPUERTO DESTINO&#xA;&#x9;,6&#x9;&#x9;-- NOVEDAD OPERATIVA - RETENCION DEL VEHICULO&#xA;&#x9;,7&#x9;&#x9;-- NOVEDAD OPERATIVA - ACCIDENTE EN LA VIA&#xA;&#x9;,8&#x9;&#x9;-- NOVEDAD OPERATIVA - NOVEDAD POR ORDEN PUBLICO&#xA;&#x9;,9&#x9;&#x9;-- NOVEDAD OPERATIVA - NOVEDADES EN LA VIA DE CONOCIMIENTO PUBLICO&#xA;&#x9;,10&#x9;&#x9;-- NOVEDAD OPERATIVA - CONGESTION EN VIAS DE ACCESO&#xA;&#x9;,11&#x9;&#x9;-- NOVEDAD OPERATIVA - NOVEDADES EN AEROPUERTOS&#xA;&#x9;,12&#x9;&#x9;-- NOVEDAD OPERATIVA - NOVEDADES ATRIBUIBLES A LA NATURALEZA&#xA;&#x9;,13&#x9;&#x9;-- NOVEDAD OPERATIVA - HURTO A CONDUCTOR &#xA;&#x9;,15&#x9;&#x9;-- NOVEDAD OPERATIVA - INSPECCION DE AUTORIDADES EN CARRETERA&#xA;&#x9;,16&#x9;&#x9;-- NOVEDAD OPERATIVA - DERRUMBE EN LA VIA&#xA;&#x9;,18&#x9;&#x9;-- NOVEDAD OPERATIVA - CANCELACION DEL VUELO&#xA;&#x9;,21&#x9;&#x9;-- NOVEDAD OPERATIVA - OPERATIVO LLEGA TARDE POR RESTRINCION&#xA;&#x9;,24&#x9;&#x9;-- NOVEDAD OPERATIVA - SINIESTRO HURTO DE VEHICULO MERCANCIA&#xA;)&#xA;GO&#xA;&#xA;INSERT INTO TMP.NOVEDADES_DEPURADA&#xA;&#xA;(&#xA;&#x9; [ID_TIPO_NOVEDAD]&#xA;&#x9;,[NOMBRE_TIPO_NOVEDAD]&#xA;&#x9;,[NOMBRE_NOVEDAD]&#xA;&#x9;,[RESP]&#xA;)&#xA;SELECT &#xA;&#x9; [ID_TIPO_NOVEDAD]&#xA;&#x9;,'NOVEDAD OPERATIVA' [NOMBRE_TIPO_NOVEDAD]&#xA;&#x9;,[NOMBRE_TIPO_NOVEDAD] [NOMBRE_NOVEDAD]&#xA;&#x9;,'S' RESP&#xA;FROM &#xA;&#x9;SIG_COLOMBIA_DW.[PAR].[TIPOSNOVEDADESOPERATIVAS] WITH (NOLOCK)&#xA;WHERE&#xA;&#x9;[ID_TIPO_NOVEDAD]&#xA;IN&#xA;(&#xA;&#x9; 3&#x9;&#x9;-- NOVEDAD OPERATIVA - RETRAZO EN SALIDA A ZONA URBANA&#xA;&#x9;,4&#x9;&#x9;-- NOVEDAD OPERATIVA - RETRAZO EN SALIDA A REGIONAL&#xA;&#x9;,5&#x9;&#x9;-- NOVEDAD OPERATIVA - FALLA MECANICA&#xA;&#x9;,14&#x9;&#x9;-- NOVEDAD OPERATIVA - FALTA DE CUPO&#xA;&#x9;,17&#x9;&#x9;-- NOVEDAD OPERATIVA - SUSPENSION DE SERVICIO&#xA;&#x9;,19&#x9;&#x9;-- NOVEDAD OPERATIVA - ENVIOS RECUPERADOS&#xA;&#x9;,20&#x9;&#x9;-- NOVEDAD OPERATIVA - INCONVENIENTES EN ASIGNACION DE ZONA&#xA;&#x9;,22&#x9;&#x9;-- NOVEDAD OPERATIVA - NORMAL FIN DE SEMANA&#xA;&#x9;,23&#x9;&#x9;-- NOVEDAD OPERATIVA - NOVEDAD DEL TRANSPORTADOR&#xA;&#x9;,25&#x9;&#x9;-- NOVEDAD OPERATIVA - INFORMACION TRAYECTOS ESPECIALES&#xA;&#x9;,26&#x9;&#x9;-- NOVEDAD OPERATIVA - TRANSBORDO AEROPUERTOS&#xA;&#x9;,27&#x9;&#x9;-- NOVEDAD OPERATIVA - NOVEDADES LOGISTICAS&#xA;&#x9;,28&#x9;&#x9;-- NOVEDAD OPERATIVA - NEUMATICO PINCHADO&#xA;&#x9;,29&#x9;&#x9;-- NOVEDAD OPERATIVA - PROTOCOLOS DE SEGURIDAD&#xA;&#x9;,30&#x9;&#x9;-- NOVEDAD OPERATIVA - VOLANTE&#xA;)" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
