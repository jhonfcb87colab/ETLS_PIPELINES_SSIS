            <SQLTask:SqlTaskData
              SQLTask:Connection="{3CA246E4-2A50-48E4-8910-61693339737A}"
              SQLTask:SqlStatementSource="UPDATE [TMP].[CUMPLIMIENTO_AC_DEP]&#xA;SET &#xA;&#x9;SE_ID_FECHA_PRIMGEST_DH = (SELECT TOP 1 FECHA FROM [TMP].[CUMPLIMIENTO_AC_DEP_DH] WITH(NOLOCK)  WHERE FECHA &gt;= CONVERT(DATE,SE_ID_FECHA_PRIMGEST)),&#xA;&#x9;SE_FECHA_PRIMGEST_DH = CONVERT(varchar(50),(SELECT TOP 1 FECHA FROM [TMP].[CUMPLIMIENTO_AC_DEP_DH] WITH(NOLOCK)  WHERE FECHA &gt;= CONVERT(DATE,SE_ID_FECHA_PRIMGEST)))&#xA;FROM &#xA;&#x9;[TMP].[CUMPLIMIENTO_AC_DEP] WITH(NOLOCK)" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
