                </component>
                <component
                  refId="Package\CALCULO INDICADOR ACIDO Y DEPURADA\INSERT GUIAS TIEMPO ENTREGA NORMAL\OLE DB Source"
                  componentClassID="Microsoft.OLEDBSource"
                  contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                  description="OLE DB Source"
                  name="OLE DB Source"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=15.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">WITH PROMESA AS (
	SELECT 
		 NUMERO_GUIA AS G_NUMERO_GUIA
		,0 AS SE_ID_FECHA
		,'1900-01-01' AS SE_FECHA
		,ISNULL(ID_CIUDAD_ORIGEN,-888) AS  G_ID_CIUDAD_ORIGEN
		,ISNULL(ID_CIUDAD_DESTINO,-888) AS G_ID_CIUDAD_DESTINO
		,ISNULL(ID_CLIENTE,-888) AS G_ID_CLIENTE
		,ISNULL(CONVERT(INT,ID_TIEMPO_ENTREGA),-888) AS G_ID_TIEMPO
		,ISNULL(CONVERT(INT,ID_MEDTRANS),-888) AS G_ID_MEDTRANS
		,0 AS G_ID_HABIL_SABADO
		,GR_ID_TIPO_COBRO
	FROM 
		SIG_COL_LOGISTICA_DW.TMP.PROMESA_V2 T WITH (NOLOCK)
		WHERE ID_TIEMPO_ENTREGA = 1
)

SELECT 
	 GUIAS.G_NUMERO_GUIA
	,GUIAS.SE_ID_FECHA
	,GUIAS.SE_FECHA
	,GUIAS.G_ID_CIUDAD_ORIGEN
	,GUIAS.G_ID_CIUDAD_DESTINO
	,GUIAS.G_ID_CLIENTE
	,GUIAS.G_ID_TIEMPO
	,GUIAS.G_ID_MEDTRANS
	,GUIAS.G_ID_HABIL_SABADO
	,GUIAS.GR_ID_TIPO_COBRO
	,ISNULL(RED.ID_RUTA,0) AS ID_RUTA
	,RED2.TIEMPO_ENTREGA_COMERCIAL_HOR AS TIEMPO_OFERTA
	, CASE WHEN ISNULL(RED.ID_RUTA,0) = 0 THEN 0  
				WHEN RED2.TIEMPO_ENTREGA_COMERCIAL_HOR BETWEEN 0 AND 36 THEN 1 
				WHEN RED2.TIEMPO_ENTREGA_COMERCIAL_HOR BETWEEN 37 AND 60 THEN 2
				WHEN RED2.TIEMPO_ENTREGA_COMERCIAL_HOR BETWEEN 61 AND 84 THEN 3
				WHEN RED2.TIEMPO_ENTREGA_COMERCIAL_HOR BETWEEN 85 AND 108 THEN 4
				ELSE 5 END 		
	  AS ID_GRUPO_RED
	,C.TIEMPO_PROMESA_H
	,C.TIEMPO_PROMESA_CUMPLE_H
FROM PROMESA AS GUIAS 
INNER JOIN  TMP.RED_OPERATIVA_RUTA_V2 RED
	ON	GUIAS.G_ID_CIUDAD_ORIGEN = RED.ID_CIUDAD_ORIGEN
	AND	GUIAS.G_ID_CIUDAD_DESTINO = RED.ID_CIUDAD_DESTINO
	AND	GUIAS.G_ID_TIEMPO = RED.ID_TIEMPO
	AND GUIAS.G_ID_MEDTRANS = RED.ID_MEDTRANS
INNER JOIN  DIM.RED_OPERATIVA_RUTA RED2
	ON  ISNULL(RED.ID_RUTA,0) = RED2.ID_RUTA
/* SE CRUZA CON LA TEMPORAL DEL CUBO ANTIGUO PARA TRER DATOS QUE YA FUERON PROCESADOS 
POR TIEMPO PROMESA */
INNER JOIN TMP.GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA AS C WITH(NOLOCK)
	ON C.NUMERO_GUIA = GUIAS.G_NUMERO_GUIA</property>
                    <property
