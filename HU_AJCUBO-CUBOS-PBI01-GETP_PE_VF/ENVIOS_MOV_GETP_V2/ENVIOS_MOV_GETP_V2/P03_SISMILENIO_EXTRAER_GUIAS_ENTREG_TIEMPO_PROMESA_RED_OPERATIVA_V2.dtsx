          DTS:DTSID="{3A445AFA-3FE7-47FE-9393-D4EA27D65842}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="ACTUALIZAR FECHA ENVIO"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{3CA246E4-2A50-48E4-8910-61693339737A}"
              SQLTask:SqlStatementSource="UPDATE A    &#xA;  SET A.FECHA_VIGENTE = RA.FECHA_VIGENTE&#xA;FROM [TMP].[PROMESA_V2] A&#xA;  INNER JOIN [TMP].[PROMESA_FECHA_V2] RA&#xA;    ON CONVERT(DATETIME,CONVERT(DATE,A.FECHA)) = RA.FECHA_ENVIO WHERE A.ID_TIEMPO_ENTREGA = 3" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\EXTRACCION PROMESA\INSERT MODALIDAD_PAGO_TMP_PROMESA"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{5F32E39A-C1DE-4741-A4AA-CA2792335EEF}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="INSERT MODALIDAD_PAGO_TMP_PROMESA"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{CDFD96D0-6B78-4FCE-A0AC-49DA8F0B8B90}"
              SQLTask:SqlStatementSource="WITH CTE&#xA;(&#xA;&#x9; NUMERO_GUIA&#xA;&#x9;,ID_TIPO_COBRO&#xA;)&#xA;AS&#xA;&#x9;(&#xA;&#x9;&#x9;SELECT&#xA;&#x9;&#x9;&#x9; PR.NUMERO_GUIA&#xA;&#x9;&#x9;&#x9;,GR.ID_TIPO_COBRO&#xA;&#x9;&#x9;FROM &#xA;&#x9;&#x9;&#x9;TMP.PROMESA_V2 PR  WITH (NOLOCK)&#xA;&#x9;&#x9;INNER JOIN &#xA;&#x9;&#x9;&#x9;LOG.GUIA_RECAUDO GR WITH (NOLOCK)&#xA;&#x9;&#x9;ON&#xA;&#x9;&#x9;&#x9;PR.NUMERO_GUIA = GR.NUMERO_GUIA&#xA;&#x9;)&#xA;&#xA;UPDATE PR&#xA;SET &#xA;&#x9;GR_ID_TIPO_COBRO =  CASE WHEN CTE.ID_TIPO_COBRO = 1 THEN 1 ELSE 2 END&#xA;FROM &#xA;&#x9; [TMP].[PROMESA_V2] PR WITH (NOLOCK)  &#xA;INNER JOIN &#x9;CTE&#xA;&#x9;ON  PR.NUMERO_GUIA = CTE.NUMERO_GUIA" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\EXTRACCION PROMESA\INSERT TMP PROMESA_1 (fecha min del proceso 5 o 6)"
