                        <outputColumn
                          refId="Package\Repoblamiento Importar guias con Pruebas entrega PE tipo prueba entrega\Transporte TMP GETP guias pruebas entrega\TMP  GETP_GUIAS_PRUEBA_ENTREGA.Outputs[OLE DB Destination Error Output].Columns[ErrorColumn]"
                          dataType="i4"
                          lineageId="Package\Repoblamiento Importar guias con Pruebas entrega PE tipo prueba entrega\Transporte TMP GETP guias pruebas entrega\TMP  GETP_GUIAS_PRUEBA_ENTREGA.Outputs[OLE DB Destination Error Output].Columns[ErrorColumn]"
                          name="ErrorColumn"
