    <DTS:Executable
      DTS:refId="Package\DESARROLLO"
      DTS:CreationName="STOCK:SEQUENCE"
      DTS:Description="Sequence Container"
      DTS:DTSID="{7A274BE3-1B4B-42BC-A9E7-8751EDB6518C}"
      DTS:ExecutableType="STOCK:SEQUENCE"
      DTS:LocaleID="-1"
      DTS:ObjectName="DESARROLLO">
      <DTS:Variables />
      <DTS:Executables>
        <DTS:Executable
          DTS:refId="Package\DESARROLLO\CARGA INCREMENTAL TABLA FAC  GUIAS ENTR RED OP V2"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{C2282703-0C29-4DFB-AEA2-F2BB801C5662}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="CARGA INCREMENTAL TABLA FAC  GUIAS ENTR RED OP V2"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{3CA246E4-2A50-48E4-8910-61693339737A}"
              SQLTask:SqlStatementSource="&#xA;DELETE FAC&#xA;FROM [TMP].[DEV_GETP_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2] T &#xA;INNER JOIN [FAC].[DEV_GETP_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2] FAC&#xA;ON FAC.NUMERO_GUIA=T.NUMERO_GUIA;&#xA;&#xA;INSERT INTO [FAC].[DEV_GETP_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2]&#xA;(&#xA;&#x9;TIME_ID&#xA;&#x9;,FECHA&#xA;&#x9;,DIA&#xA;&#x9;,MES&#xA;&#x9;,AÑO&#xA;&#x9;,ID_CIUDAD_ORIGEN&#xA;&#x9;,ID_CIUDAD_DESTINO&#xA;&#x9;,ID_CLIENTE&#xA;&#x9;,ID_ESTADOENVIO&#xA;&#x9;,ID_PRODUCTO&#xA;&#x9;,ID_SUBPRODUCTO&#xA;&#x9;,ID_PROD_SUBP&#xA;&#x9;,ID_TIEMPO_ENTREGA&#xA;&#x9;,NUMERO_GUIA&#xA;&#x9;,ID_RUTA&#xA;&#x9;,ID_GRUPO_RED&#xA;&#x9;,TIEMPO_PROMESA_H&#xA;&#x9;,TIEMPO_OFERTA&#xA;&#x9;,TIEMPO_PROMESA_CUMPLE_H&#xA;&#x9;,ID_GEOGRAFIA_CONCEPTO&#xA;&#x9;,HORAS_ND&#xA;&#x9;,ID_ESTADO_ND&#xA;&#x9;,GR_ID_TIPO_COBRO&#xA;&#x9;,SE_PROMESA_CUMPLE_ACIDA&#xA;&#x9;,SE_PROMESA_CUMPLE_DEPURADA&#xA;&#x9;,SE_RESPONSABLE_ID&#xA;&#x9;,ID_TIPO_ENTREGA&#xA;)&#xA;  SELECT &#xA;&#x9;&#x9; T.TIME_ID&#xA;&#x9;&#x9;,T.FECHA&#xA;&#x9;&#x9;,T.DIA&#xA;&#x9;&#x9;,T.MES&#xA;&#x9;&#x9;,T.AÑO&#xA;&#x9;&#x9;,T.ID_CIUDAD_ORIGEN&#xA;&#x9;&#x9;,T.ID_CIUDAD_DESTINO&#xA;&#x9;&#x9;,T.ID_CLIENTE&#xA;&#x9;&#x9;,T.ID_ESTADOENVIO&#xA;&#x9;&#x9;,T.ID_PRODUCTO&#xA;&#x9;&#x9;,T.ID_SUBPRODUCTO&#xA;        ,CONVERT(VARCHAR(6),right('00' + convert(varchar,ID_PRODUCTO),2) + right( '0000' +  convert(varchar, ID_SUBPRODUCTO),4)) ID_PROD_SUBP&#xA;&#x9;&#x9;,T.ID_TIEMPO_ENTREGA&#xA;&#x9;&#x9;,T.NUMERO_GUIA&#xA;&#x9;&#x9;,T.ID_RUTA&#xA;&#x9;&#x9;,ISNULL(T.ID_GRUPO_RED, -888) AS ID_GRUPO_RED&#xA;&#x9;&#x9;,ISNULL(T.TIEMPO_PROMESA_H, 0) AS TIEMPO_PROMESA_H&#xA;&#x9;&#x9;,ISNULL(T.TIEMPO_OFERTA, 0) AS TIEMPO_OFERTA&#xA;&#x9;&#x9;,ISNULL(T.TIEMPO_PROMESA_CUMPLE_H,'NO') AS TIEMPO_PROMESA_CUMPLE_H&#xA;&#x9;&#x9;,CONVERT(VARCHAR,G.ID_REGIONAL) +'-'+ CONVERT(VARCHAR,T.ID_CONCEPTO) ID_GEOGRAFIA_CONCEPTO &#xA;        ,T.HORAS_ND &#xA;&#x9;&#x9;,T.ID_ESTADO_ND&#xA;&#x9;&#x9;,ISNULL(T.GR_ID_TIPO_COBRO, -888) AS GR_ID_TIPO_COBRO&#xA;&#x9;&#x9;,CONVERT(VARCHAR(2), IIF(T.SE_PROMESA_CUMPLE_ACIDA = 'NO DISPONIBLE', 'NO', ISNULL(T.SE_PROMESA_CUMPLE_ACIDA,'NO') )  ) AS SE_PROMESA_CUMPLE_ACIDA&#xA;&#x9;&#x9;,CONVERT(VARCHAR(2), IIF(T.SE_PROMESA_CUMPLE_DEPURADA = 'NO DISPONIBLE', 'NO', ISNULL(T.SE_PROMESA_CUMPLE_DEPURADA, 'NO'))   ) AS SE_PROMESA_CUMPLE_DEPURADA&#xA;&#x9;&#x9;,SE_RESPONSABLE_ID&#xA;&#x9;&#x9;,ID_TIPO_ENTREGA = ISNULL(T.ID_TIPO_ENTREGA,-1)&#xA;&#x9;FROM [TMP].[DEV_GETP_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2] T &#xA; LEFT JOIN&#xA;&#x9;&#x9;&#x9;SIG_COLOMBIA_DW.DIM.GEOGRAFIA G&#xA;ON&#xA;&#x9;T.ID_CIUDAD_DESTINO = G.ID_CIUDAD&#xA;&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
      </DTS:Executables>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\EXTRACCION PROMESA"
