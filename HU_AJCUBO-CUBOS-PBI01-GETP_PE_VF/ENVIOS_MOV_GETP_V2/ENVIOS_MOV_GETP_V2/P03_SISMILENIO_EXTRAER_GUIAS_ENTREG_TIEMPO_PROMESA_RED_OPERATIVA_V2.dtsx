          DTS:Description="Execute SQL Task"
          DTS:DTSID="{E1AC26A5-3917-41D4-8417-C6C4FC652F36}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="DIA HABIL FECHA DE ENTREGA PROMESA"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{3CA246E4-2A50-48E4-8910-61693339737A}"
              SQLTask:SqlStatementSource="UPDATE [TMP].[CUMPLIMIENTO_AC_DEP] &#xA;SET &#xA;&#x9;SE_ID_FECHA_PROMESA_ENTREGA_DH = &#xA;&#x9;ISNULL( &#xA;&#x9;&#x9;&#x9;(SELECT TOP 1 FECHA FROM [TMP].[CUMPLIMIENTO_AC_DEP_DH] WITH(NOLOCK)  WHERE FECHA &gt;= CONVERT(DATE,SE_ID_FECHA_PROMESA_ENTREGA))&#xA;&#x9;, CONVERT(DATE, '1900-01-01') )&#xA;FROM &#xA;&#x9;[TMP].[CUMPLIMIENTO_AC_DEP] WITH(NOLOCK)&#xA;&#xA;GO &#xA;&#xA;UPDATE [TMP].[CUMPLIMIENTO_AC_DEP] &#xA;SET &#xA;&#x9;SE_ID_FECHA_PROMESA_ENTREGA_DH = DATEADD(SECOND,-1,DATEADD(DAY,1,SE_ID_FECHA_PROMESA_ENTREGA_DH)),&#xA;&#x9;SE_FECHA_PROMESA_ENTREGA_DH = CONVERT(VARCHAR(50),DATEADD(SECOND,-1,DATEADD(DAY,1,SE_ID_FECHA_PROMESA_ENTREGA_DH)))&#xA;FROM &#xA;&#x9;[TMP].[CUMPLIMIENTO_AC_DEP] WITH(NOLOCK)&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
