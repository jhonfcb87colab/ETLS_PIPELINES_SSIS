      <DTS:Executables>
        <DTS:Executable
          DTS:refId="Package\CALCULO INDICADOR ACIDO Y DEPURADA\ACTUALIZAR MOVIMIENTOS"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{CF44C8A5-97A4-4372-8ACD-460138AF12C0}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="ACTUALIZAR MOVIMIENTOS"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{3CA246E4-2A50-48E4-8910-61693339737A}"
              SQLTask:SqlStatementSource="WITH CTE(&#xA;NUMERO_GUIA,&#xA;[SE_ID_FECHA_EZU],&#xA;[SE_FECHA_EZU],&#xA;[SE_ID_FECHA_RR],&#xA;[SE_FECHA_RR],&#xA;[SE_ID_FECHA_EPS],&#xA;[SE_FECHA_EPS],&#xA;[SE_ID_FECHA_RE],&#xA;[SE_FECHA_RE],&#xA;[SE_ID_FECHA_EV],&#xA;[SE_FECHA_EV]&#xA;)AS(&#xA;SELECT &#xA;&#x9;&#x9;NUMERO_GUIA&#xA;&#x9;&#x9;,ISNULL(MIN(CASE WHEN ID_PROCESO = 6 THEN FECHA_HORA_MOVIMIENTO ELSE NULL END ),'1900-01-01') SE_ID_FECHA_EZU&#xA;&#x9;&#x9;,ISNULL(CONVERT(VARCHAR,MIN(CASE WHEN ID_PROCESO = 6 THEN FECHA_HORA_MOVIMIENTO ELSE NULL END ),111),'NO DISPONIBLE') SE_FECHA_EZU&#xA;&#xA;&#x9;&#x9;,ISNULL(MIN(CASE WHEN ID_PROCESO = 28 THEN FECHA_HORA_MOVIMIENTO ELSE NULL END ),'1900-01-01') SE_ID_FECHA_RR&#xA;&#x9;&#x9;,ISNULL(CONVERT(VARCHAR,MIN(CASE WHEN ID_PROCESO = 28 THEN FECHA_HORA_MOVIMIENTO ELSE NULL END ),111),'NO DISPONIBLE') SE_FECHA_RR&#xA;&#xA;&#x9;&#x9;,ISNULL(MIN(CASE WHEN ID_PROCESO = 5 THEN FECHA_HORA_MOVIMIENTO ELSE NULL END ),'1900-01-01') SE_ID_FECHA_EPS&#xA;&#x9;&#x9;,ISNULL(CONVERT(VARCHAR,MIN(CASE WHEN ID_PROCESO = 5 THEN FECHA_HORA_MOVIMIENTO ELSE NULL END ),111),'NO DISPONIBLE') SE_FECHA_EPS&#xA;&#xA;&#x9;&#x9;,ISNULL(MIN(CASE WHEN ID_PROCESO = 24 THEN FECHA_HORA_MOVIMIENTO ELSE NULL END ),'1900-01-01') SE_ID_FECHA_RE&#xA;&#x9;&#x9;,ISNULL(CONVERT(VARCHAR,MIN(CASE WHEN ID_PROCESO = 24 THEN FECHA_HORA_MOVIMIENTO ELSE NULL END ),111),'NO DISPONIBLE') SE_FECHA_RE&#xA;&#xA;&#x9;&#x9;,ISNULL(MIN(CASE WHEN ID_PROCESO = 11 THEN FECHA_HORA_MOVIMIENTO ELSE NULL END ),'1900-01-01') SE_ID_FECHA_EV&#xA;&#x9;&#x9;,ISNULL(CONVERT(VARCHAR,MIN(CASE WHEN ID_PROCESO = 11 THEN FECHA_HORA_MOVIMIENTO ELSE NULL END ),111),'NO DISPONIBLE') SE_FECHA_EV&#xA;FROM &#xA;&#x9;--SIG_COLOMBIA_DW.LOG.SEGUIMIENTO_ENVIO WITH(NOLOCK)&#xA;&#x9;TMP.CUMPLIMIENTO_AC_DEP_01 WITH(NOLOCK)&#xA;INNER JOIN &#xA;&#x9;[TMP].[CUMPLIMIENTO_AC_DEP] WITH(NOLOCK) &#xA;ON &#xA;&#x9;NUMERO_GUIA = G_NUMERO_GUIA&#xA;GROUP BY NUMERO_GUIA&#xA;)&#xA;&#xA;UPDATE [TMP].[CUMPLIMIENTO_AC_DEP]&#xA;&#x9;SET [SE_ID_FECHA_EZU] = CTE.[SE_ID_FECHA_EZU],&#xA;&#x9;&#x9;[SE_FECHA_EZU] = CTE.[SE_FECHA_EZU],&#xA;&#x9;&#x9;[SE_ID_FECHA_RR] = CTE.[SE_ID_FECHA_RR],&#xA;&#x9;&#x9;[SE_FECHA_RR] = CTE.[SE_FECHA_RR],&#xA;&#x9;&#x9;[SE_ID_FECHA_EPS] = CTE.[SE_ID_FECHA_EPS],&#xA;&#x9;&#x9;[SE_FECHA_EPS] = CTE.[SE_FECHA_EPS],&#xA;&#x9;&#x9;[SE_ID_FECHA_RE] = CTE.[SE_ID_FECHA_RE],&#xA;&#x9;&#x9;[SE_FECHA_RE] = CTE.[SE_FECHA_RE],&#xA;&#x9;&#x9;[SE_ID_FECHA_EV] = CTE.[SE_ID_FECHA_EV],&#xA;&#x9;&#x9;[SE_FECHA_EV] = CTE.[SE_FECHA_EV]&#xA;FROM &#xA;&#x9;[TMP].[CUMPLIMIENTO_AC_DEP] WITH(NOLOCK)&#xA;INNER JOIN CTE&#xA;&#x9;ON CTE.NUMERO_GUIA = G_NUMERO_GUIA" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\CALCULO INDICADOR ACIDO Y DEPURADA\CALCULAR CUMPLIMIENTO DEPURADA"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
