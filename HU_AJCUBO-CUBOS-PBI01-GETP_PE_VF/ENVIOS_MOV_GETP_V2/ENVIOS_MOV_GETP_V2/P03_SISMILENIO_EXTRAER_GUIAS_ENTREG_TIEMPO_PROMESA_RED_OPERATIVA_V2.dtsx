                <component
                  refId="Package\NOVEDAD DIARIA\CARGAR PROMESA_NDBASE\OLE DB Source"
                  componentClassID="Microsoft.OLEDBSource"
                  contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                  description="OLE DB Source"
                  name="OLE DB Source"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=15.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT
	 DOCND.[ID_PROCESO]
	,DOCND.[NUMERO_MOVIMI]
	,DOCND.[CONSECUT_MOVIMI]
	,DETND.[ID_PAIS_UNO]
	,DETND.[ID_CIUDAD_UNO]
	,DETND.[ID_PAIS_DOS]
	,DETND.[ID_CIUDAD_DOS]
	,DETND.[ID_SUBTIPO_NOVEDAD]
	,DETND.[ID_COURIER_CONDUCTOR]
	,DETND.[PLACA_VEHICULO_DOCU]
	,DETND.[UBICACION]
	,ND.[ID_TIPO_NOVEDAD]
	,DETND.[FECHA_NOVEDAD]
	,DETND.[FECHA_HORA_ENTRADA_CIL]
	,DETND.[FECHA_HORA_FIN_NOVEDAD]
FROM [LOG].[DETALLE_NOVEDAD_DIARIA] DETND WITH(NOLOCK)
INNER JOIN [LOG].[DOCUMENTOS_NOVEDAD_DIARIA] DOCND WITH(NOLOCK)
	ON  DETND.[ID_PAIS_UNO] = DOCND.[ID_PAIS_UNO]
	AND DETND.ID_CIUDAD_UNO = DOCND.ID_CIUDAD_UNO
INNER JOIN [LOG].[NOVEDAD_DIARIA] ND WITH(NOLOCK)
	ON  DETND.[ID_PAIS_UNO] = ND.[ID_PAIS_UNO]
	AND DETND.ID_CIUDAD_UNO = ND.ID_CIUDAD_UNO
INNER JOIN [PAR].[TIPOSNOVEDADESOPERATIVAS] TNO
	ON ND.[ID_TIPO_NOVEDAD] = TNO.ID_TIPO_NOVEDAD
WHERE  TNO.ES_NOVEDAD_EXTERNA  = 1
	AND DETND.[FECHA_NOVEDAD] = DOCND.[FECHA_NOVEDAD]
	AND DETND.[FECHA_NOVEDAD] = ND.[FECHA_NOVEDAD]
	AND DETND.[FECHA_NOVEDAD] &gt;= ? AND DETND.[FECHA_NOVEDAD] &lt; ?
	AND DETND.[FECHA_HORA_ENTRADA_CIL] IS NOT NULL</property>
                    <property
