        <DTS:Executable
          DTS:refId="Package\EXTRACCION PROMESA\OBTENER FECHA VIGENTE"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{EEC44552-C679-40C7-9098-2A488E42EC3C}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="OBTENER FECHA VIGENTE"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{3CA246E4-2A50-48E4-8910-61693339737A}"
              SQLTask:SqlStatementSource="DECLARE @fecha datetime&#xA;DECLARE @fecha2 datetime&#xA;DECLARE @estado VARCHAR (5)&#xA;SET @estado = 'SI'&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#x9;-- Declara el cursor y reemplaza los valores de los parámetros&#xA;&#x9;DECLARE SQL_CURSOR CURSOR FOR   &#x9;&#xA;&#x9;SELECT  FECHA_ENVIO   FROM [TMP].[PROMESA_FECHA_V2] T WITH (NOLOCK)&#xA;&#xA;&#x9;OPEN SQL_CURSOR  &#xA;&#xA;&#x9;FETCH NEXT FROM SQL_CURSOR   &#xA;&#x9;INTO @fecha&#xA;&#xA;&#x9;WHILE @@FETCH_STATUS = 0  &#xA;&#x9;BEGIN  &#xA;&#x9;&#xA;&#x9;--SELECT @fecha&#xA;&#xA;SET @estado = 'SI'&#xA;SET @fecha2 =  @fecha&#x9;&#xA;WHILE  @estado = 'SI' &#xA;&#xA;&#x9;&#x9;BEGIN&#xA;&#x9;&#x9;    SET @fecha =  DATEADD(DAY,1,CONVERT(DATETIME,CONVERT(DATE,@fecha)))&#x9;&#x9;&#x9;&#x9;&#x9;&#xA;&#x9;&#x9;&#x9;IF DATEPART(DW,@fecha) = 1 /* 1 = DOMINGO */&#xA;&#x9;&#x9;    &#x9; SET @estado = 'SI' &#x9;&#x9;&#x9;&#x9; &#xA;&#x9;&#x9;&#x9;ELSE &#xA;&#x9;&#x9;BEGIN&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#xA;&#x9;&#x9;&#x9;IF EXISTS (SELECT * FROM  DIM.TIEMPO_FESTIVOS_NACIONALES WHERE FECHA_FESTIVA  = @fecha)&#x9;&#x9;&#x9;&#xA;&#x9;&#x9;    &#x9; SET @estado = 'SI' &#x9;&#x9;&#x9;&#x9; &#xA;&#x9;&#x9;&#x9;ELSE &#xA;&#x9;&#x9;&#x9;&#x9;SET @estado = 'NO' &#x9;&#x9;&#x9;&#x9; &#x9;&#xA;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9; &#xA;&#xA;END&#xA;END&#xA;&#xA;&#xA;&#xA;UPDATE [TMP].[PROMESA_FECHA_V2] SET FECHA_VIGENTE = DATEADD(HOUR,9,@fecha) WHERE FECHA_ENVIO = @fecha2&#xA;&#xA;&#xA;FETCH NEXT FROM SQL_CURSOR   &#xA;&#x9;INTO @fecha&#xA;&#xA;&#xA;&#x9;&#xA;&#x9;&#xA;END&#xA;&#x9;&#x9;&#xA;&#xA;CLOSE SQL_CURSOR&#xA;DEALLOCATE SQL_CURSOR" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
