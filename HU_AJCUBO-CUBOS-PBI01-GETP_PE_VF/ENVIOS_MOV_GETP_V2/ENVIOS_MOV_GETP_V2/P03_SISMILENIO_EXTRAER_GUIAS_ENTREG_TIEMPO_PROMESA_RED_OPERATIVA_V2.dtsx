  <DTS:Variables>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{D897EDAE-21CF-4FE5-91E8-DB840CC251B4}"
      DTS:IncludeInDebugDump="6789"
      DTS:Namespace="User"
      DTS:ObjectName="Dias_Ant">
      <DTS:VariableValue
        DTS:DataType="3">11</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{5EE51236-6E66-4175-8A8F-D6E2886971C4}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="(DT_DATE) @[$Project::FULL_FACH_FIN] == (DT_DATE) &quot;1900-01-01&quot;?&#xA; &#xA;(DT_DATE) ((DT_WSTR,4)YEAR(DATEADD(&quot;DD&quot;, 1 ,GETDATE()))+&quot;-&quot;+RIGHT(&quot;0&quot;+(DT_WSTR,2)MONTH(DATEADD(&quot;DD&quot;,1,GETDATE())),2)+&quot;-&quot;+RIGHT(&quot;0&quot;+(DT_WSTR,2)DAY(DATEADD(&quot;DD&quot;,1,GETDATE())),2))&#xA;&#xA;: (DT_DATE) @[$Project::FULL_FACH_FIN]"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="FechaFin">
      <DTS:VariableValue
        DTS:DataType="7">10/10/2026</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{BAB2091C-13D4-4AD3-9458-B0CA12B78BA0}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="(DT_DATE)   @[$Project::FULL_FACH_INI]    == (DT_DATE) &quot;1900-01-01&quot;? &#xA;&#xA;(DT_DATE)((DT_WSTR,4)YEAR(DATEADD(&quot;DD&quot;, - @[$Project::DiaIni], GETDATE()))+&quot;-&quot;&#xA;+RIGHT(&quot;0&quot;+(DT_WSTR,2)MONTH(DATEADD(&quot;DD&quot;,-@[$Project::DiaIni],GETDATE() )),2)+&quot;-&quot;&#xA;+RIGHT(&quot;0&quot;+(DT_WSTR,2)DAY(DATEADD(&quot;DD&quot;, -@[$Project::DiaIni],GETDATE() )),2))&#xA;&#xA;: (DT_DATE) @[$Project::FULL_FACH_INI]"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="FechaIni">
      <DTS:VariableValue
        DTS:DataType="7">10/1/2026</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{F83403B7-7518-43AF-B1E4-3E1F6BDE6FC8}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="(DT_WSTR, 10)&#xA;( &#xA;(&#xA; (  (  YEAR( @[User::FechaFin] )*100 )  +&#xA;  (  MONTH( @[User::FechaFin] )  )&#xA; )*100&#xA;&#x9;)+ DAY( @[User::FechaFin] )&#xA;)"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="STR_FechaFin">
      <DTS:VariableValue
        DTS:DataType="8">20261010</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{496C2F2F-F6C6-4EC1-B2BB-25C844FE0A99}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="(DT_WSTR, 10)&#xA;( &#xA;(&#xA; (&#xA; ( YEAR( @[User::FechaIni]  )*100 ) + (  MONTH( @[User::FechaIni] )  ) )*100&#xA; )+ DAY( @[User::FechaIni] )&#xA;)"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="STR_FechaIni">
      <DTS:VariableValue
        DTS:DataType="8">20261001</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{C7E2AE83-AD44-497D-9EE0-3486529CFAD7}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot; DECLARE @FECHA_INICIO DATETIME  = CONVERT(VARCHAR,CONVERT(DATETIME,CONVERT(CHAR(11), '&quot;+  @[User::STR_FechaIni]      +&quot;'  )),120);&#xA; DECLARE @FECHA_FIN&#x9;  DATETIME  = CONVERT(VARCHAR,CONVERT(DATETIME,CONVERT(CHAR(11), '&quot;+  @[User::STR_FechaFin]     +&quot;' )),120);&#xA;&#xA;&#xA;/* habilitar para paso a produccion */&#xA;&#xA;;WITH CTE&#xA;(&#xA;&#x9;&#x9; NUMERO_GUIA&#xA;&#x9;&#x9;,FECHA&#xA;&#x9;&#x9;,ID_PAIS_ORIGEN&#xA;&#x9;&#x9;,ID_CIUDAD_ORIGEN&#xA;&#x9;&#x9;,ID_PAIS_DESTINO&#xA;&#x9;&#x9;,ID_CIUDAD_DESTINO&#xA;&#x9;&#x9;,ID_TIPOGUIA&#xA;&#x9;&#x9;,ID_CLIENTE&#xA;&#x9;&#x9;,ID_ESTADOENVIO&#xA;&#x9;&#x9;,ID_DOCU_ULT_MOVI&#xA;&#x9;&#x9;,ID_MEDTRANS&#xA;&#x9;&#x9;,ID_PRODUCTO&#xA;&#x9;&#x9;,ID_SUBPRODUCTO&#xA;&#x9;&#x9;,ID_ESTADOGUIA&#xA;&#x9;&#x9;,ID_TIEMPO_ENTREGA&#xA;&#x9;&#x9;,ID_REQ_EMBALAJE&#xA;&#x9;&#x9;,NUMERO_PIEZAS&#xA;&#x9;&#x9;,FECHA_ENTREGA&#xA;&#x9;&#x9;,FECHA_MODIFICACION&#xA;)&#xA;AS&#xA;(&#xA;&#x9;SELECT &#xA;&#x9;&#x9; EV.NUMERO_GUIA&#xA;&#x9;&#x9;,EV.FECHA_ENVIO AS FECHA&#xA;&#x9;&#x9;,EV.ID_PAIS_ORIGEN&#xA;&#x9;&#x9;,EV.ID_CIUDAD_ORIGEN&#xA;&#x9;&#x9;,EV.ID_PAIS_DESTINO&#xA;&#x9;&#x9;,EV.G_ID_CIUDAD_DESTINO AS ID_CIUDAD_DESTINO&#xA;&#x9;&#x9;,EV.ID_TIPOGUIA&#xA;&#x9;&#x9;,EV.ID_CLIENTE&#xA;&#x9;&#x9;,EV.ID_ESTADOENVIO&#xA;&#x9;&#x9;,EV.ID_DOCU_ULT_MOVI&#xA;&#x9;&#x9;,EV.ID_MEDTRANS&#xA;&#x9;&#x9;,EV.ID_PRODUCTO&#xA;&#x9;&#x9;,EV.ID_SUBPRODUCTO&#xA;&#x9;&#x9;,EV.ID_ESTADOGUIA&#xA;&#x9;&#x9;,EV.ID_TIEMPO_ENTREGA&#xA;&#x9;&#x9;,EV.ID_REQ_EMBALAJE&#xA;&#x9;&#x9;,EV.NUMERO_PIEZAS&#xA;&#x9;&#x9;,EV.FECHA_ENTREGA&#xA;&#x9;&#x9;,EV.FECHA_MODIFICACION&#xA;&#x9;FROM &#xA;&#x9;&#x9;SIG_COL_LOGISTICA_DW.TMP.ENVIOS_MOV EV WITH(NOLOCK)&#xA;&#x9;WHERE SUBSTRING(CONVERT(VARCHAR(20),NUMERO_GUIA),1,1) &lt;&gt; 5 -- REQ 2 OS211&#xA;AND&#xA;&#x9;(EV.FECHA_ENVIO &gt;= @FECHA_INICIO   AND EV.FECHA_ENVIO &lt; @FECHA_FIN   )&#xA;)&#xA;&#xA;INSERT INTO [TMP].[PROMESA_V2]&#xA;           ([NUMERO_GUIA]&#xA;           ,[FECHA]&#xA;           ,[ID_PAIS_ORIGEN]&#xA;           ,[ID_CIUDAD_ORIGEN]&#xA;           ,[ID_PAIS_DESTINO]&#xA;           ,[ID_CIUDAD_DESTINO]&#xA;           ,[ID_TIPOGUIA]&#xA;           ,[ID_CLIENTE]&#xA;           ,[ID_ESTADOENVIO]&#xA;           ,[ID_DOCU_ULT_MOVI]&#xA;           ,[ID_MEDTRANS]&#xA;           ,[ID_PRODUCTO]&#xA;           ,[ID_SUBPRODUCTO]&#xA;           ,[ID_ESTADOGUIA]&#xA;           ,[ID_TIEMPO_ENTREGA]&#xA;           ,[ID_REQ_EMBALAJE]&#xA;           ,[NUMERO_PIEZAS]&#xA;           ,[FECHA_ENTREGA]&#xA;           ,[FECHA_MODIFICACION])&#xA;SELECT&#xA;&#x9; CTE.NUMERO_GUIA&#xA;&#x9;,CTE.FECHA&#xA;&#x9;,CTE.ID_PAIS_ORIGEN&#xA;&#x9;,CTE.ID_CIUDAD_ORIGEN&#xA;&#x9;,CTE.ID_PAIS_DESTINO&#xA;&#x9;,CTE.ID_CIUDAD_DESTINO&#xA;&#x9;,CTE.ID_TIPOGUIA&#xA;&#x9;,CTE.ID_CLIENTE&#xA;&#x9;,CTE.ID_ESTADOENVIO&#xA;&#x9;,CTE.ID_DOCU_ULT_MOVI&#xA;&#x9;,CTE.ID_MEDTRANS&#xA;&#x9;,CTE.ID_PRODUCTO&#xA;&#x9;,CTE.ID_SUBPRODUCTO&#xA;&#x9;,CTE.ID_ESTADOGUIA&#xA;&#x9;,CTE.ID_TIEMPO_ENTREGA&#xA;&#x9;,CTE.ID_REQ_EMBALAJE&#xA;&#x9;,CTE.NUMERO_PIEZAS&#xA;&#x9;,CTE.FECHA_ENTREGA&#xA;&#x9;,CTE.FECHA_MODIFICACION&#x9;&#xA;FROM &#xA;&#x9;CTE&#xA;LEFT OUTER JOIN&#xA;&#x9;SIG_COLOMBIA_DW.TMP.PROMESA_V2 PR WITH (NOLOCK)&#xA;ON&#xA;&#x9;CTE.NUMERO_GUIA = PR.NUMERO_GUIA&#xA;AND PR.NUMERO_GUIA IS NULL     &quot;"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="TSQL_GUIAS">
      <DTS:VariableValue
        DTS:DataType="8"> DECLARE @FECHA_INICIO DATETIME  = CONVERT(VARCHAR,CONVERT(DATETIME,CONVERT(CHAR(11), '20261001'  )),120);
 DECLARE @FECHA_FIN	  DATETIME  = CONVERT(VARCHAR,CONVERT(DATETIME,CONVERT(CHAR(11), '20261010' )),120);


/* habilitar para paso a produccion */

;WITH CTE
(
		 NUMERO_GUIA
		,FECHA
		,ID_PAIS_ORIGEN
		,ID_CIUDAD_ORIGEN
		,ID_PAIS_DESTINO
		,ID_CIUDAD_DESTINO
		,ID_TIPOGUIA
		,ID_CLIENTE
		,ID_ESTADOENVIO
		,ID_DOCU_ULT_MOVI
		,ID_MEDTRANS
		,ID_PRODUCTO
		,ID_SUBPRODUCTO
		,ID_ESTADOGUIA
		,ID_TIEMPO_ENTREGA
		,ID_REQ_EMBALAJE
		,NUMERO_PIEZAS
		,FECHA_ENTREGA
		,FECHA_MODIFICACION
)
AS
(
	SELECT 
		 EV.NUMERO_GUIA
		,EV.FECHA_ENVIO AS FECHA
		,EV.ID_PAIS_ORIGEN
		,EV.ID_CIUDAD_ORIGEN
		,EV.ID_PAIS_DESTINO
		,EV.G_ID_CIUDAD_DESTINO AS ID_CIUDAD_DESTINO
		,EV.ID_TIPOGUIA
		,EV.ID_CLIENTE
		,EV.ID_ESTADOENVIO
		,EV.ID_DOCU_ULT_MOVI
		,EV.ID_MEDTRANS
		,EV.ID_PRODUCTO
		,EV.ID_SUBPRODUCTO
		,EV.ID_ESTADOGUIA
		,EV.ID_TIEMPO_ENTREGA
		,EV.ID_REQ_EMBALAJE
		,EV.NUMERO_PIEZAS
		,EV.FECHA_ENTREGA
		,EV.FECHA_MODIFICACION
	FROM 
		SIG_COL_LOGISTICA_DW.TMP.ENVIOS_MOV EV WITH(NOLOCK)
	WHERE SUBSTRING(CONVERT(VARCHAR(20),NUMERO_GUIA),1,1) &lt;&gt; 5 -- REQ 2 OS211
AND
	(EV.FECHA_ENVIO &gt;= @FECHA_INICIO   AND EV.FECHA_ENVIO &lt; @FECHA_FIN   )
)

INSERT INTO [TMP].[PROMESA_V2]
           ([NUMERO_GUIA]
           ,[FECHA]
           ,[ID_PAIS_ORIGEN]
           ,[ID_CIUDAD_ORIGEN]
           ,[ID_PAIS_DESTINO]
           ,[ID_CIUDAD_DESTINO]
           ,[ID_TIPOGUIA]
           ,[ID_CLIENTE]
           ,[ID_ESTADOENVIO]
           ,[ID_DOCU_ULT_MOVI]
           ,[ID_MEDTRANS]
           ,[ID_PRODUCTO]
           ,[ID_SUBPRODUCTO]
           ,[ID_ESTADOGUIA]
           ,[ID_TIEMPO_ENTREGA]
           ,[ID_REQ_EMBALAJE]
           ,[NUMERO_PIEZAS]
           ,[FECHA_ENTREGA]
           ,[FECHA_MODIFICACION])
SELECT
	 CTE.NUMERO_GUIA
	,CTE.FECHA
	,CTE.ID_PAIS_ORIGEN
	,CTE.ID_CIUDAD_ORIGEN
	,CTE.ID_PAIS_DESTINO
	,CTE.ID_CIUDAD_DESTINO
	,CTE.ID_TIPOGUIA
	,CTE.ID_CLIENTE
	,CTE.ID_ESTADOENVIO
	,CTE.ID_DOCU_ULT_MOVI
	,CTE.ID_MEDTRANS
	,CTE.ID_PRODUCTO
	,CTE.ID_SUBPRODUCTO
	,CTE.ID_ESTADOGUIA
	,CTE.ID_TIEMPO_ENTREGA
	,CTE.ID_REQ_EMBALAJE
	,CTE.NUMERO_PIEZAS
	,CTE.FECHA_ENTREGA
	,CTE.FECHA_MODIFICACION	
FROM 
	CTE
LEFT OUTER JOIN
	SIG_COLOMBIA_DW.TMP.PROMESA_V2 PR WITH (NOLOCK)
ON
	CTE.NUMERO_GUIA = PR.NUMERO_GUIA
AND PR.NUMERO_GUIA IS NULL     </DTS:VariableValue>
    </DTS:Variable>
  </DTS:Variables>
