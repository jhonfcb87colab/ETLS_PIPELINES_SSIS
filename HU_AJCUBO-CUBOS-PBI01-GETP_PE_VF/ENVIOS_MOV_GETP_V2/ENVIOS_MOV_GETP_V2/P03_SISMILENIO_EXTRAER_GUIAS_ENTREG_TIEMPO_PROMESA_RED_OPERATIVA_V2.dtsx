      ,[ID_CIUDAD_DESTINO]
      ,[HORA_CONTROL_MAXIMO_LLEGADA]
      ,NULL [FECHA_HORA_ENTRADA_CIL]
  FROM [TMP].[PROMESA_ND03_02_V2] WITH (NOLOCK) 
) T WHERE T.ID = 1</property>
