                          length="10"
                          lineageId="Package\CALCULO INDICADOR ACIDO Y DEPURADA\OBTENER NOVEDADES RESPONSA\OLE DB Source.Outputs[OLE DB Source Output].Columns[ID_PROCESO_CONCEPTO]"
                          name="ID_PROCESO_CONCEPTO"
