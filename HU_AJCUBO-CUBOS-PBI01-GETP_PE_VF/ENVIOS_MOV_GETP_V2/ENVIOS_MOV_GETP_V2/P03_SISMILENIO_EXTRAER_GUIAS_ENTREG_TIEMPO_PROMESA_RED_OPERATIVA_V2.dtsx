                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=15.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT * FROM
(
SELECT 
		
	ROW_NUMBER() OVER(PARTITION BY CONSECUT_MOVIMI,NUMERO_MOVIMI ORDER BY FECHA_HORA_MOVIMIENTO DESC) R	
	,ID_PROCESO
	,CONSECUT_MOVIMI
	,NUMERO_MOVIMI
	,PLACA_VEHICULO_DOCU
    ,ID_PAIS_DESTINO
    ,ID_CIUDAD_DESTINO			
 FROM TMP.PROMESA_ND02_01_V2 WITH (NOLOCK) 
 )T WHERE T.R =1</property>
