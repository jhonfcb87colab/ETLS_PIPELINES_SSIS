        <DTS:Executable
          DTS:refId="Package\CALCULO INDICADOR ACIDO Y DEPURADA\OBTENER DIGITALIZACION"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{920CDC84-A7B5-4201-AD31-9122ABC024F2}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="OBTENER DIGITALIZACION"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{3CA246E4-2A50-48E4-8910-61693339737A}"
              SQLTask:SqlStatementSource="WITH CTE&#xA;(&#xA;&#x9; G_NUMERO_GUIA&#xA;&#x9;,SE_ID_FECHA_DIG&#xA;&#x9;,SE_FECHA_DIG&#xA;)&#xA;AS&#xA;(&#xA;&#x9;SELECT&#xA;&#x9;&#x9; TMP.G_NUMERO_GUIA&#xA;&#x9;&#x9;,ISNULL(PE.FECHA_DIGITALIZACION,'1900-01-01') SE_ID_FECHA_DIG&#xA;&#x9;&#x9;,ISNULL(CONVERT(VARCHAR,PE.FECHA_DIGITALIZACION,111),'NO DISPONIBLE') SE_FECHA_DIG&#xA;&#x9;FROM&#xA;&#x9;&#x9;[TMP].[CUMPLIMIENTO_AC_DEP] TMP&#xA;&#x9;INNER JOIN&#xA;&#x9;&#x9;SIG_COLOMBIA_DW.LOG.PRUEBAS_ENTREGA PE&#xA;&#x9;ON&#xA;&#x9;&#x9;TMP.G_NUMERO_GUIA = PE.NUMERO_GUIA&#xA;)&#xA;&#xA;UPDATE [TMP].[CUMPLIMIENTO_AC_DEP]&#xA;SET&#xA;&#x9; SE_ID_FECHA_DIG&#x9;= CTE.SE_ID_FECHA_DIG&#xA;&#x9;,SE_FECHA_DIG&#x9;&#x9;= CTE.SE_FECHA_DIG&#xA;FROM&#xA;&#x9;[TMP].[CUMPLIMIENTO_AC_DEP] TMP&#xA;&#x9;INNER JOIN CTE ON &#xA;&#x9;TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\CALCULO INDICADOR ACIDO Y DEPURADA\OBTENER FECHA DE ENTREGA PROMESA"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{0E6E45A5-1670-4681-8F02-F65C3DAC3C83}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="OBTENER FECHA DE ENTREGA PROMESA"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{3CA246E4-2A50-48E4-8910-61693339737A}"
              SQLTask:SqlStatementSource="   /*SE INICIALIZA LA FECHA PRIMERA GESTION*/&#xA;&#xA;DROP TABLE IF EXISTS #FECHA_ENTREGA_PRIMGEST;&#xA;&#xA;SELECT  DATEADD(ms,-3,DATEADD(dd,DATEDIFF(dd,0,SE_ID_FECHA_PRIMGEST),1))  AS SE_ID_FECHA_PRIMGEST , TIEMPO_OFERTA, &#xA;SIG_COLOMBIA_DW.LOG.UFN_COUNT_HORA_RANGE ( DATEADD(ms,-3,DATEADD(dd,DATEDIFF(dd,0,SE_ID_FECHA_PRIMGEST),1))  , TIEMPO_OFERTA, 'DIA DOMINICAL,DIA FESTIVO') ID_FECHA_PROMESA_ENTREGA&#xA;INTO #FECHA_ENTREGA_PRIMGEST&#xA;FROM  &#x9;SIG_COL_LOGISTICA_DW.[TMP].[CUMPLIMIENTO_AC_DEP] WITH(NOLOCK)&#xA;GROUP BY DATEADD(ms,-3,DATEADD(dd,DATEDIFF(dd,0,SE_ID_FECHA_PRIMGEST),1)), TIEMPO_OFERTA&#xA;;&#xA;&#xA;&#xA;UPDATE [TMP].[CUMPLIMIENTO_AC_DEP] &#xA;SET &#xA;&#x9;[SE_ID_FECHA_PROMESA_ENTREGA] = PRM.ID_FECHA_PROMESA_ENTREGA&#xA;&#x9;,[SE_FECHA_PROMESA_ENTREGA] = CONVERT(varchar(50), CONVERT( DATE, PRM.ID_FECHA_PROMESA_ENTREGA  ) )&#xA;FROM &#xA;&#x9;[TMP].[CUMPLIMIENTO_AC_DEP] AS TMP WITH(NOLOCK) INNER JOIN #FECHA_ENTREGA_PRIMGEST AS PRM WITH(NOLOCK)&#xA;&#x9;ON DATEADD(ms,-3,DATEADD(dd,DATEDIFF(dd,0,TMP.SE_ID_FECHA_PRIMGEST),1)) = PRM.SE_ID_FECHA_PRIMGEST&#xA;&#x9;AND TMP.TIEMPO_OFERTA = PRM.TIEMPO_OFERTA&#xA;;&#xA;&#xA;DROP TABLE IF EXISTS #FECHA_ENTREGA_PRIMGEST;&#xA;&#xA;&#xA;&#xA;/*&#xA;-- Se comenta estas lineas ya que no se calcula correctamente los dias no habiles&#xA;UPDATE [TMP].[CUMPLIMIENTO_AC_DEP] &#xA;SET &#xA;&#x9;[SE_ID_FECHA_PROMESA_ENTREGA] = DATEADD(DAY,SE_ID_DIAS_PROMESA,CONVERT(DATE,SE_ID_FECHA_PRIMGEST_DH)),&#xA;&#x9;[SE_FECHA_PROMESA_ENTREGA] = CONVERT(varchar(50),DATEADD(DAY,SE_ID_DIAS_PROMESA,CONVERT(DATE,SE_ID_FECHA_PRIMGEST_DH)))&#xA;FROM &#xA;&#x9;[TMP].[CUMPLIMIENTO_AC_DEP] WITH(NOLOCK)&#xA;*/" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\CALCULO INDICADOR ACIDO Y DEPURADA\OBTENER FECHA ENTREGA"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{60A802E6-0BB3-457F-AEB3-6F9CDF95EEE9}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="OBTENER FECHA ENTREGA"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{3CA246E4-2A50-48E4-8910-61693339737A}"
              SQLTask:SqlStatementSource="DROP TABLE IF EXISTS DATOS_FECHA_SZU_EMPRESARIO_SATE;&#xA;&#xA;&#xA;;WITH SZU AS (&#xA;&#x9;SELECT &#xA;&#x9;&#x9;ROW_NUMBER() OVER (PARTITION BY AC.G_NUMERO_GUIA ORDER BY SE.FECHA_HORA_MOVIMIENTO ASC ) AS #ROWS &#xA;&#x9;&#x9;,'SALIDA A ZONA URBANA' AS SE_PROCESO_PRIMGEST&#xA;&#x9;&#x9;,AC.G_NUMERO_GUIA, ID_PROCESO &#xA;&#x9;&#x9;,ID_CONCEPTO&#xA;&#x9;&#x9;,FECHA_HORA_MOVIMIENTO  AS FECHA_SZU&#xA;&#x9;FROM [TMP].CUMPLIMIENTO_AC_DEP AS AC WITH(NOLOCK)&#xA;&#x9;INNER JOIN  SIG_COLOMBIA_DW.LOG.SEGUIMIENTO_ENVIO AS SE WITH(NOLOCK)&#xA;&#x9;ON AC.G_NUMERO_GUIA = SE.NUMERO_GUIA &#xA;&#x9;&#x9;AND SE.ID_PROCESO = 9&#xA;&#x9;&#x9;AND SE.ID_CONCEPTO IN (2, 4, 7, 9, 10 )&#xA;&#x9;&#x9;AND SE.ID_PROCESO &lt;&gt; 15&#xA;)&#xA;&#x9;SELECT &#xA;&#x9;&#x9;G_NUMERO_GUIA&#xA;&#x9;&#x9;,SE_PROCESO_PRIMGEST, &#xA;&#x9;&#x9;ISNULL(FECHA_SZU,'1900-01-01') AS SE_ID_FECHA_PRIMGEST, &#xA;&#x9;&#x9;ISNULL(CONVERT( VARCHAR, FECHA_SZU, 111), 'NO DISPONIBLE') AS SE_FECHA_PRIMGEST&#xA;INTO DATOS_FECHA_SZU_EMPRESARIO_SATE&#xA;&#x9;FROM SZU  WHERE #ROWS = 1;&#xA;&#xA;;WITH CTE &#xA;(&#xA;&#x9; ID&#xA;&#x9;,G_NUMERO_GUIA&#xA;&#x9;,SE_PROCESO_PRIMGEST&#xA;&#x9;,SE_ID_FECHA_PRIMGEST&#xA;&#x9;,SE_FECHA_PRIMGEST&#xA;)&#xA;AS&#xA;(&#xA;&#x9;SELECT  &#xA;&#x9;&#x9; ROW_NUMBER() OVER(PARTITION BY G_NUMERO_GUIA ORDER BY FECHA) ID&#xA;&#x9;&#x9;,G_NUMERO_GUIA&#xA;&#x9;&#x9;,PROCESO SE_PROCESO_PRIMGEST&#xA;&#x9;&#x9;,FECHA SE_ID_FECHA_PRIMGEST&#xA;&#x9;&#x9;,ISNULL(CONVERT(VARCHAR,FECHA,111),'NO DISPONIBLE') SE_FECHA_PRIMGEST&#xA;&#x9;FROM   &#xA;&#x9;   (&#xA;&#x9;&#x9;SELECT &#xA;&#x9;&#x9;&#x9; [G_NUMERO_GUIA]&#xA;&#x9;&#x9;&#x9;,[SE_ID_FECHA_EV] [ENTREGA VERIFICADA]&#xA;&#x9;&#x9;&#x9;,[SE_ID_FECHA_RE] [REPORTADO ENTREGADO]&#xA;&#x9;&#x9;&#x9;,[SE_ID_FECHA_DIG] [DIGITALIZADA]&#xA;&#x9;&#x9;FROM&#xA;&#x9;&#x9;&#x9;[TMP].CUMPLIMIENTO_AC_DEP&#xA;&#x9;&#x9;WHERE&#xA;&#x9;&#x9;&#x9;[SE_FECHA_RR] &lt;&gt; 'NO DISPONIBLE'&#xA;&#x9;&#x9;OR&#xA;&#x9;&#x9;&#x9;[SE_FECHA_RE] &lt;&gt; 'NO DISPONIBLE'&#xA;&#x9;&#x9;OR&#xA;&#x9;&#x9;&#x9;[SE_FECHA_DIG] &lt;&gt; 'NO DISPONIBLE'&#xA;&#x9;&#x9;) p  &#xA;&#x9;UNPIVOT (FECHA FOR PROCESO IN   &#xA;&#x9;&#x9;(&#xA;&#x9;&#x9;&#x9; [ENTREGA VERIFICADA]&#xA;&#x9;&#x9;&#x9;,[REPORTADO ENTREGADO]&#xA;&#x9;&#x9;&#x9;,[DIGITALIZADA]&#xA;&#x9;&#x9;)  &#xA;&#x9;)AS UNPVT&#xA;&#x9;WHERE&#xA;&#x9;&#x9;FECHA &lt;&gt; '1900-01-01'&#xA;)&#xA;&#xA;, DATOS_VAL AS (&#xA;&#xA;SELECT &#xA;&#x9;CTE.G_NUMERO_GUIA&#xA;,IIF( CTE.SE_ID_FECHA_PRIMGEST &gt;  SZU.SE_ID_FECHA_PRIMGEST, SZU.SE_PROCESO_PRIMGEST, CTE.SE_PROCESO_PRIMGEST) AS SE_PROCESO_PRIMGEST&#xA;,IIF( CTE.SE_ID_FECHA_PRIMGEST &gt;  SZU.SE_ID_FECHA_PRIMGEST, SZU.SE_ID_FECHA_PRIMGEST, CTE.SE_ID_FECHA_PRIMGEST) AS SE_ID_FECHA_PRIMGEST &#xA;,IIF( CTE.SE_ID_FECHA_PRIMGEST &gt;  SZU.SE_ID_FECHA_PRIMGEST, SZU.SE_FECHA_PRIMGEST, CTE.SE_FECHA_PRIMGEST) AS SE_FECHA_PRIMGEST &#xA;FROM CTE WITH(NOLOCK)&#xA;LEFT JOIN DATOS_FECHA_SZU_EMPRESARIO_SATE AS SZU&#xA;ON   CTE.G_NUMERO_GUIA = SZU.G_NUMERO_GUIA  --AND &#xA;WHERE CTE.ID = 1&#xA;)&#xA;&#xA;UPDATE [TMP].CUMPLIMIENTO_AC_DEP&#xA;SET&#xA;--&#x9; SE_PROCESO_PRIMGEST = CTE.SE_PROCESO_PRIMGEST&#xA;&#x9;SE_ID_FECHA = CONVERT(INT,CTE.SE_ID_FECHA_PRIMGEST)&#xA;&#x9;,SE_FECHA = CTE.SE_ID_FECHA_PRIMGEST &#xA;FROM&#xA;&#x9;TMP.CUMPLIMIENTO_AC_DEP TMP INNER JOIN  DATOS_VAL AS CTE&#xA;ON&#xA;&#x9;TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;/**/&#xA;/*&#xA;WITH CTE &#xA;(&#xA;&#x9; ID&#xA;&#x9;,G_NUMERO_GUIA&#xA;&#x9;,SE_PROCESO_PRIMGEST&#xA;&#x9;,SE_ID_FECHA_PRIMGEST&#xA;&#x9;,SE_FECHA_PRIMGEST&#xA;)&#xA;AS&#xA;(&#xA;&#x9;SELECT &#xA;&#x9;&#x9; ROW_NUMBER() OVER(PARTITION BY G_NUMERO_GUIA ORDER BY FECHA) ID&#xA;&#x9;&#x9;,G_NUMERO_GUIA&#xA;&#x9;&#x9;,PROCESO SE_PROCESO_PRIMGEST&#xA;&#x9;&#x9;,FECHA SE_ID_FECHA_PRIMGEST&#xA;&#x9;&#x9;,ISNULL(CONVERT(VARCHAR,FECHA,111),'NO DISPONIBLE') SE_FECHA_PRIMGEST&#xA;&#x9;FROM   &#xA;&#x9;   (&#xA;&#x9;&#x9;SELECT &#xA;&#x9;&#x9;&#x9; [G_NUMERO_GUIA]&#xA;&#x9;&#x9;&#x9;,[SE_ID_FECHA_EV] [ENTREGA VERIFICADA]&#xA;&#x9;&#x9;&#x9;,[SE_ID_FECHA_RE] [REPORTADO ENTREGADO]&#xA;&#x9;&#x9;&#x9;,[SE_ID_FECHA_DIG] [DIGITALIZADA]&#xA;&#x9;&#x9;FROM&#xA;&#x9;&#x9;&#x9;[TMP].CUMPLIMIENTO_AC_DEP&#xA;&#x9;&#x9;WHERE&#xA;&#x9;&#x9;&#x9;[SE_FECHA_RR] &lt;&gt; 'NO DISPONIBLE'&#xA;&#x9;&#x9;OR&#xA;&#x9;&#x9;&#x9;[SE_FECHA_RE] &lt;&gt; 'NO DISPONIBLE'&#xA;&#x9;&#x9;OR&#xA;&#x9;&#x9;&#x9;[SE_FECHA_DIG] &lt;&gt; 'NO DISPONIBLE'&#xA;&#x9;&#x9;) p  &#xA;&#x9;UNPIVOT (FECHA FOR PROCESO IN   &#xA;&#x9;&#x9;(&#xA;&#x9;&#x9;&#x9; [ENTREGA VERIFICADA]&#xA;&#x9;&#x9;&#x9;,[REPORTADO ENTREGADO]&#xA;&#x9;&#x9;&#x9;,[DIGITALIZADA]&#xA;&#x9;&#x9;)  &#xA;&#x9;)AS UNPVT&#xA;&#x9;WHERE&#xA;&#x9;&#x9;FECHA &lt;&gt; '1900-01-01'&#xA;)&#xA;&#xA;UPDATE [TMP].CUMPLIMIENTO_AC_DEP&#xA;SET&#xA;--&#x9; SE_PROCESO_PRIMGEST = CTE.SE_PROCESO_PRIMGEST&#xA;&#x9;SE_ID_FECHA = CONVERT(INT,CTE.SE_ID_FECHA_PRIMGEST)&#xA;&#x9;,SE_FECHA = CTE.SE_ID_FECHA_PRIMGEST -- CTE.SE_FECHA_PRIMGEST&#xA;FROM&#xA;&#x9;TMP.CUMPLIMIENTO_AC_DEP TMP INNER JOIN  CTE&#xA;ON&#xA;&#x9;TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA&#xA;WHERE&#xA;&#x9;CTE.ID = 1&#xA;&#xA;*/" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\CALCULO INDICADOR ACIDO Y DEPURADA\OBTENER GUIA DEPURADA"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{167ABB73-D0F1-4449-9165-F6DA15701AE6}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="OBTENER GUIA DEPURADA"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{3CA246E4-2A50-48E4-8910-61693339737A}"
              SQLTask:SqlStatementSource="&#xA;INSERT INTO [TMP].[CUMPLIMIENTO_AC_DEP_03]&#xA;           ([G_NUMERO_GUIA]&#xA;           ,[NOMBRE_TIPO_NOVEDAD]&#xA;           ,[NOMBRE_NOVEDAD]&#xA;           ,[RESP]&#xA;           ,[FECHA_HORA_MOVIMIENTO])&#xA;SELECT&#xA;&#x9; CLI.G_NUMERO_GUIA&#xA;&#x9;,CONVERT( VARCHAR(50), 'NOVEDAD OPERATIVA') AS  NOMBRE_TIPO_NOVEDAD&#xA;&#x9;,TNO.NOMBRE_TIPO_NOVEDAD AS NOMBRE_NOVEDAD&#xA;&#x9;,IIF(TNO.ES_NOVEDAD_EXTERNA = 1 , 'E', IIF(TNO.ES_NOVEDAD_EXTERNA = 0,  'S', NULL) )  RESP&#xA;&#x9;,CLI.FECHA_HORA_MOVIMIENTO&#xA;FROM&#xA;&#x9;[SIG_COLOMBIA_DW].[LOG].[DETALLE_NOVEDAD_DIARIA] DETND WITH(NOLOCK)&#xA;INNER JOIN&#xA;&#x9;[SIG_COLOMBIA_DW].[LOG].[DOCUMENTOS_NOVEDAD_DIARIA] DOCND WITH(NOLOCK)&#xA;ON&#xA;&#x9;DETND.[ID_PAIS_UNO] = DOCND.[ID_PAIS_UNO]&#xA;AND&#xA;&#x9;DETND.ID_CIUDAD_UNO = DOCND.ID_CIUDAD_UNO&#xA;INNER JOIN&#xA;&#x9;[SIG_COLOMBIA_DW].[LOG].[NOVEDAD_DIARIA] ND WITH(NOLOCK)&#xA;ON&#xA;&#x9;DETND.[ID_PAIS_UNO] = ND.[ID_PAIS_UNO]&#xA;AND&#xA;&#x9;DETND.ID_CIUDAD_UNO = ND.ID_CIUDAD_UNO&#xA;INNER JOIN&#xA;&#x9;  SIG_COLOMBIA_DW.[PAR].[TIPOSNOVEDADESOPERATIVAS] TNO  WITH (NOLOCK) &#xA;ON&#xA;&#x9;ND.[ID_TIPO_NOVEDAD] = TNO.ID_TIPO_NOVEDAD&#xA;INNER JOIN&#xA;&#x9;[TMP].[CUMPLIMIENTO_AC_DEP_02] CLI&#xA;ON&#xA;&#x9;DOCND.[ID_PROCESO] = CLI.[ID_PROCESO]&#xA;AND&#x9; &#x9;&#x9;&#x9;&#x9;&#xA;&#x9;DOCND.[NUMERO_MOVIMI] = CLI.[NUMERO_MOVIMI]&#xA;AND&#x9;&#x9;&#x9;&#x9;&#xA;&#x9;DOCND.[CONSECUT_MOVIMI] = CLI.[CONSECUT_MOVIMI]&#xA;AND&#xA;&#x9;DETND.[PLACA_VEHICULO_DOCU] = CLI.[PLACA_VEHICULO_DOCU]&#xA;WHERE&#xA;&#x9;DETND.[FECHA_NOVEDAD] = DOCND.[FECHA_NOVEDAD]&#xA;AND&#xA;&#x9;DETND.[FECHA_NOVEDAD] = ND.[FECHA_NOVEDAD]&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;/*&#xA;INSERT INTO [TMP].[CUMPLIMIENTO_AC_DEP_03]&#xA;           ([G_NUMERO_GUIA]&#xA;           ,[NOMBRE_TIPO_NOVEDAD]&#xA;           ,[NOMBRE_NOVEDAD]&#xA;           ,[RESP]&#xA;           ,[FECHA_HORA_MOVIMIENTO])&#xA;SELECT&#xA;&#x9; CLI.G_NUMERO_GUIA&#xA;&#x9;,TNO.NOMBRE_TIPO_NOVEDAD&#xA;&#x9;,TNO.NOMBRE_NOVEDAD&#xA;&#x9;,TNO.RESP&#xA;&#x9;,CLI.FECHA_HORA_MOVIMIENTO&#xA;FROM&#xA;&#x9;[SIG_COLOMBIA_DW].[LOG].[DETALLE_NOVEDAD_DIARIA] DETND WITH(NOLOCK)&#xA;INNER JOIN&#xA;&#x9;[SIG_COLOMBIA_DW].[LOG].[DOCUMENTOS_NOVEDAD_DIARIA] DOCND WITH(NOLOCK)&#xA;ON&#xA;&#x9;DETND.[ID_PAIS_UNO] = DOCND.[ID_PAIS_UNO]&#xA;AND&#xA;&#x9;DETND.ID_CIUDAD_UNO = DOCND.ID_CIUDAD_UNO&#xA;INNER JOIN&#xA;&#x9;[SIG_COLOMBIA_DW].[LOG].[NOVEDAD_DIARIA] ND WITH(NOLOCK)&#xA;ON&#xA;&#x9;DETND.[ID_PAIS_UNO] = ND.[ID_PAIS_UNO]&#xA;AND&#xA;&#x9;DETND.ID_CIUDAD_UNO = ND.ID_CIUDAD_UNO&#xA;INNER JOIN&#xA;&#x9;TMP.NOVEDADES_DEPURADA TNO&#xA;ON&#xA;&#x9;ND.[ID_TIPO_NOVEDAD] = TNO.ID_TIPO_NOVEDAD&#xA;INNER JOIN&#xA;&#x9;[TMP].[CUMPLIMIENTO_AC_DEP_02] CLI&#xA;ON&#xA;&#x9;DOCND.[ID_PROCESO] = CLI.[ID_PROCESO]&#xA;AND&#x9; &#x9;&#x9;&#x9;&#x9;&#xA;&#x9;DOCND.[NUMERO_MOVIMI] = CLI.[NUMERO_MOVIMI]&#xA;AND&#x9;&#x9;&#x9;&#x9;&#xA;&#x9;DOCND.[CONSECUT_MOVIMI] = CLI.[CONSECUT_MOVIMI]&#xA;AND&#xA;&#x9;DETND.[PLACA_VEHICULO_DOCU] = CLI.[PLACA_VEHICULO_DOCU]&#xA;WHERE&#xA;&#x9;DETND.[FECHA_NOVEDAD] = DOCND.[FECHA_NOVEDAD]&#xA;AND&#xA;&#x9;DETND.[FECHA_NOVEDAD] = ND.[FECHA_NOVEDAD]&#xA;*/" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\CALCULO INDICADOR ACIDO Y DEPURADA\OBTENER MOVIMIENTOS LOGISTICOS"
          DTS:CreationName="Microsoft.Pipeline"
          DTS:Description="Data Flow Task"
          DTS:DTSID="{83C4ADA3-DFD3-421A-9CDA-D8E57EDFF6BC}"
          DTS:ExecutableType="Microsoft.Pipeline"
          DTS:LocaleID="-1"
          DTS:ObjectName="OBTENER MOVIMIENTOS LOGISTICOS"
          DTS:TaskContact="Performs high-performance data extraction, transformation and loading;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1">
          <DTS:Variables />
          <DTS:ObjectData>
            <pipeline
              version="1">
              <components>
                <component
                  refId="Package\CALCULO INDICADOR ACIDO Y DEPURADA\OBTENER MOVIMIENTOS LOGISTICOS\OLE DB Destination"
