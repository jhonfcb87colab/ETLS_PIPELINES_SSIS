          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{3CA246E4-2A50-48E4-8910-61693339737A}"
              SQLTask:SqlStatementSource="WITH CTE&#xA;(&#xA;&#x9; ID&#xA;&#x9;,G_NUMERO_GUIA&#xA;&#x9;,SE_DESC_PROC_DEPU&#xA;&#x9;,SE_DESC_CONC_DEPU&#xA;&#x9;,SE_DEPURADO_RESP&#xA;)&#xA;AS&#xA;(&#xA;&#x9;SELECT&#xA;&#x9;&#x9; ROW_NUMBER() OVER(PARTITION BY G_NUMERO_GUIA ORDER BY FECHA_HORA_MOVIMIENTO) ID&#xA;&#x9;&#x9;,G_NUMERO_GUIA&#xA;&#x9;&#x9;,SE_DESC_PROC_DEPU&#xA;&#x9;&#x9;,SE_DESC_CONC_DEPU&#xA;&#x9;&#x9;,SE_DEPURADO_RESP&#xA;&#x9;FROM&#xA;&#x9;&#x9;TMP.[CUMPLIMIENTO_AC_DEP_04] C WITH(NOLOCK)&#xA;)&#xA;UPDATE [TMP].[CUMPLIMIENTO_AC_DEP]&#xA;SET&#xA;&#x9; SE_PROMESA_CUMPLE_DEPURADA = CASE WHEN CTE.SE_DEPURADO_RESP IN ('E','C') THEN 'SI' ELSE C.SE_PROMESA_CUMPLE_DEPURADA END&#xA;&#x9;--,SE_DESC_PROC_DEPU = CTE.SE_DESC_PROC_DEPU&#xA;&#x9;--,SE_DESC_CONC_DEPU = CTE.SE_DESC_CONC_DEPU&#xA;&#x9;,SE_RESPONSABLE_ID = ISNULL(CTE.SE_DEPURADO_RESP , 'NO APLICA' ) ----------------- CTE.SE_DEPURADO_RESP&#xA;&#xA;FROM&#xA;&#x9;TMP.[CUMPLIMIENTO_AC_DEP] C, CTE&#xA;WHERE&#xA;&#x9;C.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA&#xA;AND&#xA;&#x9;CTE.ID = 1" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\CALCULO INDICADOR ACIDO Y DEPURADA\CUMPLIMIENTO ACIDA"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{6950B06B-FC36-4D42-B0CD-B510F82B366B}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="CUMPLIMIENTO ACIDA"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{3CA246E4-2A50-48E4-8910-61693339737A}"
              SQLTask:SqlStatementSource="UPDATE [TMP].[CUMPLIMIENTO_AC_DEP]&#xA;SET [SE_PROMESA_CUMPLE_ACIDA] = CASE WHEN CONVERT(DATE,SE_FECHA) &lt;= SE_ID_FECHA_PROMESA_ENTREGA_DH THEN 'SI' ELSE 'NO' END,&#xA;&#x9;[SE_PROMESA_CUMPLE_DEPURADA] = CASE WHEN CONVERT(DATE,SE_FECHA) &lt;= SE_ID_FECHA_PROMESA_ENTREGA_DH THEN 'SI' ELSE 'NO' END&#xA;FROM [TMP].[CUMPLIMIENTO_AC_DEP] WITH(NOLOCK)&#xA;WHERE SE_FECHA &lt;&gt; '1900-01-01' AND SE_FECHA_PROMESA_ENTREGA_DH  &lt;&gt; 'NO DISPONIBLE'" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\CALCULO INDICADOR ACIDO Y DEPURADA\DIA HABIL FECHA DE ENTREGA PROMESA"
