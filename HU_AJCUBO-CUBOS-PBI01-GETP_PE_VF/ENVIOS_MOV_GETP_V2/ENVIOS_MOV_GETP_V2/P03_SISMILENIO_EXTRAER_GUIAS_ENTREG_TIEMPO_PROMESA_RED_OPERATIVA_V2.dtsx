          DTS:DTSID="{7283367E-2402-4D03-AB76-40F72706B051}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="CREAR TABLA  PIVOTE SI NO FUE ELIMINADA"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{635796CA-91A9-45A4-8AB7-4F33F233E9D0}"
              SQLTask:SqlStatementSource="&#xA;--DROP TABLE [tmp_borrar].[DBO].[BI_GETP_Guias_Trayectos_Ajustados_FACTURACION_MERF]&#xA;&#xA;-- 1. Validar y crear la tabla si no existe&#xA;IF NOT EXISTS (&#xA;    SELECT * &#xA;    FROM sys.objects &#xA;    WHERE object_id = OBJECT_ID(N'[tmp_borrar].[DBO].[BI_GETP_Guias_Trayectos_Ajustados_FACTURACION_MERF]') &#xA;      AND type = 'U'&#xA;)&#xA;BEGIN&#xA;    CREATE TABLE [tmp_borrar].[DBO].[BI_GETP_Guias_Trayectos_Ajustados_FACTURACION_MERF] (&#xA;        [NUMERO_GUIA] numeric(20,0)&#xA;    );&#xA;&#x9;PRINT('TABLA CREADA YA QUE FUE ELIMINADA')&#xA;END&#xA;GO&#xA;&#xA;-- 2. Validar y crear el índice no agrupado solo si no existe&#xA;IF NOT EXISTS (&#xA;    SELECT * &#xA;    FROM sys.indexes &#xA;    WHERE name = N'I_NUMERO_GUIA_GETP' &#xA;      AND object_id = OBJECT_ID(N'[tmp_borrar].[DBO].[BI_GETP_Guias_Trayectos_Ajustados_FACTURACION_MERF]')&#xA;)&#xA;BEGIN&#xA;    CREATE NONCLUSTERED INDEX [I_NUMERO_GUIA_GETP] &#xA;    ON [tmp_borrar].[DBO].[BI_GETP_Guias_Trayectos_Ajustados_FACTURACION_MERF]([NUMERO_GUIA] ASC)&#xA;    WITH (&#xA;        PAD_INDEX = OFF, &#xA;        STATISTICS_NORECOMPUTE = OFF, &#xA;        SORT_IN_TEMPDB = OFF, &#xA;        DROP_EXISTING = OFF, &#xA;        ONLINE = OFF, &#xA;        ALLOW_ROW_LOCKS = ON, &#xA;        ALLOW_PAGE_LOCKS = ON, &#xA;        FILLFACTOR = 80&#xA;    );&#xA;&#x9;PRINT('INDICE CREADO YA QUE FUE ELIMINADO')&#xA;END&#xA;GO&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
