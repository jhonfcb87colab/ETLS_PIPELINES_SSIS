                        <outputColumn
                          refId="Package\CALCULO INDICADOR ACIDO Y DEPURADA\INSERT GUIAS TIEMPO ENTREGA NORMAL\OLE DB Destination.Outputs[OLE DB Destination Error Output].Columns[ErrorCode]"
                          dataType="i4"
