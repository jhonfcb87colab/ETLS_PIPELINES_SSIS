          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{4E6614B9-C712-40CC-8397-3152345F8544}"
              SQLTask:SqlStatementSource="--DROP TABLE [tmp_borrar_local].[DBO].[BI_GETP_GUIAS_PRUEBAS_ENTREGA]&#xA;&#xA;-- 1. Validar y crear la tabla si no existe&#xA;IF NOT EXISTS (&#xA;    SELECT * &#xA;    FROM sys.objects &#xA;    WHERE object_id = OBJECT_ID(N'[tmp_borrar_local].[DBO].[BI_GETP_GUIAS_PRUEBAS_ENTREGA]') &#xA;      AND type = 'U'&#xA;)&#xA;BEGIN&#xA;    CREATE TABLE [tmp_borrar_local].[DBO].[BI_GETP_GUIAS_PRUEBAS_ENTREGA] (&#xA;        [NUMERO_GUIA] numeric(20,0)&#xA;    );&#xA; PRINT('TABLA CREADA YA QUE FUE ELIMINADA')&#xA;END&#xA;GO&#xA;&#xA;-- 2. Validar y crear el índice no agrupado solo si no existe&#xA;IF NOT EXISTS (&#xA;    SELECT * &#xA;    FROM sys.indexes &#xA;    WHERE name = N'I_NUMERO_GUIA_GETP' &#xA;      AND object_id = OBJECT_ID(N'[tmp_borrar_local].[DBO].[BI_GETP_GUIAS_PRUEBAS_ENTREGA]')&#xA;)&#xA;BEGIN&#xA;    CREATE NONCLUSTERED INDEX [I_NUMERO_GUIA_GETP] &#xA;    ON [tmp_borrar_local].[DBO].[BI_GETP_GUIAS_PRUEBAS_ENTREGA]([NUMERO_GUIA] ASC)&#xA;    WITH (&#xA;        PAD_INDEX = OFF, &#xA;        STATISTICS_NORECOMPUTE = OFF, &#xA;        SORT_IN_TEMPDB = OFF, &#xA;        DROP_EXISTING = OFF, &#xA;        ONLINE = OFF, &#xA;        ALLOW_ROW_LOCKS = ON, &#xA;        ALLOW_PAGE_LOCKS = ON, &#xA;        FILLFACTOR = 80&#xA;    );&#xA; PRINT('INDICE CREADO YA QUE FUE ELIMINADO')&#xA;END&#xA;GO&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
