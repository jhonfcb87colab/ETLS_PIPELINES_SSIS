                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=15.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT S.NUMERO_GUIA,S.ID_PROCESO,S.ID_CONCEPTO,S.FECHA_HORA_MOVIMIENTO FROM TMP.PROMESA_V2 T WITH (NOLOCK)

INNER JOIN

          LOG.SEGUIMIENTO_ENVIO S WITH (NOLOCK)
ON
T.NUMERO_GUIA = S.NUMERO_GUIA
WHERE S.ID_PROCESO IN (21,9)</property>
