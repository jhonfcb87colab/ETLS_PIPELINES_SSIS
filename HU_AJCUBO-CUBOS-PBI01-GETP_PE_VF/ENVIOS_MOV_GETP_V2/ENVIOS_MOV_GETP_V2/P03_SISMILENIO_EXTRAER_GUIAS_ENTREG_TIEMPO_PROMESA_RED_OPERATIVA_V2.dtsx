                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=15.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT 
	 GML.NUMERO_GUIA
	,GML.ID_PAIS_ORIGEN	
	,GML.ID_CIUDAD_ORIGEN	
	,GML.ID_PAIS_DESTINO	
	,GML.ID_CIUDAD_DESTINO
	,GML.ID_TIEMPO	
	,GML.ID_MEDTRANS
FROM [MERF_INGRESOS].[dbo].[MECE_LOGISTICO_GUIAS] GML WITH(NOLOCK)
INNER JOIN [tmp_borrar].[DBO].[BI_GETP_Guias_Trayectos_Ajustados_FACTURACION_MERF] GTP WITH(NOLOCK)
ON GML.NUMERO_GUIA=GTP.NUMERO_GUIA</property>
