            <component
              refId="Package\CONSOLIDAR TMP PROMESA\OLE DB Source"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
              description="OLE DB Source"
              name="OLE DB Source"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=15.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT 
  	    CONVERT(NUMERIC,CONVERT(DATETIME,CONVERT(CHAR(11),EV.FECHA_ENVIO)))AS TIMEID
		,CONVERT(DATETIME,CONVERT(CHAR(11),EV.FECHA_ENVIO))AS FECHA
		,DAY (EV.FECHA_ENVIO) AS DIA
		,MONTH (EV.FECHA_ENVIO) AS MES
		,YEAR (EV.FECHA_ENVIO) AS AÑO 
		,EV.ID_CIUDAD_ORIGEN
		,EV.G_ID_CIUDAD_DESTINO  AS ID_CIUDAD_DESTINO
		,EV.ID_ESTADOENVIO
		,EV.ID_PRODUCTO
		,EV.ID_SUBPRODUCTO
		,EV.ID_CLIENTE
		,0 AS ID_CONCEPTO
		,EV.ID_TIEMPO_ENTREGA
		,EV.ID_MEDTRANS
		,EV.NUMERO_GUIA
		,SE_PROMESA_CUMPLE_ACIDA
		,SE_PROMESA_CUMPLE_DEPURADA
		,CASE SE_RESPONSABLE_ID WHEN 'NO DISPONIBLE' THEN 'NO APLICA' ELSE SE_RESPONSABLE_ID END AS SE_RESPONSABLE_ID
		,AC.GR_ID_TIPO_COBRO
		,AC.ID_RUTA
		,AC.ID_GRUPO_RED
		,AC.TIEMPO_OFERTA
		,AC.TIEMPO_PROMESA_H
		,AC.TIEMPO_PROMESA_CUMPLE_H
	FROM     SIG_COL_LOGISTICA_DW.TMP.ENVIOS_MOV EV WITH(NOLOCK)
	INNER JOIN TMP.CUMPLIMIENTO_AC_DEP AC WITH(NOLOCK) 
	      ON AC.G_NUMERO_GUIA = EV.NUMERO_GUIA</property>
                <property
