                  refId="Package\Repoblamiento Importar guias con Pruebas entrega PE tipo prueba entrega\Transporte TMP GETP guias pruebas entrega.Paths[OLE DB Source Output]"
                  endId="Package\Repoblamiento Importar guias con Pruebas entrega PE tipo prueba entrega\Transporte TMP GETP guias pruebas entrega\TMP  GETP_GUIAS_PRUEBA_ENTREGA.Inputs[OLE DB Destination Input]"
                  name="OLE DB Source Output"
                  startId="Package\Repoblamiento Importar guias con Pruebas entrega PE tipo prueba entrega\Transporte TMP GETP guias pruebas entrega\EXTRACCION DATOS DE PRUEBAS ENTREGA NACIONAL.Outputs[OLE DB Source Output]" />
