                          errorRowDisposition="FailComponent"
                          externalMetadataColumnId="Package\CALCULO INDICADOR ACIDO Y DEPURADA\OBTENER NOVEDADES RESPONSA\OLE DB Source.Outputs[OLE DB Source Output].ExternalColumns[ID_PROCESO]"
