      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{3CA246E4-2A50-48E4-8910-61693339737A}"
          SQLTask:SqlStatementSource="&#xA;&#x9; --=========================================================================================================&#xA;&#x9; --PASO 04.10 ELIMINA DE LOS HECHOS LOS DÍAS EXTRAIDOS&#xA;&#x9; --========================================================================================================&#xA;&#xA;&#x9; &#x9;/*DELETE &#xA;&#x9;&#x9;FAC.GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2&#xA;&#x9;WHERE&#xA;&#x9;&#x9;TIME_ID IN&#xA;&#x9;(SELECT DISTINCT TIME_ID FROM [TMP].[GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2]) */&#xA;&#xA;DELETE&#x9;&#xA;FAC.GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2&#xA;WHERE NUMERO_GUIA IN (SELECT TMP.NUMERO_GUIA FROM TMP.GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2 TMP)&#xA;&#x9;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
