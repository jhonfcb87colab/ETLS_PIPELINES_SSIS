                  componentClassID="Microsoft.OLEDBSource"
                  contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                  description="OLE DB Source"
                  name="EXTRACCION DATOS DE PRUEBAS ENTREGA NACIONAL"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=15.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT 
		 GPE.NUMERO_GUIA
		,GPE.TIPO_PRUEBA_ENTREGA
		, NOMBRE_TIOPO_ENTREGA = CASE WHEN GPE.TIPO_PRUEBA_ENTREGA = 1 THEN 'FISCO'
									WHEN GPE.TIPO_PRUEBA_ENTREGA = 2 THEN 'VIRTUAL'
									WHEN ISNULL(GPE.TIPO_PRUEBA_ENTREGA,0)=0 THEN 'NO DISPONIBLE'
									ELSE 'NO DISPONIBLE'
									END
		,GPE.FECHA_CREACION
  FROM [tmp_borrar_local].[dbo].[PRUEBAS_ENTREGA_BI] GPE WITH(NOLOCK)
  INNER JOIN [tmp_borrar_local].[DBO].[BI_GETP_GUIAS_PRUEBAS_ENTREGA] GETP WITH(NOLOCK)
  ON GPE.[NUMERO_GUIA] = GETP.[NUMERO_GUIA]</property>
