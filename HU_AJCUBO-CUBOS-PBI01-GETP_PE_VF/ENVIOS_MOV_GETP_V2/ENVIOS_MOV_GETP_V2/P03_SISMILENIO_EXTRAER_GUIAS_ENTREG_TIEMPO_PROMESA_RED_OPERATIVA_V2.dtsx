            <component
              refId="Package\CARGAR INFO FAC\OLE DB Source"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
              description="OLE DB Source"
              name="OLE DB Source"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=15.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT
		 T.TIME_ID
		,T.FECHA
		,T.DIA
		,T.MES
		,T.AÑO
		,T.ID_CIUDAD_ORIGEN
		,T.ID_CIUDAD_DESTINO
		,T.ID_CLIENTE
		,T.ID_ESTADOENVIO
		,T.ID_PRODUCTO
		,T.ID_SUBPRODUCTO
        ,CONVERT(VARCHAR(6),right('00' + convert(varchar,ID_PRODUCTO),2) + right( '0000' +  convert(varchar, ID_SUBPRODUCTO),4)) ID_PROD_SUBP
		,T.ID_TIEMPO_ENTREGA
		,T.NUMERO_GUIA
		,T.ID_RUTA
		,ISNULL(T.ID_GRUPO_RED, -888) AS ID_GRUPO_RED
		,ISNULL(T.TIEMPO_PROMESA_H, 0) AS TIEMPO_PROMESA_H
		,ISNULL(T.TIEMPO_OFERTA, 0) AS TIEMPO_OFERTA
		,ISNULL(T.TIEMPO_PROMESA_CUMPLE_H,'NO') AS TIEMPO_PROMESA_CUMPLE_H
		,CONVERT(VARCHAR,G.ID_REGIONAL) +'-'+ CONVERT(VARCHAR,T.ID_CONCEPTO) ID_GEOGRAFIA_CONCEPTO 
        ,T.HORAS_ND 
		,T.ID_ESTADO_ND
		,ISNULL(T.GR_ID_TIPO_COBRO, -888) AS GR_ID_TIPO_COBRO
		,CONVERT(VARCHAR(2), IIF(T.SE_PROMESA_CUMPLE_ACIDA = 'NO DISPONIBLE', 'NO', ISNULL(T.SE_PROMESA_CUMPLE_ACIDA,'NO') )  ) AS SE_PROMESA_CUMPLE_ACIDA
		,CONVERT(VARCHAR(2), IIF(T.SE_PROMESA_CUMPLE_DEPURADA = 'NO DISPONIBLE', 'NO', ISNULL(T.SE_PROMESA_CUMPLE_DEPURADA, 'NO'))   ) AS SE_PROMESA_CUMPLE_DEPURADA
		,SE_RESPONSABLE_ID
	FROM 
   TMP.GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2 T 
 LEFT JOIN
			SIG_COLOMBIA_DW.DIM.GEOGRAFIA G
ON
	T.ID_CIUDAD_DESTINO = G.ID_CIUDAD</property>
                <property
