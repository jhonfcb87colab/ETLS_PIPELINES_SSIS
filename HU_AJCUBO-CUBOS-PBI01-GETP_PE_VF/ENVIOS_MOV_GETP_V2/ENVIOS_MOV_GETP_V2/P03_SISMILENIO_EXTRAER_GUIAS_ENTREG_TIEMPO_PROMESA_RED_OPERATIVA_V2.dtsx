          SQLTask:SqlStatementSource="UPDATE [TMP].[DEV_GETP_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2] &#xA;SET ID_TIPO_ENTREGA=-1&#xA;&#xA;UPDATE TMPGTP SET&#xA;TMPGTP.ID_TIPO_ENTREGA=GPE.TIPO_PRUEBA_ENTREGA&#xA;FROM SIG_COLOMBIA_DW.[TMP].[GETP_GUIAS_PRUEBA_ENTREGA] GPE WITH(NOLOCK)&#xA;INNER JOIN [TMP].[DEV_GETP_GUIAS_ENTREG_TIEMPO_PROMESA_RED_OPERATIVA_V2] TMPGTP WITH(NOLOCK)&#xA;ON GPE.NUMERO_GUIA=TMPGTP.NUMERO_GUIA&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
