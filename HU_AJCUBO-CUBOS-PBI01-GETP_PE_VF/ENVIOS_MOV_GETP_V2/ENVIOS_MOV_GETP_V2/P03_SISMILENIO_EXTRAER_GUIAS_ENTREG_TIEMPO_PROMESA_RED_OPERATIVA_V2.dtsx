        <DTS:Executable
          DTS:refId="Package\CALCULO INDICADOR ACIDO Y DEPURADA\NOVEDADES Y PROCESOS DEPURADA"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{2BE2FF58-9C24-4149-B504-B2187D4C39D0}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="NOVEDADES Y PROCESOS DEPURADA"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{3CA246E4-2A50-48E4-8910-61693339737A}"
              SQLTask:SqlStatementSource="&#xA;INSERT INTO [TMP].[CUMPLIMIENTO_AC_DEP_04]&#xA;           ([G_NUMERO_GUIA]&#xA;           ,[SE_DESC_PROC_DEPU]&#xA;           ,[SE_DESC_CONC_DEPU]&#xA;           ,[SE_DEPURADO_RESP]&#xA;           ,[FECHA_HORA_MOVIMIENTO])&#xA;SELECT&#xA;&#x9;&#x9; C.G_NUMERO_GUIA&#xA;&#x9;&#x9;,D.NOMBRE_PROCESO SE_DESC_PROC_DEPU&#xA;&#x9;&#x9;,D.NOMBRE_PROCESO SE_DESC_CONC_DEPU&#xA;&#x9;&#x9;,D.RESP SE_DEPURADO_RESP&#xA;&#x9;&#x9;,P.FECHA_HORA_MOVIMIENTO&#xA;&#x9;FROM&#xA;&#x9;&#x9;[TMP].[CUMPLIMIENTO_AC_DEP] C WITH(NOLOCK)&#xA;&#x9;INNER JOIN&#xA;&#x9;&#x9;[TMP].[CUMPLIMIENTO_AC_DEP_01] P WITH(NOLOCK)&#xA;&#x9;ON&#xA;&#x9;&#x9;C.G_NUMERO_GUIA = P.NUMERO_GUIA&#xA;&#x9;INNER JOIN&#xA;&#x9;&#x9;TMP.NOVEDADES_RESPONSABLE D&#xA;&#x9;ON&#xA;&#x9;&#x9;P.ID_PROCESO = D.ID_PROCESO&#xA;&#x9;AND&#xA;&#x9;&#x9;P.ID_CONCEPTO = D.ID_CONCEPTO&#xA;&#x9;WHERE&#xA;&#x9;&#x9;D.ES_DEPU = 1&#xA;&#x9;AND&#xA;&#x9;&#x9;C.SE_PROMESA_CUMPLE_DEPURADA = 'NO'&#xA;GO&#xA;&#xA;INSERT INTO [TMP].[CUMPLIMIENTO_AC_DEP_04]&#xA;           ([G_NUMERO_GUIA]&#xA;           ,[SE_DESC_PROC_DEPU]&#xA;           ,[SE_DESC_CONC_DEPU]&#xA;           ,[SE_DEPURADO_RESP]&#xA;           ,[FECHA_HORA_MOVIMIENTO])&#xA;&#x9;SELECT&#xA;&#x9;&#x9; C.G_NUMERO_GUIA&#xA;&#x9;&#x9;,N.NOMBRE_TIPO_NOVEDAD SE_DESC_PROC_DEPU&#xA;&#x9;&#x9;,N.NOMBRE_NOVEDAD SE_DESC_CONC_DEPU&#xA;&#x9;&#x9;,N.RESP SE_DEPURADO_RESP&#xA;&#x9;&#x9;,N.FECHA_HORA_MOVIMIENTO&#xA;&#x9;FROM&#xA;&#x9;&#x9;TMP.[CUMPLIMIENTO_AC_DEP] C WITH(NOLOCK)&#xA;&#x9;INNER JOIN&#xA;&#x9;&#x9;TMP.[CUMPLIMIENTO_AC_DEP_03] N WITH(NOLOCK)&#xA;&#x9;ON&#xA;&#x9;&#x9;C.G_NUMERO_GUIA = N.G_NUMERO_GUIA&#xA;&#x9;WHERE&#xA;&#x9;&#x9;C.SE_PROMESA_CUMPLE_DEPURADA = 'NO'&#xA;GO&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;/* Se inserta esta linea ya que se requiere actualizar los datos de responsabilidad */&#xA;;WITH CTE&#xA;(&#xA;  ID&#xA; ,G_NUMERO_GUIA&#xA; ,SE_DESC_PROC_DEPU&#xA; ,SE_DESC_CONC_DEPU&#xA; ,SE_DEPURADO_RESP&#xA;)&#xA;AS&#xA;(&#xA; SELECT&#xA;   ROW_NUMBER() OVER(PARTITION BY G_NUMERO_GUIA ORDER BY FECHA_HORA_MOVIMIENTO) ID&#xA;  ,G_NUMERO_GUIA&#xA;  ,SE_DESC_PROC_DEPU&#xA;  ,SE_DESC_CONC_DEPU&#xA;  ,SE_DEPURADO_RESP&#xA; FROM&#xA;  TMP.[CUMPLIMIENTO_AC_DEP_04] C WITH(NOLOCK)&#xA;)&#xA;&#xA;UPDATE [TMP].[CUMPLIMIENTO_AC_DEP]&#xA;SET&#xA; -- SE_PROMESA_CUMPLE_DEPURADA = CASE WHEN CTE.SE_DEPURADO_RESP IN ('E','C') THEN 'SI' ELSE C.SE_PROMESA_CUMPLE_DEPURADA END&#xA; &#xA;SE_RESPONSABLE_ID = ISNULL(CTE.SE_DEPURADO_RESP , 'NO APLICA' )    -- CTE.SE_DEPURADO_RESP&#xA;&#xA;--SELECT  &#xA;--C.SE_PROMESA_CUMPLE_DEPURADA  , CASE WHEN CTE.SE_DEPURADO_RESP IN ('E','C') THEN 'SI' ELSE C.SE_PROMESA_CUMPLE_DEPURADA END AS CCC,&#xA;--C.SE_RESPONSABLE_ID , CTE.SE_DEPURADO_RESP, COUNT(1)&#xA;FROM&#xA; TMP.[CUMPLIMIENTO_AC_DEP] C INNER JOIN  CTE&#xA;ON&#xA; C.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA&#xA;WHERE &#xA; CTE.ID = 1" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
