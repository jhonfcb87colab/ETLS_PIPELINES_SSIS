          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{3CA246E4-2A50-48E4-8910-61693339737A}"
              SQLTask:SqlStatementSource="USE SIG_COL_LOGISTICA_DW;&#xA;&#xA;&#xA;UPDATE GTP SET&#xA;&#x9; GTP.ID_CIUDAD_ORIGEN = MERF.ID_CIUDAD_ORIGEN&#x9;&#x9;&#x9;&#xA;&#x9;,GTP.ID_CIUDAD_DESTINO = MERF.ID_CIUDAD_DESTINO&#x9;&#x9;&#x9;&#xA;&#x9;,GTP.ID_TIEMPO_ENTREGA = MERF.ID_TIEMPO&#x9;&#x9;&#x9;&#xA;&#x9;,GTP.ID_MEDTRANS = MERF.ID_MEDTRANS&#x9;&#xA;FROM [SIG_COL_LOGISTICA_DW].[TMP].[PROMESA_V2] GTP&#x9;WITH(NOLOCK)&#xA;INNER JOIN [SIG_COLOMBIA_DW].[TMP].[GETP_TRAYECTOS_AJUSTADOS_MERF] MERF WITH(NOLOCK)&#xA;ON GTP.NUMERO_GUIA = MERF.NUMERO_GUIA" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
      </DTS:Executables>
      <DTS:PrecedenceConstraints>
        <DTS:PrecedenceConstraint
          DTS:refId="Package\TRANSFORMACION PROMESA.PrecedenceConstraints[Constraint]"
          DTS:CreationName=""
          DTS:DTSID="{ECD2581A-C175-44D6-997C-9908576D2D6D}"
          DTS:From="Package\TRANSFORMACION PROMESA\UPDATE TRAYECTOS CIUDADES MERF"
          DTS:LogicalAnd="True"
