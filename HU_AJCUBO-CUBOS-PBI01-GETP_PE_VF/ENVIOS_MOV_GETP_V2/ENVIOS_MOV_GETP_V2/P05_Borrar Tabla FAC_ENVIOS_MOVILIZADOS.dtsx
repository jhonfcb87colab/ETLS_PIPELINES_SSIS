  <DTS:Executables>
    <DTS:Executable
      DTS:refId="Package\ACTUALIZA ZONA A DIM"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{E1A6E230-0274-48B1-A18D-FFD4185AAB4D}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="ACTUALIZA ZONA A DIM"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="1">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{57E6F15A-0984-4D7E-A335-3C620BDD84C4}"
          SQLTask:SqlStatementSource="--- zonas base con datos por default en NO DISPONIBLE&#xA;/*&#xA;TRUNCATE TABLE [DIM].[CIUDADES_MOVIMIENTOS_MOVILIZADOS_ZONA]&#xA;GO&#xA;INSERT INTO [DIM].[CIUDADES_MOVIMIENTOS_MOVILIZADOS_ZONA]&#xA;SELECT CM.*,&#xA;CONCAT(ISNULL([ID_CIUDAD],0),'-NO DISPONIBLE' ) AS ID_CIUDAD_ZONA,&#xA;'NO DISPONIBLE' AS ZONA&#xA;FROM DIM.CIUDADES_MOVIMIENTOS_MOVILIZADOS AS CM WITH(NOLOCK)&#xA;*/&#xA;/*************************************************************************************************/&#xA;/*************************************************************************************************/&#xA;/*************************************************************************************************/&#xA;DROP TABLE IF EXISTS #CIUDADES_ZONAS;&#xA;SELECT &#xA;T.ID_PAIS, T.ID_CIUDAD, T.ZONA , T.ID_CIUDAD_ZONA&#xA;INTO #CIUDADES_ZONAS&#xA;FROM (&#xA; SELECT &#xA;  ISNULL(EM.ID_CIUDAD_ORIGEN,0) AS ID_CIUDAD&#xA;  , ISNULL(EM.ID_PAIS_ORIGEN,0) AS ID_PAIS&#xA;  , ISNULL(ID_CODIGO_ZONA_ORIG,'NO DISPONIBLE') AS ZONA&#xA;  , CONCAT(ISNULL(EM.ID_CIUDAD_ORIGEN,0),'-',ISNULL(ID_CODIGO_ZONA_ORIG,'NO DISPONIBLE') ) AS ID_CIUDAD_ZONA&#xA; FROM SIG_COL_LOGISTICA_DW.TMP.ENVIOS_MOV EM WITH (NOLOCK) &#xA; GROUP BY  ISNULL(EM.ID_CIUDAD_ORIGEN,0),&#xA;  ID_CODIGO_ZONA_ORIG, &#xA;  EM.ID_PAIS_ORIGEN&#xA; UNION ALL&#xA; SELECT &#xA;  ISNULL(EM.ID_CIUDAD_DESTINO,0) AS ID_CIUDAD&#xA;  , ISNULL(EM.ID_PAIS_DESTINO, 0) AS ID_PAIS&#xA;  , ISNULL(ID_CODIGO_ZONA_DEST,'NO DISPONIBLE')  AS ZONA&#xA;  , CONCAT(ISNULL(EM.ID_CIUDAD_DESTINO,0),'-',ISNULL(ID_CODIGO_ZONA_DEST,'NO DISPONIBLE') ) AS ID_CIUDAD_ZONA&#xA; FROM SIG_COL_LOGISTICA_DW.TMP.ENVIOS_MOV EM WITH (NOLOCK) &#xA; GROUP BY  ISNULL(EM.ID_CIUDAD_DESTINO,0),&#xA;  ID_CODIGO_ZONA_DEST, &#xA;  EM.ID_PAIS_DESTINO&#xA;) AS T&#xA;GROUP BY T.ID_PAIS, T.ID_CIUDAD, T.ID_CIUDAD_ZONA, T.ZONA&#xA;ORDER BY ID_CIUDAD, ID_CIUDAD_ZONA&#xA;&#xA;&#xA;/*************************************************************************************************/&#xA;DROP TABLE IF EXISTS #TBL_CIUDADES_ZONAS;&#xA;&#xA;SELECT CM.*, CZ.ID_CIUDAD_ZONA, CZ.ZONA &#xA; INTO #TBL_CIUDADES_ZONAS&#xA;FROM DIM.CIUDADES_MOVIMIENTOS_MOVILIZADOS AS CM WITH(NOLOCK)&#xA;INNER  JOIN #CIUDADES_ZONAS AS CZ &#xA;ON CM.ID_PAIS = CZ.ID_PAIS AND CM.ID_CIUDAD = CZ.ID_CIUDAD&#xA;&#xA;&#xA;/*************************************************************************************************/&#xA;MERGE [DIM].[CIUDADES_MOVIMIENTOS_MOVILIZADOS_ZONA] AS target&#xA;USING #TBL_CIUDADES_ZONAS AS source&#xA;ON  target.[ID_PAIS]  = source.[ID_PAIS] AND target.[ID_CIUDAD]  = source.[ID_CIUDAD]  AND  target.[ID_CIUDAD_ZONA]  = source.[ID_CIUDAD_ZONA]&#xA;WHEN MATCHED     AND target.ID_CIUDAD_ZONA  &lt;&gt;  source.ID_CIUDAD_ZONA&#xA;&#x9;OR (&#x9;target.[ID_PAIS]  &lt;&gt; source.[ID_PAIS]&#xA;&#x9;&#x9;OR&#x9;target.[ID_CIUDAD]  &lt;&gt; source.[ID_CIUDAD]&#xA;&#x9;&#x9;OR&#x9;target.[ID_REGIONAL]  &lt;&gt; source.[ID_REGIONAL]&#xA;&#x9;&#x9;OR&#x9;target.ZONA  &lt;&gt; source.ZONA&#xA;&#x9;) THEN&#xA;    UPDATE &#xA; SET  target.[ID_PAIS]  = source.[ID_PAIS]&#xA;  ,target.[ID_CIUDAD]  = source.[ID_CIUDAD]&#xA;  ,target.[NOMBRE_CIUDAD]  = source.[NOMBRE_CIUDAD]&#xA;  ,target.[CLASE_SISTEMA]  = source.[CLASE_SISTEMA]&#xA;  ,target.[ID_REGIONAL]  = source.[ID_REGIONAL]&#xA;  ,target.[NOMBRE_REGIONAL]  = source.[NOMBRE_REGIONAL]&#xA;  ,target.[FECHA_ACTUALIZACION]  = source.[FECHA_ACTUALIZACION]&#xA;  ,target.[NOMBRE_CPL]  = source.[NOMBRE_CPL]&#xA;  ,target.ID_CIUDAD_ZONA  = source.ID_CIUDAD_ZONA&#xA;  ,target.ZONA  = source.ZONA&#xA;&#xA;WHEN NOT MATCHED THEN&#xA;    INSERT (&#xA;  [ID_PAIS]&#xA;  ,[ID_CIUDAD]&#xA;  ,[NOMBRE_CIUDAD]&#xA;  ,[CLASE_SISTEMA]&#xA;  ,[ID_REGIONAL]&#xA;  ,[NOMBRE_REGIONAL]&#xA;  ,[FECHA_ACTUALIZACION]&#xA;  ,[NOMBRE_CPL]&#xA;  ,ID_CIUDAD_ZONA&#xA;  ,ZONA&#xA; )&#xA; VALUES(  source.[ID_PAIS]&#xA;   ,source.[ID_CIUDAD]&#xA;   ,source.[NOMBRE_CIUDAD]&#xA;   ,source.[CLASE_SISTEMA]&#xA;   ,source.[ID_REGIONAL]&#xA;   ,source.[NOMBRE_REGIONAL]&#xA;   ,source.[FECHA_ACTUALIZACION]&#xA;   ,source.[NOMBRE_CPL]&#xA;   ,source.ID_CIUDAD_ZONA&#xA;   ,source.ZONA&#xA;  );&#xA;/*************************************************************************************************/&#xA;&#xA;DROP TABLE IF EXISTS #CIUDADES_ZONAS;&#xA;DROP TABLE IF EXISTS #TBL_CIUDADES_ZONAS;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\BORRAR FAC ENVIOS MOV P06_SISMILENIO_EXTRAER_ENVIOS_MOVILIZADOS_FAC_SP"
