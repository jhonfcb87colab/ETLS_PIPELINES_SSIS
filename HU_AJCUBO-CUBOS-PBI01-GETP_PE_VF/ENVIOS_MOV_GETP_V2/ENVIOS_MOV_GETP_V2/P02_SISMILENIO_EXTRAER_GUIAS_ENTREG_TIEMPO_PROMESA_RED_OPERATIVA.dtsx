                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=15.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT S.NUMERO_GUIA,S.ID_PROCESO,S.ID_CONCEPTO,S.FECHA_HORA_MOVIMIENTO FROM TMP.PROMESA T WITH (NOLOCK)

