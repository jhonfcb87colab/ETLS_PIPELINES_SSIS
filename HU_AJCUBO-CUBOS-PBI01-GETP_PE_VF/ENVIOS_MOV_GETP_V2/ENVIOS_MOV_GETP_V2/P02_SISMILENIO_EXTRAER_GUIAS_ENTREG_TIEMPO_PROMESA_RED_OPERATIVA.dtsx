	,EV.ID_DOCU_ULT_MOVI
	,EV.ID_MEDTRANS
	,EV.ID_PRODUCTO
	,EV.ID_SUBPRODUCTO
	,EV.ID_ESTADOGUIA
	,EV.ID_TIEMPO_ENTREGA
	,EV.ID_REQ_EMBALAJE
	,EV.NUMERO_PIEZAS
	,EV.FECHA_ENTREGA
	,EV.FECHA_MODIFICACION
FROM 
	SIG_COL_LOGISTICA_DW.TMP.ENVIOS_MOV EV WITH(NOLOCK)
LEFT OUTER JOIN
	SIG_COLOMBIA_DW.TMP.PROMESA PR WITH (NOLOCK)
ON
	EV.NUMERO_GUIA = PR.NUMERO_GUIA
WHERE
	PR.NUMERO_GUIA IS NULL
AND
	(EV.FECHA_ENVIO &gt;= ? AND EV.FECHA_ENVIO &lt; ?)</property>
