                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=15.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">WITH CTE
(
	ID
	,[ID_PAIS]
	,[ID_CIUDAD]
	,[HORA_CONTROL_MAXIMO_LLEGADA]
)
AS
(
SELECT
	ROW_NUMBER() OVER(PARTITION BY [ID_PAIS], [ID_CIUDAD] ORDER BY [HORA_CONTROL_MAXIMO_LLEGADA] DESC) ID
	,[ID_PAIS]
	,[ID_CIUDAD]
	,[HORA_CONTROL_MAXIMO_LLEGADA]

FROM	
		[PAR].[CENTROS_LOGISTICOS] WITH (NOLOCK)
WHERE
		[HORA_CONTROL_MAXIMO_LLEGADA] &gt; '00:00:00'

)
SELECT

	[ID_PAIS]
   ,[ID_CIUDAD]
   ,[HORA_CONTROL_MAXIMO_LLEGADA]
FROM
	CTE WITH (NOLOCK)
WHERE ID =1</property>
