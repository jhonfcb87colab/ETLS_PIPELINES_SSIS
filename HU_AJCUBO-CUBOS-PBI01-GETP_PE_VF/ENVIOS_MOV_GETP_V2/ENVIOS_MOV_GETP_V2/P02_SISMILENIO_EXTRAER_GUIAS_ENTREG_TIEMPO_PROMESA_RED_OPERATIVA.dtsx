                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=15.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT * FROM
(
SELECT 
	  ROW_NUMBER() OVER(PARTITION BY NUMERO_GUIA,FECHA_HORA_MOVIMIENTO ORDER BY FECHA_HORA_MOVIMIENTO DESC) ROW
	 ,NUMERO_GUIA
	 ,ID_PROCESO
	 ,ID_CONCEPTO
	 ,FECHA_HORA_MOVIMIENTO 
FROM TMP.PROMESA_PRC_1 WITH (NOLOCK) 
) T
