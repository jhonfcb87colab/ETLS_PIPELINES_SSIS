                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=15.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT
			 ID_PROCESO
			,NUMERO_MOVIMI
			,CONSECUT_MOVIMI
			,PLACA_VEHICULO_DOCU
			,ISNULL(SUM(CONVERT(INT,ROUND((CONVERT(FLOAT,DATEDIFF(MINUTE,[FECHA_NOVEDAD],ISNULL([FECHA_HORA_FIN_NOVEDAD],GETDATE()))) / 60),0))),0) ND_HORAS
		FROM
			TMP.PROMESA_NDBASE ND WITH(NOLOCK)
		GROUP BY
			 ID_PROCESO
			,NUMERO_MOVIMI
			,CONSECUT_MOVIMI
			,PLACA_VEHICULO_DOCU</property>
