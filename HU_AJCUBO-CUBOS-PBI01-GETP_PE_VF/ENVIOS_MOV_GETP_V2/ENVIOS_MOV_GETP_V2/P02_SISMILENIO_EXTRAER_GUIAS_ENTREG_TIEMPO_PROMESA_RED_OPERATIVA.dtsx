(
SELECT 
		
	ROW_NUMBER() OVER(PARTITION BY CONSECUT_MOVIMI,NUMERO_MOVIMI ORDER BY FECHA_HORA_MOVIMIENTO DESC) R	
	,ID_PROCESO
	,CONSECUT_MOVIMI
	,NUMERO_MOVIMI
	,PLACA_VEHICULO_DOCU
    ,ID_PAIS_DESTINO
    ,ID_CIUDAD_DESTINO			
 FROM TMP.PROMESA_ND02_01 WITH (NOLOCK) 
 )T WHERE T.R =1</property>
