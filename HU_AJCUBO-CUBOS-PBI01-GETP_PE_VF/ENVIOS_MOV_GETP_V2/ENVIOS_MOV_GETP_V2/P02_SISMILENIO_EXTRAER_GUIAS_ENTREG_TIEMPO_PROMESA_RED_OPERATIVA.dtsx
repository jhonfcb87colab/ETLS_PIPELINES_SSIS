          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{D5F2C835-5AAE-435B-B7C6-E667BD13D3B7}"
              SQLTask:SqlStatementSource="UPDATE A    &#xA;  SET A.FECHA_VIGENTE = RA.FECHA_VIGENTE&#xA;FROM TMP.PROMESA A&#xA;  INNER JOIN TMP.PROMESA_FECHA RA&#xA;    ON CONVERT(DATETIME,CONVERT(DATE,A.FECHA)) = RA.FECHA_ENVIO WHERE A.ID_TIEMPO_ENTREGA = 3" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\EXTRACCION PROMESA\INSERT MODALIDAD_PAGO_TMP_PROMESA"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
