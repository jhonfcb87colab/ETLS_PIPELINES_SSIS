                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=15.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT [NUMERO_GUIA]
      ,[FECHA]
      ,[ID_PAIS_ORIGEN]
      ,[ID_CIUDAD_ORIGEN]
      ,[ID_PAIS_DESTINO]
      ,[ID_CIUDAD_DESTINO]
      ,[ID_TIPOGUIA]
      ,[ID_CLIENTE]
      ,[ID_ESTADOENVIO]
      ,[ID_DOCU_ULT_MOVI]
      ,[ID_MEDTRANS]
      ,[ID_PRODUCTO]
      ,[ID_SUBPRODUCTO]
      ,[ID_ESTADOGUIA]
      ,[ID_TIEMPO_ENTREGA]
      ,[ID_REQ_EMBALAJE]
      ,[NUMERO_PIEZAS]
      ,[FECHA_ENTREGA]
      ,[FECHA_MODIFICACION]
  FROM [TMP].[PROMESA_2] WITH (NOLOCK)
  WHERE	ID_DOCU_ULT_MOVI &gt;= 4 -- ID_PROCESO
		AND (	(LEFT(NUMERO_GUIA,1) IN (1,2,5,7,9) AND LEN(NUMERO_GUIA) &gt;= 9) 
				OR (LEFT(NUMERO_GUIA,1) IN (3,4) AND LEN(NUMERO_GUIA) &gt;= 8) 
			)</property>
