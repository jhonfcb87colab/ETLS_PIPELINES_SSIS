          DTS:DTSID="{B128342F-23DE-402E-947A-1F20F850AEA5}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="INSERT MODALIDAD_PAGO_TMP_PROMESA"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{83B6FE3B-4B7A-457E-AC1D-739D7AB8C1CD}"
              SQLTask:SqlStatementSource="WITH CTE&#xA;(&#xA;&#x9; NUMERO_GUIA&#xA;&#x9;,ID_TIPO_COBRO&#xA;)&#xA;AS&#xA;&#x9;(&#xA;&#x9;&#x9;SELECT&#xA;&#x9;&#x9;&#x9; PR.NUMERO_GUIA&#xA;&#x9;&#x9;&#x9;,GR.ID_TIPO_COBRO&#xA;&#x9;&#x9;FROM &#xA;&#x9;&#x9;&#x9;TMP.PROMESA PR  WITH (NOLOCK)&#xA;&#x9;&#x9;INNER JOIN &#xA;&#x9;&#x9;&#x9;LOG.GUIA_RECAUDO GR WITH (NOLOCK)&#xA;&#x9;&#x9;ON&#xA;&#x9;&#x9;&#x9;PR.NUMERO_GUIA = GR.NUMERO_GUIA&#xA;&#x9;)&#xA;UPDATE&#xA;&#x9;[TMP].[PROMESA]&#xA;SET &#xA;&#x9;GR_ID_TIPO_COBRO =  CASE WHEN CTE.ID_TIPO_COBRO = 1 THEN 1 ELSE 2 END&#xA;FROM &#xA;&#x9; [TMP].[PROMESA] PR WITH (NOLOCK)&#xA;&#x9;,CTE&#xA;WHERE &#xA;&#x9;PR.NUMERO_GUIA = CTE.NUMERO_GUIA" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
