      ,[ID_PAIS_DESTINO]
      ,[ID_CIUDAD_DESTINO]
      ,[HORA_CONTROL_MAXIMO_LLEGADA]
  FROM [TMP].[PROMESA_ND03_01] WITH (NOLOCK)
) T WHERE T.ID =1</property>
