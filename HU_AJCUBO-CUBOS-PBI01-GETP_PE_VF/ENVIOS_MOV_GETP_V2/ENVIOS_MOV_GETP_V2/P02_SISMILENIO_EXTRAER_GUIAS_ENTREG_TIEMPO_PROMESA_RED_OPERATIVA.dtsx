      ,[NUMERO_PIEZAS]
      ,[FECHA_ENTREGA]
      ,[FECHA_MODIFICACION]
  FROM [TMP].[PROMESA_3] WITH (NOLOCK)
) T
WHERE T.ROW =1</property>
