    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{56E4BA8D-CEE1-4FAD-B6FF-DF022BAF4225}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="(DT_DATE) @[$Project::FULL_FACH_FIN] == (DT_DATE) &quot;1900-01-01&quot;?&#xA; &#xA;(DT_WSTR,10)((DT_WSTR,4)YEAR(DATEADD(&quot;DD&quot;, 1 ,GETDATE()))+&quot;-&quot;+RIGHT(&quot;0&quot;+(DT_WSTR,2)MONTH(DATEADD(&quot;DD&quot;,1,GETDATE())),2)+&quot;-&quot;+RIGHT(&quot;0&quot;+(DT_WSTR,2)DAY(DATEADD(&quot;DD&quot;,1,GETDATE())),2))&#xA;&#xA;: @[$Project::FULL_FACH_FIN]"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="FechaFin">
      <DTS:VariableValue
        DTS:DataType="8">2026-10-01</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{F451AC5D-BB72-42E7-8F6A-D59C7586CBBC}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="(DT_DATE)   @[$Project::FULL_FACH_INI]    == (DT_DATE) &quot;1900-01-01&quot;? &#xA;&#xA;(DT_WSTR,10)((DT_WSTR,4)YEAR(DATEADD(&quot;DD&quot;, - @[$Project::DiaIni], GETDATE()))+&quot;-&quot;&#xA;+RIGHT(&quot;0&quot;+(DT_WSTR,2)MONTH(DATEADD(&quot;DD&quot;,-@[$Project::DiaIni],GETDATE() )),2)+&quot;-&quot;&#xA;+RIGHT(&quot;0&quot;+(DT_WSTR,2)DAY(DATEADD(&quot;DD&quot;, -@[$Project::DiaIni],GETDATE() )),2))&#xA;:  @[$Project::FULL_FACH_INI]"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="FechaIni">
      <DTS:VariableValue
        DTS:DataType="8">2026-09-01</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{02EE7071-D45C-456F-8590-2A90A4F0F07E}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot;  DECLARE @FECHA_INICIO DATETIME  = CONVERT(VARCHAR,CONVERT(DATETIME,CONVERT(CHAR(11),  '&quot;+ @[User::FechaIni]   +&quot;'   )),120);&#xA;  DECLARE @FECHA_FIN&#x9;  DATETIME  = CONVERT(VARCHAR,CONVERT(DATETIME,CONVERT(CHAR(11),  '&quot;+  @[User::FechaFin]  +&quot;' )),120);&#xA;&#xA;&#xA;;WITH CTE&#xA;(&#xA;&#x9;&#x9; NUMERO_GUIA&#xA;&#x9;&#x9;,FECHA&#xA;&#x9;&#x9;,ID_PAIS_ORIGEN&#xA;&#x9;&#x9;,ID_CIUDAD_ORIGEN&#xA;&#x9;&#x9;,ID_PAIS_DESTINO&#xA;&#x9;&#x9;,ID_CIUDAD_DESTINO&#xA;&#x9;&#x9;,ID_TIPOGUIA&#xA;&#x9;&#x9;,ID_CLIENTE&#xA;&#x9;&#x9;,ID_ESTADOENVIO&#xA;&#x9;&#x9;,ID_DOCU_ULT_MOVI&#xA;&#x9;&#x9;,ID_MEDTRANS&#xA;&#x9;&#x9;,ID_PRODUCTO&#xA;&#x9;&#x9;,ID_SUBPRODUCTO&#xA;&#x9;&#x9;,ID_ESTADOGUIA&#xA;&#x9;&#x9;,ID_TIEMPO_ENTREGA&#xA;&#x9;&#x9;,ID_REQ_EMBALAJE&#xA;&#x9;&#x9;,NUMERO_PIEZAS&#xA;&#x9;&#x9;,FECHA_ENTREGA&#xA;&#x9;&#x9;,FECHA_MODIFICACION&#xA;)&#xA;AS&#xA;(&#xA;&#x9;SELECT &#xA;&#x9;&#x9; EV.NUMERO_GUIA&#xA;&#x9;&#x9;,EV.FECHA_ENVIO AS FECHA&#xA;&#x9;&#x9;,EV.ID_PAIS_ORIGEN&#xA;&#x9;&#x9;,EV.ID_CIUDAD_ORIGEN&#xA;&#x9;&#x9;,EV.ID_PAIS_DESTINO&#xA;&#x9;&#x9;,EV.G_ID_CIUDAD_DESTINO AS ID_CIUDAD_DESTINO&#xA;&#x9;&#x9;,EV.ID_TIPOGUIA&#xA;&#x9;&#x9;,EV.ID_CLIENTE&#xA;&#x9;&#x9;,EV.ID_ESTADOENVIO&#xA;&#x9;&#x9;,EV.ID_DOCU_ULT_MOVI&#xA;&#x9;&#x9;,EV.ID_MEDTRANS&#xA;&#x9;&#x9;,EV.ID_PRODUCTO&#xA;&#x9;&#x9;,EV.ID_SUBPRODUCTO&#xA;&#x9;&#x9;,EV.ID_ESTADOGUIA&#xA;&#x9;&#x9;,EV.ID_TIEMPO_ENTREGA&#xA;&#x9;&#x9;,EV.ID_REQ_EMBALAJE&#xA;&#x9;&#x9;,EV.NUMERO_PIEZAS&#xA;&#x9;&#x9;,EV.FECHA_ENTREGA&#xA;&#x9;&#x9;,EV.FECHA_MODIFICACION&#xA;&#x9;FROM &#xA;&#x9;&#x9;SIG_COL_LOGISTICA_DW.TMP.ENVIOS_MOV EV WITH(NOLOCK)&#xA;)&#xA;INSERT INTO [TMP].[PROMESA]&#xA;           ([NUMERO_GUIA]&#xA;           ,[FECHA]&#xA;           ,[ID_PAIS_ORIGEN]&#xA;           ,[ID_CIUDAD_ORIGEN]&#xA;           ,[ID_PAIS_DESTINO]&#xA;           ,[ID_CIUDAD_DESTINO]&#xA;           ,[ID_TIPOGUIA]&#xA;           ,[ID_CLIENTE]&#xA;           ,[ID_ESTADOENVIO]&#xA;           ,[ID_DOCU_ULT_MOVI]&#xA;           ,[ID_MEDTRANS]&#xA;           ,[ID_PRODUCTO]&#xA;           ,[ID_SUBPRODUCTO]&#xA;           ,[ID_ESTADOGUIA]&#xA;           ,[ID_TIEMPO_ENTREGA]&#xA;           ,[ID_REQ_EMBALAJE]&#xA;           ,[NUMERO_PIEZAS]&#xA;           ,[FECHA_ENTREGA]&#xA;           ,[FECHA_MODIFICACION]   )&#xA;SELECT&#xA;&#x9; CTE.NUMERO_GUIA&#xA;&#x9;,CTE.FECHA&#xA;&#x9;,CTE.ID_PAIS_ORIGEN&#xA;&#x9;,CTE.ID_CIUDAD_ORIGEN&#xA;&#x9;,CTE.ID_PAIS_DESTINO&#xA;&#x9;,CTE.ID_CIUDAD_DESTINO&#xA;&#x9;,CTE.ID_TIPOGUIA&#xA;&#x9;,CTE.ID_CLIENTE&#xA;&#x9;,CTE.ID_ESTADOENVIO&#xA;&#x9;,CTE.ID_DOCU_ULT_MOVI&#xA;&#x9;,CTE.ID_MEDTRANS&#xA;&#x9;,CTE.ID_PRODUCTO&#xA;&#x9;,CTE.ID_SUBPRODUCTO&#xA;&#x9;,CTE.ID_ESTADOGUIA&#xA;&#x9;,CTE.ID_TIEMPO_ENTREGA&#xA;&#x9;,CTE.ID_REQ_EMBALAJE&#xA;&#x9;,CTE.NUMERO_PIEZAS&#xA;&#x9;,CTE.FECHA_ENTREGA&#xA;&#x9;,CTE.FECHA_MODIFICACION&#x9;&#xA;FROM &#xA;&#x9;CTE&#xA;LEFT OUTER JOIN&#xA;&#x9;SIG_COLOMBIA_DW.TMP.PROMESA PR WITH (NOLOCK)&#xA;ON&#xA;&#x9;CTE.NUMERO_GUIA = PR.NUMERO_GUIA&#xA;WHERE&#xA;&#x9;PR.NUMERO_GUIA IS NULL&#xA;AND&#xA;&#x9;(CTE.FECHA &gt;= @FECHA_INICIO     AND    CTE.FECHA &lt;     @FECHA_FIN    )  &quot;"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="TSQL_GUIAS">
      <DTS:VariableValue
        DTS:DataType="8">  DECLARE @FECHA_INICIO DATETIME  = CONVERT(VARCHAR,CONVERT(DATETIME,CONVERT(CHAR(11),  '2026-09-01'   )),120);
  DECLARE @FECHA_FIN	  DATETIME  = CONVERT(VARCHAR,CONVERT(DATETIME,CONVERT(CHAR(11),  '2026-10-01' )),120);


;WITH CTE
(
		 NUMERO_GUIA
		,FECHA
		,ID_PAIS_ORIGEN
		,ID_CIUDAD_ORIGEN
		,ID_PAIS_DESTINO
		,ID_CIUDAD_DESTINO
		,ID_TIPOGUIA
		,ID_CLIENTE
		,ID_ESTADOENVIO
		,ID_DOCU_ULT_MOVI
		,ID_MEDTRANS
		,ID_PRODUCTO
		,ID_SUBPRODUCTO
		,ID_ESTADOGUIA
		,ID_TIEMPO_ENTREGA
		,ID_REQ_EMBALAJE
		,NUMERO_PIEZAS
		,FECHA_ENTREGA
		,FECHA_MODIFICACION
)
AS
(
	SELECT 
		 EV.NUMERO_GUIA
		,EV.FECHA_ENVIO AS FECHA
		,EV.ID_PAIS_ORIGEN
		,EV.ID_CIUDAD_ORIGEN
		,EV.ID_PAIS_DESTINO
		,EV.G_ID_CIUDAD_DESTINO AS ID_CIUDAD_DESTINO
		,EV.ID_TIPOGUIA
		,EV.ID_CLIENTE
		,EV.ID_ESTADOENVIO
		,EV.ID_DOCU_ULT_MOVI
		,EV.ID_MEDTRANS
		,EV.ID_PRODUCTO
		,EV.ID_SUBPRODUCTO
		,EV.ID_ESTADOGUIA
		,EV.ID_TIEMPO_ENTREGA
		,EV.ID_REQ_EMBALAJE
		,EV.NUMERO_PIEZAS
		,EV.FECHA_ENTREGA
		,EV.FECHA_MODIFICACION
	FROM 
		SIG_COL_LOGISTICA_DW.TMP.ENVIOS_MOV EV WITH(NOLOCK)
)
INSERT INTO [TMP].[PROMESA]
           ([NUMERO_GUIA]
           ,[FECHA]
           ,[ID_PAIS_ORIGEN]
           ,[ID_CIUDAD_ORIGEN]
           ,[ID_PAIS_DESTINO]
           ,[ID_CIUDAD_DESTINO]
           ,[ID_TIPOGUIA]
           ,[ID_CLIENTE]
           ,[ID_ESTADOENVIO]
           ,[ID_DOCU_ULT_MOVI]
           ,[ID_MEDTRANS]
           ,[ID_PRODUCTO]
           ,[ID_SUBPRODUCTO]
           ,[ID_ESTADOGUIA]
           ,[ID_TIEMPO_ENTREGA]
           ,[ID_REQ_EMBALAJE]
           ,[NUMERO_PIEZAS]
           ,[FECHA_ENTREGA]
           ,[FECHA_MODIFICACION]   )
SELECT
	 CTE.NUMERO_GUIA
	,CTE.FECHA
	,CTE.ID_PAIS_ORIGEN
	,CTE.ID_CIUDAD_ORIGEN
	,CTE.ID_PAIS_DESTINO
	,CTE.ID_CIUDAD_DESTINO
	,CTE.ID_TIPOGUIA
	,CTE.ID_CLIENTE
	,CTE.ID_ESTADOENVIO
	,CTE.ID_DOCU_ULT_MOVI
	,CTE.ID_MEDTRANS
	,CTE.ID_PRODUCTO
	,CTE.ID_SUBPRODUCTO
	,CTE.ID_ESTADOGUIA
	,CTE.ID_TIEMPO_ENTREGA
	,CTE.ID_REQ_EMBALAJE
	,CTE.NUMERO_PIEZAS
	,CTE.FECHA_ENTREGA
	,CTE.FECHA_MODIFICACION	
FROM 
	CTE
LEFT OUTER JOIN
	SIG_COLOMBIA_DW.TMP.PROMESA PR WITH (NOLOCK)
ON
	CTE.NUMERO_GUIA = PR.NUMERO_GUIA
WHERE
	PR.NUMERO_GUIA IS NULL
AND
	(CTE.FECHA &gt;= @FECHA_INICIO     AND    CTE.FECHA &lt;     @FECHA_FIN    )  </DTS:VariableValue>
    </DTS:Variable>
  </DTS:Variables>
