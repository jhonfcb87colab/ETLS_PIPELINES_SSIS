          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{83B6FE3B-4B7A-457E-AC1D-739D7AB8C1CD}"
              SQLTask:SqlStatementSource="WITH CTE&#xA;(&#xA;&#x9; [ID_PROCESO]&#xA;&#x9;,[NUMERO_MOVIMI]&#xA;&#x9;,[CONSECUT_MOVIMI]&#xA;&#x9;,[PLACA_VEHICULO_DOCU]&#xA;&#x9;,[FECHA_HORA_ENTRADA_CIL]&#xA;)&#xA;AS&#xA;(&#xA;&#x9;SELECT&#xA;&#x9;&#x9; [ID_PROCESO]&#xA;&#x9;&#x9;,[NUMERO_MOVIMI]&#xA;&#x9;&#x9;,[CONSECUT_MOVIMI]&#xA;&#x9;&#x9;,[PLACA_VEHICULO_DOCU]&#xA;&#x9;&#x9;,MAX([FECHA_HORA_ENTRADA_CIL]) [FECHA_HORA_ENTRADA_CIL]&#xA;&#x9;FROM&#xA;&#x9;&#x9;TMP.PROMESA_NDBASE&#xA;&#x9;GROUP BY&#xA;&#x9;&#x9; [ID_PROCESO]&#xA;&#x9;&#x9;,[NUMERO_MOVIMI]&#xA;&#x9;&#x9;,[CONSECUT_MOVIMI]&#xA;&#x9;&#x9;,[PLACA_VEHICULO_DOCU]&#xA;)&#xA;&#xA;UPDATE &#xA;&#x9;&#x9;TMP.PROMESA_ND04_01&#xA;SET&#xA;&#x9;&#x9;FECHA_HORA_ENTRADA_CIL = ND.FECHA_HORA_ENTRADA_CIL&#xA;FROM&#xA;&#x9;&#x9;TMP.PROMESA_ND04_01 SE&#xA;INNER JOIN&#xA;&#x9;&#x9;CTE ND&#xA;ON&#xA;SE.[ID_PROCESO] = ND.[ID_PROCESO] AND&#xA;SE.[NUMERO_MOVIMI] = ND.[NUMERO_MOVIMI] AND&#xA;SE.[CONSECUT_MOVIMI] = ND.[CONSECUT_MOVIMI] AND&#xA;SE.[PLACA_VEHICULO_DOCU] = ND.[PLACA_VEHICULO_DOCU]" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
