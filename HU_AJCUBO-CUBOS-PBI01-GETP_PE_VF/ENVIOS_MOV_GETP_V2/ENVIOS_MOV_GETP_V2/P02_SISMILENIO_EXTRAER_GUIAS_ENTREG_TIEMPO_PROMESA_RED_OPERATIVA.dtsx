                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=15.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT 
	 T.NUMERO_GUIA
	,T.FECHA_HORA_MOVIMIENTO
	,T.ID_PROCESO
	,D.CONSECUT_MOVIMI
	,D.NUMERO_MOVIMI
	,D.PLACA_VEHICULO_DOCU
	,D.ID_PAIS_DESTINO
	,D.ID_CIUDAD_DESTINO
FROM
	TMP.PROMESA_ND01 T WITH (NOLOCK)
INNER JOIN
	LOG.DOCUMENTOS D WITH (NOLOCK)
ON
	D.ID_PROCESO = 12
AND
	D.NUMERO_MOVIMI COLLATE SQL_Latin1_General_CP850_CI_AI =  T.NUMERO_MOVIMI  COLLATE SQL_Latin1_General_CP850_CI_AI
AND
	D.CONSECUT_MOVIMI = T.CONSECUT_MOVIMI</property>
