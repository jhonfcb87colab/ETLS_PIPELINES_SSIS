                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=15.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">WITH CTE
(
	FECHA_HORA_MOVIMIENTO
    ,NUMERO_GUIA
)
AS
(
SELECT	
	MIN(FECHA_HORA_MOVIMIENTO) AS FECHA_HORA_MOVIMIENTO
                                 ,NUMERO_GUIA
FROM LOG.SEGUIMIENTO_ENVIO  WITH (NOLOCK)

WHERE FECHA_HORA_MOVIMIENTO &gt;=  ?
AND FECHA_HORA_MOVIMIENTO &lt;  ?
	AND(ID_PROCESO = 5 OR ID_PROCESO = 6) 
GROUP BY NUMERO_GUIA
) 

	SELECT T.NUMERO_GUIA,T.[FECHA_HORA_MOVIMIENTO]  FROM
(
SELECT 
       ROW_NUMBER() OVER(PARTITION BY NUMERO_GUIA ORDER BY FECHA_HORA_MOVIMIENTO ASC) R
	  ,NUMERO_GUIA
	  ,[ID_PROCESO]  
      ,[FECHA_HORA_MOVIMIENTO]      
  FROM [LOG].[SEGUIMIENTO_ENVIO] WITH (NOLOCK)
  WHERE (ID_PROCESO = 5 OR ID_PROCESO = 6)   
) T 

INNER JOIN
			CTE
ON 
T.NUMERO_GUIA = CTE.NUMERO_GUIA AND
T.FECHA_HORA_MOVIMIENTO = CTE.FECHA_HORA_MOVIMIENTO
WHERE T.R = 1</property>
