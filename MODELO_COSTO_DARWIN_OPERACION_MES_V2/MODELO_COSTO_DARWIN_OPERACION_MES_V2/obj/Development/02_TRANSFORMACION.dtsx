        <DTS:Executable
          DTS:refId="Package\Pasos Extraccion y preparacion de datos\Paso 1-0 1 Script para copiar los datos de los documentos de mece a tmp_borrar"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{a2710552-1671-4f7a-86bd-3e6e9e4264c0}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Paso 1-0 1 Script para copiar los datos de los documentos de mece a tmp_borrar"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="1">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{A3A65FF9-9058-4FB8-AA1A-7AABA464327A}"
              SQLTask:SqlStatementSource="&#xA;TRUNCATE TABLE TMP_BORRAR_LOCAL.DBO.DOCUMENTOS_MECE_LOGISTICO_RED_OPERATIVA&#xA;&#xA;INSERT INTO TMP_BORRAR_LOCAL.DBO.DOCUMENTOS_MECE_LOGISTICO_RED_OPERATIVA (&#xA;ID_PROCESO,&#xA;NUMERO_MOVIMI,&#xA;CONSECUT_MOVIMI,&#xA;PLACA_VEHICULO_DOCU,&#xA;FECHA_HORA_MOVIMI,&#xA;PESO_TOTAL,&#xA;TOTAL_ENVIOS,&#xA;ID_PAIS_ZONA_URBA,&#xA;ID_CIUDAD_ZONA_URBA,&#xA;ID_TIPO_ZONA_URBA,&#xA;ID_ZONA_URBA,&#xA;ID_PAIS_DIVISION_ORIGEN,&#xA;ID_CIUDAD_DIVISION_ORIGEN,&#xA;ID_PAIS_DESTINO,&#xA;ID_CIUDAD_DESTINO,&#xA;ID_AUXILIAR1_VEHICULO,&#xA;ID_AUXILIAR2_VEHICULO,&#xA;ID_COURIER_CONDUCTOR,&#xA;ID_PAIS_CANAL,&#xA;ID_CIUDAD_CANAL,&#xA;ID_CANAL)&#xA;SELECT &#xA;ID_PROCESO,&#xA;NUMERO_MOVIMI,&#xA;CONSECUT_MOVIMI,&#xA;PLACA_VEHICULO_DOCU,&#xA;FECHA_HORA_MOVIMI,&#xA;PESO_TOTAL,&#xA;TOTAL_ENVIOS,&#xA;ID_PAIS_ZONA_URBA,&#xA;ID_CIUDAD_ZONA_URBA,&#xA;ID_TIPO_ZONA_URBA,&#xA;ID_ZONA_URBA,&#xA;ID_PAIS_DIVISION_ORIGEN,&#xA;ID_CIUDAD_DIVISION_ORIGEN,&#xA;ID_PAIS_DESTINO,&#xA;ID_CIUDAD_DESTINO,&#xA;ID_AUXILIAR1_VEHICULO,&#xA;ID_AUXILIAR2_VEHICULO,&#xA;ID_COURIER_CONDUCTOR,&#xA;ID_PAIS_CANAL,&#xA;ID_CIUDAD_CANAL,&#xA;ID_CANAL&#xA;FROM MECE_LOGISTICO.DBO.DOCUMENTOS (NOLOCK)&#xA;WHERE ID_PROCESO IN (2,5,6,7,8,9,10,11,12,14,15,16,19,24,25,27,30,31,32)&#xA;-------AND FECHA_HORA_MOVIMI &gt;= '20240101'-- and FECHA_HORA_MOVIMI &lt;= '20240401'&#xA;AND FECHA_HORA_MOVIMI &gt;= ? and FECHA_HORA_MOVIMI &lt;=  ?&#xA;&#xA;&#xA;--CREATE NONCLUSTERED INDEX IX_PROCESO_DOCUMENTOS_MECE_LOGISTICO_RED_OPERATIVA ON TMP_BORRAR_LOCAL.DBO.DOCUMENTOS_MECE_LOGISTICO_RED_OPERATIVA (ID_PROCESO, NUMERO_MOVIMI, CONSECUT_MOVIMI)&#xA;--CREATE NONCLUSTERED INDEX IX_PROCESO_PLACA_FECHA_DOCUMENTOS_MECE_LOGISTICO_RED_OPERATIV ON TMP_BORRAR_LOCAL.DBO.DOCUMENTOS_MECE_LOGISTICO_RED_OPERATIVA (ID_PROCESO, PLACA_VEHICULO_DOCU, FECHA_HORA_MOVIMI)&#xA;--CREATE NONCLUSTERED INDEX IX_PLACA_FECHA_DOCUMENTOS_MECE_LOGISTICO_RED_OPERATIV ON TMP_BORRAR_LOCAL.DBO.DOCUMENTOS_MECE_LOGISTICO_RED_OPERATIVA (PLACA_VEHICULO_DOCU, FECHA_HORA_MOVIMI)&#xA;--PLACA_VEHICULO_DOCU  DOC.FECHA_HORA_MOVIMI&#xA;&#xA;&#xA;--Paso 2&#xA;&#xA;--SELECT DOC_TMP.[ID_PROCESO]&#xA;--      ,DOC_TMP.[NUMERO_MOVIMI]&#xA;--      ,DOC_TMP.[CONSECUT_MOVIMI]&#xA;--      ,DOC_TMP.[ID_COURIER_CONDUCTOR]&#xA;--      ,DOC_TMP.[PLACA_VEHICULO_DOCU]&#xA;--   ,DOC_TMP.FECHA_HORA_MOVIMI&#xA;--   ,DOC.[ID_COURIER_CONDUCTOR]&#xA;--   ,rtrim(ltrim(DOC_TMP.[PLACA_VEHICULO_DOCU]))--+'-'+isnull(DOC.[ID_COURIER_CONDUCTOR],'')&#xA;--  FROM [TMP_BORRAR_LOCAL].[dbo].[DOCUMENTOS_MECE_LOGISTICO_RED_OPERATIVA] DOC_TMP (nolock)&#xA;--  INNER JOIN [Mece_Logistico]..[DOCUMENTOS] DOC (NOLOCK) ON DOC.[ID_PROCESO]=DOC_TMP.[ID_PROCESO] AND DOC.[NUMERO_MOVIMI]=DOC_TMP.[NUMERO_MOVIMI]&#xA;--      AND DOC.[CONSECUT_MOVIMI]=DOC_TMP.[CONSECUT_MOVIMI]&#xA;--  where DOC_TMP.[PLACA_VEHICULO_DOCU] like '%AP═E4%' --'%A PIE%' --OTRO '%APIE%'&#xA;&#xA;--  A P�E  A P═E&#xA;--AP�E1   AP═E1&#xA;--AP�E4   AP═E4&#xA;&#xA; --Paso 2 Actualiza numero de cedula a las placas de Apie y de Moto &#xA; UPDATE DOC_TMP &#xA;  SET &#xA;  DOC_TMP.[PLACA_VEHICULO_DOCU]=rtrim(ltrim(DOC_TMP.[PLACA_VEHICULO_DOCU]))+'-'+isnull(DOC.[ID_COURIER_CONDUCTOR],'')&#xA;  ,DOC_TMP.[ID_COURIER_CONDUCTOR]=DOC.[ID_COURIER_CONDUCTOR]&#xA;   FROM [TMP_BORRAR_LOCAL].[dbo].[DOCUMENTOS_MECE_LOGISTICO_RED_OPERATIVA] DOC_TMP (nolock)&#xA;  INNER JOIN [Mece_Logistico]..[DOCUMENTOS] DOC (NOLOCK) ON DOC.[ID_PROCESO]=DOC_TMP.[ID_PROCESO] AND DOC.[NUMERO_MOVIMI]=DOC_TMP.[NUMERO_MOVIMI]&#xA;      AND DOC.[CONSECUT_MOVIMI]=DOC_TMP.[CONSECUT_MOVIMI]&#xA;  where DOC_TMP.[PLACA_VEHICULO_DOCU] like '%A PIE%'&#xA;&#xA;    UPDATE DOC_TMP &#xA;  SET &#xA;  DOC_TMP.[PLACA_VEHICULO_DOCU]=rtrim(ltrim(DOC_TMP.[PLACA_VEHICULO_DOCU]))+'-'+isnull(DOC.[ID_COURIER_CONDUCTOR],'')&#xA;  ,DOC_TMP.[ID_COURIER_CONDUCTOR]=DOC.[ID_COURIER_CONDUCTOR]&#xA;   FROM [TMP_BORRAR_LOCAL].[dbo].[DOCUMENTOS_MECE_LOGISTICO_RED_OPERATIVA] DOC_TMP (nolock)&#xA;  INNER JOIN [Mece_Logistico]..[DOCUMENTOS] DOC (NOLOCK) ON DOC.[ID_PROCESO]=DOC_TMP.[ID_PROCESO] AND DOC.[NUMERO_MOVIMI]=DOC_TMP.[NUMERO_MOVIMI]&#xA;      AND DOC.[CONSECUT_MOVIMI]=DOC_TMP.[CONSECUT_MOVIMI]&#xA;  where DOC_TMP.[PLACA_VEHICULO_DOCU] LIKE '%APIE%'&#xA;&#xA;&#xA;     UPDATE DOC_TMP &#xA;  SET &#xA;  DOC_TMP.[PLACA_VEHICULO_DOCU]=rtrim(ltrim(DOC_TMP.[PLACA_VEHICULO_DOCU]))+'-'+isnull(DOC.[ID_COURIER_CONDUCTOR],'')&#xA;  ,DOC_TMP.[ID_COURIER_CONDUCTOR]=DOC.[ID_COURIER_CONDUCTOR]&#xA;   FROM [TMP_BORRAR_LOCAL].[dbo].[DOCUMENTOS_MECE_LOGISTICO_RED_OPERATIVA] DOC_TMP (nolock)&#xA;  INNER JOIN [Mece_Logistico]..[DOCUMENTOS] DOC (NOLOCK) ON DOC.[ID_PROCESO]=DOC_TMP.[ID_PROCESO] AND DOC.[NUMERO_MOVIMI]=DOC_TMP.[NUMERO_MOVIMI]&#xA;      AND DOC.[CONSECUT_MOVIMI]=DOC_TMP.[CONSECUT_MOVIMI]&#xA;  where DOC_TMP.[PLACA_VEHICULO_DOCU] LIKE '%A P═E%'&#xA;&#xA;       UPDATE DOC_TMP &#xA;  SET &#xA;  DOC_TMP.[PLACA_VEHICULO_DOCU]=rtrim(ltrim(DOC_TMP.[PLACA_VEHICULO_DOCU]))+'-'+isnull(DOC.[ID_COURIER_CONDUCTOR],'')&#xA;  ,DOC_TMP.[ID_COURIER_CONDUCTOR]=DOC.[ID_COURIER_CONDUCTOR]&#xA;   FROM [TMP_BORRAR_LOCAL].[dbo].[DOCUMENTOS_MECE_LOGISTICO_RED_OPERATIVA] DOC_TMP (nolock)&#xA;  INNER JOIN [Mece_Logistico]..[DOCUMENTOS] DOC (NOLOCK) ON DOC.[ID_PROCESO]=DOC_TMP.[ID_PROCESO] AND DOC.[NUMERO_MOVIMI]=DOC_TMP.[NUMERO_MOVIMI]&#xA;      AND DOC.[CONSECUT_MOVIMI]=DOC_TMP.[CONSECUT_MOVIMI]&#xA;  where DOC_TMP.[PLACA_VEHICULO_DOCU] LIKE '%AP═E1%'&#xA;&#xA;       UPDATE DOC_TMP &#xA;  SET &#xA;  DOC_TMP.[PLACA_VEHICULO_DOCU]=rtrim(ltrim(DOC_TMP.[PLACA_VEHICULO_DOCU]))+'-'+isnull(DOC.[ID_COURIER_CONDUCTOR],'')&#xA;  ,DOC_TMP.[ID_COURIER_CONDUCTOR]=DOC.[ID_COURIER_CONDUCTOR]&#xA;   FROM [TMP_BORRAR_LOCAL].[dbo].[DOCUMENTOS_MECE_LOGISTICO_RED_OPERATIVA] DOC_TMP (nolock)&#xA;  INNER JOIN [Mece_Logistico]..[DOCUMENTOS] DOC (NOLOCK) ON DOC.[ID_PROCESO]=DOC_TMP.[ID_PROCESO] AND DOC.[NUMERO_MOVIMI]=DOC_TMP.[NUMERO_MOVIMI]&#xA;      AND DOC.[CONSECUT_MOVIMI]=DOC_TMP.[CONSECUT_MOVIMI]&#xA;  where DOC_TMP.[PLACA_VEHICULO_DOCU] LIKE '%AP═E4%'&#xA;&#xA;&#xA;    UPDATE DOC_TMP &#xA;  SET &#xA;  DOC_TMP.[PLACA_VEHICULO_DOCU]=rtrim(ltrim(DOC_TMP.[PLACA_VEHICULO_DOCU]))+'-'+isnull(DOC.[ID_COURIER_CONDUCTOR],'')&#xA;  ,DOC_TMP.[ID_COURIER_CONDUCTOR]=DOC.[ID_COURIER_CONDUCTOR]&#xA;   FROM [TMP_BORRAR_LOCAL].[dbo].[DOCUMENTOS_MECE_LOGISTICO_RED_OPERATIVA] DOC_TMP (nolock)&#xA;  INNER JOIN [Mece_Logistico]..[DOCUMENTOS] DOC (NOLOCK) ON DOC.[ID_PROCESO]=DOC_TMP.[ID_PROCESO] AND DOC.[NUMERO_MOVIMI]=DOC_TMP.[NUMERO_MOVIMI]&#xA;      AND DOC.[CONSECUT_MOVIMI]=DOC_TMP.[CONSECUT_MOVIMI]&#xA;   INNER JOIN [PARAMETROS].[dbo].[VEHICULOS] as v  (nolock) ON v.PLACA_VEHICULO=DOC.[PLACA_VEHICULO_DOCU] AND v.ID_TIPO_VEHI=143 -- MOTOS&#xA;  where DOC_TMP.[PLACA_VEHICULO_DOCU] not like '%A PIE%' and DOC_TMP.[PLACA_VEHICULO_DOCU] not like '%APIE%'&#xA;&#xA;  UPDATE DOC_TMP &#xA;  SET &#xA;  DOC_TMP.[PLACA_VEHICULO_DOCU]=rtrim(ltrim(DOC_TMP.[PLACA_VEHICULO_DOCU]))+'-'+isnull(DOC.[ID_COURIER_CONDUCTOR],'')&#xA;  ,DOC_TMP.[ID_COURIER_CONDUCTOR]=DOC.[ID_COURIER_CONDUCTOR]&#xA;   FROM [TMP_BORRAR_LOCAL].[dbo].[DOCUMENTOS_MECE_LOGISTICO_RED_OPERATIVA] DOC_TMP (nolock)&#xA;  INNER JOIN [Mece_Logistico]..[DOCUMENTOS] DOC (NOLOCK) ON DOC.[ID_PROCESO]=DOC_TMP.[ID_PROCESO] AND DOC.[NUMERO_MOVIMI]=DOC_TMP.[NUMERO_MOVIMI]&#xA;      AND DOC.[CONSECUT_MOVIMI]=DOC_TMP.[CONSECUT_MOVIMI]&#xA;   INNER JOIN [PARAMETROS].[dbo].[VEHICULOS] as v  (nolock) ON v.PLACA_VEHICULO=DOC.[PLACA_VEHICULO_DOCU] AND v.ID_TIPO_VEHI=142 -- MOTOS&#xA;  where --DOC_TMP.[PLACA_VEHICULO_DOCU] not like '%A PIE%' and &#xA;  DOC_TMP.[PLACA_VEHICULO_DOCU] LIKE '%ECO0%'&#xA;&#xA;  UPDATE DOC_TMP &#xA;  SET &#xA;  DOC_TMP.[PLACA_VEHICULO_DOCU]=rtrim(ltrim(DOC_TMP.[PLACA_VEHICULO_DOCU]))+'-'+isnull(DOC.[ID_COURIER_CONDUCTOR],'')&#xA;  ,DOC_TMP.[ID_COURIER_CONDUCTOR]=DOC.[ID_COURIER_CONDUCTOR]&#xA;   FROM [TMP_BORRAR_LOCAL].[dbo].[DOCUMENTOS_MECE_LOGISTICO_RED_OPERATIVA] DOC_TMP (nolock)&#xA;  INNER JOIN [Mece_Logistico]..[DOCUMENTOS] DOC (NOLOCK) ON DOC.[ID_PROCESO]=DOC_TMP.[ID_PROCESO] AND DOC.[NUMERO_MOVIMI]=DOC_TMP.[NUMERO_MOVIMI]&#xA;      AND DOC.[CONSECUT_MOVIMI]=DOC_TMP.[CONSECUT_MOVIMI]&#xA;   INNER JOIN [PARAMETROS].[dbo].[VEHICULOS] as v  (nolock) ON v.PLACA_VEHICULO=DOC.[PLACA_VEHICULO_DOCU] AND v.ID_TIPO_VEHI=142 -- MOTOS&#xA;  where --DOC_TMP.[PLACA_VEHICULO_DOCU] not like '%A PIE%' and &#xA;  DOC_TMP.[PLACA_VEHICULO_DOCU] LIKE '%ECOBIC%'&#xA;&#xA;  &#xA;  UPDATE DOC_TMP &#xA;  SET &#xA;  DOC_TMP.[PLACA_VEHICULO_DOCU]=rtrim(ltrim(DOC_TMP.[PLACA_VEHICULO_DOCU]))+'-'+isnull(DOC.[ID_COURIER_CONDUCTOR],'')&#xA;  ,DOC_TMP.[ID_COURIER_CONDUCTOR]=DOC.[ID_COURIER_CONDUCTOR]&#xA;   FROM [TMP_BORRAR_LOCAL].[dbo].[DOCUMENTOS_MECE_LOGISTICO_RED_OPERATIVA] DOC_TMP (nolock)&#xA;  INNER JOIN [Mece_Logistico]..[DOCUMENTOS] DOC (NOLOCK) ON DOC.[ID_PROCESO]=DOC_TMP.[ID_PROCESO] AND DOC.[NUMERO_MOVIMI]=DOC_TMP.[NUMERO_MOVIMI]&#xA;      AND DOC.[CONSECUT_MOVIMI]=DOC_TMP.[CONSECUT_MOVIMI]&#xA;--   INNER JOIN [PARAMETROS].[dbo].[VEHICULOS] as v  (nolock) ON v.PLACA_VEHICULO=DOC.[PLACA_VEHICULO_DOCU] AND v.ID_TIPO_VEHI=142 -- MOTOS&#xA;  where --DOC_TMP.[PLACA_VEHICULO_DOCU] not like '%A PIE%' and &#xA;  DOC_TMP.[PLACA_VEHICULO_DOCU] LIKE 'ECOBIC'&#xA;  and len(DOC_TMP.[PLACA_VEHICULO_DOCU])=6&#xA;&#xA;&#xA;--CLICOH&#xA;--select z.[NOMBRE_ZONA_URBA], DOC_TMP.*&#xA;UPDATE DOC_TMP &#xA;SET DOC_TMP.NOMBRE_ZONA_URBA=rtrim(ltrim(z.NOMBRE_ZONA_URBA))&#xA;FROM TMP_BORRAR_LOCAL.DBO.DOCUMENTOS_MECE_LOGISTICO_RED_OPERATIVA DOC_TMP WITH(NOLOCK) &#xA;INNER JOIN PARAMETROS.DBO.ZONASURBANAS Z (NOLOCK) ON Z.ID_PAIS = DOC_TMP.ID_PAIS_ZONA_URBA AND Z.ID_CIUDAD = DOC_TMP.ID_CIUDAD_ZONA_URBA &#xA; AND Z.ID_TIPO_ZONA_URBA = DOC_TMP.ID_TIPO_ZONA_URBA AND Z.ID_ZONA_URBA = DOC_TMP.ID_ZONA_URBA&#xA;WHERE DOC_TMP.ID_PROCESO = 9 --SALIDA A ZONA &#xA;AND DOC_TMP.ID_PAIS_DIVISION_ORIGEN = 1&#xA;AND DOC_TMP.ID_TIPO_ZONA_URBA=13  --CLICOH&#xA;&#xA;&#xA;--CLICOH PLACAS&#xA;UPDATE DOC_TMP &#xA;SET DOC_TMP.[PLACA_VEHICULO_DOCU]='CLICOH',&#xA;DOC_TMP.NOMBRE_ZONA_URBA=rtrim(ltrim(z.NOMBRE_ZONA_URBA))&#xA;FROM TMP_BORRAR_LOCAL.DBO.DOCUMENTOS_MECE_LOGISTICO_RED_OPERATIVA DOC_TMP WITH(NOLOCK) &#xA;INNER JOIN PARAMETROS.DBO.ZONASURBANAS Z (NOLOCK) ON Z.ID_PAIS = DOC_TMP.ID_PAIS_ZONA_URBA AND Z.ID_CIUDAD = DOC_TMP.ID_CIUDAD_ZONA_URBA &#xA; AND Z.ID_TIPO_ZONA_URBA = DOC_TMP.ID_TIPO_ZONA_URBA AND Z.ID_ZONA_URBA = DOC_TMP.ID_ZONA_URBA&#xA;WHERE DOC_TMP.ID_PROCESO = 24 --reportado entregado&#xA;AND DOC_TMP.ID_PAIS_ZONA_URBA = 1&#xA;AND DOC_TMP.ID_TIPO_ZONA_URBA=13  --CLICOH&#xA;&#xA;&#xA;--Rapigo&#xA;--select z.[NOMBRE_ZONA_URBA], DOC_TMP.*&#xA; --RAPIGO   &#xA;UPDATE DOC_TMP &#xA;SET DOC_TMP.NOMBRE_ZONA_URBA=z.NOMBRE_ZONA_URBA&#xA;FROM TMP_BORRAR_LOCAL.DBO.DOCUMENTOS_MECE_LOGISTICO_RED_OPERATIVA DOC_TMP WITH(NOLOCK) &#xA;INNER JOIN PARAMETROS.DBO.ZONASURBANAS Z (NOLOCK) ON Z.ID_PAIS = DOC_TMP.ID_PAIS_ZONA_URBA AND Z.ID_CIUDAD = DOC_TMP.ID_CIUDAD_ZONA_URBA &#xA; AND Z.ID_TIPO_ZONA_URBA = DOC_TMP.ID_TIPO_ZONA_URBA AND Z.ID_ZONA_URBA = DOC_TMP.ID_ZONA_URBA --AND Z.CATEGORIA_ZONA_URBA = 7 --RAPIGO&#xA;WHERE DOC_TMP.ID_PROCESO = 9 --SALIDA A ZONA &#xA;AND DOC_TMP.ID_TIPO_ZONA_URBA=12  --RAPIGO&#xA;AND DOC_TMP.ID_PAIS_DIVISION_ORIGEN = 1&#xA;&#xA;--Rapigo_Placas&#xA;UPDATE DOC_TMP &#xA;SET DOC_TMP.[PLACA_VEHICULO_DOCU]='RPG002'&#xA;FROM TMP_BORRAR_LOCAL.DBO.DOCUMENTOS_MECE_LOGISTICO_RED_OPERATIVA DOC_TMP WITH(NOLOCK) &#xA;INNER JOIN PARAMETROS.DBO.ZONASURBANAS Z (NOLOCK) ON Z.ID_PAIS = DOC_TMP.ID_PAIS_ZONA_URBA AND Z.ID_CIUDAD = DOC_TMP.ID_CIUDAD_ZONA_URBA &#xA; AND Z.ID_TIPO_ZONA_URBA = DOC_TMP.ID_TIPO_ZONA_URBA AND Z.ID_ZONA_URBA = DOC_TMP.ID_ZONA_URBA AND Z.CATEGORIA_ZONA_URBA = 7 --RAPIGO&#xA;WHERE DOC_TMP.ID_PROCESO = 9 --SALIDA A ZONA &#xA;AND DOC_TMP.ID_PAIS_DIVISION_ORIGEN = 1&#xA;AND DOC_TMP.PLACA_VEHICULO_DOCU NOT like '%RPG%'&#xA;&#xA;&#xA;--LODYTRANS&#xA;--select z.[NOMBRE_ZONA_URBA], DOC_TMP.*&#xA;UPDATE DOC_TMP &#xA;SET DOC_TMP.NOMBRE_ZONA_URBA=rtrim(ltrim(z.NOMBRE_ZONA_URBA))&#xA;FROM TMP_BORRAR_LOCAL.DBO.DOCUMENTOS_MECE_LOGISTICO_RED_OPERATIVA DOC_TMP WITH(NOLOCK) &#xA;INNER JOIN PARAMETROS.DBO.ZONASURBANAS Z (NOLOCK) ON Z.ID_PAIS = DOC_TMP.ID_PAIS_ZONA_URBA AND Z.ID_CIUDAD = DOC_TMP.ID_CIUDAD_ZONA_URBA &#xA; AND Z.ID_TIPO_ZONA_URBA = DOC_TMP.ID_TIPO_ZONA_URBA AND Z.ID_ZONA_URBA = DOC_TMP.ID_ZONA_URBA&#xA;WHERE DOC_TMP.ID_PROCESO = 9 --SALIDA A ZONA &#xA;AND DOC_TMP.ID_PAIS_DIVISION_ORIGEN = 1&#xA;AND DOC_TMP.ID_TIPO_ZONA_URBA=15  --LODYTRANS&#xA;&#xA;&#xA;--LODYTRANS PLACAS&#xA;UPDATE DOC_TMP &#xA;SET DOC_TMP.[PLACA_VEHICULO_DOCU]='LODYTR',&#xA;DOC_TMP.NOMBRE_ZONA_URBA=rtrim(ltrim(z.NOMBRE_ZONA_URBA))&#xA;FROM TMP_BORRAR_LOCAL.DBO.DOCUMENTOS_MECE_LOGISTICO_RED_OPERATIVA DOC_TMP WITH(NOLOCK) &#xA;INNER JOIN PARAMETROS.DBO.ZONASURBANAS Z (NOLOCK) ON Z.ID_PAIS = DOC_TMP.ID_PAIS_ZONA_URBA AND Z.ID_CIUDAD = DOC_TMP.ID_CIUDAD_ZONA_URBA &#xA; AND Z.ID_TIPO_ZONA_URBA = DOC_TMP.ID_TIPO_ZONA_URBA AND Z.ID_ZONA_URBA = DOC_TMP.ID_ZONA_URBA&#xA;WHERE DOC_TMP.ID_PROCESO = 24 --reportado entregado&#xA;AND DOC_TMP.ID_PAIS_ZONA_URBA = 1&#xA;AND DOC_TMP.ID_TIPO_ZONA_URBA=15  --LODYTRANS&#xA;&#xA;&#xA;--LODYTRANS PLACAS&#xA;UPDATE DOC_TMP &#xA;SET DOC_TMP.[PLACA_VEHICULO_DOCU]='CONSOLIDADOR',&#xA;DOC_TMP.NOMBRE_ZONA_URBA=rtrim(ltrim(z.NOMBRE_ZONA_URBA))&#xA;FROM TMP_BORRAR_LOCAL.DBO.DOCUMENTOS_MECE_LOGISTICO_RED_OPERATIVA DOC_TMP WITH(NOLOCK) &#xA;INNER JOIN PARAMETROS.DBO.ZONASURBANAS Z (NOLOCK) ON Z.ID_PAIS = DOC_TMP.ID_PAIS_ZONA_URBA AND Z.ID_CIUDAD = DOC_TMP.ID_CIUDAD_ZONA_URBA &#xA; AND Z.ID_TIPO_ZONA_URBA = DOC_TMP.ID_TIPO_ZONA_URBA AND Z.ID_ZONA_URBA = DOC_TMP.ID_ZONA_URBA&#xA;WHERE DOC_TMP.ID_PROCESO = 24 --reportado entregado&#xA;AND DOC_TMP.ID_PAIS_ZONA_URBA = 1&#xA;AND DOC_TMP.ID_TIPO_ZONA_URBA=17  --aforador&#xA;&#xA;&#xA;&#xA;UPDATE DOC_TMP &#xA;SET DOC_TMP.PLACA_VEHICULO_DOCU= CAST(DIV.CODIGO_ACTUAL AS NVARCHAR)&#xA;FROM TMP_BORRAR_LOCAL.DBO.DOCUMENTOS_MECE_LOGISTICO_RED_OPERATIVA DOC_TMP WITH(NOLOCK)&#xA;INNER JOIN PARAMETROS.DBO.DIVISIONES DIV (NOLOCK) ON DIV.ID_PAIS=DOC_TMP.ID_PAIS_CANAL AND DIV.ID_CIUDAD=DOC_TMP.ID_CIUDAD_CANAL&#xA;  AND DIV.ID_DIVISION=DOC_TMP.ID_CANAL  AND DIV.ID_EST_DIVISION=1&#xA;WHERE ID_PROCESO=2&#xA;--select &#xA;--rtrim(ltrim(DOC_TMP.[PLACA_VEHICULO_DOCU]))+'-'+isnull(DOC.[ID_COURIER_CONDUCTOR],'')&#xA;--,DOC.[ID_COURIER_CONDUCTOR]&#xA;--   FROM [TMP_BORRAR_LOCAL].[dbo].[DOCUMENTOS_MECE_LOGISTICO_RED_OPERATIVA] DOC_TMP (nolock)&#xA;--  INNER JOIN [Mece_Logistico]..[DOCUMENTOS] DOC (NOLOCK) ON DOC.[ID_PROCESO]=DOC_TMP.[ID_PROCESO] AND DOC.[NUMERO_MOVIMI]=DOC_TMP.[NUMERO_MOVIMI]&#xA;--      AND DOC.[CONSECUT_MOVIMI]=DOC_TMP.[CONSECUT_MOVIMI]&#xA;--   INNER JOIN [PARAMETROS].[dbo].[VEHICULOS] as v  (nolock) ON v.PLACA_VEHICULO=DOC.[PLACA_VEHICULO_DOCU] AND v.ID_TIPO_VEHI=142 -- MOTOS&#xA;--  where --DOC_TMP.[PLACA_VEHICULO_DOCU] not like '%A PIE%' and &#xA;--  DOC_TMP.[PLACA_VEHICULO_DOCU] LIKE '%ECOBIC%'&#xA;&#xA;&#xA;/*&#xA;2014-07-24 00:00:00.000&#xA;2014-10-18 00:00:00.000&#xA;2014-10-21 00:00:00.000&#xA;2014-10-22 00:00:00.000&#xA;2015-07-30 00:00:00.000&#xA;2015-07-31 00:00:00.000&#xA;2016-01-27 00:00:00.000&#xA;2016-01-28 00:00:00.000&#xA;2016-01-29 00:00:00.000&#xA;2016-01-30 00:00:00.000&#xA;2017-11-16 00:00:00.000&#xA;2018-04-03 00:00:00.000&#xA;*/" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
