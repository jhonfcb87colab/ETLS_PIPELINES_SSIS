            <DTS:Executable
              DTS:refId="Package\PASO 1_1 Y 1_2\PASO 1_1\Container INFO_GUIAS_MANIFIESTOS_VOLUMEN_PIEZAS V2"
              DTS:CreationName="STOCK:SEQUENCE"
              DTS:Description="Sequence Container"
              DTS:DTSID="{ef40faa2-1aa3-4ae6-8599-c98e4f0aec29}"
              DTS:ExecutableType="STOCK:SEQUENCE"
              DTS:LocaleID="-1"
              DTS:ObjectName="Container INFO_GUIAS_MANIFIESTOS_VOLUMEN_PIEZAS V2">
              <DTS:Variables />
              <DTS:Executables>
                <DTS:Executable
                  DTS:refId="Package\PASO 1_1 Y 1_2\PASO 1_1\Container INFO_GUIAS_MANIFIESTOS_VOLUMEN_PIEZAS V2\PARTE 1 INFO_GUIAS_MANIFIESTOS_VOLUMEN_PIEZAS V2"
                  DTS:CreationName="Microsoft.ExecuteSQLTask"
                  DTS:Description="Execute SQL Task"
                  DTS:DTSID="{c1d0a0e0-5b17-47b4-b3f9-78d11c83fe8f}"
                  DTS:ExecutableType="Microsoft.ExecuteSQLTask"
                  DTS:LocaleID="-1"
                  DTS:ObjectName="PARTE 1 INFO_GUIAS_MANIFIESTOS_VOLUMEN_PIEZAS V2"
                  DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
                  DTS:ThreadHint="0">
                  <DTS:Variables />
                  <DTS:ObjectData>
                    <SQLTask:SqlTaskData
                      SQLTask:Connection="{A3A65FF9-9058-4FB8-AA1A-7AABA464327A}"
                      SQLTask:SqlStatementSource="&#xA;IF OBJECT_ID('tempdb..#INFO_GUIAS_MANIFIESTOS_VOLUMEN_PIEZAS') IS NOT NULL &#xA;    DROP TABLE #INFO_GUIAS_MANIFIESTOS_VOLUMEN_PIEZAS&#xA;&#xA;&#xA;-- Tabla que tiene las guias de los manifiestos de procesar         INFO_GUIAS_MANIFIESTOS_VOLUMEN_PIEZAS&#xA;-- Tabla que tiene la guias con piezas                              INFO_GUIAS_SEGUIMIENTO_PIEZAS&#xA;-- Tabla que tiene el consolidado de volumen piezas por manifiesto  INFO_MANIFIESTOS_VOLUMEN_PIEZAS &#xA;TRUNCATE TABLE TMP_BORRAR_LOCAL.DBO.INFO_GUIAS_MANIFIESTOS_VOLUMEN_PIEZAS&#xA;TRUNCATE TABLE TMP_BORRAR_LOCAL.DBO.INFO_MANIFIESTOS_VOLUMEN_PIEZAS&#xA;TRUNCATE TABLE TMP_BORRAR_LOCAL.DBO.INFO_GUIAS_SEGUIMIENTO_PIEZAS&#xA;&#xA;&#xA;--CREATE TABLE TMP_BORRAR_LOCAL.DBO.INFO_GUIAS_MANIFIESTOS_VOLUMEN_PIEZAS ( &#xA;--NUMERO_GUIA NUMERIC(20,0),&#xA;--ID_PRODUCTO INT DEFAULT 0,&#xA;--LARGO_ENV NUMERIC(4, 0) DEFAULT 0,&#xA;--ALTO_ENV NUMERIC(4, 0) DEFAULT 0,&#xA;--ANCHO_ENV NUMERIC(4, 0) DEFAULT 0,&#xA;--PESO_VOLU NUMERIC(8,3) DEFAULT 0,&#xA;--PESO_FISICO NUMERIC(8,3) DEFAULT 0,&#xA;--NUMERO_PIEZAS INT DEFAULT 0&#xA;--)&#xA;--CREATE NONCLUSTERED INDEX IX_NUMERO_GUIA ON TMP_BORRAR_LOCAL.DBO.INFO_GUIAS_MANIFIESTOS_VOLUMEN_PIEZAS (NUMERO_GUIA)&#xA;&#xA;&#xA;--CREATE TABLE [tmp_borrar_local].[dbo].[INFO_MANIFIESTOS_VOLUMEN_PIEZAS](&#xA;-- [ID_PROCESO] [smallint] NOT NULL,&#xA;-- [NUMERO_MOVIMI] [char](30) NOT NULL,&#xA;-- [CONSECUT_MOVIMI] [numeric](7, 0) NOT NULL,&#xA;-- [PESO_VOLU_TOTAL] [numeric](38, 3) NULL,&#xA;-- [PESO_FISICO_TOTAL] [numeric](38, 3) NULL,&#xA;-- [NUMERO_PIEZAS_TOTAL] [int] NULL&#xA;--) ON [PRIMARY]&#xA;--GO&#xA;--CREATE NONCLUSTERED INDEX IX_NUMERO_GUIA ON TMP_BORRAR_LOCAL.DBO.INFO_MANIFIESTOS_VOLUMEN_PIEZAS (ID_PROCESO,NUMERO_MOVIMI,CONSECUT_MOVIMI)&#xA;&#xA;&#xA;--CREATE TABLE TMP_BORRAR_LOCAL.DBO.INFO_GUIAS_SEGUIMIENTO_PIEZAS (&#xA;--ID_PROCESO smallint NOT NULL,&#xA;--NUMERO_MOVIMI char(30) NOT NULL,&#xA;--CONSECUT_MOVIMI numeric(7, 0) NOT NULL,&#xA;--NUMERO_GUIA numeric(20, 0) NOT NULL,&#xA;--ITEM_UNI_GUIA smallint NOT NULL,&#xA;--PESO_PIEZA NUMERIC(8, 3) DEFAULT 0, &#xA;--LARGO_PIEZA NUMERIC(4, 0) DEFAULT 0, &#xA;--ANCHO_PIEZA NUMERIC(4, 0) DEFAULT 0,&#xA;--ALTO_PIEZA NUMERIC(4, 0) DEFAULT 0,&#xA;--PESO_VOLU_PIEZA NUMERIC(8, 3) DEFAULT 0,&#xA;--PESO_PIEZAS_TOTAL NUMERIC(11, 3) DEFAULT 0,&#xA;--PESO_VOLU_PIEZAS_TOTAL NUMERIC(11, 3) DEFAULT 0,&#xA;--ID_PRODUCTO INT DEFAULT 0&#xA;--)&#xA;--CREATE NONCLUSTERED INDEX IX_NUMERO_GUIA ON TMP_BORRAR_LOCAL.DBO.INFO_GUIAS_SEGUIMIENTO_PIEZAS (NUMERO_GUIA)&#xA;--CREATE NONCLUSTERED INDEX IX_MANIFIESTO ON TMP_BORRAR_LOCAL.DBO.INFO_GUIAS_SEGUIMIENTO_PIEZAS (ID_PROCESO,NUMERO_MOVIMI,CONSECUT_MOVIMI)&#xA;&#xA;--TRUNCATE TABLE TMP_BORRAR_LOCAL.DBO.INFO_GUIAS_MANIFIESTOS_VOLUMEN_PIEZAS&#xA;&#xA;&#xA;&#xA;INSERT INTO TMP_BORRAR_LOCAL.DBO.INFO_GUIAS_MANIFIESTOS_VOLUMEN_PIEZAS&#xA;SELECT DISTINCT SE.NUMERO_GUIA,G.ID_PRODUCTO,0,0,0,0,0,0 &#xA;from TMP_BORRAR_LOCAL.DBO.DOCUMENTOS_MECE_LOGISTICO_RED_OPERATIVA TDOC (NOLOCK)&#xA;INNER JOIN Mece_Logistico.DBO.SEGUIMIENTO_ENVIO SE (NOLOCK) ON SE.ID_PROCESO=TDOC.ID_PROCESO&#xA; AND SE.NUMERO_MOVIMI=TDOC.NUMERO_MOVIMI AND SE.CONSECUT_MOVIMI=TDOC.CONSECUT_MOVIMI&#xA;INNER JOIN Mece_Logistico.DBO.GUIAS G (NOLOCK) ON G.NUMERO_GUIA=SE.NUMERO_GUIA AND G.ID_PRODUCTO IS NOT NULL&#xA;LEFT JOIN TMP_BORRAR_LOCAL.DBO.INFO_GUIAS_MANIFIESTOS_VOLUMEN_PIEZAS GMVP (NOLOCK) ON GMVP.NUMERO_GUIA=SE.NUMERO_GUIA&#xA;WHERE GMVP.NUMERO_GUIA IS NULL&#xA;&#xA;&#xA;--truncate table TMP_BORRAR_LOCAL.DBO.INFO_GUIAS_SEGUIMIENTO_PIEZAS&#xA;INSERT INTO TMP_BORRAR_LOCAL.DBO.INFO_GUIAS_SEGUIMIENTO_PIEZAS&#xA;SELECT DISTINCT &#xA;SP.ID_PROCESO, SP.NUMERO_MOVIMI, SP.CONSECUT_MOVIMI,&#xA;SP.NUMERO_GUIA, TMP_SP.MAX_ITEM_UNI_GUIA,&#xA;SP.PESO_PIEZA, SP.LARGO_PIEZA, SP.ANCHO_PIEZA, SP.ALTO_PIEZA, SP.PESO_VOLU_PIEZA,&#xA;0  AS PESO_PIEZAS_TOTAL,&#xA;0 AS PESO_VOLU_PIEZAS_TOTAL,&#xA;GMVP.ID_PRODUCTO AS ID_PRODCUTO&#xA;FROM [Mece_Logistico].[dbo].[SEGUIMIENTO_PIEZA] SP (NOLOCK)&#xA;INNER JOIN TMP_BORRAR_LOCAL.DBO.INFO_GUIAS_MANIFIESTOS_VOLUMEN_PIEZAS GMVP (NOLOCK) ON GMVP.NUMERO_GUIA=SP.NUMERO_GUIA&#xA;INNER JOIN (SELECT SP1.ID_PROCESO, SP1.NUMERO_MOVIMI, SP1.CONSECUT_MOVIMI,&#xA;SP1.NUMERO_GUIA, MAX(SP1.ITEM_UNI_GUIA) AS MAX_ITEM_UNI_GUIA FROM [Mece_Logistico].[dbo].[SEGUIMIENTO_PIEZA] SP1 (NOLOCK) &#xA;GROUP BY SP1.ID_PROCESO, SP1.NUMERO_MOVIMI, SP1.CONSECUT_MOVIMI,SP1.NUMERO_GUIA) AS TMP_SP ON TMP_SP.ID_PROCESO=SP.ID_PROCESO AND TMP_SP.NUMERO_MOVIMI=SP.NUMERO_MOVIMI&#xA; AND TMP_SP.CONSECUT_MOVIMI=SP.CONSECUT_MOVIMI AND TMP_SP.NUMERO_GUIA=SP.NUMERO_GUIA&#xA;LEFT JOIN TMP_BORRAR_LOCAL.DBO.INFO_GUIAS_SEGUIMIENTO_PIEZAS GSP (NOLOCK) ON GSP.NUMERO_GUIA=GMVP.NUMERO_GUIA&#xA;WHERE  SP.FECHA_CREACION=(SELECT MIN(SP1.FECHA_CREACION) FROM [Mece_Logistico].[dbo].[SEGUIMIENTO_PIEZA] SP1 (NOLOCK) &#xA; WHERE SP1.ID_PROCESO=6 AND SP1.NUMERO_GUIA=GMVP.NUMERO_GUIA and SP1.PESO_VOLU_PIEZA&lt;5000 and SP1.ITEM_UNI_GUIA&gt;0 and SP1.LARGO_PIEZA&gt;1 AND SP1.ANCHO_PIEZA&gt;1 AND SP1.ALTO_PIEZA&gt;1)&#xA;AND GSP.NUMERO_GUIA IS NULL AND SP.ID_PROCESO=6&#xA;--AND GMVP.NUMERO_GUIA=7218135632&#xA;AND ISNULL(SP.LARGO_PIEZA,0)!=0 AND ISNULL(SP.ANCHO_PIEZA,0)!=0  AND ISNULL(SP.ALTO_PIEZA,0)!=0 &#xA;--ORDER BY SP.NUMERO_GUIA,SP.ITEM_UNI_GUIA desc &#xA;&#xA;&#xA;INSERT INTO TMP_BORRAR_LOCAL.DBO.INFO_GUIAS_SEGUIMIENTO_PIEZAS&#xA;SELECT DISTINCT &#xA;SP.ID_PROCESO, SP.NUMERO_MOVIMI, SP.CONSECUT_MOVIMI,&#xA;SP.NUMERO_GUIA, TMP_SP.MAX_ITEM_UNI_GUIA,&#xA;SP.PESO_PIEZA, SP.LARGO_PIEZA, SP.ANCHO_PIEZA, SP.ALTO_PIEZA, SP.PESO_VOLU_PIEZA,&#xA;0  AS PESO_PIEZAS_TOTAL,&#xA;0 AS PESO_VOLU_PIEZAS_TOTAL,&#xA;GMVP.ID_PRODUCTO AS ID_PRODCUTO&#xA;FROM [Mece_Logistico].[dbo].[SEGUIMIENTO_PIEZA] SP (NOLOCK)&#xA;INNER JOIN TMP_BORRAR_LOCAL.DBO.INFO_GUIAS_MANIFIESTOS_VOLUMEN_PIEZAS GMVP (NOLOCK) ON GMVP.NUMERO_GUIA=SP.NUMERO_GUIA&#xA;INNER JOIN (SELECT SP1.ID_PROCESO, SP1.NUMERO_MOVIMI, SP1.CONSECUT_MOVIMI,&#xA;SP1.NUMERO_GUIA, MAX(SP1.ITEM_UNI_GUIA) AS MAX_ITEM_UNI_GUIA FROM [Mece_Logistico].[dbo].[SEGUIMIENTO_PIEZA] SP1 (NOLOCK) &#xA;GROUP BY SP1.ID_PROCESO, SP1.NUMERO_MOVIMI, SP1.CONSECUT_MOVIMI,SP1.NUMERO_GUIA) AS TMP_SP ON TMP_SP.ID_PROCESO=SP.ID_PROCESO AND TMP_SP.NUMERO_MOVIMI=SP.NUMERO_MOVIMI&#xA; AND TMP_SP.CONSECUT_MOVIMI=SP.CONSECUT_MOVIMI AND TMP_SP.NUMERO_GUIA=SP.NUMERO_GUIA&#xA;LEFT JOIN TMP_BORRAR_LOCAL.DBO.INFO_GUIAS_SEGUIMIENTO_PIEZAS GSP (NOLOCK) ON GSP.NUMERO_GUIA=GMVP.NUMERO_GUIA&#xA;WHERE  SP.FECHA_CREACION=(SELECT MIN(SP1.FECHA_CREACION) FROM [Mece_Logistico].[dbo].[SEGUIMIENTO_PIEZA] SP1 (NOLOCK) &#xA; WHERE SP1.ID_PROCESO=12 AND SP1.NUMERO_GUIA=GMVP.NUMERO_GUIA and SP1.PESO_VOLU_PIEZA&lt;5000 and SP1.ITEM_UNI_GUIA&gt;0 and SP1.LARGO_PIEZA&gt;1 AND SP1.ANCHO_PIEZA&gt;1 AND SP1.ALTO_PIEZA&gt;1)&#xA;AND GSP.NUMERO_GUIA IS NULL AND SP.ID_PROCESO=12 AND ISNULL(SP.LARGO_PIEZA,0)!=0 AND ISNULL(SP.ANCHO_PIEZA,0)!=0  AND ISNULL(SP.ALTO_PIEZA,0)!=0 &#xA;&#xA;&#xA;INSERT INTO TMP_BORRAR_LOCAL.DBO.INFO_GUIAS_SEGUIMIENTO_PIEZAS&#xA;SELECT DISTINCT &#xA;SP.ID_PROCESO, SP.NUMERO_MOVIMI, SP.CONSECUT_MOVIMI,&#xA;SP.NUMERO_GUIA, TMP_SP.MAX_ITEM_UNI_GUIA,&#xA;SP.PESO_PIEZA, SP.LARGO_PIEZA, SP.ANCHO_PIEZA, SP.ALTO_PIEZA, SP.PESO_VOLU_PIEZA,&#xA;0  AS PESO_PIEZAS_TOTAL,&#xA;0 AS PESO_VOLU_PIEZAS_TOTAL,&#xA;GMVP.ID_PRODUCTO AS ID_PRODCUTO&#xA;FROM [Mece_Logistico].[dbo].[SEGUIMIENTO_PIEZA] SP (NOLOCK)&#xA;INNER JOIN TMP_BORRAR_LOCAL.DBO.INFO_GUIAS_MANIFIESTOS_VOLUMEN_PIEZAS GMVP (NOLOCK) ON GMVP.NUMERO_GUIA=SP.NUMERO_GUIA&#xA;INNER JOIN (SELECT SP1.ID_PROCESO, SP1.NUMERO_MOVIMI, SP1.CONSECUT_MOVIMI,&#xA;SP1.NUMERO_GUIA, MAX(SP1.ITEM_UNI_GUIA) AS MAX_ITEM_UNI_GUIA FROM [Mece_Logistico].[dbo].[SEGUIMIENTO_PIEZA] SP1 (NOLOCK) &#xA;GROUP BY SP1.ID_PROCESO, SP1.NUMERO_MOVIMI, SP1.CONSECUT_MOVIMI,SP1.NUMERO_GUIA) AS TMP_SP ON TMP_SP.ID_PROCESO=SP.ID_PROCESO AND TMP_SP.NUMERO_MOVIMI=SP.NUMERO_MOVIMI&#xA; AND TMP_SP.CONSECUT_MOVIMI=SP.CONSECUT_MOVIMI AND TMP_SP.NUMERO_GUIA=SP.NUMERO_GUIA&#xA;LEFT JOIN TMP_BORRAR_LOCAL.DBO.INFO_GUIAS_SEGUIMIENTO_PIEZAS GSP (NOLOCK) ON GSP.NUMERO_GUIA=GMVP.NUMERO_GUIA&#xA;WHERE  SP.FECHA_CREACION=(SELECT MIN(SP1.FECHA_CREACION) FROM [Mece_Logistico].[dbo].[SEGUIMIENTO_PIEZA] SP1 (NOLOCK) &#xA; WHERE SP1.ID_PROCESO=1 AND SP1.NUMERO_GUIA=GMVP.NUMERO_GUIA and SP1.PESO_VOLU_PIEZA&lt;5000 and SP1.ITEM_UNI_GUIA&gt;0 and SP1.LARGO_PIEZA&gt;1 AND SP1.ANCHO_PIEZA&gt;1 AND SP1.ALTO_PIEZA&gt;1)&#xA;AND GSP.NUMERO_GUIA IS NULL AND SP.ID_PROCESO=1 AND ISNULL(SP.LARGO_PIEZA,0)!=0 AND ISNULL(SP.ANCHO_PIEZA,0)!=0  AND ISNULL(SP.ALTO_PIEZA,0)!=0 &#xA;&#xA;INSERT INTO TMP_BORRAR_LOCAL.DBO.INFO_GUIAS_SEGUIMIENTO_PIEZAS&#xA;SELECT DISTINCT &#xA;SP.ID_PROCESO, SP.NUMERO_MOVIMI, SP.CONSECUT_MOVIMI,&#xA;SP.NUMERO_GUIA, TMP_SP.MAX_ITEM_UNI_GUIA,&#xA;SP.PESO_PIEZA, SP.LARGO_PIEZA, SP.ANCHO_PIEZA, SP.ALTO_PIEZA, SP.PESO_VOLU_PIEZA,&#xA;0  AS PESO_PIEZAS_TOTAL,&#xA;0 AS PESO_VOLU_PIEZAS_TOTAL,&#xA;GMVP.ID_PRODUCTO AS ID_PRODCUTO&#xA;FROM [Mece_Logistico].[dbo].[SEGUIMIENTO_PIEZA] SP (NOLOCK)&#xA;INNER JOIN TMP_BORRAR_LOCAL.DBO.INFO_GUIAS_MANIFIESTOS_VOLUMEN_PIEZAS GMVP (NOLOCK) ON GMVP.NUMERO_GUIA=SP.NUMERO_GUIA&#xA;INNER JOIN (SELECT SP1.ID_PROCESO, SP1.NUMERO_MOVIMI, SP1.CONSECUT_MOVIMI,&#xA;SP1.NUMERO_GUIA, MAX(SP1.ITEM_UNI_GUIA) AS MAX_ITEM_UNI_GUIA FROM [Mece_Logistico].[dbo].[SEGUIMIENTO_PIEZA] SP1 (NOLOCK) &#xA;GROUP BY SP1.ID_PROCESO, SP1.NUMERO_MOVIMI, SP1.CONSECUT_MOVIMI,SP1.NUMERO_GUIA) AS TMP_SP ON TMP_SP.ID_PROCESO=SP.ID_PROCESO AND TMP_SP.NUMERO_MOVIMI=SP.NUMERO_MOVIMI&#xA; AND TMP_SP.CONSECUT_MOVIMI=SP.CONSECUT_MOVIMI AND TMP_SP.NUMERO_GUIA=SP.NUMERO_GUIA&#xA;LEFT JOIN TMP_BORRAR_LOCAL.DBO.INFO_GUIAS_SEGUIMIENTO_PIEZAS GSP (NOLOCK) ON GSP.NUMERO_GUIA=GMVP.NUMERO_GUIA&#xA;WHERE  SP.FECHA_CREACION=(SELECT MIN(SP1.FECHA_CREACION) FROM [Mece_Logistico].[dbo].[SEGUIMIENTO_PIEZA] SP1 (NOLOCK) &#xA; WHERE SP1.ID_PROCESO=2 AND SP1.NUMERO_GUIA=GMVP.NUMERO_GUIA and SP1.PESO_VOLU_PIEZA&lt;5000 and SP1.ITEM_UNI_GUIA&gt;0 and SP1.LARGO_PIEZA&gt;1 AND SP1.ANCHO_PIEZA&gt;1 AND SP1.ALTO_PIEZA&gt;1)&#xA;AND GSP.NUMERO_GUIA IS NULL AND SP.ID_PROCESO=2 AND ISNULL(SP.LARGO_PIEZA,0)!=0 AND ISNULL(SP.ANCHO_PIEZA,0)!=0  AND ISNULL(SP.ALTO_PIEZA,0)!=0 &#xA;&#xA;&#xA;&#xA;&#xA;DELETE T FROM&#xA;(&#xA;SELECT *, DupRank = ROW_NUMBER() OVER (PARTITION BY NUMERO_GUIA ORDER BY (SELECT NULL))&#xA;FROM TMP_BORRAR_LOCAL.DBO.INFO_GUIAS_SEGUIMIENTO_PIEZAS&#xA;) AS T&#xA;WHERE DupRank &gt; 1&#xA;&#xA;--UPDATE ISP SET ISP.ITEM_UNI_GUIA=TMP_SP.MAX_ITEM_UNI_GUIA&#xA;--FROM TMP_BORRAR_LOCAL.DBO.INFO_GUIAS_SEGUIMIENTO_PIEZAS ISP&#xA;--INNER JOIN (SELECT SP1.ID_PROCESO, SP1.NUMERO_MOVIMI, SP1.CONSECUT_MOVIMI,&#xA;--SP1.NUMERO_GUIA, MAX(SP1.ITEM_UNI_GUIA) AS MAX_ITEM_UNI_GUIA FROM [Mece_Logistico].[dbo].[SEGUIMIENTO_PIEZA] SP1 (NOLOCK) &#xA;--GROUP BY SP1.ID_PROCESO, SP1.NUMERO_MOVIMI, SP1.CONSECUT_MOVIMI,SP1.NUMERO_GUIA) AS TMP_SP ON TMP_SP.ID_PROCESO=ISP.ID_PROCESO AND TMP_SP.NUMERO_MOVIMI=ISP.NUMERO_MOVIMI&#xA;-- AND TMP_SP.CONSECUT_MOVIMI=ISP.CONSECUT_MOVIMI AND TMP_SP.NUMERO_GUIA=ISP.NUMERO_GUIA&#xA;----WHERE  ISP.NUMERO_GUIA=7218193657&#xA;&#xA;/*&#xA;&#xA;SELECT * FROM TMP_BORRAR_LOCAL.DBO.INFO_GUIAS_SEGUIMIENTO_PIEZAS ISP&#xA;--WHERE ISP.NUMERO_GUIA=7218135632&#xA;order by PESO_VOLU_PIEZAS_TOTAL desc&#xA;*/&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
                  </DTS:ObjectData>
                </DTS:Executable>
                <DTS:Executable
                  DTS:refId="Package\PASO 1_1 Y 1_2\PASO 1_1\Container INFO_GUIAS_MANIFIESTOS_VOLUMEN_PIEZAS V2\PARTE 2 INFO_GUIAS_MANIFIESTOS_VOLUMEN_PIEZAS V2 CORREGIDO"
                  DTS:CreationName="Microsoft.ExecuteSQLTask"
                  DTS:Description="Execute SQL Task"
                  DTS:DTSID="{837c6716-546a-49d7-b981-fb32a9c4f748}"
                  DTS:ExecutableType="Microsoft.ExecuteSQLTask"
                  DTS:LocaleID="-1"
                  DTS:ObjectName="PARTE 2 INFO_GUIAS_MANIFIESTOS_VOLUMEN_PIEZAS V2 CORREGIDO"
                  DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
                  DTS:ThreadHint="0">
                  <DTS:Variables />
                  <DTS:ObjectData>
                    <SQLTask:SqlTaskData
                      SQLTask:Connection="{A3A65FF9-9058-4FB8-AA1A-7AABA464327A}"
                      SQLTask:SqlStatementSource="&#xA;&#xA;UPDATE SP SET SP.PESO_PIEZAS_TOTAL=(SP.PESO_PIEZA*SP.ITEM_UNI_GUIA),&#xA;PESO_VOLU_PIEZAS_TOTAL=(((SP.LARGO_PIEZA * SP.ANCHO_PIEZA * SP.ALTO_PIEZA * 400)/1000000) * SP.ITEM_UNI_GUIA)&#xA;FROM TMP_BORRAR_LOCAL.DBO.INFO_GUIAS_SEGUIMIENTO_PIEZAS SP (NOLOCK)&#xA;WHERE SP.ID_PRODUCTO=6 AND ISNULL(SP.PESO_VOLU_PIEZAS_TOTAL,0)=0&#xA;&#xA;UPDATE SP SET SP.PESO_PIEZAS_TOTAL=(SP.PESO_PIEZA*SP.ITEM_UNI_GUIA),&#xA;PESO_VOLU_PIEZAS_TOTAL=(((SP.LARGO_PIEZA * SP.ANCHO_PIEZA * SP.ALTO_PIEZA*222)/1000000) * SP.ITEM_UNI_GUIA)&#xA;FROM TMP_BORRAR_LOCAL.DBO.INFO_GUIAS_SEGUIMIENTO_PIEZAS SP&#xA;WHERE SP.ID_PRODUCTO!=6 AND ISNULL(SP.PESO_VOLU_PIEZAS_TOTAL,0)=0&#xA;&#xA;----VALIDACION DATA&#xA;--SELECT TOP 10000* FROM TMP_BORRAR_LOCAL.DBO.INFO_GUIAS_SEGUIMIENTO_PIEZAS&#xA;----WHERE --NUMERO_GUIA=2231842210&#xA;----PESO_VOLU_PIEZAS_TOTAL=0 and id_producto=6&#xA;--ORDER BY PESO_VOLU_PIEZAS_TOTAL DESC&#xA;&#xA;&#xA;--Primero Piezas&#xA;/*****************************/&#xA;--1 todo lo que sea PRODUCTO 1 O 2 se le coloca pieza 1&#xA;UPDATE GMVP SET GMVP.NUMERO_PIEZAS=1&#xA;FROM TMP_BORRAR_LOCAL.DBO.INFO_GUIAS_MANIFIESTOS_VOLUMEN_PIEZAS GMVP&#xA;INNER JOIN Mece_Logistico.DBO.GUIAS G (NOLOCK) ON G.NUMERO_GUIA=GMVP.NUMERO_GUIA&#xA;WHERE ISNULL(GMVP.NUMERO_PIEZAS,0)=0 and g.ID_PRODUCTO IN(1,2,52,24,65,55,11)&#xA;&#xA;&#xA;--3 Piezas de anticipada&#xA;UPDATE GMVP SET GMVP.NUMERO_PIEZAS=G.NUMERO_PIEZAS&#xA;FROM TMP_BORRAR_LOCAL.DBO.INFO_GUIAS_MANIFIESTOS_VOLUMEN_PIEZAS GMVP&#xA;INNER JOIN Mece_Logistico.DBO.GUIAS_INF_ANTICIPADA G (NOLOCK) ON G.NUMERO_GUIA=GMVP.NUMERO_GUIA&#xA;WHERE ISNULL(GMVP.NUMERO_PIEZAS,0)=0 and ISNULL(G.NUMERO_PIEZAS,0)!=0&#xA;&#xA;--3 Piezas de guias&#xA;UPDATE GMVP SET GMVP.NUMERO_PIEZAS=G.NUMERO_PIEZAS&#xA;FROM TMP_BORRAR_LOCAL.DBO.INFO_GUIAS_MANIFIESTOS_VOLUMEN_PIEZAS GMVP&#xA;INNER JOIN Mece_Logistico.DBO.GUIAS G (NOLOCK) ON G.NUMERO_GUIA=GMVP.NUMERO_GUIA&#xA;WHERE ISNULL(GMVP.NUMERO_PIEZAS,0)=0 and ISNULL(G.NUMERO_PIEZAS,0)!=0&#xA;/*****************************/&#xA;-----------------------------------------------------------------------------------------------------------------&#xA;--VALIDACI N DE INFOMACION TABLA PRINCIPAL DE MANIFIESTOS INFO_GUIAS_MANIFIESTOS_VOLUMEN_PIEZAS&#xA;-----------------------------------------------------------------------------------------------------------------&#xA;--SELECT ID_PRODUCTO,COUNT(1) FROM TMP_BORRAR_LOCAL.DBO.INFO_GUIAS_MANIFIESTOS_VOLUMEN_PIEZAS (NOLOCK)&#xA;--where PESO_VOLU=0--NUMERO_PIEZAS=0&#xA;--GROUP BY ID_PRODUCTO&#xA;--ORDER BY 2 DESC&#xA;&#xA;--SELECT * FROM TMP_BORRAR_LOCAL.DBO.INFO_GUIAS_MANIFIESTOS_VOLUMEN_PIEZAS (NOLOCK)&#xA;--where PESO_VOLU=0 AND ID_PRODUCTO=2 AND  SUBSTRING(CAST(NUMERO_GUIA AS nvarchar),1,1)=9--NUMERO_PIEZAS=0&#xA;--GROUP BY ID_PRODUCTO&#xA;--ORDER BY 2 DESC&#xA;-----------------------------------------------------------------------------------------------------------------&#xA;-----------------------------------------------------------------------------------------------------------------&#xA;--Se inicia la actualizaci n de peso volumetrico&#xA;/***********************************************************/&#xA;--Todo lo que es documento se le actualiza el peso volumetrico a 0.100 gramos&#xA;UPDATE GMVP SET GMVP.PESO_VOLU=0.100&#xA;FROM TMP_BORRAR_LOCAL.DBO.INFO_GUIAS_MANIFIESTOS_VOLUMEN_PIEZAS GMVP&#xA;WHERE GMVP.ID_PRODUCTO IN(1,52,24,65,55,11) --AND GMVP.PESO_VOLU=0&#xA;&#xA;--Todo lo que es documento se le actualiza el peso volumetrico a 0.100 gramos&#xA;UPDATE GMVP SET GMVP.PESO_FISICO=0.100&#xA;FROM TMP_BORRAR_LOCAL.DBO.INFO_GUIAS_MANIFIESTOS_VOLUMEN_PIEZAS GMVP&#xA;WHERE GMVP.ID_PRODUCTO IN(1,52,24,65,55,11) --AND GMVP.PESO_VOLU=0  &#xA;&#xA;&#xA;&#xA;--DECODIFICADORES DIRECT TV se le coloca 1 Kg&#xA;UPDATE GMVP SET GMVP.PESO_VOLU=1--, GMVP.PESO_FISICO=1&#xA;FROM TMP_BORRAR_LOCAL.DBO.INFO_GUIAS_MANIFIESTOS_VOLUMEN_PIEZAS GMVP&#xA;WHERE (GMVP.PESO_VOLU=0 OR GMVP.PESO_VOLU&gt;50) AND GMVP.ID_PRODUCTO IN(27)&#xA;&#xA;&#xA;--DECODIFICADORES DIRECT TV se le coloca 1 Kg&#xA;UPDATE GMVP SET GMVP.PESO_FISICO=1&#xA;FROM TMP_BORRAR_LOCAL.DBO.INFO_GUIAS_MANIFIESTOS_VOLUMEN_PIEZAS GMVP&#xA;WHERE (GMVP.PESO_FISICO=0 OR GMVP.PESO_FISICO&gt;50) AND GMVP.ID_PRODUCTO IN(27)&#xA;&#xA;--DECODIFICADORES DIRECT TV se le coloca 1 Kg&#xA;UPDATE GMVP SET GMVP.PESO_FISICO=1&#xA;FROM TMP_BORRAR_LOCAL.DBO.INFO_GUIAS_MANIFIESTOS_VOLUMEN_PIEZAS GMVP&#xA;WHERE substring(CAST(NUMERO_GUIA AS NVARCHAR(20)),0,5)=substring(CAST(PESO_FISICO AS NVARCHAR(20)),0,5)&#xA;&#xA;--AND GMVP.ID_PRODUCTO IN(27)&#xA;&#xA;--Peso Volumetrico tula de seguridad&#xA;UPDATE GMVP SET &#xA;GMVP.PESO_VOLU=2, GMVP.PESO_FISICO=2&#xA;FROM TMP_BORRAR_LOCAL.DBO.INFO_GUIAS_MANIFIESTOS_VOLUMEN_PIEZAS GMVP&#xA;INNER JOIN Mece_Logistico.DBO.GUIAS G (NOLOCK) ON G.NUMERO_GUIA=GMVP.NUMERO_GUIA&#xA;WHERE (ISNULL(GMVP.PESO_VOLU,0)=0 OR GMVP.PESO_VOLU&gt;200)  and GMVP.ID_PRODUCTO IN (7) AND  SUBSTRING(CAST(GMVP.NUMERO_GUIA AS nvarchar),1,1)=9&#xA;&#xA;UPDATE GMVP SET GMVP.PESO_FISICO=2&#xA;FROM TMP_BORRAR_LOCAL.DBO.INFO_GUIAS_MANIFIESTOS_VOLUMEN_PIEZAS GMVP&#xA;INNER JOIN Mece_Logistico.DBO.GUIAS G (NOLOCK) ON G.NUMERO_GUIA=GMVP.NUMERO_GUIA&#xA;WHERE (ISNULL(GMVP.PESO_FISICO,0)=0 OR GMVP.PESO_FISICO&gt;200)  and GMVP.ID_PRODUCTO IN (7) AND  SUBSTRING(CAST(GMVP.NUMERO_GUIA AS nvarchar),1,1)=9&#xA;&#xA;&#xA;&#xA;&#xA;--DE SEGUIMIENTO PIEZAS SE ACTUALIZA MEDIDAS, NUMERO PIEZAS  Y PESO VOLUMETRICO&#xA;UPDATE GMVP SET GMVP.LARGO_ENV=SP.LARGO_PIEZA, GMVP.ALTO_ENV =SP.ALTO_PIEZA, GMVP.ANCHO_ENV=SP.ANCHO_PIEZA&#xA;,GMVP.PESO_VOLU=SP.PESO_VOLU_PIEZAS_TOTAL&#xA;,GMVP.NUMERO_PIEZAS=SP.ITEM_UNI_GUIA&#xA;,GMVP.PESO_FISICO= SP.PESO_PIEZAS_TOTAL ---- case when len(convert(int,SP.PESO_PIEZAS_TOTAL))&gt;5 then 0 else SP.PESO_PIEZAS_TOTAL END&#xA;FROM TMP_BORRAR_LOCAL.DBO.INFO_GUIAS_MANIFIESTOS_VOLUMEN_PIEZAS GMVP&#xA;INNER JOIN TMP_BORRAR_LOCAL.DBO.INFO_GUIAS_SEGUIMIENTO_PIEZAS SP (NOLOCK) ON SP.NUMERO_GUIA=GMVP.NUMERO_GUIA&#xA;WHERE ISNULL(GMVP.PESO_VOLU,0)=0 and &#xA;ISNULL(SP.LARGO_PIEZA,0)!=0 and ISNULL(SP.ALTO_PIEZA,0)!=0 and ISNULL(SP.ANCHO_PIEZA,0)!=0&#xA;AND SP.ITEM_UNI_GUIA&gt;0&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;--Medidas ANTICIPADA&#xA;UPDATE GMVP SET GMVP.LARGO_ENV=G.LARGO_ENVIO, GMVP.ALTO_ENV =G.ALTO_ENVIO, GMVP.ANCHO_ENV=G.ANCHO_ENVIO,&#xA;GMVP.PESO_VOLU=(G.LARGO_ENVIO*G.ALTO_ENVIO*G.ANCHO_ENVIO)*222/1000000&#xA;,GMVP.PESO_FISICO=G.PESO_FISICO_GUIA&#xA;FROM TMP_BORRAR_LOCAL.DBO.INFO_GUIAS_MANIFIESTOS_VOLUMEN_PIEZAS GMVP&#xA;INNER JOIN Mece_Logistico.DBO.GUIAS_INF_ANTICIPADA G (NOLOCK) ON G.NUMERO_GUIA=GMVP.NUMERO_GUIA&#xA;WHERE ISNULL(GMVP.PESO_VOLU,0)=0 and ISNULL(G.LARGO_ENVIO,0)!=0 and ISNULL(G.ALTO_ENVIO,0)!=0 and ISNULL(G.ANCHO_ENVIO,0)!=0&#xA;--AND GMVP.ID_PRODUCTO NOT IN(6,82)&#xA;&#xA;--PESO ANTICIPADA&#xA;UPDATE GMVP SET GMVP.PESO_FISICO=G.PESO_FISICO_GUIA&#xA;FROM TMP_BORRAR_LOCAL.DBO.INFO_GUIAS_MANIFIESTOS_VOLUMEN_PIEZAS GMVP&#xA;INNER JOIN Mece_Logistico.DBO.GUIAS_INF_ANTICIPADA G (NOLOCK) ON G.NUMERO_GUIA=GMVP.NUMERO_GUIA&#xA;WHERE ISNULL(G.PESO_FISICO_GUIA,0)!=0 AND ISNULL(GMVP.PESO_FISICO,0)!=0&#xA;&#xA;&#xA;--Medidas GUIAS OPERA&#xA;UPDATE GMVP SET GMVP.LARGO_ENV=G.LARGO_ENV_OPERA, GMVP.ALTO_ENV =G.ALTO_ENV_OPERA,GMVP.ANCHO_ENV=G.ANCHO_ENV_OPERA,&#xA;GMVP.PESO_VOLU=(G.LARGO_ENV_OPERA*G.ALTO_ENV_OPERA*G.ANCHO_ENV_OPERA)*222/1000000&#xA;FROM TMP_BORRAR_LOCAL.DBO.INFO_GUIAS_MANIFIESTOS_VOLUMEN_PIEZAS GMVP&#xA;INNER JOIN Mece_Logistico.DBO.GUIAS G (NOLOCK) ON G.NUMERO_GUIA=GMVP.NUMERO_GUIA&#xA;WHERE ISNULL(GMVP.PESO_VOLU,0)=0 and ISNULL(G.LARGO_ENV_OPERA,0)!=0 and ISNULL(G.ALTO_ENV_OPERA,0)!=0 and ISNULL(G.ANCHO_ENV_OPERA,0)!=0&#xA;--AND GMVP.ID_PRODUCTO NOT IN(6,82)&#xA;&#xA;--PESO GUIAS OPERA&#xA;UPDATE GMVP SET GMVP.PESO_FISICO=G.PESO_FISICO_OPERA&#xA;FROM TMP_BORRAR_LOCAL.DBO.INFO_GUIAS_MANIFIESTOS_VOLUMEN_PIEZAS GMVP&#xA;INNER JOIN Mece_Logistico.DBO.GUIAS G (NOLOCK) ON G.NUMERO_GUIA=GMVP.NUMERO_GUIA&#xA;WHERE ISNULL(G.PESO_FISICO_OPERA,0)!=0 AND ISNULL(GMVP.PESO_FISICO,0)!=0&#xA;&#xA;--Medidas GUIAS DE LA GUIA&#xA;UPDATE GMVP SET GMVP.LARGO_ENV=G.LARGO_ENVIO, GMVP.ALTO_ENV =G.ALTO_ENVIO,GMVP.ANCHO_ENV=G.ANCHO_ENVIO,&#xA;GMVP.PESO_VOLU=(G.LARGO_ENVIO*G.ALTO_ENVIO*G.ANCHO_ENVIO)*222/1000000&#xA;FROM TMP_BORRAR_LOCAL.DBO.INFO_GUIAS_MANIFIESTOS_VOLUMEN_PIEZAS GMVP&#xA;INNER JOIN Mece_Logistico.DBO.GUIAS G (NOLOCK) ON G.NUMERO_GUIA=GMVP.NUMERO_GUIA&#xA;WHERE ISNULL(GMVP.PESO_VOLU,0)=0 and ISNULL(G.LARGO_ENVIO,0)!=0 and ISNULL(G.ALTO_ENVIO,0)!=0 and ISNULL(G.ANCHO_ENVIO,0)!=0&#xA;--AND GMVP.ID_PRODUCTO NOT IN(6,82)&#xA;&#xA;&#xA;&#xA;--PESO GUIAS DE LA GUIA&#xA;UPDATE GMVP SET  GMVP.PESO_FISICO=G.PESO_FISICO_GUIA&#xA;FROM TMP_BORRAR_LOCAL.DBO.INFO_GUIAS_MANIFIESTOS_VOLUMEN_PIEZAS GMVP&#xA;INNER JOIN Mece_Logistico.DBO.GUIAS G (NOLOCK) ON G.NUMERO_GUIA=GMVP.NUMERO_GUIA&#xA;WHERE ISNULL(G.PESO_FISICO_GUIA,0)!=0 AND ISNULL(GMVP.PESO_FISICO,0)!=0&#xA;--AND GMVP.ID_PRODUCTO NOT IN(6,82)&#xA;&#xA;&#xA;&#xA;&#xA;--1 Peso Fisico Opera se pasa al peso Volumetrico&#xA;UPDATE GMVP SET &#xA;GMVP.PESO_VOLU=G.PESO_FISICO_OPERA&#xA;FROM TMP_BORRAR_LOCAL.DBO.INFO_GUIAS_MANIFIESTOS_VOLUMEN_PIEZAS GMVP&#xA;INNER JOIN Mece_Logistico.DBO.GUIAS G (NOLOCK) ON G.NUMERO_GUIA=GMVP.NUMERO_GUIA&#xA;WHERE ISNULL(GMVP.PESO_VOLU,0)=0 AND ISNULL(G.PESO_FISICO_OPERA,0)!=0 and GMVP.ID_PRODUCTO IN (2,59,7)&#xA;AND GMVP.LARGO_ENV=1 and GMVP.ALTO_ENV=1 and GMVP.ANCHO_ENV=1 AND G.PESO_FISICO_OPERA&lt;1000&#xA;&#xA;--2 Peso Fisico guia se pasa al peso Volumetrico&#xA;UPDATE GMVP SET &#xA;GMVP.PESO_VOLU=G.PESO_FISICO_GUIA&#xA;FROM TMP_BORRAR_LOCAL.DBO.INFO_GUIAS_MANIFIESTOS_VOLUMEN_PIEZAS GMVP&#xA;INNER JOIN Mece_Logistico.DBO.GUIAS G (NOLOCK) ON G.NUMERO_GUIA=GMVP.NUMERO_GUIA&#xA;WHERE ISNULL(GMVP.PESO_VOLU,0)=0 AND ISNULL(G.PESO_FISICO_GUIA,0)!=0 and GMVP.ID_PRODUCTO IN (2,59,7)&#xA;AND GMVP.LARGO_ENV=1 and GMVP.ALTO_ENV=1 and GMVP.ANCHO_ENV=1 AND G.PESO_FISICO_GUIA&lt;1000&#xA;&#xA;/*&#xA;select * from TMP_BORRAR_LOCAL.DBO.INFO_GUIAS_MANIFIESTOS_VOLUMEN_PIEZAS GMVP&#xA;where GMVP.PESO_VOLU=0&#xA;--------------1 volumen de anticipada&#xA;------------UPDATE GMVP SET GMVP.PESO_VOLU=G.PESO_VOLU_GUIA&#xA;------------FROM TMP_BORRAR_LOCAL.DBO.INFO_GUIAS_MANIFIESTOS_VOLUMEN_PIEZAS GMVP&#xA;------------INNER JOIN Mece_Logistico.DBO.GUIAS_INF_ANTICIPADA G (NOLOCK) ON G.NUMERO_GUIA=GMVP.NUMERO_GUIA&#xA;------------WHERE ISNULL(GMVP.PESO_VOLU,0)=0 and &#xA;------------ISNULL(G.PESO_VOLU_GUIA,0)!=0&#xA;&#xA;--------------2 volumen de guias de la operacion&#xA;------------UPDATE GMVP SET GMVP.PESO_VOLU=G.PESO_VOLU_OPERA&#xA;------------FROM TMP_BORRAR_LOCAL.DBO.INFO_GUIAS_MANIFIESTOS_VOLUMEN_PIEZAS GMVP&#xA;------------INNER JOIN Mece_Logistico.DBO.GUIAS G (NOLOCK) ON G.NUMERO_GUIA=GMVP.NUMERO_GUIA&#xA;------------WHERE ISNULL(GMVP.PESO_VOLU,0)=0 and ISNULL(G.PESO_VOLU_OPERA,0)!=0&#xA;*/&#xA;&#xA;&#xA;--------------3 volumen de facturaci n&#xA;------------UPDATE GMVP SET GMVP.PESO_VOLU=G.PESO_VOLU_OPERA&#xA;------------FROM TMP_BORRAR_LOCAL.DBO.INFO_GUIAS_MANIFIESTOS_VOLUMEN_PIEZAS GMVP&#xA;------------INNER JOIN [tmp_borrar_LOCAL].[dbo].[MERF_INGRESO_FACTURADO]  G (NOLOCK) ON G.NUMERO_GUIA=GMVP.NUMERO_GUIA&#xA;------------WHERE ISNULL(GMVP.PESO_VOLU,0)=0 and ISNULL(G.PESO_VOLU_OPERA,0)!=0&#xA;&#xA;&#xA;--------------4 volumen de guias de la operacion&#xA;------------UPDATE GMVP SET GMVP.PESO_VOLU=G.PESO_VOLU_GUIA&#xA;------------FROM TMP_BORRAR_LOCAL.DBO.INFO_GUIAS_MANIFIESTOS_VOLUMEN_PIEZAS GMVP&#xA;------------INNER JOIN Mece_Logistico.DBO.GUIAS G (NOLOCK) ON G.NUMERO_GUIA=GMVP.NUMERO_GUIA&#xA;------------WHERE ISNULL(GMVP.PESO_VOLU,0)=0 and ISNULL(G.PESO_VOLU_GUIA,0)!=0 AND G.PESO_VOLU_GUIA&lt;500&#xA;&#xA;--------------4 volumen de guias de la operacion&#xA;------------UPDATE GMVP SET GMVP.PESO_VOLU=G.PESO_VOLU_GUIA&#xA;------------FROM TMP_BORRAR_LOCAL.DBO.INFO_GUIAS_MANIFIESTOS_VOLUMEN_PIEZAS GMVP&#xA;------------INNER JOIN Mece_Logistico.DBO.GUIAS G (NOLOCK) ON G.NUMERO_GUIA=GMVP.NUMERO_GUIA&#xA;------------WHERE ISNULL(G.PESO_VOLU_GUIA,0)!=0 AND GMVP.ID_PRODUCTO=6 AND GMVP.PESO_VOLU&gt;200&#xA;&#xA;&#xA;------------UPDATE GMVP SET GMVP.PESO_VOLU=0&#xA;------------FROM TMP_BORRAR_LOCAL.DBO.INFO_GUIAS_MANIFIESTOS_VOLUMEN_PIEZAS GMVP&#xA;------------INNER JOIN Mece_Logistico.DBO.GUIAS G (NOLOCK) ON G.NUMERO_GUIA=GMVP.NUMERO_GUIA&#xA;------------WHERE GMVP.ID_PRODUCTO IN (2,7) AND GMVP.PESO_VOLU&gt;100 &#xA;------------and ISNULL(G.LARGO_ENV_OPERA,0)!=0 and ISNULL(G.ALTO_ENV_OPERA,0)!=0 and ISNULL(G.ANCHO_ENV_OPERA,0)!=0&#xA; &#xA;&#xA;----------------4 volumen de guias de la guia&#xA;--------------UPDATE GMVP SET GMVP.PESO_VOLU=G.PESO_VOLU_GUIA&#xA;--------------FROM TMP_BORRAR_LOCAL.DBO.INFO_GUIAS_MANIFIESTOS_VOLUMEN_PIEZAS GMVP&#xA;--------------INNER JOIN Mece_Logistico.DBO.GUIAS G (NOLOCK) ON G.NUMERO_GUIA=GMVP.NUMERO_GUIA&#xA;--------------WHERE ISNULL(GMVP.PESO_VOLU,0)=0 and ISNULL(G.PESO_VOLU_GUIA,0)!=0&#xA;&#xA;-----------------------------------------------------------------&#xA;&#xA;&#xA;-----------------------------------------------------------------------&#xA;&#xA;&#xA;--Peso Fisico se pasa al peso Volumetrico&#xA;UPDATE GMVP SET &#xA;GMVP.PESO_VOLU=G.PESO_FISICO_OPERA&#xA;FROM TMP_BORRAR_LOCAL.DBO.INFO_GUIAS_MANIFIESTOS_VOLUMEN_PIEZAS GMVP&#xA;INNER JOIN Mece_Logistico.DBO.GUIAS G (NOLOCK) ON G.NUMERO_GUIA=GMVP.NUMERO_GUIA&#xA;WHERE ISNULL(GMVP.PESO_VOLU,0)=0 AND ISNULL(G.PESO_FISICO_OPERA,0)!=0 and GMVP.ID_PRODUCTO IN (7) AND G.PESO_FISICO_OPERA&lt;1000&#xA;&#xA;&#xA;----------------------------------------------------------------------------&#xA;----------------------------------------------------------------------------&#xA;----------------------------------------------------------------------------&#xA;----SE PRIORIZA LA INFORMACION GENERADA DE PREFACTURACION.&#xA;&#xA;--2 SE ACTUALIZAN LAS PIEZAS de Ciclo del ingreso&#xA;UPDATE GMVP SET GMVP.NUMERO_PIEZAS=G.NUMERO_PIEZAS&#xA;FROM TMP_BORRAR_LOCAL.DBO.INFO_GUIAS_MANIFIESTOS_VOLUMEN_PIEZAS GMVP&#xA;INNER JOIN [tmp_borrar_LOCAL].[dbo].[MERF_INGRESO_FACTURADO] G (NOLOCK) ON G.NUMERO_GUIA=GMVP.NUMERO_GUIA&#xA;WHERE --ISNULL(GMVP.NUMERO_PIEZAS,0)=0 --and &#xA;ISNULL(G.NUMERO_PIEZAS,0)!=0&#xA;&#xA;&#xA;--3 volumen de facturaci n cuando el peso asignado esmayor al facturado&#xA;UPDATE GMVP SET GMVP.PESO_VOLU=G.PESO_VOLU_OPERA&#xA;FROM TMP_BORRAR_LOCAL.DBO.INFO_GUIAS_MANIFIESTOS_VOLUMEN_PIEZAS GMVP&#xA;INNER JOIN [tmp_borrar_LOCAL].[dbo].[MERF_INGRESO_FACTURADO]  G (NOLOCK) ON G.NUMERO_GUIA=GMVP.NUMERO_GUIA&#xA;--WHERE --ISNULL(GMVP.PESO_VOLU,0)!=0  &#xA;where ISNULL(G.PESO_VOLU_OPERA,0)!=0&#xA;--and  GMVP.PESO_VOLU&gt;G.PESO_VOLU_OPERA&#xA;&#xA;&#xA;--3 feso fisico&#xA;UPDATE GMVP SET GMVP.PESO_FISICO=G.PESO_FISICO_OPERA&#xA;FROM TMP_BORRAR_LOCAL.DBO.INFO_GUIAS_MANIFIESTOS_VOLUMEN_PIEZAS GMVP&#xA;INNER JOIN [tmp_borrar_LOCAL].[dbo].[MERF_INGRESO_FACTURADO]  G (NOLOCK) ON G.NUMERO_GUIA=GMVP.NUMERO_GUIA&#xA;--WHERE --ISNULL(GMVP.PESO_VOLU,0)!=0  &#xA;where ISNULL(G.PESO_FISICO_OPERA,0)!=0&#xA;--and GMVP.NUMERO_GUIA=2243843085&#xA;--and  GMVP.PESO_VOLU&gt;G.PESO_VOLU_OPERA&#xA;&#xA;&#xA;----3 volumen de facturaci n cuando el peso volu esta en cero&#xA;--UPDATE GMVP SET GMVP.PESO_VOLU=G.PESO_VOLU_OPERA&#xA;--FROM TMP_BORRAR_LOCAL.DBO.INFO_GUIAS_MANIFIESTOS_VOLUMEN_PIEZAS GMVP&#xA;--INNER JOIN [tmp_borrar_LOCAL].[dbo].[MERF_INGRESO_FACTURADO]  G (NOLOCK) ON G.NUMERO_GUIA=GMVP.NUMERO_GUIA&#xA;--WHERE ISNULL(GMVP.PESO_VOLU,0)=0  &#xA;--and ISNULL(G.PESO_VOLU_OPERA,0)!=0&#xA;--and  G.PESO_VOLU_OPERA&lt;10000&#xA;&#xA;----------------------------------------------------------------------------&#xA;----------------------------------------------------------------------------&#xA;----------------------------------------------------------------------------&#xA;&#xA;&#xA;--TRUNCATE TABLE TMP_BORRAR_LOCAL.DBO.INFO_MANIFIESTOS_VOLUMEN_PIEZAS&#xA;&#xA;--select * from TMP_BORRAR_LOCAL.DBO.INFO_MANIFIESTOS_VOLUMEN_PIEZAS&#xA;--where PESO_VOLU_TOTAL=0" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
                  </DTS:ObjectData>
                </DTS:Executable>
              </DTS:Executables>
              <DTS:PrecedenceConstraints>
