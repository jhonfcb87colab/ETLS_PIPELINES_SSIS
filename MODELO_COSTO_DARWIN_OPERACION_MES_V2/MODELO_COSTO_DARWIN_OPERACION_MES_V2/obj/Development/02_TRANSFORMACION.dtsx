                  SQLTask:SqlStatementSource="TRUNCATE TABLE TMP_BORRAR_LOCAL.DBO.GUIAS_RED_OPERATIVA&#xA;&#xA;TRUNCATE TABLE TMP_BORRAR_LOCAL.DBO.INFORMACION_GUIAS_RED_OPERATIVA&#xA;&#xA;TRUNCATE TABLE TMP_BORRAR_LOCAL.DBO.DOCUMENTOS_GUIAS_RED_OPERATIVA&#xA;&#xA;TRUNCATE TABLE TMP_BORRAR_LOCAL.DBO.VEHICULOS_DOCUMENTOS_RED_OPERATIVA&#xA;&#xA;TRUNCATE TABLE TMP_BORRAR_LOCAL.DBO.VEHICULOS_TOTALES_RED_OPERATIVA&#xA;&#xA;TRUNCATE TABLE TMP_BORRAR_LOCAL.DBO.DOCUMENTOS_RED_OPERATIVA&#xA;&#xA;TRUNCATE TABLE TMP_BORRAR_LOCAL.DBO.INFORMACION_DOCUMENTOS_RED_OPERATIVA&#xA;&#xA;TRUNCATE TABLE TMP_BORRAR_LOCAL.DBO.INFORMACION_DOCUMENTOS_TOTALIZADOS_RED_OPERATIVA&#xA;&#xA;TRUNCATE TABLE TMP_BORRAR_LOCAL.DBO.PROCESOS_ADICIONALES_RED_OPERATIVA&#xA; " xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
