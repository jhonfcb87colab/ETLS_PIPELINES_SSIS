          DTS:DTSID="{e6910403-457d-4b61-9cf9-9626d42f0395}"
          DTS:ExecutableType="STOCK:SEQUENCE"
          DTS:LocaleID="-1"
          DTS:ObjectName="PASO 1_2 INFO_GUIAS_MANIFIESTOS_VOLUMEN_PIEZAS V2 PARTE 3 y 4">
          <DTS:Variables />
          <DTS:Executables>
            <DTS:Executable
              DTS:refId="Package\PASO 1_1 Y 1_2\PASO 1_2 INFO_GUIAS_MANIFIESTOS_VOLUMEN_PIEZAS V2 PARTE 3 y 4\PARTE 3 INFO_GUIAS_MANIFIESTOS_VOLUMEN_PIEZAS V2"
              DTS:CreationName="Microsoft.ExecuteSQLTask"
              DTS:Description="Execute SQL Task"
              DTS:DTSID="{d75c0824-20ca-4ea9-b6df-0b8de2d26e63}"
              DTS:ExecutableType="Microsoft.ExecuteSQLTask"
              DTS:LocaleID="-1"
              DTS:ObjectName="PARTE 3 INFO_GUIAS_MANIFIESTOS_VOLUMEN_PIEZAS V2"
              DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
              DTS:ThreadHint="0">
              <DTS:Variables />
              <DTS:ObjectData>
                <SQLTask:SqlTaskData
                  SQLTask:Connection="{A3A65FF9-9058-4FB8-AA1A-7AABA464327A}"
                  SQLTask:SqlStatementSource="&#xA;INSERT INTO TMP_BORRAR_LOCAL.DBO.INFO_MANIFIESTOS_VOLUMEN_PIEZAS&#xA;SELECT TDOC.ID_PROCESO, TDOC.NUMERO_MOVIMI,TDOC.CONSECUT_MOVIMI, &#xA;SUM(GMVP.PESO_VOLU) AS PESO_VOLU_TOTAL,&#xA;SUM(GMVP.PESO_FISICO) AS PESO_FISICO_TOTAL,SUM(GMVP.NUMERO_PIEZAS) AS NUMERO_PIEZAS_TOTAL &#xA;FROM TMP_BORRAR_LOCAL.DBO.DOCUMENTOS_MECE_LOGISTICO_RED_OPERATIVA TDOC (NOLOCK)&#xA;INNER JOIN Mece_Logistico.DBO.SEGUIMIENTO_ENVIO SE (NOLOCK) ON SE.ID_PROCESO=TDOC.ID_PROCESO&#xA; AND SE.NUMERO_MOVIMI=TDOC.NUMERO_MOVIMI AND SE.CONSECUT_MOVIMI=TDOC.CONSECUT_MOVIMI&#xA;INNER JOIN TMP_BORRAR_LOCAL.DBO.INFO_GUIAS_MANIFIESTOS_VOLUMEN_PIEZAS GMVP (NOLOCK) ON GMVP.NUMERO_GUIA=SE.NUMERO_GUIA&#xA;LEFT JOIN TMP_BORRAR_LOCAL.DBO.INFO_MANIFIESTOS_VOLUMEN_PIEZAS MVP (NOLOCK) ON MVP.ID_PROCESO=TDOC.ID_PROCESO &#xA; AND MVP.NUMERO_MOVIMI=TDOC.NUMERO_MOVIMI AND MVP.CONSECUT_MOVIMI=TDOC.CONSECUT_MOVIMI&#xA;WHERE MVP.ID_PROCESO IS NULL AND MVP.NUMERO_MOVIMI IS NULL AND MVP.CONSECUT_MOVIMI IS NULL&#xA;--TDOC.ID_PROCESO=9 AND TDOC.NUMERO_MOVIMI='001002001931008032025' AND TDOC.CONSECUT_MOVIMI=2&#xA;GROUP BY   TDOC.ID_PROCESO, TDOC.NUMERO_MOVIMI,TDOC.CONSECUT_MOVIMI" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
              </DTS:ObjectData>
            </DTS:Executable>
            <DTS:Executable
              DTS:refId="Package\PASO 1_1 Y 1_2\PASO 1_2 INFO_GUIAS_MANIFIESTOS_VOLUMEN_PIEZAS V2 PARTE 3 y 4\PARTE 4 INFO_GUIAS_MANIFIESTOS_VOLUMEN_PIEZAS V2"
              DTS:CreationName="Microsoft.ExecuteSQLTask"
              DTS:Description="Execute SQL Task"
              DTS:DTSID="{f575ea3b-6b53-48ff-9632-5e616101d4a8}"
              DTS:ExecutableType="Microsoft.ExecuteSQLTask"
              DTS:LocaleID="-1"
              DTS:ObjectName="PARTE 4 INFO_GUIAS_MANIFIESTOS_VOLUMEN_PIEZAS V2"
              DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
              DTS:ThreadHint="0">
              <DTS:Variables />
              <DTS:ObjectData>
                <SQLTask:SqlTaskData
                  SQLTask:Connection="{A3A65FF9-9058-4FB8-AA1A-7AABA464327A}"
                  SQLTask:SqlStatementSource="&#xA;--actualizacion final peso volumetrico &#xA;/*&#xA;UPDATE TDOC SET &#xA;TDOC.PESO_VOLU_TOTAL=TRY_CONVERT(NUMERIC(38, 3), MVP.PESO_VOLU_TOTAL)&#xA;FROM TMP_BORRAR_LOCAL.DBO.DOCUMENTOS_MECE_LOGISTICO_RED_OPERATIVA TDOC &#xA;INNER JOIN TMP_BORRAR_LOCAL.DBO.INFO_MANIFIESTOS_VOLUMEN_PIEZAS MVP (NOLOCK) ON&#xA; MVP.ID_PROCESO=TDOC.ID_PROCESO AND MVP.NUMERO_MOVIMI=TDOC.NUMERO_MOVIMI AND MVP.CONSECUT_MOVIMI=TDOC.CONSECUT_MOVIMI&#xA;WHERE  TDOC.PESO_VOLU_TOTAL=0&#xA;*/&#xA;BEGIN TRY &#xA;UPDATE TDOC SET &#xA;TDOC.PESO_VOLU_TOTAL=TRY_CONVERT(NUMERIC(38, 3), MVP.PESO_VOLU_TOTAL)&#xA;,TDOC.PESO_TOTAL_CALCULADO=TRY_CONVERT(NUMERIC(38, 3), MVP.[PESO_FISICO_TOTAL])&#xA;FROM TMP_BORRAR_LOCAL.DBO.DOCUMENTOS_MECE_LOGISTICO_RED_OPERATIVA TDOC &#xA;INNER JOIN TMP_BORRAR_LOCAL.DBO.INFO_MANIFIESTOS_VOLUMEN_PIEZAS MVP (NOLOCK) ON&#xA; MVP.ID_PROCESO=TDOC.ID_PROCESO AND MVP.NUMERO_MOVIMI=TDOC.NUMERO_MOVIMI AND MVP.CONSECUT_MOVIMI=TDOC.CONSECUT_MOVIMI&#xA;WHERE  TDOC.PESO_VOLU_TOTAL=0&#xA;END TRY&#xA;BEGIN CATCH&#xA;    DECLARE @ErrorMessage NVARCHAR(4000);&#xA;    DECLARE @ErrorSeverity INT;&#xA;    DECLARE @ErrorState INT;&#xA;&#xA;    SELECT &#xA;        @ErrorMessage = ERROR_MESSAGE(),&#xA;        @ErrorSeverity = ERROR_SEVERITY(),&#xA;        @ErrorState = ERROR_STATE();&#xA;&#xA;    PRINT 'Error capturado en UPDATE: ' + @ErrorMessage;&#xA;END CATCH;&#xA;&#xA;&#xA;--actualizacion final piezas&#xA;UPDATE TDOC SET TDOC.TOTAL_PIEZAS=MVP.NUMERO_PIEZAS_TOTAL&#xA;FROM TMP_BORRAR_LOCAL.DBO.DOCUMENTOS_MECE_LOGISTICO_RED_OPERATIVA TDOC &#xA;INNER JOIN TMP_BORRAR_LOCAL.DBO.INFO_MANIFIESTOS_VOLUMEN_PIEZAS MVP (NOLOCK) ON&#xA; MVP.ID_PROCESO=TDOC.ID_PROCESO AND MVP.NUMERO_MOVIMI=TDOC.NUMERO_MOVIMI AND MVP.CONSECUT_MOVIMI=TDOC.CONSECUT_MOVIMI&#xA;WHERE  TDOC.TOTAL_PIEZAS=0&#xA;&#xA;UPDATE TDOC SET &#xA;PESO_TOTAL=CASE WHEN PESO_TOTAL_CALCULADO&gt;PESO_TOTAL THEN PESO_TOTAL_CALCULADO ELSE PESO_TOTAL END&#xA;from TMP_BORRAR_LOCAL.DBO.DOCUMENTOS_MECE_LOGISTICO_RED_OPERATIVA TDOC (nolock)&#xA;&#xA;&#xA;--SELECT TOP 1000 MVP.* FROM TMP_BORRAR_LOCAL.DBO.DOCUMENTOS_MECE_LOGISTICO_RED_OPERATIVA TDOC &#xA;--INNER JOIN TMP_BORRAR_LOCAL.DBO.INFO_MANIFIESTOS_VOLUMEN_PIEZAS MVP (NOLOCK) ON&#xA;-- MVP.ID_PROCESO=TDOC.ID_PROCESO AND MVP.NUMERO_MOVIMI=TDOC.NUMERO_MOVIMI AND MVP.CONSECUT_MOVIMI=TDOC.CONSECUT_MOVIMI&#xA;--ORDER BY MVP.PESO_VOLU_TOTAL DESC&#xA;&#xA;&#xA;--WHERE ID_PROCESO=9&#xA;--ORDER BY FECHA_HORA_MOVIMI DESC" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
              </DTS:ObjectData>
            </DTS:Executable>
          </DTS:Executables>
          <DTS:PrecedenceConstraints>
            <DTS:PrecedenceConstraint
              DTS:refId="Package\PASO 1_1 Y 1_2\PASO 1_2 INFO_GUIAS_MANIFIESTOS_VOLUMEN_PIEZAS V2 PARTE 3 y 4.PrecedenceConstraints[Constraint 2]"
              DTS:CreationName=""
              DTS:DTSID="{db3739a2-6e92-4f8d-a8ff-3c10c6bcf218}"
              DTS:From="Package\PASO 1_1 Y 1_2\PASO 1_2 INFO_GUIAS_MANIFIESTOS_VOLUMEN_PIEZAS V2 PARTE 3 y 4\PARTE 3 INFO_GUIAS_MANIFIESTOS_VOLUMEN_PIEZAS V2"
              DTS:LogicalAnd="True"
              DTS:ObjectName="Constraint 2"
              DTS:To="Package\PASO 1_1 Y 1_2\PASO 1_2 INFO_GUIAS_MANIFIESTOS_VOLUMEN_PIEZAS V2 PARTE 3 y 4\PARTE 4 INFO_GUIAS_MANIFIESTOS_VOLUMEN_PIEZAS V2" />
          </DTS:PrecedenceConstraints>
        </DTS:Executable>
      </DTS:Executables>
      <DTS:PrecedenceConstraints>
        <DTS:PrecedenceConstraint
          DTS:refId="Package\PASO 1_1 Y 1_2.PrecedenceConstraints[Constraint]"
          DTS:CreationName=""
          DTS:DTSID="{742931cb-a4af-42fd-8c4c-0bd75ce4d8d1}"
          DTS:From="Package\PASO 1_1 Y 1_2\PASO 1_1"
          DTS:LogicalAnd="True"
          DTS:ObjectName="Constraint"
          DTS:To="Package\PASO 1_1 Y 1_2\PASO 1_2 INFO_GUIAS_MANIFIESTOS_VOLUMEN_PIEZAS V2 PARTE 3 y 4" />
      </DTS:PrecedenceConstraints>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\PASO 2   script 2 EJECUTAR POR MES"
      DTS:CreationName="STOCK:SEQUENCE"
      DTS:Description="Sequence Container"
      DTS:DTSID="{0263c221-9ff0-4719-ae2b-b4b1bf778b6d}"
      DTS:ExecutableType="STOCK:SEQUENCE"
      DTS:LocaleID="-1"
      DTS:ObjectName="PASO 2   script 2 EJECUTAR POR MES">
      <DTS:Variables />
      <DTS:Executables>
        <DTS:Executable
          DTS:refId="Package\PASO 2   script 2 EJECUTAR POR MES\2 Consulta guias credito y retail para costos EJECUCION POR MESES PARAMETROS"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{87b506e6-333a-48f3-bbb4-1ba9e909d349}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="2 Consulta guias credito y retail para costos EJECUCION POR MESES PARAMETROS"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{A3A65FF9-9058-4FB8-AA1A-7AABA464327A}"
              SQLTask:SqlStatementSource="SET NOCOUNT ON&#xA;&#xA;DECLARE @NUMERO_GUIA NUMERIC(20,0)&#xA;DECLARE @PESO_FISICO_GUIA NUMERIC(8,3) = 0&#xA;DECLARE @MOVIMIENTOS_CROSS TINYINT = 0&#xA;DECLARE @TIPO_CANAL VARCHAR(20) = ''&#xA;DECLARE @MEDIO_PAGO VARCHAR(20) = ''&#xA;DECLARE @VALOR_RECAUDO NUMERIC(11,2) = 0&#xA;DECLARE @VALOR_ENVIO NUMERIC(11,2) = 0&#xA;DECLARE @EMPRESARIO_SATELITE BIT = 0&#xA;DECLARE @ENTREGADO_REMITENTE BIT = 0&#xA;DECLARE @NOMBRE_PRODUCTO VARCHAR(100)&#xA;DECLARE @NOMBRE_ESTADOENVIO VARCHAR(100)&#xA;DECLARE @CONSECUTIVO INT&#xA;DECLARE @TOTAL_GUIAS INT&#xA;&#xA;&#xA;&#xA;DECLARE @FECHA_INI DATETIME&#xA;DECLARE @FECHA_FIN DATETIME&#xA;&#xA;SET @FECHA_INI =CONVERT(DATETIME,?);&#xA;SET @FECHA_FIN =CONVERT(DATETIME,?);&#xA;&#xA;&#xA;/*&#xA;SET @FECHA_INI ='20250501 00:00:00'&#xA;SET @FECHA_FIN ='20250601 00:00:00'&#xA;*/&#xA;INSERT INTO TMP_BORRAR_LOCAL.DBO.GUIAS_RED_OPERATIVA (&#xA;NUMERO_GUIA,&#xA;ID_ESTADOENVIO)&#xA;SELECT DISTINCT G.NUMERO_GUIA,&#xA;G.ID_ESTADOENVIO&#xA;FROM MECE_LOGISTICO.DBO.GUIAS G (NOLOCK)&#xA;INNER JOIN MECE_LOGISTICO.DBO.SEGUIMIENTO_ENVIO SE (NOLOCK) ON SE.NUMERO_GUIA=G.NUMERO_GUIA&#xA;WHERE SE.FECHA_HORA_MOVIMIENTO &gt;=@FECHA_INI AND SE.FECHA_HORA_MOVIMIENTO&lt;@FECHA_FIN&#xA;AND SE.ID_PROCESO IN (5,6,9,12,14) AND LEN(G.NUMERO_GUIA)&gt;7--- MOVIMIENTOS_CROSS DEL MES&#xA;--WHERE FECHA_ENVIO &gt;=@FECHA_INI AND FECHA_ENVIO&lt;@FECHA_FIN&#xA;&#xA;&#xA;PRINT 'Borrando guias con estado NULL ' + CONVERT(VARCHAR,GETDATE(),112) + ' ' + CONVERT(VARCHAR,GETDATE(),114)&#xA;-- Borra las guías que no tengan estado de envío&#xA;DELETE FROM TMP_BORRAR_LOCAL.DBO.GUIAS_RED_OPERATIVA WHERE ID_ESTADOENVIO IS NULL&#xA;&#xA;------------------------------------------------------------------------------------------------&#xA;-- Selecciona la información de las guías&#xA;&#xA;PRINT 'Seleccionando informacion guias ' + CONVERT(VARCHAR,GETDATE(),112) + ' ' + CONVERT(VARCHAR,GETDATE(),114)&#xA;INSERT INTO TMP_BORRAR_LOCAL.DBO.INFORMACION_GUIAS_RED_OPERATIVA (&#xA;NUMERO_GUIA,&#xA;--FECHA_ENVIO,&#xA;PESO_FISICO_OPERA,&#xA;PESO_VOLU_OPERA,&#xA;TIPO_CANAL,&#xA;VALOR_ENVIO,&#xA;ID_PRODUCTO,&#xA;PESO_FISICO_GUIA,&#xA;PESO_VOLU_GUIA,&#xA;NUMERO_PIEZAS,&#xA;--LARGO_ENVIO,&#xA;--ALTO_ENVIO,&#xA;--ANCHO_ENVIO,&#xA;ID_ESTADOENVIO,&#xA;ID_CLIENTE,&#xA;ID_PAIS_CANAL,&#xA;ID_CIUDAD_CANAL,&#xA;ID_CANAL,&#xA;ID_CIUDAD_ORIGEN,&#xA;ID_CIUDAD_DESTINO)&#xA;SELECT &#xA;GUI.NUMERO_GUIA,&#xA;--NULL,--GUI.FECHA_ENVIO,&#xA;ISNULL(GUI.PESO_FISICO_OPERA,0) AS PESO_FISICO_OPERA,&#xA;ISNULL(GUI.PESO_VOLU_OPERA,0) AS PESO_VOLU_OPERA,&#xA;CASE &#xA; WHEN ISNULL(GUI.ID_CLIENTE,'') &lt;&gt; '' THEN 'CORPORATIVO'&#xA; WHEN ISNULL(GUI.ID_CANAL,0) &lt;&gt; 0 THEN 'RETAIL'&#xA; ELSE 'DIVISION'&#xA;END AS TIPO_CANAL,&#xA;ISNULL(GUI.VALOR_FLETES_GUIAS,0) + ISNULL(GUI.VALOR_SEG_MAN_GUIAS,0) - ISNULL(GUI.VALOR_DESCUENTO_GUIAS,0) AS VALOR_ENVIO,&#xA;GUI.ID_PRODUCTO,&#xA;ISNULL(GUI.PESO_FISICO_GUIA,0) AS PESO_FISICO_GUIA,&#xA;ISNULL(GUI.PESO_VOLU_GUIA,0) AS PESO_VOLU_GUIA,&#xA;GUI.NUMERO_PIEZAS,&#xA;--GUI.LARGO_ENVIO,&#xA;--GUI.ALTO_ENVIO,&#xA;--GUI.ANCHO_ENVIO,&#xA;TMPGUI.ID_ESTADOENVIO,&#xA;GUI.ID_CLIENTE,&#xA;GUI.ID_1,&#xA;GUI.ID_2,&#xA;GUI.ID_CANAL,&#xA;GUI.ID_CIUDAD_ORIGEN,&#xA;GUI.ID_CIUDAD_DESTINO&#xA;FROM TMP_BORRAR_LOCAL.DBO.GUIAS_RED_OPERATIVA TMPGUI (NOLOCK)&#xA;INNER JOIN MECE_LOGISTICO.DBO.GUIAS GUI (NOLOCK) ON GUI.NUMERO_GUIA = TMPGUI.NUMERO_GUIA --AND ID_PRODUCTO IN (1,2,6,59)&#xA;&#xA;--DECLARE @FECHA_INI DATETIME&#xA;--DECLARE @FECHA_FIN DATETIME&#xA;&#xA;--SET @FECHA_INI ='20250101 00:00:00'&#xA;--SET @FECHA_FIN ='20250201 00:00:00'&#xA;&#xA;---Actualiza VALOR FACTURADO COORPORATIVO Y PESO FACTURADO&#xA;UPDATE TMPGUI SET TMPGUI.PESO_FACTURADO=MIFG.PESO_CONSOLIDADO, TMPGUI.VALOR_FACTURADO=ISNULL(MIFG.FLETE + MIFG.SOBRE_FLETE - MIFG.DESCUENTO,0)&#xA;,TMPGUI.FECHA_FACTURADO=MIFG.FECHA_FACTURACION&#xA;FROM TMP_BORRAR_LOCAL.DBO.INFORMACION_GUIAS_RED_OPERATIVA TMPGUI (nolock)  &#xA;INNER JOIN [tmp_borrar_LOCAL].[dbo].[MERF_INGRESO_FACTURADO] MIFG (NOLOCK) ON MIFG.NUMERO_GUIA=TMPGUI.NUMERO_GUIA&#xA;WHERE TMPGUI.TIPO_CANAL='CORPORATIVO' AND MIFG.FECHA_FACTURACION &gt;=@FECHA_INI AND MIFG.FECHA_FACTURACION&lt;@FECHA_FIN&#xA;AND MIFG.ID_FACTURADO=10&#xA;&#xA;---Actualiza VALOR FACTURADO RETAIL Y PESO FACTURADO&#xA;UPDATE TMPGUI SET &#xA;TMPGUI.PESO_FACTURADO=CASE WHEN GAN.PESO_FISICO_GUIA&gt;=GAN.PESO_VOLU_GUIA THEN GAN.PESO_FISICO_GUIA ELSE GAN.PESO_VOLU_GUIA END, &#xA;TMPGUI.PESO_FISICO_GUIA=CASE WHEN GAN.PESO_FISICO_GUIA&gt;=GAN.PESO_VOLU_GUIA THEN GAN.PESO_FISICO_GUIA ELSE GAN.PESO_VOLU_GUIA END, &#xA;TMPGUI.VALOR_FACTURADO=ISNULL(GAN.VALOR_FLETES_GUIAS + GAN.VALOR_SEG_MAN_GUIAS - GAN.VALOR_DESCUENTO_GUIAS,0),&#xA;TMPGUI.FECHA_FACTURADO=GAN.FECHA_ENVIO&#xA;FROM TMP_BORRAR_LOCAL.DBO.INFORMACION_GUIAS_RED_OPERATIVA TMPGUI  &#xA;INNER JOIN MECE_LOGISTICO.DBO.GUIAS_INF_ANTICIPADA GAN (NOLOCK) ON GAN.NUMERO_GUIA = TMPGUI.NUMERO_GUIA&#xA;WHERE TMPGUI.TIPO_CANAL='RETAIL'&#xA;&#xA;&#xA;-- Actualizacion el mayor peso  entre fisico VS volumetrico para productos 6-82 solicitud darwin 20260414  solo para RETAIL&#xA;IF OBJECT_ID('tempdb..#TMP_GUIAS_RETAIL_20260414') IS NOT NULL&#x9;&#xA;&#x9;DROP TABLE #TMP_GUIAS_RETAIL_20260414&#xA; &#xA;SELECT TMPGUI.NUMERO_GUIA &#xA;INTO #TMP_GUIAS_RETAIL_20260414&#xA;from &#xA;TMP_BORRAR_LOCAL.DBO.INFORMACION_GUIAS_RED_OPERATIVA TMPGUI &#x9;&#xA;WHERE TMPGUI.TIPO_CANAL='RETAIL' AND ID_PRODUCTO IN (82,6) -- INDUSTRIAL Y MULTIPLE PIEZAS&#xA; &#xA;CREATE NONCLUSTERED INDEX IX_NUMERO_GUIA ON #TMP_GUIAS_RETAIL_20260414 (NUMERO_GUIA)&#xA; &#xA;IF OBJECT_ID('tempdb..#PIEZAS_GUIAS_20260414') IS NOT NULL&#x9;&#xA;&#x9;&#x9;DROP TABLE #PIEZAS_GUIAS_20260414&#xA;SELECT &#xA;&#x9;g.number as NUMERO_GUIA,&#xA;&#x9;PIE.ShippingId&#xA;&#x9;,COUNT(PIE.ShippingId) AS Pieces&#xA;&#x9;,CAST(AVG(PIE.[Length])AS DECIMAL(8,2)) AS [Length]&#xA;&#x9;,CAST(AVG(PIE.[Width]) AS DECIMAL(8,2)) AS [Width]&#xA;&#x9;,CAST(AVG(PIE.Height) AS DECIMAL(8,2)) AS [Height]&#xA;&#x9;,CAST(AVG(PIE.PhysicalWeight) AS DECIMAL(8,2)) AS PhysicalWeight&#xA;&#x9;,AVG(PIE.[DeclaredValue]) AS [DeclaredValue_piece]&#xA;&#x9;,COUNT(PIE.ShippingId)*(SUM(PIE.[DeclaredValue])/COUNT(PIE.ShippingId)) AS [Full_DeclaredValue_piece]&#xA;&#x9;,CAST(COUNT(PIE.ShippingId)*(SUM(PIE.PhysicalWeight)/COUNT(PIE.ShippingId))AS DECIMAL(10,2)) AS [Full_PhysicalWeight]&#xA;&#x9;,CASE WHEN MAX(ID.ProductId)=6 THEN&#xA;&#x9;&#x9;CAST(((AVG(PIE.[Length]) * AVG(PIE.[Width]) * AVG(PIE.Height) * 400)/1000000) AS DECIMAL(10,2)) &#xA;&#x9;&#x9;ELSE CAST(((AVG(PIE.[Length]) * AVG(PIE.[Width]) * AVG(PIE.Height) * 222)/1000000) AS DECIMAL(10,2)) END as [VolumWeight]&#xA;&#x9;,CASE WHEN MAX(ID.ProductId)=6 THEN&#xA;&#x9;&#x9;CAST(((AVG(PIE.[Length]) * AVG(PIE.[Width]) * AVG(PIE.Height) * 222)/1000000)*COUNT(PIE.ShippingId)AS DECIMAL(10,2)) &#xA;&#x9;&#x9;ELSE CAST(((AVG(PIE.[Length]) * AVG(PIE.[Width]) * AVG(PIE.Height) * 222)/1000000)*COUNT(PIE.ShippingId)AS DECIMAL(10,2)) END as [Full_VolumWeight]&#xA;&#x9;INTO #PIEZAS_GUIAS_20260414&#xA;&#x9;FROM [LSTSSRET\SQL03_01].[RetailWebR4].[dbo].INVOICE AS I WITH(NOLOCK)&#xA;&#x9;INNER JOIN [LSTSSRET\SQL03_01].[RetailWebR4].[dbo].InvoiceDetail AS ID WITH(NOLOCK) ON ID.InvoiceId = I.Id&#xA;&#x9;INNER JOIN [LSTSSRET\SQL03_01].[RetailWebR4].[dbo].Guide AS G WITH(NOLOCK) ON G.InvoiceDetailId = ID.Id&#xA;&#x9;INNER JOIN [LSTSSRET\SQL03_01].[RetailWebR4].[dbo].Shipping AS S WITH(NOLOCK) ON S.GuideId = g.ID&#xA;&#x9;inner join [LSTSSRET\SQL03_01].[RetailWebR4].[dbo].[Piece] AS PIE WITH(NOLOCK) ON PIE.[ShippingId]=S.Id&#xA;&#x9;INNER JOIN #TMP_GUIAS_RETAIL_20260414 AS TGR WITH(NOLOCK) ON TGR.NUMERO_GUIA=G.number&#xA;&#x9;WHERE I.[state]=1 and ID.PaymentFormId!=2&#xA;&#x9;--WHERE --I.INVOICEDATE&gt;=@FECHA_INICIAL AND I.INVOICEDATE&lt;=@FECHA_FINAL--'20250930 23:00:00'&#xA;&#x9;--and ID.PaymentFormId!=2 and I.[state]=1 AND S.[ReceiverCountryId] = 1&#xA;&#x9;--AND PIE.ID=(SELECT MIN([Id]) FROM [RetailWebR4].[dbo].[Piece] AS PIE1 WITH(NOLOCK) WHERE PIE1.[ShippingId]=S.Id)&#xA;&#x9;--AND S.ID=175517086&#xA;&#x9;--and g.number=9180782923&#xA;&#x9;GROUP BY g.number,PIE.ShippingId &#xA;&#x9;ORDER BY g.number,PIE.ShippingId ASC&#xA; &#xA;drop table if exists #PIEZAS_GUIAS_20260414_v2&#xA; select &#xA;&#x9; NUMERO_GUIA&#xA;&#x9; ,TOTAL_PESO_FISICO = round([Full_PhysicalWeight],0)&#xA;&#x9; ,TOTAL_PESO_VOLU= round([Full_VolumWeight],0)&#xA;&#x9; into #PIEZAS_GUIAS_20260414_v2&#xA; from #PIEZAS_GUIAS_20260414&#xA;&#xA; &#xA; --select NUMERO_GUIA,count(1) from #PIEZAS_GUIAS_20260414_v2&#xA; --group by NUMERO_GUIA&#xA; --having count(1)&gt;1&#xA;&#xA;&#xA; -- select * from #PIEZAS_GUIAS_20260414_v2&#xA;&#x9;--where NUMERO_GUIA= 9188336605&#xA;&#xA;&#x9;UPDATE TMPGUI SET &#xA;&#x9;TMPGUI.PESO_FACTURADO = CASE WHEN TMP.TOTAL_PESO_FISICO&gt;=TMP.TOTAL_PESO_VOLU THEN TMP.TOTAL_PESO_FISICO ELSE TMP.TOTAL_PESO_VOLU END,&#xA;&#x9;TMPGUI.PESO_FISICO_GUIA = CASE WHEN TMP.TOTAL_PESO_FISICO&gt;=TMP.TOTAL_PESO_VOLU THEN TMP.TOTAL_PESO_FISICO ELSE TMP.TOTAL_PESO_VOLU END&#xA;&#x9;FROM TMP_BORRAR_LOCAL.DBO.INFORMACION_GUIAS_RED_OPERATIVA TMPGUI &#x9;&#xA;&#x9;INNER JOIN #PIEZAS_GUIAS_20260414_v2  TMP (NOLOCK) &#xA;&#x9;ON TMP.NUMERO_GUIA = TMPGUI.NUMERO_GUIA&#xA;&#x9;---WHERE TMPGUI.TIPO_CANAL='RETAIL'&#xA;&#xA;---Actualiza el valor de la comision de venta del envio del CDS&#xA;UPDATE TMPGUI SET &#xA;TMPGUI.VALOR_COMISION_VENTA_CDS=cast((((GAN.VALOR_SEG_MAN_GUIAS+GAN.VALOR_FLETES_GUIAS-GAN.VALOR_DESCUENTO_GUIAS) *CAST(CP.PORCENTAJE_COMISION_PRODUCTO AS INT))/100) as decimal(11,2))&#xA;FROM TMP_BORRAR_LOCAL.DBO.INFORMACION_GUIAS_RED_OPERATIVA TMPGUI  &#xA;INNER JOIN MECE_LOGISTICO.DBO.GUIAS_INF_ANTICIPADA GAN (NOLOCK) ON GAN.NUMERO_GUIA = TMPGUI.NUMERO_GUIA&#xA;INNER JOIN [Mece_Logistico].[dbo].[CANALES_PRODUCTOS] CP (NOLOCK) ON CP.ID_PAIS=TMPGUI.ID_PAIS_CANAL &#xA; AND CP.ID_CIUDAD=TMPGUI.ID_CIUDAD_CANAL AND CP.ID_DIVISION=TMPGUI.ID_CANAL AND CP.ID_PRODUCTO=TMPGUI.ID_PRODUCTO&#xA;WHERE CP.PORCENTAJE_COMISION_PRODUCTO&gt;0 AND TMPGUI.TIPO_CANAL='RETAIL'&#xA;&#xA;---Actualiza el valor de la comision recaduo efecty&#xA;UPDATE TMPGUI SET &#xA;TMPGUI.VALOR_COMISION_RECAUDO_EFECTY=GCE.VALOR_COMISION_EFECTY&#xA;FROM TMP_BORRAR_LOCAL.DBO.INFORMACION_GUIAS_RED_OPERATIVA TMPGUI  &#xA;INNER JOIN [tmp_borrar_local].[dbo].[GUIA_RECAUDO_INFORMACION_EFECTY] GCE (NOLOCK) ON GCE.NUMERO_GUIA=TMPGUI.NUMERO_GUIA&#xA;&#xA;&#xA;--DECLARE @FECHA_INI DATETIME&#xA;--DECLARE @FECHA_FIN DATETIME&#xA;--SET @FECHA_INI ='20250101 00:00:00'&#xA;--SET @FECHA_FIN ='20250201 00:00:00'&#xA;&#xA;UPDATE TMPGUI SET &#xA;TMPGUI.FECHA_ENVIO=NULL&#xA;FROM TMP_BORRAR_LOCAL.DBO.INFORMACION_GUIAS_RED_OPERATIVA TMPGUI &#xA;&#xA;--- ACTUALIZA LA FECHA DE ENVIO SOLO DEL MES EN EL QUE ESTOY DESDE ANTICIPADA&#xA;UPDATE TMPGUI SET &#xA;TMPGUI.FECHA_ENVIO=GAN.FECHA_ENVIO&#xA;FROM TMP_BORRAR_LOCAL.DBO.INFORMACION_GUIAS_RED_OPERATIVA TMPGUI  &#xA;INNER JOIN MECE_LOGISTICO.DBO.GUIAS_INF_ANTICIPADA GAN (NOLOCK) ON GAN.NUMERO_GUIA = TMPGUI.NUMERO_GUIA&#xA;WHERE GAN.FECHA_ENVIO IS NOT NULL AND TMPGUI.FECHA_ENVIO IS NULL&#xA;AND GAN.FECHA_ENVIO &gt;=@FECHA_INI AND GAN.FECHA_ENVIO&lt;@FECHA_FIN&#xA;&#xA;--- ACTUALIZA LA FECHA DE ENVIO SOLO DEL MES EN EL QUE ESTOY DESDE GUIAS&#xA;UPDATE TMPGUI SET &#xA;TMPGUI.FECHA_ENVIO=GAN.FECHA_ENVIO&#xA;FROM TMP_BORRAR_LOCAL.DBO.INFORMACION_GUIAS_RED_OPERATIVA TMPGUI  &#xA;INNER JOIN MECE_LOGISTICO.DBO.GUIAS GAN (NOLOCK) ON GAN.NUMERO_GUIA = TMPGUI.NUMERO_GUIA&#xA;WHERE GAN.FECHA_ENVIO IS NOT NULL AND TMPGUI.FECHA_ENVIO IS NULL&#xA;AND GAN.FECHA_ENVIO &gt;=@FECHA_INI AND GAN.FECHA_ENVIO&lt;@FECHA_FIN&#xA;&#xA;&#xA;&#xA;&#xA;---Actualiza CDS&#xA;UPDATE GRO SET GRO.NOMBRE_CLASE_TIPO_CANAL=ISNULL(CTCAN.NOMBRE_CLASE_TIPO_CANAL,'') &#xA;from TMP_BORRAR_LOCAL.DBO.INFORMACION_GUIAS_RED_OPERATIVA GRO (nolock)&#xA;inner join [Mece_Logistico].[dbo].[CANALES] CAN (NOLOCK) &#xA;on CAN.ID_PAIS=GRO.ID_PAIS_CANAL AND CAN.ID_CIUDAD=GRO.ID_CIUDAD_CANAL AND CAN.ID_DIVISION=GRO.ID_CANAL&#xA;inner join PARAMETROS.DBO.DIVISIONES DIV (NOLOCK)  on DIV.ID_PAIS=CAN.ID_PAIS AND DIV.ID_CIUDAD=CAN.ID_CIUDAD AND DIV.ID_DIVISION=CAN.ID_DIVISION -- AND DIV.ID_EST_DIVISION=1 &#xA;  INNER JOIN PARAMETROS.DBO.CIUDADES CC WITH (NOLOCK) ON CC.ID_PAIS=1 and CC.ID_CIUDAD=CAN.ID_CIUDAD&#xA;  INNER JOIN [Mece_Logistico].[dbo].[TIPOS_CANAL] TCAN (NOLOCK) ON TCAN.ID_TIPO_CANAL=CAN.ID_TIPO_CANAL AND TCAN.ID_EST_TIPO_CANAL=1&#xA;  INNER JOIN  PARAMETROS.[dbo].[CLASE_TIPO_CANAL] CTCAN (NOLOCK) ON CTCAN.ID_CLASE_TIPO_CANAL=TCAN.CLASE_TIPO_CANAL&#xA;  where CAN.ID_PAIS=1&#xA;--------------------------------------------------------&#xA;-- Borrar TIPO_CANAL de division&#xA;DELETE FROM TMP_BORRAR_LOCAL.DBO.INFORMACION_GUIAS_RED_OPERATIVA&#xA;WHERE TIPO_CANAL='DIVISION'&#xA;------------------------------------------------------&#xA;&#xA;PRINT 'Actualizando informacion guias ' + CONVERT(VARCHAR,GETDATE(),112) + ' ' + CONVERT(VARCHAR,GETDATE(),114)&#xA;UPDATE TMP_BORRAR_LOCAL.DBO.INFORMACION_GUIAS_RED_OPERATIVA SET&#xA;--PESO_FISICO_GUIA = GAN.PESO_FISICO_GUIA,&#xA;PESO_FISICO_GUIA = CASE WHEN GAN.PESO_FISICO_GUIA&gt;=GAN.PESO_VOLU_GUIA THEN GAN.PESO_FISICO_GUIA ELSE GAN.PESO_VOLU_GUIA END,&#xA;NUMERO_PIEZAS = GAN.NUMERO_PIEZAS&#xA;FROM TMP_BORRAR_LOCAL.DBO.INFORMACION_GUIAS_RED_OPERATIVA TMPGUI (NOLOCK)&#xA;INNER JOIN MECE_LOGISTICO.DBO.GUIAS_INF_ANTICIPADA GAN (NOLOCK) ON GAN.NUMERO_GUIA = TMPGUI.NUMERO_GUIA&#xA;WHERE ISNULL(GAN.PESO_FISICO_GUIA,0)!=0 AND TMPGUI.PESO_FISICO_GUIA =0 &#xA;&#xA;UPDATE TMP_BORRAR_LOCAL.DBO.INFORMACION_GUIAS_RED_OPERATIVA SET&#xA;PESO_VOLU_GUIA = GAN.PESO_VOLU_GUIA&#xA;FROM TMP_BORRAR_LOCAL.DBO.INFORMACION_GUIAS_RED_OPERATIVA TMPGUI (NOLOCK)&#xA;INNER JOIN MECE_LOGISTICO.DBO.GUIAS_INF_ANTICIPADA GAN (NOLOCK) ON GAN.NUMERO_GUIA = TMPGUI.NUMERO_GUIA&#xA;WHERE ISNULL(GAN.PESO_VOLU_GUIA,0)!=0&#xA;&#xA;--UPDATE TMP_BORRAR_LOCAL.DBO.INFORMACION_GUIAS_RED_OPERATIVA SET&#xA;--LARGO_ENVIO=GAN.LARGO_ENVIO,&#xA;--ALTO_ENVIO=GAN.ALTO_ENVIO,&#xA;--ANCHO_ENVIO=GAN.ANCHO_ENVIO&#xA;--FROM TMP_BORRAR_LOCAL.DBO.INFORMACION_GUIAS_RED_OPERATIVA TMPGUI (NOLOCK)&#xA;--INNER JOIN MECE_LOGISTICO.DBO.GUIAS_INF_ANTICIPADA GAN (NOLOCK) ON GAN.NUMERO_GUIA = TMPGUI.NUMERO_GUIA&#xA;--WHERE ISNULL(GAN.LARGO_ENVIO,0)!=0 AND ISNULL(GAN.ALTO_ENVIO,0)!=0 AND ISNULL(GAN.ANCHO_ENVIO,0)!=0&#xA;&#xA;UPDATE TMP_BORRAR_LOCAL.DBO.INFORMACION_GUIAS_RED_OPERATIVA SET&#xA;PESO_VOLU_GUIA= CAST(((GAN.LARGO_ENVIO*GAN.ALTO_ENVIO*GAN.ANCHO_ENVIO*222)/1000000) AS NUMERIC(8,3))&#xA;FROM TMP_BORRAR_LOCAL.DBO.INFORMACION_GUIAS_RED_OPERATIVA TMPGUI (NOLOCK)&#xA;INNER JOIN MECE_LOGISTICO.DBO.GUIAS_INF_ANTICIPADA GAN (NOLOCK) ON GAN.NUMERO_GUIA = TMPGUI.NUMERO_GUIA&#xA;WHERE ISNULL(GAN.LARGO_ENVIO,0)!=0 AND ISNULL(GAN.ALTO_ENVIO,0)!=0 AND ISNULL(GAN.ANCHO_ENVIO,0)!=0&#xA;AND TMPGUI.PESO_VOLU_GUIA=0 AND TMPGUI.ID_PRODUCTO IN(2,59)&#xA;&#xA;&#xA;--Hasta Aqui&#xA;UPDATE TMP_BORRAR_LOCAL.DBO.INFORMACION_GUIAS_RED_OPERATIVA SET&#xA;MEDIO_DE_PAGO =&#xA;CASE &#xA; WHEN ISNULL(GIA.VALOR_RECAUDAR_PRODUCTO,0) &lt;&gt; 0 THEN 'LPC'&#xA; WHEN ISNULL(GIA.ID_FORMAPAGO_OPER,0) = 4 THEN 'COD'&#xA; ELSE 'NO DISPONIBLE'&#xA;END,&#xA;VALOR_RECAUDO =&#xA;CASE &#xA; WHEN ISNULL(GIA.VALOR_RECAUDAR_PRODUCTO,0) &lt;&gt; 0 THEN GIA.VALOR_RECAUDAR_PRODUCTO&#xA; WHEN ISNULL(GIA.ID_FORMAPAGO_OPER,0) = 4 THEN TMPGUI.VALOR_ENVIO&#xA; ELSE 0&#xA;END,&#xA;ENTREGADO_REMITENTE =&#xA;CASE &#xA; WHEN TMPGUI.ID_ESTADOENVIO = 4 OR GIA.ID_DEVOLUCION_REMITENTE = 1 THEN 1  -- Entregado a remitente&#xA; ELSE 0&#xA;END,&#xA;ID_TIPOTRAY = GIA.ID_TIPOTRAY&#xA;FROM TMP_BORRAR_LOCAL.DBO.INFORMACION_GUIAS_RED_OPERATIVA TMPGUI (NOLOCK)&#xA;INNER JOIN MECE_LOGISTICO.DBO.GUIAS_INF_ADICIONAL GIA (NOLOCK) ON GIA.NUMERO_GUIA = TMPGUI.NUMERO_GUIA&#xA;&#xA;UPDATE TMP_BORRAR_LOCAL.DBO.INFORMACION_GUIAS_RED_OPERATIVA SET&#xA;NOMBRE_PRODUCTO = PRO.NOMBRE_PRODUCTO,&#xA;NOMBRE_ESTADOENVIO = ESTENV.NOMBRE_ESTADOENVIO&#xA;FROM TMP_BORRAR_LOCAL.DBO.INFORMACION_GUIAS_RED_OPERATIVA TMPGUI (NOLOCK)&#xA;INNER JOIN PARAMETROS.DBO.PRODUCTOS PRO (NOLOCK) ON PRO.ID_PAIS = 1 AND PRO.ID_PRODUCTO = TMPGUI.ID_PRODUCTO&#xA;INNER JOIN PARAMETROS.DBO.ESTADOSENVIO ESTENV (NOLOCK) ON ESTENV.ID_ESTADOENVIO = TMPGUI.ID_ESTADOENVIO&#xA;&#xA;UPDATE TMP_BORRAR_LOCAL.DBO.INFORMACION_GUIAS_RED_OPERATIVA SET&#xA;ID_TIPOTRAY = MAT.ID_TIPOTRAY&#xA;FROM TMP_BORRAR_LOCAL.DBO.INFORMACION_GUIAS_RED_OPERATIVA TMPGUI (NOLOCK)&#xA;INNER JOIN MECE_LOGISTICO.DBO.GUIAS GUI (NOLOCK) ON GUI.NUMERO_GUIA = TMPGUI.NUMERO_GUIA&#xA;INNER JOIN PARAMETROS.DBO.MATRIZ_CIUDADES MAT (NOLOCK) ON MAT.ID_GRUPMATRIZ = 1 AND MAT.ID_PAIS_ORIG = GUI.ID_PAIS_ORIGEN AND MAT.ID_PAIS_DEST = ISNULL(GUI.ID_PAIS_DESTINO,GUI.ID_PAIS_ORIGEN) AND MAT.ID_CIUDAD_ORIG = GUI.ID_CIUDAD_ORIGEN AND MAT.ID_CIUDAD_DEST = ISNULL(GUI.ID_CIUDAD_DESTINO,GUI.ID_CIUDAD_ORIGEN) AND MAT.ID_ESTADO_TRAY = 1&#xA;WHERE ISNULL(TMPGUI.ID_TIPOTRAY,0) = 0 &#xA;&#xA;&#xA;UPDATE TMP_BORRAR_LOCAL.DBO.INFORMACION_GUIAS_RED_OPERATIVA SET&#xA;NOMBRE_TIPOTRAY = TIP.NOMBRE_TIPOTRAY&#xA;FROM TMP_BORRAR_LOCAL.DBO.INFORMACION_GUIAS_RED_OPERATIVA TMPGUI (NOLOCK)&#xA;INNER JOIN PARAMETROS.DBO.TIPOTRAYECTO TIP (NOLOCK) ON TIP.ID_PAIS = 1 AND TIP.ID_TIPOTRAY = TMPGUI.ID_TIPOTRAY&#xA;&#xA;UPDATE TMP_BORRAR_LOCAL.DBO.INFORMACION_GUIAS_RED_OPERATIVA SET&#xA;NOMBRE_CLIENTE = ISNULL(CLI.NOMBRE_CLIENTE,'') + ' ' + ISNULL(CLI.APELLIDO_CLIENTE,'')&#xA;FROM TMP_BORRAR_LOCAL.DBO.INFORMACION_GUIAS_RED_OPERATIVA TMPGUI (NOLOCK)&#xA;INNER JOIN PARAMETROS.DBO.CLIENTES CLI (NOLOCK) ON CLI.ID_PAIS = 1 AND CLI.ID_CLIENTE = TMPGUI.ID_CLIENTE&#xA;&#xA;UPDATE TMP_BORRAR_LOCAL.DBO.INFORMACION_GUIAS_RED_OPERATIVA SET&#xA;NOMBRE_CLIENTE = DIV.NOMBRE_DIVISION&#xA;FROM TMP_BORRAR_LOCAL.DBO.INFORMACION_GUIAS_RED_OPERATIVA TMPGUI (NOLOCK)&#xA;INNER JOIN PARAMETROS.DBO.DIVISIONES DIV (NOLOCK) ON DIV.ID_PAIS = TMPGUI.ID_PAIS_CANAL AND DIV.ID_CIUDAD = TMPGUI.ID_CIUDAD_CANAL AND DIV.ID_DIVISION = TMPGUI.ID_CANAL&#xA;&#xA;UPDATE TMP_BORRAR_LOCAL.DBO.INFORMACION_GUIAS_RED_OPERATIVA SET&#xA;DANE_ORIGEN_DESTINO = ISNULL(RTRIM(CIUORI.CODIGO_DANE),'') + ' - ' + ISNULL(RTRIM(CIUDES.CODIGO_DANE),ISNULL(RTRIM(CIUORI.CODIGO_DANE),''))&#xA;,NOMBRE_ORIGEN_DESTINO = ISNULL(RTRIM(CIUORI.NOMBRE_CIUDAD),'') + ' - ' + ISNULL(RTRIM(CIUDES.NOMBRE_CIUDAD),ISNULL(RTRIM(CIUORI.NOMBRE_CIUDAD),''))&#xA;FROM TMP_BORRAR_LOCAL.DBO.INFORMACION_GUIAS_RED_OPERATIVA TMPGUI (NOLOCK)&#xA;INNER JOIN PARAMETROS.DBO.CIUDADES CIUORI (NOLOCK) ON CIUORI.ID_PAIS = 1 AND CIUORI.ID_CIUDAD = TMPGUI.ID_CIUDAD_ORIGEN&#xA;LEFT JOIN PARAMETROS.DBO.CIUDADES CIUDES (NOLOCK) ON CIUDES.ID_PAIS = 1 AND CIUDES.ID_CIUDAD = TMPGUI.ID_CIUDAD_DESTINO&#xA;-----XXXXXXXX&#xA;--Hasta aqui demorado&#xA;PRINT 'Seleccionando vehiculo y fecha ' + CONVERT(VARCHAR,GETDATE(),112) + ' ' + CONVERT(VARCHAR,GETDATE(),114)&#xA;-- Selecciona los vehículos y fecha de proceso&#xA;INSERT INTO TMP_BORRAR_LOCAL.DBO.VEHICULOS_DOCUMENTOS_RED_OPERATIVA (&#xA;PLACA_VEHICULO_DOCU,&#xA;FECHA_HORA_MOVIMI)&#xA;SELECT DISTINCT&#xA;DOC.PLACA_VEHICULO_DOCU,&#xA;CONVERT(VARCHAR,DOC.FECHA_HORA_MOVIMI,112)&#xA;FROM TMP_BORRAR_LOCAL.DBO.GUIAS_RED_OPERATIVA TMPGUI (NOLOCK)&#xA;INNER JOIN MECE_LOGISTICO.DBO.SEGUIMIENTO_ENVIO SEG (NOLOCK) ON SEG.NUMERO_GUIA = TMPGUI.NUMERO_GUIA&#xA;INNER JOIN TMP_BORRAR_LOCAL.DBO.DOCUMENTOS_MECE_LOGISTICO_RED_OPERATIVA DOC (NOLOCK) ON DOC.ID_PROCESO = SEG.ID_PROCESO AND DOC.NUMERO_MOVIMI = SEG.NUMERO_MOVIMI AND DOC.CONSECUT_MOVIMI = SEG.CONSECUT_MOVIMI&#xA;--Hasta aqui&#xA;&#xA;PRINT 'Borrando vehiculos en blanco ' + CONVERT(VARCHAR,GETDATE(),112) + ' ' + CONVERT(VARCHAR,GETDATE(),114)&#xA;DELETE FROM TMP_BORRAR_LOCAL.DBO.VEHICULOS_DOCUMENTOS_RED_OPERATIVA WHERE ISNULL(PLACA_VEHICULO_DOCU,'') = '' --AND FECHA_HORA_MOVIMI = FECHA_HORA_MOVIMI&#xA;&#xA;--xxxxxxxxxxxxxxxxxxxxxxxxx" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="0"
                SQLTask:DtsVariableName="User::STR01_FECHA_INICIAL"
                SQLTask:ParameterDirection="Input"
                SQLTask:DataType="129"
                SQLTask:ParameterSize="20" />
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="1"
                SQLTask:DtsVariableName="User::STR02_FECHA_FINAL"
                SQLTask:ParameterDirection="Input"
                SQLTask:DataType="129"
                SQLTask:ParameterSize="20" />
            </SQLTask:SqlTaskData>
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\PASO 2   script 2 EJECUTAR POR MES\2 Consulta guias credito y retail para costos PARTE 2"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{6dfff4f3-c2a0-4361-98c8-552a24b76912}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="2 Consulta guias credito y retail para costos PARTE 2"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{A3A65FF9-9058-4FB8-AA1A-7AABA464327A}"
              SQLTask:SqlStatementSource="&#xA;PRINT 'Seleccionando vehiculos totales ' + CONVERT(VARCHAR,GETDATE(),112) + ' ' + CONVERT(VARCHAR,GETDATE(),114)&#xA;INSERT INTO TMP_BORRAR_LOCAL.DBO.VEHICULOS_TOTALES_RED_OPERATIVA (&#xA;PLACA_VEHICULO_DOCU,&#xA;FECHA_HORA_MOVIMI,&#xA;ID_PROCESO,&#xA;TOTAL_ENVIOS,&#xA;TOTAL_PIEZAS,&#xA;PESO_TOTAL,&#xA;PESO_VOLU_TOTAL)&#xA;SELECT &#xA;TMPVEH.PLACA_VEHICULO_DOCU,&#xA;TMPVEH.FECHA_HORA_MOVIMI,&#xA;DOC.ID_PROCESO,&#xA;SUM(DOC.TOTAL_ENVIOS) AS TOTAL_ENVIOS,&#xA;SUM(DOC.TOTAL_PIEZAS) AS TOTAL_PIEZAS,&#xA;SUM(DOC.PESO_TOTAL) AS PESO_TOTAL,&#xA;SUM(DOC.PESO_VOLU_TOTAL) AS PESO_VOLU_TOTAL&#xA;FROM TMP_BORRAR_LOCAL.DBO.VEHICULOS_DOCUMENTOS_RED_OPERATIVA TMPVEH (NOLOCK)&#xA;INNER JOIN TMP_BORRAR_LOCAL.DBO.DOCUMENTOS_MECE_LOGISTICO_RED_OPERATIVA DOC (NOLOCK) ON DOC.PLACA_VEHICULO_DOCU = TMPVEH.PLACA_VEHICULO_DOCU AND DOC.FECHA_HORA_MOVIMI &gt;= TMPVEH.FECHA_HORA_MOVIMI AND DOC.FECHA_HORA_MOVIMI &lt;= TMPVEH.FECHA_HORA_MOVIMI + 1&#xA;GROUP BY TMPVEH.PLACA_VEHICULO_DOCU, TMPVEH.FECHA_HORA_MOVIMI, DOC.ID_PROCESO&#xA;OPTION(FAST 1)&#xA;--xxxxxxxxxxxxxxxxxxxxxxxxxxxxx&#xA;&#xA;&#xA;PRINT 'Seleccionando documentos guias ' + CONVERT(VARCHAR,GETDATE(),112) + ' ' + CONVERT(VARCHAR,GETDATE(),114)&#xA;INSERT INTO TMP_BORRAR_LOCAL.DBO.DOCUMENTOS_GUIAS_RED_OPERATIVA (&#xA;ID_PROCESO,&#xA;NUMERO_MOVIMI,&#xA;CONSECUT_MOVIMI,&#xA;DOC.PLACA_VEHICULO_DOCU,&#xA;FECHA_HORA_MOVIMI)&#xA;SELECT &#xA;DOC.ID_PROCESO,&#xA;DOC.NUMERO_MOVIMI,&#xA;DOC.CONSECUT_MOVIMI,&#xA;DOC.PLACA_VEHICULO_DOCU,&#xA;DOC.FECHA_HORA_MOVIMI&#xA;FROM TMP_BORRAR_LOCAL.DBO.VEHICULOS_DOCUMENTOS_RED_OPERATIVA TMPVEH (NOLOCK)&#xA;INNER JOIN TMP_BORRAR_LOCAL.DBO.DOCUMENTOS_MECE_LOGISTICO_RED_OPERATIVA DOC (NOLOCK) ON DOC.PLACA_VEHICULO_DOCU = TMPVEH.PLACA_VEHICULO_DOCU AND DOC.FECHA_HORA_MOVIMI &gt;= TMPVEH.FECHA_HORA_MOVIMI AND DOC.FECHA_HORA_MOVIMI &lt;= TMPVEH.FECHA_HORA_MOVIMI + 1&#xA;OPTION(FAST 1)&#xA;&#xA;&#xA;PRINT 'Borrando documentos guias de procesos ' + CONVERT(VARCHAR,GETDATE(),112) + ' ' + CONVERT(VARCHAR,GETDATE(),114)&#xA;--DELETE FROM TMP_BORRAR_LOCAL.DBO.DOCUMENTOS_GUIAS_RED_OPERATIVA WHERE ID_PROCESO NOT IN (5,6,7,8,9,10,11,12,14,15,16,19,24,25,27,30,31,32)&#xA;DELETE FROM TMP_BORRAR_LOCAL.DBO.DOCUMENTOS_GUIAS_RED_OPERATIVA WHERE ID_PROCESO NOT IN (2,5,6,9,10,12,14,24)&#xA;&#xA;PRINT 'Seleccionando documentos ' + CONVERT(VARCHAR,GETDATE(),112) + ' ' + CONVERT(VARCHAR,GETDATE(),114)&#xA;-- Selecciona todos los manifiestos de las guías&#xA;&#xA;INSERT INTO TMP_BORRAR_LOCAL.DBO.DOCUMENTOS_RED_OPERATIVA (&#xA;ID_PROCESO,&#xA;NUMERO_MOVIMI,&#xA;CONSECUT_MOVIMI,&#xA;PLACA_VEHICULO_DOCU,&#xA;FECHA_HORA_MOVIMI,&#xA;PESO_TOTAL,&#xA;PESO_VOLU_TOTAL,&#xA;TOTAL_ENVIOS,&#xA;TOTAL_PIEZAS,&#xA;ID_PAIS_ZONA_URBA,&#xA;ID_CIUDAD_ZONA_URBA,&#xA;ID_TIPO_ZONA_URBA,&#xA;ID_ZONA_URBA,&#xA;ID_PAIS_DIVISION_ORIGEN,&#xA;ID_CIUDAD_DIVISION_ORIGEN,&#xA;ID_PAIS_DESTINO,&#xA;ID_CIUDAD_DESTINO,&#xA;ID_AUXILIAR1_VEHICULO,&#xA;ID_AUXILIAR2_VEHICULO,&#xA;ID_COURIER_CONDUCTOR,&#xA;NOMBRE_ZONA_URBA)&#xA;SELECT DISTINCT&#xA;DOC.ID_PROCESO,&#xA;DOC.NUMERO_MOVIMI,&#xA;DOC.CONSECUT_MOVIMI,&#xA;DOC.PLACA_VEHICULO_DOCU,&#xA;DOC.FECHA_HORA_MOVIMI,&#xA;DOC.PESO_TOTAL,&#xA;DOC.PESO_VOLU_TOTAL,&#xA;/*&#xA;convert(numeric(5,0),&#xA;   CASE WHEN len(convert(int,DOC.PESO_TOTAL))&gt;4 THEN 0 ELSE DOC.PESO_TOTAL END&#xA;   ) as PESO_TOTAL,&#xA;convert(numeric(5,0),&#xA;   CASE WHEN len(convert(int,DOC.PESO_VOLU_TOTAL))&gt;4 THEN 0 ELSE DOC.PESO_VOLU_TOTAL END&#xA;   ) as PESO_VOLU_TOTAL,&#xA;*/&#xA;DOC.TOTAL_ENVIOS,&#xA;DOC.TOTAL_PIEZAS,&#xA;DOC.ID_PAIS_ZONA_URBA,&#xA;DOC.ID_CIUDAD_ZONA_URBA,&#xA;DOC.ID_TIPO_ZONA_URBA,&#xA;DOC.ID_ZONA_URBA,&#xA;DOC.ID_PAIS_DIVISION_ORIGEN,&#xA;DOC.ID_CIUDAD_DIVISION_ORIGEN,&#xA;DOC.ID_PAIS_DESTINO,&#xA;DOC.ID_CIUDAD_DESTINO,&#xA;DOC.ID_AUXILIAR1_VEHICULO,&#xA;DOC.ID_AUXILIAR2_VEHICULO,&#xA;DOC.ID_COURIER_CONDUCTOR,&#xA;DOC.NOMBRE_ZONA_URBA&#xA;FROM TMP_BORRAR_LOCAL.DBO.DOCUMENTOS_GUIAS_RED_OPERATIVA TMPDGU (NOLOCK)&#xA;INNER JOIN TMP_BORRAR_LOCAL.DBO.DOCUMENTOS_MECE_LOGISTICO_RED_OPERATIVA DOC (NOLOCK) ON DOC.ID_PROCESO = TMPDGU.ID_PROCESO AND DOC.NUMERO_MOVIMI = TMPDGU.NUMERO_MOVIMI AND DOC.CONSECUT_MOVIMI = TMPDGU.CONSECUT_MOVIMI&#xA;--where len(DOC.PESO_VOLU_TOTAL)&gt;5&#xA;OPTION(FAST 1)&#xA;&#xA;&#xA;PRINT 'Seleccionando información documentos ' + CONVERT(VARCHAR,GETDATE(),112) + ' ' + CONVERT(VARCHAR,GETDATE(),114)&#xA;-- Selecciona las información de los manifiestos de las guías&#xA;INSERT INTO TMP_BORRAR_LOCAL.DBO.INFORMACION_DOCUMENTOS_RED_OPERATIVA (&#xA;NUMERO_GUIA,&#xA;ID_PROCESO,&#xA;PLACA_VEHICULO_DOCU,&#xA;FECHA_HORA_MOVIMIENTO,&#xA;FECHA_HORA_MOVIMIENTO_INICIAL,&#xA;FECHA_HORA_MOVIMIENTO_FINAL,&#xA;ID_CIUDAD,&#xA;LLAVE_ORIGEN_DESTINO,&#xA;PROCESO_ENTRADA_SALIDA,&#xA;CODIGO_ACTUAL_CDS,&#xA;TOTAL_AUXILIARES)&#xA;SELECT DISTINCT &#xA;TMPGUI.NUMERO_GUIA,&#xA;DOC.ID_PROCESO,&#xA;DOC.PLACA_VEHICULO_DOCU,&#xA;DOC.FECHA_HORA_MOVIMI,--SEG.FECHA_HORA_MOVIMIENTO,&#xA;CONVERT(VARCHAR,DOC.FECHA_HORA_MOVIMI,112),--CONVERT(VARCHAR,SEG.FECHA_HORA_MOVIMIENTO,112),&#xA;CONVERT(VARCHAR,DOC.FECHA_HORA_MOVIMI,112) + ' 23:59:59',--CONVERT(VARCHAR,SEG.FECHA_HORA_MOVIMIENTO,112) + ' 23:59:59',&#xA;CASE&#xA; WHEN ISNULL(DOC.ID_CIUDAD_DIVISION_ORIGEN,0) = 0 AND ISNULL(DOC.ID_CIUDAD_DESTINO,0) &lt;&gt; 0 THEN DOC.ID_CIUDAD_DESTINO&#xA; WHEN ISNULL(DOC.ID_CIUDAD_DESTINO,0) = 0 AND ISNULL(DOC.ID_CIUDAD_DIVISION_ORIGEN,0) &lt;&gt; 0 THEN DOC.ID_CIUDAD_DIVISION_ORIGEN&#xA; WHEN DOC.ID_CIUDAD_DIVISION_ORIGEN = DOC.ID_CIUDAD_DESTINO THEN DOC.ID_CIUDAD_DIVISION_ORIGEN&#xA; WHEN DOC.ID_CIUDAD_DIVISION_ORIGEN &lt;&gt; DOC.ID_CIUDAD_DESTINO AND DOC.ID_PROCESO = 12 THEN DOC.ID_CIUDAD_DIVISION_ORIGEN&#xA; WHEN DOC.ID_CIUDAD_DIVISION_ORIGEN &lt;&gt; DOC.ID_CIUDAD_DESTINO AND DOC.ID_PROCESO = 14 THEN DOC.ID_CIUDAD_DESTINO&#xA; ELSE SUBSTRING(DOC.NUMERO_MOVIMI,4,4)&#xA;END AS ID_CIUDAD,&#xA;CASE WHEN SEG.ID_PROCESO = 12  -- Salida a regional&#xA;  THEN RTRIM(ISNULL(CIUORI.CODIGO_DANE,'')) + ' - ' + RTRIM(ISNULL(CIUDES.CODIGO_DANE,''))&#xA; WHEN SEG.ID_PROCESO IN(5, 6)  -- CIUDAD EZ&#xA;  THEN RTRIM(ISNULL(CIUORI_EZ.CODIGO_DANE,'')) + ' - ' + RTRIM(ISNULL(CIUDES.CODIGO_DANE,''))&#xA; WHEN SEG.ID_PROCESO = 9 AND DOC.ID_CIUDAD_DESTINO != 0 -- CIUDAD SZ&#xA;  THEN RTRIM(ISNULL(CIUORI_EZ.CODIGO_DANE,'')) + ' - ' + RTRIM(ISNULL(CIUDES.CODIGO_DANE,''))&#xA; WHEN SEG.ID_PROCESO = 9 AND  DOC.ID_CIUDAD_DESTINO = 0 -- CIUDAD SZ&#xA;  THEN RTRIM(ISNULL(CIUORI_EZ.CODIGO_DANE,'')) + ' - ' + RTRIM(ISNULL(CIUORI_EZ.CODIGO_DANE,''))&#xA; WHEN SEG.ID_PROCESO = 24 AND  DOC.ID_CIUDAD_DESTINO != 0 -- CIUDAD SZ&#xA;  THEN RTRIM(ISNULL(CIUORI_EZ.CODIGO_DANE,'')) + ' - ' + RTRIM(ISNULL(CIUDES.CODIGO_DANE,''))&#xA; ELSE ''&#xA;END AS LLAVE_ORIGEN_DESTINO,&#xA;PRO.ID_TIPO_PROCESO,&#xA;CASE &#xA; WHEN DOC.ID_PROCESO IN (31,32) OR (DOC.ID_PROCESO = 24 AND TMPGUI.ENTREGADO_REMITENTE = 0) THEN DIV.CODIGO_ACTUAL&#xA; ELSE ''&#xA;END AS CODIGO_ACTUAL_CDS,&#xA;CASE &#xA; WHEN ISNULL(DOC.ID_AUXILIAR1_VEHICULO,'') &lt;&gt; '' AND ISNULL(DOC.ID_AUXILIAR2_VEHICULO,'') &lt;&gt; '' THEN 2&#xA; WHEN ISNULL(DOC.ID_AUXILIAR1_VEHICULO,'') &lt;&gt; '' THEN 1&#xA; ELSE 0&#xA;END AS TOTAL_AUXILIARES&#xA;FROM TMP_BORRAR_LOCAL.DBO.INFORMACION_GUIAS_RED_OPERATIVA TMPGUI (NOLOCK)&#xA;INNER JOIN MECE_LOGISTICO.DBO.SEGUIMIENTO_ENVIO SEG (NOLOCK) ON SEG.NUMERO_GUIA = TMPGUI.NUMERO_GUIA&#xA;INNER JOIN TMP_BORRAR_LOCAL.DBO.DOCUMENTOS_RED_OPERATIVA DOC (NOLOCK) ON DOC.ID_PROCESO = SEG.ID_PROCESO AND DOC.NUMERO_MOVIMI = SEG.NUMERO_MOVIMI AND DOC.CONSECUT_MOVIMI = SEG.CONSECUT_MOVIMI&#xA;INNER JOIN PARAMETROS.DBO.PROCESOS PRO (NOLOCK) ON PRO.ID_PROCESO = SEG.ID_PROCESO&#xA;LEFT JOIN PARAMETROS.DBO.ZONASURBANAS ZON (NOLOCK) ON ZON.ID_PAIS = DOC.ID_PAIS_ZONA_URBA AND ZON.ID_CIUDAD = DOC.ID_CIUDAD_ZONA_URBA AND ZON.ID_TIPO_ZONA_URBA = DOC.ID_TIPO_ZONA_URBA AND ZON.ID_ZONA_URBA = DOC.ID_ZONA_URBA&#xA;LEFT JOIN PARAMETROS.DBO.DIVISIONES DIV (NOLOCK) ON DIV.ID_PAIS = ZON.ID_PAIS_CANAL AND DIV.ID_CIUDAD = ZON.ID_CIUDAD_CANAL AND DIV.ID_DIVISION = ZON.ID_CANAL&#xA;LEFT JOIN PARAMETROS.DBO.CIUDADES CIUORI (NOLOCK) ON CIUORI.ID_PAIS = DOC.ID_PAIS_DIVISION_ORIGEN AND CIUORI.ID_CIUDAD = DOC.ID_CIUDAD_DIVISION_ORIGEN&#xA;LEFT JOIN PARAMETROS.DBO.CIUDADES CIUDES (NOLOCK) ON CIUDES.ID_PAIS = DOC.ID_PAIS_DESTINO AND CIUDES.ID_CIUDAD = DOC.ID_CIUDAD_DESTINO&#xA;LEFT JOIN PARAMETROS.DBO.CIUDADES CIUORI_EZ (NOLOCK) ON CIUORI_EZ.ID_PAIS = DOC.ID_PAIS_ZONA_URBA AND CIUORI_EZ.ID_CIUDAD = DOC.ID_CIUDAD_ZONA_URBA&#xA;OPTION(FAST 1)&#xA;&#xA;--Hasta Aqui&#xA;-- Selecciona los movimientos de cross por guía&#xA;PRINT 'Seleccionando movimientos cross ' + CONVERT(VARCHAR,GETDATE(),112) + ' ' + CONVERT(VARCHAR,GETDATE(),114)&#xA;INSERT INTO TMP_BORRAR_LOCAL.DBO.MOVIMIENTOS_CROSS_RED_OPERATIVA (&#xA;NUMERO_GUIA,&#xA;MOVIMIENTOS_CROSS)&#xA;SELECT NUMERO_GUIA,&#xA;COUNT(1)&#xA;FROM TMP_BORRAR_LOCAL.DBO.INFORMACION_DOCUMENTOS_RED_OPERATIVA (NOLOCK)&#xA;WHERE ID_PROCESO IN (5,6,12,14,9)  -- Entrada de CDS, entrada de zona, entrada de regional&#xA;GROUP BY NUMERO_GUIA&#xA;OPTION(FAST 1)&#xA;&#xA;PRINT 'Seleccionando informacion documentos totalizados ' + CONVERT(VARCHAR,GETDATE(),112) + ' ' + CONVERT(VARCHAR,GETDATE(),114)&#xA;-- Selecciona el total de guías por manifiesto&#xA;INSERT INTO TMP_BORRAR_LOCAL.DBO.INFORMACION_DOCUMENTOS_TOTALIZADOS_RED_OPERATIVA (&#xA;NUMERO_GUIA,&#xA;ID_PROCESO,&#xA;PLACA_VEHICULO_DOCU,&#xA;ID_CIUDAD,&#xA;FECHA_HORA_MOVIMIENTO,&#xA;TOTAL_GUIAS_RECOLECCION,&#xA;TOTAL_PIEZAS_RECOLECCION,&#xA;TOTAL_GUIAS_DISTRIBUCION,&#xA;TOTAL_PIEZAS_DISTRIBUCION,&#xA;PESO_FISICO_OPERA_RECOLECCION,&#xA;PESO_VOLU_OPERA_RECOLECCION,&#xA;PESO_FISICO_OPERA_DISTRIBUCION,&#xA;PESO_VOLU_OPERA_DISTRIBUCION,&#xA;PESO_FISICO_OPERA_DEVOLUCION,&#xA;PESO_VOLU_OPERA_DEVOLUCION)&#xA;SELECT DISTINCT&#xA;TMPDOC.NUMERO_GUIA,&#xA;TMPDOC.ID_PROCESO,&#xA;TMPDOC.PLACA_VEHICULO_DOCU,&#xA;TMPDOC.ID_CIUDAD,&#xA;TMPDOC.FECHA_HORA_MOVIMIENTO,&#xA;--SUM(&#xA; CASE WHEN TMPDOC.PROCESO_ENTRADA_SALIDA = 1 AND TMPDOC.ID_PROCESO!=24 -- Proceso de entrada&#xA;  THEN TMPVEH.TOTAL_ENVIOS--DOC.TOTAL_ENVIOS&#xA;  ELSE 0&#xA; END,--) AS TOTAL_GUIAS_RECOLECCION,&#xA; CASE WHEN TMPDOC.PROCESO_ENTRADA_SALIDA = 1 AND TMPDOC.ID_PROCESO!=24 -- Proceso de entrada&#xA;  THEN TMPVEH.TOTAL_PIEZAS--DOC.TOTAL_PIEZAS&#xA;  ELSE 0&#xA; END,--) AS TOTAL_PIEZAS_RECOLECCION,&#xA;--SUM(&#xA; CASE WHEN TMPDOC.PROCESO_ENTRADA_SALIDA = 1 AND TMPDOC.ID_PROCESO=24 -- Proceso de Entrega&#xA;     THEN TMPVEH.TOTAL_ENVIOS--DOC.TOTAL_ENVIOS&#xA;      WHEN TMPDOC.PROCESO_ENTRADA_SALIDA = 2  -- Proceso de salida&#xA;   THEN TMPVEH.TOTAL_ENVIOS--DOC.TOTAL_ENVIOS&#xA;   ELSE 0&#xA; END,--) AS TOTAL_GUIAS_DISTRIBUCION,&#xA; CASE WHEN TMPDOC.PROCESO_ENTRADA_SALIDA = 1 AND TMPDOC.ID_PROCESO=24 -- Proceso de Entrega&#xA;     THEN TMPVEH.TOTAL_PIEZAS--DOC.TOTAL_PIEZAS&#xA;      WHEN TMPDOC.PROCESO_ENTRADA_SALIDA = 2  -- Proceso de salida&#xA;   THEN TMPVEH.TOTAL_PIEZAS--DOC.TOTAL_PIEZASS&#xA;   ELSE 0&#xA; END,--) AS TOTAL_PIEZAS_DISTRIBUCION,&#xA;--SUM(&#xA; CASE WHEN TMPDOC.PROCESO_ENTRADA_SALIDA = 1 AND TMPDOC.ID_PROCESO!=24 -- Proceso de entrada&#xA;   THEN TMPVEH.PESO_TOTAL--DOC.PESO_TOTAL&#xA;   ELSE 0&#xA; END,--) AS PESO_FISICO_OPERA_RECOLECCION,&#xA; CASE WHEN TMPDOC.PROCESO_ENTRADA_SALIDA = 1 AND TMPDOC.ID_PROCESO!=24 -- Proceso de entrada&#xA;   THEN TMPVEH.PESO_VOLU_TOTAL--DOC.PESO_VOLU_TOTAL&#xA;   ELSE 0&#xA; END,--) AS PESO_VOLU_OPERA_RECOLECCION,&#xA;--SUM(&#xA; CASE WHEN TMPDOC.PROCESO_ENTRADA_SALIDA = 1 AND TMPDOC.ID_PROCESO=24 -- Proceso de Entrega&#xA;   THEN TMPVEH.PESO_TOTAL--DOC.PESO_TOTAL&#xA;   WHEN TMPDOC.PROCESO_ENTRADA_SALIDA = 2  -- Proceso de salida&#xA;   THEN TMPVEH.PESO_TOTAL--DOC.PESO_TOTAL&#xA;  ELSE 0&#xA; END,--) AS PESO_FISICO_OPERA_DISTRIBUCION&#xA; CASE WHEN TMPDOC.PROCESO_ENTRADA_SALIDA = 1 AND TMPDOC.ID_PROCESO=24 -- Proceso de Entrega&#xA;   THEN TMPVEH.PESO_VOLU_TOTAL--DOC.PESO_TOTAL&#xA;   WHEN TMPDOC.PROCESO_ENTRADA_SALIDA = 2  -- Proceso de salida&#xA;   THEN TMPVEH.PESO_VOLU_TOTAL--DOC.PESO_TOTAL&#xA;  ELSE 0&#xA; END,--) AS PESO_VOLU_OPERA_DISTRIBUCION&#xA;0 AS PESO_FISICO_OPERA_DEVOLUCION,&#xA;0 AS PESO_VOLU_OPERA_DEVOLUCION&#xA;FROM TMP_BORRAR_LOCAL.DBO.INFORMACION_DOCUMENTOS_RED_OPERATIVA TMPDOC (NOLOCK)&#xA;--INNER JOIN TMP_BORRAR_LOCAL.DBO.DOCUMENTOS_RED_OPERATIVA DOC (NOLOCK) ON DOC.ID_PROCESO = TMPDOC.ID_PROCESO AND DOC.PLACA_VEHICULO_DOCU = TMPDOC.PLACA_VEHICULO_DOCU AND DOC.FECHA_HORA_MOVIMI BETWEEN TMPDOC.FECHA_HORA_MOVIMIENTO_INICIAL AND TMPDOC.FECHA_HORA_MOVIMIENTO_FINAL&#xA;INNER JOIN TMP_BORRAR_LOCAL.DBO.VEHICULOS_TOTALES_RED_OPERATIVA TMPVEH (NOLOCK) ON TMPVEH.PLACA_VEHICULO_DOCU = TMPDOC.PLACA_VEHICULO_DOCU AND TMPVEH.FECHA_HORA_MOVIMI = TMPDOC.FECHA_HORA_MOVIMIENTO_INICIAL AND TMPVEH.ID_PROCESO = TMPDOC.ID_PROCESO&#xA;--GROUP BY TMPDOC.NUMERO_GUIA, TMPDOC.ID_PROCESO, TMPDOC.PLACA_VEHICULO_DOCU, TMPDOC.ID_CIUDAD, TMPDOC.FECHA_HORA_MOVIMIENTO&#xA;ORDER BY TMPDOC.FECHA_HORA_MOVIMIENTO&#xA;OPTION(FAST 1)&#xA;&#xA;&#xA;PRINT 'Seleccionando procesos adicionales ' + CONVERT(VARCHAR,GETDATE(),112) + ' ' + CONVERT(VARCHAR,GETDATE(),114)&#xA;----------- PROCESOS ADICIONALES&#xA;-- Proceso adicional salida a zona a partir de la entrada de zona&#xA;INSERT INTO TMP_BORRAR_LOCAL.DBO.PROCESOS_ADICIONALES_RED_OPERATIVA (&#xA;NUMERO_GUIA,&#xA;ID_PROCESO,&#xA;ID_PROCESO_ADICIONAL,&#xA;PLACA_VEHICULO_DOCU,&#xA;FECHA_HORA_MOVIMIENTO,&#xA;TOTAL_GUIAS,&#xA;TOTAL_PIEZAS,&#xA;PESO_FISICO_OPERA,&#xA;PESO_VOLU_OPERA)&#xA;SELECT DISTINCT&#xA;TMPDOC.NUMERO_GUIA,&#xA;TMPDOC.ID_PROCESO,&#xA;9,  -- salida a zona&#xA;TMPDOC.PLACA_VEHICULO_DOCU,&#xA;TMPDOC.FECHA_HORA_MOVIMIENTO,&#xA;SUM(DOC.TOTAL_ENVIOS),&#xA;SUM(DOC.TOTAL_PIEZAS),&#xA;SUM(DOC.PESO_TOTAL),&#xA;SUM(DOC.PESO_VOLU_TOTAL)&#xA;FROM TMP_BORRAR_LOCAL.DBO.INFORMACION_DOCUMENTOS_RED_OPERATIVA TMPDOC (NOLOCK)&#xA;INNER JOIN TMP_BORRAR_LOCAL.DBO.DOCUMENTOS_RED_OPERATIVA DOC (NOLOCK) ON DOC.ID_PROCESO = 9 AND DOC.PLACA_VEHICULO_DOCU = TMPDOC.PLACA_VEHICULO_DOCU AND DOC.FECHA_HORA_MOVIMI BETWEEN TMPDOC.FECHA_HORA_MOVIMIENTO_INICIAL AND TMPDOC.FECHA_HORA_MOVIMIENTO_FINAL&#xA;WHERE TMPDOC.ID_PROCESO = 6  -- Entrada de zona urbana&#xA;GROUP BY TMPDOC.NUMERO_GUIA, TMPDOC.ID_PROCESO, TMPDOC.PLACA_VEHICULO_DOCU, TMPDOC.FECHA_HORA_MOVIMIENTO&#xA;OPTION(FAST 1)&#xA;  &#xA;  &#xA;-- Proceso adicional devolucion de zona a partir de la salida a zona&#xA;INSERT INTO TMP_BORRAR_LOCAL.DBO.PROCESOS_ADICIONALES_RED_OPERATIVA (&#xA;NUMERO_GUIA,&#xA;ID_PROCESO,&#xA;ID_PROCESO_ADICIONAL,&#xA;PLACA_VEHICULO_DOCU,&#xA;FECHA_HORA_MOVIMIENTO,&#xA;TOTAL_GUIAS,&#xA;TOTAL_PIEZAS,&#xA;PESO_FISICO_OPERA,&#xA;PESO_VOLU_OPERA)&#xA;SELECT &#xA;TMPDOC.NUMERO_GUIA,&#xA;TMPDOC.ID_PROCESO,&#xA;10,  -- devolución de zona&#xA;TMPDOC.PLACA_VEHICULO_DOCU,&#xA;TMPDOC.FECHA_HORA_MOVIMIENTO,&#xA;SUM(DOC.TOTAL_ENVIOS),&#xA;SUM(DOC.TOTAL_PIEZAS),&#xA;SUM(DOC.PESO_TOTAL),&#xA;SUM(DOC.PESO_VOLU_TOTAL)&#xA;FROM TMP_BORRAR_LOCAL.DBO.INFORMACION_DOCUMENTOS_RED_OPERATIVA TMPDOC (NOLOCK)&#xA;INNER JOIN TMP_BORRAR_LOCAL.DBO.DOCUMENTOS_RED_OPERATIVA DOC (NOLOCK) ON DOC.ID_PROCESO = 10 AND DOC.PLACA_VEHICULO_DOCU = TMPDOC.PLACA_VEHICULO_DOCU AND DOC.FECHA_HORA_MOVIMI BETWEEN TMPDOC.FECHA_HORA_MOVIMIENTO_INICIAL AND TMPDOC.FECHA_HORA_MOVIMIENTO_FINAL&#xA;WHERE TMPDOC.ID_PROCESO = 6  -- Entrada de zona urbana&#xA;GROUP BY TMPDOC.NUMERO_GUIA, TMPDOC.ID_PROCESO, TMPDOC.PLACA_VEHICULO_DOCU, TMPDOC.FECHA_HORA_MOVIMIENTO&#xA;OPTION(FAST 1)&#xA;&#xA;&#xA;-- Proceso adicional entrada de zona a partir de la salida a zona&#xA;INSERT INTO TMP_BORRAR_LOCAL.DBO.PROCESOS_ADICIONALES_RED_OPERATIVA (&#xA;NUMERO_GUIA,&#xA;ID_PROCESO,&#xA;ID_PROCESO_ADICIONAL,&#xA;PLACA_VEHICULO_DOCU,&#xA;FECHA_HORA_MOVIMIENTO,&#xA;TOTAL_GUIAS,&#xA;TOTAL_PIEZAS,&#xA;PESO_FISICO_OPERA,&#xA;PESO_VOLU_OPERA)&#xA;SELECT &#xA;TMPDOC.NUMERO_GUIA,&#xA;TMPDOC.ID_PROCESO,&#xA;6,  -- entrada de zona&#xA;TMPDOC.PLACA_VEHICULO_DOCU,&#xA;TMPDOC.FECHA_HORA_MOVIMIENTO,&#xA;SUM(DOC.TOTAL_ENVIOS),&#xA;SUM(DOC.TOTAL_PIEZAS),&#xA;SUM(DOC.PESO_TOTAL),&#xA;SUM(DOC.PESO_VOLU_TOTAL)&#xA;FROM TMP_BORRAR_LOCAL.DBO.INFORMACION_DOCUMENTOS_RED_OPERATIVA TMPDOC (NOLOCK)&#xA;INNER JOIN TMP_BORRAR_LOCAL.DBO.DOCUMENTOS_RED_OPERATIVA DOC (NOLOCK) ON DOC.ID_PROCESO = 6 AND DOC.PLACA_VEHICULO_DOCU = TMPDOC.PLACA_VEHICULO_DOCU AND DOC.FECHA_HORA_MOVIMI BETWEEN TMPDOC.FECHA_HORA_MOVIMIENTO_INICIAL AND TMPDOC.FECHA_HORA_MOVIMIENTO_FINAL&#xA;WHERE TMPDOC.ID_PROCESO = 9  -- Salida a zona urbana&#xA;GROUP BY TMPDOC.NUMERO_GUIA, TMPDOC.ID_PROCESO, TMPDOC.PLACA_VEHICULO_DOCU, TMPDOC.FECHA_HORA_MOVIMIENTO&#xA;OPTION(FAST 1)&#xA;&#xA;&#xA;&#xA;-- Proceso adicional devolucion de zona a partir de la salida a zona&#xA;INSERT INTO TMP_BORRAR_LOCAL.DBO.PROCESOS_ADICIONALES_RED_OPERATIVA (&#xA;NUMERO_GUIA,&#xA;ID_PROCESO,&#xA;ID_PROCESO_ADICIONAL,&#xA;PLACA_VEHICULO_DOCU,&#xA;FECHA_HORA_MOVIMIENTO,&#xA;TOTAL_GUIAS,&#xA;TOTAL_PIEZAS,&#xA;PESO_FISICO_OPERA,&#xA;PESO_VOLU_OPERA)&#xA;SELECT &#xA;TMPDOC.NUMERO_GUIA,&#xA;TMPDOC.ID_PROCESO,&#xA;10,  -- devolución de zona&#xA;TMPDOC.PLACA_VEHICULO_DOCU,&#xA;TMPDOC.FECHA_HORA_MOVIMIENTO,&#xA;SUM(DOC.TOTAL_ENVIOS),&#xA;SUM(DOC.TOTAL_PIEZAS),&#xA;SUM(DOC.PESO_TOTAL),&#xA;SUM(DOC.PESO_VOLU_TOTAL)&#xA;FROM TMP_BORRAR_LOCAL.DBO.INFORMACION_DOCUMENTOS_RED_OPERATIVA TMPDOC (NOLOCK)&#xA;INNER JOIN TMP_BORRAR_LOCAL.DBO.DOCUMENTOS_RED_OPERATIVA DOC (NOLOCK) ON DOC.ID_PROCESO = 10 AND DOC.PLACA_VEHICULO_DOCU = TMPDOC.PLACA_VEHICULO_DOCU AND DOC.FECHA_HORA_MOVIMI BETWEEN TMPDOC.FECHA_HORA_MOVIMIENTO_INICIAL AND TMPDOC.FECHA_HORA_MOVIMIENTO_FINAL&#xA;--WHERE TMPDOC.ID_PROCESO = 9  -- Salida a zona urbana&#xA;GROUP BY TMPDOC.NUMERO_GUIA, TMPDOC.ID_PROCESO, TMPDOC.PLACA_VEHICULO_DOCU, TMPDOC.FECHA_HORA_MOVIMIENTO&#xA;OPTION(FAST 1)&#xA;&#xA;PRINT 'Actualizando informacion documentos totalizados ' + CONVERT(VARCHAR,GETDATE(),112) + ' ' + CONVERT(VARCHAR,GETDATE(),114)&#xA;-- Actualiza los datos de los procesos adicionales en el totalizado&#xA;UPDATE TMP_BORRAR_LOCAL.DBO.INFORMACION_DOCUMENTOS_TOTALIZADOS_RED_OPERATIVA SET &#xA;TOTAL_GUIAS_RECOLECCION = TMPADI.TOTAL_GUIAS,&#xA;TOTAL_PIEZAS_RECOLECCION = TMPADI.TOTAL_PIEZAS&#xA;FROM TMP_BORRAR_LOCAL.DBO.PROCESOS_ADICIONALES_RED_OPERATIVA TMPADI (NOLOCK)&#xA;INNER JOIN TMP_BORRAR_LOCAL.DBO.INFORMACION_DOCUMENTOS_TOTALIZADOS_RED_OPERATIVA TMPTOT (NOLOCK) ON TMPTOT.NUMERO_GUIA = TMPADI.NUMERO_GUIA AND TMPTOT.ID_PROCESO = TMPADI.ID_PROCESO AND TMPTOT.PLACA_VEHICULO_DOCU = TMPADI.PLACA_VEHICULO_DOCU AND TMPTOT.FECHA_HORA_MOVIMIENTO = TMPADI.FECHA_HORA_MOVIMIENTO&#xA;WHERE TMPADI.ID_PROCESO_ADICIONAL = 6&#xA;OPTION(FAST 1)&#xA;&#xA;UPDATE TMP_BORRAR_LOCAL.DBO.INFORMACION_DOCUMENTOS_TOTALIZADOS_RED_OPERATIVA SET &#xA;PESO_FISICO_OPERA_RECOLECCION = TMPADI.PESO_FISICO_OPERA,&#xA;PESO_VOLU_OPERA_RECOLECCION = TMPADI.PESO_VOLU_OPERA&#xA;FROM TMP_BORRAR_LOCAL.DBO.PROCESOS_ADICIONALES_RED_OPERATIVA TMPADI (NOLOCK)&#xA;INNER JOIN TMP_BORRAR_LOCAL.DBO.INFORMACION_DOCUMENTOS_TOTALIZADOS_RED_OPERATIVA TMPTOT (NOLOCK) ON TMPTOT.NUMERO_GUIA = TMPADI.NUMERO_GUIA AND TMPTOT.ID_PROCESO = TMPADI.ID_PROCESO AND TMPTOT.PLACA_VEHICULO_DOCU = TMPADI.PLACA_VEHICULO_DOCU AND TMPTOT.FECHA_HORA_MOVIMIENTO = TMPADI.FECHA_HORA_MOVIMIENTO&#xA;WHERE TMPADI.ID_PROCESO_ADICIONAL = 6&#xA;OPTION(FAST 1)&#xA;&#xA;UPDATE TMP_BORRAR_LOCAL.DBO.INFORMACION_DOCUMENTOS_TOTALIZADOS_RED_OPERATIVA SET &#xA;TOTAL_GUIAS_DISTRIBUCION =TMPADI.TOTAL_GUIAS,&#xA;TOTAL_PIEZAS_DISTRIBUCION =TMPADI.TOTAL_PIEZAS&#xA;FROM TMP_BORRAR_LOCAL.DBO.PROCESOS_ADICIONALES_RED_OPERATIVA TMPADI (NOLOCK)&#xA;INNER JOIN TMP_BORRAR_LOCAL.DBO.INFORMACION_DOCUMENTOS_TOTALIZADOS_RED_OPERATIVA TMPTOT (NOLOCK) ON TMPTOT.NUMERO_GUIA = TMPADI.NUMERO_GUIA AND TMPTOT.ID_PROCESO = TMPADI.ID_PROCESO AND TMPTOT.PLACA_VEHICULO_DOCU = TMPADI.PLACA_VEHICULO_DOCU AND TMPTOT.FECHA_HORA_MOVIMIENTO = TMPADI.FECHA_HORA_MOVIMIENTO&#xA;WHERE TMPADI.ID_PROCESO_ADICIONAL = 9&#xA;OPTION(FAST 1)&#xA;&#xA;UPDATE TMP_BORRAR_LOCAL.DBO.INFORMACION_DOCUMENTOS_TOTALIZADOS_RED_OPERATIVA SET &#xA;PESO_FISICO_OPERA_DISTRIBUCION =TMPADI.PESO_FISICO_OPERA,&#xA;PESO_VOLU_OPERA_DISTRIBUCION =TMPADI.PESO_VOLU_OPERA&#xA;FROM TMP_BORRAR_LOCAL.DBO.PROCESOS_ADICIONALES_RED_OPERATIVA TMPADI (NOLOCK)&#xA;INNER JOIN TMP_BORRAR_LOCAL.DBO.INFORMACION_DOCUMENTOS_TOTALIZADOS_RED_OPERATIVA TMPTOT (NOLOCK) ON TMPTOT.NUMERO_GUIA = TMPADI.NUMERO_GUIA AND TMPTOT.ID_PROCESO = TMPADI.ID_PROCESO AND TMPTOT.PLACA_VEHICULO_DOCU = TMPADI.PLACA_VEHICULO_DOCU AND TMPTOT.FECHA_HORA_MOVIMIENTO = TMPADI.FECHA_HORA_MOVIMIENTO&#xA;WHERE TMPADI.ID_PROCESO_ADICIONAL = 9&#xA;OPTION(FAST 1)&#xA;&#xA;UPDATE TMP_BORRAR_LOCAL.DBO.INFORMACION_DOCUMENTOS_TOTALIZADOS_RED_OPERATIVA SET&#xA;TOTAL_GUIAS_DEVOLUCIONES = TMPADI.TOTAL_GUIAS,&#xA;TOTAL_PIEZAS_DEVOLUCIONES = TMPADI.TOTAL_PIEZAS&#xA;FROM TMP_BORRAR_LOCAL.DBO.PROCESOS_ADICIONALES_RED_OPERATIVA TMPADI (NOLOCK)&#xA;INNER JOIN TMP_BORRAR_LOCAL.DBO.INFORMACION_DOCUMENTOS_TOTALIZADOS_RED_OPERATIVA TMPTOT (NOLOCK) ON TMPTOT.NUMERO_GUIA = TMPADI.NUMERO_GUIA AND TMPTOT.ID_PROCESO = TMPADI.ID_PROCESO AND TMPTOT.PLACA_VEHICULO_DOCU = TMPADI.PLACA_VEHICULO_DOCU AND TMPTOT.FECHA_HORA_MOVIMIENTO = TMPADI.FECHA_HORA_MOVIMIENTO&#xA;WHERE TMPADI.ID_PROCESO_ADICIONAL = 10&#xA;OPTION(FAST 1)&#xA;&#xA;UPDATE TMP_BORRAR_LOCAL.DBO.INFORMACION_DOCUMENTOS_TOTALIZADOS_RED_OPERATIVA SET&#xA;PESO_FISICO_OPERA_DEVOLUCION =TMPADI.PESO_FISICO_OPERA,&#xA;PESO_VOLU_OPERA_DEVOLUCION =TMPADI.PESO_VOLU_OPERA&#xA;FROM TMP_BORRAR_LOCAL.DBO.PROCESOS_ADICIONALES_RED_OPERATIVA TMPADI (NOLOCK)&#xA;INNER JOIN TMP_BORRAR_LOCAL.DBO.INFORMACION_DOCUMENTOS_TOTALIZADOS_RED_OPERATIVA TMPTOT (NOLOCK) ON TMPTOT.NUMERO_GUIA = TMPADI.NUMERO_GUIA AND TMPTOT.ID_PROCESO = TMPADI.ID_PROCESO AND TMPTOT.PLACA_VEHICULO_DOCU = TMPADI.PLACA_VEHICULO_DOCU AND TMPTOT.FECHA_HORA_MOVIMIENTO = TMPADI.FECHA_HORA_MOVIMIENTO&#xA;WHERE TMPADI.ID_PROCESO_ADICIONAL = 10&#xA;OPTION(FAST 1)&#xA;-------FIN&#xA;&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
