      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{B4483C3B-3955-4FDA-8350-54289B65ECCC}"
          SQLTask:SqlStatementSource="&#xA;DECLARE @PERIODO INT = 202608&#xA;DELETE [ACCES_DARWIN].dbo.Costo_Anual_rubro_auxiliar_dia WHERE PERIODO&#x9;= 202608&#xA;&#xA;INSERT INTO [ACCES_DARWIN].dbo.Costo_Anual_rubro_auxiliar_dia&#xA;SELECT &#xA;PERIODO&#x9;= @PERIODO&#xA;,ATRIBUTO&#x9;&#xA;,VALOR = IIF(ATRIBUTO='VALOR_KM_HORA_URBANO',60,VALOR)&#xA;FROM [ACCES_DARWIN].dbo.Costo_Anual_rubro_auxiliar_dia &#xA;where PERIODO=@PERIODO-1&#xA;&#xA;&#xA;SELECT * FROM [ACCES_DARWIN].dbo.Costo_Anual_rubro_auxiliar_dia WHERE PERIODO&#x9;= 202608&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
