            <SQLTask:SqlTaskData
              SQLTask:Connection="{F23E2E5D-51C2-489D-BF93-33ABA46592D1}"
              SQLTask:SqlStatementSource="USE SIG_LOGISTICA_DM;&#xA;&#xA;&#xA;UPDATE TMP SET &#xA;TMP.VLT_RURAL_ORIG = 0&#xA;FROM SIG_LOGISTICA_DM.[TMP].[COSTO_DARWIN_BASE_OPERACION_MES] TMP&#xA;WHERE VLT_RURAL_ORIG IS NULL&#xA;&#xA;UPDATE TMP SET &#xA;TMP.VLT_RURAL_DEST = 0&#xA;FROM SIG_LOGISTICA_DM.[TMP].[COSTO_DARWIN_BASE_OPERACION_MES] TMP&#xA;WHERE  VLT_RURAL_DEST IS NULL&#xA;&#xA;&#xA;DROP TABLE IF EXISTS #GUIAS_ID_VEREDAS_RURAL&#xA;SELECT &#xA;NUMERO_GUIA&#xA;,VLT_RURAL_ORIG&#xA;,VLT_RURAL_DEST&#xA;INTO #GUIAS_ID_VEREDAS_RURAL&#xA;FROM SIG_COLOMBIA_DW.[TMP].[COSTO_DARWIN_BASE_OPERACION_MES] TMP&#xA;GROUP BY &#xA;NUMERO_GUIA&#xA;,VLT_RURAL_ORIG&#xA;,VLT_RURAL_DEST&#xA;&#xA;&#xA;--SELECT NUMERO_GUIA,COUNT(1) TT &#xA;--FROM #GUIAS_ID_VEREDAS_RURAL&#xA;--GROUP BY NUMERO_GUIA&#xA;--HAVING COUNT(1)&gt;1&#xA;&#xA;SELECT *&#xA;FROM #GUIAS_ID_VEREDAS_RURAL&#xA;&#xA;CREATE NONCLUSTERED INDEX [IX_GUIAS_ID_VEREDAS_RURAL] ON #GUIAS_ID_VEREDAS_RURAL&#xA;(&#xA;&#x9;[NUMERO_GUIA] ASC&#xA;)WITH (PAD_INDEX = OFF, STATISTICS_NORECOMPUTE = OFF, SORT_IN_TEMPDB = OFF, DROP_EXISTING = OFF, ONLINE = OFF, ALLOW_ROW_LOCKS = ON, ALLOW_PAGE_LOCKS = ON, FILLFACTOR = 80) ON [PRIMARY]&#xA;GO&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;--FROM SIG_LOGISTICA_DM.[TMP].[COSTO_DARWIN_BASE_OPERACION_MES] TMP&#xA;--WHERE VLT_RURAL_ORIG IS NULL&#xA;&#xA;UPDATE TMP SET &#xA; TMP.VLT_RURAL_DEST = RURAL.VLT_RURAL_DEST&#xA;,TMP.VLT_RURAL_ORIG = RURAL.VLT_RURAL_ORIG&#xA;FROM SIG_LOGISTICA_DM.[TMP].[COSTO_DARWIN_BASE_OPERACION_MES] TMP&#xA;INNER JOIN #GUIAS_ID_VEREDAS_RURAL RURAL&#xA;ON RURAL.NUMERO_GUIA=TMP.NUMERO_GUIA&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
      </DTS:Executables>
