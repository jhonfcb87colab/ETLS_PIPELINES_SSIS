          SQLTask:SqlStatementSource="UPDATE FAC SET&#xA;FAC.KM_INSOURCING=TRAY.[Distancia Km]&#xA;FROM SIG_COLOMBIA_DW.TMP.[COSTO_DARWIN_BASE_OPERACION_MES] FAC (NOLOCK)&#xA;INNER JOIN [ACCES_DARWIN].[dbo].[Distancia Trayectos ABC To ABC] TRAY (NOLOCK)&#xA;on TRAY.Key_Ori_Des_Tex=FAC.[LLAVE_ORIGEN_DESTINO]&#xA;WHERE KM_INSOURCING=0&#xA;&#xA;UPDATE FAC SET&#xA;FAC.KM_INSOURCING=TRAY.[Distancia Km]&#xA;FROM SIG_COLOMBIA_DW.TMP.[COSTO_DARWIN_BASE_OPERACION_MES] FAC (NOLOCK)&#xA;INNER JOIN [ACCES_DARWIN].[dbo].[Distancia Trayectos ABC To ABC] TRAY (NOLOCK)&#xA;on TRAY.Key_Des_Ori_Tex=FAC.[LLAVE_ORIGEN_DESTINO]&#xA;WHERE KM_INSOURCING=0&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
