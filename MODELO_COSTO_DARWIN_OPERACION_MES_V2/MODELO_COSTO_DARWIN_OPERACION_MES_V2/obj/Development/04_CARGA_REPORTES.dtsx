          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:SqlStatementSource="/*&#xA;&#xA;&lt;h3&gt;PASO 2&lt;/h3&gt;&#xA;&lt;h6&gt;EJECUCION PROCEDIMEINTOS DE  TRANSFORMACION  TABLA BASE OPERACION PRINCIPAL&lt;/h6&gt;&#xA;&lt;ol&gt;&#xA;                &lt;li&gt;TOTAL_GUIAS&lt;/li&gt;&#xA;                &lt;li&gt;KEY_SZU_RE_COBRO_DOBLE&lt;/li&gt;&#xA;                &lt;li&gt;TOTAL_PESO&lt;/li&gt;&#xA;                &lt;li&gt;VD_DOBLE_COBRO&lt;/li&gt;&#xA;                &lt;li&gt;TIPO_VEHICULO_BASE_PLACAS&lt;/li&gt;&#xA;                &lt;li&gt;KEY_IN_SOURCING&lt;/li&gt;&#xA;                &lt;li&gt;[Distancia_Km_1]&lt;/li&gt;&#xA;                &lt;li&gt;[Distancia_Km_2]&lt;/li&gt;&#xA;                &lt;li&gt;Fl_Zona_placa&lt;/li&gt;&#xA;                &lt;li&gt;Fl_Opera_placa&lt;/li&gt;&#xA;                &lt;li&gt;[Costo Promedio Flete Año Actual]&lt;/li&gt;&#xA;                &lt;li&gt;[COSTO_CON_AUXILIAR_POR_GUIA]&lt;/li&gt;&#xA;                &lt;li&gt;[TOTAL_GUIAS_RECOLECCION]&lt;/li&gt;&#xA;                &lt;li&gt;[TOTAL_GUIAS_DISTRIBUCION]&lt;/li&gt;&#xA;                &lt;li&gt;[TOTAL_DEVOLUCIONES]&lt;/li&gt;&#xA;                &lt;li&gt;COSTO_KM_IN_SOURCING&lt;/li&gt;&#xA;                &lt;li&gt;KM_INSOURCING&lt;/li&gt;&#xA;                &lt;li&gt;TIPO_VEHICULO_PLACAS_PROPIAS&lt;/li&gt;&#xA;                &lt;li&gt;GEO_CIU_DEPA&lt;/li&gt;&#xA;                &lt;li&gt;COSTO_FINAL_POR_MODELO&lt;/li&gt;&#xA;                &lt;li&gt;COSTO_UNITARIO_POR_KILO_GUIA&lt;/li&gt;&#xA;                &lt;li&gt;COSTO_UNITARIO_POR_UNIDAD_GUIA&lt;/li&gt;&#xA;                &lt;li&gt;COSTO_CON_AUXILIAR_POR_GUIA&lt;/li&gt;&#xA;                &lt;li&gt;COSTO_GUIA_MAS_AUXILIAR_POR_PESO&lt;/li&gt;&#xA;                &lt;li&gt;COSTO_GUIA_MAS_AUXILIAR_POR_GUIA&lt;/li&gt;&#xA;&lt;/ol&gt;&#xA;*/" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
