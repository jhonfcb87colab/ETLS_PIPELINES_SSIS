    <DTS:Executable
      DTS:refId="Package\DEPURACION PERIODOS ANTERIORES"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:Disabled="True"
      DTS:DTSID="{30334E07-DA0F-4928-9343-D837917B74BF}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="DEPURACION PERIODOS ANTERIORES"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{7CAD4937-80B8-4636-9468-E8E16DF2D376}"
          SQLTask:SqlStatementSource="USE SIG_LOGISTICA_DM&#xA;-- Declaración de variables para control de lotes y acumulación&#xA;DECLARE @BatchSize INT = 1000;&#xA;DECLARE @RowsDeleted INT = 1000; -- Inicializamos en mayor a 0 para que entre al bucle&#xA;DECLARE @TotalEliminados INT = 0;&#xA;DECLARE @MES_ATRAS DATETIME = DATEADD(MONTH, -3, DATEADD(mm, -1, DATEADD(mm, DATEDIFF(mm, 0, GETDATE()), 0)))&#xA;DECLARE @DELL_PERIODO INT = (YEAR(@MES_ATRAS)*100) + MONTH(@MES_ATRAS);&#xA;PRINT(@DELL_PERIODO)&#xA;&#xA;-- Mensaje inicial&#xA;PRINT 'Iniciando el proceso de depuración por lotes...';&#xA;&#xA;-- Bucle para eliminar de 1000 en 1000 registros&#xA;WHILE @RowsDeleted &gt; 0&#xA;BEGIN&#xA;    -- Ejecutamos el DELETE utilizando TOP para limitar el impacto&#xA;    DELETE TOP (@BatchSize) [FAC].[COSTO_DARWIN_BASE_OPERACION_MES]&#xA;    WHERE PERIODO_EJECUCION &lt; @DELL_PERIODO&#xA;    &#xA;    -- Obtenemos el número exacto de filas afectadas en esta iteración&#xA;    SET @RowsDeleted = @@ROWCOUNT;&#xA;    -- Acumulamos el total de eliminados&#xA;    SET @TotalEliminados = @TotalEliminados + @RowsDeleted;    &#xA;    -- Si se eliminaron registros en este ciclo, generamos el print con la acumulación&#xA;    IF @RowsDeleted &gt; 0&#xA;    BEGIN&#xA;        PRINT 'Se eliminaron los primeros mil registros. Acumulado total actual: ' + CAST(@TotalEliminados AS VARCHAR(20));&#xA;    END  &#xA;    -- (Opcional) Una pequeña pausa de 50 milisegundos si necesitas liberar recursos de E/S en entornos altamente concurrentes&#xA;    -- WAITFOR DELAY '00:00:00.050';&#xA;END&#xA;-- Mensaje final de confirmación total&#xA;PRINT 'Proceso finalizado con éxito. Total de registros eliminados: ' + CAST(@TotalEliminados AS VARCHAR(20));&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
