                  componentClassID="Microsoft.OLEDBSource"
                  contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                  description="OLE DB Source"
                  name="DG CPL"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">WITH CTE AS (
SELECT  ROWID = ROW_NUMBER() OVER(PARTITION BY CA.[ID_PAIS],CA.ID_CIUDAD_ANEXA ORDER BY CL.FECHA_MODIFICACION DESC)
        ,CL.[ID_PAIS]
        ,CL.[ID_CIUDAD]
        ,CA.ID_CIUDAD_ANEXA
		,C.ID_REGIONAL
        ,RTRIM(cl.CENTRO_LOGISTICO) AS CPL --VARCHAR(50)
		,CL.FECHA_MODIFICACION
FROM PARAMETROS..[CIUDADES_ANEXAS] CA (NOLOCK)
INNER JOIN  PARAMETROS..CENTROS_LOGISTICOS CL (NOLOCK)
ON
    CA.ID_PAIS = CL.ID_PAIS
AND
    CA.ID_CIUDAD = CL.ID_CIUDAD
AND
	CL.ID_CENTRO_LOGISTICO=1
INNER JOIN PARAMETROS..CIUDADES C (NOLOCK)
ON
	CA.ID_CIUDAD = C.ID_CIUDAD
AND
	CA.ID_PAIS = C.ID_PAIS
WHERE ID_ESTADO=1
)SELECT
 CT.ID_CIUDAD AS ID_CIUDAD_PRINCIPAL	
,CT.ID_PAIS	
,ISNULL(CT.ID_CIUDAD_ANEXA,C.ID_CIUDAD) ID_CIUDAD_ANEXA	
,ISNULL(CT.ID_REGIONAL,C.ID_REGIONAL) ID_REGIONAL
,ISNULL(CT.ID_REGIONAL,C.ID_REGIONAL) ID_REGIONAL_CA
--,CT.CPL
,CPL = CASE WHEN CT.CPL IS NOT NULL THEN CT.CPL 
			WHEN CT.CPL IS NULL AND CT.ID_CIUDAD_ANEXA	IS NOT NULL AND CT.ID_CIUDAD IS NOT NULL THEN 'ERROR - NO EXISTE EN PARAMETROS CENTRO LOGISTICO'
			WHEN CT.CPL IS NULL AND CT.ID_CIUDAD_ANEXA	IS NULL THEN 'ERROR - NO EXISTE EN PARAMETROS CIUDAD ANEXA'
			--WHEN CL.CENTRO_LOGISTICO IS NULL AND CT.ID_CIUDAD_ANEXA	IS NULL THEN 
			ELSE 'SIN DATOS' END
--INTO #CPLBORRARPRUEBAS
FROM PARAMETROS..CIUDADES C (NOLOCK)
LEFT JOIN CTE CT
ON CT.ID_CIUDAD_ANEXA = C.ID_CIUDAD AND CT.ID_PAIS = C.ID_PAIS
WHERE CT.ROWID=1 OR CT.ROWID IS NULL
AND ISNULL(CT.ID_REGIONAL,C.ID_REGIONAL)&gt;0
ORDER BY CT.ID_CIUDAD desc</property>
