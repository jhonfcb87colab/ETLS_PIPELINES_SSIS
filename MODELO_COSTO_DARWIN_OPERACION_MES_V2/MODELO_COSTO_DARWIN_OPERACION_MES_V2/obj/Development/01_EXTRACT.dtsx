      <DTS:Variables />
      <DTS:Executables>
        <DTS:Executable
          DTS:refId="Package\CALCULO MODA\CALCULO MODA PROCESOS CROSS"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{536d6122-4ed3-4155-a162-644dd1f38b6e}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="CALCULO MODA PROCESOS CROSS"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="5">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{A3A65FF9-9058-4FB8-AA1A-7AABA464327A}"
              SQLTask:SqlStatementSource="&#xA;DECLARE @PERIODO INT = ? ;&#xA;DECLARE @FECHA_INI DATETIME, @FECHA_FIN DATETIME;&#xA;SET @FECHA_INI = CONVERT(DATETIME,CONCAT(CONVERT(VARCHAR(6),@PERIODO),'01'))&#xA;SET @FECHA_FIN = CONVERT(DATETIME,DATEADD(MONTH,1,@FECHA_INI))&#xA;&#xA;IF OBJECT_ID('tempdb..#TMP_INFORMACION_MODA_ORIGEN_DESTINO_BI') IS NOT NULL &#xA;    DROP TABLE #TMP_INFORMACION_MODA_ORIGEN_DESTINO_BI&#xA;&#xA;CREATE TABLE #TMP_INFORMACION_MODA_ORIGEN_DESTINO_BI(--#TMP_INFORMACION_GUIAS_RED_OPERATIVA (&#xA;CONTADOR INT,&#xA;CANTIDAD BIGINT,&#xA;ID_CIUDAD_ORIGEN INT,&#xA;ID_CIUDAD_DESTINO INT,&#xA;NOMBRE_TIPOTRAY VARCHAR(40) DEFAULT '',&#xA;CANT_MOVI_CROSS INT  DEFAULT 0)&#xA;&#xA;CREATE NONCLUSTERED INDEX IX_CIUDAD ON #TMP_INFORMACION_MODA_ORIGEN_DESTINO_BI (ID_CIUDAD_ORIGEN,ID_CIUDAD_DESTINO)&#xA;&#xA;&#xA;IF OBJECT_ID('tempdb..#TMP_INFORMACION_GUIAS_BI') IS NOT NULL &#xA;    DROP TABLE #TMP_INFORMACION_GUIAS_BI&#xA;&#xA;CREATE TABLE #TMP_INFORMACION_GUIAS_BI(--#TMP_INFORMACION_GUIAS_RED_OPERATIVA (&#xA;NUMERO_GUIA NUMERIC(20,0),&#xA;NUMERO_PIEZAS INT  DEFAULT 1,&#xA;AÑO VARCHAR(4),&#xA;MES VARCHAR(2),&#xA;ID_ESTADOENVIO INT,&#xA;ID_CIUDAD_ORIGEN INT,&#xA;ID_CIUDAD_DESTINO INT,&#xA;DANE_ORIGEN_DESTINO VARCHAR(30),&#xA;ID_TIPOTRAY TINYINT,&#xA;NOMBRE_TIPOTRAY VARCHAR(40) DEFAULT '',&#xA;CANT_MOVI_CROSS INT  DEFAULT 0)&#xA;&#xA;CREATE NONCLUSTERED INDEX IX_NUMERO_GUIA ON #TMP_INFORMACION_GUIAS_BI (NUMERO_GUIA)&#xA;CREATE NONCLUSTERED INDEX IX_ID_TIPO_TRAY ON #TMP_INFORMACION_GUIAS_BI (ID_TIPOTRAY)&#xA;CREATE NONCLUSTERED INDEX IX_CIUDAD ON #TMP_INFORMACION_GUIAS_BI (ID_CIUDAD_ORIGEN,ID_CIUDAD_DESTINO)&#xA;--Script para identificar cantidad de envios cross por trayecto&#xA;&#xA;IF OBJECT_ID('tempdb..#TMP_GUIAS') IS NOT NULL &#xA;    DROP TABLE #TMP_GUIAS&#xA;&#xA;CREATE TABLE #TMP_GUIAS(&#xA;NUMERO_GUIA NUMERIC(20,0)&#xA;)&#xA;CREATE NONCLUSTERED INDEX IX_NUMERO_GUIA ON #TMP_GUIAS (NUMERO_GUIA)&#xA;&#xA;INSERT INTO #TMP_GUIAS&#xA;SELECT &#xA;DISTINCT G.NUMERO_GUIA &#xA;FROM MECE_LOGISTICO.DBO.GUIAS G (NOLOCK)&#xA;INNER JOIN MECE_LOGISTICO.DBO.SEGUIMIENTO_ENVIO SE (NOLOCK) ON SE.NUMERO_GUIA=G.NUMERO_GUIA&#xA;WHERE SE.FECHA_HORA_MOVIMIENTO BETWEEN @FECHA_INI AND @FECHA_FIN&#xA;AND SE.ID_PROCESO IN (5,6,9,12,14) --- MOVIMIENTOS_CROSS DEL MES&#xA;AND LEN(G.NUMERO_GUIA)&gt;7&#xA;OPTION(RECOMPILE, OPTIMIZE FOR UNKNOWN, MAXDOP 4)&#xA;&#xA;INSERT INTO #TMP_INFORMACION_GUIAS_BI (&#xA;NUMERO_GUIA&#xA;,NUMERO_PIEZAS&#xA;,AÑO&#xA;,MES&#xA;,ID_ESTADOENVIO&#xA;,ID_CIUDAD_ORIGEN&#xA;,ID_CIUDAD_DESTINO)&#xA;&#xA;SELECT G.NUMERO_GUIA,&#xA;G.NUMERO_PIEZAS,&#xA;CAST(YEAR(@FECHA_INI) AS VARCHAR),&#xA;CASE WHEN LEN(MONTH(@FECHA_INI))=1 THEN '0'+ CAST(MONTH(@FECHA_INI) AS VARCHAR) &#xA;ELSE CAST(MONTH(@FECHA_INI) AS VARCHAR) END,&#xA;G.ID_ESTADOENVIO,&#xA;G.ID_CIUDAD_ORIGEN,&#xA;G.ID_CIUDAD_DESTINO&#xA;FROM MECE_LOGISTICO.DBO.GUIAS G (NOLOCK)&#xA;INNER JOIN #TMP_GUIAS TG (NOLOCK) ON TG.NUMERO_GUIA=G.NUMERO_GUIA&#xA;--LEFT JOIN [Mece_Logistico].[dbo].[GUIAS_INF_ANTICIPADA] GUI (NOLOCK) ON GUI.NUMERO_GUIA=G.NUMERO_GUIA&#xA;--WHERE        ------ G.ID_PRODUCTO IN(1,2,6,59)   AND   --- MODIFICADO HOLMAN&#xA;--         G.FECHA_ENVIO BETWEEN @FECHA_INI AND @FECHA_FIN&#xA;--AND LEN(G.NUMERO_GUIA)&gt;7&#xA;OPTION(RECOMPILE, OPTIMIZE FOR UNKNOWN, MAXDOP 4)&#xA;--3.844.588&#xA;--6min&#xA;-----------------------------------------------------------------------------&#xA;&#xA;UPDATE G SET G.NUMERO_PIEZAS=GUI.NUMERO_PIEZAS&#xA;FROM #TMP_INFORMACION_GUIAS_BI G&#xA;INNER JOIN [Mece_Logistico].[dbo].[GUIAS_INF_ANTICIPADA] GUI (NOLOCK) ON GUI.NUMERO_GUIA=G.NUMERO_GUIA&#xA;OPTION(RECOMPILE, OPTIMIZE FOR UNKNOWN, MAXDOP 4)&#xA;--3.754.760&#xA;--44seg&#xA;-----------------------------------------------------------------------------&#xA;&#xA;UPDATE #TMP_INFORMACION_GUIAS_BI SET&#xA;ID_TIPOTRAY = MAT.ID_TIPOTRAY&#xA;FROM #TMP_INFORMACION_GUIAS_BI TMPGUI (NOLOCK)&#xA;--INNER JOIN MECE_LOGISTICO.DBO.[GUIAS_INF_ANTICIPADA] GUI (NOLOCK) ON GUI.NUMERO_GUIA = TMPGUI.NUMERO_GUIA&#xA;INNER JOIN PARAMETROS.DBO.MATRIZ_CIUDADES MAT (NOLOCK) ON MAT.ID_GRUPMATRIZ = 1 AND MAT.ID_PAIS_ORIG = 1 AND MAT.ID_PAIS_DEST = 1 AND MAT.ID_CIUDAD_ORIG = TMPGUI.ID_CIUDAD_ORIGEN &#xA;AND MAT.ID_CIUDAD_DEST = TMPGUI.ID_CIUDAD_DESTINO AND MAT.ID_ESTADO_TRAY = 1&#xA;WHERE ISNULL(TMPGUI.ID_TIPOTRAY,0) = 0 &#xA;OPTION(RECOMPILE, OPTIMIZE FOR UNKNOWN, MAXDOP 4)&#xA;--3.839.810&#xA;--36seg&#xA;-----------------------------------------------------------------------------&#xA;&#xA;&#xA;UPDATE #TMP_INFORMACION_GUIAS_BI SET&#xA;NOMBRE_TIPOTRAY = TIP.NOMBRE_TIPOTRAY&#xA;FROM #TMP_INFORMACION_GUIAS_BI TMPGUI (NOLOCK)&#xA;INNER JOIN PARAMETROS.DBO.TIPOTRAYECTO TIP (NOLOCK) ON TIP.ID_PAIS = 1 AND TIP.ID_TIPOTRAY = TMPGUI.ID_TIPOTRAY&#xA;OPTION(RECOMPILE, OPTIMIZE FOR UNKNOWN, MAXDOP 4)&#xA;--3.839.810&#xA;--23seg&#xA;-----------------------------------------------------------------------------&#xA;&#xA;&#xA;UPDATE #TMP_INFORMACION_GUIAS_BI SET&#xA;DANE_ORIGEN_DESTINO = ISNULL(RTRIM(CIUORI.CODIGO_DANE),'') + ' - ' + ISNULL(RTRIM(CIUDES.CODIGO_DANE),ISNULL(RTRIM(CIUORI.CODIGO_DANE),''))&#xA;FROM #TMP_INFORMACION_GUIAS_BI TMPGUI (NOLOCK)&#xA;INNER JOIN PARAMETROS.DBO.CIUDADES CIUORI (NOLOCK) ON CIUORI.ID_PAIS = 1 AND CIUORI.ID_CIUDAD = TMPGUI.ID_CIUDAD_ORIGEN&#xA;INNER JOIN PARAMETROS.DBO.CIUDADES CIUDES (NOLOCK) ON CIUDES.ID_PAIS = 1 AND CIUDES.ID_CIUDAD = TMPGUI.ID_CIUDAD_DESTINO&#xA;OPTION(RECOMPILE, OPTIMIZE FOR UNKNOWN, MAXDOP 4)&#xA;--3.840.060&#xA;--34seg&#xA;-----------------------------------------------------------------------------&#xA;&#xA;DROP TABLE IF EXISTS #TMP_INFORMACION_GUIAS_BI_AUX_CT_GUI;&#xA;SELECT DISTINCT TMPGUI_1.NUMERO_GUIA,COUNT(1) AS CANTIDAD &#xA;INTO  #TMP_INFORMACION_GUIAS_BI_AUX_CT_GUI&#xA;FROM #TMP_INFORMACION_GUIAS_BI TMPGUI_1 (NOLOCK)&#xA; INNER JOIN MECE_LOGISTICO.DBO.SEGUIMIENTO_ENVIO SEG (NOLOCK) ON SEG.NUMERO_GUIA = TMPGUI_1.NUMERO_GUIA&#xA;WHERE SEG.ID_PROCESO IN (5,6,12,9,14)-- PROCESOS LOGISTICOS CROSS&#xA;GROUP BY TMPGUI_1.NUMERO_GUIA&#xA;OPTION(RECOMPILE, OPTIMIZE FOR UNKNOWN, MAXDOP 4)&#xA;--3.668.155&#xA;--6min4seg&#xA;-----------------------------------------------------------------------------&#xA;&#xA;&#xA;&#xA;UPDATE TMPGUI SET TMPGUI.CANT_MOVI_CROSS=TMP_CROSS.CANTIDAD&#xA;FROM #TMP_INFORMACION_GUIAS_BI TMPGUI (NOLOCK)&#xA;INNER JOIN #TMP_INFORMACION_GUIAS_BI_AUX_CT_GUI AS TMP_CROSS &#xA;ON TMP_CROSS.NUMERO_GUIA=TMPGUI.NUMERO_GUIA&#xA;OPTION(RECOMPILE, OPTIMIZE FOR UNKNOWN, MAXDOP 4)&#xA;--3.668.155&#xA;--49seg&#xA;-----------------------------------------------------------------------------&#xA;&#xA;&#xA;&#xA;DELETE FROM #TMP_INFORMACION_GUIAS_BI &#xA;WHERE CANT_MOVI_CROSS=0&#xA;OPTION(RECOMPILE, OPTIMIZE FOR UNKNOWN, MAXDOP 4)&#xA;--176433&#xA;--2seg&#xA;-----------------------------------------------------------------------------&#xA;&#xA;DELETE FROM  #TMP_INFORMACION_GUIAS_BI&#xA;WHERE ID_CIUDAD_ORIGEN&lt;=0&#xA;OPTION(RECOMPILE, OPTIMIZE FOR UNKNOWN, MAXDOP 4)&#xA;--36&#xA;--0seg&#xA;-----------------------------------------------------------------------------&#xA;&#xA;DELETE FROM  #TMP_INFORMACION_GUIAS_BI&#xA;WHERE ID_CIUDAD_DESTINO&lt;=0&#xA;OPTION(RECOMPILE, OPTIMIZE FOR UNKNOWN, MAXDOP 4)&#xA;--673&#xA;--3seg&#xA;-----------------------------------------------------------------------------&#xA;&#xA;&#xA;INSERT INTO #TMP_INFORMACION_MODA_ORIGEN_DESTINO_BI&#xA;(CONTADOR,CANTIDAD,ID_CIUDAD_ORIGEN,ID_CIUDAD_DESTINO,NOMBRE_TIPOTRAY,CANT_MOVI_CROSS)&#xA;SELECT &#xA; DupRank = ROW_NUMBER() OVER (PARTITION BY ID_CIUDAD_ORIGEN,ID_CIUDAD_DESTINO,NOMBRE_TIPOTRAY ORDER BY (COUNT(1)) desc),&#xA;COUNT(1) AS CANTIDAD ,ID_CIUDAD_ORIGEN,ID_CIUDAD_DESTINO,NOMBRE_TIPOTRAY,CANT_MOVI_CROSS &#xA;FROM #TMP_INFORMACION_GUIAS_BI--tmp_borrar_local.DBO.TMP_INFORMACION_GUIAS_2024_PYTHON_CROSS_HW&#xA;--WHERE ID_CIUDAD_ORIGEN=10 AND ID_CIUDAD_DESTINO=10&#xA;GROUP BY ID_CIUDAD_ORIGEN,ID_CIUDAD_DESTINO,NOMBRE_TIPOTRAY,CANT_MOVI_CROSS&#xA;ORDER BY 2 DESC&#xA;OPTION(RECOMPILE, OPTIMIZE FOR UNKNOWN, MAXDOP 4)&#xA;--128711&#xA;--2sg&#xA;-----------------------------------------------------------------------------&#xA;&#xA;&#xA;&#xA;DELETE FROM #TMP_INFORMACION_MODA_ORIGEN_DESTINO_BI&#xA;WHERE CONTADOR&gt;1&#xA;OPTION(RECOMPILE, OPTIMIZE FOR UNKNOWN, MAXDOP 4)&#xA;--54.927&#xA;--0sg&#xA;-----------------------------------------------------------------------------&#xA;&#xA;DROP TABLE IF EXISTS #TMP_INFORMACION_GUIAS_MODA_PROCESOS_CROSS_BI; &#xA;SELECT &#xA;(CAST(TMPGUI.AÑO AS NVARCHAR) +'-' + CAST(CASE WHEN LEN(TMPGUI.MES) = 1 THEN '0' + CAST(TMPGUI.MES AS NVARCHAR) ELSE CAST(TMPGUI.MES  AS NVARCHAR) END  AS NVARCHAR)) AS AÑO_MES&#xA;,TMPGUI.NOMBRE_TIPOTRAY    --- MODIFICA HOLMAN se habilita campo&#xA;,DANE_ORIGEN_DESTINO&#xA;,ODM.CANT_MOVI_CROSS AS MODA_MOVIMIENTOS_CROSS&#xA;--,SUM(ODM.CANT_MOVI_CROSS*COUNT(TMPGUI.NUMERO_GUIA)) AS MOV_CROSS_ESPERADOS&#xA;,SUM(TMPGUI.CANT_MOVI_CROSS) AS CANTIDAD_MOVIMIENTOS_CROSS&#xA;,COUNT(TMPGUI.NUMERO_GUIA) AS NUMERO_GUIAS&#xA;,SUM(TMPGUI.NUMERO_PIEZAS) AS NUMERO_PIEZAS&#xA;,TMPGUI.ID_CIUDAD_ORIGEN&#xA;,CIUORI.NOMBRE_CIUDAD AS NOMBRE_CIUDAD_ORIGEN&#xA;,TMPGUI.ID_CIUDAD_DESTINO&#xA;,CIUDES.NOMBRE_CIUDAD AS NOMBRE_CIUDAD_DESTINO&#xA;INTO #TMP_INFORMACION_GUIAS_MODA_PROCESOS_CROSS_BI&#xA;FROM #TMP_INFORMACION_GUIAS_BI TMPGUI&#xA;INNER JOIN PARAMETROS.DBO.CIUDADES CIUORI (NOLOCK) ON CIUORI.ID_PAIS = 1 AND CIUORI.ID_CIUDAD = TMPGUI.ID_CIUDAD_ORIGEN&#xA;INNER JOIN PARAMETROS.DBO.CIUDADES CIUDES (NOLOCK) ON CIUDES.ID_PAIS = 1 AND CIUDES.ID_CIUDAD = TMPGUI.ID_CIUDAD_DESTINO&#xA;LEFT JOIN #TMP_INFORMACION_MODA_ORIGEN_DESTINO_BI ODM (NOLOCK) ON ODM.ID_CIUDAD_ORIGEN=TMPGUI.ID_CIUDAD_ORIGEN AND ODM.ID_CIUDAD_DESTINO=TMPGUI.ID_CIUDAD_DESTINO&#xA;--WHERE TMPGUI.ID_CIUDAD_ORIGEN=10 AND TMPGUI.ID_CIUDAD_DESTINO=10&#xA;--WHERE TMPGUI.AÑO=12 AND TMPGUI.MES=12&#xA;GROUP BY TMPGUI.DANE_ORIGEN_DESTINO,TMPGUI.ID_CIUDAD_ORIGEN,TMPGUI.ID_CIUDAD_DESTINO,CIUORI.NOMBRE_CIUDAD,CIUDES.NOMBRE_CIUDAD,ODM.CANT_MOVI_CROSS&#xA; ,(CAST(TMPGUI.AÑO AS NVARCHAR) +'-' + CAST(CASE WHEN LEN(TMPGUI.MES) = 1 THEN '0' + CAST(TMPGUI.MES AS NVARCHAR) ELSE CAST(TMPGUI.MES  AS NVARCHAR) END  AS NVARCHAR)) , TMPGUI.NOMBRE_TIPOTRAY&#xA;ORDER BY (CAST(TMPGUI.AÑO AS NVARCHAR) +'-' + CAST(CASE WHEN LEN(TMPGUI.MES) = 1 THEN '0' + CAST(TMPGUI.MES AS NVARCHAR) ELSE CAST(TMPGUI.MES  AS NVARCHAR) END  AS NVARCHAR)),&#xA;TMPGUI.ID_CIUDAD_ORIGEN,TMPGUI.ID_CIUDAD_DESTINO ASC&#xA;OPTION(RECOMPILE, OPTIMIZE FOR UNKNOWN, MAXDOP 4)&#xA;--73759&#xA;--16seg&#xA;-----------------------------------------------------------------------------&#xA;&#xA;TRUNCATE TABLE tmp_borrar_local.DBO.TMP_COSTOS_DWN_INFORMACION_GUIAS_MODA_PROCEOS_CROSS_FINAL_BI;&#xA;INSERT INTO tmp_borrar_local.DBO.TMP_COSTOS_DWN_INFORMACION_GUIAS_MODA_PROCEOS_CROSS_FINAL_BI&#xA;SELECT &#xA;AÑO_MES&#xA;,DANE_ORIGEN_DESTINO&#xA;,MODA_MOVIMIENTOS_CROSS&#xA;,NUMERO_GUIAS&#xA;,MODA_MOVIMIENTOS_CROSS*NUMERO_GUIAS AS MOV_CROSS_ESPERADOS&#xA;,CANTIDAD_MOVIMIENTOS_CROSS&#xA;,NUMERO_PIEZAS&#xA;,ID_CIUDAD_ORIGEN&#xA;,NOMBRE_CIUDAD_ORIGEN&#xA;,ID_CIUDAD_DESTINO&#xA;,NOMBRE_CIUDAD_DESTINO&#xA;,NOMBRE_TIPOTRAY  --- se crea campo en tabla mod holman&#xA;FROM #TMP_INFORMACION_GUIAS_MODA_PROCESOS_CROSS_BI (NOLOCK)&#xA;OPTION(RECOMPILE, OPTIMIZE FOR UNKNOWN, MAXDOP 4)&#xA;--73.759&#xA;--0seg&#xA;-----------------------------------------------------------------------------&#xA;&#xA;&#xA;--select AÑO_MES,count(1) from tmp_borrar_local.DBO.TMP_COSTOS_DWN_INFORMACION_GUIAS_MODA_PROCEOS_CROSS_FINAL_BI&#xA;--group by AÑO_MES order by 1&#xA;&#xA;&#xA;&#xA;&#xA;--WHERE AÑO_MES='2024-12'&#xA;&#xA;&#xA;--SELECT * FROM tmp_borrar_local.DBO.TMP_MODA_GUIAS_CROSS_HW_MODA_FINAL_BI&#xA;--WHERE DANE_ORIGEN_DESTINO='76892000 - 15051000'&#xA;--ORDER BY AÑO_MES ASC&#xA;&#xA;--SELECT SUM(MODA_MOVIMIENTOS_CROSS) AS MOD_CROSS,SUM(NUMERO_GUIAS) AS TOTAL_GUIAS, SUM(CANTIDAD_MOVIMIENTOS_CROSS) AS TOTAL_CROSS&#xA;--FROM #TMP_INFORMACION_GUIAS_2025_PYTHON_CROSS_HW_MODA (NOLOCK)&#xA;--WHERE AÑO_MES='2024-12'&#xA;&#xA;&#xA;----DROP TABLE TMP_BORRAR_LOCAL.DBO.TMP_INFORMACION_GUIAS_CROSS_2024_20250221&#xA;--TMP_INFORMACION_GUIAS_2025_PYTHON_CROSS_HW_MODA_FINAL&#xA;--TMP_INFORMACION_GUIAS_2024_PYTHON_CROSS_HW_MODA_FINAL&#xA;---- TABLE  tmp_borrar_local.DBO.TMP_INFORMACION_GUIAS_2024_PYTHON_CROSS_HW&#xA;&#xA;&#xA;--SELECT * FROM #TMP_INFORMACION_GUIAS &#xA;--WHERE ID_CIUDAD_ORIGEN=10 AND ID_CIUDAD_DESTINO=10&#xA;&#xA;&#xA;--SELECT * FROM Mece_Logistico.DBO.SEGUIMIENTO_ENVIO SE (NOLOCK)&#xA;--WHERE NUMERO_GUIA=9178314039" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="0"
                SQLTask:DtsVariableName="User::PERIODO_EJECUCION"
                SQLTask:ParameterDirection="Input"
                SQLTask:DataType="3"
                SQLTask:ParameterSize="-1" />
            </SQLTask:SqlTaskData>
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\CALCULO MODA\CARGA FAC TMP_COSTOS_DARWIN_MODA_PROCESOS_CROSS"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{1a5909d6-5e93-41cf-8f43-a58e1567b8e7}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="CARGA FAC TMP_COSTOS_DARWIN_MODA_PROCESOS_CROSS"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="5">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{7CAD4937-80B8-4636-9468-E8E16DF2D376}"
              SQLTask:SqlStatementSource="&#xA;--select PERIODO,count(1)&#xA;--from [SIG_LOGISTICA_DM].[FAC].[COSTOS_DARWIN_MODA_PROCESOS_CROSS]&#xA;--GROUP BY PERIODO&#xA;&#xA;DROP TABLE IF EXISTS #TMP_COSTOS_DARWIN_MODA_PROCESOS_CROSS;&#xA;SELECT &#xA; PERIODO = CONVERT(INT,CONCAT([SIG_COLOMBIA_DW].[dbo].[UFN_SEPARATES_COLUMNS](AÑO_MES,1,'-'),[SIG_COLOMBIA_DW].[dbo].[UFN_SEPARATES_COLUMNS](AÑO_MES,2,'-'))  )&#xA; ,AÑO_MES &#xA; ,DANE_ORIGEN_DESTINO &#xA; ,MODA_MOVIMIENTOS_CROSS &#xA; ,NUMERO_GUIAS &#xA; ,MOV_CROSS_ESPERADOS &#xA; ,CANTIDAD_MOVIMIENTOS_CROSS &#xA; ,NUMERO_PIEZAS &#xA; ,ID_CIUDAD_ORIGEN &#xA; ,NOMBRE_CIUDAD_ORIGEN &#xA; ,ID_CIUDAD_DESTINO &#xA; ,NOMBRE_CIUDAD_DESTINO&#xA; ,NOMBRE_TIPOTRAY&#xA; INTO #TMP_COSTOS_DARWIN_MODA_PROCESOS_CROSS&#xA;FROM [SIG_COLOMBIA_DW].[TMP].[COSTOS_DARWIN_MODA_PROCESOS_CROSS] (NOLOCK)&#xA;&#xA;DELETE FAC&#xA;FROM [SIG_LOGISTICA_DM].[FAC].[COSTOS_DARWIN_MODA_PROCESOS_CROSS] FAC&#xA;WHERE FAC.PERIODO IN(SELECT PERIODO FROM #TMP_COSTOS_DARWIN_MODA_PROCESOS_CROSS GROUP BY PERIODO)&#xA;&#xA;&#xA;INSERT INTO [SIG_LOGISTICA_DM].[FAC].[COSTOS_DARWIN_MODA_PROCESOS_CROSS]&#xA;SELECT &#xA; PERIODO&#xA;,AÑO_MES&#xA;,DANE_ORIGEN_DESTINO&#xA;,MODA_MOVIMIENTOS_CROSS&#xA;,NUMERO_GUIAS&#xA;,MOV_CROSS_ESPERADOS&#xA;,CANTIDAD_MOVIMIENTOS_CROSS&#xA;,NUMERO_PIEZAS&#xA;,ID_CIUDAD_ORIGEN&#xA;,NOMBRE_CIUDAD_ORIGEN&#xA;,ID_CIUDAD_DESTINO&#xA;,NOMBRE_CIUDAD_DESTINO&#xA;,NOMBRE_TIPOTRAY&#xA;FROM #TMP_COSTOS_DARWIN_MODA_PROCESOS_CROSS&#xA;&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="0"
                SQLTask:DtsVariableName="User::PERIODO_EJECUCION"
                SQLTask:ParameterDirection="Input"
                SQLTask:DataType="3"
                SQLTask:ParameterSize="-1" />
            </SQLTask:SqlTaskData>
