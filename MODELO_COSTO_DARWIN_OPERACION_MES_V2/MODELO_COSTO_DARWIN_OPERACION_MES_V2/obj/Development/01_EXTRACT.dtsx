              SQLTask:SqlStatementSource="DELETE T&#xA;FROM&#xA;(&#xA; select&#xA;DupRank = ROW_NUMBER() OVER (&#xA;PARTITION BY TMPTOT.NUMERO_GUIA,TMPTOT.[FECHA_RECOLECCION]&#xA;ORDER BY [FECHA_LIQUIDACION] DESC),&#xA;TMPTOT.[NUMERO_GUIA]&#xA;from  [tmp_borrar_local].[dbo].[PPES_COMISION_RECOLECCION] as TMPTOT&#xA;) AS T&#xA;WHERE DupRank &gt; 1&#xA;&#xA;&#xA;&#xA;DELETE T&#xA;FROM&#xA;(&#xA; select&#xA;DupRank = ROW_NUMBER() OVER (&#xA;PARTITION BY TMPTOT.NUMERO_GUIA&#xA;ORDER BY (SELECT NULL)),&#xA;TMPTOT.[NUMERO_GUIA]&#xA;from  [tmp_borrar_local].[dbo].[PPES_COMISION_DISTRIBUCION] as TMPTOT&#xA;) AS T&#xA;WHERE DupRank &gt; 1" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
