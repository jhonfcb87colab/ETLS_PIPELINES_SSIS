                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">WITH CTE AS(
SELECT RW_ID = ROW_NUMBER() OVER(PARTITION BY CODIGO_DANE ORDER BY FECHA_MODIFICACION DESC)
		,CODIGO_DANE	
		,NOMBRE_CIUDAD	
  FROM [PARAMETROS].[dbo].[CIUDADES] with(NOLOCK)
  WHERE ID_PAIS=1 AND CODIGO_DANE IS NOT NULL
GROUP BY CODIGO_DANE	
		,NOMBRE_CIUDAD	
		,ID_REGIONAL	
		,ID_DEPARTAMENTO
		,FECHA_MODIFICACION
)SELECT 
CODIGO_DANE	
,NOMBRE_CIUDAD	
----CODIGO_DANE,COUNT(1) TT
FROM CTE 
WHERE RW_ID=1
---GROUP BY CODIGO_DANE
--HAVING COUNT(1) &gt; 1 --AND RW_ID=1


--SELECT * FROM [PARAMETROS].[dbo].[CIUDADES] with(NOLOCK)
--WHERE CODIGO_DANE='23466014'</property>
