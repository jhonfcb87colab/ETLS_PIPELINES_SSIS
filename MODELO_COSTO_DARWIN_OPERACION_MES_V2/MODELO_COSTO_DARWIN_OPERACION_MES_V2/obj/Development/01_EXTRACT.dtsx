          SQLTask:SqlStatementSource="USE ACCCES_DARWIN;&#xA;TRUNCATE TABLE dbo.Costo_Anual_rubro_auxiliar_dia&#xA;;WITH CTE AS(&#xA;   SELECT 202412 PERIODO,'VALOR_COSTO_Aux_Camioneta' ATRIBUTO, 122000 VALOR&#xA;UNION ALL SELECT 202412 PERIODO,'VALOR_COSTO_Currier_Moto' ATRIBUTO,148180 VALOR&#xA;UNION ALL SELECT 202412 PERIODO,'VALOR_COSTO_Aux_Cross' ATRIBUTO,105387 VALOR&#xA;UNION ALL SELECT 202412 PERIODO,'VALOR_KM_HORA_URBANO' ATRIBUTO,65 VALOR&#xA;UNION ALL&#xA;   SELECT 202501 PERIODO,'VALOR_COSTO_Aux_Camioneta' ATRIBUTO, 139583 VALOR&#xA;UNION ALL SELECT 202501 PERIODO,'VALOR_COSTO_Currier_Moto' ATRIBUTO,166667 VALOR&#xA;UNION ALL SELECT 202501 PERIODO,'VALOR_COSTO_Aux_Cross' ATRIBUTO, 132083 VALOR&#xA;UNION ALL SELECT 202501 PERIODO,'VALOR_KM_HORA_URBANO' ATRIBUTO,65 VALOR&#xA;UNION ALL&#xA;   SELECT 202502 PERIODO,'VALOR_COSTO_Aux_Camioneta' ATRIBUTO, 139583 VALOR&#xA;UNION ALL SELECT 202502 PERIODO,'VALOR_COSTO_Currier_Moto' ATRIBUTO,166667 VALOR&#xA;UNION ALL SELECT 202502 PERIODO,'VALOR_COSTO_Aux_Cross' ATRIBUTO, 132083 VALOR&#xA;UNION ALL SELECT 202502 PERIODO,'VALOR_KM_HORA_URBANO' ATRIBUTO,65 VALOR&#xA;) &#xA;INSERT  INTO dbo.Costo_Anual_rubro_auxiliar_dia&#xA;SELECT &#xA; PERIODO&#xA; ,ATRIBUTO&#xA; ,VALOR&#xA;FROM CTE &#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;/*&#xA;poblar tablas&#xA;&#xA;select top 100 * from [ACCCES_DARWIN].[dbo].[COSTO POR RUTA AEREA]&#xA;select top 100 * from [ACCCES_DARWIN].[dbo].[Costo_Anual_rubro_auxiliar_dia]&#xA;select top 100 * from [ACCCES_DARWIN].[dbo].[Tarifas_Productos_Por_Periodo]&#xA;&#xA;SELECT * FROM [PAR].[M_14_1_VALORES_DISTRIBUCION_DOCUMENTO_PXP]     (NOLOCK)&#xA;SELECT * FROM [PAR].[M_14_1_VALORES_DISTRIBUCION_OTROS_PRODUCTOS_PXP]   (NOLOCK)&#xA;SELECT * FROM [PAR].[M_15_1_VALORES_DISTRIBUCION_DOCUMENTO_PXP_LODYTRANS]  (NOLOCK)&#xA;SELECT * FROM [PAR].[M_15_2_VALORES_DISTRIBUCION_OTROS_PRODUCTOS_PXP_LODYTRANS] (NOLOCK)&#xA;SELECT * FROM [PAR].[M_4_1_VALORES_DISTRIBUCION_DOCUMENTO_PXP]     (NOLOCK)&#xA;SELECT * FROM [PAR].[M_4_2_VALORES_DISTRIBUCION_OTROS_PRODUCTOS_PXP]   (NOLOCK)&#xA;SELECT * FROM [PAR].[M_4_3_VALORES_RECOLECCION_DOCUMENTO]      (NOLOCK)&#xA;SELECT * FROM [PAR].[M_4_4_VALORES_RECOLECCION_OTROS_PRODUCTOS]     (NOLOCK)&#xA;SELECT * FROM [PAR].[M_5_1_VALORES_DISTRIBUCION_PXP_AUXILIAR]     (NOLOCK)&#xA;SELECT * FROM [PAR].[M_6_1_VALORES_DISTRIBUCION_DOCUMENTO_RAPIGO]    (NOLOCK)&#xA;SELECT * FROM [PAR].[M_6_2_VALORES_DISTRIBUCION_OTROS_PRODUCTOS_RAPIGO]   (NOLOCK)&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;*/" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
