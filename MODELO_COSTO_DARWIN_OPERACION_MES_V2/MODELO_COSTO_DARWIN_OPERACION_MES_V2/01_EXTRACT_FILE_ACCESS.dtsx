    <DTS:Executable
      DTS:refId="Package\MERGE"
      DTS:CreationName="STOCK:SEQUENCE"
      DTS:Description="Sequence Container"
      DTS:DTSID="{2030C25B-391C-411C-9F39-7B1DBD8768AB}"
      DTS:ExecutableType="STOCK:SEQUENCE"
      DTS:LocaleID="-1"
      DTS:ObjectName="MERGE">
      <DTS:Variables />
      <DTS:Executables>
        <DTS:Executable
          DTS:refId="Package\MERGE\MERGE  CO-SOURCING_ZONAS"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{D5FC4A41-DAAF-41E4-9C94-4E7A33BE6497}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="MERGE  CO-SOURCING_ZONAS"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="1">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{898B6A84-08AD-4B99-ADB2-92F7E643D19D}"
              SQLTask:SqlStatementSource="&#xA;&#xA;MERGE [ACCES_DARWIN].[dbo].[CO_SOURCING_ZONAS] AS TARGET&#xA;USING (&#xA;    SELECT DISTINCT&#xA;        -- Texto a NVARCHAR&#xA;        CONVERT(nvarchar(510), PLACA) AS PLACA,&#xA;&#xA;        -- Conversión segura a DATETIME&#xA;        CONVERT(datetime, CASE WHEN ISDATE([FECHA 1]) = 1 THEN [FECHA 1] ELSE NULL END) AS [FECHA 1],&#xA;        CONVERT(datetime, CASE WHEN ISDATE([FECHA 2]) = 1 THEN [FECHA 2] ELSE NULL END) AS [FECHA 2],&#xA;&#xA;        -- Conversión segura a INT (Días laborados)&#xA;        CONVERT(int, CASE WHEN ISNUMERIC([DIAS LABORADOS]) = 1 THEN [DIAS LABORADOS] ELSE 0 END) AS [DIAS LABORADOS],&#xA;&#xA;        -- Conversión segura a MONEY (Tarifa)&#xA;        CONVERT(money, CASE WHEN ISNUMERIC(TARIFA) = 1 THEN TARIFA ELSE '0' END) AS TARIFA,&#xA;&#xA;        -- Conversión segura a INT (Total)&#xA;        CONVERT(int, CASE WHEN ISNUMERIC(TOTAL) = 1 THEN TOTAL ELSE 0 END) AS TOTAL&#xA;    FROM [SIG_COLOMBIA_DW].[TMP].[COSTO_DARWIN_PERIODOS_DASBOARD_TXT_CO-SOURCING_ZONAS]&#xA;    GROUP BY &#xA;        PLACA,&#xA;        CASE WHEN ISDATE([FECHA 1]) = 1 THEN [FECHA 1] ELSE NULL END,&#xA;        CASE WHEN ISDATE([FECHA 2]) = 1 THEN [FECHA 2] ELSE NULL END,&#xA;        CASE WHEN ISNUMERIC([DIAS LABORADOS]) = 1 THEN [DIAS LABORADOS] ELSE 0 END,&#xA;        CASE WHEN ISNUMERIC(TARIFA) = 1 THEN TARIFA ELSE '0' END,&#xA;        CASE WHEN ISNUMERIC(TOTAL) = 1 THEN TOTAL ELSE 0 END&#xA;) AS SOURCE&#xA;    -- Todos los campos indicados como relación clave en el ON&#xA;    ON TARGET.PLACA = SOURCE.PLACA&#xA;    AND TARGET.[FECHA 1] = SOURCE.[FECHA 1]&#xA;    AND TARGET.[FECHA 2] = SOURCE.[FECHA 2]&#xA;    AND TARGET.[DIAS LABORADOS] = SOURCE.[DIAS LABORADOS]&#xA;    AND TARGET.TARIFA = SOURCE.TARIFA&#xA;    AND TARGET.TOTAL = SOURCE.TOTAL&#xA;&#xA;-- CUANDO MATCHEA (Al ser todas llaves, si encuentra coincidencia es porque el dato ya es idéntico)&#xA;WHEN MATCHED THEN        &#xA;    UPDATE SET &#xA;        TARGET.PLACA = SOURCE.PLACA -- Reescritura simbólica para mantener la estructura de tu plantilla&#xA;&#xA;-- CUANDO EL REGISTRO ES NUEVO (Falta alguna de las condiciones de la llave compuesta)&#xA;WHEN NOT MATCHED THEN    &#xA;    INSERT (&#xA;        PLACA,&#xA;        [FECHA 1],&#xA;        [FECHA 2],&#xA;        [DIAS LABORADOS],&#xA;        TARIFA,&#xA;        TOTAL&#xA;    )    &#xA;    VALUES (&#xA;        SOURCE.PLACA,&#xA;        SOURCE.[FECHA 1],&#xA;        SOURCE.[FECHA 2],&#xA;        SOURCE.[DIAS LABORADOS],&#xA;        SOURCE.TARIFA,&#xA;        SOURCE.TOTAL&#xA;    );&#xA;&#xA;&#xA;&#xA;;WITH CTE AS (&#xA;SELECT &#xA;ROW_NUMBER() OVER(PARTITION BY &#xA;PLACA&#xA;,[FECHA 1]&#xA;,[FECHA 2]&#xA;,[DIAS LABORADOS]&#xA;,TARIFA&#xA;,TOTAL&#xA;ORDER BY [FECHA 1] DESC) AS ROW_DEL,*&#xA;FROM [ACCES_DARWIN].[dbo].[CO_SOURCING_ZONAS]&#xA;)DELETE CTE WHERE ROW_DEL&gt;1&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\MERGE\MERGE - Historico_Fletes_V2"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{B09BECCE-EDED-4C25-BDEA-A16C052FF10F}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="MERGE - Historico_Fletes_V2"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{898B6A84-08AD-4B99-ADB2-92F7E643D19D}"
              SQLTask:SqlStatementSource="&#xA;&#xA;MERGE [ACCES_DARWIN].[dbo].[HISTORICO_FLETES_V2] AS TARGET&#xA;USING (&#xA;    SELECT DISTINCT&#xA;        -- Conversión segura a DATETIME para la Fecha&#xA;        CONVERT(datetime, CASE WHEN ISDATE(FechaDelServicio) = 1 THEN FechaDelServicio ELSE NULL END) AS FechaDelServicio,&#xA;        &#xA;        -- Corrección de caracteres raros en el nombre de la columna origen a NVARCHAR(510)&#xA;        CONVERT(nvarchar(510), [TipodeVehÃ­culo]) AS TipodeVehículo,&#xA;        CONVERT(nvarchar(510), PLACA) AS PLACA,&#xA;        &#xA;        -- Conversión segura a FLOAT (si no es numérico, pone 0)&#xA;        CONVERT(float, CASE WHEN ISNUMERIC(ValorFlete) = 1 THEN ValorFlete ELSE '0' END) AS ValorFlete,&#xA;        &#xA;        -- Texto directo para el Mes&#xA;        CONVERT(nvarchar(510), MES2) AS MES2,&#xA;        &#xA;        -- Corrección del nombre &quot;AÃ‘O&quot; origen y conversión segura a INT&#xA;        CONVERT(int, CASE WHEN ISNUMERIC([AÃ‘O]) = 1 THEN [AÃ‘O] ELSE NULL END) AS AÑO&#xA;    FROM [SIG_COLOMBIA_DW].[TMP].[COSTO_DARWIN_PERIODOS_DASBOARD_TXT_frame_Historico_Fletes_V2]&#xA;/*   &#xA; GROUP BY &#xA;        CASE WHEN ISDATE(FechaDelServicio) = 1 THEN FechaDelServicio ELSE NULL END,&#xA;        [TipodeVehÃ­culo],&#xA;        PLACA,&#xA;        CASE WHEN ISNUMERIC(ValorFlete) = 1 THEN ValorFlete ELSE '0' END,&#xA;        MES2,&#xA;        CASE WHEN ISNUMERIC([AÃ‘O]) = 1 THEN [AÃ‘O] ELSE NULL END&#xA;*/&#xA;) AS SOURCE&#xA;    -- Condición de cruce utilizando todas las columnas clave indicadas&#xA;    ON TARGET.FechaDelServicio = SOURCE.FechaDelServicio&#xA;    AND TARGET.TipodeVehículo = SOURCE.TipodeVehículo&#xA;    AND TARGET.PLACA = SOURCE.PLACA&#xA;    AND TARGET.ValorFlete = SOURCE.ValorFlete&#xA;    AND TARGET.MES2 = SOURCE.MES2&#xA;    AND TARGET.AÑO = SOURCE.AÑO&#xA;&#xA;-- CUANDO MATCHEE (Al ser todas llaves, si ya existe el registro idéntico hacemos una actualización simbólica)&#xA;WHEN MATCHED THEN        &#xA;    UPDATE SET &#xA;        TARGET.PLACA = SOURCE.PLACA -- Reescritura para mantener intacta la estructura de tu plantilla&#xA;&#xA;-- CUANDO EL REGISTRO SEA NUEVO&#xA;WHEN NOT MATCHED THEN    &#xA;    INSERT (&#xA;        FechaDelServicio,&#xA;        TipodeVehículo,&#xA;        PLACA,&#xA;        ValorFlete,&#xA;        MES2,&#xA;        AÑO&#xA;    )    &#xA;    VALUES (&#xA;        SOURCE.FechaDelServicio,&#xA;        SOURCE.TipodeVehículo,&#xA;        SOURCE.PLACA,&#xA;        SOURCE.ValorFlete,&#xA;        SOURCE.MES2,&#xA;        SOURCE.AÑO&#xA;    );&#xA;&#xA;&#xA;;WITH CTE AS (&#xA;SELECT &#xA;ROW_NUMBER() OVER(PARTITION BY &#xA; FechaDelServicio&#xA;,TipodeVehículo&#xA;,PLACA&#xA;,ValorFlete&#xA;,MES2&#xA;,AÑO  ORDER BY FechaDelServicio desc ) AS ROW_DEL,*&#xA;FROM [ACCES_DARWIN].[dbo].[HISTORICO_FLETES_V2]&#xA;)DELETE CTE WHERE ROW_DEL&gt;1&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\MERGE\MERGE - TIPOLOGIA_IN-SOURCING"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{553FCF98-1D60-4734-9C9B-1412E44AA043}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="MERGE - TIPOLOGIA_IN-SOURCING"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="2">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{898B6A84-08AD-4B99-ADB2-92F7E643D19D}"
              SQLTask:SqlStatementSource="&#xA;MERGE [ACCES_DARWIN].[dbo].[TIPOLOGIA_IN_SOURCING] AS TARGET&#xA;USING (&#xA;    SELECT distinct&#xA;        -- Campos de texto directo&#xA;        CONVERT(nvarchar(510), MODELOFLETE) AS MODELOFLETE,&#xA;        CONVERT(nvarchar(510), TIPO_DATO_VEHICULOS_PROPIOS) AS TIPO_DATO_VEHICULOS_PROPIOS,&#xA;        CONVERT(nvarchar(510), HOMOLOGACION_COSTOS) AS HOMOLOGACION_COSTOS,&#xA;&#xA;        -- Conversión segura a MONEY (si no es numérico, ej: vacío o texto, pone 0)&#xA;        CONVERT(money, CASE WHEN ISNUMERIC(COSTOS_VARIABLES) = 1 THEN COSTOS_VARIABLES ELSE '0' END) AS COSTOS_VARIABLES,&#xA;        CONVERT(money, CASE WHEN ISNUMERIC(TRAILER_CV) = 1        THEN TRAILER_CV        ELSE '0' END) AS TRAILER_CV,&#xA;        CONVERT(money, CASE WHEN ISNUMERIC(COSTOS_FIJOS) = 1       THEN COSTOS_FIJOS       ELSE '0' END) AS COSTOS_FIJOS,&#xA;        CONVERT(money, CASE WHEN ISNUMERIC(TRAILER_CF) = 1        THEN TRAILER_CF        ELSE '0' END) AS TRAILER_CF,&#xA;        CONVERT(money, CASE WHEN ISNUMERIC(COSTOKM) = 1           THEN COSTOKM           ELSE '0' END) AS COSTOKM,&#xA;&#xA;        -- Conversión segura a INT para el Año&#xA;        CONVERT(int, CASE WHEN ISNUMERIC(AÑO_COSTO) = 1 THEN AÑO_COSTO ELSE NULL END) AS AÑO_COSTO&#xA;    FROM [SIG_COLOMBIA_DW].[TMP].[COSTO_DARWIN_PERIODOS_DASBOARD_TXT_TIPOLOGIA_IN-SOURCING]&#xA;) AS SOURCE&#xA;    -- Condición de cruce (Llave de negocio)&#xA;    ON &#xA;         TARGET.MODELOFLETE = SOURCE.MODELOFLETE&#xA;     AND TARGET.TIPO_DATO_VEHICULOS_PROPIOS = SOURCE.TIPO_DATO_VEHICULOS_PROPIOS&#xA;     AND TARGET.HOMOLOGACION_COSTOS  = SOURCE.HOMOLOGACION_COSTOS&#xA;     AND TARGET.AÑO_COSTO = SOURCE.AÑO_COSTO&#xA;&#xA;&#xA;-- CUANDO EL REGISTRO YA EXISTE&#xA;WHEN MATCHED THEN        &#xA;    UPDATE SET &#xA;        TARGET.TIPO_DATO_VEHICULOS_PROPIOS = SOURCE.TIPO_DATO_VEHICULOS_PROPIOS,&#xA;        TARGET.HOMOLOGACION_COSTOS          = SOURCE.HOMOLOGACION_COSTOS,&#xA;        TARGET.COSTOS_VARIABLES             = SOURCE.COSTOS_VARIABLES,&#xA;        TARGET.TRAILER_CV                   = SOURCE.TRAILER_CV,&#xA;        TARGET.COSTOS_FIJOS                 = SOURCE.COSTOS_FIJOS,&#xA;        TARGET.TRAILER_CF                   = SOURCE.TRAILER_CF,&#xA;        TARGET.COSTOKM                      = SOURCE.COSTOKM&#xA;        -- Nota: MODELOFLETE y AÑO_COSTO no se actualizan aquí porque están en el ON&#xA;&#xA;-- CUANDO EL REGISTRO ES NUEVO&#xA;WHEN NOT MATCHED THEN    &#xA;    INSERT (&#xA;        MODELOFLETE, &#xA;        TIPO_DATO_VEHICULOS_PROPIOS, &#xA;        HOMOLOGACION_COSTOS, &#xA;        COSTOS_VARIABLES, &#xA;        TRAILER_CV, &#xA;        COSTOS_FIJOS, &#xA;        TRAILER_CF, &#xA;        COSTOKM, &#xA;        AÑO_COSTO&#xA;    )    &#xA;    VALUES (&#xA;        SOURCE.MODELOFLETE, &#xA;        SOURCE.TIPO_DATO_VEHICULOS_PROPIOS, &#xA;        SOURCE.HOMOLOGACION_COSTOS, &#xA;        SOURCE.COSTOS_VARIABLES, &#xA;        SOURCE.TRAILER_CV, &#xA;        SOURCE.COSTOS_FIJOS, &#xA;        SOURCE.TRAILER_CF, &#xA;        SOURCE.COSTOKM, &#xA;        SOURCE.AÑO_COSTO&#xA;    );&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\MERGE\MERGE BASE_PLACAS_PROPIAS"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{b47c16f4-49cc-4d52-b6b3-0adee81018f5}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="MERGE BASE_PLACAS_PROPIAS"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="3">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{898B6A84-08AD-4B99-ADB2-92F7E643D19D}"
              SQLTask:SqlStatementSource="MERGE [ACCES_DARWIN].[dbo].[BASE PLACAS PROPIAS] AS TARGET&#xA;USING (&#xA;SELECT&#xA;&#x9;&#x9;PLACA&#xA;&#x9;&#x9;,REGIONAL&#xA;&#x9;&#x9;,TIPO_OPERACION&#xA;&#x9;&#x9;,MARCA&#xA;&#x9;&#x9;,LINEA&#xA;&#x9;&#x9;,MODELO&#xA;&#x9;&#x9;,CLASE_VEHICULO&#xA;&#x9;&#x9;,TIPO_COMBUSTIBLE&#xA;&#x9;&#x9;,TIPO&#xA;    FROM [SIG_COLOMBIA_DW].[TMP].[COSTO_DARWIN_PERIODOS_DASBOARD_TXT_BASE_PLACAS_PROPIAS]&#xA;) AS SOURCE&#xA;    ON TARGET.PLACA  = SOURCE.PLACA&#xA;&#x9;AND TARGET.REGIONAL&#x9; = SOURCE.REGIONAL&#xA;&#x9;AND TARGET.TIPO_OPERACION  = SOURCE.TIPO_OPERACION &#xA;WHEN MATCHED THEN        &#xA;    UPDATE SET &#xA;&#x9;&#x9;&#x9;TARGET.PLACA = SOURCE.PLACA,&#xA;&#x9;&#x9;&#x9;TARGET.REGIONAL = SOURCE.REGIONAL,&#xA;&#x9;&#x9;&#x9;TARGET.TIPO_OPERACION = SOURCE.TIPO_OPERACION,&#xA;&#x9;&#x9;&#x9;TARGET.MARCA = SOURCE.MARCA,&#xA;&#x9;&#x9;&#x9;TARGET.LINEA = SOURCE.LINEA,&#xA;&#x9;&#x9;&#x9;TARGET.MODELO = SOURCE.MODELO,&#xA;&#x9;&#x9;&#x9;TARGET.CLASE_VEHICULO = SOURCE.CLASE_VEHICULO,&#xA;&#x9;&#x9;&#x9;TARGET.TIPO_COMBUSTIBLE = SOURCE.TIPO_COMBUSTIBLE,&#xA;&#x9;&#x9;&#x9;TARGET.TIPO = SOURCE.TIPO&#xA;WHEN NOT MATCHED THEN    &#xA;    INSERT (&#xA;&#x9;&#x9;PLACA&#xA;&#x9;&#x9;,REGIONAL&#xA;&#x9;&#x9;,TIPO_OPERACION&#xA;&#x9;&#x9;,MARCA&#xA;&#x9;&#x9;,LINEA&#xA;&#x9;&#x9;,MODELO&#xA;&#x9;&#x9;,CLASE_VEHICULO&#xA;&#x9;&#x9;,TIPO_COMBUSTIBLE&#xA;&#x9;&#x9;,TIPO&#xA;    )    &#xA;    VALUES (&#xA;&#x9;&#x9;&#x9;SOURCE.PLACA,&#xA;&#x9;&#x9;&#x9;SOURCE.REGIONAL,&#xA;&#x9;&#x9;&#x9;SOURCE.TIPO_OPERACION,&#xA;&#x9;&#x9;&#x9;SOURCE.MARCA,&#xA;&#x9;&#x9;&#x9;SOURCE.LINEA,&#xA;&#x9;&#x9;&#x9;SOURCE.MODELO,&#xA;&#x9;&#x9;&#x9;SOURCE.CLASE_VEHICULO,&#xA;&#x9;&#x9;&#x9;SOURCE.TIPO_COMBUSTIBLE,&#xA;&#x9;&#x9;&#x9;SOURCE.TIPO&#xA;    );" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\MERGE\MERGE BASE_PLACAS_PXP"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{C529266A-495F-478F-9203-CD0958A86CBE}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="MERGE BASE_PLACAS_PXP"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="5">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{898B6A84-08AD-4B99-ADB2-92F7E643D19D}"
              SQLTask:SqlStatementSource="MERGE [ACCES_DARWIN].[dbo].[BASE_PLACAS_PXP] AS TARGET&#xA;USING (&#xA;SELECT DISTINCT&#xA;&#x9;&#x9; REGIONAL&#xA;&#x9;&#x9;,CIUDAD&#xA;&#x9;&#x9;,NOMBRE_APELLIDOS&#xA;&#x9;&#x9;,ID_PROVEEDOR = CONVERT(FLOAT, ID_PROVEEDOR)&#xA;&#x9;&#x9;,TIPO&#xA;&#x9;&#x9;,PLACA&#xA;&#x9;&#x9;,ESTADO&#xA;&#x9;&#x9;,CAPACIDAD = CONVERT(INT,CONVERT(FLOAT,CAPACIDAD))&#xA;&#x9;&#x9;,CLASE_VEHICULO&#xA;&#x9;&#x9;,TARIFA_X_ENTREGA = CONVERT(INT,CONVERT(FLOAT,TARIFA_X_ENTREGA)) &#xA;&#x9;&#x9;,TARIFA_X_RECOLECCION = CONVERT(INT,CONVERT(FLOAT,TARIFA_X_RECOLECCION)) &#xA;&#x9;&#x9;,OBSERVACIONES&#xA;&#x9;&#x9;,MODELO&#xA;&#x9;&#x9;,RANGO&#xA;    FROM [SIG_COLOMBIA_DW].[TMP].[COSTO_DARWIN_PERIODOS_DASBOARD_TXT_BASE_PLACAS_PXP]&#xA;) AS SOURCE&#xA;    ON TARGET.CIUDAD = SOURCE.CIUDAD &#xA;&#x9;AND TARGET.ID_PROVEEDOR = SOURCE.ID_PROVEEDOR &#xA;&#x9;AND TARGET.PLACA = SOURCE.PLACA &#xA;WHEN MATCHED THEN        &#xA;    UPDATE SET &#xA;&#x9;&#x9;&#x9;TARGET.REGIONAL = SOURCE.REGIONAL,&#xA;&#x9;&#x9;&#x9;TARGET.CIUDAD = SOURCE.CIUDAD,&#xA;&#x9;&#x9;&#x9;TARGET.NOMBRE_APELLIDOS = SOURCE.NOMBRE_APELLIDOS,&#xA;&#x9;&#x9;&#x9;TARGET.ID_PROVEEDOR = SOURCE.ID_PROVEEDOR,&#xA;&#x9;&#x9;&#x9;TARGET.TIPO = SOURCE.TIPO,&#xA;&#x9;&#x9;&#x9;TARGET.PLACA = SOURCE.PLACA,&#xA;&#x9;&#x9;&#x9;TARGET.ESTADO = SOURCE.ESTADO,&#xA;&#x9;&#x9;&#x9;TARGET.CAPACIDAD = SOURCE.CAPACIDAD,&#xA;&#x9;&#x9;&#x9;TARGET.CLASE_VEHICULO = SOURCE.CLASE_VEHICULO,&#xA;&#x9;&#x9;&#x9;TARGET.TARIFA_X_ENTREGA = SOURCE.TARIFA_X_ENTREGA,&#xA;&#x9;&#x9;&#x9;TARGET.TARIFA_X_RECOLECCION = SOURCE.TARIFA_X_RECOLECCION,&#xA;&#x9;&#x9;&#x9;TARGET.OBSERVACIONES = SOURCE.OBSERVACIONES,&#xA;&#x9;&#x9;&#x9;TARGET.MODELO = SOURCE.MODELO,&#xA;&#x9;&#x9;&#x9;TARGET.RANGO = SOURCE.RANGO&#xA;WHEN NOT MATCHED THEN    &#xA;    INSERT (&#xA;&#x9;&#x9; REGIONAL&#xA;&#x9;&#x9;,CIUDAD&#xA;&#x9;&#x9;,NOMBRE_APELLIDOS&#xA;&#x9;&#x9;,ID_PROVEEDOR&#xA;&#x9;&#x9;,TIPO&#xA;&#x9;&#x9;,PLACA&#xA;&#x9;&#x9;,ESTADO&#xA;&#x9;&#x9;,CAPACIDAD&#xA;&#x9;&#x9;,CLASE_VEHICULO&#xA;&#x9;&#x9;,TARIFA_X_ENTREGA&#xA;&#x9;&#x9;,TARIFA_X_RECOLECCION&#xA;&#x9;&#x9;,OBSERVACIONES&#xA;&#x9;&#x9;,MODELO&#xA;&#x9;&#x9;,RANGO&#xA;    )    &#xA;    VALUES (&#xA;&#x9;&#x9;&#x9;SOURCE.REGIONAL,&#xA;&#x9;&#x9;&#x9;SOURCE.CIUDAD,&#xA;&#x9;&#x9;&#x9;SOURCE.NOMBRE_APELLIDOS,&#xA;&#x9;&#x9;&#x9;SOURCE.ID_PROVEEDOR,&#xA;&#x9;&#x9;&#x9;SOURCE.TIPO,&#xA;&#x9;&#x9;&#x9;SOURCE.PLACA,&#xA;&#x9;&#x9;&#x9;SOURCE.ESTADO,&#xA;&#x9;&#x9;&#x9;SOURCE.CAPACIDAD,&#xA;&#x9;&#x9;&#x9;SOURCE.CLASE_VEHICULO,&#xA;&#x9;&#x9;&#x9;SOURCE.TARIFA_X_ENTREGA,&#xA;&#x9;&#x9;&#x9;SOURCE.TARIFA_X_RECOLECCION,&#xA;&#x9;&#x9;&#x9;SOURCE.OBSERVACIONES,&#xA;&#x9;&#x9;&#x9;SOURCE.MODELO,&#xA;&#x9;&#x9;&#x9;SOURCE.RANGO&#xA;    );&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\MERGE\NERGE CO-SOURCING_OPERATIVOS"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{018DC924-1125-4BC2-BBBF-6C9D64CFD48E}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="NERGE CO-SOURCING_OPERATIVOS"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="6">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{898B6A84-08AD-4B99-ADB2-92F7E643D19D}"
              SQLTask:SqlStatementSource="&#xA;&#xA;&#xA;&#xA;&#xA;MERGE [ACCES_DARWIN].[dbo].[CO_SOURCING_OPERATIVOS] AS TARGET&#xA;USING (&#xA;    SELECT  DISTINCT &#xA;        -- Conversión segura a DATETIME usando ISDATE&#xA;        CONVERT(datetime, CASE WHEN ISDATE([Fecha Manifiesto]) = 1 THEN [Fecha Manifiesto] ELSE NULL END) AS [Fecha Manifiesto],&#xA;        &#xA;        -- Campo de texto directo convertido a NVARCHAR(510)&#xA;        CONVERT(nvarchar(510), Placa) AS Placa,&#xA;&#xA;        -- Para los textos que no son llave, usamos MAX para consolidar duplicados si existen&#xA;        MAX(CONVERT(nvarchar(510), [Tipo_Vehiuclo_Co-s])) AS [Tipo_Vehiuclo_Co-s],&#xA;&#xA;        -- Conversión segura a MONEY para el Valor Facturado (Si está vacío o es texto, pone 0)&#xA;        MAX(CONVERT(money, CASE WHEN ISNUMERIC([Val Facturado Remesa]) = 1 THEN [Val Facturado Remesa] ELSE '0' END)) AS [Val Facturado Remesa]&#xA;    FROM [SIG_COLOMBIA_DW].[TMP].[COSTO_DARWIN_PERIODOS_DASBOARD_TXT_CO-SOURCING_OPERATIVOS]&#xA;    GROUP BY &#xA;        [Fecha Manifiesto],&#xA;        Placa&#xA;) AS SOURCE&#xA;    -- Columnas Llave indicadas por ti&#xA;    ON TARGET.[Fecha Manifiesto] = SOURCE.[Fecha Manifiesto]&#xA;    AND TARGET.Placa = SOURCE.Placa&#xA;&#xA;-- CUANDO EL REGISTRO YA EXISTE (ACTUALIZAR)&#xA;WHEN MATCHED THEN        &#xA;    UPDATE SET &#xA;        TARGET.[Tipo_Vehiuclo_Co-s] = SOURCE.[Tipo_Vehiuclo_Co-s],&#xA;        TARGET.[Val Facturado Remesa] = SOURCE.[Val Facturado Remesa]&#xA;        -- Nota: [Fecha Manifiesto] y Placa no se actualizan porque son tus llaves en el ON&#xA;&#xA;-- CUANDO EL REGISTRO ES NUEVO (INSERTAR)&#xA;WHEN NOT MATCHED THEN    &#xA;    INSERT (&#xA;        [Fecha Manifiesto],&#xA;        [Tipo_Vehiuclo_Co-s],&#xA;        Placa,&#xA;        [Val Facturado Remesa]&#xA;    )    &#xA;    VALUES (&#xA;        SOURCE.[Fecha Manifiesto],&#xA;        SOURCE.[Tipo_Vehiuclo_Co-s],&#xA;        SOURCE.Placa,&#xA;        SOURCE.[Val Facturado Remesa]&#xA;    );&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;;WITH CTE AS (&#xA;SELECT &#xA;ROW_NUMBER() OVER(PARTITION BY [Fecha Manifiesto],[Tipo_Vehiuclo_Co-s],[Val Facturado Remesa]&#x9;&#xA;                                ,[Placa] ORDER BY [Fecha Manifiesto]) AS ROW_DEL,*&#xA;FROM [ACCES_DARWIN].[dbo].[CO_SOURCING_OPERATIVOS]&#xA;)DELETE CTE WHERE ROW_DEL&gt;1" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
      </DTS:Executables>
    </DTS:Executable>
