                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">DECLARE @FECHA_INICIAL DATETIME = DATEADD(DAY,-1,CONVERT(DATETIME,CONVERT(DATE,GETDATE() )));
----SELECT (@FECHA_INICIAL)

;WITH CTE AS( 
SELECT 
CONTROL = DATEDIFF(HOUR,FECHA_HORA_MOVIMIENTO, FECHA_CREACION), 
*
FROM Mece_Logistico.DBO.SEGUIMIENTO_ENVIO WITH(NOLOCK)
WHERE FECHA_CREACION &gt; @FECHA_INICIAL
)
SELECT 
 ID_PROCESO
,NUMERO_MOVIMI
,CONSECUT_MOVIMI
,NUMERO_GUIA
,ID_CONCEPTO
,ID_EMPLEADO
,ID_ESTA_FISICO
,ID_PRODUCTO
,ID_SUBPRODUCTO
,ID_TIPOENVIO
,ID_CONSECUTIVO_SEGUIMIENTO
,ID_ENVIO_CRUZADO
,PESO_ENVIO
,LARGO_ENVIO
,ANCHO_ENVIO
,ALTO_ENVIO
,HORA_INICIAL_ENTREGA
,HORA_FINAL_ENTREGA
,FECHA_HORA_MOVIMIENTO
,ID_MODO_REGISTRO
,NUMERO_PIEZAS
,ID_EST_EMBALAJE
,ID_TIPOENVIO_PRODUCTIVIDAD
,DEVOLUCION_REGIONAL
,LOGIN_EMPLEADO
,FECHA_CREACION
,FECHA_MODIFICACION
,ID_REPLICADO
,FECHA_EXTRACCION_DW = GETDATE()
FROM CTE
WHERE CONTROL&gt;3</property>
