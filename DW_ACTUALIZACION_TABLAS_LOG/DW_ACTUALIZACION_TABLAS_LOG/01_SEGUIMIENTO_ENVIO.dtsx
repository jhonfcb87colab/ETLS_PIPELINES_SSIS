  <DTS:Executables>
    <DTS:Executable
      DTS:refId="Package\INSERT NO EXISTENTES PROCESOS MIGRADOS RECIENTEMENTE"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{ECE666FB-985F-4A4B-8B43-3B20323BFF1A}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="INSERT NO EXISTENTES PROCESOS MIGRADOS RECIENTEMENTE"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{DDF86F6D-DE13-491B-A614-ED50EAF66859}"
          SQLTask:SqlStatementSource="DELETE [TMP].[SEGUIEMINTO_ENVIO_ACTUALIZADOS_RECIENTEMENTE] WHERE LEN(NUMERO_GUIA)&lt;9&#xA;&#xA;DROP TABLE IF EXISTS #GUIAS_PROCESAR&#xA;DROP TABLE IF EXISTS #TBL_G_SEGUIMIENTO_ENVIO&#xA;CREATE TABLE #GUIAS_PROCESAR (ID INT IDENTITY(1,1), NUMERO_GUIA NUMERIC(20,0))&#xA;&#xA;CREATE NONCLUSTERED INDEX IDX_TMP_GUIAS_SE_ACTUA ON  #GUIAS_PROCESAR&#xA;(&#xA;&#x9;[NUMERO_GUIA] ASC&#xA;)WITH (PAD_INDEX = OFF, STATISTICS_NORECOMPUTE = OFF, SORT_IN_TEMPDB = OFF, DROP_EXISTING = OFF, ONLINE = OFF, ALLOW_ROW_LOCKS = ON, ALLOW_PAGE_LOCKS = ON, FILLFACTOR = 80) ON [PRIMARY]&#xA;&#xA;&#xA;&#xA;INSERT INTO #GUIAS_PROCESAR&#xA;SELECT &#xA;NUMERO_GUIA &#xA;FROM [TMP].[SEGUIEMINTO_ENVIO_ACTUALIZADOS_RECIENTEMENTE] RSEG WITH(NOLOCK)&#xA;GROUP BY NUMERO_GUIA&#xA;&#xA;--SELECT TOP 0 RSEG.* &#xA;--INTO #TBL_G_SEGUIMIENTO_ENVIO&#xA;--FROM  [TMP].[SEGUIEMINTO_ENVIO_ACTUALIZADOS_RECIENTEMENTE] RSEG WITH(NOLOCK)&#xA;--LEFT JOIN LOG.SEGUIMIENTO_ENVIO LSEG WITH(NOLOCK)&#xA;--ON LSEG.NUMERO_GUIA = RSEG.NUMERO_GUIA&#xA;--AND  LSEG.ID_PROCESO&#x9;= RSEG.ID_PROCESO&#xA;--AND  LSEG.NUMERO_MOVIMI = RSEG.NUMERO_MOVIMI&#x9;&#xA;--AND  LSEG.CONSECUT_MOVIMI = RSEG.CONSECUT_MOVIMI&#x9;&#xA;--WHERE LSEG.NUMERO_GUIA IS NULL&#xA;--OPTION(RECOMPILE) &#xA;&#xA;&#xA;-- 3. Bucle de inserción por Lotes basado en ID numérico (Evita borrar/volver a hacer JOINs)&#xA;DECLARE @LOTE INT = 2000; -- Incrementado a 50k para mejor rendimiento E/S&#xA;DECLARE @MIN_ID INT = 1;&#xA;DECLARE @MAX_ID_LOTE INT;&#xA;DECLARE @MAX_ID_TOTAL INT = (SELECT ISNULL(MAX(ID), 0) FROM #GUIAS_PROCESAR);&#xA;PRINT(CONCAT('NUMERO DE BATCHES = ',@MAX_ID_TOTAL/@LOTE))&#xA;&#xA;&#xA;WHILE @MIN_ID &lt;= @MAX_ID_TOTAL&#xA;BEGIN&#xA;    SET @MAX_ID_LOTE = @MIN_ID + @LOTE - 1;&#xA;&#xA;&#x9;&#x9;----&gt;INSERT INTO #TBL_G_SEGUIMIENTO_ENVIO&#xA;&#x9;&#x9;INSERT INTO  LOG.SEGUIMIENTO_ENVIO -------&gt;tabla degradada &#xA;&#x9;&#x9;SELECT RSEG.* &#xA;&#x9;&#x9;FROM  [TMP].[SEGUIEMINTO_ENVIO_ACTUALIZADOS_RECIENTEMENTE] RSEG WITH(NOLOCK)&#xA;&#x9;&#x9;LEFT JOIN LOG.SEGUIMIENTO_ENVIO LSEG WITH(NOLOCK)&#xA;&#x9;&#x9;ON LSEG.NUMERO_GUIA = RSEG.NUMERO_GUIA&#xA;&#x9;&#x9;AND  LSEG.ID_PROCESO&#x9;= RSEG.ID_PROCESO&#xA;&#x9;&#x9;AND  LSEG.NUMERO_MOVIMI = RSEG.NUMERO_MOVIMI&#x9;&#xA;&#x9;&#x9;AND  LSEG.CONSECUT_MOVIMI = RSEG.CONSECUT_MOVIMI&#x9;&#xA;&#x9;&#x9;WHERE LSEG.NUMERO_GUIA IS NULL&#xA;&#x9;&#x9;AND RSEG.NUMERO_GUIA IN(SELECT NUMERO_GUIA FROM #GUIAS_PROCESAR WHERE ID BETWEEN @MIN_ID AND @MAX_ID_LOTE)&#xA;&#x9;&#x9;OPTION(RECOMPILE) &#xA;&#x9;PRINT(CONCAT('INSERTCION REALIZADA DESDE - ',@MIN_ID,' / HASTA - ',@MAX_ID_LOTE))&#xA;    SET @MIN_ID = @MAX_ID_LOTE + 1;&#xA;END;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
