          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="WITH CTE  (&#xA;&#x9; G_NUMERO_GUIA&#xA;&#x9;,NOMBRE_PROCESO&#xA;) AS  (&#xA;&#x9;SELECT&#xA;&#x9;&#x9; TMP.G_NUMERO_GUIA&#xA;&#x9;&#x9;,PRO.NOMBRE_PROCESO_LOG&#xA;&#x9;FROM TMP.GUIA_MASIVA TMP WITH (NOLOCK)&#xA;&#x9;INNER JOIN PAR.PROCESOS PRO WITH (NOLOCK)&#xA;&#x9;&#x9;ON TMP.SE_ID_PROC_ULTI_MOVI = PRO.ID_PROCESO&#xA;)&#xA;/************/&#xA;UPDATE TMP&#xA;&#x9;SET SE_PROC_ULTI_MOVI = ISNULL (CTE.NOMBRE_PROCESO,'NO DISPONIBLE')&#xA;FROM TMP.GUIA_MASIVA TMP WITH (NOLOCK)&#xA;INNER JOIN CTE&#xA;ON TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
