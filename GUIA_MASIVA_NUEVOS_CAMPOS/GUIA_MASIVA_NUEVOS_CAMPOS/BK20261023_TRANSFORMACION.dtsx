        <DTS:Executable
          DTS:refId="Package\CUMPLIMIENTO AC Y DEPU\PLACA PROMESA DE DEPURADA"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{92B264C3-E5B0-4AA6-AD4F-5A69E2DC147C}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="PLACA PROMESA DE DEPURADA"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="WITH CTE  (&#xA;&#x9; G_NUMERO_GUIA&#xA;&#x9;,ID_PROCESO&#xA;&#x9;,NUMERO_MOVIMI&#xA;&#x9;,CONSECUT_MOVIMI&#xA;&#x9;,FECHA_HORA_MOVIMIENTO&#xA;)  AS (&#xA;&#x9;SELECT&#xA;&#x9;&#x9; C.G_NUMERO_GUIA&#xA;&#x9;&#x9;,P.ID_PROCESO&#xA;&#x9;&#x9;,P.NUMERO_MOVIMI&#xA;&#x9;&#x9;,P.CONSECUT_MOVIMI&#xA;&#x9;&#x9;,P.FECHA_HORA_MOVIMIENTO&#xA;&#x9;FROM TMP.GUIA_MASIVA_18 C WITH(NOLOCK)&#xA;&#x9;INNER JOIN &#x9;TMP.GUIA_MASIVA_07 P WITH(NOLOCK)&#xA;&#x9;&#x9;ON &#x9;C.G_NUMERO_GUIA = P.NUMERO_GUIA&#xA;&#x9;WHERE&#xA;&#x9;&#x9;( C.SE_PROMESA_CUMPLE_DEPURADA = 'NO'&#xA;&#x9;&#x9;OR C.SE_PROMESA_CUMPLE_PV_DEPURADA = 'NO'&#xA;&#x9;&#x9;)&#xA;&#x9;&#x9;AND P.ID_PROCESO = 12&#xA;)&#xA;&#xA;INSERT INTO [TMP].GUIA_MASIVA_21&#xA;           ([G_NUMERO_GUIA]&#xA;           ,[ID_PROCESO]&#xA;           ,[NUMERO_MOVIMI]&#xA;           ,[CONSECUT_MOVIMI]&#xA;           ,[PLACA_VEHICULO_DOCU]&#xA;           ,[FECHA_HORA_MOVIMIENTO])&#xA;SELECT&#xA;&#x9; CTE.G_NUMERO_GUIA&#xA;&#x9;,CTE.ID_PROCESO&#xA;&#x9;,CTE.NUMERO_MOVIMI&#xA;&#x9;,CTE.CONSECUT_MOVIMI&#xA;&#x9;,D.PLACA_VEHICULO_DOCU&#xA;&#x9;,CTE.FECHA_HORA_MOVIMIENTO&#xA;FROM [LOG].DOCUMENTOS AS  D  WITH(NOLOCK)&#xA;INNER JOIN CTE&#xA;&#x9;ON &#x9;D.ID_PROCESO = CTE.ID_PROCESO&#xA;&#x9;AND D.NUMERO_MOVIMI = CTE.NUMERO_MOVIMI&#xA;&#x9;AND D.CONSECUT_MOVIMI = CTE.CONSECUT_MOVIMI" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\CUMPLIMIENTO AC Y DEPU\PRIMERA GESTIÓN"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{8D0A5FD2-F42A-4275-90B5-496807F715DD}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="PRIMERA GESTIÓN"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="WITH REPORTE_ENTRE (&#xA;&#x9; ID&#xA;&#x9;,G_NUMERO_GUIA&#xA;&#x9;,SE_PROCESO_PRIMGEST&#xA;&#x9;,SE_ID_FECHA_PRIMGEST&#xA;&#x9;,SE_FECHA_PRIMGEST&#xA;)&#xA;AS&#xA;(&#xA;&#x9;SELECT &#xA;&#x9;&#x9; ROW_NUMBER() OVER(PARTITION BY G_NUMERO_GUIA ORDER BY FECHA) ID&#xA;&#x9;&#x9;,G_NUMERO_GUIA&#xA;&#x9;&#x9;,PROCESO SE_PROCESO_PRIMGEST&#xA;&#x9;&#x9;,FECHA SE_ID_FECHA_PRIMGEST&#xA;&#x9;&#x9;,ISNULL(CONVERT(VARCHAR,FECHA,111),'NO DISPONIBLE') SE_FECHA_PRIMGEST&#xA;&#x9;FROM   &#xA;&#x9;   (&#xA;&#x9;&#x9;SELECT &#xA;&#x9;&#x9;&#x9; [G_NUMERO_GUIA]&#xA;&#x9;&#x9;&#x9;,[SE_ID_FECHA_DZU] [DEVOLUCION ZONA URBANA]&#xA;&#x9;&#x9;&#x9;,[SE_ID_FECHA_RD] [REPORTADO DEVUELTO]&#xA;&#x9;&#x9;&#x9;,[SE_ID_FECHA_RE] [REPORTADO ENTREGADO]&#xA;&#x9;&#x9;&#x9;,[SE_ID_FECHA_EV] [ENTREGA VERIFICADA]&#xA;&#x9;&#x9;FROM&#xA;&#x9;&#x9;&#x9;[TMP].[GUIA_MASIVA_18]&#xA;&#x9;&#x9;WHERE&#xA;&#x9;&#x9;&#x9;[SE_FECHA_DZU] &lt;&gt; 'NO DISPONIBLE'&#xA;&#x9;&#x9;OR&#xA;&#x9;&#x9;&#x9;[SE_FECHA_RD] &lt;&gt; 'NO DISPONIBLE'&#xA;&#x9;&#x9;OR&#xA;&#x9;&#x9;&#x9;[SE_FECHA_RE] &lt;&gt; 'NO DISPONIBLE'&#xA;&#x9;&#x9;OR&#xA;&#x9;&#x9;&#x9;[SE_FECHA_EV] &lt;&gt; 'NO DISPONIBLE'&#xA;&#x9;&#x9;) p  &#xA;&#x9;UNPIVOT (FECHA FOR PROCESO IN   &#xA;&#x9;&#x9;(&#xA;&#x9;&#x9;&#x9; [DEVOLUCION ZONA URBANA]&#xA;&#x9;&#x9;&#x9;,[REPORTADO DEVUELTO]&#xA;&#x9;&#x9;&#x9;,[REPORTADO ENTREGADO]&#xA;&#x9;&#x9;&#x9;,[ENTREGA VERIFICADA]&#xA;&#x9;&#x9;)  &#xA;&#x9;)AS UNPVT&#xA;&#x9;WHERE&#xA;&#x9;&#x9;FECHA &lt;&gt; '1900-01-01'&#xA;)&#xA;&#xA;UPDATE TMP&#xA;SET&#xA;&#x9; SE_PROCESO_PRIMGEST = RE.SE_PROCESO_PRIMGEST&#xA;&#x9;,SE_ID_FECHA_PRIMGEST = RE.SE_ID_FECHA_PRIMGEST&#xA;&#x9;,SE_FECHA_PRIMGEST = RE.SE_FECHA_PRIMGEST&#xA;FROM  TMP.GUIA_MASIVA_18 AS TMP&#xA;INNER JOIN REPORTE_ENTRE AS RE&#xA;&#x9;ON TMP.G_NUMERO_GUIA = RE.G_NUMERO_GUIA&#xA;&#x9;&#x9;AND RE.ID = 1&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\CUMPLIMIENTO AC Y DEPU\PROCESO ACTUAL"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{188D1372-33F4-4662-AA36-B09471279028}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="PROCESO ACTUAL"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="WITH CTE  (&#xA;&#x9; ID&#xA;&#x9;,G_NUMERO_GUIA&#xA;&#x9;,SE_PROCESO_ULTI&#xA;&#x9;,SE_ID_FECHA_ULTI&#xA;&#x9;,SE_FECHA_ULTI&#xA;) AS (&#xA;&#x9;SELECT &#xA;&#x9;&#x9; ROW_NUMBER() OVER(PARTITION BY G_NUMERO_GUIA ORDER BY FECHA DESC) ID&#xA;&#x9;&#x9;,G_NUMERO_GUIA&#xA;&#x9;&#x9;,PROCESO SE_PROCESO_ULTI&#xA;&#x9;&#x9;,FECHA SE_ID_FECHA_ULTI&#xA;&#x9;&#x9;,ISNULL(CONVERT(VARCHAR,FECHA,111),'NO DISPONIBLE') SE_FECHA_ULTI&#xA;&#x9;FROM   &#xA;&#x9;   (&#xA;&#x9;&#x9;SELECT &#xA;&#x9;&#x9;&#x9; [G_NUMERO_GUIA]&#xA;&#x9;&#x9;&#x9;,[SE_ID_FECHA_SZU] [SALIDA ZONA URBANA]&#xA;&#x9;&#x9;&#x9;,[SE_ID_FECHA_DZU] [DEVOLUCION ZONA URBANA]&#xA;&#x9;&#x9;&#x9;,[SE_ID_FECHA_RD] [REPORTADO DEVUELTO]&#xA;&#x9;&#x9;&#x9;,[SE_ID_FECHA_RE] [REPORTADO ENTREGADO]&#xA;&#x9;&#x9;&#x9;,[SE_ID_FECHA_EV] [ENTREGA VERIFICADA]&#xA;&#x9;&#x9;FROM&#xA;&#x9;&#x9;&#x9;[TMP].[GUIA_MASIVA_18]&#xA;&#x9;&#x9;) p  &#xA;&#x9;UNPIVOT (FECHA FOR PROCESO IN   &#xA;&#x9;&#x9;(&#xA;&#x9;&#x9;&#x9; [SALIDA ZONA URBANA]&#xA;&#x9;&#x9;&#x9;,[DEVOLUCION ZONA URBANA]&#xA;&#x9;&#x9;&#x9;,[REPORTADO DEVUELTO]&#xA;&#x9;&#x9;&#x9;,[REPORTADO ENTREGADO]&#xA;&#x9;&#x9;&#x9;,[ENTREGA VERIFICADA]&#xA;&#x9;&#x9;)  &#xA;&#x9;)AS UNPVT&#xA;&#x9;WHERE&#xA;&#x9;&#x9;FECHA &lt;&gt; '1900-01-01'&#xA;)&#xA;&#xA;UPDATE [TMP].[GUIA_MASIVA_18]&#xA;SET  SE_PROCESO_ULTI = CTE.SE_PROCESO_ULTI&#xA;&#x9;,SE_ID_FECHA_ULTI = CTE.SE_ID_FECHA_ULTI&#xA;&#x9;,SE_FECHA_ULTI = CTE.SE_FECHA_ULTI&#xA;FROM&#xA;&#x9;TMP.GUIA_MASIVA_18 TMP INNER JOIN  CTE&#xA;&#x9;ON &#x9;TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA&#xA;&#x9;AND CTE.ID = 1&#xA;GO&#xA;&#xA;UPDATE [TMP].[GUIA_MASIVA_18]&#xA;SET  SE_PROCESO_ULTI = 'DIGITALIZADA'&#xA;&#x9;,SE_ID_FECHA_ULTI = SE_ID_FECHA_DIG&#xA;&#x9;,SE_FECHA_ULTI = SE_FECHA_DIG&#xA;FROM&#xA;&#x9;TMP.GUIA_MASIVA_18&#xA;WHERE &#x9;SE_ID_FECHA_DIG &lt;&gt;'1900-01-01'&#xA;GO&#xA;&#xA;&#xA;UPDATE [TMP].[GUIA_MASIVA_18]&#xA;SET&#xA;&#x9; SE_PROCESO_PRIMGEST = 'DIGITALIZADA'&#xA;&#x9;,SE_ID_FECHA_PRIMGEST = SE_ID_FECHA_DIG&#xA;&#x9;,SE_FECHA_PRIMGEST = SE_FECHA_DIG&#xA;FROM&#xA;&#x9;TMP.GUIA_MASIVA_18&#xA;WHERE&#xA;&#x9;SE_ID_FECHA_DIG &lt;&gt;'1900-01-01'&#xA;AND&#xA;&#x9;SE_ID_FECHA_PRIMGEST = '1900-01-01'&#xA;GO&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
