          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource=" UPDATE TMP&#xA;&#x9;SET  G_CANAL = 'RETAIL'&#xA;&#x9;&#x9;,G_ID_CIUDAD_CANAL_ORIGEN = ISNULL( S.CityId ,-888)&#xA;&#x9;&#x9;,G_ID_CIUDAD_CANAL_DESTINO = ISNULL( RTW.SHIPPING.ReceiverCityId ,-888)&#xA;&#xA;&#x9;FROM  [TMP].[GUIA_MASIVA] AS TMP WITH (NOLOCK)&#xA;&#x9;INNER JOIN  RTW.GUIDE AS G WITH (NOLOCK)&#xA;&#x9;&#x9;ON &#x9;G.NUMBER = TMP.G_NUMERO_GUIA&#x9;&#xA;&#x9;INNER JOIN RTW.SHIPPING WITH (NOLOCK) &#xA;&#x9;&#x9;ON &#x9;G.Id = RTW.SHIPPING.GuideId &#xA;&#x9;INNER JOIN RTW.INVOICEDETAIL AS D WITH (NOLOCK)&#xA;&#x9;&#x9;ON  G.InvoiceDetailId = D.Id&#xA;&#x9;INNER JOIN RTW.INVOICE AS V WITH (NOLOCK) &#xA;&#x9;&#x9;ON &#x9;D.InvoiceId = V.Id &#xA;&#x9;INNER JOIN  RTW.CASHREGISTER AS C WITH (NOLOCK) &#xA;&#x9;&#x9;ON  V.CashRegisterId = C.Id &#xA;&#x9;INNER JOIN  RTW.SOLUTIONCENTER AS S WITH (NOLOCK) &#xA;&#x9;&#x9;ON  C.SolutionCenterId = S.Id" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\PASO 09 ACTUALIZAR CANAL\PASO 09 02 ACTUALIZAR CANAL SISCLINET"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{F32B12C2-7E85-4591-BBD1-609FE8925FA7}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="PASO 09 02 ACTUALIZAR CANAL SISCLINET"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="WITH CTE&#xA;(&#xA;&#x9; G_NUMERO_GUIA&#xA;&#x9;,ID_GEOGRAFIA_SERV_ORIG&#xA;&#x9;,ID_GEOGRAFIA_SERV_DEST&#xA;) AS  (&#xA;SELECT&#xA;&#x9;   TMP.[G_NUMERO_GUIA]&#xA;&#x9;  ,CASE WHEN [DES_CIUDADREMITENTE] IS NULL THEN -888 ELSE [DES_CIUDADREMITENTE] END ID_GEOGRAFIA_SERV_ORIG&#xA;&#x9;  ,CASE WHEN [DES_CIUDAD] IS NULL THEN -888 ELSE [DES_CIUDAD] END ID_GEOGRAFIA_SERV_DEST&#xA;FROM    [TMP].[GUIA_MASIVA] TMP WITH (NOLOCK) &#xA;INNER JOIN [SCN].[SERT_ENVIO] S WITH (NOLOCK)&#xA;&#x9;ON &#x9;S.NUM_GUIA = TMP.[G_NUMERO_GUIA]&#xA;)&#xA;&#xA;/************/&#xA;UPDATE TMP&#xA;&#x9;SET  G_CANAL = 'CORPORATIVO'&#xA;&#x9;&#x9;,G_ID_CIUDAD_CANAL_ORIGEN = ISNULL(CTE.ID_GEOGRAFIA_SERV_ORIG,-888)&#xA;&#x9;&#x9;,G_ID_CIUDAD_CANAL_DESTINO = ISNULL(CTE.ID_GEOGRAFIA_SERV_DEST,-888)&#xA;FROM [TMP].[GUIA_MASIVA] TMP WITH (NOLOCK) INNER JOIN CTE&#xA;ON TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
      </DTS:Executables>
