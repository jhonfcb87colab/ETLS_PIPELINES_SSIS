      <DTS:Executables>
        <DTS:Executable
          DTS:refId="Package\PASO 29 ACTUALIZAR DESCRIPTIVOS\PASO 29 01 ACTUALIZAR TIEMPO ENTREGA"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{5BB116F0-FC92-4C79-A0A8-A8785B2C0514}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="PASO 29 01 ACTUALIZAR TIEMPO ENTREGA"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="WITH CTE  (&#xA;&#x9; G_NUMERO_GUIA&#xA;&#x9;,NOMBRE_TIEMPO&#xA;) AS (&#xA;&#x9;SELECT&#xA;&#x9;&#x9;&#x9;TMP.G_NUMERO_GUIA&#xA;&#x9;&#x9;,TI.NOMBRE_TIEMPO&#xA;&#x9;FROM  TMP.GUIA_MASIVA TMP WITH (NOLOCK)&#xA;&#x9;INNER JOIN &#x9;PAR.TIEMPOSENTREGA TI WITH (NOLOCK)&#xA;&#x9;ON TMP.G_ID_TIEMPO_ENTREGA = TI.ID_TIEMPO&#xA;)&#xA;&#xA;/******************/&#xA;UPDATE  TMP&#xA;&#x9;SET  G_TIEMPO_ENTREGA = ISNULL (CTE.NOMBRE_TIEMPO,'NO DISPONIBLE')&#xA;FROM TMP.GUIA_MASIVA AS TMP WITH (NOLOCK)&#xA;INNER JOIN CTE&#xA;ON TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\PASO 29 ACTUALIZAR DESCRIPTIVOS\PASO 29 02 ACTUALIZAR NOMBRE PRODUCTO"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{71D228C5-4F93-43A2-9F13-EC7C473CBE03}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="PASO 29 02 ACTUALIZAR NOMBRE PRODUCTO"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="WITH CTE  (&#xA;&#x9; G_NUMERO_GUIA&#xA;&#x9;,NOMBRE_PRODUCTO&#xA;) AS  (&#xA;&#x9;SELECT&#xA;&#x9;&#x9;&#x9;TMP.G_NUMERO_GUIA &#xA;&#x9;&#x9;,PRO.NOMBRE_PRODUCTO&#x9;&#xA;&#x9;FROM  TMP.GUIA_MASIVA TMP WITH (NOLOCK)&#xA;&#x9;INNER JOIN PAR.PRODUCTOS PRO WITH (NOLOCK)&#xA;&#x9;&#x9;ON TMP.G_ID_PRODUCTO = PRO.ID_PRODUCTO&#xA;)&#xA;/**************/&#xA;UPDATE  TMP&#xA;&#x9;SET G_PRODUCTO = ISNULL (CTE.NOMBRE_PRODUCTO,'NO DISPONIBLE')&#xA;FROM TMP.GUIA_MASIVA AS TMP WITH (NOLOCK)&#xA;INNER JOIN CTE&#xA;ON TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\PASO 29 ACTUALIZAR DESCRIPTIVOS\PASO 29 03 ACTUALIZAR GEOGRAFIA ORIGEN"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{F6F78676-D7D8-4A03-B5F8-014BE474043F}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="PASO 29 03 ACTUALIZAR GEOGRAFIA ORIGEN"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="/******************************************/&#xA;WITH CTE  (&#xA;&#x9; G_NUMERO_GUIA&#xA;&#x9;,REGIONAL&#xA;&#x9;,CIUDAD&#xA;&#x9;,DEPARTAMENTO&#xA;) AS (&#xA;&#x9;SELECT&#xA;&#x9;&#x9; TMP.G_NUMERO_GUIA &#xA;&#x9;&#x9;,GEO.REGIONAL&#xA;&#x9;&#x9;,GEO.CIUDAD&#xA;&#x9;&#x9;,GEO.DEPARTAMENTO&#xA;&#x9;FROM  TMP.GUIA_MASIVA TMP WITH (NOLOCK)&#xA;&#x9;INNER JOIN  DIM.GEOGRAFIA GEO WITH (NOLOCK)&#xA;&#x9;ON TMP.G_ID_CIUDAD_ORIGEN = GEO.ID_CIUDAD&#xA;)&#xA;/***********/&#xA;UPDATE  TMP&#xA;SET&#x9;  G_CIUDAD_ORIGEN = ISNULL(CTE.CIUDAD,'NO DISPONIBLE')&#xA;&#x9; ,G_DEPARTAMENTO_ORIGEN = ISNULL(CTE.DEPARTAMENTO,'NO DISPONIBLE')&#xA;&#x9; ,G_REGIONAL_ORIGEN = ISNULL(CTE.REGIONAL,'NO DISPONIBLE')&#xA;FROM TMP.GUIA_MASIVA TMP WITH (NOLOCK)&#xA;INNER JOIN CTE&#xA;ON &#x9;TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA&#xA;GO&#xA;&#xA;/******************************************/&#xA;WITH CTE (&#xA;&#x9; G_NUMERO_GUIA&#xA;&#x9;,REGIONAL&#xA;&#x9;,CIUDAD&#xA;&#x9;,DEPARTAMENTO&#xA;) AS (&#xA;&#x9;SELECT&#xA;&#x9;&#x9; TMP.G_NUMERO_GUIA &#xA;&#x9;&#x9;,GEO.REGIONAL&#xA;&#x9;&#x9;,GEO.CIUDAD&#xA;&#x9;&#x9;,GEO.DEPARTAMENTO&#xA;&#x9;FROM TMP.GUIA_MASIVA TMP WITH (NOLOCK)&#xA;&#x9;INNER JOIN  DIM.GEOGRAFIA GEO WITH (NOLOCK)&#xA;&#x9;ON &#x9;TMP.G_ID_CIUDAD_CANAL_ORIGEN = GEO.ID_CIUDAD&#xA;)&#xA;/*************/&#xA;UPDATE TMP&#xA;SET   G_CIUDAD_CANAL_ORIGEN = ISNULL(CTE.CIUDAD,'NO DISPONIBLE')&#xA;&#x9; ,G_DEPARTAMENTO_CANAL_ORIGEN = ISNULL(CTE.DEPARTAMENTO,'NO DISPONIBLE')&#xA;&#x9; ,G_REGIONAL_CANAL_ORIGEN = ISNULL(CTE.REGIONAL,'NO DISPONIBLE')&#x9; &#x9;&#xA;FROM TMP.GUIA_MASIVA TMP WITH (NOLOCK)&#xA;INNER JOIN CTE&#xA;ON TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA&#xA;GO&#xA;&#xA;/******************************************/&#xA;WITH CTE (&#xA;&#x9; G_NUMERO_GUIA&#xA;&#x9;,REGIONAL&#xA;&#x9;,CIUDAD&#xA;&#x9;,DEPARTAMENTO&#xA;) AS (&#xA;&#x9;SELECT&#xA;&#x9;&#x9; TMP.G_NUMERO_GUIA &#xA;&#x9;&#x9;,GEO.REGIONAL&#xA;&#x9;&#x9;,GEO.CIUDAD&#xA;&#x9;&#x9;,GEO.DEPARTAMENTO&#xA;&#x9;FROM  TMP.GUIA_MASIVA TMP WITH (NOLOCK)&#xA;&#x9;INNER JOIN  DIM.GEOGRAFIA GEO WITH (NOLOCK)&#xA;&#x9;ON TMP.DOC_ID_CIUDAD_ULTI_MOVI = GEO.ID_CIUDAD&#xA;)&#xA;/************/&#xA;UPDATE TMP&#xA;SET&#x9;  DOC_CIUDAD_ULTI_MOVI = ISNULL(CTE.CIUDAD,'NO DISPONIBLE')&#xA;&#x9; ,DOC_DEPT_ULTI_MOVI = ISNULL(CTE.DEPARTAMENTO,'NO DISPONIBLE')&#xA;&#x9; ,DOC_REGIONAL_ULTI_MOVI = ISNULL(CTE.REGIONAL,'NO DISPONIBLE')&#xA;FROM  TMP.GUIA_MASIVA TMP WITH (NOLOCK)&#xA;INNER JOIN CTE&#xA;ON &#x9;TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA&#xA;GO&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\PASO 29 ACTUALIZAR DESCRIPTIVOS\PASO 29 04 ACTUALIZAR GEOGRAFIA DESTINO"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{7BD9A69E-4B07-407D-89FA-1958E367DF3E}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="PASO 29 04 ACTUALIZAR GEOGRAFIA DESTINO"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="WITH CTE (&#xA;&#x9; G_NUMERO_GUIA&#xA;&#x9;,REGIONAL&#xA;&#x9;,CIUDAD&#xA;&#x9;,DEPARTAMENTO&#xA;) AS  (&#xA;&#x9;SELECT&#xA;&#x9;&#x9; TMP.G_NUMERO_GUIA &#xA;&#x9;&#x9;,GEO.REGIONAL&#xA;&#x9;&#x9;,GEO.CIUDAD&#xA;&#x9;&#x9;,GEO.DEPARTAMENTO&#xA;&#x9;FROM  TMP.GUIA_MASIVA TMP WITH (NOLOCK)&#xA;&#x9;INNER JOIN  DIM.GEOGRAFIA GEO WITH (NOLOCK)&#xA;&#x9;&#x9;ON TMP.G_ID_CIUDAD_DESTINO = GEO.ID_CIUDAD&#xA;)&#xA;/*************/&#xA;UPDATE TMP&#xA;SET   G_CIUDAD_DESTINO = ISNULL(CTE.CIUDAD,'NO DISPONIBLE')&#xA;&#x9; ,G_DEPARTAMENTO_DESTINO = ISNULL(CTE.DEPARTAMENTO,'NO DISPONIBLE')&#xA;&#x9; ,G_REGIONAL_DESTINO = ISNULL(CTE.REGIONAL,'NO DISPONIBLE')&#xA;FROM  TMP.GUIA_MASIVA TMP WITH (NOLOCK)&#xA;INNER JOIN CTE&#xA;&#x9;ON &#x9;TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA&#xA;GO&#xA;&#xA;/***********************************************/&#xA;WITH CTE (&#xA;&#x9; G_NUMERO_GUIA&#xA;&#x9;,REGIONAL&#xA;&#x9;,CIUDAD&#xA;&#x9;,DEPARTAMENTO&#xA;) AS (&#xA;&#x9;SELECT&#xA;&#x9;&#x9; TMP.G_NUMERO_GUIA &#xA;&#x9;&#x9;,GEO.REGIONAL&#xA;&#x9;&#x9;,GEO.CIUDAD&#xA;&#x9;&#x9;,GEO.DEPARTAMENTO&#xA;&#x9;FROM TMP.GUIA_MASIVA TMP WITH (NOLOCK)&#xA;&#x9;INNER JOIN  DIM.GEOGRAFIA GEO WITH (NOLOCK)&#xA;&#x9;&#x9;ON &#x9;TMP.G_ID_CIUDAD_CANAL_DESTINO = GEO.ID_CIUDAD&#xA;&#x9;)&#xA;&#xA;/***********/&#xA;UPDATE TMP&#xA;SET   G_CIUDAD_CANAL_DESTINO = ISNULL(CTE.CIUDAD,'NO DISPONIBLE')&#xA;&#x9; ,G_DEPARTAMENTO_CANAL_DESTINO = ISNULL(CTE.DEPARTAMENTO,'NO DISPONIBLE')&#xA;&#x9; ,G_REGIONAL_CANAL_DESTINO = ISNULL(CTE.REGIONAL,'NO DISPONIBLE')&#xA;FROM  TMP.GUIA_MASIVA TMP WITH (NOLOCK)&#xA;INNER JOIN CTE&#xA;&#x9;ON TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\PASO 29 ACTUALIZAR DESCRIPTIVOS\PASO 29 05 ACTUALIZAR NOMBRE CLIENTE"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{E1E98306-6EFB-47DE-9B5A-FF25536DDF01}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="PASO 29 05 ACTUALIZAR NOMBRE CLIENTE"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="WITH CTE  (&#xA;&#x9; G_NUMERO_GUIA&#xA;&#x9;,NOMBRE_CLIENTE&#xA;) AS (&#xA;&#x9;SELECT&#xA;&#x9;&#x9;&#x9;TMP.G_NUMERO_GUIA &#xA;&#x9;&#x9;,CLI.RAZON_SOCIAL_CORTA&#x9;&#x9;&#xA;&#x9;FROM  TMP.GUIA_MASIVA TMP WITH (NOLOCK)&#xA;&#x9;INNER JOIN &#x9;PAR.CLIENTES CLI WITH (NOLOCK)&#xA;&#x9;&#x9;ON TMP.G_ID_CLIENTE = CLI.ID_CLIENTE&#xA;)&#xA;/************/&#xA;UPDATE TMP&#xA;&#x9;SET G_CLIENTE = ISNULL (CASE WHEN CTE.NOMBRE_CLIENTE='' THEN NULL ELSE CTE.NOMBRE_CLIENTE END,'NO DISPONIBLE')&#xA;FROM TMP.GUIA_MASIVA TMP WITH (NOLOCK)&#xA;INNER JOIN CTE&#xA;&#x9;ON TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\PASO 29 ACTUALIZAR DESCRIPTIVOS\PASO 29 06 ACTUALIZAR ESTADO ENVIO"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{3C71D368-4FD4-490F-BDA5-52FD26805FC7}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="PASO 29 06 ACTUALIZAR ESTADO ENVIO"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="WITH CTE ( &#xA;&#x9;G_NUMERO_GUIA&#xA;&#x9;,NOMBRE_ESTADOENVIO&#xA;)  AS  (&#xA;&#x9;SELECT&#xA;&#x9;&#x9; TMP.G_NUMERO_GUIA &#xA;&#x9;&#x9;,EST.NOMBRE_ESTADOENVIO&#xA;&#x9;FROM  TMP.GUIA_MASIVA TMP WITH (NOLOCK)&#xA;&#x9;INNER JOIN PAR.ESTADOSENVIO EST WITH (NOLOCK)&#xA;&#x9; ON TMP.G_ID_ESTADO_ENVIO = EST.ID_ESTADOENVIO&#xA;)&#xA;/***********/&#xA;UPDATE TMP&#xA;&#x9;SET  G_ESTADO_ENVIO = ISNULL (CTE.NOMBRE_ESTADOENVIO,'NO DISPONIBLE')&#xA;FROM TMP.GUIA_MASIVA TMP WITH (NOLOCK)&#xA;INNER JOIN CTE&#xA;&#x9;ON &#x9;TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
