          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="WITH CTE&#xA;(&#xA;&#x9; G_NUMERO_GUIA&#xA;&#x9;,SE_ID_FECHA_SZU&#xA;&#x9;,SE_FECHA_SZU&#xA;&#x9;,SE_ID_FECHA_DZU&#xA;&#x9;,SE_FECHA_DZU&#xA;&#x9;,SE_ID_FECHA_DZU_CE&#xA;&#x9;,SE_FECHA_DZU_CE&#xA;&#x9;,SE_ID_FECHA_RD&#xA;&#x9;,SE_FECHA_RD&#xA;&#x9;,SE_ID_FECHA_RD_CE&#xA;&#x9;,SE_FECHA_RD_CE&#xA;&#x9;,SE_ID_FECHA_RE&#xA;&#x9;,SE_FECHA_RE&#xA;&#x9;,SE_ID_FECHA_EV&#xA;&#x9;,SE_FECHA_EV&#xA;&#x9;,SE_ID_FECHA_SPS&#xA;&#x9;,SE_FECHA_SPS&#xA;&#x9;,SE_ID_FECHA_RR&#xA;&#x9;,SE_FECHA_RR&#xA;&#x9;,SE_ES_EMPRESARIO&#xA;)&#xA;AS&#xA;(&#xA;&#x9;SELECT &#xA;&#x9;&#x9; NUMERO_GUIA G_NUMERO_GUIA&#xA;&#x9;&#x9;,ISNULL(MIN(CASE WHEN ID_PROCESO = 9 THEN FECHA_HORA_MOVIMIENTO ELSE NULL END ),'1900-01-01') SE_ID_FECHA_SZU&#xA;&#x9;&#x9;,ISNULL(CONVERT(VARCHAR,MIN(CASE WHEN ID_PROCESO = 9 THEN FECHA_HORA_MOVIMIENTO ELSE NULL END ),111),'NO DISPONIBLE') SE_FECHA_SZU&#xA;&#x9;&#x9;,ISNULL(MIN(CASE WHEN ID_PROCESO = 10 THEN FECHA_HORA_MOVIMIENTO ELSE NULL END ),'1900-01-01') SE_ID_FECHA_DZU&#xA;&#x9;&#x9;,ISNULL(CONVERT(VARCHAR,MIN(CASE WHEN ID_PROCESO = 10 THEN FECHA_HORA_MOVIMIENTO ELSE NULL END ),111),'NO DISPONIBLE') SE_FECHA_DZU&#xA;&#x9;&#x9;,ISNULL(MIN(CASE WHEN ID_PROCESO = 10 AND ID_CONCEPTO IN (1,3,4,5,6,7,10,14,15,19,20,21,22,23,75,8,63,64) THEN FECHA_HORA_MOVIMIENTO ELSE NULL END ),'1900-01-01') SE_ID_FECHA_DZU_CE&#xA;&#x9;&#x9;,ISNULL(CONVERT(VARCHAR,MIN(CASE WHEN ID_PROCESO = 10 AND ID_CONCEPTO IN (1,3,4,5,6,7,10,14,15,19,20,21,22,23,75,8,63,64) THEN FECHA_HORA_MOVIMIENTO ELSE NULL END ),111),'NO DISPONIBLE') SE_FECHA_DZU_CE&#xA;&#x9;&#x9;,ISNULL(MIN(CASE WHEN ID_PROCESO = 25 THEN FECHA_HORA_MOVIMIENTO ELSE NULL END ),'1900-01-01') SE_ID_FECHA_RD&#xA;&#x9;&#x9;,ISNULL(CONVERT(VARCHAR,MIN(CASE WHEN ID_PROCESO = 25 THEN FECHA_HORA_MOVIMIENTO ELSE NULL END ),111),'NO DISPONIBLE') SE_FECHA_RD&#xA;&#x9;&#x9;,ISNULL(MIN(CASE WHEN ID_PROCESO = 25 AND ID_CONCEPTO IN (1,3,4,5,6,7,10,14,15,19,20,21,22,23,75,8,63,64) THEN FECHA_HORA_MOVIMIENTO ELSE NULL END ),'1900-01-01') SE_ID_FECHA_RD_CE&#xA;&#x9;&#x9;,ISNULL(CONVERT(VARCHAR,MIN(CASE WHEN ID_PROCESO = 25 AND ID_CONCEPTO IN (1,3,4,5,6,7,10,14,15,19,20,21,22,23,75,8,63,64) THEN FECHA_HORA_MOVIMIENTO ELSE NULL END ),111),'NO DISPONIBLE') SE_FECHA_RD_CE&#xA;&#x9;&#x9;,ISNULL(MIN(CASE WHEN ID_PROCESO = 24 THEN FECHA_HORA_MOVIMIENTO ELSE NULL END ),'1900-01-01') SE_ID_FECHA_RE&#xA;&#x9;&#x9;,ISNULL(CONVERT(VARCHAR,MIN(CASE WHEN ID_PROCESO = 24 THEN FECHA_HORA_MOVIMIENTO ELSE NULL END ),111),'NO DISPONIBLE') SE_FECHA_RE&#xA;&#x9;&#x9;,ISNULL(MIN(CASE WHEN ID_PROCESO = 11 THEN FECHA_HORA_MOVIMIENTO ELSE NULL END ),'1900-01-01') SE_ID_FECHA_EV&#xA;&#x9;&#x9;,ISNULL(CONVERT(VARCHAR,MIN(CASE WHEN ID_PROCESO = 11 THEN FECHA_HORA_MOVIMIENTO ELSE NULL END ),111),'NO DISPONIBLE') SE_FECHA_EV&#xA;&#x9;&#x9;,ISNULL(MIN(CASE WHEN ID_PROCESO = 2 THEN FECHA_HORA_MOVIMIENTO ELSE NULL END ),'1900-01-01') SE_ID_FECHA_SPS&#xA;&#x9;&#x9;,ISNULL(CONVERT(VARCHAR,MIN(CASE WHEN ID_PROCESO = 2 THEN FECHA_HORA_MOVIMIENTO ELSE NULL END ),111),'NO DISPONIBLE') SE_FECHA_SPS&#xA;&#x9;&#x9;,ISNULL(MIN(CASE WHEN ID_PROCESO = 28 THEN FECHA_HORA_MOVIMIENTO ELSE NULL END ),'1900-01-01') SE_ID_FECHA_RR&#xA;&#x9;&#x9;,ISNULL(CONVERT(VARCHAR,MIN(CASE WHEN ID_PROCESO = 28 THEN FECHA_HORA_MOVIMIENTO ELSE NULL END ),111),'NO DISPONIBLE') SE_FECHA_RR&#xA;&#x9;&#x9;,CASE WHEN ISNULL(MIN(CASE WHEN ID_PROCESO = 9 AND ID_CONCEPTO IN (7,8,9) THEN FECHA_HORA_MOVIMIENTO ELSE NULL END ),'1900-01-01') &lt;&gt; '1900-01-01' THEN 'SI' ELSE 'NO' END SE_ES_EMPRESARIO&#xA;&#x9;FROM &#xA;&#x9;&#x9;TMP.GUIA_MASIVA_07 WITH(NOLOCK)&#xA;&#x9;GROUP BY &#xA;&#x9;&#x9;NUMERO_GUIA&#xA;)&#xA;&#xA;UPDATE [TMP].GUIA_MASIVA_18&#xA;SET&#xA;&#x9; SE_ID_FECHA_SZU&#x9;&#x9;= CTE.SE_ID_FECHA_SZU&#xA;&#x9;,SE_FECHA_SZU&#x9;&#x9;&#x9;= CTE.SE_FECHA_SZU&#xA;&#x9;,SE_ID_FECHA_DZU&#x9;&#x9;= CTE.SE_ID_FECHA_DZU&#xA;&#x9;,SE_FECHA_DZU&#x9;&#x9;&#x9;= CTE.SE_FECHA_DZU&#xA;&#x9;,SE_ID_FECHA_DZU_CE&#x9;&#x9;= CTE.SE_ID_FECHA_DZU_CE&#xA;&#x9;,SE_FECHA_DZU_CE&#x9;&#x9;= CTE.SE_FECHA_DZU_CE&#xA;&#x9;,SE_ID_FECHA_RD&#x9;&#x9;= CTE.SE_ID_FECHA_RD&#xA;&#x9;,SE_FECHA_RD&#x9;&#x9;&#x9;= CTE.SE_FECHA_RD&#xA;&#x9;,SE_ID_FECHA_RD_CE&#x9;&#x9;= CTE.SE_ID_FECHA_RD_CE&#xA;&#x9;,SE_FECHA_RD_CE&#x9;&#x9;= CTE.SE_FECHA_RD_CE&#xA;&#x9;,SE_ID_FECHA_RE&#x9;&#x9;= CTE.SE_ID_FECHA_RE&#xA;&#x9;,SE_FECHA_RE&#x9;&#x9;&#x9;= CTE.SE_FECHA_RE&#xA;&#x9;,SE_ID_FECHA_EV&#x9;&#x9;&#x9;= CTE.SE_ID_FECHA_EV&#xA;&#x9;,SE_FECHA_EV&#x9;&#x9;&#x9;= CTE.SE_FECHA_EV&#xA;&#x9;,SE_ID_FECHA_SPS&#x9;&#x9;= CTE.SE_ID_FECHA_SPS&#xA;&#x9;,SE_FECHA_SPS&#x9;&#x9;&#x9;= CTE.SE_FECHA_SPS&#xA;&#x9;,SE_ID_FECHA_RR&#x9;&#x9;= CTE.SE_ID_FECHA_RR&#xA;&#x9;,SE_FECHA_RR&#x9;&#x9;&#x9;= CTE.SE_FECHA_RR&#xA;&#x9;,SE_ES_EMPRESARIO&#x9;&#x9;= CTE.SE_ES_EMPRESARIO&#xA;FROM TMP.GUIA_MASIVA_18 AS TMP  WITH(NOLOCK)&#xA;INNER JOIN CTE&#xA;&#x9;ON TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
