            <component
              refId="Package\INFO MOV SE DG\OLE DB Source"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
              description="OLE DB Source"
              name="OLE DB Source"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=15.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">WITH GUIASG AS (
	SELECT NUMERO_GUIA  
	FROM .GUIAS AS G WITH(NOLOCK) 
	WHERE 	G.FECHA_MODIFICACION_DG BETWEEN 		
			CONVERT(DATE,DATEADD(DD,-?,GETDATE()))  AND  CONVERT(DATE,DATEADD(DD,1,GETDATE()))
)
,CTE
(
	 ID
	,[NUMERO_GUIA]
	,[ID_PROCESO]
	,[ID_CONCEPTO]
	,[FECHA_HORA_MOVIMIENTO]
	,[NUMERO_MOVIMI]
	,[CONSECUT_MOVIMI]
)
	AS
	(
		SELECT 
			 ROW_NUMBER() OVER(PARTITION BY [ID_PROCESO], [NUMERO_MOVIMI], [CONSECUT_MOVIMI], SE.[NUMERO_GUIA] ORDER BY [FECHA_HORA_MOVIMIENTO]) ID
			,SE.[NUMERO_GUIA]
			,[ID_PROCESO]
			,CASE WHEN ISNULL(CONVERT(INT,[ID_CONCEPTO]),-888) = 0 THEN -888 ELSE ISNULL(CONVERT(INT,[ID_CONCEPTO]),-888) END ID_CONCEPTO
			,[FECHA_HORA_MOVIMIENTO]
			,[NUMERO_MOVIMI]
			,[CONSECUT_MOVIMI]
		FROM 
			SEGUIMIENTO_ENVIO SE WITH(NOLOCK)
		INNER JOIN GUIASG G WITH(NOLOCK) ON G.NUMERO_GUIA = SE.NUMERO_GUIA
		)

SELECT [NUMERO_GUIA],[ID_PROCESO],[ID_CONCEPTO],[FECHA_HORA_MOVIMIENTO],[NUMERO_MOVIMI],[CONSECUT_MOVIMI] 
FROM CTE WHERE ID = 1



/*
WITH CTE
(
	 ID
	,[NUMERO_GUIA]
	,[ID_PROCESO]
	,[ID_CONCEPTO]
	,[FECHA_HORA_MOVIMIENTO]
	,[NUMERO_MOVIMI]
	,[CONSECUT_MOVIMI]
)
	AS
	(
		SELECT 
			 ROW_NUMBER() OVER(PARTITION BY [ID_PROCESO], [NUMERO_MOVIMI], [CONSECUT_MOVIMI], SE.[NUMERO_GUIA] ORDER BY [FECHA_HORA_MOVIMIENTO]) ID
			,SE.[NUMERO_GUIA]
			,[ID_PROCESO]
			,CASE WHEN ISNULL(CONVERT(INT,[ID_CONCEPTO]),-888) = 0 THEN -888 ELSE ISNULL(CONVERT(INT,[ID_CONCEPTO]),-888) END ID_CONCEPTO
			,[FECHA_HORA_MOVIMIENTO]
			,[NUMERO_MOVIMI]
			,[CONSECUT_MOVIMI]
		FROM 
			SEGUIMIENTO_ENVIO SE WITH(NOLOCK)
		INNER JOIN GUIAS G WITH(NOLOCK) ON G.NUMERO_GUIA = SE.NUMERO_GUIA
		WHERE G.FECHA_MODIFICACION_DG BETWEEN 
		CONVERT(DATE,DATEADD(DD,-5,GETDATE()))
			AND 
		CONVERT(DATE,DATEADD(DD,1,GETDATE()))

		)
SELECT [NUMERO_GUIA],[ID_PROCESO],[ID_CONCEPTO],[FECHA_HORA_MOVIMIENTO],[NUMERO_MOVIMI],[CONSECUT_MOVIMI] FROM CTE WHERE ID = 1
*/</property>
