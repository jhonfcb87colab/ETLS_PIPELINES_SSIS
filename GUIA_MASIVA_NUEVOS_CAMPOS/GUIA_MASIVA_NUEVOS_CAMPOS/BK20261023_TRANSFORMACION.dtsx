          SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
          SQLTask:SqlStatementSource="DROP TABLE IF EXISTS #CTE_GUIA_MASIVA_01;&#xA;SELECT &#xA;&#x9;ROW_NUMBER() OVER(PARTITION BY G.NUMERO_GUIA ORDER BY G.FECHA_EXTRACCION_DW DESC ) ID&#xA;&#x9;,G.[NUMERO_GUIA]&#x9;&#x9;&#x9;&#x9;,G.[NUMERO_PIEZAS]&#x9;&#x9;&#x9;&#x9;,G.[ID_TIEMPO]&#xA;&#x9;,G.[ID_PRODUCTO]&#x9;&#x9;&#x9;&#x9;,G.[ID_CLIENTE]&#x9;&#x9;&#x9;&#x9;&#x9;,G.[ID_ESTADOENVIO]&#xA;&#x9;,G.[ID_CIUDAD_ORIGEN]&#x9;&#x9;&#x9;,G.[ID_CIUDAD_DESTINO]&#x9;&#x9;&#x9;,G.[FECHA_ENVIO]&#xA;&#x9;,G.[DIRECCION_DESTINA_GUIA]&#x9;&#x9;,G.[ID_PAIS_UBICACION]&#x9;&#x9;&#x9;,G.[ID_CIUDAD_UBICACION]&#xA;&#x9;,G.[ID_DIVISION_UBICACION]&#x9;&#x9;,G.[VALOR_DECLARADO_GUIA]&#x9;&#x9;&#x9;&#xA;INTO #CTE_GUIA_MASIVA_01&#xA;FROM   [TMP].[GUIA_MASIVA_01] AS G WITH(NOLOCK)&#xA;&#xA;CREATE NONCLUSTERED INDEX IDX_BI_CTE_GUIA_MASIVA01 ON #CTE_GUIA_MASIVA_01 (ID) ;&#xA;&#xA;INSERT INTO  TMP.GUIA_MASIVA_02 &#xA;(&#xA;&#x9; [NUMERO_GUIA]&#x9;&#x9;&#x9;&#x9;,[NUMERO_PIEZAS]&#x9;&#x9;&#x9;,[ID_TIEMPO]&#xA;&#x9;,[ID_PRODUCTO]&#x9;&#x9;&#x9;&#x9;,[ID_CLIENTE]&#x9;&#x9;&#x9;&#x9;,[ID_ESTADOENVIO]&#xA;&#x9;,[ID_CIUDAD_ORIGEN]&#x9;&#x9;&#x9;,[ID_CIUDAD_DESTINO]&#x9;&#x9;,[FECHA_ENVIO]&#xA;&#x9;,[DIRECCION_DESTINA_GUIA]&#x9;,[ID_PAIS_UBICACION]&#x9;&#x9;,[ID_CIUDAD_UBICACION]&#xA;&#x9;,[ID_DIVISION_UBICACION]&#x9;,[VALOR_DECLARADO_GUIA]&#xA;)&#xA;SELECT&#xA;&#x9; [NUMERO_GUIA]&#x9;&#x9;&#x9;&#x9;,[NUMERO_PIEZAS]&#x9;&#x9;&#x9;,[ID_TIEMPO]&#xA;&#x9;,[ID_PRODUCTO]&#x9;&#x9;&#x9;&#x9;,[ID_CLIENTE]&#x9;&#x9;&#x9;&#x9;,[ID_ESTADOENVIO]&#xA;&#x9;,[ID_CIUDAD_ORIGEN]&#x9;&#x9;&#x9;,[ID_CIUDAD_DESTINO]&#x9;&#x9;,[FECHA_ENVIO]&#xA;&#x9;,[DIRECCION_DESTINA_GUIA]&#x9;,[ID_PAIS_UBICACION]&#x9;&#x9;,[ID_CIUDAD_UBICACION]&#xA;&#x9;,[ID_DIVISION_UBICACION]&#x9;,[VALOR_DECLARADO_GUIA]&#xA;FROM&#xA;&#x9;#CTE_GUIA_MASIVA_01 AS C&#xA;WHERE  &#x9;C.ID = 1&#xA;OPTION(RECOMPILE) ;&#xA;&#xA;DROP TABLE IF EXISTS #CTE_GUIA_MASIVA_01;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
