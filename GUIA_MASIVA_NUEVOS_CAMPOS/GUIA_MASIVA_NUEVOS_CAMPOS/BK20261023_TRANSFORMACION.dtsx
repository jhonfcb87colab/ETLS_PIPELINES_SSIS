        DTS:FilterKind="0" />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{24578307-51FC-41A0-AC22-59AE3C11017B}"
          SQLTask:SqlStatementSource="TRUNCATE TABLE TMP.GUIA_MASIVA;&#xA;&#xA;WITH GUIASM AS (&#xA;&#x9;SELECT &#xA;&#x9;&#x9;ROW_NUMBER() OVER (PARTITION BY G_NUMERO_GUIA ORDER BY G_NUMERO_GUIA) AS #ROW,&#xA;&#x9;&#x9;G_NUMERO_GUIA&#xA;&#x9;FROM SIG_COLOMBIA_DW.TMP.GUIA_MASIVA WITH (NOLOCK)&#xA;)&#xA;INSERT INTO TMP.GUIA_MASIVA&#xA;&#x9;SELECT G_NUMERO_GUIA &#xA;&#x9;FROM GUIASM &#xA;&#x9;WHERE #ROW = 1" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
