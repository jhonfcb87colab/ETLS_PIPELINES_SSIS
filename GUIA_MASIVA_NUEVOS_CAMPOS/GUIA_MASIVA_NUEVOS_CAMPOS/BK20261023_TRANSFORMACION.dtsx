      DTS:EvaluateAsExpression="True"
      DTS:Expression="(DT_DATE)@[$Project::ParMesIni] == (DT_DATE)&quot;1900-01-01&quot; ?  &#xA;  ((DT_WSTR,4)YEAR(DATEADD(&quot;DD&quot;, -@[$Project::Dias_Ant] ,GETDATE()))+&quot;-&quot;+RIGHT(&quot;0&quot;+(DT_WSTR,2)MONTH(DATEADD(&quot;DD&quot;,-@[$Project::Dias_Ant],GETDATE())),2)+&quot;-&quot;+RIGHT(&quot;0&quot;+(DT_WSTR,2)DAY(DATEADD(&quot;DD&quot;,-@[$Project::Dias_Ant],GETDATE())),2))&#xA;:  @[$Project::ParMesIni]"
