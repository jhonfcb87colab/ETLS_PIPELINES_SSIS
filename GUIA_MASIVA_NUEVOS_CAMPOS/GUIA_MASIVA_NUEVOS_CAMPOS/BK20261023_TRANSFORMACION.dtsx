          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="PROMESA A TIEMPO O TARDE"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="UPDATE TMP.GUIA_MASIVA_18&#xA;SET &#xA;&#x9;SE_PROMESA_ESTADO = CASE WHEN SE_ID_FECHA_ENTREGA &gt;= CONVERT(DATETIME,CONVERT(DATE,GETDATE())) THEN 'A TIEMPO' ELSE 'TARDE' END&#xA;WHERE &#xA;&#x9;SE_PROCESO_PRIMGEST = 'NO DISPONIBLE'&#xA;GO&#xA;&#xA;DECLARE @DIA_HABIL_NO_SD INT = 0&#xA;DECLARE @DIA_HABIL_NO_D INT = 0&#xA;&#xA;SELECT TOP 1 @DIA_HABIL_NO_SD = ID_DIA_HABIL FROM TMP.GUIA_MASIVA_DHABIL_NO_SD F WITH(NOLOCK) WHERE F.FECHA &gt;= GETDATE()&#xA;SELECT TOP 1 @DIA_HABIL_NO_D = ID_DIA_HABIL FROM TMP.GUIA_MASIVA_DHABIL_NO_D F WITH(NOLOCK) WHERE F.FECHA &gt;= GETDATE()&#xA;&#xA;UPDATE&#xA;&#x9;[TMP].GUIA_MASIVA_18&#xA;SET&#xA;&#x9; [SE_PROMESA_CUMPLE_ACIDA]&#x9;&#x9;&#x9;= 'NO'&#xA;&#x9;,[SE_PROMESA_CUMPLE_DEPURADA]&#x9;&#x9;= 'NO'&#xA;&#x9;,[SE_PROMESA_CUMPLE_PV_ACIDA]&#x9;&#x9;= 'NO'&#xA;&#x9;,[SE_PROMESA_CUMPLE_PV_DEPURADA]&#x9;= 'NO'&#xA;&#x9;,[SE_PROMESA_PENALI_PV_ACIDA]&#x9;&#x9;=&#xA;&#x9;CASE WHEN SE_ID_FECHA_ENTREGA &lt;&gt; '1900-01-01' THEN&#xA;&#x9;&#x9;CASE &#xA;&#x9;&#x9;&#x9;WHEN (CASE WHEN G_ID_HABIL_SABADO = 0 THEN @DIA_HABIL_NO_SD ELSE @DIA_HABIL_NO_D END - SE_ID_DIA_HABIL_ENTREGA) = 1 THEN '1 DÍA'&#xA;&#x9;&#x9;&#x9;WHEN (CASE WHEN G_ID_HABIL_SABADO = 0 THEN @DIA_HABIL_NO_SD ELSE @DIA_HABIL_NO_D END - SE_ID_DIA_HABIL_ENTREGA) = 2 THEN '2 DÍAS'&#xA;&#x9;&#x9;&#x9;WHEN (CASE WHEN G_ID_HABIL_SABADO = 0 THEN @DIA_HABIL_NO_SD ELSE @DIA_HABIL_NO_D END - SE_ID_DIA_HABIL_ENTREGA) &gt;= 3 AND (CASE WHEN G_ID_HABIL_SABADO = 0 THEN @DIA_HABIL_NO_SD ELSE @DIA_HABIL_NO_D END - SE_ID_DIA_HABIL_ENTREGA) &lt; 6 THEN '3-5 DÍAS'&#xA;&#x9;&#x9;&#x9;WHEN (CASE WHEN G_ID_HABIL_SABADO = 0 THEN @DIA_HABIL_NO_SD ELSE @DIA_HABIL_NO_D END - SE_ID_DIA_HABIL_ENTREGA) &gt;= 6 AND (CASE WHEN G_ID_HABIL_SABADO = 0 THEN @DIA_HABIL_NO_SD ELSE @DIA_HABIL_NO_D END - SE_ID_DIA_HABIL_ENTREGA) &lt; 11 THEN '6-10 DÍAS'&#xA;&#x9;&#x9;&#x9;ELSE 'MAYOR A 10 DÍAS' END&#xA;&#x9; ELSE 'NO DISPONIBLE' END&#xA;WHERE&#xA;&#x9;SE_PROMESA_ESTADO = 'TARDE'&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
      </DTS:Executables>
