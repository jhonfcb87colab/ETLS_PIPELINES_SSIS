                  description="OLE DB Source"
                  name="OLE DB Source"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=15.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT 
NUMERO_GUIA,
ISNULL(MIN(CASE WHEN ID_PROCESO = 10 THEN FECHA_HORA_MOVIMIENTO ELSE NULL END ),'1900-01-01') SE_ID_FECHA_DZU,
ISNULL(CONVERT(VARCHAR,MIN(CASE WHEN ID_PROCESO = 10 THEN FECHA_HORA_MOVIMIENTO ELSE NULL END ),111),'NO DISPONIBLE') SE_FECHA_DZU,
ISNULL(MIN(CASE WHEN ID_PROCESO = 25 THEN FECHA_HORA_MOVIMIENTO ELSE NULL END ),'1900-01-01') SE_ID_FECHA_RD,
ISNULL(CONVERT(VARCHAR,MIN(CASE WHEN ID_PROCESO = 25 THEN FECHA_HORA_MOVIMIENTO ELSE NULL END ),111),'NO DISPONIBLE') SE_FECHA_RD,
ISNULL(MIN(CASE WHEN ID_PROCESO = 24 THEN FECHA_HORA_MOVIMIENTO ELSE NULL END ),'1900-01-01') SE_ID_FECHA_RE,
ISNULL(CONVERT(VARCHAR,MIN(CASE WHEN ID_PROCESO = 24 THEN FECHA_HORA_MOVIMIENTO ELSE NULL END ),111),'NO DISPONIBLE') SE_FECHA_RE,
ISNULL(MIN(CASE WHEN ID_PROCESO = 11 THEN FECHA_HORA_MOVIMIENTO ELSE NULL END ),'1900-01-01') SE_ID_FECHA_EV,
ISNULL(CONVERT(VARCHAR,MIN(CASE WHEN ID_PROCESO = 11 THEN FECHA_HORA_MOVIMIENTO ELSE NULL END ),111),'NO DISPONIBLE') SE_FECHA_EV
FROM TMP.GUIA_MASIVA_16 WITH(NOLOCK)
GROUP BY NUMERO_GUIA</property>
