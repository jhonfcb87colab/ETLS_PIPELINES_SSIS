        <DTS:Executable
          DTS:refId="Package\PASO 30 NUEVOS CAMPOS\PASO 30 2 ESTADO RECAUDO"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{F59D6F49-18FF-4D40-B4A4-BEEC87A7A5CF}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="PASO 30 2 ESTADO RECAUDO"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="WITH CTE(&#xA;&#x9;GUIA,&#xA;&#x9;ORDEN,&#xA;&#x9;VALOR&#xA;)AS(&#xA;&#x9;SELECT &#xA;&#x9;G_NUMERO_GUIA,&#xA;&#x9;GRIR_NUMERO_ORDEN_SERVICIO,GRIR_VALOR_RECAUDAR&#xA;&#x9;FROM TMP.GUIA_MASIVA WITH(NOLOCK)&#xA;)&#xA;UPDATE TMP.GUIA_MASIVA &#xA;SET GRIR_ESTADO_RECAUDO = &#xA;&#x9;CASE &#xA;&#x9;WHEN GRIR_NUMERO_ORDEN_SERVICIO &lt;&gt; 'NO DISPONIBLE' THEN GRIR_NUMERO_ORDEN_SERVICIO&#xA;&#x9;WHEN GRIR_VALOR_RECAUDAR &lt;&gt; 0 THEN 'PENDIENTE OS'&#xA;&#x9;ELSE 'NO DISPONIBLE' END&#xA;FROM TMP.GUIA_MASIVA AS GM WITH(NOLOCK) INNER JOIN  CTE&#xA;ON GM.G_NUMERO_GUIA = CTE.GUIA&#xA;&#xA;&#xA;&#xA;/*&#xA;WITH CTE(&#xA;GUIA,&#xA;ORDEN,&#xA;VALOR&#xA;)AS(&#xA;SELECT &#xA;G_NUMERO_GUIA,&#xA;GRIR_NUMERO_ORDEN_SERVICIO,GRIR_VALOR_RECAUDAR&#xA;FROM TMP.GUIA_MASIVA WITH(NOLOCK)&#xA;)&#xA;UPDATE TMP.GUIA_MASIVA &#xA;SET GRIR_ESTADO_RECAUDO = &#xA;CASE &#xA;WHEN GRIR_NUMERO_ORDEN_SERVICIO &lt;&gt; 'NO DISPONIBLE' THEN GRIR_NUMERO_ORDEN_SERVICIO&#xA;WHEN GRIR_VALOR_RECAUDAR &lt;&gt; 0 THEN 'PENDIENTE OS'&#xA;ELSE 'NO DISPONIBLE' END&#xA;FROM TMP.GUIA_MASIVA WITH(NOLOCK), CTE&#xA;*/" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\PASO 30 NUEVOS CAMPOS\PASO 30 20 RESP INC - CUMPLE DEPURADA"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:Disabled="True"
          DTS:DTSID="{FDCF09B1-4CC9-4D15-918F-8C7507A19295}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="PASO 30 20 RESP INC - CUMPLE DEPURADA"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="1">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="WITH CTE(&#xA;GUIA,&#xA;RESP_DEPU&#xA;)AS(&#xA;SELECT  CLI.NUMERO_GUIA, TNO.RESP&#xA;FROM  LOG.DETALLE_NOVEDAD_DIARIA DETND WITH(NOLOCK)&#xA;INNER JOIN LOG.DOCUMENTOS_NOVEDAD_DIARIA DOCND WITH(NOLOCK)&#xA;ON DOCND.ID_PAIS_UNO = DETND.ID_PAIS_UNO&#xA;AND DOCND.ID_CIUDAD_UNO = DETND.ID_CIUDAD_UNO&#xA;INNER JOIN LOG.NOVEDAD_DIARIA ND WITH(NOLOCK)&#xA;ON ND.ID_PAIS_UNO = DETND.ID_PAIS_UNO&#xA;AND ND.ID_CIUDAD_UNO = DETND.ID_CIUDAD_UNO&#xA;INNER JOIN PAR.CLIECTVO_DEPU_NOVE TNO WITH(NOLOCK)&#xA;ON ND.ID_TIPO_NOVEDAD = TNO.ID_TIPO_NOVEDAD&#xA;INNER JOIN TMP.GUIA_MASIVA_16 CLI WITH(NOLOCK)&#xA;ON DOCND.ID_PROCESO = CLI.ID_PROCESO&#xA;AND DOCND.NUMERO_MOVIMI = CLI.NUMERO_MOVIMI&#xA;AND DOCND.CONSECUT_MOVIMI = CLI.CONSECUT_MOVIMI&#xA;AND DETND.PLACA_VEHICULO_DOCU = CLI.PLACA_VEHICULO_DOCU&#xA;WHERE DETND.FECHA_NOVEDAD = DOCND.FECHA_NOVEDAD&#xA;AND DETND.FECHA_NOVEDAD = ND.FECHA_NOVEDAD&#xA;)&#xA;UPDATE TMP.GUIA_MASIVA &#xA;SET CUMPLE_TE_DEPURADA = CASE WHEN RESP_DEPU IN ('C','E') THEN 'SI' ELSE 'NO' END,&#xA;RES_INCU = ISNULL(CTE.RESP_DEPU,'NO')&#xA;FROM TMP.GUIA_MASIVA T WITH(NOLOCK),CTE&#xA;WHERE CTE.GUIA = T.G_NUMERO_GUIA" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
