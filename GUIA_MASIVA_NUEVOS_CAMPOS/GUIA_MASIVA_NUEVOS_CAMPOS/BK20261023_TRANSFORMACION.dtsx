                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=15.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">WITH GUIA_MASIVA_20 AS (

SELECT 
	 SE.[NUMERO_GUIA]
	,SE.[ID_PROCESO]
	,SE.[ID_CONCEPTO]
	,SE.[FECHA_HORA_MOVIMIENTO]
	,SE.[NUMERO_MOVIMI]
	,SE.[CONSECUT_MOVIMI]
	,D.PLACA_VEHICULO_DOCU
FROM
	[LOG].[SEGUIMIENTO_ENVIO] SE WITH(NOLOCK INDEX (IX_EGUIMIENTO_ENVIO_NUMERO_GUIA_V3))
INNER JOIN 
	LOG.DOCUMENTOS D WITH(NOLOCK)
ON 
	SE.ID_PROCESO = D.ID_PROCESO 
AND 
	SE.NUMERO_MOVIMI = D.NUMERO_MOVIMI 
AND 
	SE.CONSECUT_MOVIMI = D.CONSECUT_MOVIMI

INNER JOIN  
	[TMP].[GUIA_MASIVA] TMP WITH(NOLOCK)
ON
	SE.NUMERO_GUIA = TMP.G_NUMERO_GUIA
),
-----------------------------
CTE
(
	 ID
	,[NUMERO_GUIA]
	,[ID_PROCESO]
	,[ID_CONCEPTO]
	,[FECHA_HORA_MOVIMIENTO]
	,[NUMERO_MOVIMI]
	,[CONSECUT_MOVIMI]
	,[PLACA_VEHICULO_DOCU]
)
AS
(
	SELECT 
		 ROW_NUMBER() OVER(PARTITION BY [ID_PROCESO], [NUMERO_MOVIMI], [CONSECUT_MOVIMI], [NUMERO_GUIA] ORDER BY [FECHA_HORA_MOVIMIENTO]) ID
		,[NUMERO_GUIA]
		,[ID_PROCESO]
		,[ID_CONCEPTO]
		,[FECHA_HORA_MOVIMIENTO]
		,[NUMERO_MOVIMI]
		,[CONSECUT_MOVIMI]
		,PLACA_VEHICULO_DOCU
	FROM 
		GUIA_MASIVA_20 WITH(NOLOCK)
)

SELECT
	 [NUMERO_GUIA]
	,[ID_PROCESO]
	,[ID_CONCEPTO]
	,[FECHA_HORA_MOVIMIENTO]
	,[NUMERO_MOVIMI]
	,[CONSECUT_MOVIMI]
	,PLACA_VEHICULO_DOCU
FROM
	CTE
WHERE
	ID = 1</property>
