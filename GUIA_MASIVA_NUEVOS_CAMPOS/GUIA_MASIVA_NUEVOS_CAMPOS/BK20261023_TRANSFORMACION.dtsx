    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{4CF5EDFD-1F15-4630-B8B3-CA8990351365}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot; INSERT INTO &#xA;&#x9;[TMP].[GUIA_MASIVA_01]&#xA;(&#xA;&#x9; [NUMERO_GUIA]&#xA;&#x9;,[NUMERO_PIEZAS]&#xA;&#x9;,[FECHA_ENVIO]&#xA;&#x9;,[ID_TIEMPO]&#xA;&#x9;,[ID_PRODUCTO]&#xA;&#x9;,[DIRECCION_DESTINA_GUIA]&#xA;&#x9;,[ID_CLIENTE]&#xA;&#x9;,[ID_ESTADOENVIO]&#xA;&#x9;,[ID_CIUDAD_ORIGEN]&#xA;&#x9;,[ID_CIUDAD_DESTINO]&#xA;&#x9;,[ID_PAIS_UBICACION]&#xA;&#x9;,[ID_CIUDAD_UBICACION]&#xA;&#x9;,[ID_DIVISION_UBICACION]&#xA;&#x9;,[VALOR_DECLARADO_GUIA]&#xA;&#x9;,[FECHA_EXTRACCION_DW]&#xA;)&#xA;SELECT&#xA;&#x9; [NUMERO_GUIA]&#xA;&#x9;,[NUMERO_PIEZAS]&#xA;&#x9;,[FECHA_ENVIO]&#xA;&#x9;,[ID_TIEMPO]&#xA;&#x9;,[ID_PRODUCTO]&#xA;&#x9;,[DIRECCION_DESTINA_GUIA]&#xA;&#x9;,[ID_CLIENTE]&#xA;&#x9;,[ID_ESTADOENVIO]&#xA;&#x9;,[ID_CIUDAD_ORIGEN]&#xA;&#x9;,[ID_CIUDAD_DESTINO]&#xA;&#x9;,[ID_PAIS_UBICACION]&#xA;&#x9;,[ID_CIUDAD_UBICACION]&#xA;&#x9;,[ID_DIVISION_UBICACION]&#xA;&#x9;,[VALOR_DECLARADO_GUIA]&#xA;&#x9;,[FECHA_EXTRACCION_DW]&#xA;FROM LOG.GUIAS WITH(NOLOCK)&#xA;WHERE   FECHA_MODIFICACION_DG&#xA;&#x9;BETWEEN   '&quot;+ @[User::STR_MesInicial] +&quot;'    AND  '&quot;+ @[User::STR_MesFinal] +&quot;'&#xA;OPTION(RECOMPILE) ;&#xA;&quot;"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="TSQL_Obtener_Guias">
      <DTS:VariableValue
        DTS:DataType="8"> INSERT INTO 
	[TMP].[GUIA_MASIVA_01]
(
	 [NUMERO_GUIA]
	,[NUMERO_PIEZAS]
	,[FECHA_ENVIO]
	,[ID_TIEMPO]
	,[ID_PRODUCTO]
	,[DIRECCION_DESTINA_GUIA]
	,[ID_CLIENTE]
	,[ID_ESTADOENVIO]
	,[ID_CIUDAD_ORIGEN]
	,[ID_CIUDAD_DESTINO]
	,[ID_PAIS_UBICACION]
	,[ID_CIUDAD_UBICACION]
	,[ID_DIVISION_UBICACION]
	,[VALOR_DECLARADO_GUIA]
	,[FECHA_EXTRACCION_DW]
)
SELECT
	 [NUMERO_GUIA]
	,[NUMERO_PIEZAS]
	,[FECHA_ENVIO]
	,[ID_TIEMPO]
	,[ID_PRODUCTO]
	,[DIRECCION_DESTINA_GUIA]
	,[ID_CLIENTE]
	,[ID_ESTADOENVIO]
	,[ID_CIUDAD_ORIGEN]
	,[ID_CIUDAD_DESTINO]
	,[ID_PAIS_UBICACION]
	,[ID_CIUDAD_UBICACION]
	,[ID_DIVISION_UBICACION]
	,[VALOR_DECLARADO_GUIA]
	,[FECHA_EXTRACCION_DW]
FROM LOG.GUIAS WITH(NOLOCK)
WHERE   FECHA_MODIFICACION_DG
	BETWEEN   '2026-10-18'    AND  '2026-10-24'
OPTION(RECOMPILE) ;
</DTS:VariableValue>
    </DTS:Variable>
  </DTS:Variables>
