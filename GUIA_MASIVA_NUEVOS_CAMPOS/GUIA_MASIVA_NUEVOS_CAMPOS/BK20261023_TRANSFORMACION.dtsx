                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=15.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT
     G.NUMERO_GUIA
	,T.ID_EST_TAREA AS TAR_ID_ESTADO_TAREA
    ,CASE WHEN T.ID_EST_TAREA = 1 THEN 'ABIERTA' ELSE 'CERRADA' END TAR_ESTADO_TAREA
FROM
    GUIAS G WITH(NOLOCK)
INNER JOIN
    TAREAS T WITH(NOLOCK)
ON
    CONVERT(CHAR(20),G.NUMERO_GUIA) = T.NUMERO_DOCPROBLEMA
WHERE
	FECHA_MODIFICACION_DG
	BETWEEN 
	?
    AND 
	?</property>
