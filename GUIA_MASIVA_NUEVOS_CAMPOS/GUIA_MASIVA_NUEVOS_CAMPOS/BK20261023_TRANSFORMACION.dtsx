          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="/*25Sep2022 se crea codigo para optimizar o insertar los datos de dirección general, del siguiente paquete se elimina DG*/&#xA;&#xA;&#xA;INSERT INTO [TMP].[GUIA_MASIVA_14]&#xA;           ([G_NUMERO_GUIA]&#xA;           ,[ID_PROCESO]&#xA;           ,[NUMERO_MOVIMI]&#xA;           ,[CONSECUT_MOVIMI]&#xA;           ,[SE_ID_ULTI]&#xA;           ,[ID_CIUDAD_DESTINO]&#xA;           ,[ID_CIUDAD_DIVISION_ORIGEN]&#xA;           ,[ID_TIPO_ZONA_URBA]&#xA;           ,[ID_ZONA_URBA]&#xA;           ,[ID_CIUDAD_ZONA_URBA]&#xA;           ,[FECHA_MODIFICACION])&#xA;SELECT &#xA;&#x9;[G_NUMERO_GUIA], &#xA;&#x9;[ID_PROCESO], &#xA;&#x9;[NUMERO_MOVIMI], &#xA;&#x9;[CONSECUT_MOVIMI], &#xA;&#x9;[SE_ID_ULTI], &#xA;&#x9;[ID_CIUDAD_DESTINO], &#xA;&#x9;[ID_CIUDAD_DIVISION_ORIGEN], &#xA;&#x9;[ID_TIPO_ZONA_URBA], &#xA;&#x9;[ID_ZONA_URBA], &#xA;&#x9;[ID_CIUDAD_ZONA_URBA], &#xA;&#x9;[FECHA_MODIFICACION]&#xA;FROM [TMP].[GUIA_MASIVA_14_DG] WITH(NOLOCK)&#xA; GO &#xA;&#xA;&#xA;INSERT INTO [TMP].[GUIA_MASIVA_14]&#xA;           ([G_NUMERO_GUIA]&#xA;           ,[ID_PROCESO]&#xA;           ,[NUMERO_MOVIMI]&#xA;           ,[CONSECUT_MOVIMI]&#xA;           ,[SE_ID_ULTI]&#xA;           ,[ID_CIUDAD_DESTINO]&#xA;           ,[ID_CIUDAD_DIVISION_ORIGEN]&#xA;           ,[ID_TIPO_ZONA_URBA]&#xA;           ,[ID_ZONA_URBA]&#xA;           ,[ID_CIUDAD_ZONA_URBA]&#xA;           ,[FECHA_MODIFICACION])&#xA;SELECT &#xA;&#x9;[G_NUMERO_GUIA], &#xA;&#x9;[ID_PROCESO], &#xA;&#x9;[NUMERO_MOVIMI], &#xA;&#x9;[CONSECUT_MOVIMI], &#xA;&#x9;[SE_ID_ULTI], &#xA;&#x9;[ID_CIUDAD_DESTINO], &#xA;&#x9;[ID_CIUDAD_DIVISION_ORIGEN], &#xA;&#x9;[ID_TIPO_ZONA_URBA], &#xA;&#x9;[ID_ZONA_URBA], &#xA;&#x9;[ID_CIUDAD_ZONA_URBA], &#xA;&#x9;[FECHA_MODIFICACION]&#xA;FROM [TMP].[GUIA_MASIVA_14_BOGO] WITH(NOLOCK)" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\PASO 10 DOCUMENTOS ULTI MOVI\PASO 10 03 QUITAR DUPLICADOS"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{33C5FBF0-83F9-489D-92D9-5DB3445BF11A}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="PASO 10 03 QUITAR DUPLICADOS"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="WITH CTE&#xA;(&#xA;&#x9; ID&#xA;&#x9;,[G_NUMERO_GUIA]&#xA;&#x9;,[ID_PROCESO]&#xA;&#x9;,[NUMERO_MOVIMI]&#xA;&#x9;,[CONSECUT_MOVIMI]&#xA;&#x9;,[SE_ID_ULTI]&#xA;&#x9;,[ID_CIUDAD_DESTINO]&#xA;&#x9;,[ID_CIUDAD_DIVISION_ORIGEN]&#xA;&#x9;,[ID_TIPO_ZONA_URBA]&#xA;&#x9;,[ID_ZONA_URBA]&#xA;&#x9;,[ID_CIUDAD_ZONA_URBA]&#xA;&#x9;,[FECHA_MODIFICACION]&#xA;)&#xA;&#x9;AS&#xA;&#x9;(&#xA;&#x9;&#x9;SELECT &#xA;&#x9;&#x9;&#x9; ROW_NUMBER() OVER(PARTITION BY [G_NUMERO_GUIA], [SE_ID_ULTI]  ORDER BY [FECHA_MODIFICACION] DESC) ID&#xA;&#x9;&#x9;&#x9;,[G_NUMERO_GUIA]&#xA;&#x9;&#x9;&#x9;,[ID_PROCESO]&#xA;&#x9;&#x9;&#x9;,[NUMERO_MOVIMI]&#xA;&#x9;&#x9;&#x9;,[CONSECUT_MOVIMI]&#xA;&#x9;&#x9;&#x9;,[SE_ID_ULTI]&#xA;&#x9;&#x9;&#x9;,[ID_CIUDAD_DESTINO]&#xA;&#x9;&#x9;&#x9;,[ID_CIUDAD_DIVISION_ORIGEN]&#xA;&#x9;&#x9;&#x9;,[ID_TIPO_ZONA_URBA]&#xA;&#x9;&#x9;&#x9;,[ID_ZONA_URBA]&#xA;&#x9;&#x9;&#x9;,[ID_CIUDAD_ZONA_URBA]&#xA;&#x9;&#x9;&#x9;,[FECHA_MODIFICACION]&#xA;&#x9;&#x9;FROM &#xA;&#x9;&#x9;&#x9;[TMP].[GUIA_MASIVA_14] WITH(NOLOCK)&#xA;&#x9;)&#xA;INSERT INTO &#xA;&#x9;TMP.GUIA_MASIVA_15&#xA;(&#xA;&#x9;&#x9;[G_NUMERO_GUIA]&#xA;&#x9;&#x9;,[ID_PROCESO]&#xA;&#x9;&#x9;,[NUMERO_MOVIMI]&#xA;&#x9;&#x9;,[CONSECUT_MOVIMI]&#xA;&#x9;&#x9;,[SE_ID_ULTI]&#xA;&#x9;&#x9;,[ID_CIUDAD_DESTINO]&#xA;&#x9;&#x9;,[ID_CIUDAD_DIVISION_ORIGEN]&#xA;&#x9;&#x9;,[ID_TIPO_ZONA_URBA]&#xA;&#x9;&#x9;,[ID_ZONA_URBA]&#xA;&#x9;&#x9;,[ID_CIUDAD_ZONA_URBA]&#xA;&#x9;&#x9;,[FECHA_MODIFICACION]&#xA;)&#xA;SELECT&#xA;&#x9;  [G_NUMERO_GUIA]&#xA;      ,[ID_PROCESO]&#xA;      ,[NUMERO_MOVIMI]&#xA;      ,[CONSECUT_MOVIMI]&#xA;      ,[SE_ID_ULTI]&#xA;      ,[ID_CIUDAD_DESTINO]&#xA;      ,[ID_CIUDAD_DIVISION_ORIGEN]&#xA;      ,[ID_TIPO_ZONA_URBA]&#xA;      ,[ID_ZONA_URBA]&#xA;      ,[ID_CIUDAD_ZONA_URBA]&#xA;      ,[FECHA_MODIFICACION]&#xA;FROM&#xA;&#x9;CTE&#xA;WHERE&#xA;&#x9;ID = 1&#xA;&#xA;--ORDER  BY  &#xA;--&#x9; [G_NUMERO_GUIA]&#xA;--&#x9;,[FECHA_MODIFICACION]" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
      </DTS:Executables>
