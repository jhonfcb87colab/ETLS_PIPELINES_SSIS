              SQLTask:SqlStatementSource="DELETE FROM TMP.GUIA_MASIVA_RED_OPERATIVA_RUTA_CU WHERE &#xA;ID_RUTA IN (  SELECT  [ID_RUTA]&#xA;  FROM [SIG_COL_LOGISTICA_DW].[DIM].[RED_OPERATIVA_RUTA] WITH(NOLOCK)&#xA;  WHERE [FECHA_MODIFICACION] &gt; CONVERT(DATE,DATEADD(DD,-5,GETDATE())))" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
