    <DTS:Executable
      DTS:refId="Package\PASO 30 NUEVOS CAMPOS"
      DTS:CreationName="STOCK:SEQUENCE"
      DTS:Description="Sequence Container"
      DTS:DTSID="{F82F5AED-B374-486B-B961-CFC227032900}"
      DTS:ExecutableType="STOCK:SEQUENCE"
      DTS:LocaleID="-1"
      DTS:ObjectName="PASO 30 NUEVOS CAMPOS">
      <DTS:Variables />
      <DTS:LoggingOptions
        DTS:FilterKind="0" />
      <DTS:Executables>
        <DTS:Executable
          DTS:refId="Package\PASO 30 NUEVOS CAMPOS\ESTADO RECOLECCION"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{9B237119-26E0-4D9B-A431-119AA1D34A1A}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="ESTADO RECOLECCION"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="WITH CTE (&#xA;&#x9;ID,&#xA;&#x9;G_NUMERO_GUIA,&#xA;&#x9;NOMBRE_ESTADO&#xA;) AS (&#xA;SELECT&#xA;ROW_NUMBER() OVER(PARTITION BY GR.NUMERO_GUIA ORDER BY GR.FECHA_MODIFICACION DESC) ID,&#xA;GM.G_NUMERO_GUIA,&#xA;ISNULL(PAR.NOMBRE_ESTADO_SOLICITUD,'NO DISPONIBLE')&#xA;--PAR.NOMBRE_ESTADO_SOLICITUD&#xA;&#x9;FROM TMP.GUIA_MASIVA AS GM (NOLOCK)&#xA;&#x9;LEFT JOIN LOG.GUIAS_POR_SOLICITUDRECOLECCION AS GR (NOLOCK)&#xA;&#x9;&#x9;ON GM.G_NUMERO_GUIA = GR.NUMERO_GUIA&#xA;&#x9;LEFT JOIN PAR.ESTADOS_SOLICITUDES_RECOLECCION AS PAR&#xA;&#x9;&#x9;ON GR.ID_ESTADO_RECOLECCION_GUIA = PAR.ID_ESTADO_SOLICITUD&#xA;)&#xA;/************/&#xA;UPDATE TMP&#xA;SET TMP.ESTA_RECOLECCION = CTE.NOMBRE_ESTADO&#xA;FROM TMP.GUIA_MASIVA AS TMP WITH(NOLOCK) INNER JOIN CTE&#xA;ON TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA AND CTE.ID=1" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\PASO 30 NUEVOS CAMPOS\PASO 30 1 VALOR RECAUDADO"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{5DE15216-DD1A-41BF-9629-AD5960B0E6B9}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="PASO 30 1 VALOR RECAUDADO"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="&#xA;UPDATE TMP&#xA;SET TMP.GRIR_VALOR_RECAUDADO = ISNULL(L.VALOR_RECAUDADO,-888)&#xA;FROM TMP.GUIA_MASIVA AS TMP WITH(NOLOCK)&#xA;INNER JOIN LOG.GUIA_RECAUDO_INFORMACION_RECAUDO AS L WITH(NOLOCK) &#xA;ON TMP.G_NUMERO_GUIA = L.NUMERO_GUIA &#xA;&#xA;/* &#xA;WITH CTE(&#xA;&#x9;GUIA,&#xA;&#x9;VALOR&#xA;) AS (&#xA;&#x9;SELECT &#xA;&#x9;&#x9;NUMERO_GUIA,&#xA;&#x9;&#x9;VALOR_RECAUDADO&#xA;&#x9;FROM LOG.GUIA_RECAUDO_INFORMACION_RECAUDO WITH(NOLOCK)&#xA;)&#xA;UPDATE TMP.GUIA_MASIVA&#xA;SET GRIR_VALOR_RECAUDADO = ISNULL(VALOR,-888)&#xA;FROM TMP.GUIA_MASIVA WITH(NOLOCK), CTE&#xA;WHERE GUIA = G_NUMERO_GUIA&#xA;*/" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\PASO 30 NUEVOS CAMPOS\PASO 30 10 PESO SIS-RET"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{ECE1F9CB-55CE-4E67-A92D-F04F0A995CFF}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="PASO 30 10 PESO SIS-RET"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="---consulta retail &#xA;UPDATE TMP&#xA;&#x9;SET TMP.PESO_FISICO_R = ISNULL(RTW.BILLEDWEIGHT ,-888) -- PESO&#xA;FROM TMP.GUIA_MASIVA AS TMP WITH(NOLOCK) &#xA;INNER JOIN RTW.GUIDE AS RTW WITH(NOLOCK, INDEX(IDX_Number) )&#xA;&#x9;ON RTW.NUMBER = TMP.G_NUMERO_GUIA&#xA;OPTION(RECOMPILE, OPTIMIZE FOR UNKNOWN, MAXDOP 4);&#xA;&#xA;GO&#xA;&#xA;---consulta sisclinet&#xA;WITH CTE(&#xA;&#x9;GUIA,&#xA;&#x9;PESO,LARGO,ANCHO,ALTO&#xA;) AS  (&#xA;&#x9;SELECT SE.NUM_GUIA,SEU.Num_Peso,SEU.Num_Largo,SEU.Num_Ancho,SEU.Num_Alto&#xA;&#x9;FROM SCN.SERT_ENVIO AS SE WITH(NOLOCK)&#xA;&#x9;INNER JOIN SCN.SERT_ENVIOSUNIDADESEMPAQUE AS SEU WITH(NOLOCK) ON SE.Ide_Envio =  SEU.Ide_Envio&#xA;&#x9;INNER JOIN TMP.GUIA_MASIVA AS TMP WITH(NOLOCK) ON TMP.G_NUMERO_GUIA = Num_Guia&#xA;)&#xA;UPDATE TMP&#xA;&#x9;SET TMP.PESO_FISICO_R = ISNULL(PESO,-888),&#xA;&#x9;&#x9;TMP.DIMENSIONES_R = CONCAT(LARGO , '*' , ANCHO , '*' , ALTO, ' ',(LARGO*ANCHO*ALTO), 'CM3')&#xA;FROM TMP.GUIA_MASIVA AS TMP WITH(NOLOCK)&#xA;INNER JOIN CTE&#xA;&#x9;ON G_NUMERO_GUIA = GUIA&#xA;OPTION(RECOMPILE, OPTIMIZE FOR UNKNOWN, MAXDOP 4);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\PASO 30 NUEVOS CAMPOS\PASO 30 11 DIMENSIONES R"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{B806AEAB-1307-48A1-936A-E627F343B4B3}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="PASO 30 11 DIMENSIONES R"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="UPDATE TMP&#xA;&#x9;SET TMP.DIMENSIONES_R = CONCAT(RS.Length , '*' , RS.WIDTH , '*' , RS.HEIGHT, ' ',(RS.LENGTH*RS.WIDTH*RS.HEIGHT), 'CM3')&#xA;FROM TMP.GUIA_MASIVA AS TMP WITH(NOLOCK)&#xA;INNER JOIN RTW.SHIPPING AS RS WITH(NOLOCK)&#xA;&#x9;ON TMP.G_NUMERO_GUIA = RS.GuideId&#xA;&#xA;/*&#xA;WITH CTE(&#xA;&#x9;GUIA,&#xA;&#x9;ANCHO,&#xA;&#x9;LARGO,&#xA;&#x9;ALTO&#xA;) AS (&#xA;&#x9;SELECT &#xA;&#x9;GUIDEID,&#xA;&#x9;WIDTH, &#xA;&#x9;LENGTH,&#xA;&#x9;HEIGHT&#xA;FROM RTW.SHIPPING WITH(NOLOCK)&#xA;)&#xA;UPDATE TMP&#xA;&#x9;SET TMP.DIMENSIONES_R = &#xA;SELECT &#x9;CONCAT(LARGO , '*' , ANCHO , '*' , ALTO, ' ',(LARGO*ANCHO*ALTO), 'CM3')&#xA;FROM TMP.GUIA_MASIVA AS TMP WITH(NOLOCK)&#xA;INNER JOIN CTE&#xA;&#x9;ON GUIA = G_NUMERO_GUIA&#xA;*/" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\PASO 30 NUEVOS CAMPOS\PASO 30 12 FECHA ING RET WEB"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{1EE9AFAF-DF81-40FE-A0E6-4515F4A3BDC7}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="PASO 30 12 FECHA ING RET WEB"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="WITH CTE(&#xA;ID,&#xA;GUIA,&#xA;PROCESO,&#xA;CONCEPTO,&#xA;FECHA&#xA;)AS(&#xA;SELECT ROW_NUMBER()OVER(PARTITION BY NUMERO_GUIA ORDER BY FECHA_HORA_MOVIMIENTO ) AS ID,&#xA;NUMERO_GUIA,ID_PROCESO,ID_CONCEPTO,FECHA_HORA_MOVIMIENTO &#xA;FROM LOG.SEGUIMIENTO_ENVIO SE WITH(NOLOCK)&#xA;INNER JOIN TMP.GUIA_MASIVA WITH(NOLOCK) ON NUMERO_GUIA = G_NUMERO_GUIA&#xA;WHERE ID_PROCESO IN (31,32)&#xA;)&#xA;UPDATE TMP.GUIA_MASIVA&#xA;SET FECHA_RTW_INGRESO_MOV = CTE.FECHA&#xA;FROM TMP.GUIA_MASIVA T WITH(NOLOCK),CTE&#xA;WHERE CTE.GUIA = T.G_NUMERO_GUIA&#xA;AND ID = 1" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\PASO 30 NUEVOS CAMPOS\PASO 30 12 PESO E"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{E8E6B4AB-B24F-4DFF-AEAD-8BE6A12DD1FD}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="PASO 30 12 PESO E"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="UPDATE TMP&#xA;&#x9;SET TMP.DIMENSIONES_E = CONCAT(G.LARGO_ENVIO,'*',G.ALTO_ENVIO,'*', G.ANCHO_ENVIO,' ', &#xA;&#x9;&#x9;(G.LARGO_ENVIO*G.ANCHO_ENVIO*G.ALTO_ENVIO), 'CM3')&#xA;&#x9;&#x9;, TMP.PESO_FISICO_E = G.PESO_FISICO_OPERA /*PESO*/&#xA;FROM TMP.GUIA_MASIVA AS TMP WITH(NOLOCK, INDEX(IX_GUIA_MASIVA_TMP)) &#xA;INNER JOIN LOG.GUIAS AS G WITH(NOLOCK, INDEX(IX_GUIAS_V2) )&#xA;&#x9;ON TMP.G_NUMERO_GUIA = G.NUMERO_GUIA&#xA;OPTION(RECOMPILE, OPTIMIZE FOR UNKNOWN, MAXDOP 4);&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;/*&#xA;WITH CTE(&#xA;&#x9;GUIA,&#xA;&#x9;PESO&#xA;) AS (&#xA;&#x9;SELECT NUMERO_GUIA,&#xA;&#x9;PESO_FISICO_OPERA FROM LOG.GUIAS WITH(NOLOCK)&#xA;)&#xA;UPDATE TMP.GUIA_MASIVA&#xA;SET PESO_FISICO_E = PESO&#xA;FROM TMP.GUIA_MASIVA WITH(NOLOCK), CTE&#xA;WHERE GUIA = G_NUMERO_GUIA&#xA;*/" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\PASO 30 NUEVOS CAMPOS\PASO 30 12 RET ING WEB"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{90E23571-C8EE-4797-A7B3-F55B549D6F07}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="PASO 30 12 RET ING WEB"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="UPDATE TMP.GUIA_MASIVA&#xA;SET RTW_INGRESO = CASE WHEN FECHA_RTW_INGRESO_MOV &lt;&gt; '1900-01-01' AND (SE_CONC_SZU = 'EMPRESARIO SATELITE ENTREGA EN DOMICILIO' OR &#xA;SE_CONC_SZU = 'EMPRESARIO SATELITE ENTREGA EN OFICINA' OR SE_CONC_SZU = 'EMPRESARIO SATELITE C.O.D. Y/O LPC') THEN 'SI' ELSE&#xA;CASE WHEN (SE_CONC_SZU = 'EMPRESARIO SATELITE ENTREGA EN DOMICILIO' OR &#xA;SE_CONC_SZU = 'EMPRESARIO SATELITE ENTREGA EN OFICINA' OR SE_CONC_SZU = 'EMPRESARIO SATELITE C.O.D. Y/O LPC') AND FECHA_RTW_INGRESO_MOV = '1900-01-01' THEN 'NO'&#xA;ELSE 'NO DISPONIBLE' END END &#xA;FROM TMP.GUIA_MASIVA WITH(NOLOCK)" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\PASO 30 NUEVOS CAMPOS\PASO 30 13 DIMENSIONES E"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:Disabled="True"
          DTS:DTSID="{6C5E103E-5A13-49FF-B205-0C2F06EDD08A}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="PASO 30 13 DIMENSIONES E"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="&#xA;UPDATE TMP&#xA;&#x9;SET TMP.DIMENSIONES_E = CONCAT(G.LARGO_ENVIO,'*',G.ALTO_ENVIO,'*', G.ANCHO_ENVIO,' ', &#xA;&#x9;&#x9;(G.LARGO_ENVIO*G.ANCHO_ENVIO*G.ALTO_ENVIO), 'CM3')&#xA;FROM TMP.GUIA_MASIVA AS TMP WITH(NOLOCK) &#xA;INNER JOIN LOG.GUIAS AS G WITH(NOLOCK)&#xA;&#x9;ON TMP.G_NUMERO_GUIA = G.NUMERO_GUIA&#xA;&#xA;/*&#xA;WITH CTE(&#xA;&#x9;GUIA,&#xA;&#x9;LARGO,&#xA;&#x9;ALTO,&#xA;&#x9;ANCHO&#xA;)AS(&#xA;&#x9;SELECT NUMERO_GUIA,&#xA;&#x9;&#x9;LARGO_ENVIO,ALTO_ENVIO,ANCHO_ENVIO &#xA;&#x9;FROM LOG.GUIAS WITH(NOLOCK)&#xA;)&#xA;UPDATE TMP.GUIA_MASIVA&#xA;SET DIMENSIONES_E = CONCAT(LARGO,'*',ALTO,'*', ANCHO,' ', (LARGO*ANCHO*ALTO), 'CM3')&#xA;FROM TMP.GUIA_MASIVA WITH(NOLOCK), CTE&#xA;WHERE GUIA = G_NUMERO_GUIA&#xA;*/" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\PASO 30 NUEVOS CAMPOS\PASO 30 15 EMPRESARIO"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{8CDC9133-337C-4D97-8E4F-31DB3669FBFF}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="PASO 30 15 EMPRESARIO"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="WITH CTE(&#xA;GUIA,EMP)&#xA;AS(&#xA;SELECT G_NUMERO_GUIA, CONVERT(VARCHAR(60),CONVERT(VARCHAR(12), CASE WHEN LEN(DI.ID_CIUDAD) &lt; 3 AND LEN(DI.ID_DIVISION) &lt; 3 THEN REPLICATE('0', &#xA;                         3 - datalength(rtrim(DI.[ID_CIUDAD]))) + rtrim(DI.[ID_CIUDAD]) + REPLICATE('0', 3 - datalength(rtrim(DI.[ID_DIVISION]))) + Ltrim(Rtrim(DI.ID_DIVISION)) &#xA;                         WHEN LEN(DI.ID_CIUDAD) &lt; 3 AND LEN(DI.ID_DIVISION) &gt;= 3 THEN REPLICATE('0', 3 - datalength(rtrim(DI.[ID_CIUDAD]))) + rtrim(DI.[ID_CIUDAD]) &#xA;                         + Ltrim(Rtrim(DI.ID_DIVISION)) WHEN LEN(DI.ID_CIUDAD) &gt;= 3 AND LEN(DI.ID_DIVISION) &lt; 3 THEN rtrim(DI.[ID_CIUDAD]) + REPLICATE('0', &#xA;                         3 - datalength(rtrim(DI.[ID_DIVISION]))) + Ltrim(Rtrim(DI.ID_DIVISION)) ELSE Ltrim(Rtrim(DI.ID_CIUDAD)) + Ltrim(Rtrim(DI.ID_DIVISION)) END)  + ' - ' +&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9; NOMBRE_DIVISION )&#xA;FROM TMP.GUIA_MASIVA GM WITH(NOLOCK) &#xA;INNER JOIN LOG.SEGUIMIENTO_ENVIO SE WITH(NOLOCK) ON G_NUMERO_GUIA = NUMERO_GUIA&#xA;INNER JOIN LOG.DOCUMENTOS D WITH(NOLOCK) ON D.ID_PROCESO = SE.ID_PROCESO AND D.NUMERO_MOVIMI = SE.NUMERO_MOVIMI AND D.CONSECUT_MOVIMI = SE.CONSECUT_MOVIMI&#xA;INNER JOIN PAR.ZONASURBANAS ZU WITH(NOLOCK) ON ZU.ID_PAIS = D.ID_PAIS_ZONA_URBA AND ZU.ID_CIUDAD = D.ID_CIUDAD_ZONA_URBA AND ZU.ID_ZONA_URBA = D.ID_ZONA_URBA&#xA;INNER JOIN PAR.DIVISIONES DI WITH(NOLOCK) ON ZU.ID_PAIS_CANAL = DI.ID_PAIS AND ZU.ID_CIUDAD_CANAL = DI.ID_CIUDAD AND ZU.ID_CANAL = DI.ID_DIVISION&#xA;WHERE SE.ID_PROCESO IN (31,32)&#xA;)&#xA; UPDATE TMP.GUIA_MASIVA&#xA;SET EMPRESARIO = CTE.EMP &#xA;FROM TMP.GUIA_MASIVA T&#xA;INNER JOIN CTE ON CTE.GUIA = t.G_NUMERO_GUIA" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\PASO 30 NUEVOS CAMPOS\PASO 30 16 CARGAR RUTA REDOPE"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{2E9C03B6-8CA9-4D03-93CC-F82A19067198}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="PASO 30 16 CARGAR RUTA REDOPE"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="INSERT INTO [TMP].[GUIA_MASIVA_RUTA]&#xA;           ([ID_RUTA]&#xA;           ,[ID_PAIS_ORIGEN]&#xA;           ,[ID_CIUDAD_ORIGEN]&#xA;           ,[ID_PAIS_DESTINO]&#xA;           ,[ID_CIUDAD_DESTINO]&#xA;           ,[ID_TIEMPO]&#xA;           ,[ID_MEDTRANS]&#xA;           ,[ID_IMPEDANCIA]&#xA;           ,[ID_FILTRO_CRITICIDAD]&#xA;           ,[VALOR_FILTRO_CRITICIDAD]&#xA;           ,[VALOR_FILTRO_MODO_TRANSPORTE]&#xA;           ,[TOTAL_TIEMPO_OPERATIVO]&#xA;           ,[TOTAL_TIEMPO_OPERATIVO_REF]&#xA;           ,[TOTAL_DISTANCIA]&#xA;           ,[TOTAL_COSTO]&#xA;           ,[TOTAL_ID_CRITICIDAD]&#xA;           ,[TOTAL_ID_PESOCATEG]&#xA;           ,[LOGIN_EMPLEADO_MODIFICACION]&#xA;           ,[FECHA_MODIFICACION]&#xA;           ,[ID_ESTADO_RUTA]&#xA;           ,[ID_RUTA_NET]&#xA;           ,[TOTAL_TIEMPO_OPERATIVO_REF_CALCULO]&#xA;           ,[TOTAL_DISTANCIA_CALCULO]&#xA;           ,[LOGIN_MODIFICACION_MANUAL]&#xA;           ,[ID_CALCULO]&#xA;           ,[FECHA_CALCULO])&#xA;SELECT    ID_RUTA&#xA;, ID_PAIS_ORIGEN&#xA;, ID_CIUDAD_ORIGEN&#xA;, ID_PAIS_DESTINO&#xA;, ID_CIUDAD_DESTINO&#xA;, ID_TIEMPO&#xA;, ID_MEDTRANS&#xA;, ID_IMPEDANCIA&#xA;, ID_FILTRO_CRITICIDAD&#xA;, VALOR_FILTRO_CRITICIDAD&#xA;, VALOR_FILTRO_MODO_TRANSPORTE&#xA;, TOTAL_TIEMPO_OPERATIVO&#xA;, TOTAL_TIEMPO_OPERATIVO_REF&#xA;, TOTAL_DISTANCIA&#xA;, TOTAL_COSTO&#xA;, TOTAL_ID_CRITICIDAD&#xA;, TOTAL_ID_PESOCATEG&#xA;, LOGIN_EMPLEADO_MODIFICACION&#xA;, FECHA_MODIFICACION&#xA;, ID_ESTADO_RUTA&#xA;, ID_RUTA_NET&#xA;, TOTAL_TIEMPO_OPERATIVO_REF_CALCULO&#xA;, TOTAL_DISTANCIA_CALCULO&#xA;, LOGIN_MODIFICACION_MANUAL&#xA;--, FECHA_EXTRACCION_DW&#xA;, NULL AS ID_CALCULO&#xA;, NULL AS FECHA_CALCULO&#xA;FROM   SIG_COL_LOGISTICA_DW.TMP.RUTA WITH (NOLOCK)&#xA;OPTION(FAST 1)" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\PASO 30 NUEVOS CAMPOS\PASO 30 17 OBTENER INF REDOPE"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{94358E63-4388-4318-A5F0-2EDFEA48E8D8}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="PASO 30 17 OBTENER INF REDOPE"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="INSERT INTO TMP.GUIA_MASIVA_17 (&#xA;&#x9;G_NUMERO_GUIA,&#xA;&#x9;ID_PAIS_ORIGEN,&#xA;&#x9;ID_CIUDAD_ORIGEN,&#xA;&#x9;ID_PAIS_DESTINO,&#xA;&#x9;ID_CIUDAD_DESTINO,&#xA;&#x9;ID_TIEMPO,&#xA;&#x9;ID_MEDTRANS,&#xA;&#x9;T_ENTREGA_RED_OPE&#xA;)&#x9;&#xA;SELECT &#xA;&#x9;G.NUMERO_GUIA,&#xA;&#x9;G.ID_PAIS_ORIGEN,&#xA;&#x9;G.ID_CIUDAD_ORIGEN,&#xA;&#x9;G.ID_PAIS_DESTINO,&#xA;&#x9;G.ID_CIUDAD_DESTINO,&#xA;&#x9;G.ID_TIEMPO,&#xA;&#x9;G.ID_MEDTRANS,&#xA;&#x9;0 AS T_ENTREGA_RED_OPE &#xA;FROM TMP.GUIA_MASIVA AS TMP WITH(NOLOCK, INDEX(IX_GUIA_MASIVA_TMP))&#xA;INNER JOIN LOG.GUIAS AS G WITH(NOLOCK, INDEX(IX_GUIAS_V2)) &#xA;&#x9;ON TMP.G_NUMERO_GUIA = G.NUMERO_GUIA&#xA;OPTION(FAST 1)&#xA;&#xA;&#xA;&#xA;/*&#xA;WITH CTE(&#xA;NUMERO_GUIA,ID_PAIS_ORIGEN,ID_CIUDAD_ORIGEN,ID_PAIS_DESTINO,ID_CIUDAD_DESTINO,ID_TIEMPO,ID_MEDTRANS&#xA;)&#xA;AS(&#xA;SELECT &#xA;NUMERO_GUIA,G.ID_PAIS_ORIGEN,G.ID_CIUDAD_ORIGEN,G.ID_PAIS_DESTINO,G.ID_CIUDAD_DESTINO,G.ID_TIEMPO,G.ID_MEDTRANS&#xA;FROM TMP.GUIA_MASIVA WITH(NOLOCK)&#xA;INNER JOIN LOG.GUIAS G WITH(NOLOCK) ON G_NUMERO_GUIA = NUMERO_GUIA&#xA;)&#xA;INSERT INTO TMP.GUIA_MASIVA_17 &#xA;SELECT  *,0 AS T_ENTREGA_RED_OPE FROM CTE&#xA;*/" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\PASO 30 NUEVOS CAMPOS\PASO 30 18 REGLAS REDOPE"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{9313FEED-0B8C-47D8-AAF1-7F729230A2B1}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="PASO 30 18 REGLAS REDOPE"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="UPDATE G &#xA;&#x9;SET T_ENTREGA_RED_OPE = R.TOTAL_TIEMPO_OPERATIVO/1440&#xA;FROM TMP.GUIA_MASIVA_17 G  WITH(NOLOCK)&#xA;INNER JOIN TMP.GUIA_MASIVA_RUTA R   WITH(NOLOCK)&#xA;ON &#x9;R.ID_PAIS_ORIGEN = G.ID_PAIS_ORIGEN AND&#xA;&#x9;R.ID_CIUDAD_ORIGEN = G.ID_CIUDAD_ORIGEN AND&#xA;&#x9;R.ID_PAIS_DESTINO = G.ID_PAIS_DESTINO AND&#xA;&#x9;R.ID_CIUDAD_DESTINO = G.ID_CIUDAD_DESTINO AND&#xA;&#x9;R.ID_TIEMPO = G.ID_TIEMPO AND&#xA;&#x9;R.ID_MEDTRANS = G.ID_MEDTRANS&#xA;WHERE  G.ID_TIEMPO &lt;&gt; 2&#xA;&#xA;UPDATE G &#xA;&#x9;SET T_ENTREGA_RED_OPE = 0&#xA;FROM TMP.GUIA_MASIVA_17 G  WITH(NOLOCK)&#xA;WHERE  G.ID_TIEMPO = 2&#xA;&#xA;UPDATE G &#xA;&#x9;SET T_ENTREGA_RED_OPE = 1&#xA;FROM TMP.GUIA_MASIVA_17 G  WITH(NOLOCK)&#xA;WHERE &#x9;G.ID_PAIS_ORIGEN = G.ID_PAIS_DESTINO AND&#xA;&#x9;&#x9;G.ID_CIUDAD_ORIGEN = G.ID_CIUDAD_DESTINO&#xA;&#xA;UPDATE M&#xA;&#x9;SET T_ENTREGA_RED_OPE = T.T_ENTREGA_RED_OPE&#xA;FROM TMP.GUIA_MASIVA M  WITH(NOLOCK)&#xA;INNER JOIN TMP.GUIA_MASIVA_17 T  WITH(NOLOCK)&#xA;ON T.G_NUMERO_GUIA = M.G_NUMERO_GUIA&#xA;&#xA;&#xA;/*&#xA;UPDATE TMP.GUIA_MASIVA_17 &#xA;SET T_ENTREGA_RED_OPE = R.TOTAL_TIEMPO_OPERATIVO/1440&#xA;FROM TMP.GUIA_MASIVA_17 G  WITH(NOLOCK)&#xA;INNER JOIN TMP.GUIA_MASIVA_RUTA R ON &#xA;R.ID_PAIS_ORIGEN = G.ID_PAIS_ORIGEN AND&#xA;R.ID_CIUDAD_ORIGEN = G.ID_CIUDAD_ORIGEN AND&#xA;R.ID_PAIS_DESTINO = G.ID_PAIS_DESTINO AND&#xA;R.ID_CIUDAD_DESTINO = G.ID_CIUDAD_DESTINO AND&#xA;R.ID_TIEMPO = G.ID_TIEMPO AND&#xA;R.ID_MEDTRANS = G.ID_MEDTRANS&#xA;WHERE&#xA;G.ID_TIEMPO &lt;&gt; 2&#xA;&#xA;UPDATE TMP.GUIA_MASIVA_17 &#xA;SET T_ENTREGA_RED_OPE = 0&#xA;FROM TMP.GUIA_MASIVA_17 G  WITH(NOLOCK)&#xA;WHERE&#xA;G.ID_TIEMPO = 2&#xA;&#xA;UPDATE TMP.GUIA_MASIVA_17 &#xA;SET T_ENTREGA_RED_OPE = 1&#xA;FROM TMP.GUIA_MASIVA_17 G  WITH(NOLOCK)&#xA;WHERE &#xA;G.ID_PAIS_ORIGEN = G.ID_PAIS_DESTINO AND&#xA;G.ID_CIUDAD_ORIGEN = G.ID_CIUDAD_DESTINO&#xA;&#xA;UPDATE TMP.GUIA_MASIVA&#xA;SET T_ENTREGA_RED_OPE = T.T_ENTREGA_RED_OPE&#xA;FROM TMP.GUIA_MASIVA M INNER JOIN TMP.GUIA_MASIVA_17 T ON T.G_NUMERO_GUIA = M.G_NUMERO_GUIA&#xA;&#xA;*/" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
