      <DTS:Variables />
      <DTS:LoggingOptions
        DTS:FilterKind="0" />
      <DTS:Executables>
        <DTS:Executable
          DTS:refId="Package\PASO 04 OBTENER PROCESOS Y RECAUDO\PASO 04 01 GUIA_MASIVA_03_GR"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{28C51A77-E86A-499B-954B-DE348F8A828F}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="PASO 04 01 GUIA_MASIVA_03_GR"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="INSERT INTO  TMP.GUIA_MASIVA_03_GR (&#xA;&#x9; [GR_NUMERO_GUIA],&#xA;     [GR_ID_TIPO_COBRO]&#xA;) &#xA;&#x9;SELECT &#xA;&#x9;&#x9; GR.NUMERO_GUIA AS GR_NUMERO_GUIA&#xA;&#x9;&#x9;,CASE WHEN GR.ID_TIPO_COBRO = 2 THEN 'LPC' ELSE 'COD' END ID_TIPO_COBRO&#xA;&#x9;FROM  [LOG].[GUIA_RECAUDO] GR WITH (NOLOCK,INDEX(IX_NUMERO_GUIA))&#xA;&#x9;INNER JOIN  TMP.GUIA_MASIVA TMP WITH (NOLOCK, INDEX(IX_GUIA_MASIVA_TMP) )&#xA;&#x9;&#x9;ON GR.NUMERO_GUIA = TMP.G_NUMERO_GUIA" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\PASO 04 OBTENER PROCESOS Y RECAUDO\PASO 04 02 GUIA_MASIVA_04_GRINFR"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{1F1D420D-BFEE-4390-A536-EA856F5089F6}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="PASO 04 02 GUIA_MASIVA_04_GRINFR"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="1">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="INSERT INTO  TMP.GUIA_MASIVA_04_GRINFR  (&#xA;&#x9; IR_NUMERO_GUIA&#xA;&#x9;,IR_NUMERO_ORDEN_SERVICIO&#xA;&#x9;,IR_VALOR_X_RECAUDAR&#xA;)&#xA;&#x9;SELECT&#xA;&#x9;&#x9;IR.NUMERO_GUIA IR_NUMERO_GUIA&#xA;&#x9;&#x9;,ISNULL(CASE WHEN IR.NUMERO_ORDEN_SERVICIO = '' THEN NULL ELSE IR.NUMERO_ORDEN_SERVICIO END,'NO DISPONIBLE') AS IR_NUMERO_ORDEN_SERVICIO&#xA;&#x9;&#x9;,ISNULL(IR.VALOR_PRODUCTO,0) IR_VALOR_X_RECAUDAR&#xA;&#x9;FROM  LOG.GUIA_RECAUDO_INFORMACION_RECAUDO IR WITH(NOLOCK, INDEX(IX_NUMERO_GUIA)  )&#xA;&#x9;INNER JOIN  TMP.GUIA_MASIVA MA WITH(NOLOCK, INDEX(IX_GUIA_MASIVA_TMP)  )&#xA;&#x9;&#x9;ON &#x9;IR.NUMERO_GUIA = MA.G_NUMERO_GUIA&#x9;;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\PASO 04 OBTENER PROCESOS Y RECAUDO\PASO 04 03 GUIA_MASIVA_05_INFTBCL"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{7B72BE8B-CABC-453D-8104-5DE30EE355CC}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="PASO 04 03 GUIA_MASIVA_05_INFTBCL"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="2">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="INSERT INTO  TMP.GUIA_MASIVA_05_INFTBCL (&#xA;&#x9; TC_NUMERO_GUIA&#xA;&#x9;,TC_ID_PROCESO&#xA;)&#xA;&#x9;SELECT&#xA;&#x9;&#x9;TC.NUMERO_GUIA TC_NUMERO_GUIA&#xA;&#x9;&#x9;,ISNULL(TC.ID_PROCESO,-888) TC_ID_PROCESO&#xA;&#x9;FROM  LOG.GUIA_INFORMACION_ADICIONAL_TABLERO_CONTROL TC WITH(NOLOCK, INDEX(IX_NUMERO_GUIA) )&#xA;&#x9;INNER JOIN TMP.GUIA_MASIVA MA WITH(NOLOCK, INDEX(IX_GUIA_MASIVA_TMP)  )&#xA;&#x9;&#x9;ON TC.NUMERO_GUIA = MA.G_NUMERO_GUIA&#xA;;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\PASO 04 OBTENER PROCESOS Y RECAUDO\PASO 04 06 QUITAR DUPLICADOS"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{76C15EC3-AF6A-48F7-8D26-97CB35EF6DF8}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="PASO 04 06 QUITAR DUPLICADOS"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="3">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="/*Holman Estepa 25Sep22, Se crea este paquete para optimizar el ingreso de los datos de DG */&#xA;&#xA;/* ELIMINA CREA Y CREA INDEX A LA TABLA MASIVA 06*/&#xA;DROP TABLE IF EXISTS #GUIA_MASIVA06;&#xA;SELECT &#xA;&#x9; ROW_NUMBER() OVER(PARTITION BY  [NUMERO_GUIA], [ID_PROCESO], [NUMERO_MOVIMI], [CONSECUT_MOVIMI]  ORDER BY [FECHA_HORA_MOVIMIENTO] DESC ) ID&#xA;&#x9;,[NUMERO_GUIA]&#xA;&#x9;,[ID_PROCESO]&#xA;&#x9;,CASE WHEN ISNULL(CONVERT(INT,[ID_CONCEPTO]),-888) = 0 THEN -888 ELSE ISNULL(CONVERT(INT,[ID_CONCEPTO]),-888) END ID_CONCEPTO&#xA;&#x9;,[FECHA_HORA_MOVIMIENTO]&#xA;&#x9;,[NUMERO_MOVIMI]&#xA;&#x9;,[CONSECUT_MOVIMI]&#xA; INTO #GUIA_MASIVA06&#xA;FROM &#xA;&#x9;[TMP].[GUIA_MASIVA_06] WITH(NOLOCK)&#xA;WHERE 1=0&#xA;&#xA;CREATE NONCLUSTERED INDEX  ID_TMP_GUIA_MASIVA06 ON #GUIA_MASIVA06(ID)&#xA;&#xA;&#xA;--INSERTA DATA A LA TABLA&#xA;INSERT  INTO #GUIA_MASIVA06&#xA;SELECT &#xA;&#x9; ROW_NUMBER() OVER(PARTITION BY  [NUMERO_GUIA], [ID_PROCESO], [NUMERO_MOVIMI], [CONSECUT_MOVIMI]  ORDER BY [FECHA_HORA_MOVIMIENTO] DESC ) ID&#xA;&#x9;,[NUMERO_GUIA]&#xA;&#x9;,[ID_PROCESO]&#xA;&#x9;,CASE WHEN ISNULL(CONVERT(INT,[ID_CONCEPTO]),-888) = 0 THEN -888 ELSE ISNULL(CONVERT(INT,[ID_CONCEPTO]),-888) END ID_CONCEPTO&#xA;&#x9;,[FECHA_HORA_MOVIMIENTO]&#xA;&#x9;,[NUMERO_MOVIMI]&#xA;&#x9;,[CONSECUT_MOVIMI]&#xA;FROM &#xA;&#x9;[TMP].[GUIA_MASIVA_06] WITH(NOLOCK)&#xA;&#xA;&#xA;INSERT INTO &#xA;&#x9;TMP.GUIA_MASIVA_07&#xA;(&#xA;&#x9; NUMERO_GUIA&#xA;&#x9;,ID_PROCESO&#xA;&#x9;,ID_CONCEPTO&#xA;&#x9;,FECHA_HORA_MOVIMIENTO&#xA;&#x9;,NUMERO_MOVIMI&#xA;&#x9;,CONSECUT_MOVIMI&#xA;)&#xA;SELECT&#xA;&#x9; [NUMERO_GUIA]&#xA;&#x9;,[ID_PROCESO]&#xA;&#x9;,[ID_CONCEPTO]&#xA;&#x9;,[FECHA_HORA_MOVIMIENTO]&#xA;&#x9;,[NUMERO_MOVIMI]&#xA;&#x9;,[CONSECUT_MOVIMI]&#xA;FROM&#xA;&#x9;#GUIA_MASIVA06&#xA;WHERE&#xA;&#x9;ID = 1&#xA;;&#xA;&#xA;DROP TABLE IF EXISTS #GUIA_MASIVA06;&#xA;&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\PASO 04 OBTENER PROCESOS Y RECAUDO\PASO 4 6 1 DG"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{AC2B27C6-0A4F-4A9C-B1EF-ADC6719D8CF2}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="PASO 4 6 1 DG"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="4">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="/* INSERTA DATOS DE DIRECCIÓN GENERAL */&#xA;INSERT INTO [TMP].[GUIA_MASIVA_06]&#xA;           ([NUMERO_GUIA]&#xA;           ,[ID_PROCESO]&#xA;           ,[ID_CONCEPTO]&#xA;           ,[FECHA_HORA_MOVIMIENTO]&#xA;           ,[NUMERO_MOVIMI]&#xA;           ,[CONSECUT_MOVIMI])&#xA;SELECT &#xA;&#x9; SE.[NUMERO_GUIA]&#xA;&#x9;,SE.[ID_PROCESO]&#xA;&#x9;,SE.[ID_CONCEPTO]&#xA;&#x9;,SE.[FECHA_HORA_MOVIMIENTO]&#xA;&#x9;,SE.[NUMERO_MOVIMI]&#xA;&#x9;,SE.[CONSECUT_MOVIMI]&#xA;FROM&#xA;&#x9;[LOG].[SEGUIMIENTO_ENVIO] AS SE WITH(NOLOCK, INDEX(IX_SEGUIMIENTO_ENVIO_NUMERO_GUIA_V3)) &#xA;&#x9;INNER JOIN  TMP.GUIA_MASIVA AS TMP WITH(NOLOCK)&#xA;&#x9;ON SE.NUMERO_GUIA = TMP.G_NUMERO_GUIA  " xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\PASO 04 OBTENER PROCESOS Y RECAUDO\PASO 4 6 2 MCP"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{AC39B3FD-6B0B-4B97-AA93-5B58971D2A57}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="PASO 4 6 2 MCP"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="3">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="/* INSERTA DATOS DE REGIONAL MUNICIPIOS */&#xA;INSERT INTO [TMP].[GUIA_MASIVA_06]&#xA;           ([NUMERO_GUIA]&#xA;           ,[ID_PROCESO]&#xA;           ,[ID_CONCEPTO]&#xA;           ,[FECHA_HORA_MOVIMIENTO]&#xA;           ,[NUMERO_MOVIMI]&#xA;           ,[CONSECUT_MOVIMI])&#xA;SELECT &#xA;&#x9; SE.[NUMERO_GUIA]&#xA;&#x9;,SE.[ID_PROCESO]&#xA;&#x9;,SE.[ID_CONCEPTO]&#xA;&#x9;,SE.[FECHA_HORA_MOVIMIENTO]&#xA;&#x9;,SE.[NUMERO_MOVIMI]&#xA;&#x9;,SE.[CONSECUT_MOVIMI]&#xA;FROM [LOG].[SEGUIMIENTO_ENVIO_PROV] AS  SE WITH(NOLOCK) &#xA;INNER JOIN  TMP.GUIA_MASIVA AS TMP WITH(NOLOCK)&#xA;&#x9;ON SE.NUMERO_GUIA = TMP.G_NUMERO_GUIA  ;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
