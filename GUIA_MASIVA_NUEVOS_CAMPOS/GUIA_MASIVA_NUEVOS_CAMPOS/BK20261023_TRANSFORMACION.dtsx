        <SQLTask:SqlTaskData
          SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
          SQLTask:SqlStatementSource="TRUNCATE TABLE [TMP].[GUIA_MASIVA_12]&#xA;&#xA;INSERT INTO [TMP].[GUIA_MASIVA_12]&#xA;SELECT &#xA;&#x9; [NUMERO_GUIA]&#xA;&#x9;,[ID_ESTADO_PQR]  MPE_ID_ESTADO_PQR&#xA;&#x9;,CASE WHEN [ID_ESTADO_PQR] = 0 THEN 'PENDIENTE' ELSE 'CERRADO' END AS MPE_ESTADO_PQR&#xA;FROM &#xA;&#x9;SIG_COL_LOGISTICA_DW.[FAC].[PQR_MOVIMIENTO_POR_ESTADO] AS FAC WITH(NOLOCK)&#xA;&#x9;INNER JOIN SIG_COL_LOGISTICA_DW.TMP.GUIA_MASIVA AS GM WITH(NOLOCK)&#xA;&#x9;&#x9;ON FAC.NUMERO_GUIA = GM.G_NUMERO_GUIA" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
