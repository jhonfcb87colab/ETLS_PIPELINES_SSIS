              SQLTask:SqlStatementSource="WITH CTE  (&#xA;&#x9; G_NUMERO_GUIA&#xA;&#x9;,NOMBRE_CONCEPTO&#xA;) AS (&#xA;&#x9;SELECT&#xA;&#x9;&#x9; TMP.G_NUMERO_GUIA&#xA;&#x9;&#x9;,CONC.NOMBRE_CONCEPTO&#xA;&#x9;FROM  TMP.GUIA_MASIVA TMP WITH (NOLOCK)&#xA;&#x9;INNER JOIN &#x9;PAR.ITEM_CONCEPTO CONC WITH (NOLOCK)&#xA;&#x9;&#x9;ON TMP.SE_ID_PROC_ULTI_MOVI = CONC.ID_PROCESO&#xA;&#x9;&#x9;AND&#x9;TMP.SE_ID_CONC_ULTI_MOVI = CONC.ID_CONCEPTO&#xA;)&#xA;/***************/&#xA;UPDATE TMP&#xA;&#x9;SET&#x9; SE_CONC_ULTI_MOVI = ISNULL (CTE.NOMBRE_CONCEPTO,'NO DISPONIBLE')&#xA;FROM TMP.GUIA_MASIVA TMP WITH (NOLOCK)&#xA;INNER JOIN CTE&#xA;&#x9;ON TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
