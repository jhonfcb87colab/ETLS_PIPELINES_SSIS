      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
          SQLTask:SqlStatementSource="INSERT INTO &#xA;&#x9;[TMP].[GUIA_MASIVA]&#xA;(&#xA;&#x9; [G_ID_FECHA]&#xA;&#x9;,[G_FECHA]&#xA;&#x9;,[G_NUMERO_GUIA]&#xA;&#x9;,[G_NUMERO_PIEZAS]&#xA;&#x9;,[G_ID_TIEMPO_ENTREGA]&#xA;&#x9;,[G_ID_PRODUCTO]&#xA;&#x9;,[G_DIRE_DESTINO]&#xA;    ,[G_ID_CIUDAD_ORIGEN]&#xA;&#x9;,[G_ID_CIUDAD_DESTINO]&#xA;&#x9;,[G_ID_CLIENTE]&#xA;&#x9;,[G_ID_ESTADO_ENVIO]&#xA;&#x9;,[G_ID_PAIS_UBICACION]&#xA;    ,[G_ID_CIUDAD_UBICACION]&#xA;    ,[G_ID_DIVISION_UBICACION]&#xA;&#x9;,[G_VALOR_DECLARADO]&#xA;&#x9;,[G_ID_BODEGA_ULTM_MOVI]&#xA;&#xA;&#xA;)&#xA;&#xA;SELECT &#xA;&#x9;   ISNULL([FECHA_ENVIO],'1900-01-01')AS [FECHA_ENVIO]&#xA;&#x9;  ,ISNULL(CONVERT(VARCHAR, FECHA_ENVIO,21),'NO DISPONIBLE') AS [FECHA]&#xA;&#x9;  ,[NUMERO_GUIA]&#xA;      ,ISNULL(CASE WHEN [NUMERO_PIEZAS]=0 THEN NULL ELSE [NUMERO_PIEZAS] END,1) AS [NUMERO_PIEZAS]&#xA;      ,ISNULL(CASE WHEN [ID_TIEMPO]=0 THEN NULL ELSE [ID_TIEMPO] END,-888) AS [ID_TIEMPO]&#xA;      ,ISNULL(CASE WHEN [ID_PRODUCTO]=0 THEN NULL ELSE [ID_PRODUCTO] END,-888) AS [ID_PRODUCTO]&#xA;&#x9;  ,ISNULL(CASE WHEN [DIRECCION_DESTINA_GUIA]='' THEN NULL ELSE [DIRECCION_DESTINA_GUIA] END, 'NO DISPONIBLE') AS [DIRECCION_DESTINA_GUIA]&#xA;      ,ISNULL(CASE WHEN [ID_CIUDAD_ORIGEN]=0 THEN NULL ELSE [ID_CIUDAD_ORIGEN] END, -888) AS [ID_CIUDAD_ORIGEN]&#xA;      ,ISNULL(CASE WHEN [ID_CIUDAD_DESTINO]=0 THEN NULL ELSE [ID_CIUDAD_DESTINO] END, -888) AS [ID_CIUDAD_DESTINO]&#xA;&#x9;  ,ISNULL(CASE WHEN [ID_CLIENTE]='' THEN NULL ELSE [ID_CLIENTE] END, '-888') AS [ID_CLIENTE]&#xA;      ,ISNULL(CASE WHEN [ID_ESTADOENVIO]=0 THEN NULL ELSE [ID_ESTADOENVIO] END, -888) AS [ID_ESTADOENVIO]&#xA;      ,ISNULL(CASE WHEN [ID_PAIS_UBICACION]=0 THEN NULL ELSE [ID_PAIS_UBICACION] END, -888) AS [ID_PAIS_UBICACION]&#xA;      ,ISNULL(CASE WHEN [ID_CIUDAD_UBICACION]=0 THEN NULL ELSE [ID_CIUDAD_UBICACION] END, -888) AS [ID_CIUDAD_UBICACION]&#xA;      ,ISNULL(CASE WHEN [ID_DIVISION_UBICACION]=0 THEN NULL ELSE [ID_DIVISION_UBICACION] END, -888) AS [ID_DIVISION_UBICACION]&#xA;&#x9;  ,ISNULL([VALOR_DECLARADO_GUIA],0) AS [VALOR_DECLARADO_GUIA]&#xA;&#x9;  ,CONVERT(VARCHAR,ISNULL([ID_PAIS_UBICACION],'-888')) + '-' + CONVERT(VARCHAR,ISNULL([ID_CIUDAD_UBICACION],'-888')) + '-' + CONVERT(VARCHAR,ISNULL([ID_DIVISION_UBICACION],'-888')) AS P_ID_BODEGA&#xA;&#xA;  FROM [TMP].[GUIA_MASIVA_02] WITH (NOLOCK)&#xA;GO&#xA;&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
