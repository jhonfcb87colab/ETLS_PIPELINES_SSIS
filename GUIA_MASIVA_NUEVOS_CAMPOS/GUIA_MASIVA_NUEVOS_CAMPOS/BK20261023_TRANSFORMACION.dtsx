        <DTS:Executable
          DTS:refId="Package\PASO 30 NUEVOS CAMPOS\PASO 30 22 ACTUALIZAR FEC ENTREGA"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:Disabled="True"
          DTS:DTSID="{42917615-D6D3-45D4-B8C8-986810E2FE89}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="PASO 30 22 ACTUALIZAR FEC ENTREGA"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="1">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="WITH CTE(&#xA;GUIA,&#xA;TIEMPO_ENTREGA&#xA;)AS(&#xA;SELECT NUMERO_GUIA&#xA;,MIN(FECHA_HORA_MOVIMIENTO)&#xA;FROM TMP.GUIA_MASIVA_16 &#xA;WHERE ID_PROCESO IN (5,6)&#xA;GROUP BY NUMERO_GUIA&#xA;)&#xA;UPDATE TMP.GUIA_MASIVA&#xA;SET SE_FECHA_ENTREGA = TIEMPO_ENTREGA&#xA;FROM TMP.GUIA_MASIVA WITH(NOLOCK), CTE&#xA;WHERE GUIA = G_NUMERO_GUIA;&#xA;&#xA;-----------------------------&#xA;WITH CTE&#xA;(&#xA;&#x9; ID&#xA;&#x9;,G_NUMERO_GUIA&#xA;&#x9;,SE_PROCESO_PRIMGEST&#xA;&#x9;,SE_ID_FECHA_PRIMGEST&#xA;&#x9;,SE_FECHA_PRIMGEST&#xA;)&#xA;AS&#xA;(&#xA;&#x9;SELECT &#xA;&#x9;&#x9; ROW_NUMBER() OVER(PARTITION BY G_NUMERO_GUIA ORDER BY FECHA) ID&#xA;&#x9;&#x9;,G_NUMERO_GUIA&#xA;&#x9;&#x9;,PROCESO SE_PROCESO_PRIMGEST&#xA;&#x9;&#x9;,FECHA SE_ID_FECHA_PRIMGEST&#xA;&#x9;&#x9;,ISNULL(CONVERT(VARCHAR,FECHA,111),'NO DISPONIBLE') SE_FECHA_PRIMGEST&#xA;&#x9;FROM   &#xA;&#x9;   (&#xA;&#x9;&#x9;SELECT &#xA;&#x9;&#x9;&#x9; [G_NUMERO_GUIA]&#xA;&#x9;&#x9;&#x9;,[SE_ID_FECHA_DZU] [DEVOLUCION ZONA URBANA]&#xA;&#x9;&#x9;&#x9;,[SE_ID_FECHA_RD] [REPORTADO DEVUELTO]&#xA;&#x9;&#x9;&#x9;,[SE_ID_FECHA_RE] [REPORTADO ENTREGADO]&#xA;&#x9;&#x9;&#x9;,[SE_ID_FECHA_EV] [ENTREGA VERIFICADA]&#xA;&#x9;&#x9;FROM&#xA;&#x9;&#x9;&#x9;TMP.GUIA_MASIVA_19&#xA;&#x9;&#x9;WHERE&#xA;&#x9;&#x9;&#x9;[SE_FECHA_DZU] &lt;&gt; 'NO DISPONIBLE'&#xA;&#x9;&#x9;OR&#xA;&#x9;&#x9;&#x9;[SE_FECHA_RD] &lt;&gt; 'NO DISPONIBLE'&#xA;&#x9;&#x9;OR&#xA;&#x9;&#x9;&#x9;[SE_FECHA_RE] &lt;&gt; 'NO DISPONIBLE'&#xA;&#x9;&#x9;OR&#xA;&#x9;&#x9;&#x9;[SE_FECHA_EV] &lt;&gt; 'NO DISPONIBLE'&#xA;&#x9;&#x9;) p  &#xA;&#x9;UNPIVOT (FECHA FOR PROCESO IN   &#xA;&#x9;&#x9;(&#xA;&#x9;&#x9;&#x9; [DEVOLUCION ZONA URBANA]&#xA;&#x9;&#x9;&#x9;,[REPORTADO DEVUELTO]&#xA;&#x9;&#x9;&#x9;,[REPORTADO ENTREGADO]&#xA;&#x9;&#x9;&#x9;,[ENTREGA VERIFICADA]&#xA;&#x9;&#x9;)  &#xA;&#x9;)AS UNPVT&#xA;&#x9;WHERE&#xA;&#x9;&#x9;FECHA &lt;&gt; '1900-01-01'&#xA;)&#xA;&#xA;UPDATE [TMP].[GUIA_MASIVA]&#xA;SET&#xA;&#x9; SE_PROCESO_PRIMGEST = CTE.SE_PROCESO_PRIMGEST&#xA;&#x9;,SE_ID_FECHA_PRIMGEST = CTE.SE_ID_FECHA_PRIMGEST&#xA;&#x9;,SE_FECHA_PRIMGEST = CTE.SE_FECHA_PRIMGEST&#xA;FROM&#xA;&#x9;TMP.GUIA_MASIVA TMP, CTE&#xA;WHERE&#xA;&#x9;TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA&#xA;AND&#xA;&#x9;CTE.ID = 1;&#xA;&#xA;UPDATE [TMP].[GUIA_MASIVA]&#xA;SET&#xA;&#x9; SE_PROCESO_PRIMGEST = 'DIGITALIZADA'&#xA;&#x9;,SE_ID_FECHA_PRIMGEST = SE_ID_FECHA_DIGI&#xA;&#x9;,SE_FECHA_PRIMGEST = SE_FECHA_DIGI&#xA;FROM&#xA;&#x9;TMP.GUIA_MASIVA&#xA;WHERE&#xA;&#x9;SE_ID_FECHA_DIGI &lt;&gt;'1900-01-01'&#xA;AND&#xA;&#x9;SE_ID_FECHA_PRIMGEST = '1900-01-01'" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\PASO 30 NUEVOS CAMPOS\PASO 30 23 CUMPLE ACIDA"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:Disabled="True"
          DTS:DTSID="{C59A08E3-07E5-4293-B5D5-D89E9AD12F40}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="PASO 30 23 CUMPLE ACIDA"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="1">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="WITH CTE(&#xA;ID,&#xA;GUIA,&#xA;PROCESO,&#xA;FECHA&#xA;)AS(&#xA;SELECT &#xA;ROW_NUMBER() OVER(PARTITION BY G_NUMERO_GUIA ORDER BY FECHA DESC) ID,&#xA;G_NUMERO_GUIA,&#xA;PROCESO,&#xA;FECHA&#xA;FROM (&#xA;SELECT &#xA;G_NUMERO_GUIA,&#xA;SE_ID_FECHA_DZU [DEVLUCION ZONA URBANA],&#xA;SE_ID_FECHA_RD [REPORTADO DEVUELTO],&#xA;SE_ID_FECHA_RE [REPORTADO ENTREGADO],&#xA;SE_ID_FECHA_EV [ENTREGA VERIFICADA]&#xA;FROM TMP.GUIA_MASIVA_19 CLI WITH(NOLOCK)&#xA;WHERE SE_FECHA_DZU &lt;&gt; 'NO DISPONIBLE'&#xA;OR SE_FECHA_RD &lt;&gt; 'NO DISPONIBLE'&#xA;OR SE_FECHA_RE &lt;&gt; 'NO DISPONIBLE'&#xA;OR SE_FECHA_EV &lt;&gt; 'NO DISPONIBLE'&#xA;) P UNPIVOT (FECHA FOR PROCESO IN &#xA;([DEVLUCION ZONA URBANA],&#xA;[REPORTADO DEVUELTO],&#xA;[REPORTADO ENTREGADO],&#xA;[ENTREGA VERIFICADA]&#xA;)) AS UNPVT WHERE FECHA &lt;&gt; '1900-01-01'&#xA;)&#xA;UPDATE TMP.GUIA_MASIVA&#xA;SET CUMPLE_TE_ACIDA = CASE WHEN FECHA &lt;= SE_FECHA_ENTREGA THEN 'SI' ELSE 'NO' END,&#xA;CUMPLE_TE_DEPURADA = CASE WHEN FECHA &lt;= SE_FECHA_ENTREGA THEN 'SI' ELSE 'NO' END &#xA;FROM TMP.GUIA_MASIVA G WITH(NOLOCK),CTE &#xA;WHERE GUIA = G.G_NUMERO_GUIA&#xA;&#xA;&#xA;----- SE VALIDA SI CUMPLE ENTRE EJECUTADO Y RED OPERATIVA&#xA;&#xA;UPDATE TMP.GUIA_MASIVA&#xA;SET CUMPLE_TE_ACIDA = 'SI',&#xA;CUMPLE_TE_DEPURADA = 'SI'&#xA;FROM TMP.GUIA_MASIVA WITH(NOLOCK)&#xA;WHERE T_ENTREGA_EJE = T_ENTREGA_RED_OPE&#xA;&#xA;UPDATE TMP.GUIA_MASIVA&#xA;SET CUMPLE_TE_ACIDA = 'NO'&#xA;FROM TMP.GUIA_MASIVA WITH(NOLOCK)&#xA;WHERE CUMPLE_TE_ACIDA  IS NULL&#xA;&#xA;UPDATE TMP.GUIA_MASIVA&#xA;SET CUMPLE_TE_DEPURADA = 'NO'&#xA;FROM TMP.GUIA_MASIVA WITH(NOLOCK)&#xA;WHERE CUMPLE_TE_DEPURADA  IS NULL" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\PASO 30 NUEVOS CAMPOS\PASO 30 3 RECOLECCION"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{761F1B37-4DA1-4CF4-AE84-4A47BD736788}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="PASO 30 3 RECOLECCION"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="&#xA;UPDATE TMP&#xA;SET TMP.NUMERO_RECOLECCION = ISNULL(S.NUMERO_SOLICITUD_RECOLECCION,-888),&#xA;&#x9;TMP.ID_ESTA_RECOLECCION = ISNULL(S.ID_ESTADO_RECOLECCION_GUIA,255)&#xA;FROM TMP.GUIA_MASIVA AS TMP WITH(NOLOCK)&#xA;INNER JOIN LOG.GUIAS_POR_SOLICITUDRECOLECCION AS S WITH(NOLOCK) &#xA;ON TMP.G_NUMERO_GUIA = S.NUMERO_GUIA &#xA;&#xA;/*&#xA;WITH CTE(&#xA;&#x9;GUIA,&#xA;&#x9;NUM_RECO,&#xA;&#x9;ID_ESTA&#xA;) AS (&#xA;&#x9;SELECT &#xA;&#x9;&#x9;NUMERO_GUIA, &#xA;&#x9;&#x9;NUMERO_SOLICITUD_RECOLECCION,&#xA;&#x9;&#x9;ID_ESTADO_RECOLECCION_GUIA&#xA;&#x9;FROM LOG.GUIAS_POR_SOLICITUDRECOLECCION WITH(NOLOCK)&#xA;)&#xA;UPDATE TMP.GUIA_MASIVA &#xA;SET NUMERO_RECOLECCION = ISNULL(NUM_RECO,-888),&#xA;&#x9;ID_ESTA_RECOLECCION = ISNULL(ID_ESTA,255)&#xA;FROM TMP.GUIA_MASIVA WITH(NOLOCK), CTE&#xA;WHERE GUIA = G_NUMERO_GUIA&#xA;*/" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\PASO 30 NUEVOS CAMPOS\PASO 30 4 TIEM ENTR EJE"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{1C1CA188-5D9C-4449-9CAC-6E4344A8C630}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="PASO 30 4 TIEM ENTR EJE"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="&#xA;/* HOLMAN ESTEPA 16Sep22 Se realizan cambios como &#xA;1. Se retira 'SABADOS' del filtro DAY&#xA;2. Se optimiza codigos retirando las , por los INNER JOIN &#xA;3. se comenta el codigo T_ENTREGA_EJE = 0 donde le filtro sea -1 ya que el ultimo codigo hace el trabajo &#xA;4. se crea codigo que actualiza el campo SE_FECHA_ENTREGA ya que este deberia ser usado para el calculo del campo T_ENTREGA_EJE&#xA;*/&#xA;&#xA;-- Se busca los procesos ENTREGA VERIFICADA y REPORTADO ENTREGADO y se ordena de forma descendente por la fecha hora movimiento del envio&#xA;-- esto con el fin de hallar su maximo o ultimo movimiento el cual nos indicará la fecha de entrega reportada y el campo SE_ID_FECHA_SZU por SE_FECHA_ENTREGA&#xA;WITH TIEMPO_ENTREGA AS (&#xA;&#x9;SELECT ROW_NUMBER() OVER (PARTITION BY G_NUMERO_GUIA ORDER BY E.FECHA_HORA_MOVIMIENTO DESC) AS #ROW,&#xA;&#x9;TMP.G_NUMERO_GUIA, E.ID_PROCESO,  E.FECHA_HORA_MOVIMIENTO AS FECHA_ENTREGA&#xA;&#x9;FROM TMP.GUIA_MASIVA AS TMP WITH(NOLOCK)&#xA;&#x9;INNER JOIN LOG.SEGUIMIENTO_ENVIO AS E WITH(NOLOCK)&#xA;&#x9;&#x9;ON TMP.G_NUMERO_GUIA =E.NUMERO_GUIA&#xA;&#x9;&#x9;AND E.ID_PROCESO IN (11,24)&#xA;)&#xA;UPDATE TMP&#xA;&#x9;SET TMP.SE_FECHA_ENTREGA = E.FECHA_ENTREGA  &#xA;FROM TMP.GUIA_MASIVA AS TMP WITH(NOLOCK) &#xA;INNER JOIN TIEMPO_ENTREGA AS E WITH(NOLOCK)&#xA;&#x9;ON TMP.G_NUMERO_GUIA = E.G_NUMERO_GUIA AND #ROW = 1&#xA;GO&#xA;&#xA;---CONTEO DE SABADOS Y DOMINGOS ENTRE FECHAS&#xA;WITH CTE(&#xA;GUIA,DIAS&#xA;) AS (&#xA;&#x9;SELECT G_NUMERO_GUIA,COUNT(1) FROM TMP.GUIA_MASIVA WITH(NOLOCK)&#xA;&#x9;INNER JOIN DIM.TIEMPO WITH(NOLOCK)&#xA;&#x9;&#x9;ON DAY IN ('DOMINGO')&#xA;&#x9;&#x9;AND DATE BETWEEN CONVERT(DATE,SE_ID_FECHA_EZU) AND CONVERT(DATE,SE_FECHA_ENTREGA)&#xA;&#x9;&#x9;AND SE_ID_FECHA_EZU IS NOT NULL AND SE_ID_FECHA_EZU &lt;&gt; '1900-01-01'&#xA;&#x9;&#x9;AND SE_FECHA_ENTREGA IS NOT NULL AND SE_FECHA_ENTREGA &lt;&gt; '1900-01-01'&#xA;&#x9;GROUP BY G_NUMERO_GUIA&#xA;)&#xA;/* El campo G_CANT_SD identifica unicamente los dias domingos (antes tomaba sabados y domingos )  */&#xA;UPDATE TMP&#xA;&#x9;SET TMP.G_CANT_SD = CTE.DIAS&#xA;FROM TMP.GUIA_MASIVA AS TMP WITH(NOLOCK) INNER JOIN  CTE&#xA;ON CTE.GUIA = TMP.G_NUMERO_GUIA&#xA;&#xA;GO&#xA;----CONTEO DE FESTIVOS ENTRE FECHAS&#xA;&#xA;WITH CTE(&#xA;GUIA, DIAS&#xA;)AS (&#xA;&#x9;SELECT TMP.G_NUMERO_GUIA,COUNT(1) &#xA;&#x9;FROM TMP.GUIA_MASIVA AS TMP WITH(NOLOCK) &#xA;&#x9;INNER JOIN PAR.FESTIVOSNACIONALES AS P WITH(NOLOCK)&#xA;&#x9;&#x9;ON P.FECHA_FESTIVA &gt; DATEADD(yy,-1,DATEADD(yy,DATEDIFF(yy,0,GETDATE()),0))&#xA;&#x9;&#x9;AND P.FECHA_FESTIVA BETWEEN CONVERT(DATE,TMP.SE_ID_FECHA_EZU) AND CONVERT(DATE,TMP.SE_FECHA_ENTREGA)&#xA;&#x9;&#x9;AND TMP.SE_ID_FECHA_EZU IS NOT NULL AND TMP.SE_ID_FECHA_EZU &lt;&gt; '1900-01-01'&#xA;&#x9;&#x9;AND TMP.SE_FECHA_ENTREGA IS NOT NULL AND TMP.SE_FECHA_ENTREGA &lt;&gt; '1900-01-01'&#xA;GROUP BY TMP.G_NUMERO_GUIA&#xA;)&#xA;/* el campo G_CANT_F capta los dias festivos depende de la tabla parametrica FESTIVOSNACIONALES */&#xA;UPDATE TMP&#xA;SET TMP.G_CANT_F = CTE.DIAS&#xA;FROM TMP.GUIA_MASIVA AS TMP WITH(NOLOCK) INNER JOIN  CTE&#xA;ON CTE.GUIA = TMP.G_NUMERO_GUIA&#xA;&#xA;GO&#xA;&#xA;---CALCULO DE DIFERENCIA DE DIAS MENOS SABADOS, DOMINGOS Y FESTIVOS&#xA;&#xA;UPDATE  TMP&#xA; SET TMP.T_ENTREGA_EJE = DATEDIFF(DAY,CONVERT(DATE,TMP.SE_ID_FECHA_EZU),CONVERT(DATE,TMP.SE_FECHA_ENTREGA))-(ISNULL(TMP.G_CANT_SD,0)+ISNULL(TMP.G_CANT_F,0))&#xA; FROM TMP.GUIA_MASIVA AS TMP WITH(NOLOCK)&#xA; WHERE &#xA;&#x9; TMP.SE_ID_FECHA_EZU IS NOT NULL AND TMP.SE_ID_FECHA_EZU &lt;&gt; '1900-01-01'&#xA; AND TMP.SE_FECHA_ENTREGA IS NOT NULL AND TMP.SE_FECHA_ENTREGA &lt;&gt; '1900-01-01'&#xA;&#xA;--UPDATE TMP.GUIA_MASIVA&#xA;--SET T_ENTREGA_EJE = 0&#xA;--FROM TMP.GUIA_MASIVA WITH(NOLOCK)&#xA;--WHERE T_ENTREGA_EJE = -1&#xA;&#xA;-------- MODIFICACIÓN 16/09/2022&#xA;UPDATE TMP&#xA;SET  TMP.T_ENTREGA_EJE = 1 ----------&gt;CAMBIO&#xA;FROM TMP.GUIA_MASIVA AS TMP WITH(NOLOCK)&#xA;WHERE TMP.T_ENTREGA_EJE in (0,-1) ----------&gt;CAMBIO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\PASO 30 NUEVOS CAMPOS\PASO 30 5  FECHA Y ESTADO RECOLE DUMMING"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{0B52CDC4-5983-4121-BE6B-2A9217791FD7}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="PASO 30 5  FECHA Y ESTADO RECOLE DUMMING"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="WITH CTE(&#xA;&#x9;GUIA,&#xA;&#x9;FECHA&#xA;) AS (&#xA;&#x9;SELECT NUMERO_GUIA, FECHA_HORA_MOVIMIENTO &#xA;&#x9;FROM LOG.SEGUIMIENTO_ENVIO WITH(NOLOCK)&#xA;&#x9;INNER JOIN TMP.GUIA_MASIVA WITH(NOLOCK) &#xA;&#x9;&#x9;ON NUMERO_GUIA = G_NUMERO_GUIA&#xA;&#x9;WHERE ID_PROCESO = 28&#xA;)&#xA;UPDATE TMP&#xA;&#x9;SET TMP.FECHA_RECOLECCION = FECHA&#xA;FROM TMP.GUIA_MASIVA AS TMP WITH(NOLOCK) INNER JOIN CTE&#xA;&#x9;ON TMP.G_NUMERO_GUIA = GUIA&#xA;GO&#xA;&#xA;UPDATE TMP.GUIA_MASIVA &#xA;SET ESTA_RECOLECCION = 'NO DISPONIBLE'" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\PASO 30 NUEVOS CAMPOS\PASO 30 7 NOM RECHAZO"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:Disabled="True"
          DTS:DTSID="{6A663BEA-876E-491F-B388-66364D4E47E8}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="PASO 30 7 NOM RECHAZO"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="WITH CTE(&#xA;ID_MO,&#xA;NOM_MO&#xA;)AS(&#xA;SELECT&#xA;ID_MOTIVO_RECHAZO,&#xA;NOMBRE_MOTIVO_RECHAZO&#xA;FROM PAR.MOTIVOS_RECHAZOS_SOLICRECOL WITH(NOLOCK)&#xA;)&#xA;UPDATE TMP.GUIA_MASIVA&#xA;SET R_MOTIVO_RECHAZO = NOM_MO&#xA;FROM TMP.GUIA_MASIVA WITH(NOLOCK), CTE&#xA;WHERE ID_MO = R_ID_MOTIVO_RECHAZO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\PASO 30 NUEVOS CAMPOS\PASO 30 8 EVID DISTR"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{1B86BC5D-9538-46FF-9071-B0B266FED7AE}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="PASO 30 8 EVID DISTR"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="&#xA;UPDATE TMP&#xA;&#x9;SET TMP.EVIDEN_DISTRI = CASE I.RUTA_IMAGEN_FOTO WHEN NULL THEN 'NO' ELSE 'SI' END&#xA;FROM TMP.GUIA_MASIVA AS TMP WITH(NOLOCK)&#xA;INNER JOIN LOG.SEGUIMIENTO_ENVIO_INF_ADICIONAL_MOVIL AS I WITH(NOLOCK)&#xA;&#x9;ON TMP.G_NUMERO_GUIA = I.NUMERO_GUIA&#xA;&#x9;AND  I.RUTA_IMAGEN_FOTO IS NOT NULL AND I.RUTA_IMAGEN_FOTO &lt;&gt; ''&#xA;&#xA;&#xA;/*&#xA;WITH CTE(&#xA;NUMERO_GUIA,&#xA;RUTA_IMAGEN&#xA;)AS(&#xA;SELECT &#xA;NUMERO_GUIA,&#xA;RUTA_IMAGEN_FOTO&#xA;FROM LOG.SEGUIMIENTO_ENVIO_INF_ADICIONAL_MOVIL WITH(NOLOCK)&#xA;WHERE RUTA_IMAGEN_FOTO IS NOT NULL AND RUTA_IMAGEN_FOTO &lt;&gt; ''&#xA;)&#xA;UPDATE TMP.GUIA_MASIVA&#xA;SET EVIDEN_DISTRI = CASE RUTA_IMAGEN WHEN NULL THEN 'NO' ELSE 'SI' END&#xA;FROM TMP.GUIA_MASIVA WITH(NOLOCK), CTE&#xA;WHERE NUMERO_GUIA = G_NUMERO_GUIA &#xA;*/" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\PASO 30 NUEVOS CAMPOS\PASO 3O 6 MOTIVO RECHAZO"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{A16C9A80-3FA7-4D12-81AF-63E22CC6861E}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="PASO 3O 6 MOTIVO RECHAZO"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="--- ID MOTIVO&#xA;UPDATE TMP&#xA;&#x9;SET TMP.R_ID_MOTIVO_RECHAZO = S.ID_MOTIVO_RECHAZO&#xA;FROM TMP.GUIA_MASIVA AS TMP WITH(NOLOCK)&#xA;INNER JOIN LOG.SOLICITUDRECOLECCION AS S WITH(NOLOCK)&#xA;&#x9;ON TMP.NUMERO_RECOLECCION = S.NUMERO_SOLICITUD&#xA;OPTION( OPTIMIZE FOR UNKNOWN, MAXDOP 4) ;&#xA;&#xA;&#xA;&#xA;&#xA;-- DESCRIPTIVO&#xA;UPDATE TMP&#xA;SET TMP.R_MOTIVO_RECHAZO = R.NOMBRE_MOTIVO_RECHAZO&#xA;FROM TMP.GUIA_MASIVA AS TMP WITH(NOLOCK)&#xA;INNER JOIN PAR.MOTIVOS_RECHAZOS_SOLICRECOL AS R WITH(NOLOCK)&#xA;&#x9;ON TMP.R_ID_MOTIVO_RECHAZO = R.ID_MOTIVO_RECHAZO&#xA;OPTION( OPTIMIZE FOR UNKNOWN, MAXDOP 4) ;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;/*&#xA;--- ID MOTIVO&#xA;WITH CTE(&#xA;&#x9;NUM_RECO,&#xA;&#x9;ID_MO_REC&#xA;) AS (&#xA;&#x9;SELECT &#xA;&#x9;&#x9;NUMERO_SOLICITUD,&#xA;&#x9;&#x9;ID_MOTIVO_RECHAZO&#xA;&#x9;FROM LOG.SOLICITUDRECOLECCION WITH(NOLOCK)&#xA;)&#xA;UPDATE TMP.GUIA_MASIVA&#xA;SET R_ID_MOTIVO_RECHAZO = ID_MO_REC&#xA;FROM TMP.GUIA_MASIVA WITH(NOLOCK) INNER JOIN  CTE&#xA;ON NUM_RECO = NUMERO_RECOLECCION&#xA;&#xA;GO&#xA;&#xA;-- DESCRIPTIVO&#xA;&#xA;WITH CTE(&#xA;&#x9;ID_MO,&#xA;&#x9;NOM_MO&#xA;)AS(&#xA;&#x9;SELECT&#xA;&#x9;&#x9;ID_MOTIVO_RECHAZO,&#xA;&#x9;&#x9;NOMBRE_MOTIVO_RECHAZO&#xA;&#x9;FROM PAR.MOTIVOS_RECHAZOS_SOLICRECOL WITH(NOLOCK)&#xA;)&#xA;UPDATE TMP.GUIA_MASIVA&#xA;SET R_MOTIVO_RECHAZO = NOM_MO&#xA;FROM TMP.GUIA_MASIVA WITH(NOLOCK) INNER JOIN  CTE&#xA;ON ID_MO = R_ID_MOTIVO_RECHAZO&#xA;*/" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\PASO 30 NUEVOS CAMPOS\PASOS 30 9 EVI RECO"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{88D44AC4-ABE1-4582-9A6F-5F8AA039514C}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="PASOS 30 9 EVI RECO"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="UPDATE TMP&#xA;SET EVIDEN_RECO = CASE SD.RUTA_IMAGEN_FOTO WHEN NULL THEN 'NO' ELSE 'SI' END &#xA;FROM TMP.GUIA_MASIVA AS TMP WITH(NOLOCK)&#xA;INNER JOIN LOG.SOLICITUDRECOLECCION_DETALLE_RECOGIDO AS SD WITH(NOLOCK) &#xA;&#x9;ON SD.RUTA_IMAGEN_FOTO IS NOT NULL AND SD.RUTA_IMAGEN_FOTO &lt;&gt; '' &#xA;&#x9;AND  TMP.NUMERO_RECOLECCION = SD.NUMERO_SOLICITUD&#xA;&#xA;&#xA;/*&#xA;WITH CTE(&#xA;SOLICITUD,&#xA;RUTA&#xA;) AS(&#xA;SELECT NUMERO_SOLICITUD, &#xA;RUTA_IMAGEN_FOTO&#xA;FROM LOG.SOLICITUDRECOLECCION_DETALLE_RECOGIDO WITH(NOLOCK)&#xA;WHERE RUTA_IMAGEN_FOTO IS NOT NULL AND RUTA_IMAGEN_FOTO &lt;&gt; ''&#xA;)&#xA;UPDATE TMP.GUIA_MASIVA &#xA;SET EVIDEN_RECO = CASE RUTA WHEN NULL THEN 'NO' ELSE 'SI' END&#xA;FROM TMP.GUIA_MASIVA WITH(NOLOCK),CTE&#xA;WHERE NUMERO_RECOLECCION = SOLICITUD&#xA;*/" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
      </DTS:Executables>
      <DTS:PrecedenceConstraints>
        <DTS:PrecedenceConstraint
          DTS:refId="Package\PASO 30 NUEVOS CAMPOS.PrecedenceConstraints[Constraint]"
          DTS:CreationName=""
          DTS:DTSID="{FC733034-F2F1-4923-B13A-701BB9DBEABF}"
          DTS:From="Package\PASO 30 NUEVOS CAMPOS\PASO 30 1 VALOR RECAUDADO"
          DTS:LogicalAnd="True"
          DTS:ObjectName="Constraint"
          DTS:To="Package\PASO 30 NUEVOS CAMPOS\PASO 30 2 ESTADO RECAUDO" />
        <DTS:PrecedenceConstraint
          DTS:refId="Package\PASO 30 NUEVOS CAMPOS.PrecedenceConstraints[Constraint 1]"
          DTS:CreationName=""
          DTS:DTSID="{26A9A19C-38EA-4228-A06A-FF24946D63B4}"
          DTS:From="Package\PASO 30 NUEVOS CAMPOS\PASO 30 2 ESTADO RECAUDO"
          DTS:LogicalAnd="True"
          DTS:ObjectName="Constraint 1"
          DTS:To="Package\PASO 30 NUEVOS CAMPOS\PASO 30 3 RECOLECCION" />
        <DTS:PrecedenceConstraint
          DTS:refId="Package\PASO 30 NUEVOS CAMPOS.PrecedenceConstraints[Constraint 10]"
          DTS:CreationName=""
          DTS:DTSID="{0269D1A1-AC87-48D3-B8B7-71AE558DF8DB}"
          DTS:From="Package\PASO 30 NUEVOS CAMPOS\PASO 30 11 DIMENSIONES R"
          DTS:LogicalAnd="True"
          DTS:ObjectName="Constraint 10"
