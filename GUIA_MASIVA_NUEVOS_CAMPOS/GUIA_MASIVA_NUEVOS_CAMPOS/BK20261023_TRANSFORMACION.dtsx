          DTS:ObjectName="DIA HABIL NO SAB Y DOM"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="WITH CTE (&#xA;&#x9; G_NUMERO_GUIA&#x9; &#xA;&#x9;,SE_ID_DIA_HABIL_PRIMGEST&#xA;) AS (&#xA;&#x9;SELECT&#xA;&#x9;&#x9; C.G_NUMERO_GUIA G_NUMERO_GUIA&#x9; &#xA;&#x9;&#x9;,F.ID_DIA_HABIL SE_ID_DIA_HABIL_PRIMGEST&#xA;&#x9;FROM TMP.GUIA_MASIVA_18 AS C WITH(NOLOCK)&#xA;&#x9;INNER JOIN TMP.GUIA_MASIVA_DHABIL_NO_SD AS F WITH(NOLOCK)&#xA;&#x9;&#x9;ON  CONVERT(DATE,C.SE_ID_FECHA_PRIMGEST) =  F.FECHA&#xA;&#x9;WHERE C.G_ID_HABIL_SABADO = 0&#xA;&#x9;AND SE_ID_FECHA_PRIMGEST &lt;&gt; '1900-01-01'&#xA;)&#xA;&#xA;UPDATE TMP&#xA;&#x9;SET  SE_ID_DIA_HABIL_PRIMGEST = CTE.SE_ID_DIA_HABIL_PRIMGEST&#xA;FROM TMP.GUIA_MASIVA_18 AS TMP WITH(NOLOCK)&#xA;INNER JOIN CTE&#xA;&#x9;ON &#x9;TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA&#xA;GO&#xA;&#xA;/**********************************************/&#xA;WITH CTE  (&#xA;&#x9; G_NUMERO_GUIA&#x9; &#xA;&#x9;,SE_ID_DIA_HABIL_PRIMGEST&#xA;)  AS (&#xA;&#x9;SELECT &#xA;&#x9;&#x9; C.G_NUMERO_GUIA G_NUMERO_GUIA&#xA;&#x9;&#x9;,(SELECT TOP 1 ID_DIA_HABIL &#xA;&#x9;&#x9;&#x9;FROM TMP.GUIA_MASIVA_DHABIL_NO_SD F WITH(NOLOCK) &#xA;&#x9;&#x9;&#x9;WHERE F.FECHA &gt;= CONVERT(DATE,C.SE_ID_FECHA_PRIMGEST)&#xA;&#x9;&#x9; ) AS  SE_ID_DIA_HABIL_PRIMGEST&#xA;&#x9;FROM  TMP.GUIA_MASIVA_18 AS C WITH(NOLOCK)&#xA;&#x9;WHERE  SE_ID_DIA_HABIL_PRIMGEST = 0&#xA;&#x9;AND C.G_ID_HABIL_SABADO = 0&#xA;&#x9;AND SE_ID_FECHA_PRIMGEST &lt;&gt; '1900-01-01'&#xA;)&#xA;&#xA;UPDATE TMP&#xA;&#x9;SET SE_ID_DIA_HABIL_PRIMGEST = CTE.SE_ID_DIA_HABIL_PRIMGEST&#xA;FROM TMP.GUIA_MASIVA_18 AS TMP  WITH(NOLOCK)&#xA;INNER JOIN CTE&#xA;&#x9;ON TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\CUMPLIMIENTO AC Y DEPU\DIAS CUMPLIMIENTO PRIMERA VISITA"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{EDC12BA8-81EF-4711-B660-8AD416AC1D19}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="DIAS CUMPLIMIENTO PRIMERA VISITA"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="WITH CTE (&#xA;&#x9; G_NUMERO_GUIA&#xA;&#x9;,SE_PROMESA_DIAS_CUMP_PV_ACIDA&#xA;) AS (&#xA;&#x9;SELECT&#xA;&#x9;&#x9; G_NUMERO_GUIA&#xA;&#x9;&#x9;,CASE &#xA;&#x9;&#x9;&#x9;WHEN SE_ID_DIAS_PROMESA = 1 THEN '1 DÍA'&#xA;&#x9;&#x9;&#x9;WHEN SE_ID_DIAS_PROMESA = 2 THEN '2 DÍAS'&#xA;&#x9;&#x9;&#x9;WHEN SE_ID_DIAS_PROMESA &gt;= 3 AND SE_ID_DIAS_PROMESA &lt; 6 THEN '3 A 5 DÍAS'&#xA;&#x9;&#x9;&#x9;WHEN SE_ID_DIAS_PROMESA &gt;= 6 AND SE_ID_DIAS_PROMESA &lt; 11 THEN '6 A 10 DÍAS'&#xA;&#x9;&#x9;&#x9;WHEN SE_ID_DIAS_PROMESA &gt;= 11 THEN 'MAYOR A 10 DÍAS'&#xA;&#x9;&#x9;&#x9;ELSE 'NO DISPONIBLE'&#xA;&#x9;&#x9; END SE_PROMESA_DIAS_CUMP_PV_ACIDA&#xA;&#x9;FROM&#xA;&#x9;&#x9;TMP.GUIA_MASIVA_18 WITH(NOLOCK)&#xA;&#x9;WHERE &#xA;&#x9;&#x9;SE_PROMESA_CUMPLE_PV_ACIDA = 'SI'&#x9;&#xA;&#x9;AND &#xA;&#x9;&#x9;(SE_ID_DIA_HABIL_ENTREGA - SE_ID_DIA_HABIL_PRIMGEST) = 0&#xA;&#x9;AND&#xA;&#x9;&#x9;SE_ID_DIAS_PROMESA &gt; 0&#xA;)&#xA;&#xA;UPDATE TMP&#xA;&#x9;SET  SE_PROMESA_DIAS_CUMP_PV_ACIDA = CTE.SE_PROMESA_DIAS_CUMP_PV_ACIDA&#xA;FROM TMP.GUIA_MASIVA_18 TMP INNER JOIN  CTE&#xA;&#x9;ON TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA&#xA;GO&#xA;&#xA;UPDATE [TMP].[GUIA_MASIVA_18]&#xA;SET&#xA;&#x9; SE_PROMESA_DIAS_CUMP_PV_ACIDA = &#xA;&#x9; CASE &#xA;&#x9;&#x9;&#x9;WHEN (SE_ID_DIA_HABIL_ENTREGA - SE_ID_DIA_HABIL_PRIMGEST) = 0 THEN '0 DÍAS'&#xA;&#x9;&#x9;&#x9;WHEN (SE_ID_DIA_HABIL_ENTREGA - SE_ID_DIA_HABIL_PRIMGEST) = 1 THEN '-1 DÍA'&#xA;&#x9;&#x9;&#x9;WHEN (SE_ID_DIA_HABIL_ENTREGA - SE_ID_DIA_HABIL_PRIMGEST) = 2 THEN '-2 DÍAS'&#xA;&#x9;&#x9;&#x9;WHEN (SE_ID_DIA_HABIL_ENTREGA - SE_ID_DIA_HABIL_PRIMGEST) &gt;= 3 AND (SE_ID_DIA_HABIL_ENTREGA - SE_ID_DIA_HABIL_PRIMGEST) &lt; 6 THEN '-3 A -5 DÍAS'&#xA;&#x9;&#x9;&#x9;WHEN (SE_ID_DIA_HABIL_ENTREGA - SE_ID_DIA_HABIL_PRIMGEST) &gt;= 6 AND (SE_ID_DIA_HABIL_ENTREGA - SE_ID_DIA_HABIL_PRIMGEST) &lt; 11 THEN '-6 A -10 DÍAS'&#xA;&#x9;&#x9;&#x9;ELSE 'MENOR A -10 DÍAS'&#xA;&#x9;END&#xA;FROM&#xA;&#x9;TMP.GUIA_MASIVA_18 TMP&#xA;WHERE &#xA;&#x9;SE_PROMESA_CUMPLE_PV_ACIDA = 'SI'&#x9;&#xA;AND &#xA;&#x9;SE_PROMESA_DIAS_CUMP_PV_ACIDA = 'NO DISPONIBLE'" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\CUMPLIMIENTO AC Y DEPU\DIAS PRIMERA VISITA"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{80698BB2-D0FE-4518-8E5A-D04FC2FA4BC3}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="DIAS PRIMERA VISITA"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="UPDATE TMP&#xA;SET&#xA;&#x9;SE_DIAS_PRIMGEST = &#xA;&#x9;CASE &#xA;&#x9;&#x9;WHEN (TMP.SE_ID_DIA_HABIL_PRIMGEST - TMP.SE_ID_DIA_HABIL) = 1 THEN '1 DÍA'&#xA;&#x9;&#x9;WHEN (TMP.SE_ID_DIA_HABIL_PRIMGEST - TMP.SE_ID_DIA_HABIL) = 2 THEN '2 DÍAS'&#xA;&#x9;&#x9;WHEN (TMP.SE_ID_DIA_HABIL_PRIMGEST - TMP.SE_ID_DIA_HABIL) &gt;= 3 AND (TMP.SE_ID_DIA_HABIL_PRIMGEST - TMP.SE_ID_DIA_HABIL) &lt; 6 THEN '3 A 5 DÍAS'&#xA;&#x9;&#x9;WHEN (TMP.SE_ID_DIA_HABIL_PRIMGEST - TMP.SE_ID_DIA_HABIL) &gt;= 6 AND (TMP.SE_ID_DIA_HABIL_PRIMGEST - TMP.SE_ID_DIA_HABIL) &lt; 11 THEN '6 A 10 DÍAS'&#xA;&#x9;&#x9;ELSE 'MAYOR A 10 DÍAS'&#xA;&#x9;END &#xA;FROM&#xA;&#x9;TMP.GUIA_MASIVA_18 AS TMP&#xA;WHERE&#xA;&#x9;TMP.SE_ID_FECHA_PRIMGEST &lt;&gt; '1900-01-01'&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\CUMPLIMIENTO AC Y DEPU\FECHA ENTREGA HOY MISMO Y CERO HORAS"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{34228BAD-695C-4F9E-9C1F-DDBF65247BEB}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="FECHA ENTREGA HOY MISMO Y CERO HORAS"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="-- PROMESA HOY MISMO&#xA;UPDATE  [TMP].[GUIA_MASIVA_18]&#xA;SET  SE_ID_FECHA_ENTREGA = SE_ID_FECHA&#xA;&#x9;,SE_FECHA_ENTREGA =  CONVERT(VARCHAR,SE_ID_FECHA,111)&#xA;&#x9;,SE_ID_DIAS_PROMESA = 1&#xA;&#x9;,SE_ID_DIA_HABIL_ENTREGA = SE_ID_DIA_HABIL&#xA;&#x9;,SE_TIME_ID_FECHA_ENTREGA = CONVERT(INT,CONVERT(NUMERIC,CONVERT(DATETIME,CONVERT(CHAR(11),SE_ID_FECHA_ENTREGA))))&#xA;WHERE G_ID_TIEMPO = 2&#xA;GO&#xA;&#xA;-- PROMESA CERO HORAS&#xA;WITH CTE  (&#xA;&#x9; G_NUMERO_GUIA&#xA;&#x9;,SE_ID_FECHA_ENTREGA&#xA;) AS (&#xA;&#x9;SELECT &#xA;&#x9;&#x9; C.G_NUMERO_GUIA&#xA;&#x9;&#x9;,F.FECHA SE_ID_FECHA_ENTREGA&#xA;&#x9;FROM TMP.GUIA_MASIVA_18 AS C WITH(NOLOCK)&#xA;&#x9;INNER JOIN TMP.GUIA_MASIVA_DHABIL_NO_D AS F WITH(NOLOCK)&#xA;&#x9;&#x9;ON &#x9;CONVERT(INT,C.SE_ID_DIA_HABIL + 1) = F.ID_DIA_HABIL&#x9;&#xA;&#x9;WHERE C.G_ID_TIEMPO = 3&#xA;)&#xA;&#xA;UPDATE TMP &#xA;SET  SE_ID_FECHA_ENTREGA = CTE.SE_ID_FECHA_ENTREGA&#xA;&#x9;,SE_FECHA_ENTREGA = CONVERT(VARCHAR,CTE.SE_ID_FECHA_ENTREGA,111)&#xA;&#x9;,SE_ID_DIAS_PROMESA = 1&#xA;&#x9;,SE_ID_DIA_HABIL_ENTREGA = SE_ID_DIA_HABIL&#xA;&#x9;,SE_TIME_ID_FECHA_ENTREGA = CONVERT(INT,CONVERT(NUMERIC,CONVERT(DATETIME,CONVERT(CHAR(11),CTE.SE_ID_FECHA_ENTREGA))))&#xA;FROM TMP.GUIA_MASIVA_18 AS TMP&#xA;INNER JOIN CTE&#xA;&#x9;ON TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\CUMPLIMIENTO AC Y DEPU\FECHA ENTREGA NO DOM"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{7E6B0AF0-DC38-48EF-9833-B987219BA46D}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="FECHA ENTREGA NO DOM"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="-- PROMESA RED OPERATIVA&#xA;WITH CTE (&#xA;&#x9; G_NUMERO_GUIA&#xA;&#x9;,SE_ID_FECHA_ENTREGA&#xA;&#x9;,SE_ID_DIAS_PROMESA&#xA;&#x9;,SE_ID_DIA_HABIL_ENTREGA&#xA;) AS (&#xA;&#x9;SELECT &#xA;&#x9;&#x9; C.G_NUMERO_GUIA&#xA;&#x9;&#x9;,F.FECHA SE_ID_FECHA_ENTREGA&#xA;&#x9;&#x9;,CONVERT(INT,C.TIEMPO_OFERTA_DIA) SE_ID_DIAS_PROMESA&#xA;&#x9;&#x9;,F.ID_DIA_HABIL SE_ID_DIA_HABIL_ENTREGA&#xA;&#x9;FROM&#xA;&#x9;&#x9;(&#xA;&#x9;&#x9;&#x9;SELECT &#xA;&#x9;&#x9;&#x9;&#x9; TMP.G_NUMERO_GUIA&#xA;&#x9;&#x9;&#x9;&#x9;,TMP.SE_FECHA&#xA;&#x9;&#x9;&#x9;&#x9;,G_ID_HABIL_SABADO&#xA;&#x9;&#x9;&#x9;&#x9;,ISNULL(R.TIEMPO_ENTREGA_COMERCIAL_DIA,0) TIEMPO_OFERTA_DIA&#xA;&#x9;&#x9;&#x9;&#x9;,SE_ID_DIA_HABIL&#xA;&#x9;&#x9;&#x9;&#x9;,SE_FECHA_HABIL&#xA;&#x9;&#x9;&#x9;FROM &#x9;TMP.GUIA_MASIVA_18 AS TMP WITH(NOLOCK) &#xA;&#x9;&#x9;&#x9;INNER JOIN  TMP.GUIA_MASIVA_RED_OPERATIVA_RUTA_ACTIVA_CU AS RA WITH(NOLOCK) &#xA;&#x9;&#x9;&#x9;&#x9;ON &#x9; TMP.G_ID_CIUDAD_ORIGEN = RA.ID_CIUDAD_ORIGEN&#xA;&#x9;&#x9;&#x9;&#x9;AND  TMP.G_ID_CIUDAD_DESTINO = RA.ID_CIUDAD_DESTINO&#xA;&#x9;&#x9;&#x9;&#x9;AND  CASE WHEN ISNULL(TMP.G_ID_TIEMPO,0) &lt;&gt; 0 THEN TMP.G_ID_TIEMPO ELSE 1 END = RA.ID_TIEMPO&#xA;&#x9;&#x9;&#x9;&#x9;AND  CASE WHEN ISNULL(TMP.G_ID_MEDTRANS,0) &lt;&gt; 0 THEN TMP.G_ID_MEDTRANS ELSE 1 END = RA.ID_MEDTRANS&#xA;&#x9;&#x9;&#x9;INNER JOIN TMP.GUIA_MASIVA_RED_OPERATIVA_RUTA_CU AS R WITH(NOLOCK) &#xA;&#x9;&#x9;&#x9;&#x9;ON &#x9;RA.ID_RUTA = R.ID_RUTA&#xA;&#x9;&#x9;) C &#xA;&#x9;INNER JOIN  TMP.GUIA_MASIVA_DHABIL_NO_D AS F WITH(NOLOCK)&#xA;&#x9;ON &#x9;CONVERT(INT,C.TIEMPO_OFERTA_DIA + C.SE_ID_DIA_HABIL) = F.ID_DIA_HABIL&#xA;&#x9;WHERE C.G_ID_HABIL_SABADO = 1&#xA;)&#xA;&#xA;/**************/&#xA;UPDATE TMP&#xA;SET  SE_TIME_ID_FECHA_ENTREGA = CONVERT(INT,CONVERT(NUMERIC,CONVERT(DATETIME,CONVERT(CHAR(11),CTE.SE_ID_FECHA_ENTREGA))))&#x9;&#xA;&#x9;,SE_ID_FECHA_ENTREGA = CTE.SE_ID_FECHA_ENTREGA&#xA;&#x9;,SE_FECHA_ENTREGA = CONVERT(VARCHAR,CTE.SE_ID_FECHA_ENTREGA,111)&#xA;&#x9;,SE_ID_DIAS_PROMESA = CTE.SE_ID_DIAS_PROMESA&#xA;&#x9;,SE_ID_DIA_HABIL_ENTREGA = CTE.SE_ID_DIA_HABIL_ENTREGA&#xA;FROM TMP.GUIA_MASIVA_18 TMP&#xA;INNER JOIN CTE&#xA;ON &#x9;TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\CUMPLIMIENTO AC Y DEPU\FECHA ENTREGA NO SAB Y DOM"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{235BE989-322F-42F0-85B3-1EE84D22501E}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="FECHA ENTREGA NO SAB Y DOM"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="-- PROMESA RED OPERATIVA&#xA;WITH CTE (&#xA;&#x9; G_NUMERO_GUIA&#xA;&#x9;,SE_ID_FECHA_ENTREGA&#xA;&#x9;,SE_ID_DIAS_PROMESA&#xA;&#x9;,SE_ID_DIA_HABIL_ENTREGA&#xA;) AS (&#xA;&#x9;SELECT &#xA;&#x9;&#x9; C.G_NUMERO_GUIA&#xA;&#x9;&#x9;,F.FECHA SE_ID_FECHA_ENTREGA&#xA;&#x9;&#x9;,CONVERT(INT,C.TIEMPO_OFERTA_DIA) SE_ID_DIAS_PROMESA&#xA;&#x9;&#x9;,F.ID_DIA_HABIL SE_ID_DIA_HABIL_ENTREGA&#xA;&#x9;FROM  (&#xA;&#x9;&#x9;&#x9;SELECT &#xA;&#x9;&#x9;&#x9;&#x9; TMP.G_NUMERO_GUIA&#xA;&#x9;&#x9;&#x9;&#x9;,TMP.SE_FECHA&#xA;&#x9;&#x9;&#x9;&#x9;,G_ID_HABIL_SABADO&#xA;&#x9;&#x9;&#x9;&#x9;,ISNULL(R.TIEMPO_ENTREGA_COMERCIAL_DIA,0) TIEMPO_OFERTA_DIA&#xA;&#x9;&#x9;&#x9;&#x9;,SE_ID_DIA_HABIL&#xA;&#x9;&#x9;&#x9;&#x9;,SE_FECHA_HABIL&#xA;&#x9;&#x9;&#x9;FROM&#x9;TMP.GUIA_MASIVA_18 TMP WITH(NOLOCK) &#xA;&#x9;&#x9;&#x9;INNER JOIN &#x9;TMP.GUIA_MASIVA_RED_OPERATIVA_RUTA_ACTIVA_CU RA WITH(NOLOCK) &#xA;&#x9;&#x9;&#x9;&#x9;ON &#x9;TMP.G_ID_CIUDAD_ORIGEN = RA.ID_CIUDAD_ORIGEN&#xA;&#x9;&#x9;&#x9;&#x9;AND TMP.G_ID_CIUDAD_DESTINO = RA.ID_CIUDAD_DESTINO&#xA;&#x9;&#x9;&#x9;&#x9;AND CASE WHEN ISNULL(TMP.G_ID_TIEMPO,0) &lt;&gt; 0 THEN TMP.G_ID_TIEMPO ELSE 1 END = RA.ID_TIEMPO&#xA;&#x9;&#x9;&#x9;&#x9;AND CASE WHEN ISNULL(TMP.G_ID_MEDTRANS,0) &lt;&gt; 0 THEN TMP.G_ID_MEDTRANS ELSE 1 END = RA.ID_MEDTRANS&#xA;&#x9;&#x9;&#x9;INNER JOIN  TMP.GUIA_MASIVA_RED_OPERATIVA_RUTA_CU R WITH(NOLOCK) &#xA;&#x9;&#x9;&#x9;&#x9;ON &#x9;RA.ID_RUTA = R.ID_RUTA&#xA;&#x9;&#x9;) C &#xA;&#x9;INNER JOIN &#x9;TMP.GUIA_MASIVA_DHABIL_NO_SD F WITH(NOLOCK)&#xA;&#x9;&#x9;ON &#x9;CONVERT(INT,C.TIEMPO_OFERTA_DIA + C.SE_ID_DIA_HABIL) = F.ID_DIA_HABIL&#xA;&#x9;WHERE  C.G_ID_HABIL_SABADO = 0&#xA;)&#xA;&#xA;/***********************************/&#xA;UPDATE TMP&#xA;SET&#x9; SE_TIME_ID_FECHA_ENTREGA = CONVERT(INT,CONVERT(NUMERIC,CONVERT(DATETIME,CONVERT(CHAR(11),CTE.SE_ID_FECHA_ENTREGA))))&#xA;&#x9;,SE_ID_FECHA_ENTREGA = CTE.SE_ID_FECHA_ENTREGA&#xA;&#x9;,SE_FECHA_ENTREGA = CONVERT(VARCHAR,CTE.SE_ID_FECHA_ENTREGA,111)&#xA;&#x9;,SE_ID_DIAS_PROMESA = CTE.SE_ID_DIAS_PROMESA&#xA;&#x9;,SE_ID_DIA_HABIL_ENTREGA = CTE.SE_ID_DIA_HABIL_ENTREGA&#xA;FROM  TMP.GUIA_MASIVA_18 AS TMP &#xA;INNER JOIN CTE&#xA;&#x9;ON &#x9;TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA&#xA;GO&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\CUMPLIMIENTO AC Y DEPU\FECHA_ENTREGA"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{EE6216E3-36A6-4DBE-B59F-B9A1D0198BC5}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="FECHA_ENTREGA"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="WITH CTE(&#xA;&#x9;GUIA,&#xA;&#x9;FECHA&#xA;)AS(&#xA;&#x9;SELECT G_NUMERO_GUIA, MIN(FECHA_HORA_MOVIMIENTO)  &#xA;&#x9;FROM TMP.GUIA_MASIVA_18 WITH(NOLOCK)&#xA;&#x9;INNER JOIN TMP.GUIA_MASIVA_07 WITH(NOLOCK) ON NUMERO_GUIA = G_NUMERO_GUIA &#xA;&#x9;WHERE ID_PROCESO IN (5,6) &#xA;&#x9;GROUP BY G_NUMERO_GUIA&#xA;)&#xA;UPDATE TMP.GUIA_MASIVA_18&#xA;&#x9;SET SE_ID_FECHA = CONVERT(INT,CONVERT(NUMERIC,CONVERT(DATETIME,CONVERT(CHAR(11),FECHA)))),&#xA;&#x9;&#x9;SE_FECHA = FECHA&#xA;FROM TMP.GUIA_MASIVA_18  WITH(NOLOCK)&#xA;INNER JOIN CTE &#xA;ON GUIA = G_NUMERO_GUIA" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\CUMPLIMIENTO AC Y DEPU\GUIAS A VALIDAR"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Tarea Ejecutar SQL"
          DTS:DTSID="{ADE80956-3DC4-4891-ABFE-26DC6E86F6A2}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="GUIAS A VALIDAR"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="INSERT INTO [TMP].[GUIA_MASIVA_18] (&#xA;&#x9;G_NUMERO_GUIA, &#xA;&#x9;SE_ID_FECHA, &#xA;&#x9;SE_FECHA,&#xA;&#x9;G_ID_CIUDAD_ORIGEN,&#xA;&#x9;G_ID_CIUDAD_DESTINO,&#xA;&#x9;G_ID_CLIENTE,&#xA;&#x9;G_ID_TIEMPO,&#xA;&#x9;G_ID_MEDTRANS,&#xA;&#x9;G_ID_HABIL_SABADO,&#xA;&#x9;SE_PROCESO_ULTI,&#xA;&#x9;SE_ID_FECHA_ULTI,&#xA;&#x9;SE_FECHA_ULTI)&#xA;SELECT &#xA;&#x9; NUMERO_GUIA G_NUMERO_GUIA&#xA;&#x9;,0 SE_ID_FECHA&#xA;&#x9;,'1900-01-01' SE_FECHA&#xA;&#x9;,ISNULL(ID_CIUDAD_ORIGEN,-888) G_ID_CIUDAD_ORIGEN&#xA;&#x9;,ISNULL(ID_CIUDAD_DESTINO,-888) G_ID_CIUDAD_DESTINO&#xA;&#x9;,ISNULL(ID_CLIENTE,-888) G_ID_CLIENTE&#xA;&#x9;,ISNULL(CONVERT(INT,ID_TIEMPO),-888) G_ID_TIEMPO&#xA;&#x9;,ISNULL(CONVERT(INT,ID_MEDTRANS),-888) G_ID_MEDTRANS&#xA;&#x9;,0 G_ID_HABIL_SABADO&#xA;&#x9;,'ENTRADA ZONA URBANA' SE_PROCESO_ULTI&#xA;&#x9;,ISNULL(SE_FECHA_ENTREGA,'1900-01-01') SE_ID_FECHA_ULTI&#xA;&#x9;,CONVERT(VARCHAR,ISNULL(SE_FECHA_ENTREGA,'1900-01-01'),111) SE_FECHA_ULTI&#xA;FROM &#xA;&#x9;LOG.GUIAS G WITH(NOLOCK)&#xA;&#x9;INNER JOIN TMP.GUIA_MASIVA M WITH(NOLOCK) ON NUMERO_GUIA = G_NUMERO_GUIA" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\CUMPLIMIENTO AC Y DEPU\GUIAS NOVEDAD DEPURADA"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{10479D66-F2FB-4F7D-AD25-99093204BD40}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="GUIAS NOVEDAD DEPURADA"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="INSERT INTO [TMP].GUIA_MASIVA_22&#xA;           ([G_NUMERO_GUIA]&#xA;           ,[NOMBRE_TIPO_NOVEDAD]&#xA;           ,[NOMBRE_NOVEDAD]&#xA;           ,[RESP]&#xA;           ,[FECHA_HORA_MOVIMIENTO])&#xA;SELECT&#xA;&#x9; CLI.G_NUMERO_GUIA&#xA;&#x9;,TNO.NOMBRE_TIPO_NOVEDAD&#xA;&#x9;,TNO.NOMBRE_NOVEDAD&#xA;&#x9;,TNO.RESP&#xA;&#x9;,CLI.FECHA_HORA_MOVIMIENTO&#xA;FROM&#xA;&#x9;[LOG].[DETALLE_NOVEDAD_DIARIA] DETND WITH(NOLOCK)&#xA;INNER JOIN&#xA;&#x9;[LOG].[DOCUMENTOS_NOVEDAD_DIARIA] DOCND WITH(NOLOCK)&#xA;ON&#xA;&#x9;DETND.[ID_PAIS_UNO] = DOCND.[ID_PAIS_UNO]&#xA;AND&#xA;&#x9;DETND.ID_CIUDAD_UNO = DOCND.ID_CIUDAD_UNO&#xA;INNER JOIN&#xA;&#x9;[LOG].[NOVEDAD_DIARIA] ND WITH(NOLOCK)&#xA;ON&#xA;&#x9;DETND.[ID_PAIS_UNO] = ND.[ID_PAIS_UNO]&#xA;AND&#xA;&#x9;DETND.ID_CIUDAD_UNO = ND.ID_CIUDAD_UNO&#xA;INNER JOIN&#xA;&#x9;[PAR].[CLIECTVO_DEPU_NOVE] TNO&#xA;ON&#xA;&#x9;ND.[ID_TIPO_NOVEDAD] = TNO.ID_TIPO_NOVEDAD&#xA;INNER JOIN&#xA;&#x9;[TMP].GUIA_MASIVA_21 CLI&#xA;ON&#xA;&#x9;DOCND.[ID_PROCESO] = CLI.[ID_PROCESO]&#xA;AND&#x9; &#x9;&#x9;&#x9;&#x9;&#xA;&#x9;DOCND.[NUMERO_MOVIMI] = CLI.[NUMERO_MOVIMI]&#xA;AND&#x9;&#x9;&#x9;&#x9;&#xA;&#x9;DOCND.[CONSECUT_MOVIMI] = CLI.[CONSECUT_MOVIMI]&#xA;AND&#xA;&#x9;DETND.[PLACA_VEHICULO_DOCU] = CLI.[PLACA_VEHICULO_DOCU]&#xA;WHERE&#xA;&#x9;DETND.[FECHA_NOVEDAD] = DOCND.[FECHA_NOVEDAD]&#xA;AND&#xA;&#x9;DETND.[FECHA_NOVEDAD] = ND.[FECHA_NOVEDAD]" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\CUMPLIMIENTO AC Y DEPU\NOVEDADES Y PROCESOS DEPURADA"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{8F4F8580-E253-4C23-9F72-52EC1273E406}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="NOVEDADES Y PROCESOS DEPURADA"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="INSERT INTO [TMP].GUIA_MASIVA_24&#xA;           ([G_NUMERO_GUIA]&#xA;           ,[SE_DESC_PROC_DEPU]&#xA;           ,[SE_DESC_CONC_DEPU]&#xA;           ,[SE_DEPURADO_RESP]&#xA;           ,[FECHA_HORA_MOVIMIENTO])&#xA;SELECT&#xA;&#x9;&#x9; C.G_NUMERO_GUIA&#xA;&#x9;&#x9;,D.NOMBRE_PROCESO SE_DESC_PROC_DEPU&#xA;&#x9;&#x9;,D.NOMBRE_PROCESO SE_DESC_CONC_DEPU&#xA;&#x9;&#x9;,D.RESP SE_DEPURADO_RESP&#xA;&#x9;&#x9;,P.FECHA_HORA_MOVIMIENTO&#xA;&#x9;FROM&#xA;&#x9;&#x9;TMP.GUIA_MASIVA_18 C WITH(NOLOCK)&#xA;&#x9;INNER JOIN&#xA;&#x9;&#x9;TMP.GUIA_MASIVA_07 P WITH(NOLOCK)&#xA;&#x9;ON&#xA;&#x9;&#x9;C.G_NUMERO_GUIA = P.NUMERO_GUIA&#xA;&#x9;INNER JOIN&#xA;&#x9;&#x9;PAR.CLIECTVO_DEPU D&#xA;&#x9;ON&#xA;&#x9;&#x9;P.ID_PROCESO = D.ID_PROCESO&#xA;&#x9;AND&#xA;&#x9;&#x9;P.ID_CONCEPTO = D.ID_CONCEPTO&#xA;&#x9;WHERE&#xA;&#x9;&#x9;D.ES_DEPU = 1&#xA;&#x9;AND&#xA;&#x9;&#x9;C.SE_PROMESA_CUMPLE_DEPURADA = 'NO'&#xA;GO&#xA;&#xA;INSERT INTO [TMP].GUIA_MASIVA_24&#xA;           ([G_NUMERO_GUIA]&#xA;           ,[SE_DESC_PROC_DEPU]&#xA;           ,[SE_DESC_CONC_DEPU]&#xA;           ,[SE_DEPURADO_RESP]&#xA;           ,[FECHA_HORA_MOVIMIENTO])&#xA;&#x9;SELECT&#xA;&#x9;&#x9; C.G_NUMERO_GUIA&#xA;&#x9;&#x9;,N.NOMBRE_TIPO_NOVEDAD SE_DESC_PROC_DEPU&#xA;&#x9;&#x9;,N.NOMBRE_NOVEDAD SE_DESC_CONC_DEPU&#xA;&#x9;&#x9;,N.RESP SE_DEPURADO_RESP&#xA;&#x9;&#x9;,N.FECHA_HORA_MOVIMIENTO&#xA;&#x9;FROM&#xA;&#x9;&#x9;TMP.GUIA_MASIVA_18 C WITH(NOLOCK)&#xA;&#x9;INNER JOIN&#xA;&#x9;&#x9;TMP.GUIA_MASIVA_22 N WITH(NOLOCK)&#xA;&#x9;ON&#xA;&#x9;&#x9;C.G_NUMERO_GUIA = N.G_NUMERO_GUIA&#xA;&#x9;WHERE&#xA;&#x9;&#x9;C.SE_PROMESA_CUMPLE_DEPURADA = 'NO'&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\CUMPLIMIENTO AC Y DEPU\NOVEDADES Y PROCESOS DEPURADA PV"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{495C4201-41E0-4A3A-88B9-4EC99A6C9D15}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="NOVEDADES Y PROCESOS DEPURADA PV"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="INSERT INTO [TMP].GUIA_MASIVA_23&#xA;           ([G_NUMERO_GUIA]&#xA;           ,[SE_DESC_PROC_DEPU_PV]&#xA;           ,[SE_DESC_CONC_DEPU_PV]&#xA;           ,[SE_DEPURADO_RESP_PV]&#xA;           ,[FECHA_HORA_MOVIMIENTO])&#xA;SELECT&#xA;&#x9;&#x9; C.G_NUMERO_GUIA&#xA;&#x9;&#x9;,D.NOMBRE_PROCESO SE_DESC_PROC_DEPU_PV&#xA;&#x9;&#x9;,D.NOMBRE_CONCEPTO SE_DESC_CONC_DEPU_PV&#xA;&#x9;&#x9;,D.RESP SE_DEPURADO_RESP_PV&#xA;&#x9;&#x9;,P.FECHA_HORA_MOVIMIENTO&#xA;&#x9;FROM&#xA;&#x9;&#x9;TMP.GUIA_MASIVA_18 C WITH(NOLOCK)&#xA;&#x9;INNER JOIN&#xA;&#x9;&#x9;TMP.GUIA_MASIVA_07 P WITH(NOLOCK)&#xA;&#x9;ON&#xA;&#x9;&#x9;C.G_NUMERO_GUIA = P.NUMERO_GUIA&#xA;&#x9;INNER JOIN&#xA;&#x9;&#x9;PAR.CLIECTVO_DEPU D&#xA;&#x9;ON&#xA;&#x9;&#x9;P.ID_PROCESO = D.ID_PROCESO&#xA;&#x9;AND&#xA;&#x9;&#x9;P.ID_CONCEPTO = D.ID_CONCEPTO&#xA;&#x9;WHERE&#xA;&#x9;&#x9;D.ES_DEPU_PV = 1&#xA;&#x9;AND&#xA;&#x9;&#x9;C.SE_PROMESA_CUMPLE_PV_DEPURADA = 'NO'&#xA;GO&#xA;INSERT INTO [TMP].GUIA_MASIVA_23&#xA;           ([G_NUMERO_GUIA]&#xA;           ,[SE_DESC_PROC_DEPU_PV]&#xA;           ,[SE_DESC_CONC_DEPU_PV]&#xA;           ,[SE_DEPURADO_RESP_PV]&#xA;           ,[FECHA_HORA_MOVIMIENTO])&#xA;&#x9;SELECT&#xA;&#x9;&#x9; C.G_NUMERO_GUIA&#xA;&#x9;&#x9;,N.NOMBRE_TIPO_NOVEDAD SE_DESC_PROC_DEPU_PV&#xA;&#x9;&#x9;,N.NOMBRE_NOVEDAD SE_DESC_CONC_DEPU_PV&#xA;&#x9;&#x9;,N.RESP SE_DEPURADO_RESP_PV&#xA;&#x9;&#x9;,N.FECHA_HORA_MOVIMIENTO&#xA;&#x9;FROM&#xA;&#x9;&#x9;TMP.GUIA_MASIVA_18 C WITH(NOLOCK)&#xA;&#x9;INNER JOIN&#xA;&#x9;&#x9;TMP.GUIA_MASIVA_22 N WITH(NOLOCK)&#xA;&#x9;ON&#xA;&#x9;&#x9;C.G_NUMERO_GUIA = N.G_NUMERO_GUIA&#xA;&#x9;WHERE&#xA;&#x9;&#x9;C.SE_PROMESA_CUMPLE_PV_DEPURADA = 'NO'&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\CUMPLIMIENTO AC Y DEPU\OBTENER DIGITALIZACION"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{7441BAB3-F7A6-473B-B1F6-212095FDD947}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="OBTENER DIGITALIZACION"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="&#xA;UPDATE TMP&#xA;&#x9;SET&#x9; SE_ID_FECHA_DIG = ISNULL(PE.FECHA_DIGITALIZACION,'1900-01-01')&#xA;&#x9;&#x9;,SE_FECHA_DIG&#x9; = ISNULL(CONVERT(VARCHAR,PE.FECHA_DIGITALIZACION,111),'NO DISPONIBLE') &#xA;FROM  TMP.GUIA_MASIVA_18 AS TMP  WITH(NOLOCK)&#xA;INNER JOIN LOG.PRUEBAS_ENTREGA AS PE WITH(NOLOCK)&#xA;&#x9;ON TMP.G_NUMERO_GUIA = PE.NUMERO_GUIA&#xA;&#xA;&#xA;/*&#xA;WITH PRUEBAS_ENTREGA&#xA;(&#xA;&#x9; G_NUMERO_GUIA&#xA;&#x9;,SE_ID_FECHA_DIG&#xA;&#x9;,SE_FECHA_DIG&#xA;)&#xA;AS&#xA;(&#xA;&#x9;SELECT&#xA;&#x9;&#x9; TMP.G_NUMERO_GUIA&#xA;&#x9;&#x9;,ISNULL(PE.FECHA_DIGITALIZACION,'1900-01-01') SE_ID_FECHA_DIG&#xA;&#x9;&#x9;,ISNULL(CONVERT(VARCHAR,PE.FECHA_DIGITALIZACION,111),'NO DISPONIBLE') SE_FECHA_DIG&#xA;&#x9;FROM  TMP.GUIA_MASIVA_18 AS TMP  WITH(NOLOCK)&#xA;&#x9;INNER JOIN LOG.PRUEBAS_ENTREGA AS PE WITH(NOLOCK)&#xA;&#x9;&#x9;ON TMP.G_NUMERO_GUIA = PE.NUMERO_GUIA&#xA;)&#xA;&#xA;UPDATE TMP&#xA;&#x9;SET&#x9; SE_ID_FECHA_DIG = PE.SE_ID_FECHA_DIG&#xA;&#x9;&#x9;,SE_FECHA_DIG&#x9; = PE.SE_FECHA_DIG&#xA;FROM  TMP.GUIA_MASIVA_18 AS TMP  WITH(NOLOCK)&#xA;INNER JOIN PRUEBAS_ENTREGA AS PE WITH(NOLOCK)&#xA;&#x9;ON TMP.G_NUMERO_GUIA = PE.G_NUMERO_GUIA&#xA;*/" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\CUMPLIMIENTO AC Y DEPU\OBTENER INFO SISCLINET"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{BA3A931A-FF30-4F02-A1F7-1326E1424FFA}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="OBTENER INFO SISCLINET"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="WITH CTE (&#xA;&#x9; G_NUMERO_GUIA&#xA;&#x9;,G_DOCU_CLIENTE&#xA;&#x9;,G_ID_CIUDAD_ORIGEN&#xA;&#x9;,G_ID_CIUDAD_DESTINO&#xA;) AS (&#xA;&#x9;SELECT&#xA;&#x9;&#x9; TMP.G_NUMERO_GUIA&#xA;&#x9;&#x9;,ENV.Des_VlrCampoPersonalizado1 G_DOCU_CLIENTE&#xA;&#x9;&#x9;,ENV.Des_CiudadRemitente G_ID_CIUDAD_ORIGEN&#xA;&#x9;&#x9;,ENV.Des_Ciudad G_ID_CIUDAD_DESTINO&#xA;&#x9;FROM TMP.GUIA_MASIVA_18 AS TMP WITH(NOLOCK)&#xA;&#x9;INNER JOIN &#x9;SCN.SERT_ENVIO AS ENV WITH(NOLOCK)&#xA;&#x9;&#x9;ON &#x9;TMP.G_NUMERO_GUIA = ENV.Num_Guia&#xA;)&#xA;&#xA;UPDATE TMP&#xA;SET&#x9; G_DOCU_CLIENTE = ISNULL(CASE WHEN CTE.G_DOCU_CLIENTE &lt;&gt; '' THEN CTE.G_DOCU_CLIENTE ELSE NULL END,'NO DISPONIBLE')&#xA;&#x9;,G_ID_CIUDAD_ORIGEN = CASE WHEN ISNULL(CTE.G_ID_CIUDAD_ORIGEN,TMP.G_ID_CIUDAD_ORIGEN) &lt;&gt; 0 THEN ISNULL(CTE.G_ID_CIUDAD_ORIGEN,TMP.G_ID_CIUDAD_ORIGEN) ELSE -888 END&#xA;&#x9;,G_ID_CIUDAD_DESTINO = CASE WHEN ISNULL(CTE.G_ID_CIUDAD_DESTINO,TMP.G_ID_CIUDAD_DESTINO) &lt;&gt; 0 THEN ISNULL(CTE.G_ID_CIUDAD_DESTINO,TMP.G_ID_CIUDAD_DESTINO) ELSE -888 END&#xA;FROM TMP.GUIA_MASIVA_18 AS TMP WITH(NOLOCK)&#xA;INNER JOIN CTE&#xA;&#x9;ON &#x9;TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\CUMPLIMIENTO AC Y DEPU\PASO 30 20 CARGAR INFO MOV 2"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{97CE8C69-7DFB-4E7C-ADF7-B506555189DA}"
