        <SQLTask:SqlTaskData
          SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
          SQLTask:SqlStatementSource="/*Holman Estepa 25Sep22, Se crea este paquete para optimizar el ingreso de los datos de DG */&#xA;&#xA;/* INSERTA DATOS DE DIRECCIÓN GENERAL */&#xA;INSERT INTO [TMP].[GUIA_MASIVA_06]&#xA;           ([NUMERO_GUIA]&#xA;           ,[ID_PROCESO]&#xA;           ,[ID_CONCEPTO]&#xA;           ,[FECHA_HORA_MOVIMIENTO]&#xA;           ,[NUMERO_MOVIMI]&#xA;           ,[CONSECUT_MOVIMI])&#xA;SELECT [NUMERO_GUIA]&#xA;      ,[ID_PROCESO]&#xA;      ,[ID_CONCEPTO]&#xA;      ,[FECHA_HORA_MOVIMIENTO]&#xA;      ,[NUMERO_MOVIMI]&#xA;      ,[CONSECUT_MOVIMI]&#xA;  FROM [TMP].[GUIA_MASIVA_06_DG] WITH(NOLOCK);&#xA;&#xA;&#xA;/* INSERTA DATOS DE REGIONAL BOGOTA */&#xA;INSERT INTO [TMP].[GUIA_MASIVA_06]&#xA;           ([NUMERO_GUIA]&#xA;           ,[ID_PROCESO]&#xA;           ,[ID_CONCEPTO]&#xA;           ,[FECHA_HORA_MOVIMIENTO]&#xA;           ,[NUMERO_MOVIMI]&#xA;           ,[CONSECUT_MOVIMI])&#xA;SELECT [NUMERO_GUIA]&#xA;      ,[ID_PROCESO]&#xA;      ,[ID_CONCEPTO]&#xA;      ,[FECHA_HORA_MOVIMIENTO]&#xA;      ,[NUMERO_MOVIMI]&#xA;      ,[CONSECUT_MOVIMI]&#xA;  FROM [TMP].[GUIA_MASIVA_06_BOGO] WITH(NOLOCK);&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
