          SQLTask:SqlStatementSource="INSERT INTO TMP.GUIA_MASIVA_10&#xA;(&#xA;&#x9; ID&#xA;&#x9;,NUMERO_GUIA&#xA;&#x9;,ID_CONCEPTO&#xA;&#x9;,FECHA_HORA_MOVIMIENTO&#xA;)&#xA;SELECT &#xA;&#x9; ROW_NUMBER() OVER(PARTITION BY NUMERO_GUIA ORDER BY FECHA_HORA_MOVIMIENTO DESC) ID&#xA;&#x9;,NUMERO_GUIA&#xA;&#x9;,ID_CONCEPTO&#xA;&#x9;,FECHA_HORA_MOVIMIENTO&#xA;FROM &#xA;&#x9;TMP.GUIA_MASIVA_07 WITH (NOLOCK)&#xA;WHERE &#xA;ID_PROCESO = 10" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
