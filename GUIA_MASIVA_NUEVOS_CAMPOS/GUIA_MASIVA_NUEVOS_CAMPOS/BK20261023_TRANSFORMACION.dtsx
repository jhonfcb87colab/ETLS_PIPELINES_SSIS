      <DTS:Executables>
        <DTS:Executable
          DTS:refId="Package\CUMPLIMIENTO AC Y DEPU\ACTUALIZAR TMP BASE"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{FCA5F003-8DCD-4BF4-A0A0-9F506A45ABFB}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="ACTUALIZAR TMP BASE"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="UPDATE TMP.GUIA_MASIVA&#xA;&#x9;SET CUMPLE_TE_DEPURADA = G.SE_PROMESA_CUMPLE_DEPURADA,&#xA;&#x9;&#x9;CUMPLE_TE_ACIDA = G.SE_PROMESA_CUMPLE_ACIDA,&#xA;&#x9;&#x9;RES_INCU = G.SE_DEPURADO_RESP&#xA;FROM TMP.GUIA_MASIVA AS  T WITH(NOLOCK) &#xA;INNER JOIN TMP.GUIA_MASIVA_18 G WITH(NOLOCK) &#xA;&#x9;ON T.G_NUMERO_GUIA = G.G_NUMERO_GUIA" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\CUMPLIMIENTO AC Y DEPU\CALCULAR CUMPLIMIENTO DEPURADA"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{73BB435C-D526-4D5F-B0A5-30E6D868747C}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="CALCULAR CUMPLIMIENTO DEPURADA"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="WITH CTE&#xA;(&#xA;&#x9; ID&#xA;&#x9;,G_NUMERO_GUIA&#xA;&#x9;,SE_DESC_PROC_DEPU&#xA;&#x9;,SE_DESC_CONC_DEPU&#xA;&#x9;,SE_DEPURADO_RESP&#xA;)&#xA;AS&#xA;(&#xA;&#x9;SELECT&#xA;&#x9;&#x9; ROW_NUMBER() OVER(PARTITION BY G_NUMERO_GUIA ORDER BY FECHA_HORA_MOVIMIENTO) ID&#xA;&#x9;&#x9;,G_NUMERO_GUIA&#xA;&#x9;&#x9;,SE_DESC_PROC_DEPU&#xA;&#x9;&#x9;,SE_DESC_CONC_DEPU&#xA;&#x9;&#x9;,SE_DEPURADO_RESP&#xA;&#x9;FROM&#xA;&#x9;&#x9;TMP.GUIA_MASIVA_24 C WITH(NOLOCK)&#xA;)&#xA;&#xA;UPDATE [TMP].GUIA_MASIVA_18&#xA;SET&#x9; SE_PROMESA_CUMPLE_DEPURADA = CASE WHEN CTE.SE_DEPURADO_RESP IN ('E','C') THEN 'SI' ELSE C.SE_PROMESA_CUMPLE_DEPURADA END&#xA;&#x9;,SE_DESC_PROC_DEPU = CTE.SE_DESC_PROC_DEPU&#xA;&#x9;,SE_DESC_CONC_DEPU = CTE.SE_DESC_CONC_DEPU&#xA;&#x9;,SE_DEPURADO_RESP = CTE.SE_DEPURADO_RESP&#xA;FROM TMP.GUIA_MASIVA_18 AS C &#xA;INNER JOIN CTE&#xA;&#x9;ON &#x9;C.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA&#xA;&#x9;AND CTE.ID = 1" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\CUMPLIMIENTO AC Y DEPU\CALCULAR CUMPLIMIENTO DEPURADA PV"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{E58ED0D7-4B81-4C6E-9600-52EB3A483963}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="CALCULAR CUMPLIMIENTO DEPURADA PV"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="WITH CTE  (&#xA;&#x9; ID&#xA;&#x9;,G_NUMERO_GUIA&#xA;&#x9;,SE_DESC_PROC_DEPU_PV&#xA;&#x9;,SE_DESC_CONC_DEPU_PV&#xA;&#x9;,SE_DEPURADO_RESP_PV&#xA;) AS (&#xA;&#x9;SELECT&#xA;&#x9;&#x9; ROW_NUMBER() OVER(PARTITION BY G_NUMERO_GUIA ORDER BY FECHA_HORA_MOVIMIENTO) ID&#xA;&#x9;&#x9;,G_NUMERO_GUIA&#xA;&#x9;&#x9;,SE_DESC_PROC_DEPU_PV&#xA;&#x9;&#x9;,SE_DESC_CONC_DEPU_PV&#xA;&#x9;&#x9;,SE_DEPURADO_RESP_PV&#xA;&#x9;FROM&#xA;&#x9;&#x9;TMP.GUIA_MASIVA_23 C WITH(NOLOCK)&#xA;)&#xA;&#xA;UPDATE [TMP].GUIA_MASIVA_18&#xA;SET&#xA;&#x9; SE_DESC_PROC_DEPU_PV_01 = CTE.SE_DESC_PROC_DEPU_PV&#xA;&#x9;,SE_DESC_CONC_DEPU_PV_01 = CTE.SE_DESC_CONC_DEPU_PV&#xA;&#x9;,SE_DEPURADO_RESP_PV_01 = CTE.SE_DEPURADO_RESP_PV&#xA;FROM &#x9;TMP.GUIA_MASIVA_18 AS C INNER JOIN  CTE&#xA;&#x9;ON &#x9;C.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA&#xA;&#x9;AND &#x9;CTE.ID = 1&#xA;GO&#xA;&#xA;/************************************************/&#xA;WITH CTE (&#xA;&#x9; ID&#xA;&#x9;,G_NUMERO_GUIA&#xA;&#x9;,SE_DESC_PROC_DEPU_PV&#xA;&#x9;,SE_DESC_CONC_DEPU_PV&#xA;&#x9;,SE_DEPURADO_RESP_PV&#xA;)  AS (&#xA;&#x9;SELECT&#xA;&#x9;&#x9; ROW_NUMBER() OVER(PARTITION BY G_NUMERO_GUIA ORDER BY FECHA_HORA_MOVIMIENTO) ID&#xA;&#x9;&#x9;,G_NUMERO_GUIA&#xA;&#x9;&#x9;,SE_DESC_PROC_DEPU_PV&#xA;&#x9;&#x9;,SE_DESC_CONC_DEPU_PV&#xA;&#x9;&#x9;,SE_DEPURADO_RESP_PV&#xA;&#x9;FROM&#xA;&#x9;&#x9;TMP.GUIA_MASIVA_23 C WITH(NOLOCK)&#xA;&#x9;WHERE&#xA;&#x9;&#x9;SE_DESC_PROC_DEPU_PV &lt;&gt; 'CONTROL DE INVENTARIOS'&#xA;)&#xA;&#xA;UPDATE [TMP].GUIA_MASIVA_18&#xA;SET&#xA;&#x9; SE_DESC_PROC_DEPU_PV_02 = CTE.SE_DESC_PROC_DEPU_PV&#xA;&#x9;,SE_DESC_CONC_DEPU_PV_02 = CTE.SE_DESC_CONC_DEPU_PV&#xA;&#x9;,SE_DEPURADO_RESP_PV_02 = CTE.SE_DEPURADO_RESP_PV&#xA;FROM TMP.GUIA_MASIVA_18 AS C &#xA;INNER JOIN  CTE&#xA;&#x9;ON &#x9;C.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA&#xA;&#x9;AND &#x9;CTE.ID = 1&#xA;GO&#xA;&#xA;UPDATE [TMP].GUIA_MASIVA_18&#xA;SET&#xA;&#x9; SE_DESC_PROC_DEPU_PV_01 = SE_DESC_PROC_DEPU_PV_02&#xA;&#x9;,SE_DESC_CONC_DEPU_PV_01 = SE_DESC_CONC_DEPU_PV_02&#xA;&#x9;,SE_DEPURADO_RESP_PV_01 =  SE_DEPURADO_RESP_PV_02&#xA;WHERE&#xA;&#x9;SE_DESC_PROC_DEPU_PV_01 = 'CONTROL DE INVENTARIOS'&#xA;AND&#xA;&#x9;SE_DESC_PROC_DEPU_PV_02 &lt;&gt; 'NO DISPONIBLE'&#xA;GO&#xA;&#xA;&#xA;UPDATE [TMP].GUIA_MASIVA_18&#xA;SET&#xA;&#x9; SE_PROMESA_CUMPLE_PV_DEPURADA = CASE WHEN SE_DEPURADO_RESP_PV_01 IN ('E','C') THEN 'SI' ELSE SE_PROMESA_CUMPLE_PV_DEPURADA END&#xA;&#x9;,SE_DESC_PROC_DEPU_PV = SE_DESC_PROC_DEPU_PV_01&#xA;&#x9;,SE_DESC_CONC_DEPU_PV = SE_DESC_CONC_DEPU_PV_01&#xA;&#x9;,SE_DEPURADO_RESP_PV = SE_DEPURADO_RESP_PV_01&#xA;WHERE&#xA;&#x9;SE_DESC_PROC_DEPU_PV_01 &lt;&gt; 'NO DISPONIBLE'&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\CUMPLIMIENTO AC Y DEPU\COMPENSACIONES"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{82FC5AE7-5BD7-46B3-A98B-F7E7A55DB313}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="COMPENSACIONES"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="UPDATE [TMP].GUIA_MASIVA_18&#xA;&#x9;SET  SE_PROCESO_ULTI = 'COMPENSACIONES'&#xA;FROM  TMP.GUIA_MASIVA_18 AS C &#xA;INNER JOIN (&#xA;&#x9;SELECT &#x9;NUMERO_GUIA AS G_NUMERO_GUIA&#xA;&#x9;FROM ( &#xA;&#x9;&#x9;SELECT &#xA;&#x9;&#x9;&#x9;NUMERO_GUIA&#xA;&#x9;&#x9;&#x9;,ID_PROCESO&#xA;&#x9;&#x9;&#x9;,NUMERO_MOVIMI&#xA;&#x9;&#x9;&#x9;,CONSECUT_MOVIMI&#xA;&#x9;&#x9;FROM&#xA;&#x9;&#x9;&#x9;TMP.GUIA_MASIVA_07 WITH(NOLOCK)&#xA;&#x9;&#x9;WHERE&#xA;&#x9;&#x9;&#x9;ID_PROCESO = 8&#xA;&#x9;) CTE &#xA;&#x9;INNER JOIN  LOG.DOCUMENTOS AS D WITH(NOLOCK)&#xA;&#x9;ON &#x9;D.ID_DIVISION_DESTINO IN (9209/*COMP NACIONAL NO BTA*/,9238/*COMP BTA*/,9209/*REZAGOS BTA*/)&#xA;&#x9;&#x9;AND CTE.ID_PROCESO = D.ID_PROCESO&#xA;&#x9;&#x9;AND CTE.NUMERO_MOVIMI = D.NUMERO_MOVIMI&#xA;&#x9;&#x9;AND CTE.CONSECUT_MOVIMI = D.CONSECUT_MOVIMI&#xA;) CTE2&#xA;ON &#x9;C.G_NUMERO_GUIA = CTE2.G_NUMERO_GUIA" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\CUMPLIMIENTO AC Y DEPU\CUMPLE ACIDA PRIMERA VISITA"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{C685BE9A-CA69-4080-9484-3BC0C3FCDC21}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="CUMPLE ACIDA PRIMERA VISITA"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="WITH CTE  (&#xA;&#x9; G_NUMERO_GUIA&#xA;&#x9;,CUMPLE&#xA;) AS (&#xA;&#x9;SELECT&#xA;&#x9;&#x9; G_NUMERO_GUIA&#xA;&#x9;&#x9;,CASE &#xA;&#x9;&#x9;&#x9;WHEN (CONVERT(DATE,SE_ID_FECHA_PRIMGEST) &lt;= CONVERT(DATE,SE_ID_FECHA_ENTREGA)) AND SE_PROCESO_PRIMGEST = 'DEVOLUCION ZONA URBANA' THEN&#xA;&#x9;&#x9;&#x9;&#x9;CASE WHEN SE_ID_FECHA_PRIMGEST = SE_ID_FECHA_DZU_CE THEN 'SI' ELSE 'NO' END&#xA;&#x9;&#x9;&#x9;WHEN (CONVERT(DATE,SE_ID_FECHA_PRIMGEST) &lt;= CONVERT(DATE,SE_ID_FECHA_ENTREGA)) AND SE_PROCESO_PRIMGEST = 'REPORTADO DEVUELTO' THEN&#xA;&#x9;&#x9;&#x9;&#x9;CASE WHEN SE_ID_FECHA_PRIMGEST = SE_ID_FECHA_RD_CE THEN 'SI' ELSE 'NO' END&#xA;&#x9;&#x9;&#x9;WHEN CONVERT(DATE,SE_ID_FECHA_PRIMGEST) &lt;= CONVERT(DATE,SE_ID_FECHA_ENTREGA) THEN&#xA;&#x9;&#x9;&#x9;&#x9;'SI' &#xA;&#x9;&#x9;&#x9;ELSE &#xA;&#x9;&#x9;&#x9;&#x9;'NO' &#xA;&#x9;&#x9; END [CUMPLE]&#xA;&#x9;FROM&#xA;&#x9;&#x9;[TMP].[GUIA_MASIVA_18] WITH(NOLOCK)&#xA;&#x9;WHERE&#xA;&#x9;&#x9;SE_ID_FECHA_ENTREGA &lt;&gt; '1900-01-01'&#xA;&#x9;AND&#xA;&#x9;&#x9;SE_ID_FECHA_PRIMGEST &lt;&gt; '1900-01-01'&#xA;)&#xA;&#xA;UPDATE TMP&#xA;SET&#x9; [SE_PROMESA_CUMPLE_PV_ACIDA]&#x9;&#x9;= CTE.CUMPLE&#xA;&#x9;,[SE_PROMESA_CUMPLE_PV_DEPURADA]&#x9;= CTE.CUMPLE&#xA;&#x9;,[SE_PROMESA_PENALI_PV_ACIDA] = CASE WHEN CONVERT(DATE,SE_ID_FECHA_PRIMGEST) &gt; CONVERT(DATE,SE_ID_FECHA_ENTREGA) THEN &#xA;&#x9;&#x9;CASE &#xA;&#x9;&#x9;&#x9;WHEN (SE_ID_DIA_HABIL_PRIMGEST - SE_ID_DIA_HABIL_ENTREGA) = 1 THEN '1 DÍA'&#xA;&#x9;&#x9;&#x9;WHEN (SE_ID_DIA_HABIL_PRIMGEST - SE_ID_DIA_HABIL_ENTREGA) = 2 THEN '2 DÍAS'&#xA;&#x9;&#x9;&#x9;WHEN (SE_ID_DIA_HABIL_PRIMGEST - SE_ID_DIA_HABIL_ENTREGA) &gt;= 3 AND (SE_ID_DIA_HABIL_PRIMGEST - SE_ID_DIA_HABIL_ENTREGA) &lt; 6 THEN '3-5 DÍAS'&#xA;&#x9;&#x9;&#x9;WHEN (SE_ID_DIA_HABIL_PRIMGEST - SE_ID_DIA_HABIL_ENTREGA) &gt;= 6 AND (SE_ID_DIA_HABIL_PRIMGEST - SE_ID_DIA_HABIL_ENTREGA) &lt; 11 THEN '6-10 DÍAS'&#xA;&#x9;&#x9;&#x9;ELSE 'MAYOR A 10 DÍAS' END&#xA;&#x9; ELSE 'NO DISPONIBLE' END&#xA;FROM  TMP.GUIA_MASIVA_18 AS TMP  WITH(NOLOCK)&#xA;INNER JOIN  CTE&#xA;&#x9;ON &#x9;TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA&#xA;&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\CUMPLIMIENTO AC Y DEPU\CUMPLE PROMESA ACIDA"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{3534AFC9-465F-4D1A-A748-833E92677CEE}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="CUMPLE PROMESA ACIDA"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="WITH CTE (&#xA;&#x9; ID&#xA;&#x9;,G_NUMERO_GUIA&#xA;&#x9;,SE_PROCESO_REP_ENTREGA&#xA;&#x9;,SE_ID_FECHA_REP_ENTREGA&#xA;&#x9;,SE_FECHA_REP_ENTREGA&#xA;) AS (&#xA;&#x9;SELECT &#xA;&#x9;&#x9; ROW_NUMBER() OVER(PARTITION BY G_NUMERO_GUIA ORDER BY FECHA) ID&#xA;&#x9;&#x9;,G_NUMERO_GUIA&#xA;&#x9;&#x9;,PROCESO SE_PROCESO_REP_ENTREGA&#xA;&#x9;&#x9;,FECHA SE_ID_FECHA_REP_ENTREGA&#xA;&#x9;&#x9;,ISNULL(CONVERT(VARCHAR,FECHA,111),'NO DISPONIBLE') SE_FECHA_REP_ENTREGA&#xA;&#x9;FROM   &#xA;&#x9;   (&#xA;&#x9;&#x9;SELECT &#xA;&#x9;&#x9;&#x9; [G_NUMERO_GUIA]&#xA;&#x9;&#x9;&#x9;,[SE_ID_FECHA_RE] [REPORTADO ENTREGADO]&#xA;&#x9;&#x9;&#x9;,[SE_ID_FECHA_EV] [ENTREGA VERIFICADA]&#xA;&#x9;&#x9;FROM&#xA;&#x9;&#x9;&#x9;[TMP].[GUIA_MASIVA_18]&#xA;&#x9;&#x9;WHERE&#xA;&#x9;&#x9;&#x9;[SE_FECHA_RE] &lt;&gt; 'NO DISPONIBLE'&#xA;&#x9;&#x9;OR&#xA;&#x9;&#x9;&#x9;[SE_FECHA_EV] &lt;&gt; 'NO DISPONIBLE'&#xA;&#x9;&#x9;) p  &#xA;&#x9;UNPIVOT (FECHA FOR PROCESO IN   &#xA;&#x9;&#x9;(&#xA;&#x9;&#x9;&#x9; [REPORTADO ENTREGADO]&#xA;&#x9;&#x9;&#x9;,[ENTREGA VERIFICADA]&#xA;&#x9;&#x9;)  &#xA;&#x9;)AS UNPVT&#xA;&#x9;WHERE&#xA;&#x9;&#x9;FECHA &lt;&gt; '1900-01-01'&#xA;)&#xA;&#xA;UPDATE TMP&#xA;SET&#x9; SE_PROCESO_REP_ENTREGA = CTE.SE_PROCESO_REP_ENTREGA&#xA;&#x9;,SE_ID_FECHA_REP_ENTREGA = CTE.SE_ID_FECHA_REP_ENTREGA&#xA;&#x9;,SE_FECHA_REP_ENTREGA = CTE.SE_FECHA_REP_ENTREGA&#xA;FROM  TMP.GUIA_MASIVA_18 AS TMP&#xA;INNER JOIN CTE&#xA;&#x9;ON TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA&#xA;&#x9;AND CTE.ID = 1&#xA;GO&#xA;&#xA;UPDATE [TMP].[GUIA_MASIVA_18]&#xA;SET  SE_PROCESO_REP_ENTREGA = 'DIGITALIZADA'&#xA;&#x9;,SE_ID_FECHA_REP_ENTREGA = SE_ID_FECHA_PRIMGEST&#xA;&#x9;,SE_FECHA_REP_ENTREGA = SE_FECHA_PRIMGEST&#xA;FROM TMP.GUIA_MASIVA_18&#xA;WHERE SE_PROCESO_PRIMGEST = 'DIGITALIZADA'&#xA;GO&#xA;&#xA;UPDATE  [TMP].[GUIA_MASIVA_18]&#xA;SET   [SE_PROMESA_CUMPLE_ACIDA] = CASE WHEN CONVERT(DATE,SE_ID_FECHA_REP_ENTREGA) &lt;= CONVERT(DATE,SE_ID_FECHA_ENTREGA) THEN 'SI' ELSE 'NO' END&#xA;&#x9; ,[SE_PROMESA_CUMPLE_DEPURADA] = CASE WHEN CONVERT(DATE,SE_ID_FECHA_REP_ENTREGA) &lt;= CONVERT(DATE,SE_ID_FECHA_ENTREGA) THEN 'SI' ELSE 'NO' END&#xA;WHERE SE_ID_FECHA_ENTREGA &lt;&gt; '1900-01-01'&#xA;AND  SE_ID_FECHA_REP_ENTREGA &lt;&gt; '1900-01-01'" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\CUMPLIMIENTO AC Y DEPU\DIA HABIL EZU NO DOM"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{702CEA6B-24A4-470C-A2C2-EF3D591197B6}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="DIA HABIL EZU NO DOM"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="WITH CTE (&#xA;&#x9; G_NUMERO_GUIA&#x9; &#xA;&#x9;,SE_ID_DIA_HABIL&#xA;&#x9;,SE_FECHA_HABIL&#xA;) AS (&#xA;&#x9;SELECT&#xA;&#x9;&#x9; C.G_NUMERO_GUIA G_NUMERO_GUIA&#x9; &#xA;&#x9;&#x9;,F.ID_DIA_HABIL SE_ID_DIA_HABIL&#xA;&#x9;&#x9;,F.FECHA SE_FECHA_HABIL&#xA;&#x9;FROM  TMP.GUIA_MASIVA_18 C WITH(NOLOCK)&#xA;&#x9;INNER JOIN TMP.GUIA_MASIVA_DHABIL_NO_D F WITH(NOLOCK)&#xA;&#x9;&#x9;ON  CONVERT(DATE,C.SE_FECHA) =  F.FECHA&#xA;&#x9;WHERE  C.G_ID_HABIL_SABADO = 1&#xA;)&#xA;&#xA;UPDATE TMP&#xA;SET  SE_ID_DIA_HABIL = CTE.SE_ID_DIA_HABIL&#xA;&#x9;,SE_FECHA_HABIL = CTE.SE_FECHA_HABIL&#xA;FROM TMP.GUIA_MASIVA_18 AS TMP&#xA;INNER JOIN CTE&#xA;&#x9;ON TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA&#xA;GO&#xA;&#xA;/**********************************************/&#xA;WITH CTE (&#xA;&#x9; G_NUMERO_GUIA&#x9; &#xA;&#x9;,SE_ID_DIA_HABIL&#xA;&#x9;,SE_FECHA_HABIL&#xA;)  AS (&#xA;&#x9;SELECT &#xA;&#x9;&#x9; C.G_NUMERO_GUIA G_NUMERO_GUIA&#xA;&#x9;&#x9;,(SELECT TOP 1 ID_DIA_HABIL FROM TMP.GUIA_MASIVA_DHABIL_NO_D F WITH(NOLOCK) WHERE F.FECHA &gt;= CONVERT(DATE,C.SE_FECHA)) SE_ID_DIA_HABIL&#xA;&#x9;&#x9;,(SELECT TOP 1 F.FECHA FROM TMP.GUIA_MASIVA_DHABIL_NO_D F WITH(NOLOCK) WHERE F.FECHA &gt;= CONVERT(DATE,C.SE_FECHA)) SE_FECHA_HABIL&#xA;&#x9;FROM  TMP.GUIA_MASIVA_18 AS C WITH(NOLOCK)&#xA;&#x9;WHERE &#x9;SE_ID_DIA_HABIL = 0&#xA;&#x9;AND &#x9;G_ID_HABIL_SABADO = 1&#xA;)&#xA;&#xA;UPDATE TMP&#xA;SET  SE_ID_DIA_HABIL = CTE.SE_ID_DIA_HABIL&#xA;&#x9;,SE_FECHA_HABIL = CTE.SE_FECHA_HABIL&#xA;FROM TMP.GUIA_MASIVA_18 TMP&#xA;INNER JOIN CTE&#xA;&#x9;ON &#x9;TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA&#xA;GO&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\CUMPLIMIENTO AC Y DEPU\DIA HABIL EZU NO SAB Y DOM"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{BF471073-0979-4A28-B0E3-B52B6A067C98}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="DIA HABIL EZU NO SAB Y DOM"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="WITH CTE  (&#xA;&#x9; G_NUMERO_GUIA&#x9; &#xA;&#x9;,SE_ID_DIA_HABIL&#xA;&#x9;,SE_FECHA_HABIL&#xA;)  AS (&#xA;&#x9;SELECT&#xA;&#x9;&#x9; C.G_NUMERO_GUIA G_NUMERO_GUIA&#x9; &#xA;&#x9;&#x9;,F.ID_DIA_HABIL SE_ID_DIA_HABIL&#xA;&#x9;&#x9;,F.FECHA SE_FECHA_HABIL&#xA;&#x9;FROM  TMP.GUIA_MASIVA_18 AS C WITH(NOLOCK)&#xA;&#x9;INNER JOIN TMP.GUIA_MASIVA_DHABIL_NO_SD AS F WITH(NOLOCK)&#xA;&#x9;&#x9;ON  CONVERT(DATE,C.SE_FECHA) =  F.FECHA&#xA;&#x9;WHERE C.G_ID_HABIL_SABADO = 0&#xA;)&#xA;&#xA;UPDATE  [TMP].[GUIA_MASIVA_18]&#xA;&#x9;SET  SE_ID_DIA_HABIL = CTE.SE_ID_DIA_HABIL&#xA;&#x9;&#x9;,SE_FECHA_HABIL = CTE.SE_FECHA_HABIL&#xA;FROM TMP.GUIA_MASIVA_18 AS TMP &#xA;INNER JOIN CTE&#xA;&#x9;ON TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA&#xA;GO&#xA;&#xA;/****************************/&#xA;WITH CTE  (&#xA;&#x9; G_NUMERO_GUIA&#x9; &#xA;&#x9;,SE_ID_DIA_HABIL&#xA;&#x9;,SE_FECHA_HABIL&#xA;) AS (&#xA;&#x9;SELECT &#xA;&#x9;&#x9; C.G_NUMERO_GUIA G_NUMERO_GUIA&#xA;&#x9;&#x9;,(SELECT TOP 1 ID_DIA_HABIL FROM TMP.GUIA_MASIVA_DHABIL_NO_SD F WITH(NOLOCK) WHERE F.FECHA &gt;= CONVERT(DATE,C.SE_FECHA)) SE_ID_DIA_HABIL&#xA;&#x9;&#x9;,(SELECT TOP 1 F.FECHA FROM TMP.GUIA_MASIVA_DHABIL_NO_SD F WITH(NOLOCK) WHERE F.FECHA &gt;= CONVERT(DATE,C.SE_FECHA)) SE_FECHA_HABIL&#xA;&#x9;FROM TMP.GUIA_MASIVA_18 C WITH(NOLOCK)&#xA;&#x9;WHERE SE_ID_DIA_HABIL = 0&#xA;&#x9;AND  G_ID_HABIL_SABADO = 0&#xA;)&#xA;&#xA;UPDATE TMP&#xA;&#x9;SET  SE_ID_DIA_HABIL = CTE.SE_ID_DIA_HABIL&#xA;&#x9;&#x9;,SE_FECHA_HABIL = CTE.SE_FECHA_HABIL&#xA;FROM TMP.GUIA_MASIVA_18 TMP&#xA;INNER JOIN CTE&#xA;&#x9;ON TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\CUMPLIMIENTO AC Y DEPU\DIA HABIL NO DOM"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{D1C07CA6-F1F6-44E5-9C5B-6B052112610F}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="DIA HABIL NO DOM"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="WITH CTE  (&#xA;&#x9; G_NUMERO_GUIA&#x9; &#xA;&#x9;,SE_ID_DIA_HABIL_PRIMGEST&#xA;) AS (&#xA;&#x9;SELECT&#xA;&#x9;&#x9; C.G_NUMERO_GUIA G_NUMERO_GUIA&#x9; &#xA;&#x9;&#x9;,F.ID_DIA_HABIL SE_ID_DIA_HABIL_PRIMGEST&#xA;&#x9;FROM TMP.GUIA_MASIVA_18 C WITH(NOLOCK)&#xA;&#x9;INNER JOIN TMP.GUIA_MASIVA_DHABIL_NO_D F WITH(NOLOCK)&#xA;&#x9;&#x9;ON  CONVERT(DATE,C.SE_ID_FECHA_PRIMGEST) =  F.FECHA&#xA;&#x9;WHERE C.G_ID_HABIL_SABADO = 1&#xA;&#x9;AND  SE_ID_FECHA_PRIMGEST &lt;&gt; '1900-01-01'&#xA;)&#xA;&#xA;UPDATE [TMP].[GUIA_MASIVA_18]&#xA;&#x9;SET SE_ID_DIA_HABIL_PRIMGEST = CTE.SE_ID_DIA_HABIL_PRIMGEST&#xA;FROM TMP.GUIA_MASIVA_18 AS TMP  &#xA;INNER JOIN CTE&#xA;&#x9;ON TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA&#xA;GO&#xA;&#xA;/********************************************/&#xA;WITH CTE (&#xA;&#x9; G_NUMERO_GUIA&#x9; &#xA;&#x9;,SE_ID_DIA_HABIL_PRIMGEST&#xA;)  AS (&#xA;&#x9;SELECT &#xA;&#x9;&#x9; C.G_NUMERO_GUIA G_NUMERO_GUIA&#xA;&#x9;&#x9;,( SELECT TOP 1 ID_DIA_HABIL &#xA;&#x9;&#x9;&#x9;FROM TMP.GUIA_MASIVA_DHABIL_NO_D F WITH(NOLOCK) &#xA;&#x9;&#x9;&#x9;WHERE F.FECHA &gt;= CONVERT(DATE,C.SE_ID_FECHA_PRIMGEST)&#xA;&#x9;&#x9; ) SE_ID_DIA_HABIL_PRIMGEST&#xA;&#x9;FROM TMP.GUIA_MASIVA_18 AS C WITH(NOLOCK)&#xA;&#x9;WHERE SE_ID_DIA_HABIL_PRIMGEST = 0&#xA;&#x9;AND&#x9;C.G_ID_HABIL_SABADO = 1&#xA;&#x9;AND&#xA;&#x9;&#x9;SE_ID_FECHA_PRIMGEST &lt;&gt; '1900-01-01'&#xA;)&#xA;&#xA;UPDATE [TMP].[GUIA_MASIVA_18]&#xA;&#x9;SET  SE_ID_DIA_HABIL_PRIMGEST = CTE.SE_ID_DIA_HABIL_PRIMGEST&#xA;FROM  TMP.GUIA_MASIVA_18 AS TMP&#xA;INNER JOIN CTE&#xA;&#x9;ON &#x9;TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
