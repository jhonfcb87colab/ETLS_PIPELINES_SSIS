      DTS:LocaleID="-1"
      DTS:ObjectName="PASO 28 ACTUALIZAR TAREAS"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:LoggingOptions
        DTS:FilterKind="0" />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
          SQLTask:SqlStatementSource="WITH CTE &#xA;(&#xA;&#x9; G_NUMERO_GUIA&#xA;&#x9;,TAR_ENVI_TAREA&#xA;&#x9;,TAR_ID_ESTADO_TAREA&#xA;&#x9;,TAR_ESTADO_TAREA&#xA;)  AS  (&#xA;&#x9;SELECT&#xA;&#x9;&#x9; TMP.G_NUMERO_GUIA&#xA;&#x9;&#x9;, 'SI' TAR_ENVI_TAREA&#xA;&#x9;&#x9;,TMP13.TAR_ID_ESTADO_TAREA&#xA;&#x9;&#x9;,TMP13.TAR_ESTADO_TAREA&#xA;&#x9;FROM  &#x9;TMP.GUIA_MASIVA TMP WITH (NOLOCK)&#xA;&#x9;INNER JOIN  TMP.GUIA_MASIVA_13 TMP13 WITH (NOLOCK)&#xA;&#x9;ON &#x9;TMP.G_NUMERO_GUIA = TMP13.NUMERO_GUIA&#xA;)&#xA;/*****************/&#xA;UPDATE &#x9;TMP&#xA;SET  TAR_ENVI_TAREA = CTE.TAR_ENVI_TAREA&#xA;&#x9;,TAR_ID_ESTADO_TAREA = CTE.TAR_ID_ESTADO_TAREA&#xA;&#x9;,TAR_ESTADO_TAREA =  CTE.TAR_ESTADO_TAREA&#xA;FROM  TMP.GUIA_MASIVA TMP WITH (NOLOCK)&#xA;INNER JOIN CTE&#xA;&#x9;ON TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\PASO 29 ACTUALIZAR DESCRIPTIVOS"
