        <SQLTask:SqlTaskData
          SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
          SQLTask:SqlStatementSource="  WITH CTE &#xA;(&#xA;&#x9; G_NUMERO_GUIA&#xA;&#x9;,MPE_ENVI_PQR&#xA;&#x9;,MPE_ID_ESTADO_PQR&#xA;&#x9;,MPE_ESTADO_PQR&#xA;) AS (&#xA;&#x9;SELECT&#xA;&#x9;&#x9; TMP.G_NUMERO_GUIA&#xA;&#x9;&#x9;, 'SI' MPE_ENVI_PQR&#xA;&#x9;&#x9;,TMP12.MPE_ID_ESTADO_PQR&#xA;&#x9;&#x9;,TMP12.MPE_ESTADO_PQR&#xA;&#x9;FROM &#xA;&#x9;&#x9;TMP.GUIA_MASIVA TMP WITH (NOLOCK)&#xA;&#x9;INNER JOIN &#xA;&#x9;&#x9;TMP.GUIA_MASIVA_12 TMP12 WITH (NOLOCK)&#xA;&#x9;ON&#xA;&#x9;&#x9;TMP.G_NUMERO_GUIA = TMP12.NUMERO_GUIA&#xA;)&#xA;UPDATE&#xA;&#x9;TMP&#xA;SET&#xA;&#x9; MPE_ENVI_PQR = CTE.MPE_ENVI_PQR&#xA;&#x9;,MPE_ID_ESTADO_PQR = CTE.MPE_ID_ESTADO_PQR&#xA;&#x9;,MPE_ESTADO_PQR =  CTE.MPE_ESTADO_PQR&#xA;FROM &#xA;&#x9;TMP.GUIA_MASIVA AS TMP WITH (NOLOCK)&#xA;&#x9;INNER JOIN CTE&#xA;ON  &#xA;TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
