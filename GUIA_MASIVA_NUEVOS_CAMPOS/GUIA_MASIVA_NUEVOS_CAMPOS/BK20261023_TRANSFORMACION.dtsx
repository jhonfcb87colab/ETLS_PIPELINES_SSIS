      <DTS:Executables>
        <DTS:Executable
          DTS:refId="Package\PASO 23 ACTUALIZAR NOVEDADES\PASO 23 01 OBTENER NOVEDAD"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{F4D2EFB4-6AC5-4D70-8518-ECF234EC158C}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="PASO 23 01 OBTENER NOVEDAD"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="WITH CTE &#xA;(&#xA;&#x9; ID&#xA;&#x9;,G_NUMERO_GUIA&#xA;&#x9;,G_NOVEDAD&#xA;&#x9;,G_FECHA_NOVEDAD&#xA;&#x9;&#xA;)&#xA;AS&#xA;(&#xA;SELECT &#xA;&#x9; ROW_NUMBER() OVER(PARTITION BY NOV.G_NUMERO_GUIA ORDER BY NOV.DETND_FECHA_NOVEDAD DESC) ID&#xA;&#x9;,TMP.G_NUMERO_GUIA&#xA;&#x9;,NOV.G_NOVEDAD+' - '+NOV.G_TIPO_NOVEDAD+' - '+NOV.G_SUB_NOVEDAD AS G_NOVEDAD&#xA;&#x9;,NOV.DETND_FECHA_NOVEDAD&#xA;&#x9;&#xA;FROM &#xA;&#x9;TMP.GUIA_MASIVA_NOVEDADES NOV WITH (NOLOCK)&#xA;INNER JOIN &#xA;&#x9;TMP.GUIA_MASIVA TMP WITH (NOLOCK)&#xA;ON &#xA;&#x9;NOV.G_NUMERO_GUIA = TMP.G_NUMERO_GUIA&#xA;)&#xA;&#xA;&#xA;INSERT INTO TMP.GUIA_MASIVA_11&#xA;(&#xA;&#x9; ID&#xA;&#x9;,G_NUMERO_GUIA&#xA;&#x9;,G_NOVEDAD&#xA;&#x9;,G_FECHA_NOVEDAD&#xA;)&#xA;SELECT &#xA;&#x9; CTE.ID&#xA;&#x9;,CTE.G_NUMERO_GUIA&#xA;&#x9;,CTE.G_NOVEDAD&#xA;&#x9;,CTE.G_FECHA_NOVEDAD&#xA;FROM &#xA;CTE" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\PASO 23 ACTUALIZAR NOVEDADES\PASO 23 02 NOVEDAD OPERATIVA 1"
