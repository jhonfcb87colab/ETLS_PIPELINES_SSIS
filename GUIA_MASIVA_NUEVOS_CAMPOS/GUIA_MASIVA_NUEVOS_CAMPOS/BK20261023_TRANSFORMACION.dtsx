    <DTS:Executable
      DTS:refId="Package\PASO 28 ACTUALIZAR TAREAS"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{46AACA37-242D-49FC-96B7-743C64895E0F}"
