    <DTS:Executable
      DTS:refId="Package\PASO 11 OBTENER LA ULTIMA CIUDAD DE MOVIMIENTO Y ZONA"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{7FBD36E2-919A-4A06-AD75-803E7B72B13E}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="PASO 11 OBTENER LA ULTIMA CIUDAD DE MOVIMIENTO Y ZONA"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:LoggingOptions
        DTS:FilterKind="0" />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
          SQLTask:SqlStatementSource="WITH CTE&#xA;( #ROW,&#xA;&#x9; G_NUMERO_GUIA&#xA;&#x9;,ID_PROCESO&#xA;&#x9;,NUMERO_MOVIMI&#xA;&#x9;,CONSECUT_MOVIMI&#xA;&#x9;,SE_ID_ULTI&#xA;&#x9;--,BODEGA_ULTI_MOVI&#xA;&#x9;--,ID_BODEGA_ULTI_MOVI&#xA;)&#xA;AS&#xA;&#x9;(&#xA;&#x9;&#x9;SELECT ROW_NUMBER() OVER (PARTITION BY TMP.G_NUMERO_GUIA ORDER BY TMP07.FECHA_HORA_MOVIMIENTO DESC ) AS #ROW,&#xA;&#x9;&#x9;&#x9; TMP.G_NUMERO_GUIA&#xA;&#x9;&#x9;&#x9;,TMP07.ID_PROCESO&#xA;&#x9;&#x9;&#x9;,TMP07.NUMERO_MOVIMI&#xA;&#x9;&#x9;&#x9;,TMP07.CONSECUT_MOVIMI&#xA;&#x9;&#x9;&#x9;,TMP.SE_ID_ULTI&#xA;&#x9;&#x9;&#x9;--,TMP.G_BODEGA_ULTM_MOVI&#xA;&#x9;&#x9;&#x9;--,TMP.G_ID_BODEGA_ULTM_MOVI&#xA;&#x9;&#x9;FROM &#xA;&#x9;&#x9;&#x9;[TMP].[GUIA_MASIVA_07] TMP07 WITH (NOLOCK)   -- SEGUIMIENTO_ENVIO&#xA;&#x9;&#x9;INNER JOIN &#xA;&#x9;&#x9;&#x9;TMP.GUIA_MASIVA TMP WITH (NOLOCK)   -- GUIAS&#xA;&#x9;&#x9;ON&#xA;&#x9;&#x9;&#x9;TMP07.NUMERO_GUIA = TMP.G_NUMERO_GUIA&#xA;&#x9;)&#xA;INSERT INTO [TMP].[GUIA_MASIVA_08]&#xA;(&#xA;&#x9; G_NUMERO_GUIA&#xA;&#x9;,ID_CIUDAD_ULTI_MOVI&#xA;&#x9;,ID_ZONA_URBA&#xA;)&#xA;SELECT &#xA;&#x9;CTE.G_NUMERO_GUIA,&#xA;&#x9;CASE PRO.ID_TIPO_PROCESO &#xA;&#x9;&#x9;   WHEN 1 THEN &#xA;&#x9;&#x9;&#x9;&#x9; CASE WHEN ISNULL(TMP15.ID_CIUDAD_DESTINO,0) &gt; 0 THEN TMP15.ID_CIUDAD_DESTINO ELSE TMP15.ID_CIUDAD_DIVISION_ORIGEN END &#xA;&#x9;&#x9;   WHEN 2 THEN &#xA;&#x9;&#x9;&#x9;&#x9; CASE WHEN ISNULL(TMP15.ID_CIUDAD_DIVISION_ORIGEN,0) &gt; 0 THEN TMP15.ID_CIUDAD_DIVISION_ORIGEN ELSE TMP15.ID_CIUDAD_DESTINO END &#xA;&#x9;&#x9;   ELSE &#xA;&#x9;&#x9;&#x9;&#x9; CASE WHEN ISNULL(TMP15.ID_CIUDAD_DIVISION_ORIGEN,0) &gt; 0 THEN TMP15.ID_CIUDAD_DIVISION_ORIGEN ELSE TMP15.ID_CIUDAD_DESTINO END  &#xA;&#x9;END AS ID_CIUDAD_ULTI_MOVI&#xA;&#x9;,CASE WHEN (ISNULL(ID_TIPO_ZONA_URBA,0) = 0 OR ISNULL(ID_ZONA_URBA,0) = 0) THEN '-888' ELSE CONVERT(VARCHAR,ID_CIUDAD_ZONA_URBA) + '-' + CONVERT(VARCHAR,ID_TIPO_ZONA_URBA)+ '-' + CONVERT(VARCHAR,ID_ZONA_URBA) END ID_ZONA_URBA&#xA;&#x9;--,BODEGA_ULTI_MOVI, ID_BODEGA_ULTI_MOVI&#xA;FROM &#xA;&#x9;CTE   -- GUIAS  --- SEGUIMIENTO_ENVIO&#xA;INNER JOIN  &#xA;&#x9;TMP.GUIA_MASIVA_15 TMP15 WITH (NOLOCK)&#xA;ON&#xA;&#x9;CTE.G_NUMERO_GUIA = TMP15.G_NUMERO_GUIA AND CTE.#ROW = 1&#xA;&#xA;LEFT JOIN &#xA;&#x9;PAR.PROCESOS PRO WITH (NOLOCK)&#xA;ON &#xA;CTE.ID_PROCESO = PRO.ID_PROCESO&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;/*&#xA;WITH CTE&#xA;(&#xA;&#x9; G_NUMERO_GUIA&#xA;&#x9;,ID_PROCESO&#xA;&#x9;,NUMERO_MOVIMI&#xA;&#x9;,CONSECUT_MOVIMI&#xA;&#x9;,SE_ID_ULTI&#xA;)&#xA;AS&#xA;&#x9;(&#xA;&#x9;&#x9;SELECT&#xA;&#x9;&#x9;&#x9; TMP.G_NUMERO_GUIA&#xA;&#x9;&#x9;&#x9;,TMP07.ID_PROCESO&#xA;&#x9;&#x9;&#x9;,TMP07.NUMERO_MOVIMI&#xA;&#x9;&#x9;&#x9;,TMP07.CONSECUT_MOVIMI&#xA;&#x9;&#x9;&#x9;,TMP.SE_ID_ULTI&#xA;&#x9;&#x9;FROM &#xA;&#x9;&#x9;&#x9;[TMP].[GUIA_MASIVA_07] TMP07 WITH (NOLOCK)&#xA;&#x9;&#x9;INNER JOIN &#xA;&#x9;&#x9;&#x9;TMP.GUIA_MASIVA TMP WITH (NOLOCK)&#xA;&#x9;&#x9;ON&#xA;&#x9;&#x9;&#x9;TMP07.ID = TMP.SE_ID_ULTI&#xA;&#x9;)&#xA;INSERT INTO [TMP].[GUIA_MASIVA_08]&#xA;(&#xA;&#x9; G_NUMERO_GUIA&#xA;&#x9;,ID_CIUDAD_ULTI_MOVI&#xA;&#x9;,ID_ZONA_URBA&#xA;)&#xA;SELECT &#xA;&#x9;CTE.G_NUMERO_GUIA,&#xA;&#x9;CASE PRO.ID_TIPO_PROCESO &#xA;&#x9;&#x9;   WHEN 1 THEN &#xA;&#x9;&#x9;&#x9;&#x9; CASE WHEN ISNULL(TMP15.ID_CIUDAD_DESTINO,0) &gt; 0 THEN TMP15.ID_CIUDAD_DESTINO ELSE TMP15.ID_CIUDAD_DIVISION_ORIGEN END &#xA;&#x9;&#x9;   WHEN 2 THEN &#xA;&#x9;&#x9;&#x9;&#x9; CASE WHEN ISNULL(TMP15.ID_CIUDAD_DIVISION_ORIGEN,0) &gt; 0 THEN TMP15.ID_CIUDAD_DIVISION_ORIGEN ELSE TMP15.ID_CIUDAD_DESTINO END &#xA;&#x9;&#x9;   ELSE &#xA;&#x9;&#x9;&#x9;&#x9; CASE WHEN ISNULL(TMP15.ID_CIUDAD_DIVISION_ORIGEN,0) &gt; 0 THEN TMP15.ID_CIUDAD_DIVISION_ORIGEN ELSE TMP15.ID_CIUDAD_DESTINO END  &#xA;&#x9;END AS ID_CIUDAD_ULTI_MOVI&#xA;&#x9;,CASE WHEN (ISNULL(ID_TIPO_ZONA_URBA,0) = 0 OR ISNULL(ID_ZONA_URBA,0) = 0) THEN '-888' ELSE CONVERT(VARCHAR,ID_CIUDAD_ZONA_URBA) + '-' + CONVERT(VARCHAR,ID_TIPO_ZONA_URBA)+ '-' + CONVERT(VARCHAR,ID_ZONA_URBA) END ID_ZONA_URBA&#xA;FROM &#xA;&#x9;CTE &#xA;INNER JOIN  &#xA;&#x9;TMP.GUIA_MASIVA_15 TMP15 WITH (NOLOCK)&#xA;ON&#xA;&#x9;CTE.G_NUMERO_GUIA = TMP15.G_NUMERO_GUIA&#xA;&#xA;LEFT JOIN &#xA;&#x9;PAR.PROCESOS PRO WITH (NOLOCK)&#xA;ON &#xA;CTE.ID_PROCESO = PRO.ID_PROCESO&#xA;*/" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\PASO 12 ACTUALIZAR BASE CIUDAD ULTIMO MOVIMIENTO Y ZONA"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{F1A3A15D-894D-42B7-BFF5-1140ED5698D9}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="PASO 12 ACTUALIZAR BASE CIUDAD ULTIMO MOVIMIENTO Y ZONA"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:LoggingOptions
        DTS:FilterKind="0" />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
          SQLTask:SqlStatementSource="WITH CTE&#xA;(&#xA;&#x9;G_NUMERO_GUIA&#xA;&#x9;,DOC_ID_CIUDAD_ULTI_MOVI&#xA;&#x9;,DOC_ID_ZONA&#xA;) AS (&#xA;&#x9;SELECT&#xA;&#x9;&#x9;&#x9;TMP.G_NUMERO_GUIA&#xA;&#x9;&#x9;,TMP08.ID_CIUDAD_ULTI_MOVI&#xA;&#x9;&#x9;,TMP08.ID_ZONA_URBA&#xA;&#x9;FROM TMP.GUIA_MASIVA TMP WITH (NOLOCK)&#xA;&#x9;INNER JOIN [TMP].[GUIA_MASIVA_08] TMP08 WITH (NOLOCK)&#xA;&#x9;&#x9;ON  TMP.G_NUMERO_GUIA = TMP08.G_NUMERO_GUIA&#xA;)&#xA;&#xA;/*************/&#xA;UPDATE  TMP&#xA;&#x9;SET  DOC_ID_CIUDAD_ULTI_MOVI = CASE WHEN ISNULL(CTE.DOC_ID_CIUDAD_ULTI_MOVI,0) = 0 THEN TMP.DOC_ID_CIUDAD_ULTI_MOVI ELSE CTE.DOC_ID_CIUDAD_ULTI_MOVI END&#xA;&#x9;&#x9;,DOC_ID_ZONA = CASE WHEN ISNULL(CTE.DOC_ID_ZONA,'') ='' THEN TMP.DOC_ID_ZONA ELSE CTE.DOC_ID_ZONA END --VALIDAR NULL O VACIOS &#xA;FROM  TMP.GUIA_MASIVA AS TMP WITH (NOLOCK)&#xA;INNER JOIN CTE&#xA;&#x9;ON TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\PASO 13 ACTUALIZAR ID ULTIMO PROCESO Y ULTIMO CONCEPTO"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{D48652A9-70C3-43D2-B810-63A95BB2A8EC}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="PASO 13 ACTUALIZAR ID ULTIMO PROCESO Y ULTIMO CONCEPTO"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:LoggingOptions
        DTS:FilterKind="0" />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
          SQLTask:SqlStatementSource="/*Se hace cambio 20Oct22 de la nueva consulta para que se una la información por guia y no por id_ulti_movi ya que este no es el reportado por seguimiento envio */&#xA;WITH ULT_MOV AS (&#xA;&#x9;SELECT ROW_NUMBER() OVER (PARTITION BY TMP.G_NUMERO_GUIA ORDER BY NUMERO_GUIA, FECHA_HORA_MOVIMIENTO DESC) AS #ROW,&#xA;&#x9;&#x9;&#x9;TMP.G_NUMERO_GUIA&#xA;&#x9;&#x9;,TMP07.ID_PROCESO&#xA;&#x9;&#x9;,TMP07.ID_CONCEPTO&#xA;&#x9;FROM TMP.GUIA_MASIVA AS TMP WITH(NOLOCK)&#xA;&#x9;INNER JOIN  TMP.GUIA_MASIVA_07 AS TMP07 WITH(NOLOCK)&#xA;&#x9;&#x9;ON TMP.G_NUMERO_GUIA = TMP07.NUMERO_GUIA&#xA;&#x9;&#x9;-- ON TMP.SE_ID_ULTI = TMP07.ID&#xA;&#x9;&#x9;-- ORDER BY NUMERO_GUIA, FECHA_HORA_MOVIMIENTO DESC&#xA;) &#xA;UPDATE TMP&#xA;SET &#xA;&#x9; TMP.SE_ID_PROC_ULTI_MOVI = ISNULL(C.ID_PROCESO,-888)&#xA;&#x9;,TMP.SE_ID_CONC_ULTI_MOVI = ISNULL(C.ID_CONCEPTO,-888)&#xA;&#xA;FROM  TMP.GUIA_MASIVA AS TMP WITH(NOLOCK)&#xA;INNER JOIN ULT_MOV AS C&#xA;&#x9;ON TMP.G_NUMERO_GUIA = C.G_NUMERO_GUIA&#xA;WHERE #ROW = 1&#xA;&#xA;&#xA;&#xA;&#xA;/*&#xA;WITH CTE&#xA;(&#xA;&#x9; G_NUMERO_GUIA&#xA;&#x9;,ID_PROCESO&#xA;&#x9;,ID_CONCEPTO&#xA;) AS (&#xA;&#x9;SELECT&#xA;&#x9;&#x9;&#x9;TMP.G_NUMERO_GUIA&#xA;&#x9;&#x9;,TMP07.ID_PROCESO&#xA;&#x9;&#x9;,TMP07.ID_CONCEPTO&#xA;&#x9;FROM TMP.GUIA_MASIVA TMP WITH (NOLOCK)&#xA;&#x9;INNER JOIN  TMP.GUIA_MASIVA_07 TMP07 WITH (NOLOCK)&#xA;&#x9;&#x9;ON TMP.SE_ID_ULTI = TMP07.ID&#xA;&#x9;)&#xA;*/&#xA;/******************/&#xA;/*UPDATE TMP&#xA;SET  TMP.SE_ID_PROC_ULTI_MOVI = ISNULL(ID_PROCESO,-888)&#xA;&#x9;,TMP.SE_ID_CONC_ULTI_MOVI = ISNULL(ID_CONCEPTO,-888)&#xA;FROM  TMP.GUIA_MASIVA AS TMP WITH (NOLOCK)&#xA;INNER JOIN CTE&#xA;&#x9;ON TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA&#xA;*/" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\PASO 14 ACTUALIZAR DIGITALIZADA"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{58EC8BAF-243F-4807-9F8D-5104D4A11762}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="PASO 14 ACTUALIZAR DIGITALIZADA"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:LoggingOptions
        DTS:FilterKind="0" />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
          SQLTask:SqlStatementSource="WITH CTE&#xA;(&#xA;&#x9; G_NUMERO_GUIA&#xA;&#x9;,SE_ID_DIGI&#xA;&#x9;,SE_ID_FECHA_DIG&#xA;&#x9;,SE_FECHA_DIG&#xA;)  AS  (&#xA;&#x9;SELECT&#xA;&#x9;&#x9; TMP.G_NUMERO_GUIA&#xA;&#x9;&#x9;,'SI' AS SE_ID_DIGI&#xA;&#x9;&#x9;,ISNULL(PE.FECHA_DIGITALIZACION,'1900-01-01') SE_ID_FECHA_DIG&#xA;&#x9;&#x9;,ISNULL(CONVERT(VARCHAR,PE.FECHA_DIGITALIZACION,21),'NO DISPONIBLE') SE_FECHA_DIG&#xA;&#x9;FROM  TMP.GUIA_MASIVA TMP WITH(NOLOCK)&#xA;&#x9;INNER JOIN LOG.PRUEBAS_ENTREGA PE WITH(NOLOCK)&#xA;&#x9;ON  TMP.G_NUMERO_GUIA = PE.NUMERO_GUIA&#xA;)&#xA;UPDATE TMP&#xA;SET&#x9; TMP.SE_ID_DIGI = CTE.SE_ID_DIGI&#xA;&#x9;,TMP.SE_ID_FECHA_DIGI&#x9;= CTE.SE_ID_FECHA_DIG&#xA;&#x9;,TMP.SE_FECHA_DIGI&#x9;= CTE.SE_FECHA_DIG&#xA;FROM TMP.GUIA_MASIVA TMP WITH (NOLOCK) &#xA;INNER JOIN CTE ON TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\PASO 15 ACTUALIZAR ZONA"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{63B04277-A670-4854-AC30-8865C2EC1239}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="PASO 15 ACTUALIZAR ZONA"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:LoggingOptions
        DTS:FilterKind="0" />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
          SQLTask:SqlStatementSource="WITH CTE&#xA;(&#xA;&#x9;G_NUMERO_GUIA&#xA;&#x9;,DOC_ZONA&#xA;)  AS (&#xA;&#x9;SELECT &#xA;&#x9;&#x9;TMP.G_NUMERO_GUIA&#xA;&#x9;&#x9;,ZU.NOMBRE_ZONA_URBA AS DOC_ZONA&#xA;&#x9;FROM TMP.GUIA_MASIVA TMP WITH (NOLOCK)&#xA;&#x9;INNER JOIN &#x9;PAR.ZONASURBANAS ZU WITH (NOLOCK)&#xA;&#x9;&#x9;ON &#x9;TMP.DOC_ID_ZONA = CONVERT (VARCHAR ,ID_CIUDAD) +'-'+ CONVERT (VARCHAR ,ID_TIPO_ZONA_URBA)  +'-'+ CONVERT (VARCHAR ,ID_ZONA_URBA)&#xA;)&#xA;&#xA;/*************/&#xA;UPDATE TMP&#xA;SET &#x9;DOC_ZONA =  CASE WHEN ISNULL(CTE.DOC_ZONA,'') = '' THEN TMP.DOC_ZONA ELSE CTE.DOC_ZONA END &#xA;FROM  TMP.GUIA_MASIVA AS TMP &#xA;INNER JOIN CTE ON&#x9;TMP.G_NUMERO_GUIA =CTE.G_NUMERO_GUIA" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\PASO 16 ACTUALIZAR BODEGA"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{FEC74F9A-F123-4ED0-A696-36BD232BCE53}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="PASO 16 ACTUALIZAR BODEGA"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:LoggingOptions
        DTS:FilterKind="0" />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
          SQLTask:SqlStatementSource="UPDATE&#xA;&#x9;TMP.GUIA_MASIVA&#xA;SET&#xA;&#x9;G_BODEGA_ULTM_MOVI = ISNULL(DIV.[NOMBRE_DIVISION],'NO DISPONIBLE')&#xA;FROM &#xA;&#x9;TMP.GUIA_MASIVA TMP&#xA;INNER JOIN &#xA;&#x9;[PAR].[DIVISIONES] DIV WITH(NOLOCK)&#xA;ON &#xA;&#x9;TMP.G_ID_BODEGA_ULTM_MOVI = CONVERT(VARCHAR,DIV.[ID_PAIS]) + '-' + CONVERT(VARCHAR,DIV.[ID_CIUDAD]) + '-' + CONVERT(VARCHAR,DIV.[ID_DIVISION])&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\PASO 17 ACTUALIZAR TIPO TRAYECTO"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{1EA4BFB6-7640-4E76-A5BB-328CB44330DD}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="PASO 17 ACTUALIZAR TIPO TRAYECTO"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:LoggingOptions
        DTS:FilterKind="0" />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
          SQLTask:SqlStatementSource="WITH CTE&#xA;(&#xA;&#x9; G_NUMERO_GUIA&#xA;&#x9;,G_ID_TIPO_TRAYECTO&#xA;&#x9;,G_TIPO_TRAYECTO&#xA;)  AS  (&#xA;&#x9;SELECT&#xA;&#x9;&#x9; TMP.G_NUMERO_GUIA&#xA;&#x9;&#x9; ,CONVERT(VARCHAR(50),CONVERT(NVARCHAR(10), ID_CIUDAD_ORIGEN) + '-' + CONVERT(NVARCHAR(10), ID_CIUDAD_DESTINO)) G_ID_TIPO_TRAYECTO&#xA;&#x9;&#x9; ,TT.NOMBRE_TIPOTRAY AS G_TIPO_TRAYECTO&#xA;&#x9;FROM  TMP.GUIA_MASIVA TMP WITH (NOLOCK)&#xA;&#x9;INNER JOIN &#x9;SIG_COLOMBIA_DW.PAR.RED_OPERATIVA_CONSOLIDADA_TRAYECTOS RO WITH(NOLOCK)&#xA;&#x9;&#x9;ON &#x9;TMP.G_ID_CIUDAD_ORIGEN = RO.ID_CIUDAD_ORIGEN&#xA;&#x9;&#x9;&#x9;AND&#x9;TMP.G_ID_CIUDAD_DESTINO = RO.ID_CIUDAD_DESTINO&#xA;&#x9;INNER JOIN  SIG_COLOMBIA_DW.PAR.TIPOTRAYECTO TT WITH(NOLOCK)&#xA;&#x9;&#x9;ON  RO.ID_TIPOTRAY = TT.ID_TIPOTRAY&#xA;&#x9;WHERE ID_PAIS_ORIGEN = 1 AND ID_PAIS_DESTINO = 1&#xA;)&#xA;&#xA;/*********************/&#xA;UPDATE TMP&#xA;SET  G_ID_TIPO_TRAYECTO = CTE.G_ID_TIPO_TRAYECTO&#xA;&#x9;,G_TIPO_TRAYECTO= CTE.G_TIPO_TRAYECTO&#xA;FROM  TMP.GUIA_MASIVA TMP WITH (NOLOCK)&#xA;INNER JOIN CTE&#xA;&#x9;ON &#x9;TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\PASO 18 OBTENER GUIAS CONFIRMADAS"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{B8CF2E1A-A916-42F0-82B4-E6F463D6934A}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="PASO 18 OBTENER GUIAS CONFIRMADAS"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:LoggingOptions
        DTS:FilterKind="0" />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
          SQLTask:SqlStatementSource="WITH CTE &#xA;(&#xA;&#x9; ID&#xA;&#x9;,NUMERO_GUIA&#xA;&#x9;,FECHA_CONFIRMACION&#xA;&#x9;,ID_SOLUCION&#xA;)&#xA;AS&#xA;(&#xA;SELECT &#xA;&#x9; ROW_NUMBER() OVER(PARTITION BY NUMERO_GUIA ORDER BY FECHA_CONFIRMACION DESC) ID&#xA;&#x9;,CONF.NUMERO_GUIA&#xA;&#x9;,CONF.FECHA_CONFIRMACION&#xA;&#x9;,CONF.ID_SOLUCION&#xA;FROM &#xA;&#x9;LOG.CONFIRMACIONES CONF WITH (NOLOCK)&#xA;INNER JOIN &#xA;&#x9;TMP.GUIA_MASIVA TMP WITH (NOLOCK)&#xA;ON &#xA;&#x9;CONF.NUMERO_GUIA = TMP.G_NUMERO_GUIA&#xA;)&#xA;INSERT INTO TMP.GUIA_MASIVA_09&#xA;(&#xA;&#x9; ID&#xA;&#x9;,G_NUMERO_GUIA&#xA;&#x9;,FECHA_CONFIRMACION&#xA;&#x9;,ID_SOLUCION&#xA;)&#xA;SELECT &#xA;&#x9; CTE.ID&#xA;&#x9;,CTE.NUMERO_GUIA&#xA;&#x9;,CTE.FECHA_CONFIRMACION&#xA;&#x9;,CTE.ID_SOLUCION&#xA;FROM &#xA;&#x9;CTE&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\PASO 19 ACTUALIZAR CONFIRMACIONES"
      DTS:CreationName="STOCK:SEQUENCE"
      DTS:Description="Sequence Container"
      DTS:DTSID="{A323F722-D44F-4A9B-B138-E570B499971A}"
      DTS:ExecutableType="STOCK:SEQUENCE"
      DTS:LocaleID="-1"
      DTS:ObjectName="PASO 19 ACTUALIZAR CONFIRMACIONES">
      <DTS:Variables />
      <DTS:LoggingOptions
        DTS:FilterKind="0" />
      <DTS:Executables>
        <DTS:Executable
          DTS:refId="Package\PASO 19 ACTUALIZAR CONFIRMACIONES\PASO 19 01 CANTIDAD DE CONFIRMACIONES"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{31752AA3-25AB-4D59-BB3E-18B4C1E8CE72}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="PASO 19 01 CANTIDAD DE CONFIRMACIONES"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="WITH CTE&#xA;(&#xA;&#x9; G_NUMERO_GUIA&#xA;&#x9;,CNF_CANT_CONF&#xA;) AS (&#xA;&#x9;SELECT&#xA;&#x9;&#x9; TMP.G_NUMERO_GUIA&#xA;&#x9;&#x9;,COUNT (TMP09.G_NUMERO_GUIA) CNF_CANT_CONF&#xA;&#x9;FROM  &#x9;TMP.GUIA_MASIVA TMP WITH(NOLOCK)&#xA;&#x9;INNER JOIN &#x9;TMP.GUIA_MASIVA_09 TMP09 WITH(NOLOCK)&#xA;&#x9;&#x9;ON &#x9;TMP.G_NUMERO_GUIA = TMP09.G_NUMERO_GUIA&#xA;&#x9;GROUP BY TMP.G_NUMERO_GUIA&#xA;)&#xA;&#xA;/*****************/&#xA;UPDATE TMP&#xA;SET  CNF_ID_CONFIRMACION = 'SI'&#xA;&#x9;,CNF_CANT_CONFIRMACION = CTE.CNF_CANT_CONF&#xA;FROM TMP.GUIA_MASIVA AS TMP&#xA;INNER JOIN CTE&#xA;&#x9;ON &#x9;TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA&#xA;GO&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
