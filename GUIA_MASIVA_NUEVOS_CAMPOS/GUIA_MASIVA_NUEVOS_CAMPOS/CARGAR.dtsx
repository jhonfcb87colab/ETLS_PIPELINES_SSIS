        <AnnotationLayout
          Text="ANALISIS GUIAS RESULTANTE &#xA;&#xA;&#xA;DECLARE @GUIAS AS TABLE(NUMERO_GUIA NUMERIC(20,0))&#xA;&#xA;INSERT INTO @GUIAS&#xA;VALUES &#xA; (9192599854)&#xA;,(2273483165)&#xA;,(2297040271)&#xA;,(2294969664)&#xA;,(2294969867)&#xA;,(2294968791)&#xA;&#xA;&#xA;SELECT NUMERO_GUIA,ID_PRODUCTO,ID_SUBPRODUCTO FROM MECE_LOGISTICO.DBO.GUIAS WITH(NOLOCK)&#xA;WHERE NUMERO_GUIA IN(SELECT NUMERO_GUIA FROM @GUIAS)&#xA;&#xA;SELECT NUMERO_GUIA,ID_TIPOENVIO FROM MECE_LOGISTICO.DBO.SEGUIMIENTO_ENVIO WITH(NOLOCK)&#xA;WHERE NUMERO_GUIA IN(SELECT NUMERO_GUIA FROM @GUIAS)&#xA;group by NUMERO_GUIA,ID_TIPOENVIO&#xA;&#xA;SELECT G.NUMERO_GUIA,G.ID_PRODUCTO,G.ID_SUBPRODUCTO,SEG.ID_TIPOENVIO,FECHA_MODIFICACION_DG  &#xA;FROM MECE_LOGISTICO.DBO.GUIAS G WITH(NOLOCK)&#xA;INNER JOIN MECE_LOGISTICO.DBO.SEGUIMIENTO_ENVIO SEG WITH(NOLOCK) ON G.NUMERO_GUIA=SEG.NUMERO_GUIA&#xA;WHERE G.NUMERO_GUIA IN(SELECT NUMERO_GUIA FROM @GUIAS)&#xA;and SEG.FECHA_HORA_MOVIMIENTO = (SELECT MIN(FECHA_HORA_MOVIMIENTO) FROM MECE_LOGISTICO.DBO.SEGUIMIENTO_ENVIO SEGAUX WITH(NOLOCK) WHERE SEGAUX.NUMERO_GUIA=G.NUMERO_GUIA)&#xA;&#xA;&#xA;"
          ParentId="Package"
          FontInfo="{assembly:Null}"
          Size="1160,503"
          Id="5796daa3-702a-4d4e-8ef8-16522c226899"
          TopLeft="359,464" />
      </GraphLayout>
