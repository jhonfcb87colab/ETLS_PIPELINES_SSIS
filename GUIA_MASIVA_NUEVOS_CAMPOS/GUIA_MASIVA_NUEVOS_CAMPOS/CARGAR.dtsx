	[RTW_INGRESO],
	[REC_ENV_CRD_CDS] ,
	[CUMPLE_TE_DEPURADA] ,
	[CUMPLE_TE_ACIDA] ,
	[RES_INCU] ,
	[FECHA_REC_ENV_CRD_CDS] 
	,[FECHA_RTW_INGRESO_MOV]
,[T_ENTREGA_RED_OPE] 
,ISNULL([NOMBRE_TIPO_ENVIO],'NO DISPONIBLE') AS [NOMBRE_TIPO_ENVIO]
  FROM [TMP].[GUIA_MASIVA] WITH (NOLOCK)
WHERE LEN( [G_NUMERO_GUIA])&gt;=8</property>
