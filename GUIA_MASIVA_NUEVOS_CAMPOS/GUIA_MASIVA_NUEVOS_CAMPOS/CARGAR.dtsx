      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{C7190DE6-60BE-430F-AEF9-C4F770E80734}"
          SQLTask:SqlStatementSource="UPDATE [dbo].[CONTROL_EXTRACCION] SET [ULTIMA_ACTUALIZACION] = GETDATE() WHERE TABLA = 'GUIA_MASIVA' AND ESQUEMA = 'FAC'" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\BORRADO DE GUIAS"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{93217CB9-7FE8-4B8D-9E13-688650CF9F52}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="BORRADO DE GUIAS"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:LoggingOptions
        DTS:FilterKind="0" />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{3ACEBEAD-B9B4-4242-BCAE-D62C68CDC5F5}"
          SQLTask:SqlStatementSource="DROP TABLE IF EXISTS #TMP_GUIAS_GUIA_MASIVA&#xA;;WITH CTE AS (&#xA;SELECT &#xA;ROWID = ROW_NUMBER() OVER(PARTITION BY G_NUMERO_GUIA ORDER BY G_NUMERO_GUIA),&#xA;G_NUMERO_GUIA&#xA;FROM [TMP].[GUIA_MASIVA] T&#xA;)&#xA;SELECT  &#xA;ROWIDCT = ROW_NUMBER() OVER(ORDER BY G_NUMERO_GUIA),&#xA;G_NUMERO_GUIA&#xA;INTO #TMP_GUIAS_GUIA_MASIVA&#xA;FROM CTE WHERE ROWID = 1&#xA;&#xA;&#xA;CREATE NONCLUSTERED INDEX [IX_DELL_GUIAS_GUIAMASIVA] ON #TMP_GUIAS_GUIA_MASIVA([G_NUMERO_GUIA] ASC)&#xA;WITH (PAD_INDEX = OFF, STATISTICS_NORECOMPUTE = OFF, SORT_IN_TEMPDB = OFF, DROP_EXISTING = OFF, ONLINE = OFF, &#xA;ALLOW_ROW_LOCKS = ON, ALLOW_PAGE_LOCKS = ON, FILLFACTOR = 80)&#xA;&#xA;&#xA;-- 3. Bucle de inserción por Lotes basado en ID numérico (Evita borrar/volver a hacer JOINs)&#xA;DECLARE @LOTE INT = 10000; -- Incrementado a 50k para mejor rendimiento E/S&#xA;DECLARE @MIN_ID INT = 1;&#xA;DECLARE @MAX_ID_LOTE INT;&#xA;DECLARE @MAX_ID_TOTAL INT = (SELECT ISNULL(MAX(ROWIDCT), 0) FROM #TMP_GUIAS_GUIA_MASIVA TMP WITH(NOLOCK));&#xA;&#xA;WHILE @MIN_ID &lt;= @MAX_ID_TOTAL&#xA;BEGIN&#xA;    SET @MAX_ID_LOTE = @MIN_ID + @LOTE - 1;&#xA;&#x9;&#x9;    DELETE G &#xA;&#x9;&#x9;&#x9;FROM [FAC].[GUIA_MASIVA] G&#xA;&#x9;&#x9;&#x9;INNER JOIN #TMP_GUIAS_GUIA_MASIVA TMP &#xA;&#x9;&#x9;&#x9;ON G.G_NUMERO_GUIA=TMP.G_NUMERO_GUIA&#xA;&#x9;&#x9;&#x9;WHERE TMP.ROWIDCT BETWEEN @MIN_ID AND @MAX_ID_LOTE&#xA;&#x9;OPTION(RECOMPILE);&#xA;&#x9;PRINT(CONCAT('INSERTCION REALIZADA DESDE - ',@MIN_ID,' / HASTA - ',@MAX_ID_LOTE))&#xA;    SET @MIN_ID = @MAX_ID_LOTE + 1;&#xA;END;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
