        <DTS:Executable
          DTS:refId="Package\DEPURAR GUIAS TABLA DE HECHOS\LISTAR GUIAS A ELIMINAR"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{AA8441F8-4FA5-41A6-9764-5193B992EE77}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="LISTAR GUIAS A ELIMINAR"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{5B2BDE35-0E5F-4DE2-A25A-19DB68B50268}"
              SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;&#xA;TRUNCATE TABLE [tmp_borrar_local].[dbo].[BI_MPCCO_GUIAS_VEJEZ_DEPURACION_02];&#xA;&#xA;---------------------------------------------------------------&#xA;-- 1. Guías numeradas, con CLUSTERED sobre ROIDCT (el lote = seek de rango)&#xA;---------------------------------------------------------------&#xA;DROP TABLE IF EXISTS #GUIAS;&#xA;SELECT ROIDCT = ROW_NUMBER() OVER (ORDER BY G_NUMERO_GUIA),&#xA;       G_NUMERO_GUIA&#xA;INTO #GUIAS&#xA;FROM [tmp_borrar_local].[dbo].[BI_MPCCO_GUIAS_VEJEZ_DEPURACION] WITH (NOLOCK);&#xA;&#xA;CREATE UNIQUE CLUSTERED INDEX CIX_GUIAS ON #GUIAS (ROIDCT);&#xA;&#xA;---------------------------------------------------------------&#xA;-- 2. Tabla de trabajo por lote: guía a evaluar + guía a reportar&#xA;--    ES_RPL = 0 -&gt; la propia guía (T01/T02/T03)&#xA;--    ES_RPL = 1 -&gt; guía reemplazada (T041/T042/T043)&#xA;--    Tipos copiados de GUIAS para evitar conversiones implícitas&#xA;---------------------------------------------------------------&#xA;DROP TABLE IF EXISTS #EVAL;&#xA;SELECT TOP (0)&#xA;       G_EVAL = G.NUMERO_GUIA,&#xA;       G_ORIG = G.NUMERO_GUIA,&#xA;       ES_RPL = CAST(0 AS BIT)&#xA;INTO #EVAL&#xA;FROM Mece_Logistico.dbo.GUIAS G;&#xA;&#xA;CREATE CLUSTERED INDEX CIX_EVAL ON #EVAL (G_EVAL);&#xA;&#xA;---------------------------------------------------------------&#xA;-- 3. Bucle&#xA;---------------------------------------------------------------&#xA;DECLARE @LOTE      INT = 5000;&#xA;DECLARE @MIN_ID    INT = 1;&#xA;DECLARE @MAX_ID    INT;&#xA;DECLARE @MAX_TOTAL INT = (SELECT ISNULL(MAX(ROIDCT), 0) FROM #GUIAS);&#xA;&#xA;WHILE @MIN_ID &lt;= @MAX_TOTAL&#xA;BEGIN&#xA;    SET @MAX_ID = @MIN_ID + @LOTE - 1;&#xA;&#xA;    TRUNCATE TABLE #EVAL;&#xA;&#xA;    -- Guías del lote + sus reemplazadas (REEMPLAZO_GUIAS se lee 1 vez)&#xA;    INSERT INTO #EVAL (G_EVAL, G_ORIG, ES_RPL)&#xA;    SELECT T.G_NUMERO_GUIA, T.G_NUMERO_GUIA, 0&#xA;    FROM #GUIAS T&#xA;    WHERE T.ROIDCT BETWEEN @MIN_ID AND @MAX_ID&#xA;    UNION&#xA;    SELECT R.NUMERO_GUIA_REEMPLAZADA, R.NUME_GUIA_ORIGINAL, 1&#xA;    FROM #GUIAS T&#xA;    INNER JOIN [Mece_Logistico].[dbo].[REEMPLAZO_GUIAS] R WITH (NOLOCK)&#xA;            ON R.NUME_GUIA_REEMPLAZO = T.G_NUMERO_GUIA&#xA;    WHERE T.ROIDCT BETWEEN @MIN_ID AND @MAX_ID&#xA;    OPTION (LOOP JOIN);&#xA;&#xA;    -- T01 / T041 : SEGUIMIENTO_ENVIO con proceso 11 (1 lectura)&#xA;    INSERT INTO [tmp_borrar_local].[dbo].[BI_MPCCO_GUIAS_VEJEZ_DEPURACION_02]&#xA;    SELECT DISTINCT E.G_ORIG, IIF(E.ES_RPL = 0, 'T01', 'T041')&#xA;    FROM #EVAL E&#xA;    WHERE EXISTS (SELECT 1&#xA;                  FROM Mece_Logistico.dbo.SEGUIMIENTO_ENVIO SE&#xA;                       WITH (NOLOCK, INDEX([REL_GUIAS_SEGUIMIENTOENVIO_FK]), FORCESEEK)&#xA;                  WHERE SE.NUMERO_GUIA = E.G_EVAL&#xA;                    AND SE.ID_PROCESO = 11)&#xA;    OPTION (LOOP JOIN);&#xA;&#xA;    -- T02 / T03 / T042 / T043 : GUIAS (1 lectura en vez de 4)&#xA;    INSERT INTO [tmp_borrar_local].[dbo].[BI_MPCCO_GUIAS_VEJEZ_DEPURACION_02]  &#xA;&#x9;SELECT DISTINCT E.G_ORIG, X.TIPO&#xA;    FROM #EVAL E&#xA;    INNER JOIN Mece_Logistico.dbo.GUIAS G&#xA;               WITH (NOLOCK, INDEX([UK_GUIA]), FORCESEEK)&#xA;            ON G.NUMERO_GUIA = E.G_EVAL&#xA;    CROSS APPLY (VALUES&#xA;        (CASE WHEN G.ID_ESTADOENVIO IN (3,4,5,10) THEN IIF(E.ES_RPL = 0, 'T02', 'T042') END),&#xA;        (CASE WHEN G.ID_ESTADOGUIA  IN (4,12)     THEN IIF(E.ES_RPL = 0, 'T03', 'T043') END)&#xA;    ) X(TIPO)&#xA;    WHERE X.TIPO IS NOT NULL&#xA;    OPTION (LOOP JOIN);&#xA;&#x9;PRINT(CONCAT('INSERTION DONE!! BETWEEN - ',@MIN_ID,' / TO - ',@MAX_ID))&#xA;    &#xA;    SET @MIN_ID = @MAX_ID + 1;&#xA;END;&#xA;&#xA;DROP TABLE IF EXISTS #GUIAS, #EVAL;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;/*&#xA;TRUNCATE TABLE [tmp_borrar_local].[dbo].[BI_MPCCO_GUIAS_VEJEZ_DEPURACION_02]&#xA;&#xA;DROP TABLE IF EXISTS #BI_MPCCO_GUIAS_VEJEZ_DEPURACION&#xA;SELECT &#xA;ROIDCT = ROW_NUMBER() OVER(ORDER BY G_NUMERO_GUIA),&#xA;G_NUMERO_GUIA&#xA;INTO #BI_MPCCO_GUIAS_VEJEZ_DEPURACION&#xA;FROM [tmp_borrar_local].[dbo].[BI_MPCCO_GUIAS_VEJEZ_DEPURACION] TMP WITH(NOLOCK)&#xA;&#xA;CREATE NONCLUSTERED INDEX [IX_G_NUMERO_GUIA_MPCCO] ON #BI_MPCCO_GUIAS_VEJEZ_DEPURACION(G_NUMERO_GUIA ASC)&#xA;WITH (PAD_INDEX = OFF, STATISTICS_NORECOMPUTE = OFF, SORT_IN_TEMPDB = OFF, DROP_EXISTING = OFF, ONLINE = OFF, &#xA;ALLOW_ROW_LOCKS = ON, ALLOW_PAGE_LOCKS = ON, FILLFACTOR = 80)&#xA;&#xA;&#xA;-- 3. Bucle de inserción por Lotes basado en ID numérico (Evita borrar/volver a hacer JOINs)&#xA;DECLARE @LOTE INT = 2000; -- Incrementado a 50k para mejor rendimiento E/S&#xA;DECLARE @MIN_ID INT = 1;&#xA;DECLARE @MAX_ID_LOTE INT;&#xA;DECLARE @MAX_ID_TOTAL INT = (SELECT ISNULL(MAX(IDS.ROIDCT), 0) FROM #BI_MPCCO_GUIAS_VEJEZ_DEPURACION IDS WITH(NOLOCK));&#xA;&#xA;WHILE @MIN_ID &lt;= @MAX_ID_TOTAL&#xA;BEGIN&#xA;    SET @MAX_ID_LOTE = @MIN_ID + @LOTE - 1;&#xA;&#x9;&#x9;&#x9;&#x9;-----LISTAR GUIAS A DEPUERAR PARTE 1&#xA;&#x9;&#x9;&#x9;&#x9;INSERT INTO [tmp_borrar_local].[dbo].[BI_MPCCO_GUIAS_VEJEZ_DEPURACION_02]&#xA;&#x9;&#x9;&#x9;&#x9;SELECT TMP.[G_NUMERO_GUIA], 'T01' AS TIPO&#xA;&#x9;&#x9;&#x9;&#x9;  FROM #BI_MPCCO_GUIAS_VEJEZ_DEPURACION TMP WITH(NOLOCK INDEX=[IX_G_NUMERO_GUIA_MPCCO])&#xA;&#x9;&#x9;&#x9;&#x9;  INNER JOIN Mece_Logistico.DBO.SEGUIMIENTO_ENVIO SE WITH(NOLOCK INDEX=[REL_GUIAS_SEGUIMIENTOENVIO_FK])&#xA;&#x9;&#x9;&#x9;&#x9;  ON SE.NUMERO_GUIA=TMP.G_NUMERO_GUIA&#xA;&#x9;&#x9;&#x9;&#x9;WHERE ID_PROCESO=11&#xA;&#x9;&#x9;&#x9;&#x9;AND TMP.ROIDCT BETWEEN @MIN_ID AND @MAX_ID_LOTE&#xA;&#x9;&#x9;&#x9;&#x9;GROUP BY TMP.[G_NUMERO_GUIA]&#xA;&#x9;&#x9;&#x9;&#x9;OPTION(RECOMPILE)&#xA;&#x9;&#x9;&#x9;&#x9;----LISTAR GUIAS A DEPUERAR PARTE 2&#xA;&#x9;&#x9;&#x9;&#x9;INSERT INTO [tmp_borrar_local].[dbo].[BI_MPCCO_GUIAS_VEJEZ_DEPURACION_02]&#xA;&#x9;&#x9;&#x9;&#x9;SELECT TMP.[G_NUMERO_GUIA], 'T02' AS TIPO&#xA;&#x9;&#x9;&#x9;&#x9;  FROM #BI_MPCCO_GUIAS_VEJEZ_DEPURACION TMP WITH(NOLOCK INDEX=[IX_G_NUMERO_GUIA_MPCCO])&#xA;&#x9;&#x9;&#x9;&#x9;  INNER JOIN Mece_Logistico.DBO.GUIAS G WITH(NOLOCK INDEX=[UK_GUIA])&#xA;&#x9;&#x9;&#x9;&#x9;  ON G.NUMERO_GUIA=TMP.G_NUMERO_GUIA&#xA;&#x9;&#x9;&#x9;&#x9;WHERE G.ID_ESTADOENVIO IN(3,4,5,10)&#xA;&#x9;&#x9;&#x9;&#x9;AND TMP.ROIDCT BETWEEN @MIN_ID AND @MAX_ID_LOTE&#xA;&#x9;&#x9;&#x9;&#x9;GROUP BY TMP.[G_NUMERO_GUIA]&#xA;&#x9;&#x9;&#x9;&#x9;----LISTAR GUIAS A DEPUERAR PARTE 3&#xA;&#x9;&#x9;&#x9;&#x9;INSERT INTO [tmp_borrar_local].[dbo].[BI_MPCCO_GUIAS_VEJEZ_DEPURACION_02]&#xA;&#x9;&#x9;&#x9;&#x9;SELECT TMP.[G_NUMERO_GUIA], 'T03' AS TIPO&#xA;&#x9;&#x9;&#x9;&#x9;FROM #BI_MPCCO_GUIAS_VEJEZ_DEPURACION TMP WITH(NOLOCK INDEX=[IX_G_NUMERO_GUIA_MPCCO])&#xA;&#x9;&#x9;&#x9;&#x9;INNER JOIN Mece_Logistico.DBO.GUIAS G WITH(NOLOCK INDEX=[UK_GUIA])&#xA;&#x9;&#x9;&#x9;&#x9;ON G.NUMERO_GUIA=TMP.G_NUMERO_GUIA&#xA;&#x9;&#x9;&#x9;&#x9;WHERE G.ID_ESTADOGUIA IN( 4,12)&#xA;&#x9;&#x9;&#x9;&#x9;AND TMP.ROIDCT BETWEEN @MIN_ID AND @MAX_ID_LOTE&#xA;&#x9;&#x9;&#x9;&#x9;GROUP BY TMP.[G_NUMERO_GUIA]&#xA;&#x9;&#x9;&#x9;&#x9;---LISTAR GUIAS A DEPUERAR PARTE 4&#xA;&#x9;&#x9;&#x9;&#x9;INSERT INTO [tmp_borrar_local].[dbo].[BI_MPCCO_GUIAS_VEJEZ_DEPURACION_02]&#xA;&#x9;&#x9;&#x9;&#x9;SELECT GRPL.[NUME_GUIA_ORIGINAL] AS [G_NUMERO_GUIA], 'T041' AS TIPO&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;  --,GRPL.[NUME_GUIA_REEMPLAZO]&#xA;&#x9;&#x9;&#x9;&#x9;  FROM #BI_MPCCO_GUIAS_VEJEZ_DEPURACION TMP WITH(NOLOCK INDEX=[IX_G_NUMERO_GUIA_MPCCO])&#xA;&#x9;&#x9;&#x9;&#x9;  INNER JOIN [Mece_Logistico].[dbo].[REEMPLAZO_GUIAS] GRPL WITH (NOLOCK)&#xA;&#x9;&#x9;&#x9;&#x9;  ON TMP.[G_NUMERO_GUIA] = GRPL.[NUME_GUIA_REEMPLAZO]&#xA;&#x9;&#x9;&#x9;&#x9;  INNER JOIN [Mece_Logistico].[DBO].[SEGUIMIENTO_ENVIO] SEG WITH(NOLOCK)&#xA;&#x9;&#x9;&#x9;&#x9;  ON GRPL.[NUMERO_GUIA_REEMPLAZADA]=SEG.NUMERO_GUIA&#xA;&#x9;&#x9;&#x9;&#x9;  ---WHERE GRPL.[NUME_GUIA_ORIGINAL] IN ( 9183609181 )&#xA;&#x9;&#x9;&#x9;&#x9; WHERE SEG.ID_PROCESO = 11&#xA;&#x9;&#x9;&#x9;&#x9; AND TMP.ROIDCT BETWEEN @MIN_ID AND @MAX_ID_LOTE&#xA;&#x9;&#x9;&#x9;&#x9;INSERT INTO [tmp_borrar_local].[dbo].[BI_MPCCO_GUIAS_VEJEZ_DEPURACION_02]&#xA;&#x9;&#x9;&#x9;&#x9;SELECT GRPL.[NUME_GUIA_ORIGINAL] AS [G_NUMERO_GUIA], 'T042' AS TIPO&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;  --,GRPL.[NUME_GUIA_REEMPLAZO]&#xA;&#x9;&#x9;&#x9;&#x9;  FROM #BI_MPCCO_GUIAS_VEJEZ_DEPURACION TMP WITH(NOLOCK INDEX=[IX_G_NUMERO_GUIA_MPCCO])&#xA;&#x9;&#x9;&#x9;&#x9;  INNER JOIN [Mece_Logistico].[dbo].[REEMPLAZO_GUIAS] GRPL WITH (NOLOCK)&#xA;&#x9;&#x9;&#x9;&#x9;  ON TMP.[G_NUMERO_GUIA] = GRPL.[NUME_GUIA_REEMPLAZO]&#xA;&#x9;&#x9;&#x9;&#x9;  INNER JOIN [Mece_Logistico].[DBO].[GUIAS] GUI WITH(NOLOCK)&#xA;&#x9;&#x9;&#x9;&#x9;  ON GRPL.[NUMERO_GUIA_REEMPLAZADA]=GUI.NUMERO_GUIA&#xA;&#x9;&#x9;&#x9;&#x9;  ---WHERE GRPL.[NUME_GUIA_ORIGINAL] IN ( 9183609181 )&#xA;&#x9;&#x9;&#x9;&#x9; WHERE ID_ESTADOENVIO IN(3,4,10,5)&#xA;&#x9;&#x9;&#x9;&#x9; AND TMP.ROIDCT BETWEEN @MIN_ID AND @MAX_ID_LOTE&#xA;&#x9;&#x9;&#x9;&#x9; INSERT INTO [tmp_borrar_local].[dbo].[BI_MPCCO_GUIAS_VEJEZ_DEPURACION_02]&#xA;&#x9;&#x9;&#x9;&#x9;SELECT GRPL.[NUME_GUIA_ORIGINAL] AS [G_NUMERO_GUIA], 'T043' AS TIPO&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;  --,GRPL.[NUME_GUIA_REEMPLAZO]&#xA;&#x9;&#x9;&#x9;&#x9;  FROM #BI_MPCCO_GUIAS_VEJEZ_DEPURACION TMP WITH(NOLOCK INDEX=[IX_G_NUMERO_GUIA_MPCCO])&#xA;&#x9;&#x9;&#x9;&#x9;  INNER JOIN [Mece_Logistico].[dbo].[REEMPLAZO_GUIAS] GRPL WITH (NOLOCK)&#xA;&#x9;&#x9;&#x9;&#x9;  ON TMP.[G_NUMERO_GUIA] = GRPL.[NUME_GUIA_REEMPLAZO]&#xA;&#x9;&#x9;&#x9;&#x9;  INNER JOIN [Mece_Logistico].[DBO].[GUIAS] GUI WITH(NOLOCK)&#xA;&#x9;&#x9;&#x9;&#x9;  ON GRPL.[NUMERO_GUIA_REEMPLAZADA]=GUI.NUMERO_GUIA&#xA;&#x9;&#x9;&#x9;&#x9;  ---WHERE GRPL.[NUME_GUIA_ORIGINAL] IN ( 9183609181 )&#xA;&#x9;&#x9;&#x9;&#x9; WHERE ID_ESTADOGUIA IN(4,12)&#xA;&#x9;&#x9;&#x9;&#x9; AND TMP.ROIDCT BETWEEN @MIN_ID AND @MAX_ID_LOTE&#xA;&#x9;PRINT(CONCAT('INSERTION DONE BETWEEN - ',@MIN_ID,' / TO - ',@MAX_ID_LOTE))&#xA;    SET @MIN_ID = @MAX_ID_LOTE + 1;&#xA;END;&#xA;&#xA;&#xA;*/&#xA;&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\DEPURAR GUIAS TABLA DE HECHOS\QUITAR DUPLICADOS GUIAS DE DEPURACION"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{B96472E8-73FC-4DB9-8768-68D2469505CC}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
