SION_ORIGEN&#xA;,DOC_ID_CIUDAD_DIVISION_ORIGEN&#xA;,DOC_ID_DIVISION_ORIGEN&#xA;,DOC_ID_PAIS_DESTINO&#xA;,DOC_ID_CIUDAD_DESTINO&#xA;,DOC_ID_DIVISION_DESTINO&#xA;,DOC_ID_COURIER_CONDUCTOR&#xA;,DOC_ID_PAIS_OPERATIVO&#xA;,DOC_ID_CIUDAD_OPERATIVO&#xA;,DOC_ID_OPERATIVO&#xA;,DOC_ID_RUTA&#xA;,DOC_ID_PAIS_CANAL&#xA;,DOC_ID_CIUDAD_CANAL&#xA;,DOC_ID_CANAL&#xA;,DOC_ID_TIPO_LOGISTICA&#xA;,DOC_FECHA_HORA_MOVIMI&#xA;,DOC_TOTAL_ENVIOS&#xA;,DOC_PESO_TOTAL&#xA;,DOC_PLACA_VEHICULO_DOCU&#xA;,DOC_ESTADO_MOVIMI&#xA;,DOC_NUME_SELLO_SEGURIDAD&#xA;,DOC_ID_TIPO_MOVIMIENTO&#xA;,DOC_ID_ESTADO_TRANS_ZONA&#xA;,DOC_ID_AUXILIAR2_VEHICULO&#xA;,DOC_FECHA_CREACION&#xA;,DOC_FECHA_MODIFICACION&#xA;,PE_TIPO_PRUEBA_ENTREGA&#xA;,PE_GENERACION_PE&#xA;,PE_FECHA_DIGITALIZACION&#xA;,PE_FECHA_CREACION&#xA;FROM [TMP].[MPCCO_VJ_ULTIMO_PROCESO_LOG] TMP WITH(NOLOCK)&#xA;)&#xA;INSERT INTO [TMP].[MPCCO_VJ_PS01]&#xA;(&#xA; G_NUMERO_GUIA&#xA;,G_ID_TIPOGUIA&#xA;,G_ID_CLIENTE&#xA;,G_ID_CANAL&#xA;,G_ID_DIVISION_PROV&#xA;,G_ID_PAIS_ORIGEN&#xA;,G_ID_CIUDAD_ORIGEN&#xA;,G_ID_PAIS_DESTINO&#xA;,G_ID_CIUDAD_DESTINO&#xA;,G_ID_TIPO_ZONA_URBA&#xA;,G_ID_PAIS_ZONA_URB_ENTR&#xA;,G_ID_CIUDAD_ZONA_URB_ENTR&#xA;,G_ID_ZONA_URBA&#xA;,G_ID_ESTADOENVIO&#xA;,G_ID_ESTADOGUIA&#xA;,G_ID_CARACT_ENVIO&#xA;,G_ID_TIEMPO&#xA;,G_ID_MEDTRANS&#xA;,G_ID_PRODUCTO&#xA;,G_ID_SUBPRODUCTO&#xA;,G_FECHA_ENVIO&#xA;,G_ID_REMITE&#xA;,G_ID_DESTINA&#xA;,G_NOMBRE_REMITE_GUIA&#xA;,G_APELLIDO_REMITE_GUIA&#xA;,G_NOMBRE_DESTINA_GUIA&#xA;,G_APELLIDO_DESTINA_GUIA&#xA;,G_TELEFONO_REMITE_GUIA&#xA;,G_TELEFONO_DESTINA_GUIA&#xA;,G_DIRECCION_REMITE_GUIA&#xA;,G_DIRECCION_DESTINA_GUIA&#xA;,G_CONTENIDO&#xA;,G_LARGO_ENVIO&#xA;,G_ALTO_ENVIO&#xA;,G_ANCHO_ENVIO&#xA;,G_LARGO_ENV_OPERA&#xA;,G_ALTO_ENV_OPERA&#xA;,G_ANCHO_ENV_OPERA&#xA;,G_PESO_GUIA&#xA;,G_PESO_FISICO_GUIA&#xA;,G_PESO_VOLU_GUIA&#xA;,G_PESO_FISICO_OPERA&#xA;,G_PESO_VOLU_OPERA&#xA;,G_PESO_FACTURADO&#xA;,G_FECHA_ENTREGA&#xA;,G_NUMERO_PIEZAS&#xA;,G_VALOR_DECLARADO_GUIA&#xA;,G_VALOR_SEG_MAN_GUIAS&#xA;,G_VALOR_FLETES_GUIAS&#xA;,G_VALOR_DESCUENTO_GUIAS&#xA;,G_VALOR_PEDIDO_GUIAS&#xA;,G_VALOR_SEG_MAN_GUIAS_FACT&#xA;,G_VALOR_FLETES_GUIAS_FACT&#xA;,G_FECHA_CREACION&#xA;,G_FECHA_MODIFICACION_DG&#xA;,SEG_ID_PROCESO&#xA;,SEG_NUMERO_MOVIMI&#xA;,SEG_CONSECUT_MOVIMI&#xA;,SEG_ID_CONCEPTO&#xA;,SEG_ID_TIPOENVIO&#xA;,SEG_ID_ENVIO_CRUZADO&#xA;,SEG_PESO_ENVIO&#xA;,SEG_LARGO_ENVIO&#xA;,SEG_ANCHO_ENVIO&#xA;,SEG_ALTO_ENVIO&#xA;,SEG_FECHA_HORA_MOVIMIENTO&#xA;,SEG_NUMERO_PIEZAS&#xA;,SEG_FECHA_CREACION&#xA;,SEG_FECHA_MODIFICACION&#xA;,SEG_FECHA_EXTRACCION&#xA;,DOC_ID_TIPO_ZONA_URBA&#xA;,DOC_ID_PAIS_ZONA_URBA&#xA;,DOC_ID_CIUDAD_ZONA_URBA&#xA;,DOC_ID_ZONA_URBA&#xA;,DOC_ID_PAIS_DIVISION_ORIGEN&#xA;,DOC_ID_CIUDAD_DIVISION_ORIGEN&#xA;,DOC_ID_DIVISION_ORIGEN&#xA;,DOC_ID_PAIS_DESTINO&#xA;,DOC_ID_CIUDAD_DESTINO&#xA;,DOC_ID_DIVISION_DESTINO&#xA;,DOC_ID_COURIER_CONDUCTOR&#xA;,DOC_ID_PAIS_OPERATIVO&#xA;,DOC_ID_CIUDAD_OPERATIVO&#xA;,DOC_ID_OPERATIVO&#xA;,DOC_ID_RUTA&#xA;,DOC_ID_PAIS_CANAL&#xA;,DOC_ID_CIUDAD_CANAL&#xA;,DOC_ID_CANAL&#xA;,DOC_ID_TIPO_LOGISTICA&#xA;,DOC_FECHA_HORA_MOVIMI&#xA;,DOC_TOTAL_ENVIOS&#xA;,DOC_PESO_TOTAL&#xA;,DOC_PLACA_VEHICULO_DOCU&#xA;,DOC_ESTADO_MOVIMI&#xA;,DOC_NUME_SELLO_SEGURIDAD&#xA;,DOC_ID_TIPO_MOVIMIENTO&#xA;,DOC_ID_ESTADO_TRANS_ZONA&#xA;,DOC_ID_AUXILIAR2_VEHICULO&#xA;,DOC_FECHA_CREACION&#xA;,DOC_FECHA_MODIFICACION&#xA;,PE_TIPO_PRUEBA_ENTREGA&#xA;,PE_GENERACION_PE&#xA;,PE_FECHA_DIGITALIZACION&#xA;,PE_FECHA_CREACION&#xA;)&#xA;SELECT&#xA;G_NUMERO_GUIA&#xA;,G_ID_TIPOGUIA&#xA;,G_ID_CLIENTE&#xA;,G_ID_CANAL&#xA;,G_ID_DIVISION_PROV&#xA;,G_ID_PAIS_ORIGEN&#xA;,G_ID_CIUDAD_ORIGEN&#xA;,G_ID_PAIS_DESTINO&#xA;,G_ID_CIUDAD_DESTINO&#xA;,G_ID_TIPO_ZONA_URBA&#xA;,G_ID_PAIS_ZONA_URB_ENTR&#xA;,G_ID_CIUDAD_ZONA_URB_ENTR&#xA;,G_ID_ZONA_URBA&#xA;,G_ID_ESTADOENVIO&#xA;,G_ID_ESTADOGUIA&#xA;,G_ID_CARACT_ENVIO&#xA;,G_ID_TIEMPO&#xA;,G_ID_MEDTRANS&#xA;,G_ID_PRODUCTO&#xA;,G_ID_SUBPRODUCTO&#xA;,G_FECHA_ENVIO&#xA;,G_ID_REMITE&#xA;,G_ID_DESTINA&#xA;,G_NOMBRE_REMITE_GUIA&#xA;,G_APELLIDO_REMITE_GUIA&#xA;,G_NOMBRE_DESTINA_GUIA&#x