      DTS:ThreadHint="1">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{9270DAF5-1074-4D39-8815-87044D378AC9}"
          SQLTask:SqlStatementSource="&#xA;USE SIG_COLOMBIA_DW;&#xA;&#xA;UPDATE TMP SET&#xA; TMP.FORMA_PAGO = T01.FORMA_PAGO&#xA;,TMP.VALOR_A_RECAUDAR = T01.VALOR_A_RECAUDAR&#xA;,TMP.VALOR_RECAUDADO = T01.VALOR_RECAUDADO&#xA;,TMP.NUMERO_ORDEN_SERVICIO = T01.NUMERO_ORDEN_SERVICIO&#xA;,TMP.ESTA_RECAUDADO = T01.ESTA_RECAUDADO&#xA;FROM [TMP].[MPCCO_VJ_GUIAS_RECAUDO] T01 WITH(NOLOCK)&#xA;INNER JOIN [TMP].[MPCCO_VJ_PS01] TMP ---------------WITH(NOLOCK)&#xA;ON TMP.G_NUMERO_GUIA=T01.NUMERO_GUIA&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
