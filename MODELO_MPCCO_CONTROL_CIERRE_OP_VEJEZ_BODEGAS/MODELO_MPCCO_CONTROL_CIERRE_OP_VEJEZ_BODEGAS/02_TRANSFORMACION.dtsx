    <DTS:Executable
      DTS:refId="Package\PS02 ASIGNAR BODEGA ORIGEN DESTINO"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{E7B578A5-610C-4FD4-ACCE-E12400D2D351}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="PS02 ASIGNAR BODEGA ORIGEN DESTINO"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="1">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{9270DAF5-1074-4D39-8815-87044D378AC9}"
          SQLTask:SqlStatementSource="&#xA;/*&#x9;&#x9;ASIGNAR BODEGA ORIGEN DESTINO&#x9;&#x9;&#x9;&#x9;*/&#xA;&#xA;&#xA;&#xA;&#xA;USE SIG_COLOMBIA_DW;&#xA;&#xA;UPDATE TMP SET&#xA;    TMP.DOC_NOMBRE_DIVISION_ORG    = BOG_ORG.NOMBRE_DIVISION,&#xA;    TMP.DOC_NOMBRE_TIPO_BODEGA_ORG = BOG_ORG.TIPO_BODEGA,&#xA;    TMP.DOC_NOMBRE_DIVISION_DEST   = BOG_DEST.NOMBRE_DIVISION,&#xA;    TMP.DOC_NOMBRE_TIPO_BODEGA_DEST = BOG_DEST.TIPO_BODEGA&#xA;FROM [TMP].[MPCCO_VJ_PS01] TMP&#xA;LEFT JOIN [TMP].[MPCCO_VJ_DIVISIONES_BODEGAS] BOG_ORG&#xA;    ON BOG_ORG.ID_DIVISION = TMP.DOC_ID_DIVISION_ORIGEN&#xA;   AND BOG_ORG.ID_CIUDAD   = TMP.DOC_ID_CIUDAD_DIVISION_ORIGEN&#xA;   AND BOG_ORG.ID_PAIS     = TMP.DOC_ID_PAIS_DIVISION_ORIGEN&#xA;LEFT JOIN [TMP].[MPCCO_VJ_DIVISIONES_BODEGAS] BOG_DEST&#xA;    ON BOG_DEST.ID_DIVISION = TMP.DOC_ID_DIVISION_DESTINO&#xA;   AND BOG_DEST.ID_CIUDAD   = TMP.DOC_ID_CIUDAD_DESTINO&#xA;   AND BOG_DEST.ID_PAIS     = TMP.DOC_ID_PAIS_DESTINO&#xA;WHERE BOG_ORG.ID_DIVISION IS NOT NULL&#xA;   OR BOG_DEST.ID_DIVISION IS NOT NULL;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;/*&#xA;UPDATE TMP SET&#xA;TMP.DOC_NOMBRE_DIVISION_ORG&#x9;   = BOG_ORG.NOMBRE_DIVISION,&#xA;TMP.DOC_NOMBRE_TIPO_BODEGA_ORG = BOG_ORG.TIPO_BODEGA&#xA;FROM [TMP].[MPCCO_VJ_PS01] TMP WITH(NOLOCK)&#xA;INNER JOIN [TMP].[MPCCO_VJ_DIVISIONES_BODEGAS] BOG_ORG WITH(NOLOCK)&#xA;ON BOG_ORG.ID_DIVISION=TMP.DOC_ID_DIVISION_ORIGEN&#xA;AND BOG_ORG.ID_CIUDAD=TMP.DOC_ID_CIUDAD_DIVISION_ORIGEN&#xA;AND BOG_ORG.ID_PAIS=TMP.DOC_ID_PAIS_DIVISION_ORIGEN&#xA;&#xA;&#xA;&#xA;UPDATE TMP SET&#xA;TMP.DOC_NOMBRE_DIVISION_DEST&#x9;&#x9;= BOG_DEST.NOMBRE_DIVISION,&#xA;TMP.DOC_NOMBRE_TIPO_BODEGA_DEST&#x9;&#x9;= BOG_DEST.TIPO_BODEGA&#xA;FROM [TMP].[MPCCO_VJ_PS01] TMP WITH(NOLOCK)&#xA;INNER JOIN [TMP].[MPCCO_VJ_DIVISIONES_BODEGAS] BOG_DEST WITH(NOLOCK)&#xA; ON BOG_DEST.ID_DIVISION=TMP.DOC_ID_DIVISION_DESTINO&#xA;AND BOG_DEST.ID_CIUDAD=TMP.DOC_ID_CIUDAD_DESTINO&#xA;AND BOG_DEST.ID_PAIS=TMP.DOC_ID_PAIS_DESTINO&#xA;/**/&#xA;&#xA;&#xA;&#xA;*/" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\PS03 ASIGNAR CPL ORIGEN DESTINO"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{5A344CF2-7551-4EF6-A4C5-A2432FAE387E}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="PS03 ASIGNAR CPL ORIGEN DESTINO"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="1">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{9270DAF5-1074-4D39-8815-87044D378AC9}"
          SQLTask:SqlStatementSource="/*&#x9;&#x9;ASIGNAR CPL ORIGEN DESTINO&#x9;&#x9;&#x9;&#x9;*/&#xA;&#xA;&#xA;UPDATE TMP SET&#xA;    TMP.CPL_ORG = CPL_ORG.CPL,&#xA;    TMP.CPL_DES = CPL_DS.CPL&#xA;FROM [TMP].[MPCCO_VJ_PS01] TMP&#xA;LEFT JOIN [TMP].[MPCCO_VJ_CPL] CPL_ORG&#xA;    ON TMP.DOC_ID_CIUDAD_DIVISION_ORIGEN = CPL_ORG.ID_CIUDAD_ANEXA&#xA;   AND TMP.DOC_ID_PAIS_DIVISION_ORIGEN   = CPL_ORG.ID_PAIS&#xA;LEFT JOIN [TMP].[MPCCO_VJ_CPL] CPL_DS&#xA;    ON TMP.DOC_ID_CIUDAD_DESTINO = CPL_DS.ID_CIUDAD_ANEXA&#xA;   AND TMP.DOC_ID_PAIS_DESTINO   = CPL_DS.ID_PAIS&#xA;WHERE CPL_ORG.ID_CIUDAD_ANEXA IS NOT NULL&#xA;   OR CPL_DS.ID_CIUDAD_ANEXA IS NOT NULL;&#xA;&#xA;&#xA;&#xA;/*&#xA;UPDATE TMP SET &#xA;TMP.CPL_ORG = CPL_ORG.CPL&#xA;----SELECT CPL_ORG CPL_ORG.CPL &#xA;FROM [TMP].[MPCCO_VJ_PS01] TMP WITH(NOLOCK)&#xA;INNER JOIN [TMP].[MPCCO_VJ_CPL] CPL_ORG WITH(NOLOCK)&#xA;ON TMP.DOC_ID_CIUDAD_DIVISION_ORIGEN=CPL_ORG.ID_CIUDAD_ANEXA &#xA;AND TMP.DOC_ID_PAIS_DIVISION_ORIGEN=CPL_ORG.ID_PAIS&#xA;&#xA;UPDATE TMP SET &#xA;TMP.CPL_DES = CPL_DS.CPL &#xA;FROM [TMP].[MPCCO_VJ_PS01] TMP WITH(NOLOCK)&#xA;INNER JOIN [TMP].[MPCCO_VJ_CPL] CPL_DS WITH(NOLOCK)&#xA;ON TMP.DOC_ID_CIUDAD_DESTINO=CPL_DS.ID_CIUDAD_ANEXA &#xA;AND TMP.DOC_ID_PAIS_DESTINO=CPL_DS.ID_PAIS&#xA;*/&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\PS04 ASIGNAR CIUDADREGIONAL ORIGEN_INICIAL DESTINO_FINAL DEL ENVIO"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{210253D2-E496-4639-AECD-4444A9067AF1}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="PS04 ASIGNAR CIUDADREGIONAL ORIGEN_INICIAL DESTINO_FINAL DEL ENVIO"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="1">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{9270DAF5-1074-4D39-8815-87044D378AC9}"
          SQLTask:SqlStatementSource="&#xA;&#xA;DROP TABLE IF EXISTS #PAR_CIUDADES_REGIONAL;&#xA;SELECT &#xA;CD.ID_PAIS,&#xA;CD.ID_CIUDAD, &#xA;CD.NOMBRE_CIUDAD,&#xA;RG.ID_REGIONAL,&#xA;RG.NOMBRE_REGIONAL&#xA;INTO #PAR_CIUDADES_REGIONAL&#xA;FROM PAR.CIUDADES CD WITH(NOLOCK)&#xA;INNER JOIN PAR.REGIONALES_PAIS RG WITH(NOLOCK)&#xA;ON RG.ID_REGIONAL=CD.ID_REGIONAL&#xA;WHERE CD.ID_PAIS=1 AND RG.ID_EST_REGIONAL=1&#xA;&#xA;&#xA;UPDATE TMP SET &#xA;TMP.G_NOMBRE_CIUDAD_INICIAL_ORIGEN = CD_ORG.NOMBRE_CIUDAD&#xA;,TMP.G_NOMBRE_REGIONAL_INICIAL_ORIGEN = CD_ORG.NOMBRE_REGIONAL&#xA;FROM [TMP].[MPCCO_VJ_PS01] TMP ------WITH(NOLOCK)&#xA;INNER JOIN #PAR_CIUDADES_REGIONAL CD_ORG WITH(NOLOCK)&#xA; ON  CD_ORG.ID_CIUDAD=TMP.G_ID_CIUDAD_ORIGEN&#xA;AND CD_ORG.ID_PAIS=TMP.G_ID_PAIS_ORIGEN&#xA;&#xA;&#xA;UPDATE TMP SET &#xA;TMP.G_NOMBRE_CIUDAD_FINAL_DESTINO = CD_DEST.NOMBRE_CIUDAD &#xA;,TMP.G_NOMBRE_REGIONAL_FINAL_DESTINO = CD_DEST.NOMBRE_REGIONAL&#xA;FROM [TMP].[MPCCO_VJ_PS01]  TMP --------------WITH(NOLOCK)&#xA;INNER JOIN #PAR_CIUDADES_REGIONAL CD_DEST WITH(NOLOCK)&#xA; ON  CD_DEST.ID_CIUDAD=TMP.G_ID_CIUDAD_DESTINO&#xA;AND  CD_DEST.ID_PAIS=TMP.G_ID_PAIS_DESTINO&#xA;&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\PS05  ASIGNAR CIUDAD-REGIONAL ORIGEN DESTINO DEL MANIFIESTO"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{2806F82F-B5BF-4CFA-8C17-4E07C23FE76B}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="PS05  ASIGNAR CIUDAD-REGIONAL ORIGEN DESTINO DEL MANIFIESTO"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="1">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{9270DAF5-1074-4D39-8815-87044D378AC9}"
          SQLTask:SqlStatementSource="/*&#x9;&#x9;ASIGNAR CIUDAD-REGIONAL ORIGEN DESTINO DEL MANIFIESTO&#x9;&#x9;&#x9;&#x9;&#x9;*/&#xA;&#xA;DROP TABLE IF EXISTS #PAR_CIUDADES_REGIONAL;&#xA;SELECT &#xA;CD.ID_PAIS,&#xA;CD.ID_CIUDAD, &#xA;CD.NOMBRE_CIUDAD,&#xA;RG.ID_REGIONAL,&#xA;RG.NOMBRE_REGIONAL&#xA;INTO #PAR_CIUDADES_REGIONAL&#xA;FROM PAR.CIUDADES CD WITH(NOLOCK)&#xA;INNER JOIN PAR.REGIONALES_PAIS RG WITH(NOLOCK)&#xA;ON RG.ID_REGIONAL=CD.ID_REGIONAL&#xA;WHERE CD.ID_PAIS=1 AND RG.ID_EST_REGIONAL=1&#xA;&#xA;&#xA;UPDATE TMP SET &#xA;TMP.DOC_NOMBRE_CIUDAD_ORIGEN = DOC_ORG.NOMBRE_CIUDAD &#xA;,TMP.DOC_NOMBRE_REGIONAL_ORIGEN = DOC_ORG.NOMBRE_REGIONAL&#xA;FROM [TMP].[MPCCO_VJ_PS01] TMP ----------------WITH(NOLOCK)&#xA;INNER JOIN #PAR_CIUDADES_REGIONAL DOC_ORG WITH(NOLOCK)&#xA; ON  DOC_ORG.ID_CIUDAD=TMP.DOC_ID_CIUDAD_DIVISION_ORIGEN&#xA;AND  DOC_ORG.ID_PAIS=TMP.DOC_ID_PAIS_DIVISION_ORIGEN&#xA;&#xA;UPDATE TMP SET &#xA;TMP.DOC_NOMBRE_CIUDAD_DESTINO = DOC_DEST.NOMBRE_CIUDAD&#xA;,TMP.DOC_NOMBRE_REGIONAL_DESTRINO = DOC_DEST.NOMBRE_REGIONAL&#xA;FROM [TMP].[MPCCO_VJ_PS01] TMP -----------------WITH(NOLOCK)&#xA;INNER JOIN #PAR_CIUDADES_REGIONAL DOC_DEST WITH(NOLOCK)&#xA; ON  DOC_DEST.ID_CIUDAD=TMP.DOC_ID_CIUDAD_DESTINO&#xA;AND  DOC_DEST.ID_PAIS=TMP.DOC_ID_PAIS_DESTINO&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\PS06 ASIGNAR NOMBRE PRODUCTO SUB PRODUCTO UEN"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{7D7068B2-8D85-4FFC-9A07-FAC4FC40FF25}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="PS06 ASIGNAR NOMBRE PRODUCTO SUB PRODUCTO UEN"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="1">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{9270DAF5-1074-4D39-8815-87044D378AC9}"
          SQLTask:SqlStatementSource="&#xA;/*&#x9;&#x9;ASIGNAR NOMBRE PRODUCTO SUB PRODUCTO UEN &#x9;&#x9;&#x9;&#x9;&#x9;*/&#xA;&#xA;UPDATE TMP SET &#xA; TMP.NOMBRE_SUBPRODUCTO = UEN.NOMBRE_SUBPRODUCTO&#xA;,TMP.NOMBRE_PRODUCTO = UEN.NOMBRE_PRODUCTO&#xA;,TMP.NOMBRE_UEN = UEN.NOMBRE_UEN&#xA;FROM [TMP].[MPCCO_VJ_PS01] TMP -----------WITH(NOLOCK)&#xA;INNER JOIN [TMP].[MPCCO_VJ_UEN] UEN WITH(NOLOCK)&#xA; ON  UEN.ID_PRODUCTO=TMP.G_ID_PRODUCTO&#xA; AND UEN.ID_SUBPRODUCTO=TMP.G_ID_SUBPRODUCTO &#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\PS07 ASIGNAR NOMBRE DE CLIENTES"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{16430071-2D0C-4A16-B2D1-EEABD279B675}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="PS07 ASIGNAR NOMBRE DE CLIENTES"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="1">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{9270DAF5-1074-4D39-8815-87044D378AC9}"
          SQLTask:SqlStatementSource=" /*&#x9;&#x9;&#x9;ASIGNAR NOMBRE DE CLIENTES&#x9;&#x9;&#x9;&#x9;&#x9;*/ &#xA;&#xA;DROP TABLE IF EXISTS #CLIENTES_TEMP&#xA;SELECT ID_CLIENTE,NOMBRE_CLIENTE,RAZON_SOCIAL_CORTA &#xA;INTO #CLIENTES_TEMP&#xA;FROM PAR.CLIENTES WITH(NOLOCK)&#xA;&#xA;UPDATE TMP SET &#xA;TMP.NOMBRE_CLIENTE =  CL.NOMBRE_CLIENTE&#xA;FROM [TMP].[MPCCO_VJ_PS01] TMP ----------WITH(NOLOCK)&#xA; INNER JOIN #CLIENTES_TEMP CL WITH(NOLOCK)&#xA; ON  CL.ID_CLIENTE=TMP.G_ID_CLIENTE&#xA;&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\PS08 ASIGNAR NOMBRE DE ZONA URBANA Y CATEGORIA ZONA URBANA"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{E8EC36E9-C950-466E-859B-2390623EC0FD}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="PS08 ASIGNAR NOMBRE DE ZONA URBANA Y CATEGORIA ZONA URBANA"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="1">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{9270DAF5-1074-4D39-8815-87044D378AC9}"
          SQLTask:SqlStatementSource="&#xA;  /*&#x9;&#x9;&#x9;ASIGNAR NOMBRE DE ZONA URBANA Y CATEGORIA ZONA URBANA&#x9;&#x9;&#x9;&#x9;*/ &#xA;&#xA; DROP TABLE IF EXISTS #ZONA_URBA_TEMP&#xA;SELECT &#xA;ID_PAIS&#x9;&#xA;,ID_CIUDAD&#x9;&#xA;,ID_TIPO_ZONA_URBA&#x9;&#xA;,ID_ZONA_URBA&#x9;&#xA;,NOMBRE_ZONA_URBA&#x9;&#xA;,CATEGORIA_ZONA_URBA AS ID_CATEGORIA_ZONA_URBA&#xA;,CTZU.Nombre_Categoria AS NOMBRE_CATEGORIA_ZONA_URBA&#xA;INTO #ZONA_URBA_TEMP&#xA;FROM PAR.ZONASURBANAS Z WITH(NOLOCK)  &#xA;LEFT JOIN [PAR].[CATEGORIAZONAURBANA] CTZU WITH(NOLOCK)  &#xA;ON Z.CATEGORIA_ZONA_URBA=CTZU.Id_Categoria&#xA;&#xA;UPDATE TMP SET &#xA; TMP.DOC_NOMBRE_ZONA_URBANA = ZU.NOMBRE_ZONA_URBA&#xA;,TMP.DOC_NOMBRE_CATEGORIA_ZONA_URBANA = ZU.NOMBRE_CATEGORIA_ZONA_URBA &#xA;FROM [TMP].[MPCCO_VJ_PS01] TMP ----------WITH(NOLOCK)&#xA; INNER JOIN #ZONA_URBA_TEMP ZU WITH(NOLOCK)&#xA; ON  ZU.ID_PAIS=DOC_ID_PAIS_ZONA_URBA&#xA; AND ZU.ID_CIUDAD=DOC_ID_CIUDAD_ZONA_URBA&#xA; AND ZU.ID_TIPO_ZONA_URBA=DOC_ID_TIPO_ZONA_URBA&#xA; AND ZU.ID_ZONA_URBA=DOC_ID_ZONA_URBA&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\PS09 ASIGNAR ESTADO DEL ENVIO  Y ESTADO DE LA GUIA"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{E276BCF2-22AA-4942-956D-88F7FE95E53B}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="PS09 ASIGNAR ESTADO DEL ENVIO  Y ESTADO DE LA GUIA"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="1">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{9270DAF5-1074-4D39-8815-87044D378AC9}"
          SQLTask:SqlStatementSource="&#xA;/*&#x9;&#x9;&#x9;ASIGNAR ESTADO DEL ENVIO  Y ESTADO DE LA GUIA&#x9;&#x9;&#x9;&#x9;*/  &#xA;&#xA;&#xA;SET NOCOUNT ON;&#xA;&#xA;DROP TABLE IF EXISTS #PAR_ESTADOSENVIO_TEMP;&#xA;SELECT ID_ESTADOENVIO, NOMBRE_ESTADOENVIO&#xA;INTO #PAR_ESTADOSENVIO_TEMP&#xA;FROM PAR.ESTADOSENVIO WITH(NOLOCK);&#xA;&#xA;CREATE UNIQUE NONCLUSTERED INDEX IX_ESTENVIO ON #PAR_ESTADOSENVIO_TEMP (ID_ESTADOENVIO) INCLUDE (NOMBRE_ESTADOENVIO);&#xA;&#xA;DROP TABLE IF EXISTS #PAR_ESTADOSGUIA_TEMP;&#xA;SELECT ID_ESTADOGUIA, NOMBRE_ESTADOGUIA&#xA;INTO #PAR_ESTADOSGUIA_TEMP&#xA;FROM PAR.ESTADOSGUIA WITH(NOLOCK);&#xA;&#xA;CREATE UNIQUE NONCLUSTERED INDEX IX_ESTGUIA ON #PAR_ESTADOSGUIA_TEMP (ID_ESTADOGUIA) INCLUDE (NOMBRE_ESTADOGUIA);&#xA;&#xA;UPDATE TMP SET &#xA;    TMP.G_NOMBRE_ESTADOENVIO = EV.NOMBRE_ESTADOENVIO,&#xA;    TMP.G_NOMBRE_ESTADOGUIA  = EG.NOMBRE_ESTADOGUIA&#xA;FROM [TMP].[MPCCO_VJ_PS01] TMP&#xA;LEFT JOIN #PAR_ESTADOSENVIO_TEMP EV ON EV.ID_ESTADOENVIO = TMP.G_ID_ESTADOENVIO&#xA;LEFT JOIN #PAR_ESTADOSGUIA_TEMP  EG ON EG.ID_ESTADOGUIA  = TMP.G_ID_ESTADOGUIA&#xA;WHERE EV.ID_ESTADOENVIO IS NOT NULL&#xA;   OR EG.ID_ESTADOGUIA  IS NOT NULL;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\PS10  ASIGNAR FECHA Y PRIMERE PROCESO"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{9E3811AE-AAB6-4EEC-851B-0EA4DFF5CCD8}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="PS10  ASIGNAR FECHA Y PRIMERE PROCESO"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="1">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{9270DAF5-1074-4D39-8815-87044D378AC9}"
          SQLTask:SqlStatementSource="/*                  PS10  ASIGNAR FECHA Y PRIMERE PROCESO               */&#xA;&#xA;UPDATE T01 SET&#xA;T01.PRIM_EZU_EPS_ER_SEG_FECHA_HORA_MOVIMIENTO = T02.FECHA_HORA_MOVIMIENTO,&#xA;T01.PRIM_EZU_EPS_ER_SEG_PROCESO = T02.ID_PROCESO&#xA;FROM [TMP].[MPCCO_VJ_PS01] T01 -------------WITH(NOLOCK)&#xA;INNER JOIN [TMP].[MPCCO_VJ_PRIMERA_ENTRADA_BODEGA] T02 WITH(NOLOCK)&#xA;ON T01.G_NUMERO_GUIA=T02.NUMERO_GUIA" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\PS11 ASIGNAR CALCULO TIEMPO PROMESA RED OPERATIVA"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{FF4BFF6E-BC3B-4A06-A4E5-39E18665D4C1}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="PS11 ASIGNAR CALCULO TIEMPO PROMESA RED OPERATIVA"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="1">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{9270DAF5-1074-4D39-8815-87044D378AC9}"
          SQLTask:SqlStatementSource="/*&#x9;&#x9;PS11 ASIGNAR CALCULO TIEMPO PROMESA RED OPERATIVA&#x9;&#x9;&#x9;&#x9;&#x9;*/&#x9;&#xA;&#xA;WITH CTE_RA AS(&#xA;SELECT&#xA;&#x9;RA.TIEMPO_ENTREGA_COMERCIAL_HOR,&#xA;&#x9;RA.TIEMPO_ENTREGA_COMERCIAL_DIA,&#xA;&#x9;RA.ID_CIUDAD_ORIGEN,&#xA;&#x9;RA.ID_CIUDAD_DESTINO,&#xA;&#x9;RA.ID_TIEMPO,&#xA;&#x9;RA.ID_MEDTRANS,&#xA;&#x9;MAX(RA.ID_RUTA) AS ID_RUTA&#xA;FROM [TMP].[MPCCO_VJ_PARAMETROS_RED_OPERATIVA] RA WITH(NOLOCK)&#xA; GROUP BY &#xA; RA.TIEMPO_ENTREGA_COMERCIAL_HOR,&#xA; RA.TIEMPO_ENTREGA_COMERCIAL_DIA,&#xA; RA.ID_CIUDAD_ORIGEN,&#xA; RA.ID_CIUDAD_DESTINO,&#xA; RA.ID_MEDTRANS,&#xA; RA.ID_TIEMPO&#xA;)&#xA;UPDATE TMP SET&#xA;TMP.TIMEPO_PROMESA_OPERATIVA_H  =  RA.TIEMPO_ENTREGA_COMERCIAL_HOR, &#xA;TMP.TIMEPO_PROMESA_OPERATIVA_D&#x9;=  RA.TIEMPO_ENTREGA_COMERCIAL_DIA&#xA;FROM [TMP].[MPCCO_VJ_PS01] TMP ---------------WITH(NOLOCK)&#xA;INNER JOIN CTE_RA RA WITH(NOLOCK)&#xA;ON&#x9;TMP.G_ID_CIUDAD_ORIGEN = RA.ID_CIUDAD_ORIGEN&#xA;AND&#x9;TMP.G_ID_CIUDAD_DESTINO = RA.ID_CIUDAD_DESTINO&#xA;AND&#x9;CASE WHEN ISNULL(TMP.G_ID_TIEMPO,0) &lt;&gt; 0 THEN TMP.G_ID_TIEMPO ELSE 1 END = RA.ID_TIEMPO&#xA;AND&#x9;CASE WHEN ISNULL(TMP.G_ID_MEDTRANS,0) &lt;&gt; 0 THEN TMP.G_ID_MEDTRANS ELSE 1 END = RA.ID_MEDTRANS&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\PS12 SET FECHA_ACTUAL_DEL_SISTEMA"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{6A025F81-F154-455D-9153-75CF42FD2C49}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="PS12 SET FECHA_ACTUAL_DEL_SISTEMA"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="1">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{9270DAF5-1074-4D39-8815-87044D378AC9}"
          SQLTask:SqlStatementSource="UPDATE  [SIG_COLOMBIA_DW].[TMP].[MPCCO_VJ_PS01] SET&#xA;FECHA_ACTUAL_DEL_SISTEMA = CASE WHEN SEG_ID_PROCESO IN(11) OR PE_TIPO_PRUEBA_ENTREGA &gt;=1 THEN  SEG_FECHA_HORA_MOVIMIENTO&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;ELSE GETDATE()&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;END&#xA;,NUMERO_DE_FESTIVOS_Y_DOMINICALES = CONVERT(INT,0)&#xA;,NUMERO_DE_ORDINARIOS = CONVERT(INT,0)&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\PS13 Calculo dias fectivos TEMP"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{630ccf80-cc0b-4254-b8c5-fc7fdfacd058}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="PS13 Calculo dias fectivos TEMP"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="1">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{9270DAF5-1074-4D39-8815-87044D378AC9}"
          SQLTask:SqlStatementSource="UPDATE T01 SET&#xA; T01.NUMERO_DE_FESTIVOS_Y_DOMINICALES = T02.DIAS_FESTIVOS_DOMINICALES_TO_HOY&#xA;,T01.NUMERO_DE_ORDINARIOS = T02.GENERAL_DIAS&#xA;FROM [TMP].[MPCCO_VJ_PS01] T01 ---------------WITH(NOLOCK)&#xA;INNER JOIN [SIG_COLOMBIA_DW].[TMP].[MPCCO_VJ_FESTIVOS_DOMINICALES_HABILES] T02 WITH(NOLOCK)&#xA;ON (CASE WHEN T01.PRIM_EZU_EPS_ER_SEG_FECHA_HORA_MOVIMIENTO IS NULL THEN CONVERT(DATE,T01.G_FECHA_ENVIO)&#xA;ELSE CONVERT(DATE,T01.PRIM_EZU_EPS_ER_SEG_FECHA_HORA_MOVIMIENTO) END)=CONVERT(DATE,T02.[DATE])&#xA;&#xA;/*&#xA;ON CONVERT(DATE,T01.PRIM_EZU_EPS_ER_SEG_FECHA_HORA_MOVIMIENTO)=CONVERT(DATE,T02.[DATE])&#xA;*/&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\PS14 Calculo fecha promesa TEMP"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{DBBA9FD4-D8DF-4256-A37E-52241BAA74F1}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="PS14 Calculo fecha promesa TEMP"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="1">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{9270DAF5-1074-4D39-8815-87044D378AC9}"
          SQLTask:SqlStatementSource="&#xA;USE SIG_COLOMBIA_DW;&#xA;--FECHA_PROMESA_ENTREGA&#xA;UPDATE  T01 SET&#xA;/*SELECT &#xA; G_NUMERO_GUIA&#xA;,G_FECHA_ENVIO&#xA;,PRIM_EZU_EPS_ER_SEG_FECHA_HORA_MOVIMIENTO&#xA;,FECHA_ACTUAL_DEL_SISTEMA&#xA;,TIMEPO_PROMESA_OPERATIVA_D&#xA;,NUMERO_DE_FESTIVOS_Y_DOMINICALES&#xA;,NUMERO_DE_ORDINARIOS&#xA;,*/&#xA;T01.FECHA_PROMESA_ENTREGA = CASE WHEN DATEPART(HOUR, &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;DATEADD(DAY,NUMERO_DE_FESTIVOS_Y_DOMINICALES,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;DATEADD(DAY,TIMEPO_PROMESA_OPERATIVA_D,ISNULL(PRIM_EZU_EPS_ER_SEG_FECHA_HORA_MOVIMIENTO,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;DATEADD(DAY,1,G_FECHA_ENVIO)&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;)&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;)&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;)&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;)&lt;7&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;THEN DATEADD(HOUR,8,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;DATEADD(DAY,NUMERO_DE_FESTIVOS_Y_DOMINICALES,DATEADD(DAY,TIMEPO_PROMESA_OPERATIVA_D,ISNULL(PRIM_EZU_EPS_ER_SEG_FECHA_HORA_MOVIMIENTO,DATEADD(DAY,1,G_FECHA_ENVIO))))&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;)&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;ELSE DATEADD(DAY,NUMERO_DE_FESTIVOS_Y_DOMINICALES,DATEADD(DAY,TIMEPO_PROMESA_OPERATIVA_D,ISNULL(PRIM_EZU_EPS_ER_SEG_FECHA_HORA_MOVIMIENTO,DATEADD(DAY,1,G_FECHA_ENVIO))))&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;END&#xA;FROM [TMP].[MPCCO_VJ_PS01] T01 ------------------------WITH(NOLOCK)&#xA;WHERE &#xA;TIMEPO_PROMESA_OPERATIVA_D IS NOT NULL&#xA;AND (SEG_ID_PROCESO &lt;&gt; 11 OR PE_FECHA_DIGITALIZACION IS NULL)" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\PS15 Genero entrega verificada TEMP"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{D0E90527-A495-4DBF-BA41-6B9C4A5D4057}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="PS15 Genero entrega verificada TEMP"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="1">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{9270DAF5-1074-4D39-8815-87044D378AC9}"
          SQLTask:SqlStatementSource="UPDATE TMP SET&#xA; TMP.ID_GENERO_EV     = 1&#xA;,TMP.FECHA_GENERO_EV&#x9; = EV.FECHA_HORA_MOVIMIENTO&#xA;FROM [TMP].[MPCCO_VJ_PS01] TMP ----------------WITH(NOLOCK)&#xA;INNER JOIN [TMP].[MPCCO_VJ_ENTREGA_VERIFICADA] EV WITH(NOLOCK)&#xA;ON EV.NUMERO_GUIA=TMP.G_NUMERO_GUIA&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\PS16 Caculo vejez Bodega 02 TEMP"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{98169DB0-2A8B-4E95-B62D-632A361C850C}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="PS16 Caculo vejez Bodega 02 TEMP"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="1">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{9270DAF5-1074-4D39-8815-87044D378AC9}"
          SQLTask:SqlStatementSource="UPDATE TMP SET&#xA;TMP.ID_DIAS_VEJEZ_BODEGA_02 = CASE WHEN FECHA_PROMESA_ENTREGA IS NULL  THEN -99&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN DATEDIFF(DAY,FECHA_PROMESA_ENTREGA,FECHA_ACTUAL_DEL_SISTEMA) &gt;= 31 THEN 31&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN DATEDIFF(DAY,FECHA_PROMESA_ENTREGA,FECHA_ACTUAL_DEL_SISTEMA) &lt;= 0 THEN 0&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;ELSE DATEDIFF(DAY,FECHA_PROMESA_ENTREGA,FECHA_ACTUAL_DEL_SISTEMA)&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;END&#xA;,TMP.DIAS_VEJEZ_BODEGA_02 = CASE WHEN FECHA_PROMESA_ENTREGA IS NULL  THEN NULL&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;ELSE DATEDIFF(DAY,FECHA_PROMESA_ENTREGA,FECHA_ACTUAL_DEL_SISTEMA)&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;END&#xA;FROM [TMP].[MPCCO_VJ_PS01] TMP -----------------------WITH(NOLOCK)&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;    &#xA;WHERE (ID_GENERO_EV IS NULL AND PE_FECHA_DIGITALIZACION IS NULL AND SEG_ID_PROCESO &lt;&gt; 11)&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;/*&#xA;SELECT &#xA;G_NUMERO_GUIA&#xA;,FECHA_PROMESA_ENTREGA&#xA;,FECHA_ACTUAL_DEL_SISTEMA&#xA;,SEG_ID_PROCESO&#xA;,PE_FECHA_DIGITALIZACION&#xA;,ID_GENERO_EV&#xA;,*/" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
