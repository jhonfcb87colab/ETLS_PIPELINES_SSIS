alter table [TMP].[MPCCO_VJ_PS01] alter column G_NOMBRE_ESTADOENVIO VARCHAR(40) NULL&#xA;--alter table [TMP].[MPCCO_VJ_PS01] alter column G_NOMBRE_ESTADOGUIA  VARCHAR(40) NULL&#xA;--alter table [TMP].[MPCCO_VJ_PS01] alter column DOC_NOMBRE_ZONA_URBANA VARCHAR(40) NULL&#xA;&#xA;--SELECT COUNT(1) FROM [TMP].[MPCCO_VJ_PS01]&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
