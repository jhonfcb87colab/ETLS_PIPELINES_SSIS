                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=15.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT GRPL.[NUME_GUIA_ORIGINAL]
      --,GRPL.[NUME_GUIA_REEMPLAZO]
  FROM [tmp_borrar_local].[dbo].[BI_MPCCO_GUIAS_VEJEZ_DEPURACION] TMP WITH(NOLOCK) ----&gt;TU TABLA 
  INNER JOIN [Mece_Logistico].[dbo].[REEMPLAZO_GUIAS] GRPL WITH (NOLOCK)
  ON TMP.[G_NUMERO_GUIA] = GRPL.[NUME_GUIA_REEMPLAZO]
  INNER JOIN [Mece_Logistico].[DBO].[SEGUIMIENTO_ENVIO] SEG WITH(NOLOCK)
  ON GRPL.[NUMERO_GUIA_REEMPLAZADA]=SEG.NUMERO_GUIA
  ---WHERE GRPL.[NUME_GUIA_ORIGINAL] IN ( 9183609181 )
 WHERE SEG.ID_PROCESO = 11
UNION ALL  
SELECT GRPL.[NUME_GUIA_ORIGINAL]
      --,GRPL.[NUME_GUIA_REEMPLAZO]
  FROM [tmp_borrar_local].[dbo].[BI_MPCCO_GUIAS_VEJEZ_DEPURACION] TMP WITH(NOLOCK) ----&gt;TU TABLA 
  INNER JOIN [Mece_Logistico].[dbo].[REEMPLAZO_GUIAS] GRPL WITH (NOLOCK)
  ON TMP.[G_NUMERO_GUIA] = GRPL.[NUME_GUIA_REEMPLAZO]
  INNER JOIN [Mece_Logistico].[DBO].[GUIAS] GUI WITH(NOLOCK)
  ON GRPL.[NUMERO_GUIA_REEMPLAZADA]=GUI.NUMERO_GUIA
  ---WHERE GRPL.[NUME_GUIA_ORIGINAL] IN ( 9183609181 )
 WHERE ID_ESTADOENVIO IN(3,4,10,5)
 UNION ALL  
SELECT GRPL.[NUME_GUIA_ORIGINAL]
      --,GRPL.[NUME_GUIA_REEMPLAZO]
  FROM [tmp_borrar_local].[dbo].[BI_MPCCO_GUIAS_VEJEZ_DEPURACION] TMP WITH(NOLOCK) ----&gt;TU TABLA 
  INNER JOIN [Mece_Logistico].[dbo].[REEMPLAZO_GUIAS] GRPL WITH (NOLOCK)
  ON TMP.[G_NUMERO_GUIA] = GRPL.[NUME_GUIA_REEMPLAZO]
  INNER JOIN [Mece_Logistico].[DBO].[GUIAS] GUI WITH(NOLOCK)
  ON GRPL.[NUMERO_GUIA_REEMPLAZADA]=GUI.NUMERO_GUIA
  ---WHERE GRPL.[NUME_GUIA_ORIGINAL] IN ( 9183609181 )
 WHERE ID_ESTADOGUIA IN(4,12)</property>
