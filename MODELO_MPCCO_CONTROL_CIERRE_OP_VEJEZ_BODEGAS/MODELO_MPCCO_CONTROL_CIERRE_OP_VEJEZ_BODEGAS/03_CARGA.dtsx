      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{9270DAF5-1074-4D39-8815-87044D378AC9}"
          SQLTask:SqlStatementSource="&#xA;DECLARE @VARSELECT INT =  DATEPART(HOUR,DATEADD(HOUR,0,GETDATE()));&#xA;&#xA;SELECT VAR_EJECUTA_DIM_NOCTURNO = CASE WHEN @VARSELECT BETWEEN 22 AND 24 THEN 1&#xA;          WHEN @VARSELECT BETWEEN 0 AND 3 THEN 1&#xA;          ELSE 0&#xA;          END&#xA;          &#xA;"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="0"
            SQLTask:DtsVariableName="User::VAR_EJECUTA_DIM_NOCTURNO" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
