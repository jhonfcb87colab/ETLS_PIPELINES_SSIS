                    <component
                      refId="Package\Contruccion dimensiones\DIM TIEMPOS\DIM CALENDARIOS FECHAS\PARANETROS TIEMPOS Y FESTIVOS"
                      componentClassID="Microsoft.OLEDBSource"
                      contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                      description="OLE DB Source"
                      name="PARANETROS TIEMPOS Y FESTIVOS"
                      usesDispositions="true"
                      version="7">
                      <properties>
                        <property
                          dataType="System.Int32"
                          description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                          name="CommandTimeout">0</property>
                        <property
                          dataType="System.String"
                          description="Specifies the name of the database object used to open a rowset."
                          name="OpenRowset"></property>
                        <property
                          dataType="System.String"
                          description="Specifies the variable that contains the name of the database object used to open a rowset."
                          name="OpenRowsetVariable"></property>
                        <property
                          dataType="System.String"
                          description="The SQL command to be executed."
                          name="SqlCommand"
                          UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">WITH CTE AS(
SELECT  ROW_ID=ROW_NUMBER() OVER(PARTITION BY T.[TIME_ID] ORDER BY F.FECHA_EXTRACCION_DW DESC)
		,T.[TIME_ID]
		,ID_YYYYMMDD = (((YEAR(T.[DATE])*100)+MONTH(T.[DATE]))*100)+DAY(T.[DATE])
		,ID_YYYYMM = (((YEAR(T.[DATE])*100)+MONTH(T.[DATE])))
		,T.[DATE]
		,T.[DAY]
		,T.[MONTH]
		,UPPER(LEFT(T.[MONTH],3)) AS NOMBRE_MES_CORTO
		,T.[YEAR]
		,T.[DAY_OF_MONTH]
		,T.[WEEK_OF_YEAR]
		,T.[MONTH_OF_YEAR]
		,T.[QUARTER_OF_YEAR]
		,T.[SEMESTER_OF_YEAR]
		,T.[SEMESTER]
		,F.FECHA_FESTIVA
		,TIPO_DIA = CASE WHEN F.FECHA_FESTIVA IS NOT NULL THEN 'DIA FESTIVO'
				WHEN T.[DAY]='Domingo' THEN 'DIA DOMINICAL'
				ELSE 'DIA HABIL' END
		,ID_TIPO_DIA = CASE WHEN F.FECHA_FESTIVA IS NOT NULL THEN 1
				WHEN T.[DAY]='Domingo' THEN 2
				ELSE 0 END
  FROM [SIG_COLOMBIA_DW].[DIM].[TIEMPO] T WITH(NOLOCK)
  LEFT JOIN [PAR].[FESTIVOSNACIONALES] F WITH(NOLOCK)
  ON CONVERT(INT,[FECHA_FESTIVA])=[TIME_ID] AND F.[ID_PAIS]=1
  WHERE T.[DATE] BETWEEN DATEADD(yy,-5,DATEADD(yy,DATEDIFF(yy,0,GETDATE()),0)) AND DATEADD(DAY,1,CONVERT(DATETIME,CONVERT(DATE,GETDATE())))
)
SELECT 
 [TIME_ID]	
,[ID_YYYYMMDD]	
,[ID_YYYYMM]	
,[DATE]	
,[DAY]	
,[MONTH]	
,[NOMBRE_MES_CORTO]	
,[YEAR]	
,[DAY_OF_MONTH]	
,[WEEK_OF_YEAR]	
,[MONTH_OF_YEAR]	
,[QUARTER_OF_YEAR]	
,[SEMESTER_OF_YEAR]	
,[SEMESTER]	
,[FECHA_FESTIVA]	
,[TIPO_DIA]	
,[ID_TIPO_DIA]
FROM CTE WHERE ROW_ID=1</property>
                        <property
                          dataType="System.String"
                          description="The variable that contains the SQL command to be executed."
                          name="SqlCommandVariable"></property>
                        <property
