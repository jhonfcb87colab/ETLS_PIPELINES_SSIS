UNION
SELECT 27 AS ID_VEJEZ, 'DE 21 A 30 DIAS DE VEJEZ' AS NOMBRE_RANGO, 6 AS ORDEN
UNION
SELECT 28 AS ID_VEJEZ, 'DE 21 A 30 DIAS DE VEJEZ' AS NOMBRE_RANGO, 6 AS ORDEN
