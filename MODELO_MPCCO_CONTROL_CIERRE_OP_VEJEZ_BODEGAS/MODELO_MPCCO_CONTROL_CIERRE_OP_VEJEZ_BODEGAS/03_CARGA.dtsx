                        <property
                          dataType="System.String"
                          description="The SQL command to be executed."
                          name="SqlCommand"
                          UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">WITH CTE AS(
SELECT 0 AS ID_VEJEZ, '0 DIAS DE VEJEZ' AS NOMBRE_RANGO, 1 AS ORDEN
UNION
SELECT 1 AS ID_VEJEZ, 'DE 1 A 2 DIAS DE VEJEZ' AS NOMBRE_RANGO, 2 AS ORDEN
UNION
SELECT 2 AS ID_VEJEZ, 'DE 1 A 2 DIAS DE VEJEZ' AS NOMBRE_RANGO, 2 AS ORDEN
UNION
SELECT 3 AS ID_VEJEZ, 'DE 3 A 6 DIAS DE VEJEZ' AS NOMBRE_RANGO, 3 AS ORDEN
UNION
SELECT 4 AS ID_VEJEZ, 'DE 3 A 6 DIAS DE VEJEZ' AS NOMBRE_RANGO, 3 AS ORDEN
UNION
SELECT 5 AS ID_VEJEZ, 'DE 3 A 6 DIAS DE VEJEZ' AS NOMBRE_RANGO, 3 AS ORDEN
UNION
SELECT 6 AS ID_VEJEZ, 'DE 3 A 6 DIAS DE VEJEZ' AS NOMBRE_RANGO, 3 AS ORDEN
UNION
SELECT 7 AS ID_VEJEZ, 'DE 7 A 10 DIAS DE VEJEZ' AS NOMBRE_RANGO, 4 AS ORDEN
UNION
SELECT 8 AS ID_VEJEZ, 'DE 7 A 10 DIAS DE VEJEZ' AS NOMBRE_RANGO, 4 AS ORDEN
UNION
SELECT 9 AS ID_VEJEZ, 'DE 7 A 10 DIAS DE VEJEZ' AS NOMBRE_RANGO, 4 AS ORDEN
UNION
SELECT 10 AS ID_VEJEZ, 'DE 7 A 10 DIAS DE VEJEZ' AS NOMBRE_RANGO, 4 AS ORDEN
UNION
SELECT 11 AS ID_VEJEZ, 'DE 11 A 20 DIAS DE VEJEZ' AS NOMBRE_RANGO, 5 AS ORDEN
UNION
SELECT 12 AS ID_VEJEZ, 'DE 11 A 20 DIAS DE VEJEZ' AS NOMBRE_RANGO, 5 AS ORDEN
UNION
SELECT 13 AS ID_VEJEZ, 'DE 11 A 20 DIAS DE VEJEZ' AS NOMBRE_RANGO, 5 AS ORDEN
UNION
SELECT 14 AS ID_VEJEZ, 'DE 11 A 20 DIAS DE VEJEZ' AS NOMBRE_RANGO, 5 AS ORDEN
UNION
SELECT 15 AS ID_VEJEZ, 'DE 11 A 20 DIAS DE VEJEZ' AS NOMBRE_RANGO, 5 AS ORDEN
UNION
SELECT 16 AS ID_VEJEZ, 'DE 11 A 20 DIAS DE VEJEZ' AS NOMBRE_RANGO, 5 AS ORDEN
UNION
SELECT 17 AS ID_VEJEZ, 'DE 11 A 20 DIAS DE VEJEZ' AS NOMBRE_RANGO, 5 AS ORDEN
UNION
SELECT 18 AS ID_VEJEZ, 'DE 11 A 20 DIAS DE VEJEZ' AS NOMBRE_RANGO, 5 AS ORDEN
UNION
SELECT 19 AS ID_VEJEZ, 'DE 11 A 20 DIAS DE VEJEZ' AS NOMBRE_RANGO, 5 AS ORDEN
UNION
SELECT 20 AS ID_VEJEZ, 'DE 11 A 20 DIAS DE VEJEZ' AS NOMBRE_RANGO, 5 AS ORDEN
UNION
SELECT 21 AS ID_VEJEZ, 'DE 21 A 30 DIAS DE VEJEZ' AS NOMBRE_RANGO, 6 AS ORDEN
UNION
SELECT 22 AS ID_VEJEZ, 'DE 21 A 30 DIAS DE VEJEZ' AS NOMBRE_RANGO, 6 AS ORDEN
UNION
SELECT 23 AS ID_VEJEZ, 'DE 21 A 30 DIAS DE VEJEZ' AS NOMBRE_RANGO, 6 AS ORDEN
UNION
SELECT 24 AS ID_VEJEZ, 'DE 21 A 30 DIAS DE VEJEZ' AS NOMBRE_RANGO, 6 AS ORDEN
UNION
