        <SQLTask:SqlTaskData
          SQLTask:Connection="{0A780CA5-176D-4393-A0A7-F578C6D072B0}"
          SQLTask:SqlStatementSource="DELETE [SIG_LOGISTICA_DM].[FAC].[MPCCO_VJ_VEJEZ_BODEGA_CIERRE_OPERATIVO] &#xA;WHERE SEG_ID_PROCESO IN(24,11)&#xA;&#xA;DELETE [SIG_LOGISTICA_DM].[FAC].[MPCCO_VJ_VEJEZ_BODEGA_CIERRE_OPERATIVO] &#xA;WHERE PE_TIPO_PRUEBA_ENTREGA IN(1,2)&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\PS01 UPDATE GUIAS"
      DTS:CreationName="STOCK:SEQUENCE"
      DTS:Description="Sequence Container"
      DTS:DTSID="{3B29B62C-C8D4-418E-8DC0-CD13D2C27D88}"
      DTS:ExecutableType="STOCK:SEQUENCE"
      DTS:LocaleID="-1"
      DTS:ObjectName="PS01 UPDATE GUIAS">
      <DTS:Variables />
      <DTS:Executables>
        <DTS:Executable
          DTS:refId="Package\PS01 UPDATE GUIAS\PS01 UPDATE GUIAS"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:Disabled="True"
          DTS:DTSID="{02696560-E0D9-4DE5-910E-342C3C2E2E85}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="PS01 UPDATE GUIAS"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="3">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{0A780CA5-176D-4393-A0A7-F578C6D072B0}"
              SQLTask:SqlStatementSource="/* =====================================================================&#xA;   Carga incremental por lotes - MPCCO_VJ_VEJEZ_BODEGA_CIERRE_OPERATIVO&#xA;   =====================================================================&#xA;   Reemplaza el DELETE + INSERT masivo (todo TMP contra FAC de una vez)&#xA;   por un proceso en dos partes, sin depender de UPDATE:&#xA;&#xA;   PARTE 1 - INSERT de guias nuevas (no existen aun en FAC)&#xA;     Insert directo, sin necesidad de batch (son altas puras, no tocan&#xA;     filas existentes de FAC).&#xA;&#xA;   PARTE 2 - Actualizacion de guias que ya existen en FAC (hacen match)&#xA;     1) Se materializan en TMP.STG_VEJEZ_BODEGA las guias que hacen&#xA;        match entre TMP y FAC (pendientes de &quot;actualizar&quot;).&#xA;     2) WHILE queda algo en el staging:&#xA;          - Toma TOP 10000 guias del staging&#xA;          - DELETE en FAC de esas guias&#xA;          - INSERT en FAC de esas mismas guias, con los datos de TMP&#xA;          - Elimina esas guias del staging (asi el staging se va&#xA;            vaciando y el proceso es reanudable: si se corta a mitad&#xA;            de camino, al volver a correr solo faltan las que quedan&#xA;            en TMP.STG_VEJEZ_BODEGA, sin reprocesar lo ya hecho)&#xA;&#xA;   Notas de rendimiento / bloqueos:&#xA;     - NOLOCK se retiro de FAC en las operaciones de escritura (DELETE):&#xA;       usar NOLOCK sobre la tabla que se esta modificando en la misma&#xA;       instruccion puede saltar o duplicar filas; no aporta beneficio&#xA;       real ahi y es riesgoso.&#xA;     - ROWLOCK + READCOMMITTEDLOCK fuerzan bloqueo a nivel de fila en&#xA;       vez de dejar que el motor escale a bloqueo de pagina/tabla,&#xA;       reduciendo el impacto sobre otros procesos que lean FAC.&#xA;     - READPAST en la lectura del staging permite saltar filas que&#xA;       otro proceso tenga bloqueadas en ese instante, en vez de&#xA;       esperarlas (util si corren cargas en paralelo sobre el staging).&#xA;     - Transacciones cortas (una por lote, no una para todo el proceso)&#xA;       evitan crecimiento excesivo del log y bloqueos prolongados.&#xA;     - WAITFOR DELAY entre lotes da tiempo a que otros procesos&#xA;       obtengan turno sobre FAC/TMP y evita saturar el lock manager.&#xA;   ===================================================================== */&#xA;&#xA;SET NOCOUNT ON;&#xA;SET XACT_ABORT ON; -- si una instruccion falla dentro de la transaccion, se revierte todo el lote automaticamente&#xA;&#xA;-------------------------------------------------------------------------&#xA;-- PARTE 1: INSERT de guias nuevas (LEFT JOIN ... FAC IS NULL)&#xA;--          ROWLOCK evita escalamiento a bloqueo de tabla en un insert&#xA;--          potencialmente grande.&#xA;-------------------------------------------------------------------------&#xA;INSERT INTO FAC.MPCCO_VJ_VEJEZ_BODEGA_CIERRE_OPERATIVO WITH (ROWLOCK)&#xA;SELECT&#xA;     TMP.G_NUMERO_GUIA, TMP.G_ID_TIPOGUIA, TMP.G_ID_CLIENTE, TMP.NOMBRE_CLIENTE, TMP.G_ID_CANAL&#xA;    ,TMP.G_ID_DIVISION_PROV, TMP.G_ID_PAIS_ORIGEN, TMP.G_ID_CIUDAD_ORIGEN, TMP.G_NOMBRE_CIUDAD_INICIAL_ORIGEN&#xA;    ,TMP.G_ID_PAIS_DESTINO, TMP.G_ID_CIUDAD_DESTINO, TMP.G_NOMBRE_CIUDAD_FINAL_DESTINO&#xA;    ,TMP.G_ID_TIPO_ZONA_URBA, TMP.G_ID_PAIS_ZONA_URB_ENTR, TMP.G_ID_CIUDAD_ZONA_URB_ENTR, TMP.G_ID_ZONA_URBA&#xA;    ,TMP.G_ID_ESTADOENVIO, TMP.G_ID_ESTADOGUIA, TMP.G_NOMBRE_ESTADOENVIO, TMP.G_NOMBRE_ESTADOGUIA&#xA;    ,TMP.G_ID_CARACT_ENVIO, TMP.G_ID_TIEMPO, TMP.G_ID_MEDTRANS, TMP.G_ID_PRODUCTO, TMP.G_ID_SUBPRODUCTO&#xA;    ,TMP.NOMBRE_SUBPRODUCTO, TMP.NOMBRE_PRODUCTO, TMP.NOMBRE_UEN, TMP.G_FECHA_ENVIO&#xA;    ,TMP.G_ID_REMITE, TMP.G_ID_DESTINA, TMP.G_NOMBRE_REMITE_GUIA, TMP.G_APELLIDO_REMITE_GUIA&#xA;    ,TMP.G_NOMBRE_DESTINA_GUIA, TMP.G_APELLIDO_DESTINA_GUIA, TMP.G_TELEFONO_REMITE_GUIA, TMP.G_TELEFONO_DESTINA_GUIA&#xA;    ,TMP.G_DIRECCION_REMITE_GUIA, TMP.G_DIRECCION_DESTINA_GUIA, TMP.G_CONTENIDO&#xA;    ,TMP.G_LARGO_ENVIO, TMP.G_ALTO_ENVIO, TMP.G_ANCHO_ENVIO, TMP.G_LARGO_ENV_OPERA, TMP.G_ALTO_ENV_OPERA, TMP.G_ANCHO_ENV_OPERA&#xA;    ,TMP.G_PESO_GUIA, TMP.G_PESO_FISICO_GUIA, TMP.G_PESO_VOLU_GUIA, TMP.G_PESO_FISICO_OPERA, TMP.G_PESO_VOLU_OPERA, TMP.G_PESO_FACTURADO&#xA;    ,TMP.G_FECHA_ENTREGA, TMP.G_NUMERO_PIEZAS&#xA;    ,TMP.G_VALOR_DECLARADO_GUIA, TMP.G_VALOR_SEG_MAN_GUIAS, TMP.G_VALOR_FLETES_GUIAS, TMP.G_VALOR_DESCUENTO_GUIAS&#xA;    ,TMP.G_VALOR_PEDIDO_GUIAS, TMP.G_VALOR_SEG_MAN_GUIAS_FACT, TMP.G_VALOR_FLETES_GUIAS_FACT&#xA;    ,TMP.G_FECHA_CREACION, TMP.G_FECHA_MODIFICACION_DG&#xA;    ,TMP.SEG_ID_PROCESO, TMP.SEG_NUMERO_MOVIMI, TMP.SEG_CONSECUT_MOVIMI, TMP.SEG_ID_CONCEPTO, TMP.SEG_ID_TIPOENVIO&#xA;    ,TMP.SEG_ID_ENVIO_CRUZADO, TMP.SEG_PESO_ENVIO, TMP.SEG_LARGO_ENVIO, TMP.SEG_ANCHO_ENVIO, TMP.SEG_ALTO_ENVIO&#xA;    ,TMP.SEG_FECHA_HORA_MOVIMIENTO, TMP.SEG_NUMERO_PIEZAS, TMP.SEG_FECHA_CREACION, TMP.SEG_FECHA_MODIFICACION, TMP.SEG_FECHA_EXTRACCION&#xA;    ,TMP.DOC_ID_TIPO_ZONA_URBA, TMP.DOC_ID_PAIS_ZONA_URBA, TMP.DOC_ID_CIUDAD_ZONA_URBA, TMP.DOC_ID_ZONA_URBA&#xA;    ,TMP.DOC_NOMBRE_ZONA_URBANA, TMP.DOC_NOMBRE_CATEGORIA_ZONA_URBANA&#xA;    ,TMP.DOC_ID_PAIS_DIVISION_ORIGEN, TMP.DOC_ID_CIUDAD_DIVISION_ORIGEN, TMP.DOC_NOMBRE_CIUDAD_ORIGEN&#xA;    ,TMP.CPL_ORG, TMP.DOC_ID_DIVISION_ORIGEN, TMP.DOC_NOMBRE_DIVISION_ORG, TMP.DOC_NOMBRE_TIPO_BODEGA_ORG&#xA;    ,TMP.DOC_ID_PAIS_DESTINO, TMP.DOC_ID_CIUDAD_DESTINO, TMP.DOC_ID_DIVISION_DESTINO, TMP.DOC_NOMBRE_CIUDAD_DESTINO&#xA;    ,TMP.CPL_DES, TMP.DOC_NOMBRE_DIVISION_DEST, TMP.DOC_NOMBRE_TIPO_BODEGA_DEST&#xA;    ,TMP.DOC_ID_COURIER_CONDUCTOR, TMP.DOC_ID_PAIS_OPERATIVO, TMP.DOC_ID_CIUDAD_OPERATIVO, TMP.DOC_ID_OPERATIVO&#xA;    ,TMP.DOC_ID_RUTA, TMP.DOC_ID_PAIS_CANAL, TMP.DOC_ID_CIUDAD_CANAL, TMP.DOC_ID_CANAL, TMP.DOC_ID_TIPO_LOGISTICA&#xA;    ,TMP.DOC_FECHA_HORA_MOVIMI, TMP.DOC_TOTAL_ENVIOS, TMP.DOC_PESO_TOTAL, TMP.DOC_PLACA_VEHICULO_DOCU&#xA;    ,TMP.DOC_ESTADO_MOVIMI, TMP.DOC_NUME_SELLO_SEGURIDAD, TMP.DOC_ID_TIPO_MOVIMIENTO, TMP.DOC_ID_ESTADO_TRANS_ZONA&#xA;    ,TMP.DOC_ID_AUXILIAR2_VEHICULO, TMP.DOC_FECHA_CREACION, TMP.DOC_FECHA_MODIFICACION&#xA;    ,TMP.PE_TIPO_PRUEBA_ENTREGA, TMP.PE_GENERACION_PE, TMP.PE_FECHA_DIGITALIZACION, TMP.PE_FECHA_CREACION&#xA;    ,TMP.DOC_NOMBRE_REGIONAL_ORIGEN, TMP.DOC_NOMBRE_REGIONAL_DESTRINO&#xA;    ,TMP.G_NOMBRE_REGIONAL_FINAL_DESTINO, TMP.G_NOMBRE_REGIONAL_INICIAL_ORIGEN&#xA;    ,TMP.PRIM_EZU_EPS_ER_SEG_FECHA_HORA_MOVIMIENTO, TMP.PRIM_EZU_EPS_ER_SEG_PROCESO&#xA;    ,TMP.FECHA_ACTUAL_DEL_SISTEMA, TMP.NUMERO_DE_FESTIVOS_Y_DOMINICALES, TMP.NUMERO_DE_ORDINARIOS&#xA;    ,TMP.TIMEPO_PROMESA_OPERATIVA_H, TMP.TIMEPO_PROMESA_OPERATIVA_D, TMP.FECHA_PROMESA_ENTREGA&#xA;    ,TMP.ID_DIAS_VEJEZ_BODEGA_02, TMP.DIAS_VEJEZ_BODEGA_02&#xA;    ,TMP.ID_GENERO_EV, TMP.FECHA_GENERO_EV&#xA;    ,TMP.FORMA_PAGO, TMP.VALOR_A_RECAUDAR, TMP.VALOR_RECAUDADO, TMP.NUMERO_ORDEN_SERVICIO, TMP.ESTA_RECAUDADO&#xA;    ,ID_PROCESS = 1&#xA;FROM [SIG_COLOMBIA_DW].[TMP].[MPCCO_VJ_PS01] TMP WITH (NOLOCK)&#xA;LEFT JOIN FAC.MPCCO_VJ_VEJEZ_BODEGA_CIERRE_OPERATIVO FAC WITH (NOLOCK)&#xA;    ON TMP.G_NUMERO_GUIA = FAC.G_NUMERO_GUIA&#xA;WHERE FAC.G_NUMERO_GUIA IS NULL;&#xA;&#xA;-------------------------------------------------------------------------&#xA;-- PARTE 2: Preparacion del staging con las guias que hacen match&#xA;--          (pendientes de refrescar via DELETE + INSERT por lotes)&#xA;-------------------------------------------------------------------------&#xA;IF OBJECT_ID('TMP.STG_VEJEZ_BODEGA') IS NOT NULL&#xA;    DROP TABLE TMP.STG_VEJEZ_BODEGA;&#xA;&#xA;SELECT TMP.G_NUMERO_GUIA&#xA;INTO TMP.STG_VEJEZ_BODEGA&#xA;FROM [SIG_COLOMBIA_DW].[TMP].[MPCCO_VJ_PS01] TMP WITH (NOLOCK INDEX=[TMP_IX_VEJEZBOD_GUIA])&#xA;INNER JOIN FAC.MPCCO_VJ_VEJEZ_BODEGA_CIERRE_OPERATIVO FAC WITH (NOLOCK INDEX=[IX_VEJEZBOD_GUIA])&#xA;    ON TMP.G_NUMERO_GUIA = FAC.G_NUMERO_GUIA&#xA;GROUP BY TMP.G_NUMERO_GUIA;&#xA;&#xA;-- Indice para que el TOP 10000 y el DELETE del staging sean eficientes&#xA;CREATE CLUSTERED INDEX IX_STG_VEJEZ_BODEGA_GUIA ON TMP.STG_VEJEZ_BODEGA (G_NUMERO_GUIA);&#xA;&#xA;-------------------------------------------------------------------------&#xA;-- PARTE 3: Bucle por lotes de 10000 - consume el staging hasta vaciarlo&#xA;--          Reanudable: si el proceso se corta, TMP.STG_VEJEZ_BODEGA&#xA;--          conserva solo lo que falta por procesar.&#xA;-------------------------------------------------------------------------&#xA;DECLARE @TamanoLote     INT = 10000;&#xA;DECLARE @FilasAfectadas INT = 1;&#xA;DECLARE @TotalLotes     INT = 0;&#xA;DECLARE @TotalFilas     INT = 0;&#xA;DECLARE @EsperaEntreLotes CHAR(8) = '00:00:00.300'; -- pausa breve entre lotes; ajustar segun carga del servidor&#xA;&#xA;IF OBJECT_ID('tempdb..#LOTE_GUIAS') IS NOT NULL DROP TABLE #LOTE_GUIAS;&#xA;&#xA;CREATE TABLE #LOTE_GUIAS&#xA;(&#xA;    G_NUMERO_GUIA VARCHAR(50) PRIMARY KEY -- ajustar tipo/longitud al de G_NUMERO_GUIA real&#xA;);&#xA;&#xA;WHILE EXISTS (SELECT 1 FROM TMP.STG_VEJEZ_BODEGA)&#xA;BEGIN&#xA;    BEGIN TRY&#xA;        TRUNCATE TABLE #LOTE_GUIAS;&#xA;&#xA;        -- 3.1 Toma el siguiente lote de hasta 10000 guias pendientes del staging.&#xA;        --     READPAST: si otro proceso tiene bloqueadas algunas filas del&#xA;        --     staging, se saltan en vez de esperarlas.&#xA;        INSERT INTO #LOTE_GUIAS (G_NUMERO_GUIA)&#xA;        SELECT TOP (@TamanoLote) G_NUMERO_GUIA&#xA;        FROM TMP.STG_VEJEZ_BODEGA WITH (READPAST);&#xA;&#xA;        SET @FilasAfectadas = @@ROWCOUNT;&#xA;&#xA;        IF @FilasAfectadas = 0&#xA;            BREAK;&#xA;&#xA;        BEGIN TRANSACTION;&#xA;&#xA;        -- 3.2 DELETE en FAC de las guias del lote.&#xA;        --     ROWLOCK + READCOMMITTEDLOCK: bloqueo fila a fila (no pagina/tabla),&#xA;        --     para no frenar a otros procesos que consulten FAC en paralelo.&#xA;        --     No se usa NOLOCK aqui: NOLOCK sobre la tabla que se esta&#xA;        --     modificando puede saltar u omitir filas de forma inconsistente.&#xA;        DELETE FAC&#xA;        FROM FAC.MPCCO_VJ_VEJEZ_BODEGA_CIERRE_OPERATIVO FAC WITH (ROWLOCK, READCOMMITTEDLOCK, INDEX=[IX_VEJEZBOD_GUIA])&#xA;        INNER JOIN #LOTE_GUIAS L&#xA;            ON FAC.G_NUMERO_GUIA = L.G_NUMERO_GUIA;&#xA;&#xA;        -- 3.3 INSERT en FAC de las guias del lote, con los datos actuales de TMP.&#xA;        --     TABLOCK aqui aplicaria bloqueo de tabla; se omite a proposito&#xA;        --     para mantener granularidad de fila (ROWLOCK) y no bloquear&#xA;        --     lectores concurrentes de FAC.&#xA;        INSERT INTO FAC.MPCCO_VJ_VEJEZ_BODEGA_CIERRE_OPERATIVO WITH (ROWLOCK)&#xA;        SELECT&#xA;             TMP.G_NUMERO_GUIA, TMP.G_ID_TIPOGUIA, TMP.G_ID_CLIENTE, TMP.NOMBRE_CLIENTE, TMP.G_ID_CANAL&#xA;            ,TMP.G_ID_DIVISION_PROV, TMP.G_ID_PAIS_ORIGEN, TMP.G_ID_CIUDAD_ORIGEN, TMP.G_NOMBRE_CIUDAD_INICIAL_ORIGEN&#xA;            ,TMP.G_ID_PAIS_DESTINO, TMP.G_ID_CIUDAD_DESTINO, TMP.G_NOMBRE_CIUDAD_FINAL_DESTINO&#xA;            ,TMP.G_ID_TIPO_ZONA_URBA, TMP.G_ID_PAIS_ZONA_URB_ENTR, TMP.G_ID_CIUDAD_ZONA_URB_ENTR, TMP.G_ID_ZONA_URBA&#xA;            ,TMP.G_ID_ESTADOENVIO, TMP.G_ID_ESTADOGUIA, TMP.G_NOMBRE_ESTADOENVIO, TMP.G_NOMBRE_ESTADOGUIA&#xA;            ,TMP.G_ID_CARACT_ENVIO, TMP.G_ID_TIEMPO, TMP.G_ID_MEDTRANS, TMP.G_ID_PRODUCTO, TMP.G_ID_SUBPRODUCTO&#xA;            ,TMP.NOMBRE_SUBPRODUCTO, TMP.NOMBRE_PRODUCTO, TMP.NOMBRE_UEN, TMP.G_FECHA_ENVIO&#xA;            ,TMP.G_ID_REMITE, TMP.G_ID_DESTINA, TMP.G_NOMBRE_REMITE_GUIA, TMP.G_APELLIDO_REMITE_GUIA&#xA;            ,TMP.G_NOMBRE_DESTINA_GUIA, TMP.G_APELLIDO_DESTINA_GUIA, TMP.G_TELEFONO_REMITE_GUIA, TMP.G_TELEFONO_DESTINA_GUIA&#xA;            ,TMP.G_DIRECCION_REMITE_GUIA, TMP.G_DIRECCION_DESTINA_GUIA, TMP.G_CONTENIDO&#xA;            ,TMP.G_LARGO_ENVIO, TMP.G_ALTO_ENVIO, TMP.G_ANCHO_ENVIO, TMP.G_LARGO_ENV_OPERA, TMP.G_ALTO_ENV_OPERA, TMP.G_ANCHO_ENV_OPERA&#xA;            ,TMP.G_PESO_GUIA, TMP.G_PESO_FISICO_GUIA, TMP.G_PESO_VOLU_GUIA, TMP.G_PESO_FISICO_OPERA, TMP.G_PESO_VOLU_OPERA, TMP.G_PESO_FACTURADO&#xA;            ,TMP.G_FECHA_ENTREGA, TMP.G_NUMERO_PIEZAS&#xA;            ,TMP.G_VALOR_DECLARADO_GUIA, TMP.G_VALOR_SEG_MAN_GUIAS, TMP.G_VALOR_FLETES_GUIAS, TMP.G_VALOR_DESCUENTO_GUIAS&#xA;            ,TMP.G_VALOR_PEDIDO_GUIAS, TMP.G_VALOR_SEG_MAN_GUIAS_FACT, TMP.G_VALOR_FLETES_GUIAS_FACT&#xA;            ,TMP.G_FECHA_CREACION, TMP.G_FECHA_MODIFICACION_DG&#xA;            ,TMP.SEG_ID_PROCESO, TMP.SEG_NUMERO_MOVIMI, TMP.SEG_CONSECUT_MOVIMI, TMP.SEG_ID_CONCEPTO, TMP.SEG_ID_TIPOENVIO&#xA;            ,TMP.SEG_ID_ENVIO_CRUZADO, TMP.SEG_PESO_ENVIO, TMP.SEG_LARGO_ENVIO, TMP.SEG_ANCHO_ENVIO, TMP.SEG_ALTO_ENVIO&#xA;            ,TMP.SEG_FECHA_HORA_MOVIMIENTO, TMP.SEG_NUMERO_PIEZAS, TMP.SEG_FECHA_CREACION, TMP.SEG_FECHA_MODIFICACION, TMP.SEG_FECHA_EXTRACCION&#xA;            ,TMP.DOC_ID_TIPO_ZONA_URBA, TMP.DOC_ID_PAIS_ZONA_URBA, TMP.DOC_ID_CIUDAD_ZONA_URBA, TMP.DOC_ID_ZONA_URBA&#xA;            ,TMP.DOC_NOMBRE_ZONA_URBANA, TMP.DOC_NOMBRE_CATEGORIA_ZONA_URBANA&#xA;            ,TMP.DOC_ID_PAIS_DIVISION_ORIGEN, TMP.DOC_ID_CIUDAD_DIVISION_ORIGEN, TMP.DOC_NOMBRE_CIUDAD_ORIGEN&#xA;            ,TMP.CPL_ORG, TMP.DOC_ID_DIVISION_ORIGEN, TMP.DOC_NOMBRE_DIVISION_ORG, TMP.DOC_NOMBRE_TIPO_BODEGA_ORG&#xA;            ,TMP.DOC_ID_PAIS_DESTINO, TMP.DOC_ID_CIUDAD_DESTINO, TMP.DOC_ID_DIVISION_DESTINO, TMP.DOC_NOMBRE_CIUDAD_DESTINO&#xA;            ,TMP.CPL_DES, TMP.DOC_NOMBRE_DIVISION_DEST, TMP.DOC_NOMBRE_TIPO_BODEGA_DEST&#xA;            ,TMP.DOC_ID_COURIER_CONDUCTOR, TMP.DOC_ID_PAIS_OPERATIVO, TMP.DOC_ID_CIUDAD_OPERATIVO, TMP.DOC_ID_OPERATIVO&#xA;            ,TMP.DOC_ID_RUTA, TMP.DOC_ID_PAIS_CANAL, TMP.DOC_ID_CIUDAD_CANAL, TMP.DOC_ID_CANAL, TMP.DOC_ID_TIPO_LOGISTICA&#xA;            ,TMP.DOC_FECHA_HORA_MOVIMI, TMP.DOC_TOTAL_ENVIOS, TMP.DOC_PESO_TOTAL, TMP.DOC_PLACA_VEHICULO_DOCU&#xA;            ,TMP.DOC_ESTADO_MOVIMI, TMP.DOC_NUME_SELLO_SEGURIDAD, TMP.DOC_ID_TIPO_MOVIMIENTO, TMP.DOC_ID_ESTADO_TRANS_ZONA&#xA;            ,TMP.DOC_ID_AUXILIAR2_VEHICULO, TMP.DOC_FECHA_CREACION, TMP.DOC_FECHA_MODIFICACION&#xA;            ,TMP.PE_TIPO_PRUEBA_ENTREGA, TMP.PE_GENERACION_PE, TMP.PE_FECHA_DIGITALIZACION, TMP.PE_FECHA_CREACION&#xA;            ,TMP.DOC_NOMBRE_REGIONAL_ORIGEN, TMP.DOC_NOMBRE_REGIONAL_DESTRINO&#xA;            ,TMP.G_NOMBRE_REGIONAL_FINAL_DESTINO, TMP.G_NOMBRE_REGIONAL_INICIAL_ORIGEN&#xA;            ,TMP.PRIM_EZU_EPS_ER_SEG_FECHA_HORA_MOVIMIENTO, TMP.PRIM_EZU_EPS_ER_SEG_PROCESO&#xA;            ,TMP.FECHA_ACTUAL_DEL_SISTEMA, TMP.NUMERO_DE_FESTIVOS_Y_DOMINICALES, TMP.NUMERO_DE_ORDINARIOS&#xA;            ,TMP.TIMEPO_PROMESA_OPERATIVA_H, TMP.TIMEPO_PROMESA_OPERATIVA_D, TMP.FECHA_PROMESA_ENTREGA&#xA;            ,TMP.ID_DIAS_VEJEZ_BODEGA_02, TMP.DIAS_VEJEZ_BODEGA_02&#xA;            ,TMP.ID_GENERO_EV, TMP.FECHA_GENERO_EV&#xA;            ,TMP.FORMA_PAGO, TMP.VALOR_A_RECAUDAR, TMP.VALOR_RECAUDADO, TMP.NUMERO_ORDEN_SERVICIO, TMP.ESTA_RECAUDADO&#xA;            ,ID_PROCESS = 1&#xA;        FROM [SIG_COLOMBIA_DW].[TMP].[MPCCO_VJ_PS01] TMP WITH (NOLOCK INDEX=[TMP_IX_VEJEZBOD_GUIA])&#xA;        INNER JOIN #LOTE_GUIAS L&#xA;            ON TMP.G_NUMERO_GUIA = L.G_NUMERO_GUIA;&#xA;&#xA;        -- 3.4 Quita del staging las guias ya procesadas en este lote&#xA;        DELETE STG&#xA;        FROM TMP.STG_VEJEZ_BODEGA STG WITH (ROWLOCK)&#xA;        INNER JOIN #LOTE_GUIAS L&#xA;            ON STG.G_NUMERO_GUIA = L.G_NUMERO_GUIA;&#xA;&#xA;        COMMIT TRANSACTION;&#xA;&#xA;        SET @TotalLotes = @TotalLotes + 1;&#xA;        SET @TotalFilas = @TotalFilas + @FilasAfectadas;&#xA;&#xA;        PRINT 'Lote ' + CAST(@TotalLotes AS VARCHAR) + ' procesado. Filas: ' + CAST(@FilasAfectadas AS VARCHAR);&#xA;&#xA;        -- Pausa breve entre lotes: da chance a otros procesos de tomar&#xA;        -- turno sobre FAC/TMP y evita presionar el log/lock manager&#xA;        -- de forma continua durante toda la carga.&#xA;        WAITFOR DELAY @EsperaEntreLotes;&#xA;&#xA;    END TRY&#xA;    BEGIN CATCH&#xA;        IF XACT_STATE() &lt;&gt; 0 ROLLBACK TRANSACTION;&#xA;&#xA;        PRINT 'ERROR en lote ' + CAST(@TotalLotes + 1 AS VARCHAR) + ': ' + ERROR_MESSAGE();&#xA;        THROW; -- al reintentar, TMP.STG_VEJEZ_BODEGA aun conserva lo pendiente&#xA;    END CATCH&#xA;END;&#xA;&#xA;IF OBJECT_ID('tempdb..#LOTE_GUIAS') IS NOT NULL DROP TABLE #LOTE_GUIAS;&#xA;&#xA;-- Staging queda vacio al terminar; se puede dejar como historico o limpiar aqui&#xA;-- IF OBJECT_ID('TMP.STG_VEJEZ_BODEGA') IS NOT NULL DROP TABLE TMP.STG_VEJEZ_BODEGA;&#xA;&#xA;PRINT 'Carga incremental finalizada. Total lotes: ' + CAST(@TotalLotes AS VARCHAR)&#xA;      + '. Total filas actualizadas: ' + CAST(@TotalFilas AS VARCHAR) + '.';&#xA;&#xA;&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\PS01 UPDATE GUIAS\PS01 UPDATE GUIAS PARTE 01"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{2E9F6675-5F58-4098-B680-E6C38BB4CAD2}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="PS01 UPDATE GUIAS PARTE 01"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="3">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{0A780CA5-176D-4393-A0A7-F578C6D072B0}"
              SQLTask:SqlStatementSource="INSERT INTO FAC.MPCCO_VJ_VEJEZ_BODEGA_CIERRE_OPERATIVO WITH (ROWLOCK)&#xA;SELECT&#xA;     TMP.G_NUMERO_GUIA, TMP.G_ID_TIPOGUIA, TMP.G_ID_CLIENTE, TMP.NOMBRE_CLIENTE, TMP.G_ID_CANAL&#xA;    ,TMP.G_ID_DIVISION_PROV, TMP.G_ID_PAIS_ORIGEN, TMP.G_ID_CIUDAD_ORIGEN, TMP.G_NOMBRE_CIUDAD_INICIAL_ORIGEN&#xA;    ,TMP.G_ID_PAIS_DESTINO, TMP.G_ID_CIUDAD_DESTINO, TMP.G_NOMBRE_CIUDAD_FINAL_DESTINO&#xA;    ,TMP.G_ID_TIPO_ZONA_URBA, TMP.G_ID_PAIS_ZONA_URB_ENTR, TMP.G_ID_CIUDAD_ZONA_URB_ENTR, TMP.G_ID_ZONA_URBA&#xA;    ,TMP.G_ID_ESTADOENVIO, TMP.G_ID_ESTADOGUIA, TMP.G_NOMBRE_ESTADOENVIO, TMP.G_NOMBRE_ESTADOGUIA&#xA;    ,TMP.G_ID_CARACT_ENVIO, TMP.G_ID_TIEMPO, TMP.G_ID_MEDTRANS, TMP.G_ID_PRODUCTO, TMP.G_ID_SUBPRODUCTO&#xA;    ,TMP.NOMBRE_SUBPRODUCTO, TMP.NOMBRE_PRODUCTO, TMP.NOMBRE_UEN, TMP.G_FECHA_ENVIO&#xA;    ,TMP.G_ID_REMITE, TMP.G_ID_DESTINA, TMP.G_NOMBRE_REMITE_GUIA, TMP.G_APELLIDO_REMITE_GUIA&#xA;    ,TMP.G_NOMBRE_DESTINA_GUIA, TMP.G_APELLIDO_DESTINA_GUIA, TMP.G_TELEFONO_REMITE_GUIA, TMP.G_TELEFONO_DESTINA_GUIA&#xA;    ,TMP.G_DIRECCION_REMITE_GUIA, TMP.G_DIRECCION_DESTINA_GUIA, TMP.G_CONTENIDO&#xA;    ,TMP.G_LARGO_ENVIO, TMP.G_ALTO_ENVIO, TMP.G_ANCHO_ENVIO, TMP.G_LARGO_ENV_OPERA, TMP.G_ALTO_ENV_OPERA, TMP.G_ANCHO_ENV_OPERA&#xA;    ,TMP.G_PESO_GUIA, TMP.G_PESO_FISICO_GUIA, TMP.G_PESO_VOLU_GUIA, TMP.G_PESO_FISICO_OPERA, TMP.G_PESO_VOLU_OPERA, TMP.G_PESO_FACTURADO&#xA;    ,TMP.G_FECHA_ENTREGA, TMP.G_NUMERO_PIEZAS&#xA;    ,TMP.G_VALOR_DECLARADO_GUIA, TMP.G_VALOR_SEG_MAN_GUIAS, TMP.G_VALOR_FLETES_GUIAS, TMP.G_VALOR_DESCUENTO_GUIAS&#xA;    ,TMP.G_VALOR_PEDIDO_GUIAS, TMP.G_VALOR_SEG_MAN_GUIAS_FACT, TMP.G_VALOR_FLETES_GUIAS_FACT&#xA;    ,TMP.G_FECHA_CREACION, TMP.G_FECHA_MODIFICACION_DG&#xA;    ,TMP.SEG_ID_PROCESO, TMP.SEG_NUMERO_MOVIMI, TMP.SEG_CONSECUT_MOVIMI, TMP.SEG_ID_CONCEPTO, TMP.SEG_ID_TIPOENVIO&#xA;    ,TMP.SEG_ID_ENVIO_CRUZADO, TMP.SEG_PESO_ENVIO, TMP.SEG_LARGO_ENVIO, TMP.SEG_ANCHO_ENVIO, TMP.SEG_ALTO_ENVIO&#xA;    ,TMP.SEG_FECHA_HORA_MOVIMIENTO, TMP.SEG_NUMERO_PIEZAS, TMP.SEG_FECHA_CREACION, TMP.SEG_FECHA_MODIFICACION, TMP.SEG_FECHA_EXTRACCION&#xA;    ,TMP.DOC_ID_TIPO_ZONA_URBA, TMP.DOC_ID_PAIS_ZONA_URBA, TMP.DOC_ID_CIUDAD_ZONA_URBA, TMP.DOC_ID_ZONA_URBA&#xA;    ,TMP.DOC_NOMBRE_ZONA_URBANA, TMP.DOC_NOMBRE_CATEGORIA_ZONA_URBANA&#xA;    ,TMP.DOC_ID_PAIS_DIVISION_ORIGEN, TMP.DOC_ID_CIUDAD_DIVISION_ORIGEN, TMP.DOC_NOMBRE_CIUDAD_ORIGEN&#xA;    ,TMP.CPL_ORG, TMP.DOC_ID_DIVISION_ORIGEN, TMP.DOC_NOMBRE_DIVISION_ORG, TMP.DOC_NOMBRE_TIPO_BODEGA_ORG&#xA;    ,TMP.DOC_ID_PAIS_DESTINO, TMP.DOC_ID_CIUDAD_DESTINO, TMP.DOC_ID_DIVISION_DESTINO, TMP.DOC_NOMBRE_CIUDAD_DESTINO&#xA;    ,TMP.CPL_DES, TMP.DOC_NOMBRE_DIVISION_DEST, TMP.DOC_NOMBRE_TIPO_BODEGA_DEST&#xA;    ,TMP.DOC_ID_COURIER_CONDUCTOR, TMP.DOC_ID_PAIS_OPERATIVO, TMP.DOC_ID_CIUDAD_OPERATIVO, TMP.DOC_ID_OPERATIVO&#xA;    ,TMP.DOC_ID_RUTA, TMP.DOC_ID_PAIS_CANAL, TMP.DOC_ID_CIUDAD_CANAL, TMP.DOC_ID_CANAL, TMP.DOC_ID_TIPO_LOGISTICA&#xA;    ,TMP.DOC_FECHA_HORA_MOVIMI, TMP.DOC_TOTAL_ENVIOS, TMP.DOC_PESO_TOTAL, TMP.DOC_PLACA_VEHICULO_DOCU&#xA;    ,TMP.DOC_ESTADO_MOVIMI, TMP.DOC_NUME_SELLO_SEGURIDAD, TMP.DOC_ID_TIPO_MOVIMIENTO, TMP.DOC_ID_ESTADO_TRANS_ZONA&#xA;    ,TMP.DOC_ID_AUXILIAR2_VEHICULO, TMP.DOC_FECHA_CREACION, TMP.DOC_FECHA_MODIFICACION&#xA;    ,TMP.PE_TIPO_PRUEBA_ENTREGA, TMP.PE_GENERACION_PE, TMP.PE_FECHA_DIGITALIZACION, TMP.PE_FECHA_CREACION&#xA;    ,TMP.DOC_NOMBRE_REGIONAL_ORIGEN, TMP.DOC_NOMBRE_REGIONAL_DESTRINO&#xA;    ,TMP.G_NOMBRE_REGIONAL_FINAL_DESTINO, TMP.G_NOMBRE_REGIONAL_INICIAL_ORIGEN&#xA;    ,TMP.PRIM_EZU_EPS_ER_SEG_FECHA_HORA_MOVIMIENTO, TMP.PRIM_EZU_EPS_ER_SEG_PROCESO&#xA;    ,TMP.FECHA_ACTUAL_DEL_SISTEMA, TMP.NUMERO_DE_FESTIVOS_Y_DOMINICALES, TMP.NUMERO_DE_ORDINARIOS&#xA;    ,TMP.TIMEPO_PROMESA_OPERATIVA_H, TMP.TIMEPO_PROMESA_OPERATIVA_D, TMP.FECHA_PROMESA_ENTREGA&#xA;    ,TMP.ID_DIAS_VEJEZ_BODEGA_02, TMP.DIAS_VEJEZ_BODEGA_02&#xA;    ,TMP.ID_GENERO_EV, TMP.FECHA_GENERO_EV&#xA;    ,TMP.FORMA_PAGO, TMP.VALOR_A_RECAUDAR, TMP.VALOR_RECAUDADO, TMP.NUMERO_ORDEN_SERVICIO, TMP.ESTA_RECAUDADO&#xA;    ,ID_PROCESS = 1&#xA;FROM [SIG_COLOMBIA_DW].[TMP].[MPCCO_VJ_PS01] TMP WITH (NOLOCK)&#xA;LEFT JOIN FAC.MPCCO_VJ_VEJEZ_BODEGA_CIERRE_OPERATIVO FAC WITH (NOLOCK)&#xA;    ON TMP.G_NUMERO_GUIA = FAC.G_NUMERO_GUIA&#xA;WHERE FAC.G_NUMERO_GUIA IS NULL;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\PS01 UPDATE GUIAS\PS01 UPDATE GUIAS PARTE 02"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{8509BC31-E4A8-48E8-8DED-644578A97D9C}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="PS01 UPDATE GUIAS PARTE 02"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="3">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{0A780CA5-176D-4393-A0A7-F578C6D072B0}"
              SQLTask:SqlStatementSource="/* =====================================================================&#xA;   Carga incremental por lotes - MPCCO_VJ_VEJEZ_BODEGA_CIERRE_OPERATIVO&#xA;   =====================================================================&#xA;   Reemplaza el DELETE + INSERT masivo (todo TMP contra FAC de una vez)&#xA;   por un proceso en dos partes, sin depender de UPDATE:&#xA;&#xA;   PARTE 1 - INSERT de guias nuevas (no existen aun en FAC)&#xA;     Insert directo, sin necesidad de batch (son altas puras, no tocan&#xA;     filas existentes de FAC).&#xA;&#xA;   PARTE 2 - Actualizacion de guias que ya existen en FAC (hacen match)&#xA;     1) Se materializan en TMP.STG_VEJEZ_BODEGA SOLO las guias que hacen&#xA;        match entre TMP y FAC Y que ademas cambiaron realmente en al&#xA;        menos uno de estos 3 campos:&#xA;           DOC_FECHA_MODIFICACION, G_FECHA_MODIFICACION_DG,&#xA;           SEG_FECHA_HORA_MOVIMIENTO&#xA;        Si los 3 campos son iguales entre TMP y FAC, la guia NO entra&#xA;        al staging (no vale la pena reprocesarla). Esto reduce mucho&#xA;        el volumen a mover en cada corrida.&#xA;     2) WHILE queda algo en el staging:&#xA;          - Toma TOP 10000 guias del staging&#xA;          - DELETE en FAC de esas guias&#xA;          - INSERT en FAC de esas mismas guias, con los datos de TMP&#xA;          - Elimina esas guias del staging (asi el staging se va&#xA;            vaciando y el proceso es reanudable: si se corta a mitad&#xA;            de camino, al volver a correr solo faltan las que quedan&#xA;            en TMP.STG_VEJEZ_BODEGA, sin reprocesar lo ya hecho)&#xA;&#xA;   Notas de rendimiento / bloqueos:&#xA;     - NOLOCK se retiro de FAC en las operaciones de escritura (DELETE):&#xA;       usar NOLOCK sobre la tabla que se esta modificando en la misma&#xA;       instruccion puede saltar o duplicar filas; no aporta beneficio&#xA;       real ahi y es riesgoso.&#xA;     - ROWLOCK + READCOMMITTEDLOCK fuerzan bloqueo a nivel de fila en&#xA;       vez de dejar que el motor escale a bloqueo de pagina/tabla,&#xA;       reduciendo el impacto sobre otros procesos que lean FAC.&#xA;     - READPAST en la lectura del staging permite saltar filas que&#xA;       otro proceso tenga bloqueadas en ese instante, en vez de&#xA;       esperarlas (util si corren cargas en paralelo sobre el staging).&#xA;     - Transacciones cortas (una por lote, no una para todo el proceso)&#xA;       evitan crecimiento excesivo del log y bloqueos prolongados.&#xA;     - WAITFOR DELAY entre lotes da tiempo a que otros procesos&#xA;       obtengan turno sobre FAC/TMP y evita saturar el lock manager.&#xA;   ===================================================================== */&#xA;&#xA;SET NOCOUNT ON;&#xA;SET XACT_ABORT ON; -- si una instruccion falla dentro de la transaccion, se revierte todo el lote automaticamente&#xA;&#xA;-------------------------------------------------------------------------&#xA;-- PARTE 1: INSERT de guias nuevas (LEFT JOIN ... FAC IS NULL)&#xA;--          ROWLOCK evita escalamiento a bloqueo de tabla en un insert&#xA;--          potencialmente grande.&#xA;-------------------------------------------------------------------------&#xA;&#xA;/*&#xA;INSERT INTO FAC.MPCCO_VJ_VEJEZ_BODEGA_CIERRE_OPERATIVO WITH (ROWLOCK)&#xA;SELECT&#xA;     TMP.G_NUMERO_GUIA, TMP.G_ID_TIPOGUIA, TMP.G_ID_CLIENTE, TMP.NOMBRE_CLIENTE, TMP.G_ID_CANAL&#xA;    ,TMP.G_ID_DIVISION_PROV, TMP.G_ID_PAIS_ORIGEN, TMP.G_ID_CIUDAD_ORIGEN, TMP.G_NOMBRE_CIUDAD_INICIAL_ORIGEN&#xA;    ,TMP.G_ID_PAIS_DESTINO, TMP.G_ID_CIUDAD_DESTINO, TMP.G_NOMBRE_CIUDAD_FINAL_DESTINO&#xA;    ,TMP.G_ID_TIPO_ZONA_URBA, TMP.G_ID_PAIS_ZONA_URB_ENTR, TMP.G_ID_CIUDAD_ZONA_URB_ENTR, TMP.G_ID_ZONA_URBA&#xA;    ,TMP.G_ID_ESTADOENVIO, TMP.G_ID_ESTADOGUIA, TMP.G_NOMBRE_ESTADOENVIO, TMP.G_NOMBRE_ESTADOGUIA&#xA;    ,TMP.G_ID_CARACT_ENVIO, TMP.G_ID_TIEMPO, TMP.G_ID_MEDTRANS, TMP.G_ID_PRODUCTO, TMP.G_ID_SUBPRODUCTO&#xA;    ,TMP.NOMBRE_SUBPRODUCTO, TMP.NOMBRE_PRODUCTO, TMP.NOMBRE_UEN, TMP.G_FECHA_ENVIO&#xA;    ,TMP.G_ID_REMITE, TMP.G_ID_DESTINA, TMP.G_NOMBRE_REMITE_GUIA, TMP.G_APELLIDO_REMITE_GUIA&#xA;    ,TMP.G_NOMBRE_DESTINA_GUIA, TMP.G_APELLIDO_DESTINA_GUIA, TMP.G_TELEFONO_REMITE_GUIA, TMP.G_TELEFONO_DESTINA_GUIA&#xA;    ,TMP.G_DIRECCION_REMITE_GUIA, TMP.G_DIRECCION_DESTINA_GUIA, TMP.G_CONTENIDO&#xA;    ,TMP.G_LARGO_ENVIO, TMP.G_ALTO_ENVIO, TMP.G_ANCHO_ENVIO, TMP.G_LARGO_ENV_OPERA, TMP.G_ALTO_ENV_OPERA, TMP.G_ANCHO_ENV_OPERA&#xA;    ,TMP.G_PESO_GUIA, TMP.G_PESO_FISICO_GUIA, TMP.G_PESO_VOLU_GUIA, TMP.G_PESO_FISICO_OPERA, TMP.G_PESO_VOLU_OPERA, TMP.G_PESO_FACTURADO&#xA;    ,TMP.G_FECHA_ENTREGA, TMP.G_NUMERO_PIEZAS&#xA;    ,TMP.G_VALOR_DECLARADO_GUIA, TMP.G_VALOR_SEG_MAN_GUIAS, TMP.G_VALOR_FLETES_GUIAS, TMP.G_VALOR_DESCUENTO_GUIAS&#xA;    ,TMP.G_VALOR_PEDIDO_GUIAS, TMP.G_VALOR_SEG_MAN_GUIAS_FACT, TMP.G_VALOR_FLETES_GUIAS_FACT&#xA;    ,TMP.G_FECHA_CREACION, TMP.G_FECHA_MODIFICACION_DG&#xA;    ,TMP.SEG_ID_PROCESO, TMP.SEG_NUMERO_MOVIMI, TMP.SEG_CONSECUT_MOVIMI, TMP.SEG_ID_CONCEPTO, TMP.SEG_ID_TIPOENVIO&#xA;    ,TMP.SEG_ID_ENVIO_CRUZADO, TMP.SEG_PESO_ENVIO, TMP.SEG_LARGO_ENVIO, TMP.SEG_ANCHO_ENVIO, TMP.SEG_ALTO_ENVIO&#xA;    ,TMP.SEG_FECHA_HORA_MOVIMIENTO, TMP.SEG_NUMERO_PIEZAS, TMP.SEG_FECHA_CREACION, TMP.SEG_FECHA_MODIFICACION, TMP.SEG_FECHA_EXTRACCION&#xA;    ,TMP.DOC_ID_TIPO_ZONA_URBA, TMP.DOC_ID_PAIS_ZONA_URBA, TMP.DOC_ID_CIUDAD_ZONA_URBA, TMP.DOC_ID_ZONA_URBA&#xA;    ,TMP.DOC_NOMBRE_ZONA_URBANA, TMP.DOC_NOMBRE_CATEGORIA_ZONA_URBANA&#xA;    ,TMP.DOC_ID_PAIS_DIVISION_ORIGEN, TMP.DOC_ID_CIUDAD_DIVISION_ORIGEN, TMP.DOC_NOMBRE_CIUDAD_ORIGEN&#xA;    ,TMP.CPL_ORG, TMP.DOC_ID_DIVISION_ORIGEN, TMP.DOC_NOMBRE_DIVISION_ORG, TMP.DOC_NOMBRE_TIPO_BODEGA_ORG&#xA;    ,TMP.DOC_ID_PAIS_DESTINO, TMP.DOC_ID_CIUDAD_DESTINO, TMP.DOC_ID_DIVISION_DESTINO, TMP.DOC_NOMBRE_CIUDAD_DESTINO&#xA;    ,TMP.CPL_DES, TMP.DOC_NOMBRE_DIVISION_DEST, TMP.DOC_NOMBRE_TIPO_BODEGA_DEST&#xA;    ,TMP.DOC_ID_COURIER_CONDUCTOR, TMP.DOC_ID_PAIS_OPERATIVO, TMP.DOC_ID_CIUDAD_OPERATIVO, TMP.DOC_ID_OPERATIVO&#xA;    ,TMP.DOC_ID_RUTA, TMP.DOC_ID_PAIS_CANAL, TMP.DOC_ID_CIUDAD_CANAL, TMP.DOC_ID_CANAL, TMP.DOC_ID_TIPO_LOGISTICA&#xA;    ,TMP.DOC_FECHA_HORA_MOVIMI, TMP.DOC_TOTAL_ENVIOS, TMP.DOC_PESO_TOTAL, TMP.DOC_PLACA_VEHICULO_DOCU&#xA;    ,TMP.DOC_ESTADO_MOVIMI, TMP.DOC_NUME_SELLO_SEGURIDAD, TMP.DOC_ID_TIPO_MOVIMIENTO, TMP.DOC_ID_ESTADO_TRANS_ZONA&#xA;    ,TMP.DOC_ID_AUXILIAR2_VEHICULO, TMP.DOC_FECHA_CREACION, TMP.DOC_FECHA_MODIFICACION&#xA;    ,TMP.PE_TIPO_PRUEBA_ENTREGA, TMP.PE_GENERACION_PE, TMP.PE_FECHA_DIGITALIZACION, TMP.PE_FECHA_CREACION&#xA;    ,TMP.DOC_NOMBRE_REGIONAL_ORIGEN, TMP.DOC_NOMBRE_REGIONAL_DESTRINO&#xA;    ,TMP.G_NOMBRE_REGIONAL_FINAL_DESTINO, TMP.G_NOMBRE_REGIONAL_INICIAL_ORIGEN&#xA;    ,TMP.PRIM_EZU_EPS_ER_SEG_FECHA_HORA_MOVIMIENTO, TMP.PRIM_EZU_EPS_ER_SEG_PROCESO&#xA;    ,TMP.FECHA_ACTUAL_DEL_SISTEMA, TMP.NUMERO_DE_FESTIVOS_Y_DOMINICALES, TMP.NUMERO_DE_ORDINARIOS&#xA;    ,TMP.TIMEPO_PROMESA_OPERATIVA_H, TMP.TIMEPO_PROMESA_OPERATIVA_D, TMP.FECHA_PROMESA_ENTREGA&#xA;    ,TMP.ID_DIAS_VEJEZ_BODEGA_02, TMP.DIAS_VEJEZ_BODEGA_02&#xA;    ,TMP.ID_GENERO_EV, TMP.FECHA_GENERO_EV&#xA;    ,TMP.FORMA_PAGO, TMP.VALOR_A_RECAUDAR, TMP.VALOR_RECAUDADO, TMP.NUMERO_ORDEN_SERVICIO, TMP.ESTA_RECAUDADO&#xA;    ,ID_PROCESS = 1&#xA;FROM [SIG_COLOMBIA_DW].[TMP].[MPCCO_VJ_PS01] TMP WITH (NOLOCK)&#xA;LEFT JOIN FAC.MPCCO_VJ_VEJEZ_BODEGA_CIERRE_OPERATIVO FAC WITH (NOLOCK)&#xA;    ON TMP.G_NUMERO_GUIA = FAC.G_NUMERO_GUIA&#xA;WHERE FAC.G_NUMERO_GUIA IS NULL;&#xA;*/&#xA;-------------------------------------------------------------------------&#xA;-- PARTE 2: Preparacion del staging con las guias que hacen match&#xA;--          Y que realmente cambiaron (pendientes de refrescar via&#xA;--          DELETE + INSERT por lotes).&#xA;--&#xA;--          Filtro de &quot;cambio real&quot;: si DOC_FECHA_MODIFICACION,&#xA;--          G_FECHA_MODIFICACION_DG y SEG_FECHA_HORA_MOVIMIENTO son&#xA;--          iguales en TMP y en FAC, la guia no entra al staging.&#xA;--          Se usa comparacion NULL-safe (no se pierden filas cuando&#xA;--          alguno de los dos lados tiene NULL en estos campos).&#xA;-------------------------------------------------------------------------&#xA;IF OBJECT_ID('TMP.STG_VEJEZ_BODEGA') IS NOT NULL&#xA;    DROP TABLE TMP.STG_VEJEZ_BODEGA;&#xA;&#xA;SELECT TMP.G_NUMERO_GUIA&#xA;INTO TMP.STG_VEJEZ_BODEGA&#xA;FROM [SIG_COLOMBIA_DW].[TMP].[MPCCO_VJ_PS01] TMP WITH (NOLOCK INDEX=[TMP_IX_VEJEZBOD_GUIA])&#xA;INNER JOIN FAC.MPCCO_VJ_VEJEZ_BODEGA_CIERRE_OPERATIVO FAC WITH (NOLOCK INDEX=[IX_VEJEZBOD_GUIA])&#xA;    ON TMP.G_NUMERO_GUIA = FAC.G_NUMERO_GUIA&#xA;WHERE  (   TMP.DOC_FECHA_MODIFICACION      &lt;&gt; FAC.DOC_FECHA_MODIFICACION&#xA;        OR (TMP.DOC_FECHA_MODIFICACION      IS NULL AND FAC.DOC_FECHA_MODIFICACION      IS NOT NULL)&#xA;        OR (TMP.DOC_FECHA_MODIFICACION      IS NOT NULL AND FAC.DOC_FECHA_MODIFICACION  IS NULL)&#xA;       )&#xA;    OR (   TMP.G_FECHA_MODIFICACION_DG     &lt;&gt; FAC.G_FECHA_MODIFICACION_DG&#xA;        OR (TMP.G_FECHA_MODIFICACION_DG     IS NULL AND FAC.G_FECHA_MODIFICACION_DG     IS NOT NULL)&#xA;        OR (TMP.G_FECHA_MODIFICACION_DG     IS NOT NULL AND FAC.G_FECHA_MODIFICACION_DG IS NULL)&#xA;       )&#xA;    OR (   TMP.SEG_FECHA_HORA_MOVIMIENTO   &lt;&gt; FAC.SEG_FECHA_HORA_MOVIMIENTO&#xA;        OR (TMP.SEG_FECHA_HORA_MOVIMIENTO   IS NULL AND FAC.SEG_FECHA_HORA_MOVIMIENTO   IS NOT NULL)&#xA;        OR (TMP.SEG_FECHA_HORA_MOVIMIENTO   IS NOT NULL AND FAC.SEG_FECHA_HORA_MOVIMIENTO IS NULL)&#xA;       )&#xA;GROUP BY TMP.G_NUMERO_GUIA;&#xA;&#xA;-- Indice para que el TOP 10000 y el DELETE del staging sean eficientes&#xA;CREATE CLUSTERED INDEX IX_STG_VEJEZ_BODEGA_GUIA ON TMP.STG_VEJEZ_BODEGA (G_NUMERO_GUIA);&#xA;&#xA;-------------------------------------------------------------------------&#xA;-- PARTE 3: Bucle por lotes de 10000 - consume el staging hasta vaciarlo&#xA;--          Reanudable: si el proceso se corta, TMP.STG_VEJEZ_BODEGA&#xA;--          conserva solo lo que falta por procesar.&#xA;-------------------------------------------------------------------------&#xA;DECLARE @TamanoLote     INT = 10000;&#xA;DECLARE @FilasAfectadas INT = 1;&#xA;DECLARE @TotalLotes     INT = 0;&#xA;DECLARE @TotalFilas     INT = 0;&#xA;DECLARE @EsperaEntreLotes CHAR(8) = '00:00:00.300'; -- pausa breve entre lotes; ajustar segun carga del servidor&#xA;&#xA;IF OBJECT_ID('tempdb..#LOTE_GUIAS') IS NOT NULL DROP TABLE #LOTE_GUIAS;&#xA;&#xA;CREATE TABLE #LOTE_GUIAS&#xA;(&#xA;    G_NUMERO_GUIA VARCHAR(50) PRIMARY KEY -- ajustar tipo/longitud al de G_NUMERO_GUIA real&#xA;);&#xA;&#xA;WHILE EXISTS (SELECT 1 FROM TMP.STG_VEJEZ_BODEGA)&#xA;BEGIN&#xA;    BEGIN TRY&#xA;        TRUNCATE TABLE #LOTE_GUIAS;&#xA;&#xA;        -- 3.1 Toma el siguiente lote de hasta 10000 guias pendientes del staging.&#xA;        --     READPAST: si otro proceso tiene bloqueadas algunas filas del&#xA;        --     staging, se saltan en vez de esperarlas.&#xA;        INSERT INTO #LOTE_GUIAS (G_NUMERO_GUIA)&#xA;        SELECT TOP (@TamanoLote) G_NUMERO_GUIA&#xA;        FROM TMP.STG_VEJEZ_BODEGA WITH (READPAST);&#xA;&#xA;        SET @FilasAfectadas = @@ROWCOUNT;&#xA;&#xA;        IF @FilasAfectadas = 0&#xA;            BREAK;&#xA;&#xA;        BEGIN TRANSACTION;&#xA;&#xA;        -- 3.2 DELETE en FAC de las guias del lote.&#xA;        --     ROWLOCK + READCOMMITTEDLOCK: bloqueo fila a fila (no pagina/tabla),&#xA;        --     para no frenar a otros procesos que consulten FAC en paralelo.&#xA;        --     No se usa NOLOCK aqui: NOLOCK sobre la tabla que se esta&#xA;        --     modificando puede saltar u omitir filas de forma inconsistente.&#xA;        DELETE FAC&#xA;        FROM FAC.MPCCO_VJ_VEJEZ_BODEGA_CIERRE_OPERATIVO FAC WITH (ROWLOCK, READCOMMITTEDLOCK, INDEX=[IX_VEJEZBOD_GUIA])&#xA;        INNER JOIN #LOTE_GUIAS L&#xA;            ON FAC.G_NUMERO_GUIA = L.G_NUMERO_GUIA;&#xA;&#xA;        -- 3.3 INSERT en FAC de las guias del lote, con los datos actuales de TMP.&#xA;        --     TABLOCK aqui aplicaria bloqueo de tabla; se omite a proposito&#xA;        --     para mantener granularidad de fila (ROWLOCK) y no bloquear&#xA;        --     lectores concurrentes de FAC.&#xA;        INSERT INTO FAC.MPCCO_VJ_VEJEZ_BODEGA_CIERRE_OPERATIVO WITH (ROWLOCK)&#xA;        SELECT&#xA;             TMP.G_NUMERO_GUIA, TMP.G_ID_TIPOGUIA, TMP.G_ID_CLIENTE, TMP.NOMBRE_CLIENTE, TMP.G_ID_CANAL&#xA;            ,TMP.G_ID_DIVISION_PROV, TMP.G_ID_PAIS_ORIGEN, TMP.G_ID_CIUDAD_ORIGEN, TMP.G_NOMBRE_CIUDAD_INICIAL_ORIGEN&#xA;            ,TMP.G_ID_PAIS_DESTINO, TMP.G_ID_CIUDAD_DESTINO, TMP.G_NOMBRE_CIUDAD_FINAL_DESTINO&#xA;            ,TMP.G_ID_TIPO_ZONA_URBA, TMP.G_ID_PAIS_ZONA_URB_ENTR, TMP.G_ID_CIUDAD_ZONA_URB_ENTR, TMP.G_ID_ZONA_URBA&#xA;            ,TMP.G_ID_ESTADOENVIO, TMP.G_ID_ESTADOGUIA, TMP.G_NOMBRE_ESTADOENVIO, TMP.G_NOMBRE_ESTADOGUIA&#xA;            ,TMP.G_ID_CARACT_ENVIO, TMP.G_ID_TIEMPO, TMP.G_ID_MEDTRANS, TMP.G_ID_PRODUCTO, TMP.G_ID_SUBPRODUCTO&#xA;            ,TMP.NOMBRE_SUBPRODUCTO, TMP.NOMBRE_PRODUCTO, TMP.NOMBRE_UEN, TMP.G_FECHA_ENVIO&#xA;            ,TMP.G_ID_REMITE, TMP.G_ID_DESTINA, TMP.G_NOMBRE_REMITE_GUIA, TMP.G_APELLIDO_REMITE_GUIA&#xA;            ,TMP.G_NOMBRE_DESTINA_GUIA, TMP.G_APELLIDO_DESTINA_GUIA, TMP.G_TELEFONO_REMITE_GUIA, TMP.G_TELEFONO_DESTINA_GUIA&#xA;            ,TMP.G_DIRECCION_REMITE_GUIA, TMP.G_DIRECCION_DESTINA_GUIA, TMP.G_CONTENIDO&#xA;            ,TMP.G_LARGO_ENVIO, TMP.G_ALTO_ENVIO, TMP.G_ANCHO_ENVIO, TMP.G_LARGO_ENV_OPERA, TMP.G_ALTO_ENV_OPERA, TMP.G_ANCHO_ENV_OPERA&#xA;            ,TMP.G_PESO_GUIA, TMP.G_PESO_FISICO_GUIA, TMP.G_PESO_VOLU_GUIA, TMP.G_PESO_FISICO_OPERA, TMP.G_PESO_VOLU_OPERA, TMP.G_PESO_FACTURADO&#xA;            ,TMP.G_FECHA_ENTREGA, TMP.G_NUMERO_PIEZAS&#xA;            ,TMP.G_VALOR_DECLARADO_GUIA, TMP.G_VALOR_SEG_MAN_GUIAS, TMP.G_VALOR_FLETES_GUIAS, TMP.G_VALOR_DESCUENTO_GUIAS&#xA;            ,TMP.G_VALOR_PEDIDO_GUIAS, TMP.G_VALOR_SEG_MAN_GUIAS_FACT, TMP.G_VALOR_FLETES_GUIAS_FACT&#xA;            ,TMP.G_FECHA_CREACION, TMP.G_FECHA_MODIFICACION_DG&#xA;            ,TMP.SEG_ID_PROCESO, TMP.SEG_NUMERO_MOVIMI, TMP.SEG_CONSECUT_MOVIMI, TMP.SEG_ID_CONCEPTO, TMP.SEG_ID_TIPOENVIO&#xA;            ,TMP.SEG_ID_ENVIO_CRUZADO, TMP.SEG_PESO_ENVIO, TMP.SEG_LARGO_ENVIO, TMP.SEG_ANCHO_ENVIO, TMP.SEG_ALTO_ENVIO&#xA;            ,TMP.SEG_FECHA_HORA_MOVIMIENTO, TMP.SEG_NUMERO_PIEZAS, TMP.SEG_FECHA_CREACION, TMP.SEG_FECHA_MODIFICACION, TMP.SEG_FECHA_EXTRACCION&#xA;            ,TMP.DOC_ID_TIPO_ZONA_URBA, TMP.DOC_ID_PAIS_ZONA_URBA, TMP.DOC_ID_CIUDAD_ZONA_URBA, TMP.DOC_ID_ZONA_URBA&#xA;            ,TMP.DOC_NOMBRE_ZONA_URBANA, TMP.DOC_NOMBRE_CATEGORIA_ZONA_URBANA&#xA;            ,TMP.DOC_ID_PAIS_DIVISION_ORIGEN, TMP.DOC_ID_CIUDAD_DIVISION_ORIGEN, TMP.DOC_NOMBRE_CIUDAD_ORIGEN&#xA;            ,TMP.CPL_ORG, TMP.DOC_ID_DIVISION_ORIGEN, TMP.DOC_NOMBRE_DIVISION_ORG, TMP.DOC_NOMBRE_TIPO_BODEGA_ORG&#xA;            ,TMP.DOC_ID_PAIS_DESTINO, TMP.DOC_ID_CIUDAD_DESTINO, TMP.DOC_ID_DIVISION_DESTINO, TMP.DOC_NOMBRE_CIUDAD_DESTINO&#xA;            ,TMP.CPL_DES, TMP.DOC_NOMBRE_DIVISION_DEST, TMP.DOC_NOMBRE_TIPO_BODEGA_DEST&#xA;            ,TMP.DOC_ID_COURIER_CONDUCTOR, TMP.DOC_ID_PAIS_OPERATIVO, TMP.DOC_ID_CIUDAD_OPERATIVO, TMP.DOC_ID_OPERATIVO&#xA;            ,TMP.DOC_ID_RUTA, TMP.DOC_ID_PAIS_CANAL, TMP.DOC_ID_CIUDAD_CANAL, TMP.DOC_ID_CANAL, TMP.DOC_ID_TIPO_LOGISTICA&#xA;            ,TMP.DOC_FECHA_HORA_MOVIMI, TMP.DOC_TOTAL_ENVIOS, TMP.DOC_PESO_TOTAL, TMP.DOC_PLACA_VEHICULO_DOCU&#xA;            ,TMP.DOC_ESTADO_MOVIMI, TMP.DOC_NUME_SELLO_SEGURIDAD, TMP.DOC_ID_TIPO_MOVIMIENTO, TMP.DOC_ID_ESTADO_TRANS_ZONA&#xA;            ,TMP.DOC_ID_AUXILIAR2_VEHICULO, TMP.DOC_FECHA_CREACION, TMP.DOC_FECHA_MODIFICACION&#xA;            ,TMP.PE_TIPO_PRUEBA_ENTREGA, TMP.PE_GENERACION_PE, TMP.PE_FECHA_DIGITALIZACION, TMP.PE_FECHA_CREACION&#xA;            ,TMP.DOC_NOMBRE_REGIONAL_ORIGEN, TMP.DOC_NOMBRE_REGIONAL_DESTRINO&#xA;            ,TMP.G_NOMBRE_REGIONAL_FINAL_DESTINO, TMP.G_NOMBRE_REGIONAL_INICIAL_ORIGEN&#xA;            ,TMP.PRIM_EZU_EPS_ER_SEG_FECHA_HORA_MOVIMIENTO, TMP.PRIM_EZU_EPS_ER_SEG_PROCESO&#xA;            ,TMP.FECHA_ACTUAL_DEL_SISTEMA, TMP.NUMERO_DE_FESTIVOS_Y_DOMINICALES, TMP.NUMERO_DE_ORDINARIOS&#xA;            ,TMP.TIMEPO_PROMESA_OPERATIVA_H, TMP.TIMEPO_PROMESA_OPERATIVA_D, TMP.FECHA_PROMESA_ENTREGA&#xA;            ,TMP.ID_DIAS_VEJEZ_BODEGA_02, TMP.DIAS_VEJEZ_BODEGA_02&#xA;            ,TMP.ID_GENERO_EV, TMP.FECHA_GENERO_EV&#xA;            ,TMP.FORMA_PAGO, TMP.VALOR_A_RECAUDAR, TMP.VALOR_RECAUDADO, TMP.NUMERO_ORDEN_SERVICIO, TMP.ESTA_RECAUDADO&#xA;            ,ID_PROCESS = 1&#xA;        FROM [SIG_COLOMBIA_DW].[TMP].[MPCCO_VJ_PS01] TMP WITH (NOLOCK INDEX=[TMP_IX_VEJEZBOD_GUIA])&#xA;        INNER JOIN #LOTE_GUIAS L&#xA;            ON TMP.G_NUMERO_GUIA = L.G_NUMERO_GUIA;&#xA;&#xA;        -- 3.4 Quita del staging las guias ya procesadas en este lote&#xA;        DELETE STG&#xA;        FROM TMP.STG_VEJEZ_BODEGA STG WITH (ROWLOCK)&#xA;        INNER JOIN #LOTE_GUIAS L&#xA;            ON STG.G_NUMERO_GUIA = L.G_NUMERO_GUIA;&#xA;&#xA;        COMMIT TRANSACTION;&#xA;&#xA;        SET @TotalLotes = @TotalLotes + 1;&#xA;        SET @TotalFilas = @TotalFilas + @FilasAfectadas;&#xA;&#xA;        PRINT 'Lote ' + CAST(@TotalLotes AS VARCHAR) + ' procesado. Filas: ' + CAST(@FilasAfectadas AS VARCHAR);&#xA;&#xA;        -- Pausa breve entre lotes: da chance a otros procesos de tomar&#xA;        -- turno sobre FAC/TMP y evita presionar el log/lock manager&#xA;        -- de forma continua durante toda la carga.&#xA;        WAITFOR DELAY @EsperaEntreLotes;&#xA;&#xA;    END TRY&#xA;    BEGIN CATCH&#xA;        IF XACT_STATE() &lt;&gt; 0 ROLLBACK TRANSACTION;&#xA;&#xA;        PRINT 'ERROR en lote ' + CAST(@TotalLotes + 1 AS VARCHAR) + ': ' + ERROR_MESSAGE();&#xA;        THROW; -- al reintentar, TMP.STG_VEJEZ_BODEGA aun conserva lo pendiente&#xA;    END CATCH&#xA;END;&#xA;&#xA;IF OBJECT_ID('tempdb..#LOTE_GUIAS') IS NOT NULL DROP TABLE #LOTE_GUIAS;&#xA;&#xA;-- Staging queda vacio al terminar; se puede dejar como historico o limpiar aqui&#xA;-- IF OBJECT_ID('TMP.STG_VEJEZ_BODEGA') IS NOT NULL DROP TABLE TMP.STG_VEJEZ_BODEGA;&#xA;&#xA;PRINT 'Carga incremental finalizada. Total lotes: ' + CAST(@TotalLotes AS VARCHAR)&#xA;      + '. Total filas actualizadas: ' + CAST(@TotalFilas AS VARCHAR) + '.';&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
      </DTS:Executables>
      <DTS:PrecedenceConstraints>
        <DTS:PrecedenceConstraint
          DTS:refId="Package\PS01 UPDATE GUIAS.PrecedenceConstraints[Constraint]"
          DTS:CreationName=""
          DTS:DTSID="{F7347B3E-5BE8-4111-BD58-D644156F2EF7}"
