UNION
SELECT 30 AS ID_VEJEZ, 'DE 21 A 30 DIAS DE VEJEZ' AS NOMBRE_RANGO, 6 AS ORDEN
UNION
SELECT 31 AS ID_VEJEZ, 'SUPERIOR A 30 DIAS DE VEJEZ' AS NOMBRE_RANGO, 7 AS ORDEN
UNION
SELECT -99 AS ID_VEJEZ, 'SIN TIEMPO PROMESA' AS NOMBRE_RANGO, 8 AS ORDEN
)
SELECT 
 ID_VEJEZ
,NOMBRE_RANGO
,ORDEN
FROM CTE
order by ORDEN asc</property>
