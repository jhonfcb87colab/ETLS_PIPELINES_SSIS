                    <component
                      refId="Package\Contruccion dimensiones\DIM CPL REGIONAL\CARGUE DIM CPL REGIONAL\PARAMETROS SIG COLOMBIA CPL REGIONAL"
                      componentClassID="Microsoft.OLEDBSource"
                      contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                      description="OLE DB Source"
                      name="PARAMETROS SIG COLOMBIA CPL REGIONAL"
                      usesDispositions="true"
                      version="7">
                      <properties>
                        <property
                          dataType="System.Int32"
                          description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                          name="CommandTimeout">0</property>
                        <property
                          dataType="System.String"
                          description="Specifies the name of the database object used to open a rowset."
                          name="OpenRowset"></property>
                        <property
                          dataType="System.String"
                          description="Specifies the variable that contains the name of the database object used to open a rowset."
                          name="OpenRowsetVariable"></property>
                        <property
                          dataType="System.String"
                          description="The SQL command to be executed."
                          name="SqlCommand"
                          UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">WITH CTE AS (
SELECT C.ID_CIUDAD,
		C.NOMBRE_CIUDAD, 
		RP.ID_REGIONAL, 
		RP.NOMBRE_REGIONAL,
		C.ID_PAIS
FROM SIG_COLOMBIA_DW.PAR.CIUDADES C WITH(NOLOCK)
INNER JOIN SIG_COLOMBIA_DW.PAR.REGIONALES_PAIS RP WITH(NOLOCK)
ON C.ID_REGIONAL = RP.ID_REGIONAL
)
SELECT DISTINCT
 CPL.ID_CIUDAD_ANEXA AS ID_CIUDAD
,CT.NOMBRE_CIUDAD	
,CT.ID_REGIONAL	
,CT.NOMBRE_REGIONAL
,CPL.CPL
,CPL.ID_CIUDAD_PRINCIPAL
,CT_PRINCIP.NOMBRE_CIUDAD AS NOMBRE_CIUDAD_PRINCIPAL
,CT_PRINCIP.NOMBRE_REGIONAL AS NOMBRE_REGIONAL_PRINCIPAL
FROM SIG_COLOMBIA_DW.[TMP].[MPCCO_VJ_CPL] CPL WITH(NOLOCK)
LEFT JOIN CTE CT
ON CT.ID_CIUDAD=CPL.ID_CIUDAD_ANEXA AND CT.ID_PAIS=1
LEFT JOIN CTE CT_PRINCIP
ON CPL.ID_CIUDAD_PRINCIPAL=CT_PRINCIP.ID_CIUDAD AND CT_PRINCIP.ID_PAIS=1

--9624</property>
