        <SQLTask:SqlTaskData
          SQLTask:Connection="{0A780CA5-176D-4393-A0A7-F578C6D072B0}"
          SQLTask:SqlStatementSource="&#xA;UPDATE FAC SET &#xA;FLAG=0&#xA;FROM [SIG_LOGISTICA_DM].[FAC].[MPCCO_VJ_VEJEZ_BODEGA_CIERRE_OPERATIVO_INVENTARIO_BODEGA] FAC&#xA;&#xA;INSERT  INTO [SIG_LOGISTICA_DM].[FAC].[MPCCO_VJ_VEJEZ_BODEGA_CIERRE_OPERATIVO_INVENTARIO_BODEGA]&#xA;SELECT &#xA;   [G_NUMERO_GUIA]&#xA;      ,TIME_ID_UL_MOV = CONVERT(INT,CONVERT(DATETIME,CONVERT(DATE,[SEG_FECHA_HORA_MOVIMIENTO])))&#xA;      ,ID_PREFIJO = LEFT([G_NUMERO_GUIA],1)&#xA;      ,[G_ID_TIPOGUIA]&#xA;      ,[G_ID_CLIENTE]&#xA;      ,ISNULL([NOMBRE_CLIENTE],'NO SE ASIGNO CLIENTE') AS [NOMBRE_CLIENTE]&#xA;      ,[G_ID_CANAL]&#xA;      ,[G_ID_DIVISION_PROV]&#xA;      ,[G_ID_PAIS_ORIGEN]&#xA;      ,[G_ID_CIUDAD_ORIGEN]&#xA;      ,[G_NOMBRE_CIUDAD_INICIAL_ORIGEN]&#xA;      ,[G_ID_PAIS_DESTINO]&#xA;      ,[G_ID_CIUDAD_DESTINO]&#xA;      ,[G_NOMBRE_CIUDAD_FINAL_DESTINO]&#xA;      ,[G_ID_TIPO_ZONA_URBA]&#xA;      ,[G_ID_PAIS_ZONA_URB_ENTR]&#xA;      ,[G_ID_CIUDAD_ZONA_URB_ENTR]&#xA;      ,[G_ID_ZONA_URBA]&#xA;      ,[G_ID_ESTADOENVIO]&#xA;      ,[G_ID_ESTADOGUIA]&#xA;      ,[G_NOMBRE_ESTADOENVIO]&#xA;      ,[G_NOMBRE_ESTADOGUIA]&#xA;      ,[G_ID_CARACT_ENVIO]&#xA;      ,[G_ID_TIEMPO]&#xA;      ,[G_ID_MEDTRANS]&#xA;      ,[G_ID_PRODUCTO]&#xA;      ,[G_ID_SUBPRODUCTO]&#xA;      ,[NOMBRE_SUBPRODUCTO]&#xA;      ,[NOMBRE_PRODUCTO]&#xA;      ,[NOMBRE_UEN]&#xA;      ,[G_FECHA_ENVIO]&#xA;      ,[G_ID_REMITE]&#xA;      ,[G_ID_DESTINA]&#xA;      ,[G_NOMBRE_REMITE_GUIA]&#xA;      ,[G_APELLIDO_REMITE_GUIA]&#xA;      ,[G_NOMBRE_DESTINA_GUIA]&#xA;      ,[G_APELLIDO_DESTINA_GUIA]&#xA;      ,[G_TELEFONO_REMITE_GUIA]&#xA;      ,[G_TELEFONO_DESTINA_GUIA]&#xA;      ,[G_DIRECCION_REMITE_GUIA]&#xA;      ,[G_DIRECCION_DESTINA_GUIA]&#xA;      ,[G_CONTENIDO]&#xA;      ,[G_LARGO_ENVIO]&#xA;      ,[G_ALTO_ENVIO]&#xA;      ,[G_ANCHO_ENVIO]&#xA;      ,[G_LARGO_ENV_OPERA]&#xA;      ,[G_ALTO_ENV_OPERA]&#xA;      ,[G_ANCHO_ENV_OPERA]&#xA;      ,[G_PESO_GUIA]&#xA;      ,[G_PESO_FISICO_GUIA]&#xA;      ,[G_PESO_VOLU_GUIA]&#xA;      ,[G_PESO_FISICO_OPERA]&#xA;      ,[G_PESO_VOLU_OPERA]&#xA;      ,[G_PESO_FACTURADO]&#xA;      ,[G_FECHA_ENTREGA]&#xA;      ,[G_NUMERO_PIEZAS]&#xA;      ,[G_VALOR_DECLARADO_GUIA]&#xA;      ,[G_VALOR_SEG_MAN_GUIAS]&#xA;      ,[G_VALOR_FLETES_GUIAS]&#xA;      ,[G_VALOR_DESCUENTO_GUIAS]&#xA;      ,[G_VALOR_PEDIDO_GUIAS]&#xA;      ,[G_VALOR_SEG_MAN_GUIAS_FACT]&#xA;      ,[G_VALOR_FLETES_GUIAS_FACT]&#xA;      ,[G_FECHA_CREACION]&#xA;      ,[G_FECHA_MODIFICACION_DG]&#xA;      ,[SEG_ID_PROCESO]&#xA;      ,[SEG_NUMERO_MOVIMI]&#xA;      ,[SEG_CONSECUT_MOVIMI]&#xA;      ,[SEG_ID_CONCEPTO]&#xA;      ,[SEG_ID_TIPOENVIO]&#xA;      ,[SEG_ID_ENVIO_CRUZADO]&#xA;      ,[SEG_PESO_ENVIO]&#xA;      ,[SEG_LARGO_ENVIO]&#xA;      ,[SEG_ANCHO_ENVIO]&#xA;      ,[SEG_ALTO_ENVIO]&#xA;      ,[SEG_FECHA_HORA_MOVIMIENTO]&#xA;      ,[SEG_NUMERO_PIEZAS]&#xA;      ,[SEG_FECHA_CREACION]&#xA;      ,[SEG_FECHA_MODIFICACION]&#xA;      ,[SEG_FECHA_EXTRACCION]&#xA;      ,[DOC_ID_TIPO_ZONA_URBA]&#xA;      ,[DOC_ID_PAIS_ZONA_URBA]&#xA;      ,[DOC_ID_CIUDAD_ZONA_URBA]&#xA;      ,[DOC_ID_ZONA_URBA]&#xA;      ,[DOC_NOMBRE_ZONA_URBANA]&#xA;      ,[DOC_NOMBRE_CATEGORIA_ZONA_URBANA]&#xA;      ,[DOC_ID_PAIS_DIVISION_ORIGEN]&#xA;      ,[DOC_ID_CIUDAD_DIVISION_ORIGEN]&#xA;      ,[DOC_NOMBRE_CIUDAD_ORIGEN]&#xA;      ,[CPL_ORG]&#xA;      ,[DOC_ID_DIVISION_ORIGEN]&#xA;      ,[DOC_NOMBRE_DIVISION_ORG]&#xA;      ,[DOC_NOMBRE_TIPO_BODEGA_ORG]&#xA;      ,[DOC_ID_PAIS_DESTINO]&#xA;      ,[DOC_ID_CIUDAD_DESTINO]&#xA;      ,[DOC_ID_DIVISION_DESTINO]&#xA;      ,[DOC_NOMBRE_CIUDAD_DESTINO]&#xA;      ,[CPL_DES]&#xA;      ,[DOC_NOMBRE_DIVISION_DEST]&#xA;      ,[DOC_NOMBRE_TIPO_BODEGA_DEST]&#xA;      ,[DOC_ID_COURIER_CONDUCTOR]&#xA;      ,[DOC_ID_PAIS_OPERATIVO]&#xA;      ,[DOC_ID_CIUDAD_OPERATIVO]&#xA;      ,[DOC_ID_OPERATIVO]&#xA;      ,[DOC_ID_RUTA]&#xA;      ,[DOC_ID_PAIS_CANAL]&#xA;      ,[DOC_ID_CIUDAD_CANAL]&#xA;      ,[DOC_ID_CANAL]&#xA;      ,[DOC_ID_TIPO_LOGISTICA]&#xA;      ,[DOC_FECHA_HORA_MOVIMI]&#xA;      ,[DOC_TOTAL_ENVIOS]&#xA;      ,[DOC_PESO_TOTAL]&#xA;      ,[DOC_PLACA_VEHICULO_DOCU]&#xA;      ,[DOC_ESTADO_MOVIMI]&#xA;      ,[DOC_NUME_SELLO_SEGURIDAD]&#xA;      ,[DOC_ID_TIPO_MOVIMIENTO]&#xA;      ,[DOC_ID_ESTADO_TRANS_ZONA]&#xA;      ,[DOC_ID_AUXILIAR2_VEHICULO]&#xA;      ,[DOC_FECHA_CREACION]&#xA;      ,[DOC_FECHA_MODIFICACION]&#xA;      ,[PE_TIPO_PRUEBA_ENTREGA]&#xA;      ,[PE_GENERACION_PE]&#xA;      ,[PE_FECHA_DIGITALIZACION]&#xA;      ,[PE_FECHA_CREACION]&#xA;      ,[DOC_NOMBRE_REGIONAL_ORIGEN]&#xA;      ,[DOC_NOMBRE_REGIONAL_DESTRINO]&#xA;      ,[G_NOMBRE_REGIONAL_FINAL_DESTINO]&#xA;      ,[G_NOMBRE_REGIONAL_INICIAL_ORIGEN]&#xA;      ,[PRIM_EZU_EPS_ER_SEG_FECHA_HORA_MOVIMIENTO]&#xA;      ,[PRIM_EZU_EPS_ER_SEG_PROCESO]&#xA;      ,[FECHA_ACTUAL_DEL_SISTEMA]&#xA;      ,[NUMERO_DE_FESTIVOS_Y_DOMINICALES]&#xA;      ,[NUMERO_DE_ORDINARIOS]&#xA;      ,[TIMEPO_PROMESA_OPERATIVA_H]&#xA;      ,[TIMEPO_PROMESA_OPERATIVA_D]&#xA;      ,[FECHA_PROMESA_ENTREGA]&#xA;      ,[ID_DIAS_VEJEZ_BODEGA_02]&#xA;   ,SEMAFORO = CASE &#xA;     WHEN [ID_DIAS_VEJEZ_BODEGA_02] BETWEEN 0 AND 1 THEN '01 VERDE'&#xA;     WHEN [ID_DIAS_VEJEZ_BODEGA_02] BETWEEN 2 AND 14 THEN '02 AMARILLO'&#xA;     WHEN [ID_DIAS_VEJEZ_BODEGA_02] BETWEEN 15 AND 32 THEN '03 ROJO'&#xA;     WHEN [ID_DIAS_VEJEZ_BODEGA_02] =-99 THEN '04 SIN VEJEZ'&#xA;     ELSE 'N/yA'&#xA;     END&#xA;      ,[DIAS_VEJEZ_BODEGA_02]&#xA;      ,[ID_GENERO_EV]&#xA;      ,[FECHA_GENERO_EV]&#xA;      ,FORMA_PAGO&#xA;      ,VALOR_A_RECAUDAR&#xA;      ,VALOR_RECAUDADO&#xA;      ,NUMERO_ORDEN_SERVICIO&#xA;      ,ESTA_RECAUDADO&#xA;      ,ID_APLICA_PROCESO_LOG_VEJEZ_02 = CASE WHEN SEG_ID_PROCESO IN(5,6,7,8,10,14,15,19,21) THEN '01-VEJEZ_02' ELSE 'NA' END&#xA;   &#xA;   ,UBICACION_REGIONAL = CASE WHEN SEG_ID_PROCESO IN(10,33,46,24,5,6,68,14,17,8,15,16,18,19,21,23,25,27,28,31,32,37,37,40,42,44,45,49) THEN DOC_NOMBRE_REGIONAL_DESTRINO ELSE DOC_NOMBRE_REGIONAL_ORIGEN END&#xA;   ,UBICACION_CPL = CASE WHEN SEG_ID_PROCESO IN(10,33,46,24,5,6,68,14,17,8,15,16,18,19,21,23,25,27,28,31,32,37,37,40,42,44,45,49) THEN CPL_DES ELSE CPL_ORG END&#xA;   ,UBICACION_CIUDAD = CASE WHEN SEG_ID_PROCESO IN(10,33,46,24,5,6,68,14,17,8,15,16,18,19,21,23,25,27,28,31,32,37,37,40,42,44,45,49) THEN DOC_NOMBRE_CIUDAD_DESTINO ELSE DOC_NOMBRE_CIUDAD_ORIGEN END&#xA;   ,UBICACION_BODEGA = CASE WHEN SEG_ID_PROCESO IN(10,33,46,24,5,6,68,14,17,8,15,16,18,19,21,23,25,27,28,31,32,37,37,40,42,44,45,49) THEN DOC_NOMBRE_DIVISION_DEST ELSE DOC_NOMBRE_DIVISION_ORG END&#xA;   ,UBICACION_TIPO_BODEGA = CASE WHEN SEG_ID_PROCESO IN(10,33,46,24,5,6,68,14,17,8,15,16,18,19,21,23,25,27,28,31,32,37,37,40,42,44,45,49) THEN DOC_NOMBRE_TIPO_BODEGA_DEST ELSE DOC_NOMBRE_TIPO_BODEGA_ORG END&#xA; ,FLAG = 1&#xA;  FROM [SIG_LOGISTICA_DM].[FAC].[MPCCO_VJ_VEJEZ_BODEGA_CIERRE_OPERATIVO] WITH(NOLOCK)&#xA;  WHERE (ID_GENERO_EV IS NULL AND PE_FECHA_DIGITALIZACION IS NULL AND SEG_ID_PROCESO not in(11,12,24,9,16,48,44))&#xA;  ------AND SEG_ID_PROCESO IN(9)&#xA;&#xA;&#xA;DELETE [SIG_LOGISTICA_DM].[FAC].[MPCCO_VJ_VEJEZ_BODEGA_CIERRE_OPERATIVO_INVENTARIO_BODEGA] &#xA;WHERE FLAG=0&#xA;&#xA;  ---DESTINOS SEG_ID_PROCESO IN(10,33,46,24,5,6,68,14,17,8,15,16,18,19,21,23,25,27,28,31,32,37,37,40,42,44,45,49)&#xA;  ---ORIGEN SEG_ID_PROCESO IN(9,7,12)&#xA;  ---&#xA;&#xA;  --  &#xA;&#xA;&#xA;&#xA;  /*&#xA;  SELECT DISTINCT SEG_ID_PROCESO FROM [SIG_LOGISTICA_DM].[FAC].[MPCCO_VJ_VEJEZ_BODEGA_CIERRE_OPERATIVO] WITH(NOLOCK)&#xA;  WHERE SEG_ID_PROCESO NOT IN(10,33,46,24,5,6,8,68,14,17,9,7,12,15,11,161,18,16,19,21,23,25,27,28,31,32)&#xA;  */&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\PS01 DELETE ENVIOS FUERA DEL INVENTARIO"
