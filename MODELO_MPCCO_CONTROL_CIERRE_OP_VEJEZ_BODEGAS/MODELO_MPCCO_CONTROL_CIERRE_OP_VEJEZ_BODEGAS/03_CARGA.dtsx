            <SQLTask:SqlTaskData
              SQLTask:Connection="{0A780CA5-176D-4393-A0A7-F578C6D072B0}"
              SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;&#xA;/* =========================================================&#xA;   PASO 0: Verificar RCSI (recomendado antes de correr esto&#xA;   junto con el dashboard en DirectQuery).&#xA;&#xA;   Con RCSI activo, los lectores de DirectQuery usan row-versioning&#xA;   y NO se bloquean con las escrituras de este proceso, incluso si&#xA;   el INSERT/UPDATE toma un lock a nivel de tabla. Por eso ya NO es&#xA;   necesario fragmentar el INSERT/UPDATE en micro-lotes de 1000 filas:&#xA;   eso solo tenía sentido como mitigación de bloqueos SIN RCSI, y aquí&#xA;   es la causa principal de que el script tarde 7+ minutos con solo&#xA;   339,954 registros.&#xA;   ========================================================= */&#xA;-- ALTER DATABASE SIG_COLOMBIA_DW SET READ_COMMITTED_SNAPSHOT ON WITH ROLLBACK IMMEDIATE;&#xA;&#xA;/* =========================================================&#xA;   PASO 1: Índice único en el target (si no existe)&#xA;   ========================================================= */&#xA;IF NOT EXISTS (&#xA;    SELECT 1 FROM sys.indexes&#xA;    WHERE object_id = OBJECT_ID('FAC.MPCCO_VJ_VEJEZ_BODEGA_CIERRE_OPERATIVO')&#xA;      AND name = 'IX_VEJEZBOD_GUIA'&#xA;)&#xA;BEGIN&#xA;    CREATE UNIQUE NONCLUSTERED INDEX IX_VEJEZBOD_GUIA&#xA;    ON [FAC].[MPCCO_VJ_VEJEZ_BODEGA_CIERRE_OPERATIVO] (G_NUMERO_GUIA);&#xA;END&#xA;&#xA;/* =========================================================&#xA;   PASO 2: Staging&#xA;   -----------------------------------------------------------&#xA;   Se elimina la columna ES_PROCESADO y toda la lógica de control&#xA;   de lotes: el INSERT y el UPDATE de abajo son cada uno una sola&#xA;   instrucción set-based, por lo tanto son naturalmente idempotentes&#xA;   (si el script se corta a mitad de camino, puede volver a correrse&#xA;   sin duplicar filas ni perder cambios). No se necesita bandera de&#xA;   &quot;ya procesado&quot;.&#xA;   ========================================================= */&#xA;IF OBJECT_ID('TMP.STG_VEJEZ_BODEGA') IS NOT NULL&#xA;    DROP TABLE TMP.STG_VEJEZ_BODEGA;&#xA;&#xA;SELECT&#xA;     G_NUMERO_GUIA, G_ID_TIPOGUIA, G_ID_CLIENTE, NOMBRE_CLIENTE, G_ID_CANAL&#xA;    ,G_ID_DIVISION_PROV, G_ID_PAIS_ORIGEN, G_ID_CIUDAD_ORIGEN, G_NOMBRE_CIUDAD_INICIAL_ORIGEN&#xA;    ,G_ID_PAIS_DESTINO, G_ID_CIUDAD_DESTINO, G_NOMBRE_CIUDAD_FINAL_DESTINO&#xA;    ,G_ID_TIPO_ZONA_URBA, G_ID_PAIS_ZONA_URB_ENTR, G_ID_CIUDAD_ZONA_URB_ENTR, G_ID_ZONA_URBA&#xA;    ,G_ID_ESTADOENVIO, G_ID_ESTADOGUIA, G_NOMBRE_ESTADOENVIO, G_NOMBRE_ESTADOGUIA&#xA;    ,G_ID_CARACT_ENVIO, G_ID_TIEMPO, G_ID_MEDTRANS, G_ID_PRODUCTO, G_ID_SUBPRODUCTO&#xA;    ,NOMBRE_SUBPRODUCTO, NOMBRE_PRODUCTO, NOMBRE_UEN, G_FECHA_ENVIO&#xA;    ,G_ID_REMITE, G_ID_DESTINA, G_NOMBRE_REMITE_GUIA, G_APELLIDO_REMITE_GUIA&#xA;    ,G_NOMBRE_DESTINA_GUIA, G_APELLIDO_DESTINA_GUIA, G_TELEFONO_REMITE_GUIA, G_TELEFONO_DESTINA_GUIA&#xA;    ,G_DIRECCION_REMITE_GUIA, G_DIRECCION_DESTINA_GUIA, G_CONTENIDO&#xA;    ,G_LARGO_ENVIO, G_ALTO_ENVIO, G_ANCHO_ENVIO, G_LARGO_ENV_OPERA, G_ALTO_ENV_OPERA, G_ANCHO_ENV_OPERA&#xA;    ,G_PESO_GUIA, G_PESO_FISICO_GUIA, G_PESO_VOLU_GUIA, G_PESO_FISICO_OPERA, G_PESO_VOLU_OPERA, G_PESO_FACTURADO&#xA;    ,G_FECHA_ENTREGA, G_NUMERO_PIEZAS&#xA;    ,G_VALOR_DECLARADO_GUIA, G_VALOR_SEG_MAN_GUIAS, G_VALOR_FLETES_GUIAS, G_VALOR_DESCUENTO_GUIAS&#xA;    ,G_VALOR_PEDIDO_GUIAS, G_VALOR_SEG_MAN_GUIAS_FACT, G_VALOR_FLETES_GUIAS_FACT&#xA;    ,G_FECHA_CREACION, G_FECHA_MODIFICACION_DG&#xA;    ,SEG_ID_PROCESO, SEG_NUMERO_MOVIMI, SEG_CONSECUT_MOVIMI, SEG_ID_CONCEPTO, SEG_ID_TIPOENVIO&#xA;    ,SEG_ID_ENVIO_CRUZADO, SEG_PESO_ENVIO, SEG_LARGO_ENVIO, SEG_ANCHO_ENVIO, SEG_ALTO_ENVIO&#xA;    ,SEG_FECHA_HORA_MOVIMIENTO, SEG_NUMERO_PIEZAS, SEG_FECHA_CREACION, SEG_FECHA_MODIFICACION, SEG_FECHA_EXTRACCION&#xA;    ,DOC_ID_TIPO_ZONA_URBA, DOC_ID_PAIS_ZONA_URBA, DOC_ID_CIUDAD_ZONA_URBA, DOC_ID_ZONA_URBA&#xA;    ,DOC_NOMBRE_ZONA_URBANA, DOC_NOMBRE_CATEGORIA_ZONA_URBANA&#xA;    ,DOC_ID_PAIS_DIVISION_ORIGEN, DOC_ID_CIUDAD_DIVISION_ORIGEN, DOC_NOMBRE_CIUDAD_ORIGEN&#xA;    ,CPL_ORG, DOC_ID_DIVISION_ORIGEN, DOC_NOMBRE_DIVISION_ORG, DOC_NOMBRE_TIPO_BODEGA_ORG&#xA;    ,DOC_ID_PAIS_DESTINO, DOC_ID_CIUDAD_DESTINO, DOC_ID_DIVISION_DESTINO, DOC_NOMBRE_CIUDAD_DESTINO&#xA;    ,CPL_DES, DOC_NOMBRE_DIVISION_DEST, DOC_NOMBRE_TIPO_BODEGA_DEST&#xA;    ,DOC_ID_COURIER_CONDUCTOR, DOC_ID_PAIS_OPERATIVO, DOC_ID_CIUDAD_OPERATIVO, DOC_ID_OPERATIVO&#xA;    ,DOC_ID_RUTA, DOC_ID_PAIS_CANAL, DOC_ID_CIUDAD_CANAL, DOC_ID_CANAL, DOC_ID_TIPO_LOGISTICA&#xA;    ,DOC_FECHA_HORA_MOVIMI, DOC_TOTAL_ENVIOS, DOC_PESO_TOTAL, DOC_PLACA_VEHICULO_DOCU&#xA;    ,DOC_ESTADO_MOVIMI, DOC_NUME_SELLO_SEGURIDAD, DOC_ID_TIPO_MOVIMIENTO, DOC_ID_ESTADO_TRANS_ZONA&#xA;    ,DOC_ID_AUXILIAR2_VEHICULO, DOC_FECHA_CREACION, DOC_FECHA_MODIFICACION&#xA;    ,PE_TIPO_PRUEBA_ENTREGA, PE_GENERACION_PE, PE_FECHA_DIGITALIZACION, PE_FECHA_CREACION&#xA;    ,DOC_NOMBRE_REGIONAL_ORIGEN, DOC_NOMBRE_REGIONAL_DESTRINO&#xA;    ,G_NOMBRE_REGIONAL_FINAL_DESTINO, G_NOMBRE_REGIONAL_INICIAL_ORIGEN&#xA;    ,PRIM_EZU_EPS_ER_SEG_FECHA_HORA_MOVIMIENTO, PRIM_EZU_EPS_ER_SEG_PROCESO&#xA;    ,FECHA_ACTUAL_DEL_SISTEMA, NUMERO_DE_FESTIVOS_Y_DOMINICALES, NUMERO_DE_ORDINARIOS&#xA;    ,TIMEPO_PROMESA_OPERATIVA_H, TIMEPO_PROMESA_OPERATIVA_D, FECHA_PROMESA_ENTREGA&#xA;    ,ID_DIAS_VEJEZ_BODEGA_02, DIAS_VEJEZ_BODEGA_02&#xA;    ,ID_GENERO_EV, FECHA_GENERO_EV&#xA;    ,FORMA_PAGO, VALOR_A_RECAUDAR, VALOR_RECAUDADO, NUMERO_ORDEN_SERVICIO, ESTA_RECAUDADO&#xA;INTO TMP.STG_VEJEZ_BODEGA&#xA;FROM [SIG_COLOMBIA_DW].[TMP].[MPCCO_VJ_PS01] WITH (NOLOCK);&#xA;&#xA;CREATE UNIQUE CLUSTERED INDEX IX_STG_GUIA&#xA;ON TMP.STG_VEJEZ_BODEGA (G_NUMERO_GUIA);&#xA;&#xA;/* =========================================================&#xA;   FASE 1: INSERTS — guías que no existen en el target&#xA;   -----------------------------------------------------------&#xA;   Una sola instrucción set-based (antes: hasta ~340 iteraciones&#xA;   de un WHILE con TOP(1000), cada una re-escaneando el staging&#xA;   completo porque ES_PROCESADO no tenía índice, más un UPDATE&#xA;   adicional para marcar &quot;procesado&quot; que volvía a consultar el&#xA;   target). El índice único IX_VEJEZBOD_GUIA del PASO 1 permite&#xA;   que el motor resuelva el NOT EXISTS con un seek, no un scan.&#xA;   ========================================================= */&#xA;INSERT INTO FAC.MPCCO_VJ_VEJEZ_BODEGA_CIERRE_OPERATIVO (&#xA;     G_NUMERO_GUIA, G_ID_TIPOGUIA, G_ID_CLIENTE, NOMBRE_CLIENTE, G_ID_CANAL&#xA;    ,G_ID_DIVISION_PROV, G_ID_PAIS_ORIGEN, G_ID_CIUDAD_ORIGEN, G_NOMBRE_CIUDAD_INICIAL_ORIGEN&#xA;    ,G_ID_PAIS_DESTINO, G_ID_CIUDAD_DESTINO, G_NOMBRE_CIUDAD_FINAL_DESTINO&#xA;    ,G_ID_TIPO_ZONA_URBA, G_ID_PAIS_ZONA_URB_ENTR, G_ID_CIUDAD_ZONA_URB_ENTR, G_ID_ZONA_URBA&#xA;    ,G_ID_ESTADOENVIO, G_ID_ESTADOGUIA, G_NOMBRE_ESTADOENVIO, G_NOMBRE_ESTADOGUIA&#xA;    ,G_ID_CARACT_ENVIO, G_ID_TIEMPO, G_ID_MEDTRANS, G_ID_PRODUCTO, G_ID_SUBPRODUCTO&#xA;    ,NOMBRE_SUBPRODUCTO, NOMBRE_PRODUCTO, NOMBRE_UEN, G_FECHA_ENVIO&#xA;    ,G_ID_REMITE, G_ID_DESTINA, G_NOMBRE_REMITE_GUIA, G_APELLIDO_REMITE_GUIA&#xA;    ,G_NOMBRE_DESTINA_GUIA, G_APELLIDO_DESTINA_GUIA, G_TELEFONO_REMITE_GUIA, G_TELEFONO_DESTINA_GUIA&#xA;    ,G_DIRECCION_REMITE_GUIA, G_DIRECCION_DESTINA_GUIA, G_CONTENIDO&#xA;    ,G_LARGO_ENVIO, G_ALTO_ENVIO, G_ANCHO_ENVIO, G_LARGO_ENV_OPERA, G_ALTO_ENV_OPERA, G_ANCHO_ENV_OPERA&#xA;    ,G_PESO_GUIA, G_PESO_FISICO_GUIA, G_PESO_VOLU_GUIA, G_PESO_FISICO_OPERA, G_PESO_VOLU_OPERA, G_PESO_FACTURADO&#xA;    ,G_FECHA_ENTREGA, G_NUMERO_PIEZAS&#xA;    ,G_VALOR_DECLARADO_GUIA, G_VALOR_SEG_MAN_GUIAS, G_VALOR_FLETES_GUIAS, G_VALOR_DESCUENTO_GUIAS&#xA;    ,G_VALOR_PEDIDO_GUIAS, G_VALOR_SEG_MAN_GUIAS_FACT, G_VALOR_FLETES_GUIAS_FACT&#xA;    ,G_FECHA_CREACION, G_FECHA_MODIFICACION_DG&#xA;    ,SEG_ID_PROCESO, SEG_NUMERO_MOVIMI, SEG_CONSECUT_MOVIMI, SEG_ID_CONCEPTO, SEG_ID_TIPOENVIO&#xA;    ,SEG_ID_ENVIO_CRUZADO, SEG_PESO_ENVIO, SEG_LARGO_ENVIO, SEG_ANCHO_ENVIO, SEG_ALTO_ENVIO&#xA;    ,SEG_FECHA_HORA_MOVIMIENTO, SEG_NUMERO_PIEZAS, SEG_FECHA_CREACION, SEG_FECHA_MODIFICACION, SEG_FECHA_EXTRACCION&#xA;    ,DOC_ID_TIPO_ZONA_URBA, DOC_ID_PAIS_ZONA_URBA, DOC_ID_CIUDAD_ZONA_URBA, DOC_ID_ZONA_URBA&#xA;    ,DOC_NOMBRE_ZONA_URBANA, DOC_NOMBRE_CATEGORIA_ZONA_URBANA&#xA;    ,DOC_ID_PAIS_DIVISION_ORIGEN, DOC_ID_CIUDAD_DIVISION_ORIGEN, DOC_NOMBRE_CIUDAD_ORIGEN&#xA;    ,CPL_ORG, DOC_ID_DIVISION_ORIGEN, DOC_NOMBRE_DIVISION_ORG, DOC_NOMBRE_TIPO_BODEGA_ORG&#xA;    ,DOC_ID_PAIS_DESTINO, DOC_ID_CIUDAD_DESTINO, DOC_ID_DIVISION_DESTINO, DOC_NOMBRE_CIUDAD_DESTINO&#xA;    ,CPL_DES, DOC_NOMBRE_DIVISION_DEST, DOC_NOMBRE_TIPO_BODEGA_DEST&#xA;    ,DOC_ID_COURIER_CONDUCTOR, DOC_ID_PAIS_OPERATIVO, DOC_ID_CIUDAD_OPERATIVO, DOC_ID_OPERATIVO&#xA;    ,DOC_ID_RUTA, DOC_ID_PAIS_CANAL, DOC_ID_CIUDAD_CANAL, DOC_ID_CANAL, DOC_ID_TIPO_LOGISTICA&#xA;    ,DOC_FECHA_HORA_MOVIMI, DOC_TOTAL_ENVIOS, DOC_PESO_TOTAL, DOC_PLACA_VEHICULO_DOCU&#xA;    ,DOC_ESTADO_MOVIMI, DOC_NUME_SELLO_SEGURIDAD, DOC_ID_TIPO_MOVIMIENTO, DOC_ID_ESTADO_TRANS_ZONA&#xA;    ,DOC_ID_AUXILIAR2_VEHICULO, DOC_FECHA_CREACION, DOC_FECHA_MODIFICACION&#xA;    ,PE_TIPO_PRUEBA_ENTREGA, PE_GENERACION_PE, PE_FECHA_DIGITALIZACION, PE_FECHA_CREACION&#xA;    ,DOC_NOMBRE_REGIONAL_ORIGEN, DOC_NOMBRE_REGIONAL_DESTRINO&#xA;    ,G_NOMBRE_REGIONAL_FINAL_DESTINO, G_NOMBRE_REGIONAL_INICIAL_ORIGEN&#xA;    ,PRIM_EZU_EPS_ER_SEG_FECHA_HORA_MOVIMIENTO, PRIM_EZU_EPS_ER_SEG_PROCESO&#xA;    ,FECHA_ACTUAL_DEL_SISTEMA, NUMERO_DE_FESTIVOS_Y_DOMINICALES, NUMERO_DE_ORDINARIOS&#xA;    ,TIMEPO_PROMESA_OPERATIVA_H, TIMEPO_PROMESA_OPERATIVA_D, FECHA_PROMESA_ENTREGA&#xA;    ,ID_DIAS_VEJEZ_BODEGA_02, DIAS_VEJEZ_BODEGA_02&#xA;    ,ID_GENERO_EV, FECHA_GENERO_EV&#xA;    ,FORMA_PAGO, VALOR_A_RECAUDAR, VALOR_RECAUDADO, NUMERO_ORDEN_SERVICIO, ESTA_RECAUDADO&#xA;)&#xA;SELECT&#xA;     s.G_NUMERO_GUIA, s.G_ID_TIPOGUIA, s.G_ID_CLIENTE, s.NOMBRE_CLIENTE, s.G_ID_CANAL&#xA;    ,s.G_ID_DIVISION_PROV, s.G_ID_PAIS_ORIGEN, s.G_ID_CIUDAD_ORIGEN, s.G_NOMBRE_CIUDAD_INICIAL_ORIGEN&#xA;    ,s.G_ID_PAIS_DESTINO, s.G_ID_CIUDAD_DESTINO, s.G_NOMBRE_CIUDAD_FINAL_DESTINO&#xA;    ,s.G_ID_TIPO_ZONA_URBA, s.G_ID_PAIS_ZONA_URB_ENTR, s.G_ID_CIUDAD_ZONA_URB_ENTR, s.G_ID_ZONA_URBA&#xA;    ,s.G_ID_ESTADOENVIO, s.G_ID_ESTADOGUIA, s.G_NOMBRE_ESTADOENVIO, s.G_NOMBRE_ESTADOGUIA&#xA;    ,s.G_ID_CARACT_ENVIO, s.G_ID_TIEMPO, s.G_ID_MEDTRANS, s.G_ID_PRODUCTO, s.G_ID_SUBPRODUCTO&#xA;    ,s.NOMBRE_SUBPRODUCTO, s.NOMBRE_PRODUCTO, s.NOMBRE_UEN, s.G_FECHA_ENVIO&#xA;    ,s.G_ID_REMITE, s.G_ID_DESTINA, s.G_NOMBRE_REMITE_GUIA, s.G_APELLIDO_REMITE_GUIA&#xA;    ,s.G_NOMBRE_DESTINA_GUIA, s.G_APELLIDO_DESTINA_GUIA, s.G_TELEFONO_REMITE_GUIA, s.G_TELEFONO_DESTINA_GUIA&#xA;    ,s.G_DIRECCION_REMITE_GUIA, s.G_DIRECCION_DESTINA_GUIA, s.G_CONTENIDO&#xA;    ,s.G_LARGO_ENVIO, s.G_ALTO_ENVIO, s.G_ANCHO_ENVIO, s.G_LARGO_ENV_OPERA, s.G_ALTO_ENV_OPERA, s.G_ANCHO_ENV_OPERA&#xA;    ,s.G_PESO_GUIA, s.G_PESO_FISICO_GUIA, s.G_PESO_VOLU_GUIA, s.G_PESO_FISICO_OPERA, s.G_PESO_VOLU_OPERA, s.G_PESO_FACTURADO&#xA;    ,s.G_FECHA_ENTREGA, s.G_NUMERO_PIEZAS&#xA;    ,s.G_VALOR_DECLARADO_GUIA, s.G_VALOR_SEG_MAN_GUIAS, s.G_VALOR_FLETES_GUIAS, s.G_VALOR_DESCUENTO_GUIAS&#xA;    ,s.G_VALOR_PEDIDO_GUIAS, s.G_VALOR_SEG_MAN_GUIAS_FACT, s.G_VALOR_FLETES_GUIAS_FACT&#xA;    ,s.G_FECHA_CREACION, s.G_FECHA_MODIFICACION_DG&#xA;    ,s.SEG_ID_PROCESO, s.SEG_NUMERO_MOVIMI, s.SEG_CONSECUT_MOVIMI, s.SEG_ID_CONCEPTO, s.SEG_ID_TIPOENVIO&#xA;    ,s.SEG_ID_ENVIO_CRUZADO, s.SEG_PESO_ENVIO, s.SEG_LARGO_ENVIO, s.SEG_ANCHO_ENVIO, s.SEG_ALTO_ENVIO&#xA;    ,s.SEG_FECHA_HORA_MOVIMIENTO, s.SEG_NUMERO_PIEZAS, s.SEG_FECHA_CREACION, s.SEG_FECHA_MODIFICACION, s.SEG_FECHA_EXTRACCION&#xA;    ,s.DOC_ID_TIPO_ZONA_URBA, s.DOC_ID_PAIS_ZONA_URBA, s.DOC_ID_CIUDAD_ZONA_URBA, s.DOC_ID_ZONA_URBA&#xA;    ,s.DOC_NOMBRE_ZONA_URBANA, s.DOC_NOMBRE_CATEGORIA_ZONA_URBANA&#xA;    ,s.DOC_ID_PAIS_DIVISION_ORIGEN, s.DOC_ID_CIUDAD_DIVISION_ORIGEN, s.DOC_NOMBRE_CIUDAD_ORIGEN&#xA;    ,s.CPL_ORG, s.DOC_ID_DIVISION_ORIGEN, s.DOC_NOMBRE_DIVISION_ORG, s.DOC_NOMBRE_TIPO_BODEGA_ORG&#xA;    ,s.DOC_ID_PAIS_DESTINO, s.DOC_ID_CIUDAD_DESTINO, s.DOC_ID_DIVISION_DESTINO, s.DOC_NOMBRE_CIUDAD_DESTINO&#xA;    ,s.CPL_DES, s.DOC_NOMBRE_DIVISION_DEST, s.DOC_NOMBRE_TIPO_BODEGA_DEST&#xA;    ,s.DOC_ID_COURIER_CONDUCTOR, s.DOC_ID_PAIS_OPERATIVO, s.DOC_ID_CIUDAD_OPERATIVO, s.DOC_ID_OPERATIVO&#xA;    ,s.DOC_ID_RUTA, s.DOC_ID_PAIS_CANAL, s.DOC_ID_CIUDAD_CANAL, s.DOC_ID_CANAL, s.DOC_ID_TIPO_LOGISTICA&#xA;    ,s.DOC_FECHA_HORA_MOVIMI, s.DOC_TOTAL_ENVIOS, s.DOC_PESO_TOTAL, s.DOC_PLACA_VEHICULO_DOCU&#xA;    ,s.DOC_ESTADO_MOVIMI, s.DOC_NUME_SELLO_SEGURIDAD, s.DOC_ID_TIPO_MOVIMIENTO, s.DOC_ID_ESTADO_TRANS_ZONA&#xA;    ,s.DOC_ID_AUXILIAR2_VEHICULO, s.DOC_FECHA_CREACION, s.DOC_FECHA_MODIFICACION&#xA;    ,s.PE_TIPO_PRUEBA_ENTREGA, s.PE_GENERACION_PE, s.PE_FECHA_DIGITALIZACION, s.PE_FECHA_CREACION&#xA;    ,s.DOC_NOMBRE_REGIONAL_ORIGEN, s.DOC_NOMBRE_REGIONAL_DESTRINO&#xA;    ,s.G_NOMBRE_REGIONAL_FINAL_DESTINO, s.G_NOMBRE_REGIONAL_INICIAL_ORIGEN&#xA;    ,s.PRIM_EZU_EPS_ER_SEG_FECHA_HORA_MOVIMIENTO, s.PRIM_EZU_EPS_ER_SEG_PROCESO&#xA;    ,s.FECHA_ACTUAL_DEL_SISTEMA, s.NUMERO_DE_FESTIVOS_Y_DOMINICALES, s.NUMERO_DE_ORDINARIOS&#xA;    ,s.TIMEPO_PROMESA_OPERATIVA_H, s.TIMEPO_PROMESA_OPERATIVA_D, s.FECHA_PROMESA_ENTREGA&#xA;    ,s.ID_DIAS_VEJEZ_BODEGA_02, s.DIAS_VEJEZ_BODEGA_02&#xA;    ,s.ID_GENERO_EV, s.FECHA_GENERO_EV&#xA;    ,s.FORMA_PAGO, s.VALOR_A_RECAUDAR, s.VALOR_RECAUDADO, s.NUMERO_ORDEN_SERVICIO, s.ESTA_RECAUDADO&#xA;FROM TMP.STG_VEJEZ_BODEGA s&#xA;WHERE NOT EXISTS (&#xA;    SELECT 1 FROM FAC.MPCCO_VJ_VEJEZ_BODEGA_CIERRE_OPERATIVO t&#xA;    WHERE t.G_NUMERO_GUIA = s.G_NUMERO_GUIA&#xA;);&#xA;&#xA;/* =========================================================&#xA;   FASE 2: UPDATES — existen en ambas y algo relevante cambió&#xA;   (mismo criterio de CHECKSUM que el MERGE original, en una&#xA;   sola pasada set-based, sin lote ni tabla de control)&#xA;   ========================================================= */&#xA;UPDATE t&#xA;SET&#xA;     t.G_ID_TIPOGUIA = s.G_ID_TIPOGUIA&#xA;    ,t.G_ID_CLIENTE = s.G_ID_CLIENTE&#xA;    ,t.NOMBRE_CLIENTE = s.NOMBRE_CLIENTE&#xA;    ,t.G_ID_CANAL = s.G_ID_CANAL&#xA;    ,t.G_ID_DIVISION_PROV = s.G_ID_DIVISION_PROV&#xA;    ,t.G_ID_PAIS_ORIGEN = s.G_ID_PAIS_ORIGEN&#xA;    ,t.G_ID_CIUDAD_ORIGEN = s.G_ID_CIUDAD_ORIGEN&#xA;    ,t.G_NOMBRE_CIUDAD_INICIAL_ORIGEN = s.G_NOMBRE_CIUDAD_INICIAL_ORIGEN&#xA;    ,t.G_ID_PAIS_DESTINO = s.G_ID_PAIS_DESTINO&#xA;    ,t.G_ID_CIUDAD_DESTINO = s.G_ID_CIUDAD_DESTINO&#xA;    ,t.G_NOMBRE_CIUDAD_FINAL_DESTINO = s.G_NOMBRE_CIUDAD_FINAL_DESTINO&#xA;    ,t.G_ID_TIPO_ZONA_URBA = s.G_ID_TIPO_ZONA_URBA&#xA;    ,t.G_ID_PAIS_ZONA_URB_ENTR = s.G_ID_PAIS_ZONA_URB_ENTR&#xA;    ,t.G_ID_CIUDAD_ZONA_URB_ENTR = s.G_ID_CIUDAD_ZONA_URB_ENTR&#xA;    ,t.G_ID_ZONA_URBA = s.G_ID_ZONA_URBA&#xA;    ,t.G_ID_ESTADOENVIO = s.G_ID_ESTADOENVIO&#xA;    ,t.G_ID_ESTADOGUIA = s.G_ID_ESTADOGUIA&#xA;    ,t.G_NOMBRE_ESTADOENVIO = s.G_NOMBRE_ESTADOENVIO&#xA;    ,t.G_NOMBRE_ESTADOGUIA = s.G_NOMBRE_ESTADOGUIA&#xA;    ,t.G_ID_CARACT_ENVIO = s.G_ID_CARACT_ENVIO&#xA;    ,t.G_ID_TIEMPO = s.G_ID_TIEMPO&#xA;    ,t.G_ID_MEDTRANS = s.G_ID_MEDTRANS&#xA;    ,t.G_ID_PRODUCTO = s.G_ID_PRODUCTO&#xA;    ,t.G_ID_SUBPRODUCTO = s.G_ID_SUBPRODUCTO&#xA;    ,t.NOMBRE_SUBPRODUCTO = s.NOMBRE_SUBPRODUCTO&#xA;    ,t.NOMBRE_PRODUCTO = s.NOMBRE_PRODUCTO&#xA;    ,t.NOMBRE_UEN = s.NOMBRE_UEN&#xA;    ,t.G_FECHA_ENVIO = s.G_FECHA_ENVIO&#xA;    ,t.G_ID_REMITE = s.G_ID_REMITE&#xA;    ,t.G_ID_DESTINA = s.G_ID_DESTINA&#xA;    ,t.G_NOMBRE_REMITE_GUIA = s.G_NOMBRE_REMITE_GUIA&#xA;    ,t.G_APELLIDO_REMITE_GUIA = s.G_APELLIDO_REMITE_GUIA&#xA;    ,t.G_NOMBRE_DESTINA_GUIA = s.G_NOMBRE_DESTINA_GUIA&#xA;    ,t.G_APELLIDO_DESTINA_GUIA = s.G_APELLIDO_DESTINA_GUIA&#xA;    ,t.G_TELEFONO_REMITE_GUIA = s.G_TELEFONO_REMITE_GUIA&#xA;    ,t.G_TELEFONO_DESTINA_GUIA = s.G_TELEFONO_DESTINA_GUIA&#xA;    ,t.G_DIRECCION_REMITE_GUIA = s.G_DIRECCION_REMITE_GUIA&#xA;    ,t.G_DIRECCION_DESTINA_GUIA = s.G_DIRECCION_DESTINA_GUIA&#xA;    ,t.G_CONTENIDO = s.G_CONTENIDO&#xA;    ,t.G_LA