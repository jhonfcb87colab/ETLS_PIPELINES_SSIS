    <DTS:Executable
      DTS:refId="Package\PS02 Asignar fecha actual del sistema sin cierre logistico"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{702682E4-3376-4BEE-8211-351FE0C105A1}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="PS02 Asignar fecha actual del sistema sin cierre logistico"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="3">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{0A780CA5-176D-4393-A0A7-F578C6D072B0}"
          SQLTask:SqlStatementSource="UPDATE FAC SET&#xA;FAC.FECHA_ACTUAL_DEL_SISTEMA =  GETDATE()&#xA;FROM [FAC].[MPCCO_VJ_VEJEZ_BODEGA_CIERRE_OPERATIVO] FAC WITH(NOLOCK)&#xA;WHERE (SEG_ID_PROCESO &lt;&gt; 11&#xA;OR PE_FECHA_DIGITALIZACION IS NULL)&#xA;AND FECHA_ACTUAL_DEL_SISTEMA &lt; DATEADD(HOUR,-3,GETDATE())&#xA;--&#x9;784.770&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\PS03 Calculo dias fectivos FACT"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{A66AE62A-222D-47AD-A6B0-ABE3691E5FD0}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="PS03 Calculo dias fectivos FACT"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="3">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{0A780CA5-176D-4393-A0A7-F578C6D072B0}"
          SQLTask:SqlStatementSource="&#xA;UPDATE T01 SET&#xA; T01.NUMERO_DE_FESTIVOS_Y_DOMINICALES&#x9;= T02.DIAS_FESTIVOS_DOMINICALES_TO_HOY&#xA;,T01.NUMERO_DE_ORDINARIOS&#x9;&#x9;&#x9;&#x9;= T02.GENERAL_DIAS&#xA;&#xA;FROM [FAC].[MPCCO_VJ_VEJEZ_BODEGA_CIERRE_OPERATIVO] T01 WITH(NOLOCK)&#xA;INNER JOIN [SIG_COLOMBIA_DW].[TMP].[MPCCO_VJ_FESTIVOS_DOMINICALES_HABILES] T02 WITH(NOLOCK)&#xA;ON (CASE WHEN T01.PRIM_EZU_EPS_ER_SEG_FECHA_HORA_MOVIMIENTO IS NULL THEN CONVERT(DATE,T01.G_FECHA_ENVIO)&#xA;ELSE CONVERT(DATE,T01.PRIM_EZU_EPS_ER_SEG_FECHA_HORA_MOVIMIENTO) END)=CONVERT(DATE,T02.[DATE])&#xA;/*&#xA; CONVERT(DATE,T01.PRIM_EZU_EPS_ER_SEG_FECHA_HORA_MOVIMIENTO)=CONVERT(DATE,T02.[DATE])&#xA;*/&#xA;WHERE (SEG_ID_PROCESO = 11&#xA;OR PE_FECHA_DIGITALIZACION IS NULL)&#xA;AND FECHA_ACTUAL_DEL_SISTEMA &lt; DATEADD(HOUR,-3,GETDATE())&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\PS04 Calculo fecha promesa FACT"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{8876D44A-4AEE-435B-9EED-AEB96CFC144B}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="PS04 Calculo fecha promesa FACT"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="3">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{0A780CA5-176D-4393-A0A7-F578C6D072B0}"
          SQLTask:SqlStatementSource="&#xA;&#xA; USE SIG_LOGISTICA_DM;&#xA;--FECHA_PROMESA_ENTREGA&#xA;UPDATE  T01 SET&#xA;/*SELECT &#xA; G_NUMERO_GUIA&#xA;,G_FECHA_ENVIO&#xA;,PRIM_EZU_EPS_ER_SEG_FECHA_HORA_MOVIMIENTO&#xA;,FECHA_ACTUAL_DEL_SISTEMA&#xA;,TIMEPO_PROMESA_OPERATIVA_D&#xA;,NUMERO_DE_FESTIVOS_Y_DOMINICALES&#xA;,NUMERO_DE_ORDINARIOS&#xA;,T01.FECHA_PROMESA_ENTREGA&#xA;,&#xA;--*/&#xA;T01.FECHA_PROMESA_ENTREGA = CASE WHEN DATEPART(HOUR, &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;DATEADD(DAY,NUMERO_DE_FESTIVOS_Y_DOMINICALES,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;DATEADD(DAY,TIMEPO_PROMESA_OPERATIVA_D,ISNULL(PRIM_EZU_EPS_ER_SEG_FECHA_HORA_MOVIMIENTO,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;DATEADD(DAY,1,G_FECHA_ENVIO)&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;)&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;)&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;)&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;)&lt;7&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;THEN DATEADD(HOUR,8,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;DATEADD(DAY,NUMERO_DE_FESTIVOS_Y_DOMINICALES,DATEADD(DAY,TIMEPO_PROMESA_OPERATIVA_D,ISNULL(PRIM_EZU_EPS_ER_SEG_FECHA_HORA_MOVIMIENTO,DATEADD(DAY,1,G_FECHA_ENVIO))))&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;)&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;ELSE DATEADD(DAY,NUMERO_DE_FESTIVOS_Y_DOMINICALES,DATEADD(DAY,TIMEPO_PROMESA_OPERATIVA_D,ISNULL(PRIM_EZU_EPS_ER_SEG_FECHA_HORA_MOVIMIENTO,DATEADD(DAY,1,G_FECHA_ENVIO))))&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;END&#xA;FROM [FAC].[MPCCO_VJ_VEJEZ_BODEGA_CIERRE_OPERATIVO] T01 WITH(NOLOCK)&#xA;WHERE ---G_NUMERO_GUIA=7218238356&#xA;TIMEPO_PROMESA_OPERATIVA_D IS NOT NULL&#xA;AND (SEG_ID_PROCESO &lt;&gt; 11 OR PE_FECHA_DIGITALIZACION IS NULL)&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\PS05 Caculo vejez Bodega 02 FACT"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{8ba2b0b3-969f-459e-8480-2086dd267262}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="PS05 Caculo vejez Bodega 02 FACT"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="3">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{0A780CA5-176D-4393-A0A7-F578C6D072B0}"
          SQLTask:SqlStatementSource="UPDATE FAC SET&#xA;FAC.ID_DIAS_VEJEZ_BODEGA_02 = CASE WHEN FECHA_PROMESA_ENTREGA IS NULL  THEN -99&#xA;       WHEN DATEDIFF(DAY,FECHA_PROMESA_ENTREGA,FECHA_ACTUAL_DEL_SISTEMA) &gt;= 31 THEN 31&#xA;       WHEN DATEDIFF(DAY,FECHA_PROMESA_ENTREGA,FECHA_ACTUAL_DEL_SISTEMA) &lt;= 0 THEN 0&#xA;       ELSE DATEDIFF(DAY,FECHA_PROMESA_ENTREGA,FECHA_ACTUAL_DEL_SISTEMA)&#xA;       END&#xA;,FAC.DIAS_VEJEZ_BODEGA_02 = CASE WHEN FECHA_PROMESA_ENTREGA IS NULL  THEN NULL&#xA;       ELSE DATEDIFF(DAY,FECHA_PROMESA_ENTREGA,FECHA_ACTUAL_DEL_SISTEMA)&#xA;       END&#xA;FROM [FAC].[MPCCO_VJ_VEJEZ_BODEGA_CIERRE_OPERATIVO] FAC WITH(NOLOCK)           &#xA;WHERE (ID_GENERO_EV IS NULL AND PE_FECHA_DIGITALIZACION IS NULL AND SEG_ID_PROCESO &lt;&gt; 11)&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\VAR_EJECUTA_DIM_NOCTURNO"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
