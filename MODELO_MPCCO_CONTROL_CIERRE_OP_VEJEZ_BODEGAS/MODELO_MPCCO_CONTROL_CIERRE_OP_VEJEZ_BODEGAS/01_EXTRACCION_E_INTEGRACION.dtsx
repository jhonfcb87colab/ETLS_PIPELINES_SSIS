      DTS:DTSID="{4242E423-57CF-4F1B-A4CA-05BA4660962D}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="(DT_DATE)   @[$Project::FULL_FACH_INI]"
      DTS:IncludeInDebugDump="2345"
