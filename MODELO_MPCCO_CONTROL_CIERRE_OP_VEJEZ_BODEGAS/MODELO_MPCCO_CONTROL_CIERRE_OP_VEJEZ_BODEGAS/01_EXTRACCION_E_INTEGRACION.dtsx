      <DTS:VariableValue
        DTS:DataType="7">1/1/1900</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{BE40397F-9A48-41D0-9D94-92D83DB03E20}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot;&#xA;SET NOCOUNT ON;&#xA;SET XACT_ABORT ON;&#xA;&#xA;-- 1. Declaración de Variables y Ventana de Tiempo&#xA;declare @fecha_ini_VAR VARCHAR(12)='&quot;+@[User::STR_01_FE_INI]+&quot;';&#xA;declare @fecha_fin_VAR VARCHAR(12)='&quot;+@[User::STR_02_FE_FIN]+&quot;';&#xA;declare @diasatr int = &quot;+(DT_WSTR,2) @[User::Dias_int_atr] +&quot;;&#xA;declare @INTERVALO_FE_INI int = 12;&#xA;&#xA;DECLARE @HoraActual INT = DATEPART(HOUR, GETDATE());&#xA;&#xA;&quot;&#xA;+@[$Project::SCRIPT]+&#xA;&quot;&#xA;&#xA;&#xA;IF @fecha_ini_VAR = '1900-01-01' OR @fecha_fin_VAR = '1900-01-01' OR @fecha_ini_VAR &lt;= '1999-01-01' OR @fecha_fin_VAR &lt;= '1999-01-01' &#xA;BEGIN&#xA;    SET @fecha_ini_VAR = CONVERT(VARCHAR, GETDATE() - @diasatr, 23);&#xA;    SET @fecha_fin_VAR = CONVERT(VARCHAR, GETDATE(), 23);&#xA;END&#xA;&#xA;DECLARE @FECHA_INI DATETIME = DATEADD(HOUR, @INTERVALO_FE_INI, CONVERT(DATETIME, @fecha_ini_VAR)); &#xA;DECLARE @FECHA_FIN DATETIME = DATEADD(DAY, 1, CONVERT(DATETIME, @fecha_fin_VAR));&#xA;&#xA;&#xA;--SELECT @FECHA_INI&#xA;--&#x9;   ,@FECHA_FIN&#xA;&#xA;-- 2. Limpieza de Objetos Previos&#xA;DROP TABLE IF EXISTS #TMP_INDEX_GUIAS;&#xA;DROP TABLE IF EXISTS #TMP_GUIAS_WHILE;&#xA;DROP TABLE IF EXISTS #NUMEROS_GUIAS_TEMP;&#xA;DROP TABLE IF EXISTS #MANIEFIESTOS_UNIDAD;&#xA;&#xA;-- 3. Consolidación Inicial de Guías Únicas (La única consulta pesada, acotada por índice)&#xA;CREATE TABLE #TMP_INDEX_GUIAS (NUMERO_GUIA NUMERIC(20,0) PRIMARY KEY);&#xA;&#xA;INSERT INTO #TMP_INDEX_GUIAS (NUMERO_GUIA)&#xA;SELECT NUMERO_GUIA &#xA;FROM (&#xA;    SELECT NUMERO_GUIA FROM Mece_Logistico.DBO.GUIAS WITH (NOLOCK)&#xA;    WHERE FECHA_MODIFICACION_DG BETWEEN @FECHA_INI AND @FECHA_FIN AND ID_ESTADOGUIA &gt;= 3&#xA;    UNION&#xA;    SELECT NUMERO_GUIA FROM Mece_Logistico.DBO.SEGUIMIENTO_ENVIO WITH (NOLOCK)&#xA;    WHERE FECHA_HORA_MOVIMIENTO BETWEEN @FECHA_INI AND @FECHA_FIN AND ID_PROCESO &gt;= 5&#xA;) AS T&#xA;WHERE LEN(NUMERO_GUIA) &gt; 7 AND LEFT(NUMERO_GUIA, 1) &lt;&gt; '5';&#xA;&#xA;-- Copia para el control del bucle de Guías&#xA;SELECT NUMERO_GUIA INTO #TMP_GUIAS_WHILE FROM #TMP_INDEX_GUIAS;&#xA;CREATE TABLE #NUMEROS_GUIAS_TEMP (NUMERO_GUIA NUMERIC(20,0) PRIMARY KEY);&#xA;&#xA;-- Asegurar que las tablas destino locales estén vacías antes de comenzar&#xA;TRUNCATE TABLE TMP_BORRAR_LOCAL.DBO.MPCCO_LOG_GUIAS;&#xA;TRUNCATE TABLE TMP_BORRAR_LOCAL.DBO.MPCCO_LOG_SEGUIMEINTO_ENVIO;&#xA;TRUNCATE TABLE TMP_BORRAR_LOCAL.DBO.MPCCO_LOG_DOCUMENTOS;&#xA;&#xA;DECLARE @LOTE INT = 5000; -- Lote moderado para no saturar I/O ni memoria RAM&#xA;DECLARE @Contador INT = 1;&#xA;&#xA;--------------------------------------------------------------------------------&#xA;-- BUCLE 1: PROCESAMIENTO POR LOTES DE GUIAS Y SEGUIMIENTO (Evita colapso de discos)&#xA;--------------------------------------------------------------------------------&#xA;WHILE EXISTS (SELECT 1 FROM #TMP_GUIAS_WHILE)&#xA;BEGIN&#xA;    TRUNCATE TABLE #NUMEROS_GUIAS_TEMP;&#xA;&#xA;    -- Tomar un bloque de guías&#xA;    INSERT INTO #NUMEROS_GUIAS_TEMP&#xA;    SELECT TOP (@LOTE) NUMERO_GUIA FROM #TMP_GUIAS_WHILE;&#xA;&#xA;    -- 1. Insertar Lote de GUIAS directamente a la tabla final (Evita tabla temporal masiva)&#xA;    INSERT INTO TMP_BORRAR_LOCAL.DBO.MPCCO_LOG_GUIAS&#xA;    SELECT G.* &#xA;    FROM Mece_Logistico.DBO.GUIAS G WITH (NOLOCK)&#xA;    INNER JOIN #NUMEROS_GUIAS_TEMP T ON G.NUMERO_GUIA = T.NUMERO_GUIA;&#xA;&#xA;    -- 2. Insertar Lote de SEGUIMIENTO_ENVIO directamente a la tabla final&#xA;    INSERT INTO TMP_BORRAR_LOCAL.DBO.MPCCO_LOG_SEGUIMEINTO_ENVIO&#xA;    SELECT SE.* &#xA;    FROM Mece_Logistico.DBO.SEGUIMIENTO_ENVIO SE WITH (NOLOCK)&#xA;    INNER JOIN #NUMEROS_GUIAS_TEMP T ON SE.NUMERO_GUIA = T.NUMERO_GUIA&#xA;    WHERE SE.FECHA_HORA_MOVIMIENTO BETWEEN @FECHA_INI AND @FECHA_FIN;&#xA;&#xA;    -- Remover las guías ya procesadas del control&#xA;    DELETE W&#xA;    FROM #TMP_GUIAS_WHILE W&#xA;    INNER JOIN #NUMEROS_GUIAS_TEMP T ON W.NUMERO_GUIA = T.NUMERO_GUIA;&#xA;&#xA;    PRINT CONCAT('Lote Guías/Seguimiento procesado: ', @Contador);&#xA;    SET @Contador = @Contador + 1;&#xA;&#xA;    -- [RESPIRACIÓN DEL SERVIDOR]: Pequeña pausa opcional de 50ms para dar oxígeno a los discos duros lentos&#xA;    -- WAITFOR DELAY '00:00:00.050'; &#xA;END&#xA;&#xA;--------------------------------------------------------------------------------&#xA;-- BUCLE 2: EXTRACCIÓN DE DOCUMENTOS POR MANIFIESTOS (También por lotes)&#xA;--------------------------------------------------------------------------------&#xA;-- Extraer los manifiestos únicos basados en el seguimiento ya descargado&#xA;SELECT DISTINCT ID_PROCESO, NUMERO_MOVIMI, CONSECUT_MOVIMI&#xA;INTO #MANIEFIESTOS_UNIDAD&#xA;FROM TMP_BORRAR_LOCAL.DBO.MPCCO_LOG_SEGUIMEINTO_ENVIO;&#xA;&#xA;ALTER TABLE #MANIEFIESTOS_UNIDAD ADD CONSTRAINT PK_MNF_TEMP PRIMARY KEY (ID_PROCESO, NUMERO_MOVIMI, CONSECUT_MOVIMI);&#xA;&#xA;DROP TABLE IF EXISTS #MANIFIESTOS_WHILE;&#xA;SELECT ID_PROCESO, NUMERO_MOVIMI, CONSECUT_MOVIMI, IDENTITY(INT,1,1) AS ID &#xA;INTO #MANIFIESTOS_WHILE &#xA;FROM #MANIEFIESTOS_UNIDAD;&#xA;&#xA;DECLARE @MinId INT = 1, @MaxId INT, @LoteManifiestos INT = 3000;&#xA;SELECT @MaxId = MAX(ID) FROM #MANIFIESTOS_WHILE;&#xA;&#xA;WHILE @MinId &lt;= @MaxId&#xA;BEGIN&#xA;    -- Insertar Lote de Documentos directamente a la tabla final usando un rango de IDs&#xA;    INSERT INTO TMP_BORRAR_LOCAL.DBO.MPCCO_LOG_DOCUMENTOS&#xA;    SELECT DOC.* &#xA;    FROM Mece_Logistico.DBO.DOCUMENTOS DOC WITH (NOLOCK)&#xA;    INNER JOIN #MANIFIESTOS_WHILE M ON DOC.ID_PROCESO = M.ID_PROCESO &#xA;                                   AND DOC.NUMERO_MOVIMI = M.NUMERO_MOVIMI &#xA;                                   AND DOC.CONSECUT_MOVIMI = M.CONSECUT_MOVIMI&#xA;    WHERE M.ID BETWEEN @MinId AND (@MinId + @LoteManifiestos - 1);&#xA;&#xA;    PRINT CONCAT('Lote Documentos procesado rango: ', @MinId, ' al ', @MinId + @LoteManifiestos);&#xA;    SET @MinId = @MinId + @LoteManifiestos;&#xA;    &#xA;    -- [RESPIRACIÓN DEL SERVIDOR]: Pausa para discos lentos&#xA;    -- WAITFOR DELAY '00:00:00.050';&#xA;END&#xA;&#xA;-- 4. Limpieza Final de Objetos Temporales&#xA;DROP TABLE IF EXISTS #TMP_INDEX_GUIAS;&#xA;DROP TABLE IF EXISTS #TMP_GUIAS_WHILE;&#xA;DROP TABLE IF EXISTS #NUMEROS_GUIAS_TEMP;&#xA;DROP TABLE IF EXISTS #MANIEFIESTOS_UNIDAD;&#xA;DROP TABLE IF EXISTS #MANIFIESTOS_WHILE;&#xA;&#xA;&quot;"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="SCRIPT_00_EXTRACCION_ESTRUCTURADO">
      <DTS:VariableValue
        DTS:DataType="8">
SET NOCOUNT ON;
SET XACT_ABORT ON;

-- 1. Declaración de Variables y Ventana de Tiempo
declare @fecha_ini_VAR VARCHAR(12)='1900-01-01';
declare @fecha_fin_VAR VARCHAR(12)='1900-01-01';
declare @diasatr int = 2;
declare @INTERVALO_FE_INI int = 12;

DECLARE @HoraActual INT = DATEPART(HOUR, GETDATE());

IF @HoraActual BETWEEN 5 AND 10     BEGIN SET @diasatr = 0; SET @INTERVALO_FE_INI = 3;  END  ELSE IF @HoraActual BETWEEN 10 AND 14 BEGIN SET @diasatr = 0; SET @INTERVALO_FE_INI = 6;  END  ELSE IF @HoraActual BETWEEN 14 AND 17 BEGIN SET @diasatr = 0; SET @INTERVALO_FE_INI = 9;  END  ELSE IF @HoraActual BETWEEN 18 AND 20 BEGIN SET @diasatr = 2; SET @INTERVALO_FE_INI = 12; END  ELSE IF @HoraActual BETWEEN 21 AND 24 BEGIN SET @diasatr = 3; SET @INTERVALO_FE_INI = 0;  END


IF @fecha_ini_VAR = '1900-01-01' OR @fecha_fin_VAR = '1900-01-01' OR @fecha_ini_VAR &lt;= '1999-01-01' OR @fecha_fin_VAR &lt;= '1999-01-01' 
BEGIN
    SET @fecha_ini_VAR = CONVERT(VARCHAR, GETDATE() - @diasatr, 23);
    SET @fecha_fin_VAR = CONVERT(VARCHAR, GETDATE(), 23);
END

DECLARE @FECHA_INI DATETIME = DATEADD(HOUR, @INTERVALO_FE_INI, CONVERT(DATETIME, @fecha_ini_VAR)); 
DECLARE @FECHA_FIN DATETIME = DATEADD(DAY, 1, CONVERT(DATETIME, @fecha_fin_VAR));


--SELECT @FECHA_INI
--	   ,@FECHA_FIN

-- 2. Limpieza de Objetos Previos
DROP TABLE IF EXISTS #TMP_INDEX_GUIAS;
DROP TABLE IF EXISTS #TMP_GUIAS_WHILE;
DROP TABLE IF EXISTS #NUMEROS_GUIAS_TEMP;
DROP TABLE IF EXISTS #MANIEFIESTOS_UNIDAD;

-- 3. Consolidación Inicial de Guías Únicas (La única consulta pesada, acotada por índice)
CREATE TABLE #TMP_INDEX_GUIAS (NUMERO_GUIA NUMERIC(20,0) PRIMARY KEY);

INSERT INTO #TMP_INDEX_GUIAS (NUMERO_GUIA)
SELECT NUMERO_GUIA 
FROM (
    SELECT NUMERO_GUIA FROM Mece_Logistico.DBO.GUIAS WITH (NOLOCK)
    WHERE FECHA_MODIFICACION_DG BETWEEN @FECHA_INI AND @FECHA_FIN AND ID_ESTADOGUIA &gt;= 3
    UNION
    SELECT NUMERO_GUIA FROM Mece_Logistico.DBO.SEGUIMIENTO_ENVIO WITH (NOLOCK)
    WHERE FECHA_HORA_MOVIMIENTO BETWEEN @FECHA_INI AND @FECHA_FIN AND ID_PROCESO &gt;= 5
) AS T
WHERE LEN(NUMERO_GUIA) &gt; 7 AND LEFT(NUMERO_GUIA, 1) &lt;&gt; '5';

-- Copia para el control del bucle de Guías
SELECT NUMERO_GUIA INTO #TMP_GUIAS_WHILE FROM #TMP_INDEX_GUIAS;
CREATE TABLE #NUMEROS_GUIAS_TEMP (NUMERO_GUIA NUMERIC(20,0) PRIMARY KEY);

-- Asegurar que las tablas destino locales estén vacías antes de comenzar
TRUNCATE TABLE TMP_BORRAR_LOCAL.DBO.MPCCO_LOG_GUIAS;
TRUNCATE TABLE TMP_BORRAR_LOCAL.DBO.MPCCO_LOG_SEGUIMEINTO_ENVIO;
TRUNCATE TABLE TMP_BORRAR_LOCAL.DBO.MPCCO_LOG_DOCUMENTOS;

DECLARE @LOTE INT = 5000; -- Lote moderado para no saturar I/O ni memoria RAM
DECLARE @Contador INT = 1;

--------------------------------------------------------------------------------
-- BUCLE 1: PROCESAMIENTO POR LOTES DE GUIAS Y SEGUIMIENTO (Evita colapso de discos)
--------------------------------------------------------------------------------
WHILE EXISTS (SELECT 1 FROM #TMP_GUIAS_WHILE)
BEGIN
    TRUNCATE TABLE #NUMEROS_GUIAS_TEMP;

    -- Tomar un bloque de guías
    INSERT INTO #NUMEROS_GUIAS_TEMP
    SELECT TOP (@LOTE) NUMERO_GUIA FROM #TMP_GUIAS_WHILE;

    -- 1. Insertar Lote de GUIAS directamente a la tabla final (Evita tabla temporal masiva)
    INSERT INTO TMP_BORRAR_LOCAL.DBO.MPCCO_LOG_GUIAS
    SELECT G.* 
    FROM Mece_Logistico.DBO.GUIAS G WITH (NOLOCK)
    INNER JOIN #NUMEROS_GUIAS_TEMP T ON G.NUMERO_GUIA = T.NUMERO_GUIA;

    -- 2. Insertar Lote de SEGUIMIENTO_ENVIO directamente a la tabla final
    INSERT INTO TMP_BORRAR_LOCAL.DBO.MPCCO_LOG_SEGUIMEINTO_ENVIO
    SELECT SE.* 
    FROM Mece_Logistico.DBO.SEGUIMIENTO_ENVIO SE WITH (NOLOCK)
    INNER JOIN #NUMEROS_GUIAS_TEMP T ON SE.NUMERO_GUIA = T.NUMERO_GUIA
    WHERE SE.FECHA_HORA_MOVIMIENTO BETWEEN @FECHA_INI AND @FECHA_FIN;

    -- Remover las guías ya procesadas del control
    DELETE W
    FROM #TMP_GUIAS_WHILE W
    INNER JOIN #NUMEROS_GUIAS_TEMP T ON W.NUMERO_GUIA = T.NUMERO_GUIA;

    PRINT CONCAT('Lote Guías/Seguimiento procesado: ', @Contador);
    SET @Contador = @Contador + 1;

    -- [RESPIRACIÓN DEL SERVIDOR]: Pequeña pausa opcional de 50ms para dar oxígeno a los discos duros lentos
    -- WAITFOR DELAY '00:00:00.050'; 
END

--------------------------------------------------------------------------------
-- BUCLE 2: EXTRACCIÓN DE DOCUMENTOS POR MANIFIESTOS (También por lotes)
--------------------------------------------------------------------------------
-- Extraer los manifiestos únicos basados en el seguimiento ya descargado
SELECT DISTINCT ID_PROCESO, NUMERO_MOVIMI, CONSECUT_MOVIMI
INTO #MANIEFIESTOS_UNIDAD
FROM TMP_BORRAR_LOCAL.DBO.MPCCO_LOG_SEGUIMEINTO_ENVIO;

ALTER TABLE #MANIEFIESTOS_UNIDAD ADD CONSTRAINT PK_MNF_TEMP PRIMARY KEY (ID_PROCESO, NUMERO_MOVIMI, CONSECUT_MOVIMI);

DROP TABLE IF EXISTS #MANIFIESTOS_WHILE;
SELECT ID_PROCESO, NUMERO_MOVIMI, CONSECUT_MOVIMI, IDENTITY(INT,1,1) AS ID 
INTO #MANIFIESTOS_WHILE 
FROM #MANIEFIESTOS_UNIDAD;

DECLARE @MinId INT = 1, @MaxId INT, @LoteManifiestos INT = 3000;
SELECT @MaxId = MAX(ID) FROM #MANIFIESTOS_WHILE;

WHILE @MinId &lt;= @MaxId
BEGIN
    -- Insertar Lote de Documentos directamente a la tabla final usando un rango de IDs
    INSERT INTO TMP_BORRAR_LOCAL.DBO.MPCCO_LOG_DOCUMENTOS
    SELECT DOC.* 
    FROM Mece_Logistico.DBO.DOCUMENTOS DOC WITH (NOLOCK)
    INNER JOIN #MANIFIESTOS_WHILE M ON DOC.ID_PROCESO = M.ID_PROCESO 
                                   AND DOC.NUMERO_MOVIMI = M.NUMERO_MOVIMI 
                                   AND DOC.CONSECUT_MOVIMI = M.CONSECUT_MOVIMI
    WHERE M.ID BETWEEN @MinId AND (@MinId + @LoteManifiestos - 1);

    PRINT CONCAT('Lote Documentos procesado rango: ', @MinId, ' al ', @MinId + @LoteManifiestos);
    SET @MinId = @MinId + @LoteManifiestos;
    
    -- [RESPIRACIÓN DEL SERVIDOR]: Pausa para discos lentos
    -- WAITFOR DELAY '00:00:00.050';
END

-- 4. Limpieza Final de Objetos Temporales
DROP TABLE IF EXISTS #TMP_INDEX_GUIAS;
DROP TABLE IF EXISTS #TMP_GUIAS_WHILE;
DROP TABLE IF EXISTS #NUMEROS_GUIAS_TEMP;
DROP TABLE IF EXISTS #MANIEFIESTOS_UNIDAD;
DROP TABLE IF EXISTS #MANIFIESTOS_WHILE;

</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{C582AC4B-0B28-4875-86FA-10E124F1F101}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="(DT_WSTR, 4)YEAR(@[User::FechaIni])&#xA;+&quot;-&quot;+&#xA;RIGHT((DT_WSTR, 3) (MONTH(@[User::FechaIni])+100) , 2 ) &#xA;+&quot;-&quot;+&#xA;RIGHT((DT_WSTR, 3) (DAY(@[User::FechaIni])+100) , 2 )"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="STR_01_FE_INI">
      <DTS:VariableValue
        DTS:DataType="8">1900-01-01</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{9A071C39-D470-4438-8F4F-77E8E0997F8C}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="(DT_WSTR, 4)YEAR(@[User::FechaFin])&#xA;+&quot;-&quot;+&#xA;RIGHT((DT_WSTR, 3) (MONTH(@[User::FechaFin])+100) , 2 ) &#xA;+&quot;-&quot;+&#xA;RIGHT((DT_WSTR, 3) (DAY(@[User::FechaFin])+100) , 2 )"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="STR_02_FE_FIN">
      <DTS:VariableValue
        DTS:DataType="8">1900-01-01</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{5626C5DC-4D68-473F-A282-C4CC2411DE90}"
      DTS:IncludeInDebugDump="6789"
      DTS:Namespace="User"
      DTS:ObjectName="VAR_EJECUTA_DIM_NOCTURNO">
      <DTS:VariableValue
        DTS:DataType="3">0</DTS:VariableValue>
    </DTS:Variable>
  </DTS:Variables>
  <DTS:Executables>
    <DTS:Executable
      DTS:refId="Package\AJ-ACTUALIZAR CAMPOS PRUEBAS ENTREGA"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{8AC188C5-29D2-4C24-8F40-31E503217EF1}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="AJ-ACTUALIZAR CAMPOS PRUEBAS ENTREGA"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{9270DAF5-1074-4D39-8815-87044D378AC9}"
          SQLTask:SqlStatementSource="&#xA;&#xA;DECLARE @CONTADOR_MAX_PRINCIPAL INT = (SELECT MAX(PK) FROM [TMP].[MPCCO_VJ_ULTIMO_PROCESO_LOG] WITH(NOLOCK));&#xA;DECLARE @CONTADOR_MIN INT = 1;&#xA;DECLARE @INCREMENTO INT = 100000;&#xA;DECLARE @CONTADOR_MAX INT;&#xA;&#xA;-- Cambiamos la condición para asegurar que el último bloque SIEMPRE se ejecute&#xA;WHILE @CONTADOR_MIN &lt;= @CONTADOR_MAX_PRINCIPAL&#xA;BEGIN&#xA;    SET @CONTADOR_MAX = @CONTADOR_MIN + @INCREMENTO - 1;&#xA;&#xA;    UPDATE TMP&#xA;    SET TMP.PE_TIPO_PRUEBA_ENTREGA = PE.TIPO_PRUEBA_ENTREGA,&#xA;        TMP.PE_GENERACION_PE      = PE.GENERACION_PE,&#xA;        TMP.PE_FECHA_DIGITALIZACION = PE.FECHA_DIGITALIZACION,&#xA;        TMP.PE_FECHA_CREACION       = PE.FECHA_CREACION&#xA;    FROM [TMP].[MPCCO_VJ_ULTIMO_PROCESO_LOG] TMP WITH(ROWLOCK)&#xA;    INNER JOIN [SIG_COLOMBIA_DW].[TMP].[MPCCO_VJ_PE] PE WITH(NOLOCK)&#xA;        ON PE.NUMERO_GUIA = TMP.G_NUMERO_GUIA&#xA;    WHERE TMP.PK &gt;= @CONTADOR_MIN &#xA;      AND TMP.PK &lt;= @CONTADOR_MAX;&#xA;&#xA;    SET @CONTADOR_MIN = @CONTADOR_MAX + 1;&#xA;END;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;/*&#xA;&#xA;DECLARE @CONTADOR_MAX_PRINCIPAL INT = (SELECT MAX(PK) AS PK FROM [TMP].[MPCCO_VJ_ULTIMO_PROCESO_LOG] WITH(NOLOCK));&#xA;DECLARE @CONTADOR_MIN INT = 1;&#xA;DECLARE @CONTADORMONITOR INT =1;&#xA;DECLARE @INCREMENTO INT = 100000;&#xA;DECLARE @CONTADOR_MAX INT = @CONTADOR_MIN+@INCREMENTO-1;&#xA;PRINT(@CONTADOR_MAX_PRINCIPAL)&#xA;PRINT(@CONTADOR_MAX)&#xA;PRINT('************************&#x9;&#x9;&#x9;&#x9;inicio bucle &#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;************************')&#xA;&#xA;&#x9;&#x9;&#x9;WHILE @CONTADOR_MAX &lt; @CONTADOR_MAX_PRINCIPAL&#xA;&#x9;&#x9;&#x9; BEGIN&#xA;&#x9;&#x9;&#x9;    PRINT(CONCAT('UPDATE NUMERO ',@CONTADOR_MIN ,' - ',@CONTADOR_MAX ));&#xA;&#x9;&#x9;&#x9;&#x9;UPDATE TMP SET&#xA;&#x9;&#x9;&#x9;&#x9;-- TMP.PE_PAQUETE&#x9; = PE.PAQUETE&#x9;&#xA;&#x9;&#x9;&#x9;&#x9;--,TMP.PE_CAJA = PE.CAJA&#x9;&#xA;&#x9;&#x9;&#x9;&#x9;--,TMP.PE_USUARIO_DIGITALIZA&#x9; = PE.USUARIO_DIGITALIZA&#x9;&#xA;&#x9;&#x9;&#x9;&#x9;TMP.PE_TIPO_PRUEBA_ENTREGA = PE.TIPO_PRUEBA_ENTREGA&#x9;&#xA;&#x9;&#x9;&#x9;&#x9;,TMP.PE_GENERACION_PE = PE.GENERACION_PE&#x9;&#xA;&#x9;&#x9;&#x9;&#x9;,TMP.PE_FECHA_DIGITALIZACION = PE.FECHA_DIGITALIZACION&#x9;&#xA;&#x9;&#x9;&#x9;&#x9;,TMP.PE_FECHA_CREACION = PE.FECHA_CREACION&#xA;&#x9;&#x9;&#x9;&#x9;  FROM [TMP].[MPCCO_VJ_ULTIMO_PROCESO_LOG] TMP WITH(NOLOCK)&#xA;&#x9;&#x9;&#x9;&#x9;  INNER JOIN [SIG_COLOMBIA_DW].[TMP].[MPCCO_VJ_PE] PE WITH(NOLOCK)&#xA;&#x9;&#x9;&#x9;&#x9;  ON PE.NUMERO_GUIA=TMP.G_NUMERO_GUIA&#xA;&#x9;&#x9;&#x9;&#x9;  WHERE (PK &gt;= @CONTADOR_MIN AND PK &lt;= @CONTADOR_MAX)&#xA;&#x9;&#x9;&#x9;&#x9;  OPTION(RECOMPILE)&#xA;/*&#xA;&#x9;&#x9;&#x9;&#x9;WHERE T1.PERIODO_EJECUCION = @PERIODO AND &#xA;&#x9;&#x9;&#x9;&#x9;(PK &gt;= @CONTADOR_MIN AND PK &lt;= @CONTADOR_MAX)&#xA;*/&#xA;&#x9;&#x9;&#x9; SET @CONTADOR_MIN = @CONTADOR_MAX + 1 ;&#xA;&#x9;&#x9;&#x9; SET @CONTADOR_MAX = @CONTADOR_MIN + @INCREMENTO-1 ;&#xA;&#x9;&#x9;&#x9; SET @CONTADORMONITOR = @CONTADORMONITOR+1;&#xA;END&#xA;*/" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\backups scripts"
      DTS:CreationName="STOCK:SEQUENCE"
      DTS:Description="Sequence Container"
      DTS:Disabled="True"
      DTS:DTSID="{59EA4035-04E5-4B11-9BCA-FBB23BD1502B}"
      DTS:ExecutableType="STOCK:SEQUENCE"
      DTS:LocaleID="-1"
      DTS:ObjectName="backups scripts">
      <DTS:Variables />
      <DTS:Executables>
        <DTS:Executable
          DTS:refId="Package\backups scripts\backup"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:Disabled="True"
          DTS:DTSID="{0687F8CD-72D3-4EDF-878F-592F65DA12DB}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="backup"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="3">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{5B2BDE35-0E5F-4DE2-A25A-19DB68B50268}"
              SQLTask:SqlStatementSource="EXEC [tmp_borrar_local]. [dbo].[TMP_MPCCO_OBTENER_GUIAS] ?,?,?;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;/*&#xA;&#xA;USE [tmp_borrar_local]&#xA;GO&#xA;&#xA;SET ANSI_NULLS ON&#xA;GO&#xA;SET QUOTED_IDENTIFIER ON&#xA;GO&#xA;&#xA;ALTER PROCEDURE [dbo].[TMP_MPCCO_OBTENER_GUIAS]&#xA;@fecha_ini_VAR VARCHAR(10),&#xA;@fecha_fin_VAR VARCHAR(10),&#xA;@diasatr int&#xA;AS&#xA;BEGIN&#xA;&#x9;&#x9;IF @fecha_ini_VAR='1900-01-01' OR @fecha_fin_VAR='1900-01-01' &#xA;&#x9;&#x9;&#x9;OR @fecha_ini_VAR&lt;='1999-01-01' OR @fecha_fin_VAR&lt;='1999-01-01' &#xA;&#x9;&#x9;BEGIN&#xA;&#x9;&#x9;SET @fecha_ini_VAR=CONVERT(varchar,GETDATE()-@diasatr,23)&#xA;&#x9;&#x9;SET @fecha_fin_VAR=CONVERT(varchar,GETDATE(),23)&#xA;&#x9;&#x9;END&#xA;&#xA;&#xA;DECLARE @VAR_INT INT = @diasatr;&#xA;DECLARE @FECHA_INI DATETIME = CONVERT(DATETIME,@fecha_ini_VAR); &#xA;DECLARE @FECHA_FIN DATETIME = CONVERT(DATETIME,@fecha_fin_VAR);&#xA;&#xA;&#xA;DROP TABLE IF EXISTS #TMP_INDEX_GUIAS_AUX&#xA;DROP TABLE IF EXISTS #TMP_INDEX_GUIAS&#xA;DROP TABLE IF EXISTS #MANIEFIESTOS_MPCCO_LOG_SEGUIMEINTO_ENVIO&#xA;&#xA;TRUNCATE TABLE TMP_BORRAR_LOCAL.DBO.MPCCO_LOG_GUIAS&#xA;TRUNCATE TABLE TMP_BORRAR_LOCAL.DBO.MPCCO_LOG_SEGUIMEINTO_ENVIO&#xA;TRUNCATE TABLE TMP_BORRAR_LOCAL.DBO.MPCCO_LOG_DOCUMENTOS&#xA;&#xA;&#xA;CREATE TABLE #TMP_INDEX_GUIAS(NUMERO_GUIA NUMERIC(20,0))&#xA;ALTER TABLE #TMP_INDEX_GUIAS ADD  CONSTRAINT [ZZZZIDX_GUIA] UNIQUE NONCLUSTERED &#xA;([NUMERO_GUIA] ASC)WITH (PAD_INDEX = OFF, STATISTICS_NORECOMPUTE = OFF, SORT_IN_TEMPDB = OFF, IGNORE_DUP_KEY = OFF, ONLINE = OFF, ALLOW_ROW_LOCKS = ON, ALLOW_PAGE_LOCKS = ON, FILLFACTOR = 80) ON [PRIMARY]&#xA;&#xA;&#xA;SELECT NUMERO_GUIA &#xA;INTO #TMP_INDEX_GUIAS_AUX&#xA;FROM Mece_Logistico.DBO.GUIAS WITH(NOLOCK)&#xA;WHERE FECHA_MODIFICACION_DG BETWEEN @FECHA_INI  AND @FECHA_FIN &#xA;AND ID_ESTADOGUIA&gt;=3&#xA;GROUP BY NUMERO_GUIA&#xA;&#xA;INSERT INTO #TMP_INDEX_GUIAS_AUX&#xA;SELECT NUMERO_GUIA &#xA;FROM Mece_Logistico.DBO.SEGUIMIENTO_ENVIO WITH(NOLOCK)&#xA;WHERE FECHA_HORA_MOVIMIENTO BETWEEN @FECHA_INI  AND @FECHA_FIN &#xA;AND ID_PROCESO&gt;=5&#xA;GROUP BY NUMERO_GUIA&#xA;&#xA;INSERT INTO #TMP_INDEX_GUIAS&#xA;SELECT NUMERO_GUIA FROM #TMP_INDEX_GUIAS_AUX GROUP BY NUMERO_GUIA&#xA;&#xA;---ELIMINAR MALAS CAPTURAS&#xA;DELETE #TMP_INDEX_GUIAS WHERE LEN(NUMERO_GUIA)&lt;=7&#xA;---ELIMINAR GUIAS INTERNAS&#xA;DELETE #TMP_INDEX_GUIAS WHERE LEFT(NUMERO_GUIA,1)=5&#xA;&#xA;&#xA;INSERT INTO TMP_BORRAR_LOCAL.DBO.MPCCO_LOG_GUIAS&#xA;SELECT G.*&#xA;--INTO TMP_BORRAR_LOCAL.DBO.MPCCO_LOG_GUIAS&#xA;FROM Mece_Logistico.DBO.GUIAS G WITH(NOLOCK)&#xA;INNER JOIN #TMP_INDEX_GUIAS TMP_G ON G.NUMERO_GUIA=TMP_G.NUMERO_GUIA&#xA;&#xA;INSERT INTO TMP_BORRAR_LOCAL.DBO.MPCCO_LOG_SEGUIMEINTO_ENVIO&#xA;SELECT SE.*&#xA;--INTO TMP_BORRAR_LOCAL.DBO.MPCCO_LOG_SEGUIMEINTO_ENVIO&#xA;FROM Mece_Logistico.DBO.SEGUIMIENTO_ENVIO SE WITH(NOLOCK)&#xA;INNER JOIN #TMP_INDEX_GUIAS TMP_G ON SE.NUMERO_GUIA=TMP_G.NUMERO_GUIA&#xA;&#xA;&#xA;DROP TABLE IF EXISTS #MANIEFIESTOS_MPCCO_LOG_SEGUIMEINTO_ENVIO;&#xA;SELECT TOP 0&#xA;ID_PROCESO&#x9;&#xA;,NUMERO_MOVIMI&#x9;&#xA;,CONSECUT_MOVIMI &#xA;INTO #MANIEFIESTOS_MPCCO_LOG_SEGUIMEINTO_ENVIO&#xA;FROM TMP_BORRAR_LOCAL.DBO.MPCCO_LOG_SEGUIMEINTO_ENVIO&#xA;&#xA;ALTER TABLE #MANIEFIESTOS_MPCCO_LOG_SEGUIMEINTO_ENVIO ADD  CONSTRAINT [ZZZZIDX_MANIFIESTOS] UNIQUE NONCLUSTERED &#xA;(&#xA;ID_PROCESO&#x9;ASC&#xA;,NUMERO_MOVIMI&#x9;ASC&#xA;,CONSECUT_MOVIMI ASC)&#xA;WITH (PAD_INDEX = OFF, STATISTICS_NORECOMPUTE = OFF, SORT_IN_TEMPDB = OFF, IGNORE_DUP_KEY = OFF, ONLINE = OFF, ALLOW_ROW_LOCKS = ON, ALLOW_PAGE_LOCKS = ON, FILLFACTOR = 80) ON [PRIMARY]&#xA;&#xA;INSERT INTO #MANIEFIESTOS_MPCCO_LOG_SEGUIMEINTO_ENVIO&#xA;SELECT &#xA;ID_PROCESO&#x9;&#xA;,NUMERO_MOVIMI&#x9;&#xA;,CONSECUT_MOVIMI &#xA;FROM TMP_BORRAR_LOCAL.DBO.MPCCO_LOG_SEGUIMEINTO_ENVIO&#xA;GROUP BY &#xA;ID_PROCESO&#x9;&#xA;,NUMERO_MOVIMI&#x9;&#xA;,CONSECUT_MOVIMI&#xA;&#xA;INSERT INTO TMP_BORRAR_LOCAL.DBO.MPCCO_LOG_DOCUMENTOS&#xA;SELECT DOC.* &#xA;--INTO TMP_BORRAR_LOCAL.DBO.MPCCO_LOG_DOCUMENTOS&#xA;FROM Mece_Logistico.DBO.DOCUMENTOS DOC WITH(NOLOCK)&#xA;INNER JOIN #MANIEFIESTOS_MPCCO_LOG_SEGUIMEINTO_ENVIO MNF&#xA;ON  MNF.ID_PROCESO=DOC.ID_PROCESO&#x9;&#xA;AND MNF.NUMERO_MOVIMI=DOC.NUMERO_MOVIMI&#x9;&#xA;AND MNF.CONSECUT_MOVIMI=DOC.CONSECUT_MOVIMI&#xA;&#xA;&#xA;DROP TABLE IF EXISTS #TMP_INDEX_GUIAS_AUX&#xA;DROP TABLE IF EXISTS #TMP_INDEX_GUIAS&#xA;DROP TABLE IF EXISTS #MANIEFIESTOS_MPCCO_LOG_SEGUIMEINTO_ENVIO&#xA;&#xA;&#xA;END&#xA;&#xA;&#xA;&#xA;*/" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="0"
                SQLTask:DtsVariableName="User::STR_01_FE_INI"
                SQLTask:ParameterDirection="Input"
                SQLTask:DataType="3"
                SQLTask:ParameterSize="-1" />
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="1"
                SQLTask:DtsVariableName="User::STR_02_FE_FIN"
                SQLTask:ParameterDirection="Input"
                SQLTask:DataType="3"
                SQLTask:ParameterSize="-1" />
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="2"
                SQLTask:DtsVariableName="User::Dias_int_atr"
                SQLTask:ParameterDirection="Input"
                SQLTask:DataType="3"
                SQLTask:ParameterSize="-1" />
            </SQLTask:SqlTaskData>
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\backups scripts\BACKUP 20260814 EXTRACCION INICIAL ULTIMO PROCESO"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{eb9051d7-65c3-467e-9962-d720a5f08c37}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="BACKUP 20260814 EXTRACCION INICIAL ULTIMO PROCESO"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="4">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{5B2BDE35-0E5F-4DE2-A25A-19DB68B50268}"
              SQLTask:SqlStatementSource="declare @fecha_ini_VAR VARCHAR(12)=?;&#xA;declare @fecha_fin_VAR VARCHAR(12)=?;&#xA;declare @diasatr int = ?;&#xA;declare @INTERVALO_FE_INI int = 12;&#xA;&#xA;--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------&#xA;--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------&#xA;--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------&#xA;&#xA;IF DATEPART(HOUR,GETDATE()) BETWEEN  6 AND 10&#xA; BEGIN &#xA; SET @diasatr = 1&#xA; SET  @INTERVALO_FE_INI = 6;&#xA; PRINT('ASIGNACION TIPO 01')&#xA; END&#xA;&#xA;IF DATEPART(HOUR,GETDATE()) BETWEEN  10 AND 14&#xA; BEGIN &#xA; SET @diasatr = 0&#xA; SET  @INTERVALO_FE_INI = 0;&#xA; PRINT('ASIGNACION TIPO 02')&#xA; END&#xA;&#xA;IF DATEPART(HOUR,GETDATE()) BETWEEN  14 AND 17&#xA; BEGIN &#xA; SET @diasatr = 1&#xA; SET  @INTERVALO_FE_INI = 9;&#xA; PRINT('ASIGNACION TIPO 03')&#xA; END&#xA;--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------&#xA;--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------&#xA;--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------&#xA;&#xA;  IF @fecha_ini_VAR='1900-01-01' OR @fecha_fin_VAR='1900-01-01' &#xA;   OR @fecha_ini_VAR&lt;='1999-01-01' OR @fecha_fin_VAR&lt;='1999-01-01' &#xA;  BEGIN&#xA;  SET @fecha_ini_VAR=CONVERT(varchar,GETDATE()-@diasatr,23)&#xA;  SET @fecha_fin_VAR=CONVERT(varchar,GETDATE(),23)&#xA;  END&#xA;/*&#xA;select @fecha_ini_VAR&#xA;    ,@fecha_fin_VAR&#xA;*/&#xA;&#xA;DECLARE @VAR_INT INT = @diasatr;&#xA;DECLARE @FECHA_INI DATETIME = DATEADD(HOUR,@INTERVALO_FE_INI,CONVERT(DATETIME,@fecha_ini_VAR)); &#xA;DECLARE @FECHA_FIN DATETIME = DATEADD(DAY,1,CONVERT(DATETIME,@fecha_fin_VAR));&#xA;&#xA;----SELECT @VAR_INT I,@FECHA_INI,@FECHA_FIN&#xA;&#xA;&#xA;DROP TABLE IF EXISTS #TMP_INDEX_GUIAS_AUX;&#xA;DROP TABLE IF EXISTS #TMP_INDEX_GUIAS;&#xA;DROP TABLE IF EXISTS #MANIEFIESTOS_MPCCO_LOG_SEGUIMEINTO_ENVIO;&#xA;&#xA;DROP TABLE IF EXISTS ##TMP_BORRAR_LOCAL_DBO_MPCCO_LOG_GUIAS;&#xA;DROP TABLE IF EXISTS ##TMP_BORRAR_LOCAL_DBO_MPCCO_LOG_SEGUIMEINTO_ENVIO;&#xA;DROP TABLE IF EXISTS ##TMP_BORRAR_LOCAL_DBO_MPCCO_LOG_DOCUMENTOS;&#xA;&#xA;&#xA;CREATE TABLE #TMP_INDEX_GUIAS(NUMERO_GUIA NUMERIC(20,0))&#xA;ALTER TABLE #TMP_INDEX_GUIAS ADD  CONSTRAINT [ZZZZZIDX_GUIA] UNIQUE NONCLUSTERED &#xA;([NUMERO_GUIA] ASC)WITH (PAD_INDEX = OFF, STATISTICS_NORECOMPUTE = OFF, SORT_IN_TEMPDB = OFF, IGNORE_DUP_KEY = OFF, ONLINE = OFF, ALLOW_ROW_LOCKS = ON, ALLOW_PAGE_LOCKS = ON, FILLFACTOR = 80) ON [PRIMARY];&#xA;&#xA;&#xA;SELECT NUMERO_GUIA &#xA;INTO #TMP_INDEX_GUIAS_AUX&#xA;FROM Mece_Logistico.DBO.GUIAS WITH(NOLOCK)&#xA;WHERE FECHA_MODIFICACION_DG BETWEEN  @FECHA_INI  AND @FECHA_FIN &#xA;AND ID_ESTADOGUIA&gt;=3&#xA;GROUP BY NUMERO_GUIA;&#xA;&#xA;--SELECT&#xA;--DATEADD(HOUR,-12,CONVERT(DATETIME,CONVERT(DATE,GETDATE()))) &#xA;--,DATEADD(DAY,1,CONVERT(DATETIME,CONVERT(DATE,GETDATE()))) &#xA;&#xA;--[PK_GUIAS]&#xA;--[REL_GUIAS_SEGUIMIENTOENVIO_FK]&#xA;--[IX_FECHA_HORA_MOVIMIENTO_BI]&#xA;&#xA;&#xA;INSERT INTO #TMP_INDEX_GUIAS_AUX&#xA;SELECT NUMERO_GUIA &#xA;FROM Mece_Logistico.DBO.SEGUIMIENTO_ENVIO WITH(NOLOCK, INDEX([IX_FECHA_HORA_MOVIMIENTO_BI]))&#xA;WHERE FECHA_HORA_MOVIMIENTO BETWEEN @FECHA_INI  AND @FECHA_FIN &#xA;AND ID_PROCESO&gt;=5&#xA;GROUP BY NUMERO_GUIA;&#xA;&#xA;INSERT INTO #TMP_INDEX_GUIAS&#xA;SELECT NUMERO_GUIA FROM #TMP_INDEX_GUIAS_AUX GROUP BY NUMERO_GUIA;&#xA;&#xA;---ELIMINAR MALAS CAPTURAS&#xA;DELETE #TMP_INDEX_GUIAS WHERE LEN(NUMERO_GUIA)&lt;=7&#xA;---ELIMINAR GUIAS INTERNAS&#xA;DELETE #TMP_INDEX_GUIAS WHERE LEFT(NUMERO_GUIA,1)=5&#xA;&#xA;----------------------------------------------&#xA;&#xA;SELECT SE.*&#xA;INTO ##TMP_BORRAR_LOCAL_DBO_MPCCO_LOG_SEGUIMEINTO_ENVIO&#xA;FROM Mece_Logistico.DBO.SEGUIMIENTO_ENVIO SE WITH(NOLOCK, INDEX([REL_GUIAS_SEGUIMIENTOENVIO_FK]))&#xA;INNER JOIN #TMP_INDEX_GUIAS TMP_G WITH (NOLOCK, INDEX([ZZZZZIDX_GUIA]))&#xA;    ON SE.NUMERO_GUIA = TMP_G.NUMERO_GUIA&#xA;OPTION (FAST 1);&#xA;&#xA;--TMP_BORRAR_LOCAL.DBO.MPCCO_&#xA;&#xA;DROP TABLE IF EXISTS #MANIEFIESTOS_MPCCO_LOG_SEGUIMEINTO_ENVIO;&#xA;SELECT TOP 0&#xA;ID_PROCESO &#xA;,NUMERO_MOVIMI &#xA;,CONSECUT_MOVIMI &#xA;INTO #MANIEFIESTOS_MPCCO_LOG_SEGUIMEINTO_ENVIO&#xA;FROM ##TMP_BORRAR_LOCAL_DBO_MPCCO_LOG_SEGUIMEINTO_ENVIO;&#xA;&#xA;ALTER TABLE #MANIEFIESTOS_MPCCO_LOG_SEGUIMEINTO_ENVIO ADD  CONSTRAINT [ZZZZZIDX_MANIFIESTOS] UNIQUE NONCLUSTERED &#xA;(&#xA;ID_PROCESO ASC&#xA;,NUMERO_MOVIMI ASC&#xA;,CONSECUT_MOVIMI ASC)&#xA;WITH (PAD_INDEX = OFF, STATISTICS_NORECOMPUTE = OFF, SORT_IN_TEMPDB = OFF, IGNORE_DUP_KEY = OFF, ONLINE = OFF, ALLOW_ROW_LOCKS = ON, ALLOW_PAGE_LOCKS = ON, FILLFACTOR = 80) ON [PRIMARY];&#xA;&#xA;INSERT INTO #MANIEFIESTOS_MPCCO_LOG_SEGUIMEINTO_ENVIO&#xA;SELECT &#xA;ID_PROCESO &#xA;,NUMERO_MOVIMI &#xA;,CONSECUT_MOVIMI &#xA;FROM ##TMP_BORRAR_LOCAL_DBO_MPCCO_LOG_SEGUIMEINTO_ENVIO&#xA;GROUP BY &#xA;ID_PROCESO &#xA;,NUMERO_MOVIMI &#xA;,CONSECUT_MOVIMI;&#xA;&#xA;&#xA;SELECT DOC.* &#xA;INTO ##TMP_BORRAR_LOCAL_DBO_MPCCO_LOG_DOCUMENTOS&#xA;FROM Mece_Logistico.DBO.DOCUMENTOS DOC WITH(NOLOCK, INDEX([PK_DOCUMENTOS_NEW]))&#xA;INNER JOIN #MANIEFIESTOS_MPCCO_LOG_SEGUIMEINTO_ENVIO MNF WITH(NOLOCK,INDEX([ZZZZZIDX_MANIFIESTOS]))&#xA;ON  MNF.ID_PROCESO=DOC.ID_PROCESO &#xA;AND MNF.NUMERO_MOVIMI=DOC.NUMERO_MOVIMI &#xA;AND MNF.CONSECUT_MOVIMI=DOC.CONSECUT_MOVIMI;&#xA;&#xA;--------------------------------------------------&#xA;&#xA;--SELECT NUMERO_GUIA,COUNT(1)&#xA;--FROM #TMP_INDEX_GUIAS&#xA;--GROUP BY NUMERO_GUIA&#xA;--HAVING COUNT(1)&gt;1&#xA;--SELECT COUNT(1) FROM #TMP_INDEX_GUIAS&#xA;&#xA;&#xA;SET NOCOUNT ON;&#xA;    IF NOT EXISTS (SELECT 1 FROM tempdb.sys.indexes &#xA;                   WHERE object_id = OBJECT_ID('tempdb..#TMP_INDEX_GUIAS')&#xA;                     AND name = 'IX_FORCE_GUIA20251113')&#xA;    BEGIN&#xA;        CREATE UNIQUE INDEX IX_FORCE_GUIA20251113 ON #TMP_INDEX_GUIAS (NUMERO_GUIA);&#xA;    END&#xA;&#xA;SELECT TOP 0 G.*&#xA;INTO ##TMP_BORRAR_LOCAL_DBO_MPCCO_LOG_GUIAS&#xA;FROM Mece_Logistico.DBO.GUIAS G WITH (NOLOCK, INDEX([PK_GUIAS]))&#xA;INNER JOIN #TMP_INDEX_GUIAS TMP_G WITH (NOLOCK, INDEX(IX_FORCE_GUIA20251113))&#xA;    ON G.NUMERO_GUIA = TMP_G.NUMERO_GUIA&#xA;OPTION (HASH JOIN, FORCE ORDER);&#xA;&#xA;&#xA;DROP TABLE IF EXISTS #TMP_INDEX_GUIAS_WHILE&#xA;SELECT NUMERO_GUIA &#xA;INTO #TMP_INDEX_GUIAS_WHILE&#xA;FROM #TMP_INDEX_GUIAS TMP_G WITH(NOLOCK)&#xA;DROP TABLE IF EXISTS #NUMEROS_GUIAS_TEMP;&#xA;CREATE TABLE #NUMEROS_GUIAS_TEMP(NUMERO_GUIA NUMERIC(20,0))&#xA;&#xA;DECLARE @VAR_CONTROL INT=1;&#xA;&#xA;WHILE (SELECT COUNT(1) FROM #TMP_INDEX_GUIAS_WHILE)&gt;0&#xA; BEGIN&#xA;  INSERT INTO #NUMEROS_GUIAS_TEMP&#xA;  SELECT TOP 10000 NUMERO_GUIA FROM #TMP_INDEX_GUIAS_WHILE&#xA;&#xA;  INSERT INTO ##TMP_BORRAR_LOCAL_DBO_MPCCO_LOG_GUIAS&#xA;  SELECT G.*  &#xA;   FROM Mece_Logistico.DBO.GUIAS G WITH (NOLOCK, INDEX([PK_GUIAS]))&#xA;   WHERE G.NUMERO_GUIA IN(SELECT NUMERO_GUIA FROM #NUMEROS_GUIAS_TEMP)&#xA;  &#xA;  DELETE #TMP_INDEX_GUIAS_WHILE WHERE NUMERO_GUIA IN(SELECT NUMERO_GUIA FROM #NUMEROS_GUIAS_TEMP)&#xA;  TRUNCATE TABLE #NUMEROS_GUIAS_TEMP;&#xA;&#xA;  PRINT(@VAR_CONTROL);&#xA;  SET @VAR_CONTROL = @VAR_CONTROL+1;&#xA; END&#xA;&#xA;TRUNCATE TABLE TMP_BORRAR_LOCAL.DBO.MPCCO_LOG_GUIAS&#xA;INSERT INTO TMP_BORRAR_LOCAL.DBO.MPCCO_LOG_GUIAS&#xA;SELECT * FROM ##TMP_BORRAR_LOCAL_DBO_MPCCO_LOG_GUIAS&#xA;&#xA;TRUNCATE TABLE TMP_BORRAR_LOCAL.DBO.MPCCO_LOG_SEGUIMEINTO_ENVIO&#xA;INSERT INTO TMP_BORRAR_LOCAL.DBO.MPCCO_LOG_SEGUIMEINTO_ENVIO&#xA;SELECT * FROM ##TMP_BORRAR_LOCAL_DBO_MPCCO_LOG_SEGUIMEINTO_ENVIO&#xA;&#xA;TRUNCATE TABLE TMP_BORRAR_LOCAL.DBO.MPCCO_LOG_DOCUMENTOS&#xA;INSERT INTO TMP_BORRAR_LOCAL.DBO.MPCCO_LOG_DOCUMENTOS&#xA;SELECT * FROM ##TMP_BORRAR_LOCAL_DBO_MPCCO_LOG_DOCUMENTOS&#xA;&#xA;DROP TABLE IF EXISTS #TMP_INDEX_GUIAS_AUX;&#xA;DROP TABLE IF EXISTS #TMP_INDEX_GUIAS;&#xA;DROP TABLE IF EXISTS #MANIEFIESTOS_MPCCO_LOG_SEGUIMEINTO_ENVIO;&#xA;&#xA;DROP TABLE IF EXISTS ##TMP_BORRAR_LOCAL_DBO_MPCCO_LOG_GUIAS&#xA;DROP TABLE IF EXISTS ##TMP_BORRAR_LOCAL_DBO_MPCCO_LOG_SEGUIMEINTO_ENVIO&#xA;DROP TABLE IF EXISTS ##TMP_BORRAR_LOCAL_DBO_MPCCO_LOG_DOCUMENTOS&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;/*&#xA;EXEC [tmp_borrar_local]. [dbo].[TMP_MPCCO_OBTENER_GUIAS] ?,?,?;&#xA;&#xA;SELECT COUNT(1) FROM TMP_BORRAR_LOCAL.DBO.MPCCO_LOG_GUIAS&#xA;SELECT COUNT(1) FROM TMP_BORRAR_LOCAL.DBO.MPCCO_LOG_SEGUIMEINTO_ENVIO&#xA;SELECT COUNT(1) FROM TMP_BORRAR_LOCAL.DBO.MPCCO_LOG_DOCUMENTOS&#xA;*/&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;/*&#xA;&#xA;USE [tmp_borrar_local]&#xA;GO&#xA;&#xA;SET ANSI_NULLS ON&#xA;GO&#xA;SET QUOTED_IDENTIFIER ON&#xA;GO&#xA;&#xA;ALTER PROCEDURE [dbo].[TMP_MPCCO_OBTENER_GUIAS]&#xA;@fecha_ini_VAR VARCHAR(10),&#xA;@fecha_fin_VAR VARCHAR(10),&#xA;@diasatr int&#xA;AS&#xA;BEGIN&#xA;  IF @fecha_ini_VAR='1900-01-01' OR @fecha_fin_VAR='1900-01-01' &#xA;   OR @fecha_ini_VAR&lt;='1999-01-01' OR @fecha_fin_VAR&lt;='1999-01-01' &#xA;  BEGIN&#xA;  SET @fecha_ini_VAR=CONVERT(varchar,GETDATE()-@diasatr,23)&#xA;  SET @fecha_fin_VAR=CONVERT(varchar,GETDATE(),23)&#xA;  END&#xA;&#xA;&#xA;DECLARE @VAR_INT INT = @diasatr;&#xA;DECLARE @FECHA_INI DATETIME = CONVERT(DATETIME,@fecha_ini_VAR); &#xA;DECLARE @FECHA_FIN DATETIME = CONVERT(DATETIME,@fecha_fin_VAR);&#xA;&#xA;&#xA;DROP TABLE IF EXISTS #TMP_INDEX_GUIAS_AUX&#xA;DROP TABLE IF EXISTS #TMP_INDEX_GUIAS&#xA;DROP TABLE IF EXISTS #MANIEFIESTOS_MPCCO_LOG_SEGUIMEINTO_ENVIO&#xA;&#xA;TRUNCATE TABLE TMP_BORRAR_LOCAL.DBO.MPCCO_LOG_GUIAS&#xA;TRUNCATE TABLE TMP_BORRAR_LOCAL.DBO.MPCCO_LOG_SEGUIMEINTO_ENVIO&#xA;TRUNCATE TABLE TMP_BORRAR_LOCAL.DBO.MPCCO_LOG_DOCUMENTOS&#xA;&#xA;&#xA;CREATE TABLE #TMP_INDEX_GUIAS(NUMERO_GUIA NUMERIC(20,0))&#xA;ALTER TABLE #TMP_INDEX_GUIAS ADD  CONSTRAINT [ZZZZIDX_GUIA] UNIQUE NONCLUSTERED &#xA;([NUMERO_GUIA] ASC)WITH (PAD_INDEX = OFF, STATISTICS_NORECOMPUTE = OFF, SORT_IN_TEMPDB = OFF, IGNORE_DUP_KEY = OFF, ONLINE = OFF, ALLOW_ROW_LOCKS = ON, ALLOW_PAGE_LOCKS = ON, FILLFACTOR = 80) ON [PRIMARY]&#xA;&#xA;&#xA;SELECT NUMERO_GUIA &#xA;INTO #TMP_INDEX_GUIAS_AUX&#xA;FROM Mece_Logistico.DBO.GUIAS WITH(NOLOCK)&#xA;WHERE FECHA_MODIFICACION_DG BETWEEN @FECHA_INI  AND @FECHA_FIN &#xA;AND ID_ESTADOGUIA&gt;=3&#xA;GROUP BY NUMERO_GUIA&#xA;&#xA;INSERT INTO #TMP_INDEX_GUIAS_AUX&#xA;SELECT NUMERO_GUIA &#xA;FROM Mece_Logistico.DBO.SEGUIMIENTO_ENVIO WITH(NOLOCK)&#xA;WHERE FECHA_HORA_MOVIMIENTO BETWEEN @FECHA_INI  AND @FECHA_FIN &#xA;AND ID_PROCESO&gt;=5&#xA;GROUP BY NUMERO_GUIA&#xA;&#xA;INSERT INTO #TMP_INDEX_GUIAS&#xA;SELECT NUMERO_GUIA FROM #TMP_INDEX_GUIAS_AUX GROUP BY NUMERO_GUIA&#xA;&#xA;---ELIMINAR MALAS CAPTURAS&#xA;DELETE #TMP_INDEX_GUIAS WHERE LEN(NUMERO_GUIA)&lt;=7&#xA;---ELIMINAR GUIAS INTERNAS&#xA;DELETE #TMP_INDEX_GUIAS WHERE LEFT(NUMERO_GUIA,1)=5&#xA;&#xA;&#xA;INSERT INTO TMP_BORRAR_LOCAL.DBO.MPCCO_LOG_GUIAS&#xA;SELECT G.*&#xA;--INTO TMP_BORRAR_LOCAL.DBO.MPCCO_LOG_GUIAS&#xA;FROM Mece_Logistico.DBO.GUIAS G WITH(NOLOCK)&#xA;INNER JOIN #TMP_INDEX_GUIAS TMP_G ON G.NUMERO_GUIA=TMP_G.NUMERO_GUIA&#xA;&#xA;INSERT INTO TMP_BORRAR_LOCAL.DBO.MPCCO_LOG_SEGUIMEINTO_ENVIO&#xA;SELECT SE.*&#xA;--INTO TMP_BORRAR_LOCAL.DBO.MPCCO_LOG_SEGUIMEINTO_ENVIO&#xA;FROM Mece_Logistico.DBO.SEGUIMIENTO_ENVIO SE WITH(NOLOCK)&#xA;INNER JOIN #TMP_INDEX_GUIAS TMP_G ON SE.NUMERO_GUIA=TMP_G.NUMERO_GUIA&#xA;&#xA;&#xA;DROP TABLE IF EXISTS #MANIEFIESTOS_MPCCO_LOG_SEGUIMEINTO_ENVIO;&#xA;SELECT TOP 0&#xA;ID_PROCESO &#xA;,NUMERO_MOVIMI &#xA;,CONSECUT_MOVIMI &#xA;INTO #MANIEFIESTOS_MPCCO_LOG_SEGUIMEINTO_ENVIO&#xA;FROM TMP_BORRAR_LOCAL.DBO.MPCCO_LOG_SEGUIMEINTO_ENVIO&#xA;&#xA;ALTER TABLE #MANIEFIESTOS_MPCCO_LOG_SEGUIMEINTO_ENVIO ADD  CONSTRAINT [ZZZZIDX_MANIFIESTOS] UNIQUE NONCLUSTERED &#xA;(&#xA;ID_PROCESO ASC&#xA;,NUMERO_MOVIMI ASC&#xA;,CONSECUT_MOVIMI ASC)&#xA;WITH (PAD_INDEX = OFF, STATISTICS_NORECOMPUTE = OFF, SORT_IN_TEMPDB = OFF, IGNORE_DUP_KEY = OFF, ONLINE = OFF, ALLOW_ROW_LOCKS = ON, ALLOW_PAGE_LOCKS = ON, FILLFACTOR = 80) ON [PRIMARY]&#xA;&#xA;INSERT INTO #MANIEFIESTOS_MPCCO_LOG_SEGUIMEINTO_ENVIO&#xA;SELECT &#xA;ID_PROCESO &#xA;,NUMERO_MOVIMI &#xA;,CONSECUT_MOVIMI &#xA;FROM TMP_BORRAR_LOCAL.DBO.MPCCO_LOG_SEGUIMEINTO_ENVIO&#xA;GROUP BY &#xA;ID_PROCESO &#xA;,NUMERO_MOVIMI &#xA;,CONSECUT_MOVIMI&#xA;&#xA;INSERT INTO TMP_BORRAR_LOCAL.DBO.MPCCO_LOG_DOCUMENTOS&#xA;SELECT DOC.* &#xA;--INTO TMP_BORRAR_LOCAL.DBO.MPCCO_LOG_DOCUMENTOS&#xA;FROM Mece_Logistico.DBO.DOCUMENTOS DOC WITH(NOLOCK)&#xA;INNER JOIN #MANIEFIESTOS_MPCCO_LOG_SEGUIMEINTO_ENVIO MNF&#xA;ON  MNF.ID_PROCESO=DOC.ID_PROCESO &#xA;AND MNF.NUMERO_MOVIMI=DOC.NUMERO_MOVIMI &#xA;AND MNF.CONSECUT_MOVIMI=DOC.CONSECUT_MOVIMI&#xA;&#xA;&#xA;DROP TABLE IF EXISTS #TMP_INDEX_GUIAS_AUX&#xA;DROP TABLE IF EXISTS #TMP_INDEX_GUIAS&#xA;DROP TABLE IF EXISTS #MANIEFIESTOS_MPCCO_LOG_SEGUIMEINTO_ENVIO&#xA;&#xA;&#xA;END&#xA;&#xA;&#xA;&#xA;*/" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="0"
                SQLTask:DtsVariableName="User::STR_01_FE_INI"
                SQLTask:ParameterDirection="Input"
                SQLTask:DataType="129"
                SQLTask:ParameterSize="-1" />
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="1"
                SQLTask:DtsVariableName="User::STR_02_FE_FIN"
                SQLTask:ParameterDirection="Input"
                SQLTask:DataType="129"
                SQLTask:ParameterSize="-1" />
              <SQLTask:ParameterBinding
