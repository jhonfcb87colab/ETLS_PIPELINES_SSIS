        <DTS:Executable
          DTS:refId="Package\backups scripts\backup20260710 EXTRACCION INICIAL ULTIMO PROCESO"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:Disabled="True"
          DTS:DTSID="{078c8b4c-5a7b-4927-91e8-cbae9caabd0b}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="backup20260710 EXTRACCION INICIAL ULTIMO PROCESO"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="5">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{5B2BDE35-0E5F-4DE2-A25A-19DB68B50268}"
              SQLTask:SqlStatementSource="declare @fecha_ini_VAR VARCHAR(12)=?;&#xA;declare @fecha_fin_VAR VARCHAR(12)=?;&#xA;declare @diasatr int = ?;&#xA;&#xA;  IF @fecha_ini_VAR='1900-01-01' OR @fecha_fin_VAR='1900-01-01' &#xA;   OR @fecha_ini_VAR&lt;='1999-01-01' OR @fecha_fin_VAR&lt;='1999-01-01' &#xA;  BEGIN&#xA;  SET @fecha_ini_VAR=CONVERT(varchar,GETDATE()-@diasatr,23)&#xA;  SET @fecha_fin_VAR=CONVERT(varchar,GETDATE(),23)&#xA;  END&#xA;/*&#xA;select @fecha_ini_VAR&#xA;    ,@fecha_fin_VAR&#xA;*/&#xA;&#xA;DECLARE @VAR_INT INT = @diasatr;&#xA;DECLARE @FECHA_INI DATETIME = DATEADD(HOUR,12,CONVERT(DATETIME,@fecha_ini_VAR)); &#xA;DECLARE @FECHA_FIN DATETIME = DATEADD(DAY,1,CONVERT(DATETIME,@fecha_fin_VAR));&#xA;&#xA;----SELECT @VAR_INT I,@FECHA_INI,@FECHA_FIN&#xA;&#xA;&#xA;DROP TABLE IF EXISTS #TMP_INDEX_GUIAS_AUX;&#xA;DROP TABLE IF EXISTS #TMP_INDEX_GUIAS;&#xA;DROP TABLE IF EXISTS #MANIEFIESTOS_MPCCO_LOG_SEGUIMEINTO_ENVIO;&#xA;&#xA;DROP TABLE IF EXISTS ##TMP_BORRAR_LOCAL_DBO_MPCCO_LOG_GUIAS;&#xA;DROP TABLE IF EXISTS ##TMP_BORRAR_LOCAL_DBO_MPCCO_LOG_SEGUIMEINTO_ENVIO;&#xA;DROP TABLE IF EXISTS ##TMP_BORRAR_LOCAL_DBO_MPCCO_LOG_DOCUMENTOS;&#xA;&#xA;&#xA;CREATE TABLE #TMP_INDEX_GUIAS(NUMERO_GUIA NUMERIC(20,0))&#xA;ALTER TABLE #TMP_INDEX_GUIAS ADD  CONSTRAINT [ZZZZZIDX_GUIA] UNIQUE NONCLUSTERED &#xA;([NUMERO_GUIA] ASC)WITH (PAD_INDEX = OFF, STATISTICS_NORECOMPUTE = OFF, SORT_IN_TEMPDB = OFF, IGNORE_DUP_KEY = OFF, ONLINE = OFF, ALLOW_ROW_LOCKS = ON, ALLOW_PAGE_LOCKS = ON, FILLFACTOR = 80) ON [PRIMARY];&#xA;&#xA;&#xA;SELECT NUMERO_GUIA &#xA;INTO #TMP_INDEX_GUIAS_AUX&#xA;FROM Mece_Logistico.DBO.GUIAS WITH(NOLOCK)&#xA;WHERE FECHA_MODIFICACION_DG BETWEEN  @FECHA_INI  AND @FECHA_FIN &#xA;AND ID_ESTADOGUIA&gt;=3&#xA;GROUP BY NUMERO_GUIA;&#xA;&#xA;--SELECT&#xA;--DATEADD(HOUR,-12,CONVERT(DATETIME,CONVERT(DATE,GETDATE()))) &#xA;--,DATEADD(DAY,1,CONVERT(DATETIME,CONVERT(DATE,GETDATE()))) &#xA;&#xA;--[PK_GUIAS]&#xA;--[REL_GUIAS_SEGUIMIENTOENVIO_FK]&#xA;--[IX_FECHA_HORA_MOVIMIENTO_BI]&#xA;&#xA;&#xA;INSERT INTO #TMP_INDEX_GUIAS_AUX&#xA;SELECT NUMERO_GUIA &#xA;FROM Mece_Logistico.DBO.SEGUIMIENTO_ENVIO WITH(NOLOCK, INDEX([IX_FECHA_HORA_MOVIMIENTO_BI]))&#xA;WHERE FECHA_HORA_MOVIMIENTO BETWEEN @FECHA_INI  AND @FECHA_FIN &#xA;AND ID_PROCESO&gt;=5&#xA;GROUP BY NUMERO_GUIA;&#xA;&#xA;INSERT INTO #TMP_INDEX_GUIAS&#xA;SELECT NUMERO_GUIA FROM #TMP_INDEX_GUIAS_AUX GROUP BY NUMERO_GUIA;&#xA;&#xA;---ELIMINAR MALAS CAPTURAS&#xA;DELETE #TMP_INDEX_GUIAS WHERE LEN(NUMERO_GUIA)&lt;=7&#xA;---ELIMINAR GUIAS INTERNAS&#xA;DELETE #TMP_INDEX_GUIAS WHERE LEFT(NUMERO_GUIA,1)=5&#xA;&#xA;----------------------------------------------&#xA;&#xA;SELECT SE.*&#xA;INTO ##TMP_BORRAR_LOCAL_DBO_MPCCO_LOG_SEGUIMEINTO_ENVIO&#xA;FROM Mece_Logistico.DBO.SEGUIMIENTO_ENVIO SE WITH(NOLOCK, INDEX([REL_GUIAS_SEGUIMIENTOENVIO_FK]))&#xA;INNER JOIN #TMP_INDEX_GUIAS TMP_G WITH (NOLOCK, INDEX([ZZZZZIDX_GUIA]))&#xA;    ON SE.NUMERO_GUIA = TMP_G.NUMERO_GUIA&#xA;OPTION (FAST 1);&#xA;&#xA;--TMP_BORRAR_LOCAL.DBO.MPCCO_&#xA;&#xA;DROP TABLE IF EXISTS #MANIEFIESTOS_MPCCO_LOG_SEGUIMEINTO_ENVIO;&#xA;SELECT TOP 0&#xA;ID_PROCESO &#xA;,NUMERO_MOVIMI &#xA;,CONSECUT_MOVIMI &#xA;INTO #MANIEFIESTOS_MPCCO_LOG_SEGUIMEINTO_ENVIO&#xA;FROM ##TMP_BORRAR_LOCAL_DBO_MPCCO_LOG_SEGUIMEINTO_ENVIO;&#xA;&#xA;ALTER TABLE #MANIEFIESTOS_MPCCO_LOG_SEGUIMEINTO_ENVIO ADD  CONSTRAINT [ZZZZZIDX_MANIFIESTOS] UNIQUE NONCLUSTERED &#xA;(&#xA;ID_PROCESO ASC&#xA;,NUMERO_MOVIMI ASC&#xA;,CONSECUT_MOVIMI ASC)&#xA;WITH (PAD_INDEX = OFF, STATISTICS_NORECOMPUTE = OFF, SORT_IN_TEMPDB = OFF, IGNORE_DUP_KEY = OFF, ONLINE = OFF, ALLOW_ROW_LOCKS = ON, ALLOW_PAGE_LOCKS = ON, FILLFACTOR = 80) ON [PRIMARY];&#xA;&#xA;INSERT INTO #MANIEFIESTOS_MPCCO_LOG_SEGUIMEINTO_ENVIO&#xA;SELECT &#xA;ID_PROCESO &#xA;,NUMERO_MOVIMI &#xA;,CONSECUT_MOVIMI &#xA;FROM ##TMP_BORRAR_LOCAL_DBO_MPCCO_LOG_SEGUIMEINTO_ENVIO&#xA;GROUP BY &#xA;ID_PROCESO &#xA;,NUMERO_MOVIMI &#xA;,CONSECUT_MOVIMI;&#xA;&#xA;&#xA;SELECT DOC.* &#xA;INTO ##TMP_BORRAR_LOCAL_DBO_MPCCO_LOG_DOCUMENTOS&#xA;FROM Mece_Logistico.DBO.DOCUMENTOS DOC WITH(NOLOCK, INDEX([PK_DOCUMENTOS_NEW]))&#xA;INNER JOIN #MANIEFIESTOS_MPCCO_LOG_SEGUIMEINTO_ENVIO MNF WITH(NOLOCK,INDEX([ZZZZZIDX_MANIFIESTOS]))&#xA;ON  MNF.ID_PROCESO=DOC.ID_PROCESO &#xA;AND MNF.NUMERO_MOVIMI=DOC.NUMERO_MOVIMI &#xA;AND MNF.CONSECUT_MOVIMI=DOC.CONSECUT_MOVIMI;&#xA;&#xA;--------------------------------------------------&#xA;&#xA;--SELECT NUMERO_GUIA,COUNT(1)&#xA;--FROM #TMP_INDEX_GUIAS&#xA;--GROUP BY NUMERO_GUIA&#xA;--HAVING COUNT(1)&gt;1&#xA;--SELECT COUNT(1) FROM #TMP_INDEX_GUIAS&#xA;&#xA;&#xA;SET NOCOUNT ON;&#xA;    IF NOT EXISTS (SELECT 1 FROM tempdb.sys.indexes &#xA;                   WHERE object_id = OBJECT_ID('tempdb..#TMP_INDEX_GUIAS')&#xA;                     AND name = 'IX_FORCE_GUIA20251113')&#xA;    BEGIN&#xA;        CREATE UNIQUE INDEX IX_FORCE_GUIA20251113 ON #TMP_INDEX_GUIAS (NUMERO_GUIA);&#xA;    END&#xA;&#xA;SELECT TOP 0 G.*&#xA;INTO ##TMP_BORRAR_LOCAL_DBO_MPCCO_LOG_GUIAS&#xA;FROM Mece_Logistico.DBO.GUIAS G WITH (NOLOCK, INDEX([PK_GUIAS]))&#xA;INNER JOIN #TMP_INDEX_GUIAS TMP_G WITH (NOLOCK, INDEX(IX_FORCE_GUIA20251113))&#xA;    ON G.NUMERO_GUIA = TMP_G.NUMERO_GUIA&#xA;OPTION (HASH JOIN, FORCE ORDER);&#xA;&#xA;&#xA;DROP TABLE IF EXISTS #TMP_INDEX_GUIAS_WHILE&#xA;SELECT NUMERO_GUIA &#xA;INTO #TMP_INDEX_GUIAS_WHILE&#xA;FROM #TMP_INDEX_GUIAS TMP_G WITH(NOLOCK)&#xA;DROP TABLE IF EXISTS #NUMEROS_GUIAS_TEMP;&#xA;CREATE TABLE #NUMEROS_GUIAS_TEMP(NUMERO_GUIA NUMERIC(20,0))&#xA;&#xA;DECLARE @VAR_CONTROL INT=1;&#xA;&#xA;WHILE (SELECT COUNT(1) FROM #TMP_INDEX_GUIAS_WHILE)&gt;0&#xA; BEGIN&#xA;  INSERT INTO #NUMEROS_GUIAS_TEMP&#xA;  SELECT TOP 10000 NUMERO_GUIA FROM #TMP_INDEX_GUIAS_WHILE&#xA;&#xA;  INSERT INTO ##TMP_BORRAR_LOCAL_DBO_MPCCO_LOG_GUIAS&#xA;  SELECT G.*  &#xA;   FROM Mece_Logistico.DBO.GUIAS G WITH (NOLOCK, INDEX([PK_GUIAS]))&#xA;   WHERE G.NUMERO_GUIA IN(SELECT NUMERO_GUIA FROM #NUMEROS_GUIAS_TEMP)&#xA;  &#xA;  DELETE #TMP_INDEX_GUIAS_WHILE WHERE NUMERO_GUIA IN(SELECT NUMERO_GUIA FROM #NUMEROS_GUIAS_TEMP)&#xA;  TRUNCATE TABLE #NUMEROS_GUIAS_TEMP;&#xA;&#xA;  PRINT(@VAR_CONTROL);&#xA;  SET @VAR_CONTROL = @VAR_CONTROL+1;&#xA; END&#xA;&#xA;TRUNCATE TABLE TMP_BORRAR_LOCAL.DBO.MPCCO_LOG_GUIAS&#xA;INSERT INTO TMP_BORRAR_LOCAL.DBO.MPCCO_LOG_GUIAS&#xA;SELECT * FROM ##TMP_BORRAR_LOCAL_DBO_MPCCO_LOG_GUIAS&#xA;&#xA;TRUNCATE TABLE TMP_BORRAR_LOCAL.DBO.MPCCO_LOG_SEGUIMEINTO_ENVIO&#xA;INSERT INTO TMP_BORRAR_LOCAL.DBO.MPCCO_LOG_SEGUIMEINTO_ENVIO&#xA;SELECT * FROM ##TMP_BORRAR_LOCAL_DBO_MPCCO_LOG_SEGUIMEINTO_ENVIO&#xA;&#xA;TRUNCATE TABLE TMP_BORRAR_LOCAL.DBO.MPCCO_LOG_DOCUMENTOS&#xA;INSERT INTO TMP_BORRAR_LOCAL.DBO.MPCCO_LOG_DOCUMENTOS&#xA;SELECT * FROM ##TMP_BORRAR_LOCAL_DBO_MPCCO_LOG_DOCUMENTOS&#xA;&#xA;DROP TABLE IF EXISTS #TMP_INDEX_GUIAS_AUX;&#xA;DROP TABLE IF EXISTS #TMP_INDEX_GUIAS;&#xA;DROP TABLE IF EXISTS #MANIEFIESTOS_MPCCO_LOG_SEGUIMEINTO_ENVIO;&#xA;&#xA;DROP TABLE IF EXISTS ##TMP_BORRAR_LOCAL_DBO_MPCCO_LOG_GUIAS&#xA;DROP TABLE IF EXISTS ##TMP_BORRAR_LOCAL_DBO_MPCCO_LOG_SEGUIMEINTO_ENVIO&#xA;DROP TABLE IF EXISTS ##TMP_BORRAR_LOCAL_DBO_MPCCO_LOG_DOCUMENTOS&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;/*&#xA;EXEC [tmp_borrar_local]. [dbo].[TMP_MPCCO_OBTENER_GUIAS] ?,?,?;&#xA;&#xA;SELECT COUNT(1) FROM TMP_BORRAR_LOCAL.DBO.MPCCO_LOG_GUIAS&#xA;SELECT COUNT(1) FROM TMP_BORRAR_LOCAL.DBO.MPCCO_LOG_SEGUIMEINTO_ENVIO&#xA;SELECT COUNT(1) FROM TMP_BORRAR_LOCAL.DBO.MPCCO_LOG_DOCUMENTOS&#xA;*/&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;/*&#xA;&#xA;USE [tmp_borrar_local]&#xA;GO&#xA;&#xA;SET ANSI_NULLS ON&#xA;GO&#xA;SET QUOTED_IDENTIFIER ON&#xA;GO&#xA;&#xA;ALTER PROCEDURE [dbo].[TMP_MPCCO_OBTENER_GUIAS]&#xA;@fecha_ini_VAR VARCHAR(10),&#xA;@fecha_fin_VAR VARCHAR(10),&#xA;@diasatr int&#xA;AS&#xA;BEGIN&#xA;  IF @fecha_ini_VAR='1900-01-01' OR @fecha_fin_VAR='1900-01-01' &#xA;   OR @fecha_ini_VAR&lt;='1999-01-01' OR @fecha_fin_VAR&lt;='1999-01-01' &#xA;  BEGIN&#xA;  SET @fecha_ini_VAR=CONVERT(varchar,GETDATE()-@diasatr,23)&#xA;  SET @fecha_fin_VAR=CONVERT(varchar,GETDATE(),23)&#xA;  END&#xA;&#xA;&#xA;DECLARE @VAR_INT INT = @diasatr;&#xA;DECLARE @FECHA_INI DATETIME = CONVERT(DATETIME,@fecha_ini_VAR); &#xA;DECLARE @FECHA_FIN DATETIME = CONVERT(DATETIME,@fecha_fin_VAR);&#xA;&#xA;&#xA;DROP TABLE IF EXISTS #TMP_INDEX_GUIAS_AUX&#xA;DROP TABLE IF EXISTS #TMP_INDEX_GUIAS&#xA;DROP TABLE IF EXISTS #MANIEFIESTOS_MPCCO_LOG_SEGUIMEINTO_ENVIO&#xA;&#xA;TRUNCATE TABLE TMP_BORRAR_LOCAL.DBO.MPCCO_LOG_GUIAS&#xA;TRUNCATE TABLE TMP_BORRAR_LOCAL.DBO.MPCCO_LOG_SEGUIMEINTO_ENVIO&#xA;TRUNCATE TABLE TMP_BORRAR_LOCAL.DBO.MPCCO_LOG_DOCUMENTOS&#xA;&#xA;&#xA;CREATE TABLE #TMP_INDEX_GUIAS(NUMERO_GUIA NUMERIC(20,0))&#xA;ALTER TABLE #TMP_INDEX_GUIAS ADD  CONSTRAINT [ZZZZIDX_GUIA] UNIQUE NONCLUSTERED &#xA;([NUMERO_GUIA] ASC)WITH (PAD_INDEX = OFF, STATISTICS_NORECOMPUTE = OFF, SORT_IN_TEMPDB = OFF, IGNORE_DUP_KEY = OFF, ONLINE = OFF, ALLOW_ROW_LOCKS = ON, ALLOW_PAGE_LOCKS = ON, FILLFACTOR = 80) ON [PRIMARY]&#xA;&#xA;&#xA;SELECT NUMERO_GUIA &#xA;INTO #TMP_INDEX_GUIAS_AUX&#xA;FROM Mece_Logistico.DBO.GUIAS WITH(NOLOCK)&#xA;WHERE FECHA_MODIFICACION_DG BETWEEN @FECHA_INI  AND @FECHA_FIN &#xA;AND ID_ESTADOGUIA&gt;=3&#xA;GROUP BY NUMERO_GUIA&#xA;&#xA;INSERT INTO #TMP_INDEX_GUIAS_AUX&#xA;SELECT NUMERO_GUIA &#xA;FROM Mece_Logistico.DBO.SEGUIMIENTO_ENVIO WITH(NOLOCK)&#xA;WHERE FECHA_HORA_MOVIMIENTO BETWEEN @FECHA_INI  AND @FECHA_FIN &#xA;AND ID_PROCESO&gt;=5&#xA;GROUP BY NUMERO_GUIA&#xA;&#xA;INSERT INTO #TMP_INDEX_GUIAS&#xA;SELECT NUMERO_GUIA FROM #TMP_INDEX_GUIAS_AUX GROUP BY NUMERO_GUIA&#xA;&#xA;---ELIMINAR MALAS CAPTURAS&#xA;DELETE #TMP_INDEX_GUIAS WHERE LEN(NUMERO_GUIA)&lt;=7&#xA;---ELIMINAR GUIAS INTERNAS&#xA;DELETE #TMP_INDEX_GUIAS WHERE LEFT(NUMERO_GUIA,1)=5&#xA;&#xA;&#xA;INSERT INTO TMP_BORRAR_LOCAL.DBO.MPCCO_LOG_GUIAS&#xA;SELECT G.*&#xA;--INTO TMP_BORRAR_LOCAL.DBO.MPCCO_LOG_GUIAS&#xA;FROM Mece_Logistico.DBO.GUIAS G WITH(NOLOCK)&#xA;INNER JOIN #TMP_INDEX_GUIAS TMP_G ON G.NUMERO_GUIA=TMP_G.NUMERO_GUIA&#xA;&#xA;INSERT INTO TMP_BORRAR_LOCAL.DBO.MPCCO_LOG_SEGUIMEINTO_ENVIO&#xA;SELECT SE.*&#xA;--INTO TMP_BORRAR_LOCAL.DBO.MPCCO_LOG_SEGUIMEINTO_ENVIO&#xA;FROM Mece_Logistico.DBO.SEGUIMIENTO_ENVIO SE WITH(NOLOCK)&#xA;INNER JOIN #TMP_INDEX_GUIAS TMP_G ON SE.NUMERO_GUIA=TMP_G.NUMERO_GUIA&#xA;&#xA;&#xA;DROP TABLE IF EXISTS #MANIEFIESTOS_MPCCO_LOG_SEGUIMEINTO_ENVIO;&#xA;SELECT TOP 0&#xA;ID_PROCESO &#xA;,NUMERO_MOVIMI &#xA;,CONSECUT_MOVIMI &#xA;INTO #MANIEFIESTOS_MPCCO_LOG_SEGUIMEINTO_ENVIO&#xA;FROM TMP_BORRAR_LOCAL.DBO.MPCCO_LOG_SEGUIMEINTO_ENVIO&#xA;&#xA;ALTER TABLE #MANIEFIESTOS_MPCCO_LOG_SEGUIMEINTO_ENVIO ADD  CONSTRAINT [ZZZZIDX_MANIFIESTOS] UNIQUE NONCLUSTERED &#xA;(&#xA;ID_PROCESO ASC&#xA;,NUMERO_MOVIMI ASC&#xA;,CONSECUT_MOVIMI ASC)&#xA;WITH (PAD_INDEX = OFF, STATISTICS_NORECOMPUTE = OFF, SORT_IN_TEMPDB = OFF, IGNORE_DUP_KEY = OFF, ONLINE = OFF, ALLOW_ROW_LOCKS = ON, ALLOW_PAGE_LOCKS = ON, FILLFACTOR = 80) ON [PRIMARY]&#xA;&#xA;INSERT INTO #MANIEFIESTOS_MPCCO_LOG_SEGUIMEINTO_ENVIO&#xA;SELECT &#xA;ID_PROCESO &#xA;,NUMERO_MOVIMI &#xA;,CONSECUT_MOVIMI &#xA;FROM TMP_BORRAR_LOCAL.DBO.MPCCO_LOG_SEGUIMEINTO_ENVIO&#xA;GROUP BY &#xA;ID_PROCESO &#xA;,NUMERO_MOVIMI &#xA;,CONSECUT_MOVIMI&#xA;&#xA;INSERT INTO TMP_BORRAR_LOCAL.DBO.MPCCO_LOG_DOCUMENTOS&#xA;SELECT DOC.* &#xA;--INTO TMP_BORRAR_LOCAL.DBO.MPCCO_LOG_DOCUMENTOS&#xA;FROM Mece_Logistico.DBO.DOCUMENTOS DOC WITH(NOLOCK)&#xA;INNER JOIN #MANIEFIESTOS_MPCCO_LOG_SEGUIMEINTO_ENVIO MNF&#xA;ON  MNF.ID_PROCESO=DOC.ID_PROCESO &#xA;AND MNF.NUMERO_MOVIMI=DOC.NUMERO_MOVIMI &#xA;AND MNF.CONSECUT_MOVIMI=DOC.CONSECUT_MOVIMI&#xA;&#xA;&#xA;DROP TABLE IF EXISTS #TMP_INDEX_GUIAS_AUX&#xA;DROP TABLE IF EXISTS #TMP_INDEX_GUIAS&#xA;DROP TABLE IF EXISTS #MANIEFIESTOS_MPCCO_LOG_SEGUIMEINTO_ENVIO&#xA;&#xA;&#xA;END&#xA;&#xA;&#xA;&#xA;*/" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="0"
                SQLTask:DtsVariableName="User::STR_01_FE_INI"
                SQLTask:ParameterDirection="Input"
