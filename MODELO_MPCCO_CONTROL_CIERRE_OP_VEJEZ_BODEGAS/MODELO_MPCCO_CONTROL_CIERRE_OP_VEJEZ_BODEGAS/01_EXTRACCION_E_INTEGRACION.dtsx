      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{9270DAF5-1074-4D39-8815-87044D378AC9}"
          SQLTask:SqlStatementSource="TRUNCATE TABLE [TMP].[MPCCO_VJ_ULTIMO_PROCESO_LOG];&#xA;&#xA;;WITH CTE AS (&#xA;SELECT &#xA;ROW_ID = ROW_NUMBER() OVER(PARTITION BY G.NUMERO_GUIA ORDER BY SEG.FECHA_HORA_MOVIMIENTO DESC)&#xA;,G.NUMERO_GUIA&#x9;   AS  &#x9;G_NUMERO_GUIA&#xA;,G.ID_TIPOGUIA&#x9;   AS  &#x9;G_ID_TIPOGUIA&#xA;,G.ID_CLIENTE&#x9;   AS  &#x9;G_ID_CLIENTE&#xA;,G.ID_CANAL&#x9;   AS  &#x9;G_ID_CANAL&#xA;,G.ID_DIVISION_PROV&#x9;   AS  &#x9;G_ID_DIVISION_PROV&#xA;,G.ID_PAIS_ORIGEN&#x9;   AS  &#x9;G_ID_PAIS_ORIGEN&#xA;,G.ID_CIUDAD_ORIGEN&#x9;   AS  &#x9;G_ID_CIUDAD_ORIGEN&#xA;,G.ID_PAIS_DESTINO&#x9;   AS  &#x9;G_ID_PAIS_DESTINO&#xA;,G.ID_CIUDAD_DESTINO&#x9;   AS  &#x9;G_ID_CIUDAD_DESTINO&#xA;,G.ID_TIPO_ZONA_URBA&#x9;   AS  &#x9;G_ID_TIPO_ZONA_URBA&#xA;,G.ID_PAIS_ZONA_URB_ENTR&#x9;   AS  &#x9;G_ID_PAIS_ZONA_URB_ENTR&#xA;,G.ID_CIUDAD_ZONA_URB_ENTR&#x9;   AS  &#x9;G_ID_CIUDAD_ZONA_URB_ENTR&#xA;,G.ID_ZONA_URBA&#x9;   AS  &#x9;G_ID_ZONA_URBA&#xA;,G.ID_ESTADOENVIO&#x9;   AS  &#x9;G_ID_ESTADOENVIO&#xA;,G.ID_ESTADOGUIA&#x9;   AS  &#x9;G_ID_ESTADOGUIA&#xA;,G.ID_CARACT_ENVIO&#x9;   AS  &#x9;G_ID_CARACT_ENVIO&#xA;,G.ID_TIEMPO&#x9;   AS  &#x9;G_ID_TIEMPO&#xA;,G.ID_MEDTRANS&#x9;   AS  &#x9;G_ID_MEDTRANS&#xA;,G.ID_PRODUCTO&#x9;   AS  &#x9;G_ID_PRODUCTO&#xA;,G.ID_SUBPRODUCTO&#x9;   AS  &#x9;G_ID_SUBPRODUCTO&#xA;,G.FECHA_ENVIO&#x9;   AS  &#x9;G_FECHA_ENVIO&#xA;,G.ID_REMITE&#x9;   AS  &#x9;G_ID_REMITE&#xA;,G.ID_DESTINA&#x9;   AS  &#x9;G_ID_DESTINA&#xA;,G.NOMBRE_REMITE_GUIA&#x9;   AS  &#x9;G_NOMBRE_REMITE_GUIA&#xA;,G.APELLIDO_REMITE_GUIA&#x9;   AS  &#x9;G_APELLIDO_REMITE_GUIA&#xA;,G.NOMBRE_DESTINA_GUIA&#x9;   AS  &#x9;G_NOMBRE_DESTINA_GUIA&#xA;,G.APELLIDO_DESTINA_GUIA&#x9;   AS  &#x9;G_APELLIDO_DESTINA_GUIA&#xA;,G.TELEFONO_REMITE_GUIA&#x9;   AS  &#x9;G_TELEFONO_REMITE_GUIA&#xA;,G.TELEFONO_DESTINA_GUIA&#x9;   AS  &#x9;G_TELEFONO_DESTINA_GUIA&#xA;,G.DIRECCION_REMITE_GUIA&#x9;   AS  &#x9;G_DIRECCION_REMITE_GUIA&#xA;,G.DIRECCION_DESTINA_GUIA&#x9;   AS  &#x9;G_DIRECCION_DESTINA_GUIA&#xA;,G.CONTENIDO&#x9;   AS  &#x9;G_CONTENIDO&#xA;,G.LARGO_ENVIO&#x9;   AS  &#x9;G_LARGO_ENVIO&#xA;,G.ALTO_ENVIO&#x9;   AS  &#x9;G_ALTO_ENVIO&#xA;,G.ANCHO_ENVIO&#x9;   AS  &#x9;G_ANCHO_ENVIO&#xA;,G.LARGO_ENV_OPERA&#x9;   AS  &#x9;G_LARGO_ENV_OPERA&#xA;,G.ALTO_ENV_OPERA&#x9;   AS  &#x9;G_ALTO_ENV_OPERA&#xA;,G.ANCHO_ENV_OPERA&#x9;   AS  &#x9;G_ANCHO_ENV_OPERA&#xA;,G.PESO_GUIA&#x9;   AS  &#x9;G_PESO_GUIA&#xA;,G.PESO_FISICO_GUIA&#x9;   AS  &#x9;G_PESO_FISICO_GUIA&#xA;,G.PESO_VOLU_GUIA&#x9;   AS  &#x9;G_PESO_VOLU_GUIA&#xA;,G.PESO_FISICO_OPERA&#x9;   AS  &#x9;G_PESO_FISICO_OPERA&#xA;,G.PESO_VOLU_OPERA&#x9;   AS  &#x9;G_PESO_VOLU_OPERA&#xA;,G.PESO_FACTURADO&#x9;   AS  &#x9;G_PESO_FACTURADO&#xA;,G.FECHA_ENTREGA&#x9;   AS  &#x9;G_FECHA_ENTREGA&#xA;,G.NUMERO_PIEZAS&#x9;   AS  &#x9;G_NUMERO_PIEZAS&#xA;,G.VALOR_DECLARADO_GUIA&#x9;   AS  &#x9;G_VALOR_DECLARADO_GUIA&#xA;,G.VALOR_SEG_MAN_GUIAS&#x9;   AS  &#x9;G_VALOR_SEG_MAN_GUIAS&#xA;,G.VALOR_FLETES_GUIAS&#x9;   AS  &#x9;G_VALOR_FLETES_GUIAS&#xA;,G.VALOR_DESCUENTO_GUIAS&#x9;   AS  &#x9;G_VALOR_DESCUENTO_GUIAS&#xA;,G.VALOR_PEDIDO_GUIAS&#x9;   AS  &#x9;G_VALOR_PEDIDO_GUIAS&#xA;,G.VALOR_SEG_MAN_GUIAS_FACT&#x9;   AS  &#x9;G_VALOR_SEG_MAN_GUIAS_FACT&#xA;,G.VALOR_FLETES_GUIAS_FACT&#x9;   AS  &#x9;G_VALOR_FLETES_GUIAS_FACT&#xA;,G.FECHA_CREACION&#x9;   AS  &#x9;G_FECHA_CREACION&#xA;,G.FECHA_MODIFICACION_DG&#x9;   AS  &#x9;G_FECHA_MODIFICACION_DG&#xA;,SEG.ID_PROCESO&#x9;   AS  &#x9;SEG_ID_PROCESO&#xA;,SEG.NUMERO_MOVIMI&#x9;   AS  &#x9;SEG_NUMERO_MOVIMI&#xA;,SEG.CONSECUT_MOVIMI&#x9;   AS  &#x9;SEG_CONSECUT_MOVIMI&#xA;,SEG.ID_CONCEPTO&#x9;   AS  &#x9;SEG_ID_CONCEPTO&#xA;,SEG.ID_TIPOENVIO&#x9;   AS  &#x9;SEG_ID_TIPOENVIO&#xA;,SEG.ID_ENVIO_CRUZADO&#x9;   AS  &#x9;SEG_ID_ENVIO_CRUZADO&#xA;,SEG.PESO_ENVIO&#x9;   AS  &#x9;SEG_PESO_ENVIO&#xA;,SEG.LARGO_ENVIO&#x9;   AS  &#x9;SEG_LARGO_ENVIO&#xA;,SEG.ANCHO_ENVIO&#x9;   AS  &#x9;SEG_ANCHO_ENVIO&#xA;,SEG.ALTO_ENVIO&#x9;   AS  &#x9;SEG_ALTO_ENVIO&#xA;,SEG.FECHA_HORA_MOVIMIENTO&#x9;   AS  &#x9;SEG_FECHA_HORA_MOVIMIENTO&#xA;,SEG.NUMERO_PIEZAS&#x9;   AS  &#x9;SEG_NUMERO_PIEZAS&#xA;,SEG.FECHA_CREACION&#x9;   AS  &#x9;SEG_FECHA_CREACION&#xA;,SEG.FECHA_MODIFICACION&#x9;   AS  &#x9;SEG_FECHA_MODIFICACION&#xA;,SEG.FECHA_EXTRACCION&#x9;   AS  &#x9;SEG_FECHA_EXTRACCION&#xA;,DOC.ID_TIPO_ZONA_URBA&#x9;   AS  &#x9;DOC_ID_TIPO_ZONA_URBA&#xA;,DOC.ID_PAIS_ZONA_URBA&#x9;   AS  &#x9;DOC_ID_PAIS_ZONA_URBA&#xA;,DOC.ID_CIUDAD_ZONA_URBA&#x9;   AS  &#x9;DOC_ID_CIUDAD_ZONA_URBA&#xA;,DOC.ID_ZONA_URBA&#x9;   AS  &#x9;DOC_ID_ZONA_URBA&#xA;,DOC.ID_PAIS_DIVISION_ORIGEN&#x9;   AS  &#x9;DOC_ID_PAIS_DIVISION_ORIGEN&#xA;,DOC.ID_CIUDAD_DIVISION_ORIGEN&#x9;   AS  &#x9;DOC_ID_CIUDAD_DIVISION_ORIGEN&#xA;,DOC.ID_DIVISION_ORIGEN&#x9;   AS  &#x9;DOC_ID_DIVISION_ORIGEN&#xA;,DOC.ID_PAIS_DESTINO&#x9;   AS  &#x9;DOC_ID_PAIS_DESTINO&#xA;,DOC.ID_CIUDAD_DESTINO&#x9;   AS  &#x9;DOC_ID_CIUDAD_DESTINO&#xA;,DOC.ID_DIVISION_DESTINO&#x9;   AS  &#x9;DOC_ID_DIVISION_DESTINO&#xA;,DOC.ID_COURIER_CONDUCTOR&#x9;   AS  &#x9;DOC_ID_COURIER_CONDUCTOR&#xA;,DOC.ID_PAIS_OPERATIVO&#x9;   AS  &#x9;DOC_ID_PAIS_OPERATIVO&#xA;,DOC.ID_CIUDAD_OPERATIVO&#x9;   AS  &#x9;DOC_ID_CIUDAD_OPERATIVO&#xA;,DOC.ID_OPERATIVO&#x9;   AS  &#x9;DOC_ID_OPERATIVO&#xA;,DOC.ID_RUTA&#x9;   AS  &#x9;DOC_ID_RUTA&#xA;,DOC.ID_PAIS_CANAL&#x9;   AS  &#x9;DOC_ID_PAIS_CANAL&#xA;,DOC.ID_CIUDAD_CANAL&#x9;   AS  &#x9;DOC_ID_CIUDAD_CANAL&#xA;,DOC.ID_CANAL&#x9;   AS  &#x9;DOC_ID_CANAL&#xA;,DOC.ID_TIPO_LOGISTICA&#x9;   AS  &#x9;DOC_ID_TIPO_LOGISTICA&#xA;,DOC.FECHA_HORA_MOVIMI&#x9;   AS  &#x9;DOC_FECHA_HORA_MOVIMI&#xA;,DOC.TOTAL_ENVIOS&#x9;   AS  &#x9;DOC_TOTAL_ENVIOS&#xA;,DOC.PESO_TOTAL&#x9;   AS  &#x9;DOC_PESO_TOTAL&#xA;,DOC.PLACA_VEHICULO_DOCU&#x9;   AS  &#x9;DOC_PLACA_VEHICULO_DOCU&#xA;,DOC.ESTADO_MOVIMI&#x9;   AS  &#x9;DOC_ESTADO_MOVIMI&#xA;,DOC.NUME_SELLO_SEGURIDAD&#x9;   AS  &#x9;DOC_NUME_SELLO_SEGURIDAD&#xA;,DOC.ID_TIPO_MOVIMIENTO&#x9;   AS  &#x9;DOC_ID_TIPO_MOVIMIENTO&#xA;,DOC.ID_ESTADO_TRANS_ZONA&#x9;   AS  &#x9;DOC_ID_ESTADO_TRANS_ZONA&#xA;,DOC.ID_AUXILIAR2_VEHICULO&#x9;   AS  &#x9;DOC_ID_AUXILIAR2_VEHICULO&#xA;,DOC.FECHA_CREACION&#x9;   AS  &#x9;DOC_FECHA_CREACION&#xA;,DOC.FECHA_MODIFICACION&#x9;   AS  &#x9;DOC_FECHA_MODIFICACION&#xA;FROM [TMP].[MPCCO_VJ_GUIAS] G WITH(NOLOCK)&#xA;INNER JOIN [TMP].[MPCCO_VJ_SEGUIMIENTO_ENV] SEG WITH(NOLOCK) &#xA;ON SEG.NUMERO_GUIA=G.NUMERO_GUIA&#xA;INNER JOIN [TMP].[MPCCO_VJ_DOCUMENTOS] DOC WITH(NOLOCK) &#xA;ON DOC.ID_PROCESO=SEG.ID_PROCESO&#xA;AND DOC.NUMERO_MOVIMI=SEG.NUMERO_MOVIMI&#xA;AND DOC.CONSECUT_MOVIMI=SEG.CONSECUT_MOVIMI&#xA;WHERE SEG.ID_PROCESO &gt;=5&#xA;)&#xA;INSERT INTO [TMP].[MPCCO_VJ_ULTIMO_PROCESO_LOG]&#xA;(&#xA; ROW_ID&#xA;,G_NUMERO_GUIA&#xA;,G_ID_TIPOGUIA&#xA;,G_ID_CLIENTE&#xA;,G_ID_CANAL&#xA;,G_ID_DIVISION_PROV&#xA;,G_ID_PAIS_ORIGEN&#xA;,G_ID_CIUDAD_ORIGEN&#xA;,G_ID_PAIS_DESTINO&#xA;,G_ID_CIUDAD_DESTINO&#xA;,G_ID_TIPO_ZONA_URBA&#xA;,G_ID_PAIS_ZONA_URB_ENTR&#xA;,G_ID_CIUDAD_ZONA_URB_ENTR&#xA;,G_ID_ZONA_URBA&#xA;,G_ID_ESTADOENVIO&#xA;,G_ID_ESTADOGUIA&#xA;,G_ID_CARACT_ENVIO&#xA;,G_ID_TIEMPO&#xA;,G_ID_MEDTRANS&#xA;,G_ID_PRODUCTO&#xA;,G_ID_SUBPRODUCTO&#xA;,G_FECHA_ENVIO&#xA;,G_ID_REMITE&#xA;,G_ID_DESTINA&#xA;,G_NOMBRE_REMITE_GUIA&#xA;,G_APELLIDO_REMITE_GUIA&#xA;,G_NOMBRE_DESTINA_GUIA&#xA;,G_APELLIDO_DESTINA_GUIA&#xA;,G_TELEFONO_REMITE_GUIA&#xA;,G_TELEFONO_DESTINA_GUIA&#xA;,G_DIRECCION_REMITE_GUIA&#xA;,G_DIRECCION_DESTINA_GUIA&#xA;,G_CONTENIDO&#xA;,G_LARGO_ENVIO&#xA;,G_ALTO_ENVIO&#xA;,G_ANCHO_ENVIO&#xA;,G_LARGO_ENV_OPERA&#xA;,G_ALTO_ENV_OPERA&#xA;,G_ANCHO_ENV_OPERA&#xA;,G_PESO_GUIA&#xA;,G_PESO_FISICO_GUIA&#xA;,G_PESO_VOLU_GUIA&#xA;,G_PESO_FISICO_OPERA&#xA;,G_PESO_VOLU_OPERA&#xA;,G_PESO_FACTURADO&#xA;,G_FECHA_ENTREGA&#xA;,G_NUMERO_PIEZAS&#xA;,G_VALOR_DECLARADO_GUIA&#xA;,G_VALOR_SEG_MAN_GUIAS&#xA;,G_VALOR_FLETES_GUIAS&#xA;,G_VALOR_DESCUENTO_GUIAS&#xA;,G_VALOR_PEDIDO_GUIAS&#xA;,G_VALOR_SEG_MAN_GUIAS_FACT&#xA;,G_VALOR_FLETES_GUIAS_FACT&#xA;,G_FECHA_CREACION&#xA;,G_FECHA_MODIFICACION_DG&#xA;,SEG_ID_PROCESO&#xA;,SEG_NUMERO_MOVIMI&#xA;,SEG_CONSECUT_MOVIMI&#xA;,SEG_ID_CONCEPTO&#xA;,SEG_ID_TIPOENVIO&#xA;,SEG_ID_ENVIO_CRUZADO&#xA;,SEG_PESO_ENVIO&#xA;,SEG_LARGO_ENVIO&#xA;,SEG_ANCHO_ENVIO&#xA;,SEG_ALTO_ENVIO&#xA;,SEG_FECHA_HORA_MOVIMIENTO&#xA;,SEG_NUMERO_PIEZAS&#xA;,SEG_FECHA_CREACION&#xA;,SEG_FECHA_MODIFICACION&#xA;,SEG_FECHA_EXTRACCION&#xA;,DOC_ID_TIPO_ZONA_URBA&#xA;,DOC_ID_PAIS_ZONA_URBA&#xA;,DOC_ID_CIUDAD_ZONA_URBA&#xA;,DOC_ID_ZONA_URBA&#xA;,DOC_ID_PAIS_DIVISION_ORIGEN&#xA;,DOC_ID_CIUDAD_DIVISION_ORIGEN&#xA;,DOC_ID_DIVISION_ORIGEN&#xA;,DOC_ID_PAIS_DESTINO&#xA;,DOC_ID_CIUDAD_DESTINO&#xA;,DOC_ID_DIVISION_DESTINO&#xA;,DOC_ID_COURIER_CONDUCTOR&#xA;,DOC_ID_PAIS_OPERATIVO&#xA;,DOC_ID_CIUDAD_OPERATIVO&#xA;,DOC_ID_OPERATIVO&#xA;,DOC_ID_RUTA&#xA;,DOC_ID_PAIS_CANAL&#xA;,DOC_ID_CIUDAD_CANAL&#xA;,DOC_ID_CANAL&#xA;,DOC_ID_TIPO_LOGISTICA&#xA;,DOC_FECHA_HORA_MOVIMI&#xA;,DOC_TOTAL_ENVIOS&#xA;,DOC_PESO_TOTAL&#xA;,DOC_PLACA_VEHICULO_DOCU&#xA;,DOC_ESTADO_MOVIMI&#xA;,DOC_NUME_SELLO_SEGURIDAD&#xA;,DOC_ID_TIPO_MOVIMIENTO&#xA;,DOC_ID_ESTADO_TRANS_ZONA&#xA;,DOC_ID_AUXILIAR2_VEHICULO&#xA;,DOC_FECHA_CREACION&#xA;,DOC_FECHA_MODIFICACION&#xA;)&#xA;SELECT &#xA; ROW_ID&#xA;,G_NUMERO_GUIA&#xA;,G_ID_TIPOGUIA&#xA;,G_ID_CLIENTE&#xA;,G_ID_CANAL&#xA;,G_ID_DIVISION_PROV&#xA;,G_ID_PAIS_ORIGEN&#xA;,G_ID_CIUDAD_ORIGEN&#xA;,G_ID_PAIS_DESTINO&#xA;,G_ID_CIUDAD_DESTINO&#xA;,G_ID_TIPO_ZONA_URBA&#xA;,G_ID_PAIS_ZONA_URB_ENTR&#xA;,G_ID_CIUDAD_ZONA_URB_ENTR&#xA;,G_ID_ZONA_URBA&#xA;,G_ID_ESTADOENVIO&#xA;,G_ID_ESTADOGUIA&#xA;,G_ID_CARACT_ENVIO&#xA;,G_ID_TIEMPO&#xA;,G_ID_MEDTRANS&#xA;,G_ID_PRODUCTO&#xA;,G_ID_SUBPRODUCTO&#xA;,G_FECHA_ENVIO&#xA;,G_ID_REMITE&#xA;,G_ID_DESTINA&#xA;,G_NOMBRE_REMITE_GUIA&#xA;,G_APELLIDO_REMITE_GUIA&#xA;,G_NOMBRE_DESTINA_GUIA&#xA;,G_APELLIDO_DESTINA_GUIA&#xA;,G_TELEFONO_REMITE_GUIA&#xA;,G_TELEFONO_DESTINA_GUIA&#xA;,G_DIRECCION_REMITE_GUIA&#xA;,G_DIRECCION_DESTINA_GUIA&#xA;,G_CONTENIDO&#xA;,G_LARGO_ENVIO&#xA;,G_ALTO_ENVIO&#xA;,G_ANCHO_ENVIO&#xA;,G_LARGO_ENV_OPERA&#xA;,G_ALTO_ENV_OPERA&#xA;,G_ANCHO_ENV_OPERA&#xA;,G_PESO_GUIA&#xA;,G_PESO_FISICO_GUIA&#xA;,G_PESO_VOLU_GUIA&#xA;,G_PESO_FISICO_OPERA&#xA;,G_PESO_VOLU_OPERA&#xA;,G_PESO_FACTURADO&#xA;,G_FECHA_ENTREGA&#xA;,G_NUMERO_PIEZAS&#xA;,G_VALOR_DECLARADO_GUIA&#xA;,G_VALOR_SEG_MAN_GUIAS&#xA;,G_VALOR_FLETES_GUIAS&#xA;,G_VALOR_DESCUENTO_GUIAS&#xA;,G_VALOR_PEDIDO_GUIAS&#xA;,G_VALOR_SEG_MAN_GUIAS_FACT&#xA;,G_VALOR_FLETES_GUIAS_FACT&#xA;,G_FECHA_CREACION&#xA;,G_FECHA_MODIFICACION_DG&#xA;,SEG_ID_PROCESO&#xA;,SEG_NUMERO_MOVIMI&#xA;,SEG_CONSECUT_MOVIMI&#xA;,SEG_ID_CONCEPTO&#xA;,SEG_ID_TIPOENVIO&#xA;,SEG_ID_ENVIO_CRUZADO&#xA;,SEG_PESO_ENVIO&#xA;,SEG_LARGO_ENVIO&#xA;,SEG_ANCHO_ENVIO&#xA;,SEG_ALTO_ENVIO&#xA;,SEG_FECHA_HORA_MOVIMIENTO&#xA;,SEG_NUMERO_PIEZAS&#xA;,SEG_FECHA_CREACION&#xA;,SEG_FECHA_MODIFICACION&#xA;,SEG_FECHA_EXTRACCION&#xA;,DOC_ID_TIPO_ZONA_URBA&#xA;,DOC_ID_PAIS_ZONA_URBA&#xA;,DOC_ID_CIUDAD_ZONA_URBA&#xA;,DOC_ID_ZONA_URBA&#xA;,DOC_ID_PAIS_DIVISION_ORIGEN&#xA;,DOC_ID_CIUDAD_DIVISION_ORIGEN&#xA;,DOC_ID_DIVISION_ORIGEN&#xA;,DOC_ID_PAIS_DESTINO&#xA;,DOC_ID_CIUDAD_DESTINO&#xA;,DOC_ID_DIVISION_DESTINO&#xA;,DOC_ID_COURIER_CONDUCTOR&#xA;,DOC_ID_PAIS_OPERATIVO&#xA;,DOC_ID_CIUDAD_OPERATIVO&#xA;,DOC_ID_OPERATIVO&#xA;,DOC_ID_RUTA&#xA;,DOC_ID_PAIS_CANAL&#xA;,DOC_ID_CIUDAD_CANAL&#xA;,DOC_ID_CANAL&#xA;,DOC_ID_TIPO_LOGISTICA&#xA;,DOC_FECHA_HORA_MOVIMI&#xA;,DOC_TOTAL_ENVIOS&#xA;,DOC_PESO_TOTAL&#xA;,DOC_PLACA_VEHICULO_DOCU&#xA;,DOC_ESTADO_MOVIMI&#xA;,DOC_NUME_SELLO_SEGURIDAD&#xA;,DOC_ID_TIPO_MOVIMIENTO&#xA;,DOC_ID_ESTADO_TRANS_ZONA&#xA;,DOC_ID_AUXILIAR2_VEHICULO&#xA;,DOC_FECHA_CREACION&#xA;,DOC_FECHA_MODIFICACION&#xA;FROM CTE &#xA;WHERE ROW_ID=1&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
