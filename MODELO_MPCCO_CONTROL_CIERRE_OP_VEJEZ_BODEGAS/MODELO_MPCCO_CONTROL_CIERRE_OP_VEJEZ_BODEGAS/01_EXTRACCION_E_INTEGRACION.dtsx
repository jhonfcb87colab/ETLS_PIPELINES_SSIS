          DTS:TaskContact="Performs high-performance data extraction, transformation and loading;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1">
          <DTS:Variables />
          <DTS:ObjectData>
            <pipeline
              version="1">
              <components>
                <component
                  refId="Package\PROCESOS LOG\LOGISTICA RECAUDO\GUIAS RECAUDO"
                  componentClassID="Microsoft.OLEDBSource"
                  contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                  description="OLE DB Source"
                  name="GUIAS RECAUDO"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">USE tmp_borrar_local;
Select CPR.NUMERO_GUIA, 
CASE WHEN GIA.ID_FORMAPAGO_GUIA!=2 THEN FP.NOMBRE_FORMAPAGO ELSE 'LPC' END AS FORMA_PAGO,
----CI.NOMBRE_CIUDAD,GIA.FECHA_ENVIO,E.NOMBRE_ESTADOENVIO,
CASE WHEN CPR.ES_COD_CORPORATIVO=0 THEN  
CASE WHEN ISNULL(CPR.VALOR_TOTAL,0) = 0 AND GIA.ID_FORMAPAGO_GUIA=4 THEN GIA.VALOR_SEG_MAN_GUIAS + GIA.VALOR_FLETES_GUIAS ELSE isnull(CPR.VALOR_TOTAL,0) END
ELSE ISNULL(CPR.VALOR_PRODUCTO,0) END AS VALOR_A_RECAUDAR
,ISNULL(CPR.VALOR_RECAUDADO,0) AS VALOR_RECAUDADO,ISNULL(CPR.NUMERO_ORDEN_SERVICIO, '') AS NUMERO_ORDEN_SERVICIO
,CASE WHEN CPR.ESTA_RECAUDADO=0 THEN 'SIN RECAUDO' ELSE 'CON RECAUDO' END ESTA_RECAUDADO
--,CPR.estado_cod
--,CPR.*
FROM [Mece_Logistico].[dbo].[COD_PENDIENTE_POR_RECAUDO] CPR (nolock)
INNER JOIN [dbo].[MPCCO_LOG_GUIAS] G (nolock) on G.NUMERO_GUIA=CPR.NUMERO_GUIA 
left JOIN [Mece_Logistico].[dbo].[GUIAS_INF_ANTICIPADA] GIA (nolock) on GIA.NUMERO_GUIA=CPR.NUMERO_GUIA 
left join PARAMETROS.DBO.FORMAPAGO FP (NOLOCK) ON FP.ID_PAIS=1 AND FP.ID_FORMAPAGO=GIA.ID_FORMAPAGO_GUIA
left join PARAMETROS.DBO.CIUDADES CI (NOLOCK) ON CI.ID_PAIS=1 AND CI.ID_CIUDAD=CPR.ID_CIUDAD AND ID_REGIONAL=8 --DEPARTAMENTO 15-- REGIONAL 8 BOYACA</property>
