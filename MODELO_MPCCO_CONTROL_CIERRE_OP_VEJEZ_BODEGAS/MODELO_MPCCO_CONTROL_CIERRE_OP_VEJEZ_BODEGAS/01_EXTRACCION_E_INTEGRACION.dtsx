                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT TMP.[NUMERO_GUIA]
      ,PE.[FECHA_DIGITALIZACION]
      ,PE.[PATH_IMAGEN]
      ,PE.[ID_CIUDAD]
      ,PE.[TIPO_PRUEBA_ENTREGA]
      ,PE.[GENERACION_PE]
      ,PE.[FECHA_CREACION]
      ,PE.[FECHA_EXTRACCION]
  FROM [tmp_borrar_local].[dbo].[PRUEBAS_ENTREGA_BI] PE WITH(NOLOCK)
  INNER JOIN [dbo].[MPCCO_LOG_GUIAS] TMP WITH(NOLOCK)
  ON TMP.NUMERO_GUIA=PE.NUMERO_GUIA</property>
