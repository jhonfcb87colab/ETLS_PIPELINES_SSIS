            <DTS:Executable
              DTS:refId="Package\CARGAR DIMENSIONES\DIMENSIONES\Generacion de Festivos y dominicales"
              DTS:CreationName="Microsoft.ExecuteSQLTask"
              DTS:Description="Execute SQL Task"
              DTS:DTSID="{2BDF9532-B268-4304-A860-1113E749680E}"
              DTS:ExecutableType="Microsoft.ExecuteSQLTask"
              DTS:LocaleID="-1"
              DTS:ObjectName="Generacion de Festivos y dominicales"
              DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
              DTS:ThreadHint="1">
              <DTS:Variables />
              <DTS:ObjectData>
                <SQLTask:SqlTaskData
                  SQLTask:Connection="{9270DAF5-1074-4D39-8815-87044D378AC9}"
                  SQLTask:SqlStatementSource="USE SIG_COLOMBIA_DW;&#xA;DECLARE @FechaInicio datetime&#xA;DECLARE @FechaFin datetime&#xA;SET @FechaInicio =  DATEADD(yy,-5,DATEADD(yy,DATEDIFF(yy,0,GETDATE()),0));&#xA;SET @FechaFin = CONVERT(DATETIME,CONVERT(DATE,CONVERT(DATETIME,GETDATE()))) ---------------DATEADD(ms,-3,DATEADD(yy,0,DATEADD(yy,DATEDIFF(yy,0,GETDATE())+1,0)));&#xA;DECLARE @FechaCiclo datetime&#xA;SET @FechaCiclo = @FechaInicio&#xA;&#xA;&#xA;&#xA;-----------------------------------------------------------------------------------------------------------------------------------------------------------&#xA;----------------CALENDARIO CONTEO  FESTIVOS-------------------------------------------------------------------------------------------------------------------------&#xA;-----------------------------------------------------------------------------------------------------------------------------------------------------------&#xA; &#xA; &#xA;IF object_id('tempdb..[#MPCCO_LOCAL_TABLEVARIABLE_CALENDARIO]') &lt; 0 &#xA;  BEGIN&#xA;    DROP TABLE [#MPCCO_LOCAL_TABLEVARIABLE_CALENDARIO]&#xA;  END&#xA; &#xA;CREATE TABLE #MPCCO_LOCAL_TABLEVARIABLE_CALENDARIO&#xA;(&#xA;&#x9;[TIME_ID] [int] NOT NULL,&#xA;&#x9;[DATE] [datetime] NULL,&#xA;&#x9;[DAY] [varchar](10) NULL,&#xA;&#x9;[DIAS_FESTIVOS_DOMINICALES_TO_HOY] [int] NULL,&#xA;&#x9;[DIAS_HABILES_TO_HOY] [int] NULL,&#xA;);&#xA; &#xA;WHILE @FechaCiclo &lt;= @FechaFin&#xA;BEGIN &#xA;----PRINT(@FechaCiclo)&#xA;INSERT INTO #MPCCO_LOCAL_TABLEVARIABLE_CALENDARIO VALUES&#xA;(&#xA;CONVERT(int,CONVERT(DATETIME,@FechaCiclo)),&#xA;CONVERT(DATETIME,@FechaCiclo),&#xA;CASE&#xA;&#x9;&#x9;WHEN DATEPART(dw,@FechaCiclo )=1 THEN 'Domingo'&#xA;&#x9;&#x9;WHEN DATEPART(dw,@FechaCiclo )=2 THEN 'Lunes'&#xA;&#x9;&#x9;WHEN DATEPART(dw,@FechaCiclo )=3 THEN 'Martes'&#xA;&#x9;&#x9;WHEN DATEPART(dw,@FechaCiclo )=4 THEN 'Miercoles'&#xA;&#x9;&#x9;WHEN DATEPART(dw,@FechaCiclo )=5 THEN 'Jueves'&#xA;&#x9;&#x9;WHEN DATEPART(dw,@FechaCiclo )=6 THEN 'Viernes'&#xA;&#x9;&#x9;WHEN DATEPART(dw,@FechaCiclo )=7 THEN 'Sabado'&#xA;&#x9;&#x9;ELSE NULL &#xA;&#x9;END,&#xA;&#x9;1,&#xA;&#x9;1&#xA;)&#xA;SET @FechaCiclo = DATEADD(DAY, 1, @FechaCiclo);&#xA;END;&#xA;&#xA;TRUNCATE TABLE [SIG_COLOMBIA_DW].[TMP].[MPCCO_VJ_FESTIVOS_DOMINICALES_HABILES];&#xA;&#xA;INSERT INTO [SIG_COLOMBIA_DW].[TMP].[MPCCO_VJ_FESTIVOS_DOMINICALES_HABILES] &#xA;SELECT &#xA;[TIME_ID]&#x9;&#xA;,[DATE]&#xA;,[HOY] = CONVERT(DATETIME,CONVERT(DATE,CONVERT(DATETIME,GETDATE())))&#xA;,[DAY]&#x9;&#xA;,[DIAS_FESTIVOS_DOMINICALES_TO_HOY]&#x9;= SIG_COLOMBIA_DW.LOG.UFN_COUNT_DAYS_RANGE([DATE],convert(datetime,convert(date,GETDATE())),'DIA HABIL')&#xA;,[DIAS_HABILES_TO_HOY]= [LOG].[MPCCO_UFN_COUNT_DAYS_RANGE]([DATE],convert(datetime,convert(date,GETDATE())),'DIA DOMINICAL,DIA FESTIVO')&#x9;&#xA;,[GENERAL_DIAS] = DATEDIFF(DAY,[DATE],CONVERT(DATETIME,CONVERT(DATE,GETDATE()+1)))  --DATEIFF([DATE]&#xA;------INTO [SIG_COLOMBIA_DW].[TMP].[MPCCO_VJ_FESTIVOS_DOMINICALES_HABILES] &#xA;FROM #MPCCO_LOCAL_TABLEVARIABLE_CALENDARIO&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
              </DTS:ObjectData>
            </DTS:Executable>
            <DTS:Executable
              DTS:refId="Package\CARGAR DIMENSIONES\DIMENSIONES\RED OPERATIVA"
              DTS:CreationName="Microsoft.Pipeline"
              DTS:Description="Data Flow Task"
              DTS:DTSID="{12EE50AE-13FF-43B7-BEE4-E0C9CCB439F1}"
              DTS:ExecutableType="Microsoft.Pipeline"
              DTS:LocaleID="-1"
              DTS:ObjectName="RED OPERATIVA"
              DTS:TaskContact="Performs high-performance data extraction, transformation and loading;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1">
              <DTS:Variables />
              <DTS:ObjectData>
                <pipeline
                  version="1">
                  <components>
                    <component
                      refId="Package\CARGAR DIMENSIONES\DIMENSIONES\RED OPERATIVA\EXTRACCION RED OPERATIVA RUTAS"
                      componentClassID="Microsoft.OLEDBSource"
                      contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                      description="OLE DB Source"
                      name="EXTRACCION RED OPERATIVA RUTAS"
                      usesDispositions="true"
                      version="7">
                      <properties>
                        <property
                          dataType="System.Int32"
                          description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                          name="CommandTimeout">0</property>
                        <property
                          dataType="System.String"
                          description="Specifies the name of the database object used to open a rowset."
                          name="OpenRowset"></property>
                        <property
                          dataType="System.String"
                          description="Specifies the variable that contains the name of the database object used to open a rowset."
                          name="OpenRowsetVariable"></property>
                        <property
                          dataType="System.String"
                          description="The SQL command to be executed."
                          name="SqlCommand"
                          UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">;WITH CIUDADES_MOVIMIENTOS_MOVILIZADOS AS (
SELECT 
CD.ID_CIUDAD,
CD.NOMBRE_CIUDAD,
RG.ID_REGIONAL,
RG.NOMBRE_REGIONAL
FROM PARAMETROS.DBO.CIUDADES CD WITH(NOLOCK)
INNER JOIN PARAMETROS.DBO.REGIONALES_PAIS RG WITH(NOLOCK)
ON RG.ID_REGIONAL=CD.ID_REGIONAL
WHERE CD.ID_PAIS=1
)
SELECT 
	 R.ID_RUTA
	,GEO.NOMBRE_REGIONAL REGIONAL_ORIGEN
	,GEO.NOMBRE_CIUDAD CIUDAD_ORIGEN
	,R.ID_CIUDAD_ORIGEN
	,GED.NOMBRE_REGIONAL REGIONAL_DESTINO
	,GED.NOMBRE_CIUDAD CIUDAD_DESTINO
	,R.ID_CIUDAD_DESTINO
	,TE.NOMBRE_TIEMPO
	,R.ID_TIEMPO
	,MT.NOMBRE_MEDTRANS
	,R.ID_MEDTRANS
	,IM.NOMBRE_IMPEDANCIA
	,R.ID_IMPEDANCIA
	,FC.NOMBRE_FILTRO
	,R.ID_FILTRO_CRITICIDAD
	,R.VALOR_FILTRO_CRITICIDAD
	,R.VALOR_FILTRO_MODO_TRANSPORTE
	,R.TOTAL_TIEMPO_OPERATIVO
	,R.TOTAL_TIEMPO_OPERATIVO_REF
	,R.TOTAL_DISTANCIA
	,R.TOTAL_COSTO
	,R.TOTAL_ID_CRITICIDAD
	,R.TOTAL_ID_PESOCATEG
	,R.LOGIN_EMPLEADO_MODIFICACION
	,R.FECHA_MODIFICACION
	,R.ID_ESTADO_RUTA
	,R.ID_RUTA_NET
	,R.TOTAL_TIEMPO_OPERATIVO_REF_CALCULO
	,R.TOTAL_DISTANCIA_CALCULO
	-- REGLA DEL NEGOCIO TOMADA DE RDO_FUN_TIEMPO_ENTREGA_COMERCIAL DE REDOPERATIVA
	,CASE WHEN
			R.ID_CIUDAD_ORIGEN = R.ID_CIUDAD_DESTINO
		THEN
			CASE WHEN R.ID_TIEMPO = 2 THEN 0 ELSE 24 END
		ELSE
			ISNULL(R.TOTAL_TIEMPO_OPERATIVO_REF/60,0)
		END [TIEMPO_ENTREGA_COMERCIAL_HOR]
	,CASE WHEN
			R.ID_CIUDAD_ORIGEN = R.ID_CIUDAD_DESTINO
		THEN
			CASE WHEN R.ID_TIEMPO = 2 THEN 0 ELSE 1 END
		ELSE
			ISNULL(R.TOTAL_TIEMPO_OPERATIVO_REF/1440,0)
		END [TIEMPO_ENTREGA_COMERCIAL_DIA]
	,R.LOGIN_MODIFICACION_MANUAL
--	,R.FECHA_EXTRACCION_DW
FROM 
	REDOPERATIVA.DBO.RUTA R WITH(NOLOCK)
LEFT JOIN
	CIUDADES_MOVIMIENTOS_MOVILIZADOS GEO
ON
	R.ID_CIUDAD_ORIGEN = GEO.ID_CIUDAD
LEFT JOIN
	CIUDADES_MOVIMIENTOS_MOVILIZADOS GED 
ON
	R.ID_CIUDAD_DESTINO = GED.ID_CIUDAD
LEFT JOIN
	PARAMETROS.DBO.TIEMPOSENTREGA TE WITH(NOLOCK)
ON
	R.ID_TIEMPO = TE.ID_TIEMPO
LEFT JOIN
	PARAMETROS.DBO.MEDIOTRANSPORTE MT WITH(NOLOCK)
ON
	R.ID_MEDTRANS = MT.ID_MEDTRANS
LEFT JOIN
	REDOPERATIVA.DBO.IMPEDANCIA IM WITH(NOLOCK)
ON
	R.ID_IMPEDANCIA = IM.ID_IMPEDANCIA
LEFT JOIN
	REDOPERATIVA.DBO.FILTROCRITICIDAD FC WITH(NOLOCK)
ON
	R.ID_FILTRO_CRITICIDAD = FC.ID_FILTRO_CRITICIDAD
WHERE 
	(R.ID_PAIS_ORIGEN = 1 AND R.ID_PAIS_DESTINO = 1)</property>
