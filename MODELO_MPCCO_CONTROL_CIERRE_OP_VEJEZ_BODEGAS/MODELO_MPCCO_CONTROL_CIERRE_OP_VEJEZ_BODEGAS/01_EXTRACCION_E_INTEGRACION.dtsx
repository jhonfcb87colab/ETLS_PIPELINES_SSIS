      DTS:ObjectName="CARGAR DIMENSIONES">
      <DTS:Variables />
      <DTS:Executables>
        <DTS:Executable
          DTS:refId="Package\CARGAR DIMENSIONES\DIMENSIONES"
          DTS:CreationName="STOCK:SEQUENCE"
          DTS:Description="Sequence Container"
          DTS:DTSID="{655BFFF2-A05C-4B0A-B785-BAC52B866FC5}"
          DTS:ExecutableType="STOCK:SEQUENCE"
          DTS:LocaleID="-1"
          DTS:ObjectName="DIMENSIONES">
          <DTS:Variables />
          <DTS:Executables>
            <DTS:Executable
              DTS:refId="Package\CARGAR DIMENSIONES\DIMENSIONES\CONSTRUCCION CPL"
              DTS:CreationName="Microsoft.ExecuteSQLTask"
              DTS:Description="Execute SQL Task"
              DTS:DTSID="{928FEE40-E4BC-4E38-A4E9-C29DC8E303F3}"
              DTS:ExecutableType="Microsoft.ExecuteSQLTask"
              DTS:LocaleID="-1"
              DTS:ObjectName="CONSTRUCCION CPL"
              DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
              DTS:ThreadHint="2">
              <DTS:Variables />
              <DTS:ObjectData>
                <SQLTask:SqlTaskData
                  SQLTask:Connection="{5B2BDE35-0E5F-4DE2-A25A-19DB68B50268}"
                  SQLTask:SqlStatementSource="DROP TABLE IF EXISTS #TMP_CIUDADES_ANEXAS;&#xA;DROP TABLE IF EXISTS #TMP_CIUDADES_ANEXAS_CPL;&#xA;SELECT CAD.* &#xA;INTO #TMP_CIUDADES_ANEXAS &#xA;FROM PARAMETROS.DBO.CIUDADES_ANEXAS CAD (NOLOCK) &#xA;WHERE CAD.ID_PAIS=1 AND CAD.RECOLECCION=1&#xA; &#xA;INSERT INTO #TMP_CIUDADES_ANEXAS&#xA;SELECT CAD.* FROM PARAMETROS.DBO.CIUDADES_ANEXAS CAD (NOLOCK) &#xA;LEFT JOIN #TMP_CIUDADES_ANEXAS TCAD ON TCAD.ID_CIUDAD_ANEXA=CAD.ID_CIUDAD_ANEXA&#xA;WHERE CAD.ID_PAIS=1 AND CAD.RECOLECCION=0 AND TCAD.ID_CIUDAD_ANEXA IS NULL&#xA; &#xA;DELETE T FROM (&#xA;SELECT *, DupRank = ROW_NUMBER() OVER (PARTITION BY ID_CIUDAD_ANEXA ORDER BY FECHA_CREACION DESC&#xA;) FROM #TMP_CIUDADES_ANEXAS) AS T&#xA;WHERE DupRank &gt; 1&#xA;&#xA;----truncate table [TMP].[KPI_TIEMPOS_ENTREGA_13]&#xA;&#xA;SELECT &#xA;T01.ID_CIUDAD_ANEXA AS  ID_CIUDAD_ANEXA&#xA;,CD_ANX.NOMBRE_CIUDAD AS NOMBRE_CIUDAD_ANEXA&#xA;,RG_ANX.ID_REGIONAL AS ID_REGIONAL_ANEXA&#xA;,RG_ANX.NOMBRE_REGIONAL AS NOMBRE_REGIONAL_ANEXA&#xA;,T01.ID_CIUDAD AS ID_CIUDAD_CABECERA&#xA;,CD.NOMBRE_CIUDAD AS  NOMBRE_CIUDAD_CABECERA&#xA;,RG_PRIN.ID_REGIONAL AS ID_REGIONAL_PRINCIPAL&#xA;,RG_PRIN.NOMBRE_REGIONAL AS NOMBRE_REGIONAL_PRINCIPAL&#xA;,CPL = CONVERT(VARCHAR(50),'')&#xA;INTO #TMP_CIUDADES_ANEXAS_CPL&#xA;FROM #TMP_CIUDADES_ANEXAS T01&#xA;INNER JOIN PARAMETROS.DBO.CIUDADES CD_ANX WITH(NOLOCK)&#xA;ON CD_ANX.ID_CIUDAD=T01.ID_CIUDAD_ANEXA&#xA;AND CD_ANX.ID_PAIS=1&#xA;INNER JOIN PARAMETROS.DBO.REGIONALES_PAIS RG_ANX WITH(NOLOCK)&#xA;ON RG_ANX.ID_REGIONAL=CD_ANX.ID_REGIONAL&#xA;AND RG_ANX.ID_PAIS=1&#xA;INNER JOIN PARAMETROS.DBO.CIUDADES CD WITH(NOLOCK)&#xA;ON CD.ID_CIUDAD=T01.ID_CIUDAD&#xA;AND CD.ID_PAIS=1&#xA;INNER JOIN PARAMETROS.DBO.REGIONALES_PAIS RG_PRIN WITH(NOLOCK)&#xA;ON CD.ID_REGIONAL=RG_PRIN.ID_REGIONAL&#xA;&#xA;---where T01.ID_CIUDAD_ANEXA = 253--460&#xA;---CD.NOMBRE_CIUDAD like '%QUEREMAL%'&#xA;ORDER BY 1 ASC&#xA;&#xA;UPDATE CPL SET&#xA;CPL.CPL = CL.CENTRO_LOGISTICO &#xA;FROM  #TMP_CIUDADES_ANEXAS_CPL CPL &#xA;INNER JOIN PARAMETROS.DBO.CENTROS_LOGISTICOS CL WITH(NOLOCK)&#xA;ON CPL.ID_CIUDAD_CABECERA=CL.ID_CIUDAD_UBICACION_FISICA AND CL.ID_ESTADO=1&#xA;&#xA;UPDATE CPL SET&#xA;CPL.CPL = CL.CENTRO_LOGISTICO &#xA;FROM  #TMP_CIUDADES_ANEXAS_CPL CPL &#xA;INNER JOIN PARAMETROS.DBO.CENTROS_LOGISTICOS CL WITH(NOLOCK)&#xA;ON CPL.ID_CIUDAD_CABECERA=CL.ID_CIUDAD AND CL.ID_ESTADO=1&#xA;WHERE LEN(CPL)&lt;1&#xA;&#xA;&#xA;--select &#xA;--CPL = CL.CENTRO_LOGISTICO &#xA;--FROM  #TMP_CIUDADES_ANEXAS_CPL CPL &#xA;--INNER JOIN PARAMETROS.DBO.CENTROS_LOGISTICOS CL WITH(NOLOCK)&#xA;--ON CPL.ID_CIUDAD_CABECERA=CL.ID_CIUDAD AND CL.ID_ESTADO=1&#xA;--WHERE LEN(CPL)&lt;1&#xA;&#xA;&#xA;&#xA;--SELECT * FROM PARAMETROS.DBO.CENTROS_LOGISTICOS CL WITH(NOLOCK) WHERE ID_CIUDAD=15&#xA;&#xA;TRUNCATE TABLE [dbo].[MPCCO_PAR_CPL]&#xA;&#xA;;WITH CTE AS(&#xA;SELECT &#xA;ID_CIUDAD_ANEXA&#x9;&#xA;,NOMBRE_CIUDAD_ANEXA&#x9;&#xA;,ID_REGIONAL_ANEXA&#x9;&#xA;,NOMBRE_REGIONAL_ANEXA&#x9;&#xA;,ID_CIUDAD_CABECERA&#x9;&#xA;,NOMBRE_CIUDAD_CABECERA&#x9;&#xA;,ID_REGIONAL_PRINCIPAL&#x9;&#xA;,NOMBRE_REGIONAL_PRINCIPAL&#x9;&#xA;,CPL&#xA;FROM #TMP_CIUDADES_ANEXAS_CPL&#xA;UNION  ALL &#xA;SELECT &#xA;ID_CIUDAD_ANEXA=CD.ID_CIUDAD&#x9;&#xA;,NOMBRE_CIUDAD_ANEXA=CD.NOMBRE_CIUDAD&#x9;&#xA;,ID_REGIONAL_ANEXA=RG.ID_REGIONAL&#x9;&#xA;,NOMBRE_REGIONAL_ANEXA=RG.NOMBRE_REGIONAL&#xA;,ID_CIUDAD_CABECERA=NULL&#x9;&#xA;,NOMBRE_CIUDAD_CABECERA=NULL&#x9;&#xA;,ID_REGIONAL_PRINCIPAL=NULL&#x9;&#xA;,NOMBRE_REGIONAL_PRINCIPAL=NULL&#x9;&#xA;,CPL='ERROR - NO EXISTE EN PARAMETROS CENTRO LOGISTICO'&#xA;----INTO [dbo].[MPCCO_PAR_CPL]&#xA;FROM PARAMETROS.DBO.CIUDADES CD WITH(NOLOCK)&#xA;INNER JOIN PARAMETROS.DBO.REGIONALES_PAIS RG WITH(NOLOCK)&#xA;ON CD.ID_REGIONAL=RG.ID_REGIONAL&#xA;WHERE CD.ID_CIUDAD NOT IN(SELECT ID_CIUDAD_ANEXA FROM #TMP_CIUDADES_ANEXAS_CPL WITH(NOLOCK) GROUP BY ID_CIUDAD_ANEXA)&#xA;AND CD.ID_PAIS=1&#xA;AND RG.ID_PAIS=1&#xA;)&#xA;INSERT INTO tmp_borrar_local.[dbo].[MPCCO_PAR_CPL]&#xA;SELECT &#xA;ID_CIUDAD_ANEXA&#x9;&#xA;,NOMBRE_CIUDAD_ANEXA&#x9;&#xA;,ID_REGIONAL_ANEXA&#x9;&#xA;,NOMBRE_REGIONAL_ANEXA&#x9;&#xA;,ID_CIUDAD_CABECERA&#x9;&#xA;,NOMBRE_CIUDAD_CABECERA&#x9;&#xA;,ID_REGIONAL_PRINCIPAL&#x9;&#xA;,NOMBRE_REGIONAL_PRINCIPAL&#x9;&#xA;,CPL&#xA;FROM CTE ORDER BY 1 ASC&#xA;&#xA;&#xA;--SELECT * FROM [dbo].[MPCCO_PAR_CPL]&#xA;&#xA;&#xA;&#xA;DROP TABLE IF EXISTS #TMP_CIUDADES_ANEXAS;&#xA;DROP TABLE IF EXISTS #TMP_CIUDADES_ANEXAS_CPL;&#xA;&#xA;/*&#xA;SELECT ID_CIUDAD_ANEXA,COUNT(1) FROM [dbo].[MPCCO_PAR_CPL]&#xA;GROUP BY ID_CIUDAD_ANEXA&#xA;HAVING COUNT(1)&gt;1&#xA;&#xA;--SELECT ID_CIUDAD,COUNT(1) FROM PAR.CENTROS_LOGISTICOS CL WITH(NOLOCK)&#xA;--GROUP BY ID_CIUDAD&#xA;--ORDER BY 2&#xA;*/&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
              </DTS:ObjectData>
            </DTS:Executable>
            <DTS:Executable
              DTS:refId="Package\CARGAR DIMENSIONES\DIMENSIONES\CPL"
              DTS:CreationName="Microsoft.Pipeline"
              DTS:Description="Data Flow Task"
              DTS:DTSID="{CCB3E66B-42F0-4D22-81FE-DD3A99C47BD4}"
