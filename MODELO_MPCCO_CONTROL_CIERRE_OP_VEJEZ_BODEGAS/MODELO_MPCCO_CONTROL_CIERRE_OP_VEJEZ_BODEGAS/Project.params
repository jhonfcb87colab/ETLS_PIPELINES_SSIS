      <SSIS:Property
        SSIS:Name="DataType">18</SSIS:Property>
    </SSIS:Properties>
  </SSIS:Parameter>
  <SSIS:Parameter
    SSIS:Name="FULL_FACH_INI">
    <SSIS:Properties>
      <SSIS:Property
        SSIS:Name="ID">{db3fa528-e111-4ab0-9702-aea3e2824f6c}</SSIS:Property>
      <SSIS:Property
        SSIS:Name="CreationName"></SSIS:Property>
      <SSIS:Property
        SSIS:Name="Description"></SSIS:Property>
      <SSIS:Property
        SSIS:Name="IncludeInDebugDump">0</SSIS:Property>
      <SSIS:Property
        SSIS:Name="Required">0</SSIS:Property>
      <SSIS:Property
        SSIS:Name="Sensitive">0</SSIS:Property>
      <SSIS:Property
        SSIS:Name="Value">1900-01-01</SSIS:Property>
      <SSIS:Property
        SSIS:Name="DataType">18</SSIS:Property>
    </SSIS:Properties>
  </SSIS:Parameter>
  <SSIS:Parameter
    SSIS:Name="SCRIPT">
    <SSIS:Properties>
      <SSIS:Property
        SSIS:Name="ID">{80ebfdc1-fc15-46dc-8c39-8b53f68d067f}</SSIS:Property>
      <SSIS:Property
        SSIS:Name="CreationName"></SSIS:Property>
      <SSIS:Property
        SSIS:Name="Description"></SSIS:Property>
      <SSIS:Property
        SSIS:Name="IncludeInDebugDump">0</SSIS:Property>
      <SSIS:Property
        SSIS:Name="Required">0</SSIS:Property>
      <SSIS:Property
        SSIS:Name="Sensitive">0</SSIS:Property>
      <SSIS:Property
        SSIS:Name="Value">IF @HoraActual BETWEEN 5 AND 10     BEGIN SET @diasatr = 0; SET @INTERVALO_FE_INI = 3;  END  ELSE IF @HoraActual BETWEEN 10 AND 14 BEGIN SET @diasatr = 0; SET @INTERVALO_FE_INI = 6;  END  ELSE IF @HoraActual BETWEEN 14 AND 17 BEGIN SET @diasatr = 0; SET @INTERVALO_FE_INI = 9;  END  ELSE IF @HoraActual BETWEEN 18 AND 20 BEGIN SET @diasatr = 2; SET @INTERVALO_FE_INI = 12; END  ELSE IF @HoraActual BETWEEN 21 AND 24 BEGIN SET @diasatr = 3; SET @INTERVALO_FE_INI = 0;  END</SSIS:Property>
      <SSIS:Property
        SSIS:Name="DataType">18</SSIS:Property>
    </SSIS:Properties>
  </SSIS:Parameter>
</SSIS:Parameters>