          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="WITH CTE_GEOOGRAFIA&#xA;(&#xA;&#x9; G_NUMERO_GUIA&#xA;&#x9;,REGIONAL&#xA;&#x9;,CIUDAD&#xA;&#x9;,DEPARTAMENTO&#xA;)&#xA;AS&#xA;&#x9;(&#xA;&#x9;&#x9;SELECT&#xA;&#x9;&#x9;&#x9; TMP.G_NUMERO_GUIA &#xA;&#x9;&#x9;&#x9;,GEO.REGIONAL&#xA;&#x9;&#x9;&#x9;,GEO.CIUDAD&#xA;&#x9;&#x9;&#x9;,GEO.DEPARTAMENTO&#xA;&#x9;&#x9;FROM &#xA;&#x9;&#x9;&#x9;TMP.MBCORE_GUIAS TMP WITH (NOLOCK)&#xA;&#x9;&#x9;INNER JOIN  &#xA;&#x9;&#x9;&#x9;DIM.GEOGRAFIA GEO WITH (NOLOCK)&#xA;&#x9;&#x9;ON &#xA;&#x9;&#x9;&#x9;TMP.G_ID_CIUDAD_CANAL_DESTINO = GEO.ID_CIUDAD&#xA;&#x9;)&#xA;UPDATE &#xA;&#x9;TMP.MBCORE_GUIAS&#xA;SET&#xA;&#x9; G_CIUDAD_CANAL_DESTINO = ISNULL(CTE.CIUDAD,'NO DISPONIBLE')&#xA;&#x9; ,G_DEPARTAMENTO_CANAL_DESTINO = ISNULL(CTE.DEPARTAMENTO,'NO DISPONIBLE')&#xA;&#x9; ,G_REGIONAL_CANAL_DESTINO = ISNULL(CTE.REGIONAL,'NO DISPONIBLE')&#xA;&#x9; &#x9;&#xA;FROM &#xA;&#x9;TMP.MBCORE_GUIAS TMP WITH (NOLOCK) &#xA;&#x9;INNER JOIN CTE_GEOOGRAFIA CTE&#xA;ON &#xA;&#x9;TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
