          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="WITH CTE&#xA;(&#xA;   ID&#xA;   ,[NUMERO_GUIA]&#xA;      ,[NUMERO_PIEZAS]&#xA;      ,[ID_TIEMPO]&#xA;      ,[ID_PRODUCTO]&#xA;      ,[ID_CLIENTE]&#xA;      ,[ID_ESTADOENVIO]&#xA;      ,[ID_CIUDAD_ORIGEN]&#xA;      ,[ID_CIUDAD_DESTINO]&#xA;      ,[FECHA_ENVIO]&#xA;      ,[DIRECCION_DESTINA_GUIA]&#xA;      ,[ID_PAIS_UBICACION]&#xA;      ,[ID_CIUDAD_UBICACION]&#xA;      ,[ID_DIVISION_UBICACION]&#xA;   ,[VALOR_DECLARADO_GUIA]&#xA;   ,[CR_ID_APLICA_COMPENSACIONES]&#xA;   ,[G_NOMBRE_REMITENTE]&#xA;   ,[G_TELEFONO_REMITE_GUIA]&#xA;,[G_ID_REMITE]&#xA;)&#xA;AS&#xA; (&#xA;  SELECT &#xA;    ROW_NUMBER() OVER(PARTITION BY NUMERO_GUIA ORDER BY FECHA_EXTRACCION_DW DESC ) ID&#xA;   ,[NUMERO_GUIA]&#xA;   ,[NUMERO_PIEZAS]&#xA;   ,[ID_TIEMPO]&#xA;   ,[ID_PRODUCTO]&#xA;   ,[ID_CLIENTE]&#xA;   ,[ID_ESTADOENVIO]&#xA;   ,[ID_CIUDAD_ORIGEN]&#xA;   ,[ID_CIUDAD_DESTINO]&#xA;   ,[FECHA_ENVIO]&#xA;   ,[DIRECCION_DESTINA_GUIA]&#xA;   ,[ID_PAIS_UBICACION]&#xA;   ,[ID_CIUDAD_UBICACION]&#xA;   ,[ID_DIVISION_UBICACION]&#xA;   ,[VALOR_DECLARADO_GUIA]&#xA;   ,[CR_ID_APLICA_COMPENSACIONES]&#xA;   ,[G_NOMBRE_REMITENTE]&#xA;   ,[G_TELEFONO_REMITE_GUIA]&#xA;,[G_ID_REMITE]&#xA;  FROM &#xA;   [TMP].[MBCORE_GUIAS_01] G WITH(NOLOCK)&#xA; )&#xA;INSERT INTO &#xA; TMP.MBCORE_GUIAS_02 &#xA;(&#xA;  [NUMERO_GUIA]&#xA; ,[NUMERO_PIEZAS]&#xA; ,[ID_TIEMPO]&#xA; ,[ID_PRODUCTO]&#xA; ,[ID_CLIENTE]&#xA; ,[ID_ESTADOENVIO]&#xA; ,[ID_CIUDAD_ORIGEN]&#xA; ,[ID_CIUDAD_DESTINO]&#xA; ,[FECHA_ENVIO]&#xA; ,[DIRECCION_DESTINA_GUIA]&#xA; ,[ID_PAIS_UBICACION]&#xA; ,[ID_CIUDAD_UBICACION]&#xA; ,[ID_DIVISION_UBICACION]&#xA; ,[VALOR_DECLARADO_GUIA]&#xA;,[CR_ID_APLICA_COMPENSACIONES]&#xA;   ,[G_NOMBRE_REMITENTE]&#xA;   ,[G_TELEFONO_REMITE_GUIA]&#xA;,[G_ID_REMITE]&#xA;)&#xA;SELECT&#xA;  [NUMERO_GUIA]&#xA; ,[NUMERO_PIEZAS]&#xA; ,[ID_TIEMPO]&#xA; ,[ID_PRODUCTO]&#xA; ,[ID_CLIENTE]&#xA; ,[ID_ESTADOENVIO]&#xA; ,[ID_CIUDAD_ORIGEN]&#xA; ,[ID_CIUDAD_DESTINO]&#xA; ,[FECHA_ENVIO]&#xA; ,[DIRECCION_DESTINA_GUIA]&#xA; ,[ID_PAIS_UBICACION]&#xA; ,[ID_CIUDAD_UBICACION]&#xA; ,[ID_DIVISION_UBICACION]&#xA; ,[VALOR_DECLARADO_GUIA]&#xA;,[CR_ID_APLICA_COMPENSACIONES]&#xA;   ,[G_NOMBRE_REMITENTE]&#xA;   ,[G_TELEFONO_REMITE_GUIA]&#xA;,[G_ID_REMITE]&#xA;FROM&#xA; CTE&#xA;WHERE &#xA; ID = 1&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\CARGA INICIAL OPERADO DE EXTRACCION Y GENERADOR DE FECHAS\PASO 03 ARMAR BASE"
