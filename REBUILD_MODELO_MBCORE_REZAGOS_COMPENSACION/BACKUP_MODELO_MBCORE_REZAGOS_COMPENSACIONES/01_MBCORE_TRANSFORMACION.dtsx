          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="WITH CTE_TIEMPO_ENTREGA&#xA;(&#xA;&#x9; G_NUMERO_GUIA&#xA;&#x9;,NOMBRE_TIEMPO&#xA;&#x9;&#xA;)&#xA;AS&#xA;&#x9;(&#xA;&#x9;&#x9;SELECT&#xA;&#x9;&#x9;&#x9; TMP.G_NUMERO_GUIA&#xA;&#x9;&#x9;&#x9;,TI.NOMBRE_TIEMPO&#xA;&#x9;&#x9;&#x9;&#xA;&#x9;&#x9;FROM &#xA;&#x9;&#x9;&#x9;TMP.MBCORE_GUIAS TMP WITH (NOLOCK)&#xA;&#x9;&#x9;INNER JOIN &#xA;&#x9;&#x9;&#x9;PAR.TIEMPOSENTREGA TI WITH (NOLOCK)&#xA;&#x9;&#x9;ON&#xA;&#x9;&#x9;&#x9;TMP.G_ID_TIEMPO_ENTREGA = TI.ID_TIEMPO&#xA;&#x9;&#x9;&#xA;&#x9;&#x9;&#xA;&#x9;)&#xA;UPDATE &#xA;&#x9;TMP&#xA;SET&#xA;&#x9; G_TIEMPO_ENTREGA = ISNULL (CTE.NOMBRE_TIEMPO,'NO DISPONIBLE')&#xA;&#x9;&#xA;FROM &#xA;&#x9;TMP.MBCORE_GUIAS TMP WITH (NOLOCK) &#xA;INNER JOIN CTE_TIEMPO_ENTREGA CTE&#xA;ON&#xA;&#x9;TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
