    <DTS:Executable
      DTS:refId="Package\PASO 11 OBTENER LA ULTIMA CIUDAD DE MOVIMIENTO Y ZONA"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{D4A5567E-EB6A-4C3A-A836-1B8457BC8507}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="PASO 11 OBTENER LA ULTIMA CIUDAD DE MOVIMIENTO Y ZONA"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:LoggingOptions
        DTS:FilterKind="0" />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
          SQLTask:SqlStatementSource="WITH CTE&#xA;(&#xA;&#x9; G_NUMERO_GUIA&#xA;&#x9;,ID_PROCESO&#xA;&#x9;,NUMERO_MOVIMI&#xA;&#x9;,CONSECUT_MOVIMI&#xA;&#x9;,SE_ID_ULTI&#xA;)&#xA;AS&#xA;&#x9;(&#xA;&#x9;&#x9;SELECT&#xA;&#x9;&#x9;&#x9; TMP.G_NUMERO_GUIA&#xA;&#x9;&#x9;&#x9;,TMP07.ID_PROCESO&#xA;&#x9;&#x9;&#x9;,TMP07.NUMERO_MOVIMI&#xA;&#x9;&#x9;&#x9;,TMP07.CONSECUT_MOVIMI&#xA;&#x9;&#x9;&#x9;,TMP.SE_ID_ULTI&#xA;&#x9;&#x9;FROM &#xA;&#x9;&#x9;&#x9;[TMP].[MBCORE_GUIAS_07] TMP07 WITH (NOLOCK)&#xA;&#x9;&#x9;INNER JOIN &#xA;&#x9;&#x9;&#x9;TMP.MBCORE_GUIAS TMP WITH (NOLOCK)&#xA;&#x9;&#x9;ON&#xA;&#x9;&#x9;&#x9;TMP07.ID = TMP.SE_ID_ULTI&#xA;&#x9;)&#xA;INSERT INTO [TMP].[MBCORE_GUIAS_08]&#xA;(&#xA;&#x9; G_NUMERO_GUIA&#xA;&#x9;,ID_CIUDAD_ULTI_MOVI&#xA;&#x9;,ID_ZONA_URBA&#xA;)&#xA;SELECT &#xA;&#x9;CTE.G_NUMERO_GUIA,&#xA;&#x9;CASE PRO.ID_TIPO_PROCESO &#xA;&#x9;&#x9;   WHEN 1 THEN &#xA;&#x9;&#x9;&#x9;&#x9; CASE WHEN ISNULL(TMP15.ID_CIUDAD_DESTINO,0) &gt; 0 THEN TMP15.ID_CIUDAD_DESTINO ELSE TMP15.ID_CIUDAD_DIVISION_ORIGEN END &#xA;&#x9;&#x9;   WHEN 2 THEN &#xA;&#x9;&#x9;&#x9;&#x9; CASE WHEN ISNULL(TMP15.ID_CIUDAD_DIVISION_ORIGEN,0) &gt; 0 THEN TMP15.ID_CIUDAD_DIVISION_ORIGEN ELSE TMP15.ID_CIUDAD_DESTINO END &#xA;&#x9;&#x9;   ELSE &#xA;&#x9;&#x9;&#x9;&#x9; CASE WHEN ISNULL(TMP15.ID_CIUDAD_DIVISION_ORIGEN,0) &gt; 0 THEN TMP15.ID_CIUDAD_DIVISION_ORIGEN ELSE TMP15.ID_CIUDAD_DESTINO END  &#xA;&#x9;END AS ID_CIUDAD_ULTI_MOVI&#xA;&#x9;,CASE WHEN (ISNULL(ID_TIPO_ZONA_URBA,0) = 0 OR ISNULL(ID_ZONA_URBA,0) = 0) THEN '-888' ELSE CONVERT(VARCHAR,ID_CIUDAD_ZONA_URBA) + '-' + CONVERT(VARCHAR,ID_TIPO_ZONA_URBA)+ '-' + CONVERT(VARCHAR,ID_ZONA_URBA) END ID_ZONA_URBA&#xA;FROM &#xA;&#x9;CTE &#xA;INNER JOIN  &#xA;&#x9;TMP.MBCORE_GUIAS_15 TMP15 WITH (NOLOCK)&#xA;ON&#xA;&#x9;CTE.G_NUMERO_GUIA = TMP15.G_NUMERO_GUIA&#xA;&#xA;LEFT JOIN &#xA;&#x9;PAR.PROCESOS PRO WITH (NOLOCK)&#xA;ON &#xA;CTE.ID_PROCESO = PRO.ID_PROCESO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\PASO 12 ACTUALIZAR BASE CIUDAD ULTIMO MOVIMIENTO Y ZONA"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{A4432A48-919E-496E-B242-2E169B1C97C9}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="PASO 12 ACTUALIZAR BASE CIUDAD ULTIMO MOVIMIENTO Y ZONA"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:LoggingOptions
        DTS:FilterKind="0" />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
          SQLTask:SqlStatementSource="WITH CTE_PROCESOS&#xA;(&#xA;&#x9;G_NUMERO_GUIA&#xA;&#x9;,DOC_ID_CIUDAD_ULTI_MOVI&#xA;&#x9;,DOC_ID_ZONA&#xA;)&#xA;AS&#xA;&#x9;(&#xA;&#x9;&#x9;SELECT&#xA;&#x9;&#x9;&#x9; TMP.G_NUMERO_GUIA&#xA;&#x9;&#x9;&#x9;,TMP08.ID_CIUDAD_ULTI_MOVI&#xA;&#x9;&#x9;&#x9;,TMP08.ID_ZONA_URBA&#xA;&#x9;&#x9;FROM &#xA;&#x9;&#x9;&#x9;TMP.MBCORE_GUIAS TMP WITH (NOLOCK)&#xA;&#x9;&#x9;INNER JOIN &#xA;&#x9;&#x9;&#x9;[TMP].[MBCORE_GUIAS_08] TMP08 WITH (NOLOCK)&#xA;&#x9;&#x9;ON &#xA;&#x9;&#x9;&#x9;TMP.G_NUMERO_GUIA = TMP08.G_NUMERO_GUIA&#xA;&#x9;)&#xA;UPDATE &#xA;&#x9;TMP &#xA;SET&#xA;&#x9;DOC_ID_CIUDAD_ULTI_MOVI = CASE WHEN ISNULL(CTE.DOC_ID_CIUDAD_ULTI_MOVI,0) = 0 THEN TMP.DOC_ID_CIUDAD_ULTI_MOVI ELSE CTE.DOC_ID_CIUDAD_ULTI_MOVI END&#xA;&#x9;,DOC_ID_ZONA = CASE WHEN ISNULL(CTE.DOC_ID_ZONA,'') ='' THEN TMP.DOC_ID_ZONA ELSE CTE.DOC_ID_ZONA END --VALIDAR NULL O VACIOS &#xA;FROM &#xA;&#x9; TMP.MBCORE_GUIAS TMP WITH (NOLOCK)&#xA;&#x9;INNER JOIN CTE_PROCESOS CTE  ON  TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\PASO 13 ACTUALIZAR ID ULTIMO PROCESO Y ULTIMO CONCEPTO"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{2D13BB2A-0317-4608-87A7-8B45A87706BC}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="PASO 13 ACTUALIZAR ID ULTIMO PROCESO Y ULTIMO CONCEPTO"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:LoggingOptions
        DTS:FilterKind="0" />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
          SQLTask:SqlStatementSource="&#xA;&#xA;WITH CTE&#xA;(&#xA;&#x9; G_NUMERO_GUIA&#xA;&#x9;,ID_PROCESO&#xA;&#x9;,ID_CONCEPTO&#xA;)&#xA;AS&#xA;&#x9;(&#xA;&#x9;&#x9;SELECT&#xA;&#x9;&#x9;&#x9; TMP.G_NUMERO_GUIA&#xA;&#x9;&#x9;&#x9;,TMP07.ID_PROCESO&#xA;&#x9;&#x9;&#x9;,TMP07.ID_CONCEPTO&#xA;&#x9;&#x9;FROM &#xA;&#x9;&#x9;&#x9;TMP.MBCORE_GUIAS TMP WITH (NOLOCK)&#xA;&#x9;&#x9;INNER JOIN &#xA;&#x9;&#x9;&#x9;TMP.MBCORE_GUIAS_07 TMP07 WITH (NOLOCK)&#xA;&#x9;&#x9;ON &#xA;&#x9;&#x9;&#x9;TMP.SE_ID_ULTI = TMP07.ID&#xA;&#x9;)&#xA;UPDATE &#xA;&#x9;TMP.MBCORE_GUIAS&#xA;SET &#xA;--SELECT&#xA;&#x9; SE_ID_PROC_ULTI_MOVI = ISNULL(ID_PROCESO,-888)&#xA;&#x9;,SE_ID_CONC_ULTI_MOVI = ISNULL(ID_CONCEPTO,-888)&#xA;FROM &#xA;&#x9; TMP.MBCORE_GUIAS TMP WITH (NOLOCK)&#xA;&#x9;INNER JOIN CTE ON TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\PASO 14 ACTUALIZAR DIGITALIZADA"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{5C38C93B-4DA8-4412-8E17-28472210A4B9}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="PASO 14 ACTUALIZAR DIGITALIZADA"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:LoggingOptions
        DTS:FilterKind="0" />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
          SQLTask:SqlStatementSource="&#xA;WITH CTE&#xA;(&#xA;&#x9; G_NUMERO_GUIA&#xA;&#x9;,SE_ID_DIGI&#xA;&#x9;,SE_ID_FECHA_DIG&#xA;&#x9;,SE_FECHA_DIG&#xA;)&#xA;AS&#xA;(&#xA;&#x9;SELECT&#xA;&#x9;&#x9; TMP.G_NUMERO_GUIA&#xA;&#x9;&#x9;,'SI' AS SE_ID_DIGI&#xA;&#x9;&#x9;,ISNULL(PE.FECHA_DIGITALIZACION,'1900-01-01') SE_ID_FECHA_DIG&#xA;&#x9;&#x9;,ISNULL(CONVERT(VARCHAR,PE.FECHA_DIGITALIZACION,21),'NO DISPONIBLE') SE_FECHA_DIG&#xA;&#x9;FROM&#xA;&#x9;&#x9;TMP.MBCORE_GUIAS TMP WITH(NOLOCK)&#xA;&#x9;INNER JOIN&#xA;&#x9;&#x9;SIG_COLOMBIA_DW.LOG.PRUEBAS_ENTREGA PE WITH(NOLOCK)&#xA;&#x9;ON&#xA;&#x9;&#x9;TMP.G_NUMERO_GUIA = PE.NUMERO_GUIA&#xA;)&#xA;UPDATE &#xA;&#x9;TMP.MBCORE_GUIAS&#xA;SET&#xA;&#x9; SE_ID_DIGI = CTE.SE_ID_DIGI&#xA;&#x9;,SE_ID_FECHA_DIGI&#x9;= CTE.SE_ID_FECHA_DIG&#xA;&#x9;,SE_FECHA_DIGI&#x9;= CTE.SE_FECHA_DIG&#xA;FROM&#xA;&#x9;TMP.MBCORE_GUIAS TMP WITH (NOLOCK) &#xA; INNER JOIN CTE &#xA;ON TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\PASO 15 ACTUALIZAR ZONA"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{8CF1636F-2A57-4D21-928A-7F27E58314EB}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="PASO 15 ACTUALIZAR ZONA"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:LoggingOptions
        DTS:FilterKind="0" />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
          SQLTask:SqlStatementSource="WITH CTE_ZONAS&#xA;(&#xA;&#x9;G_NUMERO_GUIA&#xA;&#x9;,DOC_ZONA&#xA;)&#xA;AS&#xA;(&#xA;SELECT &#xA;&#x9;TMP.G_NUMERO_GUIA&#xA;&#x9;,ZU.NOMBRE_ZONA_URBA AS DOC_ZONA&#xA;FROM &#xA;&#x9;TMP.MBCORE_GUIAS TMP WITH (NOLOCK)&#xA;INNER JOIN &#xA;&#x9;PAR.ZONASURBANAS ZU WITH (NOLOCK)&#xA;ON &#xA;&#x9;TMP.DOC_ID_ZONA = CONVERT (VARCHAR ,ID_CIUDAD) +'-'+ CONVERT (VARCHAR ,ID_TIPO_ZONA_URBA)  +'-'+ CONVERT (VARCHAR ,ID_ZONA_URBA)&#xA;)&#xA;UPDATE&#xA;&#x9;TMP&#xA;SET&#xA;&#x9;DOC_ZONA =  CASE WHEN ISNULL(CTE.DOC_ZONA,'') = '' THEN TMP.DOC_ZONA ELSE CTE.DOC_ZONA END &#xA;FROM &#xA;&#x9;TMP.MBCORE_GUIAS TMP  WITH (NOLOCK)&#xA;&#x9;INNER JOIN CTE_ZONAS  CTE&#xA;ON &#xA;&#x9;TMP.G_NUMERO_GUIA =CTE.G_NUMERO_GUIA&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\PASO 16_01 ACTUALIZAR BODEGA GENERAL  ESTANDAR"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{5AC85E59-1391-423D-9B61-361B2638FEC8}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="PASO 16_01 ACTUALIZAR BODEGA GENERAL  ESTANDAR"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:LoggingOptions
        DTS:FilterKind="0" />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
          SQLTask:SqlStatementSource="UPDATE&#xA; TMP.MBCORE_GUIAS&#xA;SET&#xA; G_BODEGA_ULTM_MOVI = ISNULL(DIV.[NOMBRE_DIVISION],'NO DISPONIBLE')&#xA;FROM &#xA; TMP.MBCORE_GUIAS TMP&#xA;INNER JOIN &#xA; [PAR].[DIVISIONES] DIV WITH(NOLOCK)&#xA;ON &#xA; TMP.G_ID_BODEGA_ULTM_MOVI = CONVERT(VARCHAR,DIV.[ID_PAIS]) + '-' + CONVERT(VARCHAR,DIV.[ID_CIUDAD]) + '-' + CONVERT(VARCHAR,DIV.[ID_DIVISION])&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\PASO 17 ACTUALIZAR TIPO TRAYECTO"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{12296900-243E-4745-87D9-81D8365853DD}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="PASO 17 ACTUALIZAR TIPO TRAYECTO"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:LoggingOptions
        DTS:FilterKind="0" />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
          SQLTask:SqlStatementSource="WITH CTE_TIPO_TRAYECTO&#xA;(&#xA;&#x9; G_NUMERO_GUIA&#xA;&#x9;,G_ID_TIPO_TRAYECTO&#xA;&#x9;,G_TIPO_TRAYECTO&#xA;)&#xA;AS&#xA;(&#xA;SELECT&#xA;     TMP.G_NUMERO_GUIA&#xA;&#x9; ,CONVERT(VARCHAR(50),CONVERT(NVARCHAR(10), ID_CIUDAD_ORIGEN) + '-' + CONVERT(NVARCHAR(10), ID_CIUDAD_DESTINO)) G_ID_TIPO_TRAYECTO&#xA;     ,TT.NOMBRE_TIPOTRAY AS G_TIPO_TRAYECTO&#xA;FROM&#xA;    TMP.MBCORE_GUIAS TMP WITH (NOLOCK)&#xA;INNER JOIN &#xA;&#x9;SIG_COLOMBIA_DW.PAR.RED_OPERATIVA_CONSOLIDADA_TRAYECTOS RO WITH(NOLOCK)&#xA;ON &#xA;&#x9;TMP.G_ID_CIUDAD_ORIGEN = RO.ID_CIUDAD_ORIGEN&#xA;AND&#xA;&#x9;TMP.G_ID_CIUDAD_DESTINO = RO.ID_CIUDAD_DESTINO&#xA;INNER JOIN&#xA;    SIG_COLOMBIA_DW.PAR.TIPOTRAYECTO TT WITH(NOLOCK)&#xA;ON&#xA;    RO.ID_TIPOTRAY = TT.ID_TIPOTRAY&#xA;WHERE&#xA;    ID_PAIS_ORIGEN = 1&#xA;AND&#xA;    ID_PAIS_DESTINO = 1&#xA;)&#xA;UPDATE&#xA;&#x9;TMP.MBCORE_GUIAS &#xA;SET &#xA;&#x9; G_ID_TIPO_TRAYECTO = CTE.G_ID_TIPO_TRAYECTO&#xA;&#x9;,G_TIPO_TRAYECTO= CTE.G_TIPO_TRAYECTO&#xA;FROM &#xA;&#x9;TMP.MBCORE_GUIAS TMP WITH (NOLOCK)&#xA;&#x9;INNER JOIN CTE_TIPO_TRAYECTO CTE&#xA;ON &#xA;&#x9;TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\PASO 18 OBTENER GUIAS CONFIRMADAS"
