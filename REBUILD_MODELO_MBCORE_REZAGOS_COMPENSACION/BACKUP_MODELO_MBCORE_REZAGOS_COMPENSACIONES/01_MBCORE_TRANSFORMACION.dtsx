                    <pipeline
                      version="1">
                      <components>
                        <component
                          refId="Package\CARGA INICIAL OPERADO DE EXTRACCION Y GENERADOR DE FECHAS\Base principal de Compensaciones y rezagos y Guias no MBCORE\GUIAS MBCORE\PASO 01 01 OBTENER GUIAS rezagos y compensaciones\DIRECCION GENERAL  GUIAS EN REZAGOS Y COMPENSACIONES"
                          componentClassID="Microsoft.OLEDBSource"
                          contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                          description="OLE DB Source"
                          name="DIRECCION GENERAL  GUIAS EN REZAGOS Y COMPENSACIONES"
                          usesDispositions="true"
                          version="7">
                          <properties>
                            <property
                              dataType="System.Int32"
                              description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                              name="CommandTimeout">0</property>
                            <property
                              dataType="System.String"
                              description="Specifies the name of the database object used to open a rowset."
                              name="OpenRowset"></property>
                            <property
                              dataType="System.String"
                              description="Specifies the variable that contains the name of the database object used to open a rowset."
                              name="OpenRowsetVariable"></property>
                            <property
                              dataType="System.String"
                              description="The SQL command to be executed."
                              name="SqlCommand"
                              UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">DECLARE @DATE_INI DATETIME = CONVERT(DATETIME, CONVERT(DATE,CONVERT(DATETIME,?))); 
DECLARE @DATE_FIN DATETIME = CONVERT(DATETIME, CONVERT(DATE,CONVERT(DATETIME,?))); 
SELECT 
	 GUI.[NUMERO_GUIA]
	,GUI.[NUMERO_PIEZAS]
	,GUI.[FECHA_ENVIO]
	,GUI.[ID_TIEMPO]
	,GUI.[ID_PRODUCTO]
	,GUI.[DIRECCION_DESTINA_GUIA]
	,GUI.[ID_CLIENTE]
	,GUI.[ID_ESTADOENVIO]
	,GUI.[ID_CIUDAD_ORIGEN]
	,GUI.[ID_CIUDAD_DESTINO]
	,GUI.[ID_PAIS_UBICACION]
	,GUI.[ID_CIUDAD_UBICACION]
	,GUI.[ID_DIVISION_UBICACION]
	,GUI.[VALOR_DECLARADO_GUIA]
	,[FECHA_EXTRACCION_DW] = GETDATE()
,[CR_ID_APLICA_COMPENSACIONES] =1
   ,[G_NOMBRE_REMITENTE]=CONCAT(GUI.NOMBRE_REMITE_GUIA,GUI.APELLIDO_REMITE_GUIA)
   ,[G_TELEFONO_REMITE_GUIA] = GUI.TELEFONO_REMITE_GUIA
,[G_ID_REMITE] = GUI.[ID_REMITE]
FROM DBO.GUIAS GUI WITH(NOLOCK)
INNER JOIN  DBO.SEGUIMIENTO_ENVIO SEG WITH (NOLOCK)
ON GUI.NUMERO_GUIA=SEG.NUMERO_GUIA
INNER JOIN  DBO.DOCUMENTOS DOC WITH (NOLOCK) 
ON SEG.ID_PROCESO=DOC.ID_PROCESO AND SEG.NUMERO_MOVIMI=DOC.NUMERO_MOVIMI AND SEG.CONSECUT_MOVIMI=DOC.CONSECUT_MOVIMI
INNER JOIN PARAMETROS..DIVISIONES DIV WITH (NOLOCK)
ON DIV.ID_DIVISION=DOC.ID_DIVISION_DESTINO AND DOC.ID_CIUDAD_DESTINO=DIV.ID_CIUDAD 
WHERE 
	(DIV.NOMBRE_DIVISION LIKE '%REZAGO%' OR DIV.NOMBRE_DIVISION LIKE '%COMPENSACION%')
	AND
	(SEG.FECHA_HORA_MOVIMIENTO
	BETWEEN 
			@DATE_INI
    AND 
			@DATE_FIN
	)</property>
                            <property
