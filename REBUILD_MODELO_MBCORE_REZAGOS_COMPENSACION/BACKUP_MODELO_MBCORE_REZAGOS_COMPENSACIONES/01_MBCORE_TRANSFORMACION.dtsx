                        <connection
                          refId="Package\38 ACTUALIZACION UBICACION BODEGA Y REGIONAL INVENATARIOS FISICOS\39 03 ACTUALIZACION BODEGA Y REGIONAL UBICACION INVENARIO FISICO\Paso 39 02 EXTRAE MBCORE BODEGA Y REGIONAL TB LOG\EXTRACCION DE BODEGAS  MOVIMEINTOS.Connections[OleDbConnection]"
