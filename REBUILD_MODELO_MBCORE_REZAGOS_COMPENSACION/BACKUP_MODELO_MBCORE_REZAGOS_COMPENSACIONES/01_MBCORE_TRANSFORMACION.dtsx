        <DTS:Executable
          DTS:refId="Package\PASO 30 ACTUALIZAR CAMPOS NUEVOS MBCORE\PASO 30 04 ACTUALIZAR REGIMEN LOGISTICO"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{F5756C1F-07C0-4ACA-A8C1-A12E29FD4443}"
