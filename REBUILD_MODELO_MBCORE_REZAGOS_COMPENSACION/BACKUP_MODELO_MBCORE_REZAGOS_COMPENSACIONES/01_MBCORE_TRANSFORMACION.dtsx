                    <pipeline
                      version="1">
                      <components>
                        <component
                          refId="Package\CARGA INICIAL OPERADO DE EXTRACCION Y GENERADOR DE FECHAS\Base principal de Compensaciones y rezagos y Guias no MBCORE\GUIAS NO MBCORE\PASO 01 02 OBTENER GUIAS NO SON DE MBCORE\DIRECCION GENERAL  NO MBCORE"
                          componentClassID="Microsoft.OLEDBSource"
                          contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                          description="OLE DB Source"
                          name="DIRECCION GENERAL  NO MBCORE"
                          usesDispositions="true"
                          version="7">
                          <properties>
                            <property
                              dataType="System.Int32"
                              description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                              name="CommandTimeout">0</property>
                            <property
                              dataType="System.String"
                              description="Specifies the name of the database object used to open a rowset."
                              name="OpenRowset"></property>
                            <property
                              dataType="System.String"
                              description="Specifies the variable that contains the name of the database object used to open a rowset."
                              name="OpenRowsetVariable"></property>
                            <property
                              dataType="System.String"
                              description="The SQL command to be executed."
                              name="SqlCommand"
                              UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">DECLARE @DATE_INI DATETIME = CONVERT(DATETIME, CONVERT(DATE,CONVERT(DATETIME,?))); 
DECLARE @DATE_FIN DATETIME = CONVERT(DATETIME, CONVERT(DATE,CONVERT(DATETIME,?))); 
WITH CTE_GUIAS_NO_MBCORE
(
	ID
	,NUMERO_GUIA	
	,NUMERO_PIEZAS	
	,FECHA_ENVIO	
	,ID_TIEMPO	
	,ID_PRODUCTO	
	,DIRECCION_DESTINA_GUIA	
	,ID_CLIENTE	
	,ID_ESTADOENVIO	
	,ID_CIUDAD_ORIGEN	
	,ID_CIUDAD_DESTINO	
	,ID_PAIS_UBICACION	
	,ID_CIUDAD_UBICACION	
	,ID_DIVISION_UBICACION	
	,VALOR_DECLARADO_GUIA	
	,FECHA_EXTRACCION_DW	
	,CR_ID_APLICA_COMPENSACIONES
   ,[G_NOMBRE_REMITENTE]
   ,[G_TELEFONO_REMITE_GUIA]
,[G_ID_REMITE]
) AS (
SELECT
ID = ROW_NUMBER ( )   OVER ( PARTITION BY GUI.[NUMERO_GUIA] order by GUI.[FECHA_MODIFICACION_DG] desc ) 
	 ,GUI.[NUMERO_GUIA]
	,GUI.[NUMERO_PIEZAS]
	,GUI.[FECHA_ENVIO]
	,GUI.[ID_TIEMPO]
	,GUI.[ID_PRODUCTO]
	,GUI.[DIRECCION_DESTINA_GUIA]
	,GUI.[ID_CLIENTE]
	,GUI.[ID_ESTADOENVIO]
	,GUI.[ID_CIUDAD_ORIGEN]
	,GUI.[ID_CIUDAD_DESTINO]
	,GUI.[ID_PAIS_UBICACION]
	,GUI.[ID_CIUDAD_UBICACION]
	,GUI.[ID_DIVISION_UBICACION]
	,GUI.[VALOR_DECLARADO_GUIA]
	,[FECHA_EXTRACCION_DW] = GETDATE()
   ,[CR_ID_APLICA_COMPENSACIONES] =0
   ,[G_NOMBRE_REMITENTE]=CONCAT(GUI.NOMBRE_REMITE_GUIA,GUI.APELLIDO_REMITE_GUIA)
   ,[G_TELEFONO_REMITE_GUIA] = GUI.TELEFONO_REMITE_GUIA
,[G_ID_REMITE]=GUI.[ID_REMITE]
FROM LOG.GUIAS GUI WITH(NOLOCK)
INNER JOIN  LOG.SEGUIMIENTO_ENVIO SEG WITH (NOLOCK)
ON GUI.NUMERO_GUIA=SEG.NUMERO_GUIA
WHERE 
	(SEG.FECHA_HORA_MOVIMIENTO 	BETWEEN @DATE_INI AND @DATE_FIN )  
	AND 
	GUI.ID_ESTADOGUIA&lt;&gt;4
	--and 
	--GUI.NUMERO_GUIA=523061022
)
SELECT 
	NUMERO_GUIA	
	,NUMERO_PIEZAS	
	,FECHA_ENVIO	
	,ID_TIEMPO	
	,ID_PRODUCTO	
	,DIRECCION_DESTINA_GUIA	
	,ID_CLIENTE	
	,ID_ESTADOENVIO	
	,ID_CIUDAD_ORIGEN	
	,ID_CIUDAD_DESTINO	
	,ID_PAIS_UBICACION	
	,ID_CIUDAD_UBICACION	
	,ID_DIVISION_UBICACION	
	,VALOR_DECLARADO_GUIA	
	,FECHA_EXTRACCION_DW	
	,CR_ID_APLICA_COMPENSACIONES
    ,[G_NOMBRE_REMITENTE]
    ,[G_TELEFONO_REMITE_GUIA]
,[G_ID_REMITE]
FROM CTE_GUIAS_NO_MBCORE WHERE ID=1</property>
