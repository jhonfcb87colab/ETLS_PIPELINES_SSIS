            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="WITH CTE_PESO_R&#xA;(&#xA;&#x9;NUMERO_GUIA,&#xA;&#x9;PESO_ENVIO&#xA;)AS&#xA;(&#xA;&#x9;SELECT NUMERO_GUIA,PESO_ENVIO FROM(&#xA;&#x9;&#x9;&#x9;&#x9;SELECT &#xA;&#x9;&#x9;&#x9;&#x9;ROW_NUMBER ( )   OVER ( PARTITION BY NUMERO_GUIA order by FECHA_HORA_MOVIMIENTO ASC )  id, &#xA;&#x9;&#x9;&#x9;&#x9;NUMERO_GUIA,&#xA;&#x9;&#x9;&#x9;&#x9;ID_PROCESO,&#xA;&#x9;&#x9;&#x9;&#x9;PESO_ENVIO,&#xA;&#x9;&#x9;&#x9;&#x9;FECHA_HORA_MOVIMIENTO &#xA;&#x9;&#x9;&#x9;&#x9;FROM/*         */    SIG_COLOMBIA_DW.LOG.SEGUIMIENTO_ENVIO  (NOLOCK) WHERE NUMERO_GUIA IN (SELECT DISTINCT GUI.G_NUMERO_GUIA FROM  TMP.MBCORE_GUIAS GUI (NOLOCK))&#x9;&#x9;&#x9; &#xA;&#x9;&#x9;&#x9;&#x9;) CTE &#xA;&#x9;WHERE CTE.id=1&#xA;) ---select * from CTE_PESO_R&#xA;&#xA;UPDATE &#xA;&#x9;TMP.MBCORE_GUIAS&#xA;SET &#xA;&#x9;PESO_FISICO_R = CTE_PESO_R.PESO_ENVIO&#xA;FROM &#xA;&#x9; TMP.MBCORE_GUIAS TMP&#xA;&#x9;,CTE_PESO_R&#xA;WHERE &#xA;&#x9;TMP.G_NUMERO_GUIA = CTE_PESO_R.NUMERO_GUIA&#xA;GO&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
