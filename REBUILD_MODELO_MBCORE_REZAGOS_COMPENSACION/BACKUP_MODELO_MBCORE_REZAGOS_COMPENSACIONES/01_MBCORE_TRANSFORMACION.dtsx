                  SQLTask:SqlStatementSource="TRUNCATE TABLE [TMP].[MBCORE_GUIAS_27];&#xA;GO&#xA;&#xA;WITH CTE_ULTIMA_BODEGA_COMPENSACIONES&#xA;(&#xA;&#x9;&#x9;&#x9;ROW_REPETIDO&#xA;&#x9;&#x9;&#x9;,DIVISION_DESTINO&#xA;&#x9;&#x9;&#x9;,DIVISION_ORIGEN&#xA;&#x9;&#x9;&#x9;,NUMERO_GUIA&#xA;&#x9;&#x9;&#x9;,FECHA_HORA_MOVIMIENTO&#xA;&#x9;&#x9;&#x9;,FECHA_MODIFICACION_DG&#xA;&#x9;&#x9;&#x9;,REGIONAL_DESTINO&#xA;&#x9;&#x9;&#x9;,REGIONAL_ORIGEN&#xA;&#x9;&#x9;&#x9;,CIUDAD_DESTINO&#xA;&#x9;&#x9;&#x9;,CIUDAD_ORIGEN&#xA;&#x9;&#x9;&#x9;,ID_PROCESO&#xA;&#x9;&#x9;&#x9;,NOMBRE_PROCESO_LOG&#xA;&#x9;&#x9;&#x9;,BODEGA_UBICACION_ENVIO&#xA;&#x9;&#x9;&#x9;,REGIONAL_UBICACION_ENVIO&#xA;)AS(&#xA;&#x9;SELECT &#xA;&#x9;&#x9;ROW_NUMBER ( )   OVER ( PARTITION BY NUMERO_GUIA order by FECHA_HORA_MOVIMIENTO desc )  ROW_REPETIDO,  &#xA;&#x9;&#x9;&#x9;DIVISION_DESTINO&#xA;&#x9;&#x9;&#x9;,DIVISION_ORIGEN&#xA;&#x9;&#x9;&#x9;,NUMERO_GUIA&#xA;&#x9;&#x9;&#x9;,FECHA_HORA_MOVIMIENTO&#xA;&#x9;&#x9;&#x9;,FECHA_MODIFICACION_DG&#xA;&#x9;&#x9;&#x9;,REGIONAL_DESTINO&#xA;&#x9;&#x9;&#x9;,REGIONAL_ORIGEN&#xA;&#x9;&#x9;&#x9;,CIUDAD_DESTINO&#xA;&#x9;&#x9;&#x9;,CIUDAD_ORIGEN&#xA;&#x9;&#x9;&#x9;,ID_PROCESO&#xA;&#x9;&#x9;&#x9;,NOMBRE_PROCESO_LOG&#xA;&#x9;&#x9;&#x9;,BODEGA_UBICACION_ENVIO = &#xA;&#x9;&#x9;&#x9;&#x9;CASE &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN DIVISION_DESTINO LIKE '%COMPENSAC%' AND NOMBRE_PROCESO_LOG LIKE '%ENTRA%' THEN  DIVISION_DESTINO&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN DIVISION_DESTINO LIKE '%COMPENSAC%' AND NOMBRE_PROCESO_LOG LIKE '%SALIDA%' THEN DIVISION_ORIGEN &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN DIVISION_ORIGEN LIKE '%COMPENSAC%' AND NOMBRE_PROCESO_LOG LIKE '%SALIDA%' THEN DIVISION_DESTINO&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN DIVISION_DESTINO LIKE '%SIN DEFINIR%' AND NOMBRE_PROCESO_LOG LIKE '%SALIDA%' THEN DIVISION_ORIGEN&#xA;&#xA;&#x9;&#x9;&#x9;&#x9;ELSE  DIVISION_DESTINO END&#xA;&#x9;&#x9;&#x9;,REGIONAL_UBICACION_ENVIO = &#xA;&#x9;&#x9;&#x9;&#x9;CASE &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN DIVISION_DESTINO LIKE '%COMPENSAC%' AND NOMBRE_PROCESO_LOG LIKE '%ENTRADA%' THEN  REGIONAL_DESTINO&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN DIVISION_DESTINO LIKE '%COMPENSAC%' AND NOMBRE_PROCESO_LOG LIKE '%SALIDA%' THEN REGIONAL_ORIGEN &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN DIVISION_ORIGEN LIKE '%COMPENSAC%' AND NOMBRE_PROCESO_LOG LIKE '%SALIDA%' THEN REGIONAL_DESTINO &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN REGIONAL_DESTINO LIKE '%SIN DEFINIR%' AND NOMBRE_PROCESO_LOG LIKE '%SALIDA%' THEN REGIONAL_ORIGEN&#xA;&#x9;&#x9;&#x9;&#x9;ELSE  REGIONAL_DESTINO END&#xA;&#xA;&#x9;FROM &#xA;&#x9;[TMP].[MBCORE_GUIAS_26] WITH (NOLOCK)&#xA;&#x9;WHERE ID=1&#xA;)&#xA;INSERT INTO [TMP].[MBCORE_GUIAS_27]&#xA;SELECT &#xA;&#x9;&#x9;&#x9;DIVISION_DESTINO&#xA;&#x9;&#x9;&#x9;,DIVISION_ORIGEN&#xA;&#x9;&#x9;&#x9;,NUMERO_GUIA&#xA;&#x9;&#x9;&#x9;,FECHA_HORA_MOVIMIENTO&#xA;&#x9;&#x9;&#x9;,FECHA_MODIFICACION_DG&#xA;&#x9;&#x9;&#x9;,REGIONAL_DESTINO&#xA;&#x9;&#x9;&#x9;,REGIONAL_ORIGEN&#xA;&#x9;&#x9;&#x9;,CIUDAD_DESTINO&#xA;&#x9;&#x9;&#x9;,CIUDAD_ORIGEN&#xA;&#x9;&#x9;&#x9;,ID_PROCESO&#xA;&#x9;&#x9;&#x9;,NOMBRE_PROCESO_LOG&#xA;&#x9;&#x9;&#x9;,BODEGA_UBICACION_ENVIO&#xA;&#x9;&#x9;&#x9;,REGIONAL_UBICACION_ENVIO&#xA;&#x9;FROM CTE_ULTIMA_BODEGA_COMPENSACIONES&#xA;&#x9;WHERE ROW_REPETIDO=1&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
