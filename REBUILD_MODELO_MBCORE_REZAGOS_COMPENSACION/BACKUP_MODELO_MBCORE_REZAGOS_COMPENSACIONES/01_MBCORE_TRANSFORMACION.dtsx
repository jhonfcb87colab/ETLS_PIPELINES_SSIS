                          description="Specifies the variable that contains the name of the database object used to open a rowset."
                          name="OpenRowsetVariable"></property>
                        <property
                          dataType="System.String"
                          description="The SQL command to be executed."
                          name="SqlCommand"
                          UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT CTE.NUMERO_GUIA,ESTFIS.NOMBRE_ESTA_FISICO FROM(
				SELECT 
				ROW_NUMBER ( )   OVER ( PARTITION BY NUMERO_GUIA order by FECHA_HORA_MOVIMIENTO ASC )  id, 
				NUMERO_GUIA,
				ID_PROCESO,
				ID_ESTA_FISICO,
				FECHA_HORA_MOVIMIENTO 
				FROM/*         */    SIG_COLOMBIA_DW.LOG.SEGUIMIENTO_ENVIO  (NOLOCK) WHERE NUMERO_GUIA IN (SELECT DISTINCT GUI.G_NUMERO_GUIA FROM  TMP.MBCORE_GUIAS GUI (NOLOCK))			 
				) CTE 
				INNER JOIN [PAR].[ESTADOSFISICO] ESTFIS (NOLOCK)
				ON ESTFIS.ID_ESTA_FISICO=CTE.ID_ESTA_FISICO
	WHERE CTE.id=1</property>
