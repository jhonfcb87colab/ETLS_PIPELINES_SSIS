      <DTS:Variables />
      <DTS:LoggingOptions
        DTS:FilterKind="0" />
      <DTS:Executables>
        <DTS:Executable
          DTS:refId="Package\PASO 37 CLIENTE PROVISION\PASO 37 01 IMPORTAR GUIAS MBCORE CLIENTES PROVISION"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{BC04286B-382C-4CE2-AB7E-19D18B2F09D1}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="PASO 37 01 IMPORTAR GUIAS MBCORE CLIENTES PROVISION"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="IF object_id('tempdb..[#tabla_temporal_DIM_PQR_CLIENTES_202206031215]') &lt; 0 &#xA;  BEGIN&#xA;    DROP TABLE [#tabla_temporal_DIM_PQR_CLIENTES_202206031215]&#xA;  END&#xA;&#xA;CREATE TABLE #tabla_temporal_DIM_PQR_CLIENTES_202206031215(ID_CLIENTE varchar(50), NOMBRE_EMPRESA varchar(100));&#xA;&#xA;&#xA;WITH CTE(id,&#x9;ID_CLIENTE,&#x9;NOMBRE_EMPRESA)&#xA;AS&#xA;(&#xA;SELECT &#xA;ROW_NUMBER ( )   OVER ( PARTITION BY PQRCLIE.ID_CLIENTE order by PQRCLIE.FECHA_MODIFICA desc )  id,  &#xA;PQRCLIE.ID_CLIENTE,&#xA;PQRCLIE.NOMBRE_EMPRESA&#xA;FROM &#xA;SIG_COL_LOGISTICA_DW.DIM.PQR_CLIENTES (NOLOCK) PQRCLIE&#xA;)&#xA;INSERT INTO #tabla_temporal_DIM_PQR_CLIENTES_202206031215&#xA;SELECT CTE.ID_CLIENTE, CTE.NOMBRE_EMPRESA FROM CTE AS CTE WHERE CTE.ID=1&#xA;&#xA;&#xA;&#xA;&#xA;TRUNCATE TABLE TMP.MBCORE_GUIAS_24;&#xA;INSERT INTO TMP.MBCORE_GUIAS_24&#xA;SELECT DISTINCT&#xA;PQR.NUMERO_GUIA,PQR.ID_CLIENTE,TBL_TEMPO.NOMBRE_EMPRESA&#xA;FROM /*         */    SIG_COLOMBIA_DW.LOG.[PQR] PQR (NOLOCK)&#xA;INNER JOIN #tabla_temporal_DIM_PQR_CLIENTES_202206031215 TBL_TEMPO&#xA;ON TBL_TEMPO.ID_CLIENTE   = PQR.ID_CLIENTE  &#xA;WHERE PQR.NUMERO_GUIA IN (SELECT DISTINCT NUMERO_GUIA FROM [TMP].[MBCORE_GUIAS] (NOLOCK)  WHERE CR_ID_APLICA_COMPENSACIONES=1  )&#xA;AND LEN(PQR.NUMERO_GUIA)&gt;1&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;--create table TMP.MBCORE_GUIAS_24([NUMERO_GUIA] numeric(20,0),ID_CLIENTE VARCHAR(100), NOMBRE_EMPRESA VARCHAR(200))&#xA;&#xA;--SELECT &#xA;--PQRCLIE.ID_CLIENTE,&#xA;--COUNT(PQRCLIE.ID_CLIENTE) CONTEO&#xA;--FROM &#xA;--SIG_COL_LOGISTICA_DW.DIM.PQR_CLIENTES (NOLOCK) PQRCLIE&#xA;--GROUP BY PQRCLIE.ID_CLIENTE&#xA;--ORDER BY COUNT(PQRCLIE.ID_CLIENTE) DESC&#xA;-----      SELECT * FROM #tabla_temporal_DIM_PQR_CLIENTES_202206031215&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\PASO 37 CLIENTE PROVISION\PASO 37 02 ACTUALIZAR MBCORE CLIENTES PROVISION"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{6FCBE2CA-A071-457A-AF8E-8C53480A69B0}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="PASO 37 02 ACTUALIZAR MBCORE CLIENTES PROVISION"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="WITH CTE_GUIAS_CLIENTE_PORVISION&#xA;  (&#xA;  id,&#xA;&#x9;NUMERO_GUIA,&#xA;&#x9;ID_CLIENTE_PROVISION, &#xA;&#x9;NOMBRE_CLIENTE_PROVISION&#xA;  )&#xA;  AS&#xA;  (&#xA;  SELECT&#x9;ROW_NUMBER ( )   OVER ( PARTITION BY NUMERO_GUIA order by NUMERO_GUIA desc )  id,  &#xA;&#x9;&#x9;&#x9;NUMERO_GUIA,&#xA;&#x9;&#x9;&#x9;ID_CLIENTE as ID_CLIENTE_PROVISION,&#xA;&#x9;&#x9;&#x9;NOMBRE_EMPRESA as NOMBRE_CLIENTE_PROVISION&#xA;  FROM TMP.MBCORE_GUIAS_24 WITH(NOLOCK)&#xA;  ---WHERE [NUMERO_GUIA] IN (SELECT G_NUMERO_GUIA FROM SIG_COL_LOGISTICA_DW.TMP.MBCORE_GUIAS (NOLOCK))&#xA;)&#xA;--SELECT &#xA;&#xA;UPDATE &#xA;&#x9;TMP &#xA;SET&#xA;&#x9;ID_CLIENTE_PROVISION = ISNULL (CTE.ID_CLIENTE_PROVISION,'NO DISPONIBLE'),&#xA;&#x9;NOMBRE_CLIENTE_PROVISION =  ISNULL (CTE.NOMBRE_CLIENTE_PROVISION,'NO DISPONIBLE')&#xA;FROM &#xA;&#x9;TMP.MBCORE_GUIAS TMP WITH (NOLOCK) INNER JOIN CTE_GUIAS_CLIENTE_PORVISION CTE&#xA;ON&#xA;&#x9;(TMP.G_NUMERO_GUIA = CTE.NUMERO_GUIA)&#xA;&#x9;AND CTE.id=1" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\PASO 37 CLIENTE PROVISION\PASO 37 03 ACTUALIZAR MBCORE CLIENTES PROVISION POR DEFECTO"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{09654661-9D49-456F-80FE-2657D6BD4C8F}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="PASO 37 03 ACTUALIZAR MBCORE CLIENTES PROVISION POR DEFECTO"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="WITH CTE_GUIAS_CLIENTE_PORVISION&#xA;  (&#xA;  id,&#xA;&#x9;NUMERO_GUIA,&#xA;&#x9;ID_CLIENTE_PROVISION, &#xA;&#x9;NOMBRE_CLIENTE_PROVISION&#xA;  )&#xA;  AS&#xA;  (&#xA;  SELECT&#x9;ROW_NUMBER ( )   OVER ( PARTITION BY G.NUMERO_GUIA order by G.FECHA_MODIFICACION_DG desc )  id,  &#xA;&#x9;&#x9;&#x9;G.NUMERO_GUIA,&#xA;&#x9;&#x9;&#x9;G.ID_CLIENTE as ID_CLIENTE_PROVISION,&#xA;&#x9;&#x9;&#x9;CLIE.NOMBRE_CLIENTE as NOMBRE_CLIENTE_PROVISION&#xA;  FROM/*         */    SIG_COLOMBIA_DW.LOG.GUIAS  G WITH(NOLOCK)&#xA;  --LEFT JOIN SIG_COL_LOGISTICA_DW.DIM.MOXP_CLIENTES CLIE  WITH(NOLOCK)&#xA;  LEFT JOIN  PAR.CLIENTES CLIE  WITH(NOLOCK)&#xA;  ON CLIE.ID_CLIENTE  =  G.ID_CLIENTE ----COLLATE SQL_Latin1_General_CP850_CI_AI                /    COLLATE SQL_Latin1_General_CP850_CI_AI&#xA;  WHERE [NUMERO_GUIA] IN (SELECT G_NUMERO_GUIA FROM SIG_COL_LOGISTICA_DW.TMP.MBCORE_GUIAS (NOLOCK))&#xA;)&#xA;--SELECT &#xA;&#xA;UPDATE &#xA;&#x9;TMP.MBCORE_GUIAS&#xA;SET&#xA;&#x9;ID_CLIENTE_PROVISION = ISNULL (CTE.ID_CLIENTE_PROVISION,'NO DISPONIBLE'),&#xA;&#x9;NOMBRE_CLIENTE_PROVISION =  ISNULL (CTE.NOMBRE_CLIENTE_PROVISION,'NO DISPONIBLE')&#xA;FROM &#xA;&#x9;TMP.MBCORE_GUIAS TMP WITH (NOLOCK) INNER JOIN CTE_GUIAS_CLIENTE_PORVISION CTE&#xA;ON &#xA;&#x9;TMP.G_NUMERO_GUIA = CTE.NUMERO_GUIA&#xA;&#x9;AND CTE.id=1" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
      </DTS:Executables>
