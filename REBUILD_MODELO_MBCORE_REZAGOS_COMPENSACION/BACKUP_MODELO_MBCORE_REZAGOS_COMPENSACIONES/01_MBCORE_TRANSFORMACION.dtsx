          DTS:ObjectName="PASO 30 02 ACTUALIZAR PESO FISICO E_ULTIMO"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="WITH CTE_PESO_E&#xA;(&#xA;&#x9;NUMERO_GUIA,&#xA;&#x9;PESO_ENVIO&#xA;)AS&#xA;(&#xA;&#x9;SELECT NUMERO_GUIA,PESO_ENVIO FROM(&#xA;&#x9;&#x9;&#x9;&#x9;SELECT &#xA;&#x9;&#x9;&#x9;&#x9;ROW_NUMBER ( )   OVER ( PARTITION BY NUMERO_GUIA order by FECHA_HORA_MOVIMIENTO desc )  id, &#xA;&#x9;&#x9;&#x9;&#x9;NUMERO_GUIA,&#xA;&#x9;&#x9;&#x9;&#x9;ID_PROCESO,&#xA;&#x9;&#x9;&#x9;&#x9;PESO_ENVIO,&#xA;&#x9;&#x9;&#x9;&#x9;FECHA_HORA_MOVIMIENTO &#xA;&#x9;&#x9;&#x9;&#x9;FROM/*         */    SIG_COLOMBIA_DW.LOG.SEGUIMIENTO_ENVIO  (NOLOCK) WHERE NUMERO_GUIA IN (SELECT DISTINCT GUI.G_NUMERO_GUIA FROM  TMP.MBCORE_GUIAS GUI (NOLOCK))&#x9;&#x9;&#x9; &#xA;&#x9;&#x9;&#x9;&#x9;) CTE &#xA;&#x9;WHERE CTE.id=1&#xA;) --select * from CTE_PESO_E&#xA;&#xA;UPDATE &#xA;&#x9;TMP.MBCORE_GUIAS&#xA;SET &#xA;&#x9;PESO_FISICO_E = CTE_PESO_E.PESO_ENVIO&#xA;FROM &#xA;&#x9; TMP.MBCORE_GUIAS TMP&#xA;&#x9;,CTE_PESO_E&#xA;WHERE &#xA;&#x9;TMP.G_NUMERO_GUIA = CTE_PESO_E.NUMERO_GUIA&#xA;GO&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
