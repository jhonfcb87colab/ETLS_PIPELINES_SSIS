          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="WITH CTE_FECHA_BOD_Compensaciones&#xA;(&#xA;&#x9;id,&#x9;&#xA;&#x9;NUMERO_GUIA,&#x9;&#xA;&#x9;ID_DIVISION_DESTINO,&#x9;&#xA;&#x9;NOMBRE_DIVISION,&#x9;&#xA;&#x9;FECHA_HORA_MOVIMIENTO&#xA;) AS&#xA;(&#xA;&#x9;SELECT &#xA;&#x9;ROW_NUMBER ( )   OVER ( PARTITION BY &#xA;&#x9;NUMERO_GUIA,ID_DIVISION_DESTINO,NOMBRE_DIVISION&#xA;&#x9;order by FECHA_HORA_MOVIMIENTO desc )  id,&#xA;&#x9;* FROM (&#xA;&#x9;&#x9;&#x9;SELECT &#xA;&#x9;&#x9;&#x9;&#x9;SEG.NUMERO_GUIA,DOC.ID_DIVISION_DESTINO,DIV.NOMBRE_DIVISION, SEG.FECHA_HORA_MOVIMIENTO FROM/*         */    SIG_COLOMBIA_DW.LOG.SEGUIMIENTO_ENVIO  SEG&#xA;&#x9;&#x9;&#x9;INNER JOIN /*         */    SIG_COLOMBIA_DW.LOG.DOCUMENTOS DOC WITH (NOLOCK) &#xA;&#x9;&#x9;&#x9;ON (DOC.ID_PROCESO=SEG.ID_PROCESO AND DOC.NUMERO_MOVIMI=SEG.NUMERO_MOVIMI  AND  DOC.CONSECUT_MOVIMI=SEG.CONSECUT_MOVIMI)&#xA;&#x9;&#x9;&#x9;INNER JOIN PAR.DIVISIONES DIV WITH (NOLOCK)&#xA;&#x9;&#x9;&#x9;ON DIV.ID_DIVISION=DOC.ID_DIVISION_DESTINO AND DOC.ID_CIUDAD_DESTINO=DIV.ID_CIUDAD &#xA;&#x9;&#x9;&#x9;WHERE SEG.NUMERO_GUIA IN (SELECT DISTINCT GUI.G_NUMERO_GUIA FROM  TMP.MBCORE_GUIAS GUI (NOLOCK)   WHERE GUI.CR_ID_APLICA_COMPENSACIONES=1   )&#xA;&#x9;&#x9;&#x9;AND DIV.NOMBRE_DIVISION LIKE '%COMPENSACION%'&#xA;&#x9;&#x9;&#x9;AND DOC.ID_PROCESO=8&#xA;&#x9;) CTEDS&#xA;)&#xA;--SELECT * FROM CTE_FECHA_BOD_Compensaciones WHERE id=1&#xA;UPDATE &#xA;&#x9;TMP&#xA;SET&#xA;&#x9; FECHA_BOD_Compensaciones = ISNULL (CTE.FECHA_HORA_MOVIMIENTO,'1900-01-01')&#xA;FROM &#xA;&#x9;TMP.MBCORE_GUIAS TMP WITH (NOLOCK)&#xA;&#x9;INNER JOIN CTE_FECHA_BOD_Compensaciones CTE&#xA;ON &#xA;&#x9;TMP.G_NUMERO_GUIA = CTE.NUMERO_GUIA&#xA;&#x9;AND CTE.id=1" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\PASO 30 ACTUALIZAR CAMPOS NUEVOS MBCORE\PASO 30 09 ACTUALIZAR Numero_veces_compensaicones"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{38CD8297-5FBB-4AC3-BD8B-ED55915B6A4D}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="PASO 30 09 ACTUALIZAR Numero_veces_compensaicones"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="WITH CTE_Numero_veces_compensaicones&#xA;(&#xA;&#x9;NUMERO_GUIA,&#x9;&#xA;&#x9;Numero_veces_compensaicones&#x9;&#xA;) AS&#xA;(&#xA;&#x9;SELECT NUMERO_GUIA, count(ID_DIVISION_DESTINO) Numero_veces_compensaicones FROM &#xA;&#x9;(&#xA;&#x9;&#x9;SELECT &#xA;&#x9;&#x9;ROW_NUMBER ( )   OVER ( PARTITION BY &#xA;&#x9;&#x9;NUMERO_GUIA,ID_DIVISION_DESTINO,NOMBRE_DIVISION,FECHA_HORA_MOVIMIENTO&#xA;&#x9;&#x9;order by FECHA_HORA_MOVIMIENTO desc )  id,&#xA;&#x9;&#x9;* FROM (&#xA;&#x9;&#x9;&#x9;&#x9;SELECT &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;SEG.NUMERO_GUIA,DOC.ID_DIVISION_DESTINO,DIV.NOMBRE_DIVISION, SEG.FECHA_HORA_MOVIMIENTO FROM/*         */    SIG_COLOMBIA_DW.LOG.SEGUIMIENTO_ENVIO  SEG&#xA;&#x9;&#x9;&#x9;&#x9;INNER JOIN /*         */    SIG_COLOMBIA_DW.LOG.DOCUMENTOS DOC WITH (NOLOCK) &#xA;&#x9;&#x9;&#x9;&#x9;ON (DOC.ID_PROCESO=SEG.ID_PROCESO AND DOC.NUMERO_MOVIMI=SEG.NUMERO_MOVIMI  AND  DOC.CONSECUT_MOVIMI=SEG.CONSECUT_MOVIMI)&#xA;&#x9;&#x9;&#x9;&#x9;INNER JOIN PAR.DIVISIONES DIV WITH (NOLOCK)&#xA;&#x9;&#x9;&#x9;&#x9;ON DIV.ID_DIVISION=DOC.ID_DIVISION_DESTINO AND DOC.ID_CIUDAD_DESTINO=DIV.ID_CIUDAD &#xA;&#x9;&#x9;&#x9;&#x9;WHERE SEG.NUMERO_GUIA &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;IN (SELECT DISTINCT GUI.G_NUMERO_GUIA FROM  TMP.MBCORE_GUIAS GUI (NOLOCK) WHERE GUI.CR_ID_APLICA_COMPENSACIONES=1)&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;--IN (34091499,239616019)  --,279923419,282008669,282233749,282233750&#xA;&#x9;&#x9;&#x9;&#x9;AND DIV.NOMBRE_DIVISION LIKE '%COMPENSACION%'&#xA;&#x9;&#x9;&#x9;&#x9;AND DOC.ID_PROCESO=8&#xA;&#x9;&#x9;) CTEDS_1&#xA;&#x9;)CTEDS_2 WHERE id=1 group by NUMERO_GUIA&#xA;)&#xA;--SELECT * FROM CTE_Numero_veces_compensaicones&#xA;UPDATE &#xA;&#x9;TMP.MBCORE_GUIAS&#xA;SET &#xA;&#x9; Numero_veces_compensaicones = ISNULL(CTE.Numero_veces_compensaicones,0)&#xA;FROM &#xA;&#x9;TMP.MBCORE_GUIAS TMP WITH (NOLOCK)&#xA;&#x9;INNER JOIN CTE_Numero_veces_compensaicones CTE&#xA;ON &#xA;&#x9;TMP.G_NUMERO_GUIA = CTE.NUMERO_GUIA" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
