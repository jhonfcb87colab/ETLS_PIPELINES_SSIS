          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="UPDATE&#xA; TMP.MBCORE_GUIAS&#xA;SET&#xA; [CR_BODEGA_UBICACION] = ISNULL(DIV.[NOMBRE_DIVISION],'NO DISPONIBLE')&#xA;FROM &#xA; TMP.MBCORE_GUIAS TMP&#xA;INNER JOIN &#xA; [PAR].[DIVISIONES] DIV WITH(NOLOCK)&#xA;ON &#xA; TMP.G_ID_BODEGA_ULTM_MOVI = CONVERT(VARCHAR,DIV.[ID_PAIS]) + '-' + CONVERT(VARCHAR,DIV.[ID_CIUDAD]) + '-' + CONVERT(VARCHAR,DIV.[ID_DIVISION])&#xA;&#xA;GO&#xA;&#xA;WITH CTE_REGIONAL_UBICACION&#xA;(&#xA;&#x9; G_NUMERO_GUIA&#xA;&#x9;,REGIONAL&#xA;&#x9;,CIUDAD&#xA;&#x9;,DEPARTAMENTO&#xA;)&#xA;AS&#xA;&#x9;(&#xA;&#x9;&#x9;SELECT&#xA;&#x9;&#x9;&#x9; TMP.G_NUMERO_GUIA &#xA;&#x9;&#x9;&#x9;,GEO.REGIONAL&#xA;&#x9;&#x9;&#x9;,GEO.CIUDAD&#xA;&#x9;&#x9;&#x9;,GEO.DEPARTAMENTO&#xA;&#x9;&#x9;FROM &#xA;&#x9;&#x9;&#x9;TMP.MBCORE_GUIAS TMP WITH (NOLOCK)&#xA;&#x9;&#x9;INNER JOIN  &#xA;&#x9;&#x9;&#x9;DIM.GEOGRAFIA GEO WITH (NOLOCK)&#xA;&#x9;&#x9;ON &#xA;&#x9;&#x9;&#x9;TMP.G_ID_CIUDAD_DESTINO = GEO.ID_CIUDAD&#xA;&#x9;)&#xA;UPDATE &#xA;&#x9;TMP&#xA;SET&#xA;&#x9; [CR_REGIONAL_UBICACION] = ISNULL(CTE.REGIONAL,'NO DISPONIBLE')&#xA;&#x9; &#x9;&#xA;FROM &#xA;&#x9;TMP.MBCORE_GUIAS TMP WITH (NOLOCK) INNER JOIN CTE_REGIONAL_UBICACION CTE&#xA;ON&#xA;&#x9;TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\38 ACTUALIZACION UBICACION BODEGA Y REGIONAL INVENATARIOS FISICOS\Paso 38 01 EXTRAE MBCORE BODEGA Y REGIONAL"
