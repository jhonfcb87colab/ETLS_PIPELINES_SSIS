          DTS:ObjectName="PASO 04 06 QUITAR DUPLICADOS"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="WITH CTE&#xA;(&#xA;&#x9; ID&#xA;&#x9;,[NUMERO_GUIA]&#xA;&#x9;,[ID_PROCESO]&#xA;&#x9;,[ID_CONCEPTO]&#xA;&#x9;,[FECHA_HORA_MOVIMIENTO]&#xA;&#x9;,[NUMERO_MOVIMI]&#xA;&#x9;,[CONSECUT_MOVIMI]&#xA;)&#xA;&#x9;AS&#xA;&#x9;(&#xA;&#x9;&#x9;SELECT &#xA;&#x9;&#x9;&#x9; ROW_NUMBER() OVER(PARTITION BY [ID_PROCESO], [NUMERO_MOVIMI], [CONSECUT_MOVIMI], [NUMERO_GUIA] ORDER BY [FECHA_HORA_MOVIMIENTO]) ID&#xA;&#x9;&#x9;&#x9;,[NUMERO_GUIA]&#xA;&#x9;&#x9;&#x9;,[ID_PROCESO]&#xA;&#x9;&#x9;&#x9;,CASE WHEN ISNULL(CONVERT(INT,[ID_CONCEPTO]),-888) = 0 THEN -888 ELSE ISNULL(CONVERT(INT,[ID_CONCEPTO]),-888) END ID_CONCEPTO&#xA;&#x9;&#x9;&#x9;,[FECHA_HORA_MOVIMIENTO]&#xA;&#x9;&#x9;&#x9;,[NUMERO_MOVIMI]&#xA;&#x9;&#x9;&#x9;,[CONSECUT_MOVIMI]&#xA;&#x9;&#x9;FROM &#xA;&#x9;&#x9;&#x9;[TMP].[MBCORE_GUIAS_06] WITH(NOLOCK)&#xA;&#x9;)&#xA;INSERT INTO &#xA;&#x9;TMP.MBCORE_GUIAS_07&#xA;(&#xA;&#x9; NUMERO_GUIA&#xA;&#x9;,ID_PROCESO&#xA;&#x9;,ID_CONCEPTO&#xA;&#x9;,FECHA_HORA_MOVIMIENTO&#xA;&#x9;,NUMERO_MOVIMI&#xA;&#x9;,CONSECUT_MOVIMI&#xA;)&#xA;SELECT&#xA;&#x9; [NUMERO_GUIA]&#xA;&#x9;,[ID_PROCESO]&#xA;&#x9;,[ID_CONCEPTO]&#xA;&#x9;,[FECHA_HORA_MOVIMIENTO]&#xA;&#x9;,[NUMERO_MOVIMI]&#xA;&#x9;,[CONSECUT_MOVIMI]&#xA;FROM&#xA;&#x9;CTE&#xA;WHERE&#xA;&#x9;ID = 1&#xA;/*&#xA;ORDER  BY  &#xA;&#x9; [NUMERO_GUIA]&#xA;&#x9;,[FECHA_HORA_MOVIMIENTO]&#xA;*/" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
      </DTS:Executables>
