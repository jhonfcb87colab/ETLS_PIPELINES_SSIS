              SQLTask:SqlStatementSource="WITH CTE&#xA;(&#xA;&#x9; G_NUMERO_GUIA&#xA;&#x9;,TELEFONO_DESTINA_GUIA&#xA;)&#xA;AS&#xA;(&#xA;SELECT&#xA;&#x9; TMP.G_NUMERO_GUIA&#xA;&#x9;,ISNULL(GUI.TELEFONO_DESTINA_GUIA,'NO DISPONIBLE') AS  TELEFONO_DESTINA_GUIA&#xA;FROM &#xA;&#x9;TMP.MBCORE_GUIAS TMP WITH(NOLOCK)&#xA;INNER JOIN &#xA;&#x9;SIG_COLOMBIA_DW.LOG.GUIAS  GUI WITH (NOLOCK) &#xA;ON&#xA;&#x9;TMP.G_NUMERO_GUIA = GUI.NUMERO_GUIA&#xA;)&#xA;UPDATE &#xA;&#x9;TMP.MBCORE_GUIAS&#xA;SET &#xA;&#x9;TELEFONO_DESTINATARIO = CTE.TELEFONO_DESTINA_GUIA&#xA;FROM &#xA;&#x9; TMP.MBCORE_GUIAS TMP&#xA;&#x9;,CTE&#xA;WHERE &#xA;&#x9;TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\PASO 30 ACTUALIZAR CAMPOS NUEVOS MBCORE\PASO 30 02 ACTUALIZAR PESO FISICO E_ULTIMO"
