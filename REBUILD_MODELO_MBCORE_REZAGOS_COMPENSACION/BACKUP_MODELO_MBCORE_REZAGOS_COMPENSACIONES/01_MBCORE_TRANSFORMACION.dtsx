          SQLTask:SqlStatementSource="UPDATE &#xA;&#x9;TMP.MBCORE_GUIAS&#xA;SET&#xA;&#x9; GR_ESTADO_RECAUDO = 'SI'&#xA;WHERE&#xA;&#x9;TC_PROCESO &lt;&gt; -888&#xA;AND&#xA;GRIR_NUMERO_ORDEN_SERVICIO &lt;&gt; 'NO DISPONIBLE'" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
