              SQLTask:SqlStatementSource="WITH CTE_NOMBRE_CLIENTE&#xA;(&#xA;&#x9; G_NUMERO_GUIA&#xA;&#x9;,NOMBRE_CLIENTE&#xA;&#x9;&#xA;)&#xA;AS&#xA;&#x9;(&#xA;&#x9;&#x9;SELECT&#xA;&#x9;&#x9;&#x9; TMP.G_NUMERO_GUIA &#xA;&#x9;&#x9;&#x9;,CLI.RAZON_SOCIAL_CORTA&#xA;&#x9;&#x9;&#x9;&#xA;&#x9;&#x9;FROM &#xA;&#x9;&#x9;&#x9;TMP.MBCORE_GUIAS TMP WITH (NOLOCK)&#xA;&#x9;&#x9;INNER JOIN &#xA;&#x9;&#x9;&#x9;PAR.CLIENTES CLI WITH (NOLOCK)&#xA;&#x9;&#x9;ON&#xA;&#x9;&#x9;&#x9;TMP.G_ID_CLIENTE = CLI.ID_CLIENTE&#xA;&#x9;&#x9;&#xA;&#x9;)&#xA;UPDATE &#xA;&#x9;TMP&#xA;SET&#xA;&#x9; G_CLIENTE = ISNULL (CASE WHEN CTE.NOMBRE_CLIENTE='' THEN NULL ELSE CTE.NOMBRE_CLIENTE END,'NO DISPONIBLE')&#xA;&#x9;&#xA;FROM &#xA;&#x9;TMP.MBCORE_GUIAS TMP WITH (NOLOCK) &#xA;&#x9;INNER JOIN CTE_NOMBRE_CLIENTE CTE&#xA;ON &#xA;&#x9;TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
