          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="&#xA;-----------CTE_GEOGRAFIA_ULTIMO MOVIMIENTO----------------------------------&#xA;&#xA;&#xA;&#xA;WITH CTE_GEOGRAFIA_ULTIMO_MOVIMIENTO&#xA;(&#xA;&#x9; G_NUMERO_GUIA&#xA;&#x9;,REGIONAL&#xA;&#x9;,CIUDAD&#xA;&#x9;,DEPARTAMENTO&#xA;)&#xA;AS&#xA;&#x9;(&#xA;&#x9;&#x9;SELECT&#xA;&#x9;&#x9;&#x9; TMP.G_NUMERO_GUIA &#xA;&#x9;&#x9;&#x9;,GEO.REGIONAL&#xA;&#x9;&#x9;&#x9;,GEO.CIUDAD&#xA;&#x9;&#x9;&#x9;,GEO.DEPARTAMENTO&#xA;&#x9;&#x9;FROM &#xA;&#x9;&#x9;&#x9;TMP.MBCORE_GUIAS TMP WITH (NOLOCK)&#xA;&#x9;&#x9;INNER JOIN  &#xA;&#x9;&#x9;&#x9;DIM.GEOGRAFIA GEO WITH (NOLOCK)&#xA;&#x9;&#x9;ON &#xA;&#x9;&#x9;&#x9;TMP.DOC_ID_CIUDAD_ULTI_MOVI = GEO.ID_CIUDAD&#xA;&#x9;)&#xA;UPDATE &#xA;&#x9;TMP&#xA;SET&#xA;&#x9; DOC_CIUDAD_ULTI_MOVI = ISNULL(CTE.CIUDAD,'NO DISPONIBLE')&#xA;&#x9; ,DOC_DEPT_ULTI_MOVI = ISNULL(CTE.DEPARTAMENTO,'NO DISPONIBLE')&#xA;&#x9; ,DOC_REGIONAL_ULTI_MOVI = ISNULL(CTE.REGIONAL,'NO DISPONIBLE')&#xA;&#x9; &#x9;&#xA;FROM &#xA;&#x9;TMP.MBCORE_GUIAS TMP WITH (NOLOCK) &#xA;&#x9;INNER JOIN CTE_GEOGRAFIA_ULTIMO_MOVIMIENTO CTE&#xA;ON &#xA;&#x9;TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA&#xA;GO&#xA;&#xA;-----------CTE_GEOGRAFIA_UBICACION----------------------------------&#xA;&#xA;&#xA;&#xA;WITH CTE_GEOGRAFIA_UBICACION&#xA;(&#xA;&#x9; G_NUMERO_GUIA&#xA;&#x9;,REGIONAL&#xA;&#x9;,CIUDAD&#xA;&#x9;,DEPARTAMENTO&#xA;)&#xA;AS&#xA;&#x9;(&#xA;&#x9;&#x9;SELECT&#xA;&#x9;&#x9;&#x9; TMP.G_NUMERO_GUIA &#xA;&#x9;&#x9;&#x9;,GEO.REGIONAL&#xA;&#x9;&#x9;&#x9;,GEO.CIUDAD&#xA;&#x9;&#x9;&#x9;,GEO.DEPARTAMENTO&#xA;&#x9;&#x9;FROM &#xA;&#x9;&#x9;&#x9;TMP.MBCORE_GUIAS TMP WITH (NOLOCK)&#xA;&#x9;&#x9;INNER JOIN  &#xA;&#x9;&#x9;&#x9;DIM.GEOGRAFIA GEO WITH (NOLOCK)&#xA;&#x9;&#x9;ON &#xA;&#x9;&#x9;&#x9;TMP.G_ID_CIUDAD_ORIGEN = GEO.ID_CIUDAD&#xA;&#x9;)&#xA;UPDATE &#xA;&#x9;TMP&#xA;SET&#xA;&#x9; G_CIUDAD_ORIGEN = ISNULL(CTE.CIUDAD,'NO DISPONIBLE')&#xA;&#x9; ,G_DEPARTAMENTO_ORIGEN = ISNULL(CTE.DEPARTAMENTO,'NO DISPONIBLE')&#xA;&#x9; ,G_REGIONAL_ORIGEN = ISNULL(CTE.REGIONAL,'NO DISPONIBLE')&#xA;&#x9; &#x9;&#xA;FROM &#xA;&#x9;TMP.MBCORE_GUIAS TMP WITH (NOLOCK) &#xA;&#x9;INNER JOIN CTE_GEOGRAFIA_UBICACION CTE&#xA;ON &#xA;&#x9;TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA&#xA;GO&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
