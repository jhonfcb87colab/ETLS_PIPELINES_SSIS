            <DTS:Executable
              DTS:refId="Package\38 ACTUALIZACION UBICACION BODEGA Y REGIONAL INVENATARIOS FISICOS\39 03 ACTUALIZACION BODEGA Y REGIONAL UBICACION INVENARIO FISICO\Paso 39 03 EXTRAE MBCORE BODEGA Y REGIONAL TB DG NOVEDAD"
              DTS:CreationName="Microsoft.Pipeline"
              DTS:Description="Data Flow Task"
              DTS:DTSID="{4BF8326E-35E2-4CFC-A29D-60E959BAFA20}"
              DTS:ExecutableType="Microsoft.Pipeline"
              DTS:LocaleID="-1"
              DTS:ObjectName="Paso 39 03 EXTRAE MBCORE BODEGA Y REGIONAL TB DG NOVEDAD"
              DTS:TaskContact="Performs high-performance data extraction, transformation and loading;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1">
              <DTS:Variables />
