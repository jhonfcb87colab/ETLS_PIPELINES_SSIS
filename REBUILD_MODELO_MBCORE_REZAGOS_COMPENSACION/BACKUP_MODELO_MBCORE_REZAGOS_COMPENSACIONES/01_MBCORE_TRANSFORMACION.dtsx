        <DTS:Executable
          DTS:refId="Package\PASO 32 ACTUALIZAR MBCORE DURACION ALMA REZAGOS\PASO 32 03 ACTUALIZAR CALCULO DURACION EN REZAGOS"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{C106FDFF-4228-4EED-AC66-721CB80173C0}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="PASO 32 03 ACTUALIZAR CALCULO DURACION EN REZAGOS"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="WITH CTE_DURACION_ALMA_REZAGOS&#xA;(&#xA;&#x9;NUMERO_GUIA,&#xA;&#x9;DURACION&#xA;) AS&#xA;(&#xA;&#x9;SELECT PR7.NUMERO_GUIA,&#xA;&#x9;&#x9;CASE WHEN (PR8.[1]) IS NULL OR  (PR7.[1]) IS NULL THEN 0 ELSE  CONVERT(FLOAT,PR8.[1]-PR7.[1]) END &#xA;&#x9;&#x9;+CASE WHEN (PR8.[2]) IS NULL OR  (PR7.[2]) IS NULL THEN 0 ELSE  CONVERT(FLOAT,PR8.[2]-PR7.[2]) END &#xA;&#x9;&#x9;+CASE WHEN (PR8.[3]) IS NULL OR  (PR7.[3]) IS NULL THEN 0 ELSE  CONVERT(FLOAT,PR8.[3]-PR7.[3]) END &#xA;&#x9;&#x9;+CASE WHEN (PR8.[4]) IS NULL OR  (PR7.[4]) IS NULL THEN 0 ELSE  CONVERT(FLOAT,PR8.[4]-PR7.[4]) END &#xA;&#x9;&#x9;+CASE WHEN (PR8.[5]) IS NULL OR  (PR7.[5]) IS NULL THEN 0 ELSE  CONVERT(FLOAT,PR8.[5]-PR7.[5]) END &#xA;&#x9;&#x9;+CASE WHEN (PR8.[6]) IS NULL OR  (PR7.[6]) IS NULL THEN 0 ELSE  CONVERT(FLOAT,PR8.[6]-PR7.[6]) END &#xA;&#x9;&#x9;+CASE WHEN (PR8.[7]) IS NULL OR  (PR7.[7]) IS NULL THEN 0 ELSE  CONVERT(FLOAT,PR8.[7]-PR7.[7]) END &#xA;&#x9;&#x9;+CASE WHEN (PR8.[8]) IS NULL OR  (PR7.[8]) IS NULL THEN 0 ELSE  CONVERT(FLOAT,PR8.[8]-PR7.[8]) END &#xA;&#x9;&#x9;+CASE WHEN (PR8.[9]) IS NULL OR  (PR7.[9]) IS NULL THEN 0 ELSE  CONVERT(FLOAT,PR8.[9]-PR7.[9]) END &#xA;&#x9;&#x9;+CASE WHEN (PR8.[10]) IS NULL OR  (PR7.[10]) IS NULL THEN 0 ELSE  CONVERT(FLOAT,PR8.[10]-PR7.[10]) END &#xA;&#x9;AS DURACION&#xA;&#x9;FROM [TMP].[MBCORE_GUIAS_22] PR7&#xA;&#x9;INNER JOIN [TMP].[MBCORE_GUIAS_23] PR8&#xA;&#x9;ON PR7.NUMERO_GUIA=PR8.NUMERO_GUIA&#xA;)&#xA;--SELECT NUMERO_GUIA,ROUND(DURACION,2) DURACION FROM CTE_DURACION_ALMA_REZAGOS&#xA;&#xA;UPDATE &#xA;&#x9;TMP&#xA;SET &#xA;&#x9; DURACION_REZAGOS = CASE WHEN ROUND(ISNULL(CTE.DURACION,0),2)&lt;0 THEN 0 ELSE ROUND(ISNULL(CTE.DURACION,0),2) END&#xA;FROM &#xA;&#x9;TMP.MBCORE_GUIAS TMP WITH (NOLOCK) &#xA;               INNER JOIN  CTE_DURACION_ALMA_REZAGOS CTE&#xA;ON &#xA;&#x9;TMP.G_NUMERO_GUIA = CTE.NUMERO_GUIA&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
      </DTS:Executables>
