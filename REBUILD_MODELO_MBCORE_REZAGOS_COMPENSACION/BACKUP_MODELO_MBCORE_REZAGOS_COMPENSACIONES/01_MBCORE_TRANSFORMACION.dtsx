            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="WITH CTE_REGIMEN&#xA;(&#xA;&#x9; G_NUMERO_GUIA&#xA;&#x9;,REGIMEN&#xA;&#x9;&#xA;)&#xA;AS&#xA;&#x9;(&#xA;&#x9;&#x9;SELECT&#xA;&#x9;&#x9;&#x9; TMP.G_NUMERO_GUIA&#xA;&#x9;&#x9;&#x9;,CASE WHEN PESO_FISICO_E IS NULL THEN 'NO DISPONIBLE'&#xA;&#x9;&#x9;&#x9;WHEN PESO_FISICO_R&gt;5 THEN 'TRANSPORTE CARGA'&#xA;&#x9;&#x9;&#x9;WHEN PESO_FISICO_R&lt;=5 THEN  'Mensajería Expresa' ELSE   'NO DISPONIBLE' END REGIMEN&#x9;&#xA;&#x9;&#x9;FROM &#xA;&#x9;&#x9;&#x9;TMP.MBCORE_GUIAS TMP WITH (NOLOCK)&#x9;&#x9;&#x9;&#xA;&#x9;) --select * from CTE_REGIMEN&#xA;UPDATE &#xA;&#x9;TMP.MBCORE_GUIAS&#xA;SET&#xA;&#x9; REGIMEN = ISNULL (CTE.REGIMEN,'NO DISPONIBLE')&#xA;&#x9;&#xA;FROM &#xA;&#x9;TMP.MBCORE_GUIAS TMP WITH (NOLOCK) &#xA;&#x9;INNER JOIN  CTE_REGIMEN CTE&#xA;ON &#xA;&#x9;TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA&#xA;&#xA;&#xA;&#xA;&#xA;/*&#xA;WITH CTE_REGIMEN&#xA;(&#xA;&#x9; G_NUMERO_GUIA&#xA;&#x9;,REGIMEN&#xA;&#x9;&#xA;)&#xA;AS&#xA;&#x9;(&#xA;&#x9;&#x9;SELECT&#xA;&#x9;&#x9;&#x9; TMP.G_NUMERO_GUIA&#xA;&#x9;&#x9;&#x9;,CASE WHEN PESO_FISICO_E IS NULL THEN 'NO DISPONIBLE'&#xA;&#x9;&#x9;&#x9;WHEN PESO_FISICO_R&gt;5 THEN 'TRANSPORTE CARGA'&#xA;&#x9;&#x9;&#x9;WHEN PESO_FISICO_R&lt;=5 THEN  'Mensajería Expresa' ELSE   'NO DISPONIBLE' END REGIMEN&#x9;&#xA;&#x9;&#x9;FROM &#xA;&#x9;&#x9;&#x9;TMP.MBCORE_GUIAS TMP WITH (NOLOCK)&#x9;&#x9;&#x9;&#xA;&#x9;) --select * from CTE_REGIMEN&#xA;UPDATE &#xA;&#x9;TMP.MBCORE_GUIAS&#xA;SET&#xA;&#x9; REGIMEN = ISNULL (CTE_REGIMEN.REGIMEN,'NO DISPONIBLE')&#xA;&#x9;&#xA;FROM &#xA;&#x9;TMP.MBCORE_GUIAS TMP WITH (NOLOCK),CTE_REGIMEN&#xA;WHERE &#xA;&#x9;TMP.G_NUMERO_GUIA = CTE_REGIMEN.G_NUMERO_GUIA&#xA;*/" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
