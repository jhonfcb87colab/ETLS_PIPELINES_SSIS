          DTS:LocaleID="-1"
          DTS:ObjectName="39 03 ACTUALIZACION BODEGA Y REGIONAL UBICACION INVENARIO FISICO">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:Executables>
            <DTS:Executable
              DTS:refId="Package\38 ACTUALIZACION UBICACION BODEGA Y REGIONAL INVENATARIOS FISICOS\39 03 ACTUALIZACION BODEGA Y REGIONAL UBICACION INVENARIO FISICO\Paso 39 01 ACTUALIZAR MBCORE BODEGA Y REGIONAL CON REGLA DE NEGOCIO HU_150911"
              DTS:CreationName="Microsoft.ExecuteSQLTask"
              DTS:Description="Execute SQL Task"
              DTS:DTSID="{AED1C8FA-2F9F-4A45-A4C1-337FFC66BBFD}"
              DTS:ExecutableType="Microsoft.ExecuteSQLTask"
              DTS:LocaleID="-1"
              DTS:ObjectName="Paso 39 01 ACTUALIZAR MBCORE BODEGA Y REGIONAL CON REGLA DE NEGOCIO HU_150911"
              DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
              DTS:ThreadHint="0">
              <DTS:Variables />
              <DTS:LoggingOptions
                DTS:FilterKind="0" />
              <DTS:ObjectData>
                <SQLTask:SqlTaskData
                  SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
                  SQLTask:SqlStatementSource="&#xA;WITH CTE_ULTIMA_BODEGA_Y_REGIONAL&#xA;(&#xA;id, &#xA;NUMERO_GUIA, &#xA;BODEGA_UBICACION_ENVIO,&#xA;REGIONAL_UBICACION_ENVIO&#xA;) AS (&#xA; SELECT &#xA; ROW_NUMBER ( )   OVER ( PARTITION BY NUMERO_GUIA order by FECHA_HORA_MOVIMIENTO desc )  ID, &#xA;&#x9;NUMERO_GUIA, &#xA;&#x9;BODEGA_UBICACION_ENVIO,&#xA;&#x9;REGIONAL_UBICACION_ENVIO&#xA;   FROM [TMP].[MBCORE_GUIAS_27] WITH (NOLOCK)&#xA;) &#xA;--SELECT * FROM CTE_ULTIMA_BODEGA_Y_REGIONAL WHERE ID=1&#xA;&#xA;UPDATE TMP&#xA;--SELECT CTE.NUMERO_GUIA,&#xA;SET&#xA;[CR_BODEGA_UBICACION] = ISNULL (CTE.BODEGA_UBICACION_ENVIO,'NO DISPONIBLE'),&#xA;[CR_REGIONAL_UBICACION] =  ISNULL (CTE.REGIONAL_UBICACION_ENVIO,'NO DISPONIBLE')&#xA;FROM &#xA; TMP.MBCORE_GUIAS TMP WITH (NOLOCK)&#xA; INNER JOIN CTE_ULTIMA_BODEGA_Y_REGIONAL CTE &#xA; ON TMP.G_NUMERO_GUIA = CTE.NUMERO_GUIA&#xA;WHERE &#xA;  CTE.id=1  AND TMP.CR_ID_APLICA_COMPENSACIONES=1" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
              </DTS:ObjectData>
            </DTS:Executable>
            <DTS:Executable
              DTS:refId="Package\38 ACTUALIZACION UBICACION BODEGA Y REGIONAL INVENATARIOS FISICOS\39 03 ACTUALIZACION BODEGA Y REGIONAL UBICACION INVENARIO FISICO\Paso 39 02 EXTRAE MBCORE BODEGA Y REGIONAL TB LOG"
              DTS:CreationName="Microsoft.Pipeline"
              DTS:Description="Data Flow Task"
              DTS:DTSID="{C0857F84-96F1-408D-8BA8-DB4A449BA618}"
              DTS:ExecutableType="Microsoft.Pipeline"
              DTS:LocaleID="-1"
              DTS:ObjectName="Paso 39 02 EXTRAE MBCORE BODEGA Y REGIONAL TB LOG"
              DTS:TaskContact="Performs high-performance data extraction, transformation and loading;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1">
              <DTS:Variables />
              <DTS:LoggingOptions
                DTS:FilterKind="0" />
              <DTS:ObjectData>
                <pipeline
                  version="1">
                  <components>
                    <component
                      refId="Package\38 ACTUALIZACION UBICACION BODEGA Y REGIONAL INVENATARIOS FISICOS\39 03 ACTUALIZACION BODEGA Y REGIONAL UBICACION INVENARIO FISICO\Paso 39 02 EXTRAE MBCORE BODEGA Y REGIONAL TB LOG\EXTRACCION DE BODEGAS  MOVIMEINTOS"
                      componentClassID="Microsoft.OLEDBSource"
                      contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                      description="OLE DB Source"
                      name="EXTRACCION DE BODEGAS  MOVIMEINTOS"
                      usesDispositions="true"
                      version="7">
                      <properties>
                        <property
                          dataType="System.Int32"
                          description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                          name="CommandTimeout">0</property>
                        <property
                          dataType="System.String"
                          description="Specifies the name of the database object used to open a rowset."
                          name="OpenRowset"></property>
                        <property
                          dataType="System.String"
                          description="Specifies the variable that contains the name of the database object used to open a rowset."
                          name="OpenRowsetVariable"></property>
                        <property
                          dataType="System.String"
                          description="The SQL command to be executed."
                          name="SqlCommand"
                          UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT ROW_NUMBER ( )   OVER ( PARTITION BY GUI.[NUMERO_GUIA] order by SEG.FECHA_HORA_MOVIMIENTO desc )  id,  
		 DIVISION_DESTINO = DIV.[NOMBRE_DIVISION]
		 ,DIVISION_ORIGEN = DIV2.[NOMBRE_DIVISION]
		,GUI.[NUMERO_GUIA]
		,SEG.FECHA_HORA_MOVIMIENTO
		,GUI.FECHA_MODIFICACION_DG
		,REGIO.NOMBRE_REGIONAL AS REGIONAL_DESTINO
		,REGIO2.NOMBRE_REGIONAL AS REGIONAL_ORIGEN
		,CIUD.NOMBRE_CIUDAD AS CIUDAD_DESTINO
		,CIUD2.NOMBRE_CIUDAD AS CIUDAD_ORIGEN
		,SEG.ID_PROCESO
		,PR.NOMBRE_PROCESO_LOG

		--,SEG.NUMERO_MOVIMI
		--,SEG.CONSECUT_MOVIMI
	FROM/*         */    SIG_COLOMBIA_DW.LOG.GUIAS  GUI WITH(NOLOCK)
	INNER JOIN /*         */    SIG_COLOMBIA_DW.LOG.SEGUIMIENTO_ENVIO  SEG WITH (NOLOCK)
	ON GUI.NUMERO_GUIA=SEG.NUMERO_GUIA
	INNER JOIN /*         */    SIG_COLOMBIA_DW.LOG.DOCUMENTOS DOC WITH (NOLOCK) 
	ON (SEG.ID_PROCESO=DOC.ID_PROCESO AND SEG.NUMERO_MOVIMI=DOC.NUMERO_MOVIMI AND SEG.CONSECUT_MOVIMI=DOC.CONSECUT_MOVIMI)
	INNER JOIN PAR.DIVISIONES DIV WITH (NOLOCK)
	ON (DIV.ID_DIVISION=DOC.ID_DIVISION_DESTINO AND DOC.ID_CIUDAD_DESTINO=DIV.ID_CIUDAD) 
	INNER JOIN PAR.DIVISIONES DIV2 WITH (NOLOCK)
	ON (DIV2.ID_DIVISION=DOC.ID_DIVISION_ORIGEN AND DOC.ID_CIUDAD_DIVISION_ORIGEN=DIV2.ID_CIUDAD)
	INNER JOIN PAR.PROCESOS  PR WITH (NOLOCK) ON (SEG.ID_PROCESO=PR.ID_PROCESO)
	INNER JOIN PAR.CIUDADES CIUD WITH (NOLOCK) ON (CIUD.ID_CIUDAD=DOC.ID_CIUDAD_DESTINO)
	INNER JOIN PAR.REGIONALES_PAIS REGIO WITH (NOLOCK) ON (REGIO.ID_REGIONAL=CIUD.ID_REGIONAL)

	INNER JOIN PAR.CIUDADES CIUD2 WITH (NOLOCK) ON (CIUD2.ID_CIUDAD=DOC.ID_CIUDAD_DIVISION_ORIGEN)
	INNER JOIN PAR.REGIONALES_PAIS REGIO2 WITH (NOLOCK) ON (REGIO2.ID_REGIONAL=CIUD2.ID_REGIONAL)
	--INNER JOIN @LOCAL_TABLEVARIABLE_NUMERO_GUIA202208130853 AS GTR
	--ON GRT.NUMERO_GUIA=GUI.NUMERO_GUIA
	WHERE 
       GUI.NUMERO_GUIA
	   IN
	   ( 
                           SELECT DISTINCT GUI.G_NUMERO_GUIA FROM TMP.MBCORE_GUIAS GUI WITH(NOLOCK) WHERE GUI.CR_ID_APLICA_COMPENSACIONES=1
	     ---SELECT DISTINCT NUMERO_GUIA FROM TMP.MBCORE_GUIAS_01
	   )</property>
                        <property
                          dataType="System.String"
                          description="The variable that contains the SQL command to be executed."
                          name="SqlCommandVariable"></property>
                        <property
                          dataType="System.Int32"
                          description="Specifies the column code page to use when code page information is unavailable from the data source."
                          name="DefaultCodePage">1252</property>
                        <property
                          dataType="System.Boolean"
                          description="Forces the use of the DefaultCodePage property value when describing character data."
                          name="AlwaysUseDefaultCodePage">false</property>
                        <property
                          dataType="System.Int32"
                          description="Specifies the mode used to access the database."
                          name="AccessMode"
                          typeConverter="AccessMode">2</property>
                        <property
                          dataType="System.String"
                          description="The mappings between the parameters in the SQL command and variables."
                          name="ParameterMapping">"Parameter0:Input",{054FC50E-A115-44CB-A31F-A6EA6184EB20};"Parameter1:Input",{DFCC1A5B-4FBF-4EB4-AD79-D7374EEA0BDE};</property>
                      </properties>
