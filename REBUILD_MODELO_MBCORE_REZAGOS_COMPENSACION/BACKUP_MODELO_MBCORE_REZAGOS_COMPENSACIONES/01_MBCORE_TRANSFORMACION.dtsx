      <DTS:Executables>
        <DTS:Executable
          DTS:refId="Package\PASO 04 OBTENER PROCESOS Y RECAUDO\PASO 04 01 MBCORE_GUIAS_03_GR"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{05C2EC20-CDC3-423A-A7C7-45AC5D5D242A}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="PASO 04 01 MBCORE_GUIAS_03_GR"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="WITH CTE&#xA;(GR_NUMERO_GUIA&#xA;,ID_TIPO_COBRO&#xA;)AS(&#xA;SELECT &#xA;&#x9; GR.NUMERO_GUIA AS GR_NUMERO_GUIA&#xA;&#x9;,CASE WHEN GR.ID_TIPO_COBRO = 2 THEN 'LPC' ELSE 'COD' END ID_TIPO_COBRO&#xA;FROM &#xA;&#x9;/*         */    SIG_COLOMBIA_DW.[LOG].[GUIA_RECAUDO] GR WITH (NOLOCK)&#xA;INNER JOIN&#xA;&#x9;TMP.MBCORE_GUIAS TMP WITH (NOLOCK)&#xA;on &#xA;GR.NUMERO_GUIA = TMP.G_NUMERO_GUIA&#xA;&#xA;)&#xA;INSERT INTO&#xA;&#x9;TMP.MBCORE_GUIAS_03_GR&#xA;(&#xA;&#x9; [GR_NUMERO_GUIA],&#xA;     [GR_ID_TIPO_COBRO]&#xA;&#xA;)&#xA;SELECT &#xA;&#x9; GR_NUMERO_GUIA&#xA;    ,ID_TIPO_COBRO&#xA;FROM &#xA;CTE&#x9;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\PASO 04 OBTENER PROCESOS Y RECAUDO\PASO 04 02 MBCORE_GUIAS_04_GRINFR"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{8BA77132-F3D5-44A2-BC5A-6781D714BCD3}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="PASO 04 02 MBCORE_GUIAS_04_GRINFR"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="WITH CTE &#xA;(&#xA;&#x9; IR_NUMERO_GUIA&#xA;&#x9;,IR_NUMERO_ORDEN_SERVICIO&#xA;&#x9;,IR_VALOR_X_RECAUDAR&#xA;)&#xA;&#x9;AS&#xA;&#x9;&#x9;( &#xA;&#x9;&#x9;&#x9;SELECT&#xA;&#x9;&#x9;&#x9;&#x9; IR.NUMERO_GUIA IR_NUMERO_GUIA&#xA;&#x9;&#x9;&#x9;&#x9;,ISNULL(CASE WHEN IR.NUMERO_ORDEN_SERVICIO = '' THEN NULL ELSE IR.NUMERO_ORDEN_SERVICIO END,'NO DISPONIBLE') IR_NUMERO_ORDEN_SERVICIO&#xA;&#x9;&#x9;&#x9;&#x9;,ISNULL(IR.VALOR_PRODUCTO,0) IR_VALOR_X_RECAUDAR&#xA;&#x9;&#x9;&#x9;FROM&#xA;&#x9;&#x9;&#x9;&#x9;LOG.GUIA_RECAUDO_INFORMACION_RECAUDO IR WITH(NOLOCK)&#xA;&#x9;&#x9;&#x9;INNER JOIN&#xA;&#x9;&#x9;&#x9;&#x9;TMP.MBCORE_GUIAS MA WITH(NOLOCK)&#xA;&#x9;&#x9;&#x9;ON&#xA;&#x9;&#x9;&#x9;&#x9;IR.NUMERO_GUIA = MA.G_NUMERO_GUIA&#xA;&#x9;&#x9;)&#xA;&#xA;INSERT INTO&#xA;&#x9;TMP.MBCORE_GUIAS_04_GRINFR&#xA;(&#xA;&#x9; IR_NUMERO_GUIA&#xA;&#x9;,IR_NUMERO_ORDEN_SERVICIO&#xA;&#x9;,IR_VALOR_X_RECAUDAR&#xA;&#xA;)&#xA;SELECT &#xA;&#x9; IR_NUMERO_GUIA&#xA;&#x9;,IR_NUMERO_ORDEN_SERVICIO&#xA;&#x9;,IR_VALOR_X_RECAUDAR&#xA;FROM &#xA;&#x9;CTE&#x9;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\PASO 04 OBTENER PROCESOS Y RECAUDO\PASO 04 03 MBCORE_GUIAS_05_INFTBCL"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{D1C10BBF-C94D-40BF-9E3B-143F41A5D3D7}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="PASO 04 03 MBCORE_GUIAS_05_INFTBCL"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="WITH CTE &#xA;(&#xA;&#x9; TC_NUMERO_GUIA&#xA;&#x9;,TC_ID_PROCESO&#xA;)&#xA;&#x9;AS&#xA;&#x9;&#x9;(&#xA;&#x9;&#x9;&#x9;SELECT&#xA;&#x9;&#x9;&#x9;&#x9; TC.NUMERO_GUIA TC_NUMERO_GUIA&#xA;&#x9;&#x9;&#x9;&#x9;,ISNULL(TC.ID_PROCESO,-888) TC_ID_PROCESO&#xA;&#x9;&#x9;&#x9;FROM&#xA;&#x9;&#x9;&#x9;&#x9;LOG.GUIA_INFORMACION_ADICIONAL_TABLERO_CONTROL TC WITH(NOLOCK)&#xA;&#x9;&#x9;&#x9;INNER JOIN&#xA;&#x9;&#x9;&#x9;&#x9;TMP.MBCORE_GUIAS MA  WITH(NOLOCK)&#xA;&#x9;&#x9;&#x9;ON&#xA;&#x9;&#x9;&#x9;&#x9;TC.NUMERO_GUIA = MA.G_NUMERO_GUIA&#xA;&#x9;&#x9;)&#xA;INSERT INTO&#xA;&#x9;TMP.MBCORE_GUIAS_05_INFTBCL&#xA;(&#xA;&#x9; TC_NUMERO_GUIA&#xA;&#x9;,TC_ID_PROCESO&#xA;&#xA;)&#xA;SELECT &#xA;&#x9; TC_NUMERO_GUIA&#xA;&#x9;,TC_ID_PROCESO&#xA;FROM &#xA;&#x9;CTE&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
