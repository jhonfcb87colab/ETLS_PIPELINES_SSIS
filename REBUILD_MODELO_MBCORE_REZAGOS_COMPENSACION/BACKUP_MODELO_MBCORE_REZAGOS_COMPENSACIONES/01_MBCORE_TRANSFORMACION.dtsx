      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
          SQLTask:SqlStatementSource="WITH CTE_TAREAS&#xA;(&#xA;&#x9; G_NUMERO_GUIA&#xA;&#x9;,TAR_ENVI_TAREA&#xA;&#x9;,TAR_ID_ESTADO_TAREA&#xA;&#x9;,TAR_ESTADO_TAREA&#xA;)&#xA;AS&#xA;(&#xA;SELECT&#xA;&#x9; TMP.G_NUMERO_GUIA&#xA;&#x9;, 'SI' TAR_ENVI_TAREA&#xA;&#x9;,TMP13.TAR_ID_ESTADO_TAREA&#xA;&#x9;,TMP13.TAR_ESTADO_TAREA&#xA;FROM &#xA;&#x9;TMP.MBCORE_GUIAS TMP WITH (NOLOCK)&#xA;INNER JOIN &#xA;&#x9;TMP.MBCORE_GUIAS_13 TMP13 WITH (NOLOCK)&#xA;ON&#xA;&#x9;TMP.G_NUMERO_GUIA = TMP13.NUMERO_GUIA&#xA;)&#xA;UPDATE&#xA;&#x9;TMP&#xA;SET&#xA;&#x9; TAR_ENVI_TAREA = CTE.TAR_ENVI_TAREA&#xA;&#x9;,TAR_ID_ESTADO_TAREA = CTE.TAR_ID_ESTADO_TAREA&#xA;&#x9;,TAR_ESTADO_TAREA =  CTE.TAR_ESTADO_TAREA&#xA;FROM &#xA;&#x9;TMP.MBCORE_GUIAS TMP WITH (NOLOCK)  &#xA;&#x9;INNER JOIN CTE_TAREAS CTE&#xA;ON&#xA;TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
