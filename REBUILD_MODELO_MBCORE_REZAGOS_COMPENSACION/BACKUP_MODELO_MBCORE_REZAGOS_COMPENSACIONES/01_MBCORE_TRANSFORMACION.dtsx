        <SQLTask:SqlTaskData
          SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
          SQLTask:SqlStatementSource="WITH CTE&#xA;(&#xA;&#x9; G_NUMERO_GUIA&#xA;&#x9;,SE_ID_FECHA_EZU&#xA;&#x9;,SE_FECHA_EZU&#xA;&#x9;,SE_ID_FECHA_ULTI_MOVI&#xA;&#x9;,SE_FECHA_ULTI_MOVI&#xA;&#x9;,SE_CANT_SZU&#xA;&#x9;,SE_ID_FECHA_SZU&#xA;&#x9;,SE_FECHA_SZU&#xA;&#x9;,SE_ID_CONC_SZU&#xA;&#x9;,SE_ID_DZU&#xA;&#x9;,SE_ID_ULTI&#xA;)&#xA;AS&#xA;(&#xA;SELECT &#xA;&#x9; NUMERO_GUIA G_NUMERO_GUIA&#xA;&#x9;,ISNULL(MIN(CASE WHEN ID_PROCESO IN (5,6) THEN FECHA_HORA_MOVIMIENTO ELSE NULL END  ),'1900-01-01' ) SE_ID_FECHA_EZU&#xA;&#x9;,ISNULL(CONVERT(VARCHAR, MIN(CASE WHEN ID_PROCESO IN (5,6) THEN FECHA_HORA_MOVIMIENTO ELSE NULL END  ),21),'NO DISPONIBLE' ) SE_FECHA_EZU&#xA;&#x9;,ISNULL(MAX(FECHA_HORA_MOVIMIENTO),'1900-01-01') SE_ID_FECHA_ULTI_MOVI&#xA;&#x9;,ISNULL(CONVERT(VARCHAR,MAX(FECHA_HORA_MOVIMIENTO),21),'NO DISPONIBLE') SE_FECHA_ULTI_MOVI&#xA;&#x9;,ISNULL(COUNT(CASE WHEN ID_PROCESO = 9 THEN ID_PROCESO ELSE NULL END),0) SE_CANT_SZU&#xA;&#x9;,ISNULL(MAX(CASE WHEN ID_PROCESO = 9 THEN FECHA_HORA_MOVIMIENTO ELSE NULL END  ),'1900-01-01' ) SE_ID_FECHA_SZU&#xA;&#x9;,ISNULL(CONVERT(VARCHAR, MAX(CASE WHEN ID_PROCESO = 9 THEN FECHA_HORA_MOVIMIENTO ELSE NULL END  ),21),'NO DISPONIBLE' ) SE_FECHA_SZU&#xA;&#x9;,ISNULL(MAX(CASE WHEN ID_PROCESO = 9 THEN ID_CONCEPTO ELSE NULL END  ),-888 ) SE_ID_CONC_SZU&#x9; &#xA;&#x9;,ISNULL(COUNT(CASE WHEN ID_PROCESO = 10 THEN ID_PROCESO ELSE NULL END),0) SE_ID_DZU&#xA;&#x9;,ISNULL(MAX(ID),-888) SE_ID_ULTI&#xA;FROM &#xA;&#x9;[TMP].[MBCORE_GUIAS_07] WITH(NOLOCK)&#xA;GROUP BY &#xA;&#x9; NUMERO_GUIA&#xA;)&#xA;UPDATE &#xA;&#x9;[TMP].[MBCORE_GUIAS]&#xA;SET&#xA;&#x9; SE_ID_FECHA_EZU   = CTE.SE_ID_FECHA_EZU&#xA;&#x9;,SE_FECHA_EZU = CTE.SE_FECHA_EZU&#xA;&#x9;,SE_ID_FECHA_ULTI_MOVI   = CTE.SE_ID_FECHA_ULTI_MOVI&#xA;&#x9;,SE_FECHA_ULTI_MOVI = CTE.SE_FECHA_ULTI_MOVI&#xA;&#x9;,SE_CANT_SZU   = CTE.SE_CANT_SZU&#xA;&#x9;,SE_ID_FECHA_SZU = CTE.SE_ID_FECHA_SZU&#xA;&#x9;,SE_FECHA_SZU = CTE.SE_FECHA_SZU&#xA;&#x9;,SE_ID_CONC_SZU = CTE.SE_ID_CONC_SZU&#xA;&#x9;,SE_ID_CANT_DZU = CTE.SE_ID_DZU&#xA;&#x9;,SE_ID_ULTI = CTE.SE_ID_ULTI&#xA;FROM&#xA;&#x9;[TMP].[MBCORE_GUIAS] TMP WITH (NOLOCK), CTE&#xA;WHERE&#xA;&#x9;TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA&#xA;&#xA;GO&#xA;&#xA;&#x9;UPDATE &#xA;&#x9;&#x9;TMP.MBCORE_GUIAS&#xA;&#x9;SET&#xA;&#x9;SE_ID_SZU = CASE WHEN SE_CANT_SZU &gt; 0 THEN 'SI' ELSE SE_ID_SZU END&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
