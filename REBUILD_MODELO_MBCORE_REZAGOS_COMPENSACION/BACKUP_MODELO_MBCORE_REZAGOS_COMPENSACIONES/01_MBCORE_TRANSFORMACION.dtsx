          DTS:Description="Execute SQL Task"
          DTS:DTSID="{771511B5-8F7E-4899-AA85-3BCBC1EA49BF}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="PASO 09 01 ACTUALIZAR CANAL RETAIL"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="WITH CTE_CANALNEGOCIO &#xA;(&#xA;&#x9; G_NUMERO_GUIA&#xA;&#x9;,ID_GEOGRAFIA_SERV_ORIG&#xA;&#x9;,ID_GEOGRAFIA_SERV_DEST&#xA;)&#xA;AS &#xA;&#x9;(&#xA;&#x9;&#x9;SELECT   &#xA;&#x9;&#x9;&#x9; TMP.G_NUMERO_GUIA&#xA;&#x9;&#x9;&#x9;,S.CityId ID_GEOGRAFIA_SERV_ORIG&#xA;&#x9;&#x9;&#x9;,RTW.SHIPPING.ReceiverCityId ID_GEOGRAFIA_SERV_DEST&#xA;&#x9;&#x9;FROM            &#xA;&#x9;&#x9;&#x9;[TMP].[MBCORE_GUIAS] TMP WITH (NOLOCK)&#xA;&#x9;&#x9;INNER JOIN  &#xA;&#x9;&#x9;&#x9;RTW.GUIDE AS G WITH (NOLOCK)&#xA;&#x9;&#x9;ON&#xA;&#x9;&#x9;&#x9;G.NUMBER = TMP.G_NUMERO_GUIA&#x9;&#xA;&#x9;&#x9;INNER JOIN                        &#xA;&#x9;&#x9;&#x9;RTW.SHIPPING WITH (NOLOCK) &#xA;&#x9;&#x9;ON &#xA;&#x9;&#x9;&#x9;G.Id = RTW.SHIPPING.GuideId &#xA;&#x9;&#x9;INNER JOIN &#xA;&#x9;&#x9;&#x9;RTW.INVOICEDETAIL AS D WITH (NOLOCK)&#xA;&#x9;&#x9;ON &#xA;&#x9;&#x9;&#x9;G.InvoiceDetailId = D.Id&#xA;&#x9;&#x9;INNER JOIN&#xA;&#x9;&#x9;&#x9;RTW.INVOICE AS V WITH (NOLOCK) &#xA;&#x9;&#x9;ON &#xA;&#x9;&#x9;&#x9;D.InvoiceId = V.Id &#xA;&#x9;&#x9;INNER JOIN&#xA;&#x9;&#x9;&#x9;RTW.CASHREGISTER AS C WITH (NOLOCK) &#xA;&#x9;&#x9;ON &#xA;&#x9;&#x9;&#x9;V.CashRegisterId = C.Id &#xA;&#x9;&#x9;INNER JOIN&#xA;&#x9;&#x9;&#x9;RTW.SOLUTIONCENTER AS S WITH (NOLOCK) &#xA;&#x9;&#x9;ON &#xA;&#x9;&#x9;&#x9;C.SolutionCenterId = S.Id&#xA;&#x9;)&#xA;UPDATE &#xA;&#x9;TMP.MBCORE_GUIAS&#xA;SET &#xA;&#x9; G_CANAL = 'RETAIL'&#xA;&#x9;,G_ID_CIUDAD_CANAL_ORIGEN = ISNULL(CTE.ID_GEOGRAFIA_SERV_ORIG,-888)&#xA;&#x9;,G_ID_CIUDAD_CANAL_DESTINO = ISNULL(CTE.ID_GEOGRAFIA_SERV_DEST,-888)&#xA;FROM &#xA;&#x9;[TMP].[MBCORE_GUIAS] TMP WITH (NOLOCK) &#xA;&#x9;INNER JOIN CTE_CANALNEGOCIO CTE&#xA;ON &#xA;&#x9;TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA&#xA;GO&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\PASO 09 ACTUALIZAR CANAL\PASO 09 02 ACTUALIZAR CANAL SISCLINET"
