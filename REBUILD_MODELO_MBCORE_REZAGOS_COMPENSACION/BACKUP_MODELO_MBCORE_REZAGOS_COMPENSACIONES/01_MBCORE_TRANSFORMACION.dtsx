          DTS:Description="Data Flow Task"
          DTS:DTSID="{FA36D194-19AF-42B7-93B6-EF48CE4AF941}"
          DTS:ExecutableType="Microsoft.Pipeline"
          DTS:LocaleID="-1"
          DTS:ObjectName="Paso 38 01 EXTRAE MBCORE BODEGA Y REGIONAL"
          DTS:TaskContact="Performs high-performance data extraction, transformation and loading;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <pipeline
              version="1">
              <components>
                <component
                  refId="Package\38 ACTUALIZACION UBICACION BODEGA Y REGIONAL INVENATARIOS FISICOS\Paso 38 01 EXTRAE MBCORE BODEGA Y REGIONAL\EXTRAER DG GUIAS BODEGA Y REGIONAL"
                  componentClassID="Microsoft.OLEDBSource"
                  contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                  description="OLE DB Source"
                  name="EXTRAER DG GUIAS BODEGA Y REGIONAL"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">DECLARE @FECHA_INICIAL DATETIME = CONVERT(DATETIME,CONVERT(DATE,CONVERT(DATETIME,?)));
DECLARE @FECHA_FINAL DATETIME = CONVERT(DATETIME,CONVERT(DATE,CONVERT(DATETIME,?)));

--DECLARE @FECHA_INICIAL DATETIME = CONVERT(DATETIME,CONVERT(DATE,CONVERT(DATETIME,'2022-01-01')));
--DECLARE @FECHA_FINAL DATETIME = CONVERT(DATETIME,CONVERT(DATE,CONVERT(DATETIME,'2022-02-01')));

WITH CTE(
ID,
NUMERO_GUIA,
FECHA_MODIFICACION_DG,
NOMBRE_DIVISION,
NOMBRE_REGIONAL
) AS(
SELECT 
	ROW_NUMBER ( )   OVER ( PARTITION BY G.[NUMERO_GUIA] order by G.FECHA_ULTIMA_MOD desc )  id,  
	G.NUMERO_GUIA,
	G.FECHA_MODIFICACION_DG, 
	DIV.NOMBRE_DIVISION,
	REGI.NOMBRE_REGIONAL
FROM Mece_Logistico..GUIAS G WITH (NOLOCK)
	INNER JOIN PARAMETROS..DIVISIONES DIV WITH (NOLOCK)
		ON G.ID_DIVISION_UBICACION=DIV.ID_DIVISION
	INNER JOIN PARAMETROS..CIUDADES CIU WITH (NOLOCK)
		ON G.ID_CIUDAD_UBICACION=CIU.ID_CIUDAD
	INNER JOIN PARAMETROS..REGIONALES_PAIS REGI WITH (NOLOCK)
		ON CIU.ID_REGIONAL=REGI.ID_REGIONAL
WHERE
(
G.FECHA_MODIFICACION_DG 
BETWEEN
		@FECHA_INICIAL 
		AND 
		@FECHA_FINAL
)
AND 
(DIV.NOMBRE_DIVISION LIKE '%REZA%'   OR DIV.NOMBRE_DIVISION LIKE '%COMPENSA%'  )  --
)
SELECT * FROM CTE WHERE ID=1</property>
                    <property
