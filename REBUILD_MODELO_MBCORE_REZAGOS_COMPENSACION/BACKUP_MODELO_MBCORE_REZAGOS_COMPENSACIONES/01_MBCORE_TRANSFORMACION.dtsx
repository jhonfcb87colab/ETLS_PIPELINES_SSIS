              <DTS:ObjectData>
                <SQLTask:SqlTaskData
                  SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
                  SQLTask:SqlStatementSource="UPDATE &#xA;&#x9;TMP&#xA;SET&#xA;&#x9; ESTADOFISICO = ISNULL (TMPESTFI.NOMBRE_ESTA_FISICO,'NO DISPONIBLE')&#xA;&#x9;&#xA;FROM &#xA;&#x9;TMP.MBCORE_GUIAS TMP WITH (NOLOCK) &#xA;&#x9;INNER JOIN [TMP].[MBCORE_GUIAS_21] TMPESTFI WITH (NOLOCK) &#xA;ON&#xA;&#x9;TMP.G_NUMERO_GUIA = TMPESTFI.NUMERO_GUIA" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
              </DTS:ObjectData>
