          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="WITH CTE_Numero_piezas_rezagos&#xA;(&#xA;&#x9;NUMERO_GUIA,&#x9;&#xA;&#x9;NUMERO_PIEZAS&#x9;&#xA;) AS&#xA;(&#xA;&#x9;SELECT NUMERO_GUIA, count(ID_DIVISION_DESTINO) Numero_veces_rezagos FROM &#xA;&#x9;(&#xA;&#x9;&#x9;SELECT &#xA;&#x9;&#x9;ROW_NUMBER ( )   OVER ( PARTITION BY &#xA;&#x9;&#x9;NUMERO_GUIA,ID_DIVISION_DESTINO,NOMBRE_DIVISION,FECHA_HORA_MOVIMIENTO,NUMERO_PIEZAS&#xA;&#x9;&#x9;order by FECHA_HORA_MOVIMIENTO desc )  id,&#xA;&#x9;&#x9;* FROM (&#xA;&#x9;&#x9;&#x9;&#x9;SELECT &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;SEG.NUMERO_GUIA,DOC.ID_DIVISION_DESTINO,DIV.NOMBRE_DIVISION, SEG.FECHA_HORA_MOVIMIENTO,SEG.NUMERO_PIEZAS &#xA;&#x9;&#x9;&#x9;&#x9;FROM/*         */    SIG_COLOMBIA_DW.LOG.SEGUIMIENTO_ENVIO  SEG&#xA;&#x9;&#x9;&#x9;&#x9;INNER JOIN /*         */    SIG_COLOMBIA_DW.LOG.DOCUMENTOS DOC WITH (NOLOCK) &#xA;&#x9;&#x9;&#x9;&#x9;ON (DOC.ID_PROCESO=SEG.ID_PROCESO AND DOC.NUMERO_MOVIMI=SEG.NUMERO_MOVIMI  AND  DOC.CONSECUT_MOVIMI=SEG.CONSECUT_MOVIMI)&#xA;&#x9;&#x9;&#x9;&#x9;INNER JOIN PAR.DIVISIONES DIV WITH (NOLOCK)&#xA;&#x9;&#x9;&#x9;&#x9;ON DIV.ID_DIVISION=DOC.ID_DIVISION_DESTINO AND DOC.ID_CIUDAD_DESTINO=DIV.ID_CIUDAD &#xA;&#x9;&#x9;&#x9;&#x9;WHERE SEG.NUMERO_GUIA &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;IN (SELECT DISTINCT GUI.G_NUMERO_GUIA FROM  TMP.MBCORE_GUIAS GUI (NOLOCK) WHERE GUI.CR_ID_APLICA_COMPENSACIONES=1 )&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;--IN (34091499,239616019,279923419,282008669,282233749,282233750)  --&#xA;&#x9;&#x9;&#x9;&#x9;AND DIV.NOMBRE_DIVISION LIKE '%REZAGO%NACIO%'&#xA;&#x9;&#x9;&#x9;&#x9;AND DOC.ID_PROCESO=8&#xA;&#x9;&#x9;) CTEDS_1&#xA;&#x9;)CTEDS_2 WHERE id=1 group by NUMERO_GUIA&#xA;)&#xA;-- SELECT * FROM CTE_Numero_piezas_rezagos&#xA;&#xA;UPDATE &#xA;&#x9;TMP&#xA;SET &#xA;&#x9; Numero_piezas_rezagos = ISNULL(CTE.NUMERO_PIEZAS,0)&#xA;FROM &#xA;&#x9;TMP.MBCORE_GUIAS TMP WITH (NOLOCK)&#xA;&#x9;INNER JOIN CTE_Numero_piezas_rezagos CTE&#xA;ON &#xA;&#x9;TMP.G_NUMERO_GUIA = CTE.NUMERO_GUIA" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\PASO 30 ACTUALIZAR CAMPOS NUEVOS MBCORE\PASO 30 12 ACTUALIZAR Numero_piezas_compensacion"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{E2814900-3AFB-4A2C-ADAC-B97608E9EF82}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="PASO 30 12 ACTUALIZAR Numero_piezas_compensacion"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="WITH CTE_Numero_piezas_compensacion&#xA;(&#xA;&#x9;NUMERO_GUIA,&#x9;&#xA;&#x9;NUMERO_PIEZAS&#x9;&#xA;) AS&#xA;(&#xA;&#x9;SELECT NUMERO_GUIA, count(ID_DIVISION_DESTINO) Numero_piezas_compensacion FROM &#xA;&#x9;(&#xA;&#x9;&#x9;SELECT &#xA;&#x9;&#x9;ROW_NUMBER ( )   OVER ( PARTITION BY &#xA;&#x9;&#x9;NUMERO_GUIA,ID_DIVISION_DESTINO,NOMBRE_DIVISION,FECHA_HORA_MOVIMIENTO,NUMERO_PIEZAS&#xA;&#x9;&#x9;order by FECHA_HORA_MOVIMIENTO desc )  id,&#xA;&#x9;&#x9;* FROM (&#xA;&#x9;&#x9;&#x9;&#x9;SELECT &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;SEG.NUMERO_GUIA,DOC.ID_DIVISION_DESTINO,DIV.NOMBRE_DIVISION, SEG.FECHA_HORA_MOVIMIENTO,SEG.NUMERO_PIEZAS &#xA;&#x9;&#x9;&#x9;&#x9;FROM/*         */    SIG_COLOMBIA_DW.LOG.SEGUIMIENTO_ENVIO  SEG&#xA;&#x9;&#x9;&#x9;&#x9;INNER JOIN /*         */    SIG_COLOMBIA_DW.LOG.DOCUMENTOS DOC WITH (NOLOCK) &#xA;&#x9;&#x9;&#x9;&#x9;ON (DOC.ID_PROCESO=SEG.ID_PROCESO AND DOC.NUMERO_MOVIMI=SEG.NUMERO_MOVIMI  AND  DOC.CONSECUT_MOVIMI=SEG.CONSECUT_MOVIMI)&#xA;&#x9;&#x9;&#x9;&#x9;INNER JOIN PAR.DIVISIONES DIV WITH (NOLOCK)&#xA;&#x9;&#x9;&#x9;&#x9;ON DIV.ID_DIVISION=DOC.ID_DIVISION_DESTINO AND DOC.ID_CIUDAD_DESTINO=DIV.ID_CIUDAD &#xA;&#x9;&#x9;&#x9;&#x9;WHERE SEG.NUMERO_GUIA &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;IN (SELECT DISTINCT GUI.G_NUMERO_GUIA FROM  TMP.MBCORE_GUIAS GUI (NOLOCK) WHERE GUI.CR_ID_APLICA_COMPENSACIONES=1 )&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;--IN (34091499,239616019,279923419,282008669,282233749,282233750)  --&#xA;&#x9;&#x9;&#x9;&#x9;AND DIV.NOMBRE_DIVISION LIKE '%COMPENSACION%'&#xA;&#x9;&#x9;&#x9;&#x9;AND DOC.ID_PROCESO=8&#xA;&#x9;&#x9;) CTEDS_1&#xA;&#x9;)CTEDS_2 WHERE id=1 group by NUMERO_GUIA&#xA;)&#xA;-- SELECT * FROM CTE_Numero_piezas_compensacion&#xA;&#xA;UPDATE &#xA;&#x9;TMP&#xA;SET &#xA;&#x9; Numero_piezas_compensacion = ISNULL(CTE.NUMERO_PIEZAS,0)&#xA;FROM &#xA;&#x9;TMP.MBCORE_GUIAS TMP WITH (NOLOCK)&#xA;&#x9;INNER JOIN CTE_Numero_piezas_compensacion CTE&#xA;ON&#xA;&#x9;TMP.G_NUMERO_GUIA = CTE.NUMERO_GUIA" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\PASO 30 ACTUALIZAR CAMPOS NUEVOS MBCORE\PASO 30 13 ACTUALIZAR ESTADO_INDEMNIZACION"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{E6EC17C2-454B-4238-9282-0311ED9C097F}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="PASO 30 13 ACTUALIZAR ESTADO_INDEMNIZACION"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource=" WITH CTE_ESTADO_INDEMNIZACION&#xA;(&#xA;&#x9;NUMERO_GUIA,&#x9;&#xA;&#x9;ID_ESTADO_INDEMNIZACION_PQR,&#xA;&#x9;NOMBRE_ESTADO_INDEMNIZACION_PQR&#xA;) AS&#xA;(&#xA;SELECT PQR.NUMERO_GUIA,IDPQR.ID_ESTADO_INDEMNIZACION_PQR,  ESPQR.NOMBRE_ESTADO_INDEMNIZACION_PQR&#xA;&#x9;FROM/*         */    SIG_COLOMBIA_DW.LOG.[PQR] PQR WITH (NOLOCK)&#xA;&#x9;LEFT JOIN/*         */    SIG_COLOMBIA_DW.LOG.[INDEMNIZACIONES_PQR] IDPQR WITH (NOLOCK)&#xA;&#x9;ON IDPQR.ID_PQR=PQR.ID_PQR&#xA;&#x9;LEFT JOIN [PAR].[ESTADOS_INDEMNIZACION_PQR] ESPQR WITH (NOLOCK)&#xA;&#x9;ON IDPQR.ID_ESTADO_INDEMNIZACION_PQR=ESPQR.ID_ESTADO_INDEMNIZACION_PQR&#xA;WHERE PQR.NUMERO_GUIA &#xA;&#x9;&#x9;&#x9;&#x9;IN (SELECT DISTINCT GUI.G_NUMERO_GUIA FROM  TMP.MBCORE_GUIAS GUI (NOLOCK) WHERE GUI.CR_ID_APLICA_COMPENSACIONES=1 )&#xA;&#x9;&#x9;&#x9;&#x9;--IN (369465667,349700977,367249173,930984665,236935798,236935785,366750736,922646101,248587303,930872879,248205913)  --&#xA;)&#xA;-- SELECT * FROM CTE_ESTADO_INDEMNIZACION&#xA;&#xA;UPDATE &#xA;&#x9;TMP.MBCORE_GUIAS&#xA;SET &#xA;&#x9; ID_ESTADO_INDEMNIZACION = ISNULL(CONVERT(INT,CTE.ID_ESTADO_INDEMNIZACION_PQR),-888),&#xA;&#x9; ESTADO_INDEMNIZACION = ISNULL(CTE.NOMBRE_ESTADO_INDEMNIZACION_PQR,'NO DISPONIBLE')&#xA;FROM &#xA;&#x9;TMP.MBCORE_GUIAS TMP WITH (NOLOCK) &#xA;&#x9;INNER JOIN CTE_ESTADO_INDEMNIZACION CTE&#xA;ON&#xA;&#x9;TMP.G_NUMERO_GUIA = CTE.NUMERO_GUIA" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
      </DTS:Executables>
