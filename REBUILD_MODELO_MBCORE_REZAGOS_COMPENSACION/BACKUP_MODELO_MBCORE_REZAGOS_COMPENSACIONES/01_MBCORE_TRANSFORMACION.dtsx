                        <property
                          dataType="System.String"
                          description="The SQL command to be executed."
                          name="SqlCommand"
                          UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT 
	 SE.[NUMERO_GUIA]
	,SE.[ID_PROCESO]
	,SE.[ID_CONCEPTO]
	,SE.[FECHA_HORA_MOVIMIENTO]
	,SE.[NUMERO_MOVIMI]
	,SE.[CONSECUT_MOVIMI]
FROM
	/*         */    SIG_COLOMBIA_DW.[LOG].[SEGUIMIENTO_ENVIO_PROV] SE WITH(NOLOCK), TMP.MBCORE_GUIAS TMP WITH(NOLOCK)
WHERE
SE.NUMERO_GUIA = TMP.G_NUMERO_GUIA</property>
