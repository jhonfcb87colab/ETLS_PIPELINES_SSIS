                  DTS:refId="Package\CARGA INICIAL OPERADO DE EXTRACCION Y GENERADOR DE FECHAS\Base principal de Compensaciones y rezagos y Guias no MBCORE\GUIAS NO MBCORE\PASO 01 02 OBTENER GUIAS NO SON DE MBCORE"
                  DTS:CreationName="Microsoft.Pipeline"
