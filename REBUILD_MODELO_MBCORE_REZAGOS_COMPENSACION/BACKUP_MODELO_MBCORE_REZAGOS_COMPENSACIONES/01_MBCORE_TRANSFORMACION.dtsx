          DTS:Description="Execute SQL Task"
          DTS:DTSID="{90353563-CF83-4BF0-957E-677421F16484}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="PASO 23 02 NOVEDAD OPERATIVA 1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="WITH CTE&#xA;(&#xA;&#x9; G_NUMERO_GUIA&#xA;&#x9;,SE_NOVD_OPERATIVA_1&#xA;)&#xA;AS&#xA;(&#xA;SELECT&#xA;&#x9; TMP.G_NUMERO_GUIA&#xA;&#x9;,TMP11.G_NOVEDAD AS  SE_NOVD_OPERATIVA_1&#xA;FROM &#xA;&#x9;TMP.MBCORE_GUIAS TMP WITH(NOLOCK)&#xA;INNER JOIN &#xA;&#x9;TMP.MBCORE_GUIAS_11 TMP11 WITH(NOLOCK)&#xA;ON&#xA;&#x9;TMP.G_NUMERO_GUIA = TMP11.G_NUMERO_GUIA&#xA;WHERE &#xA;&#x9;TMP11.ID = 1 &#xA;)&#xA;UPDATE &#xA;&#x9;TMP.MBCORE_GUIAS&#xA;SET &#xA;&#x9;SE_NOVD_OPERATIVA_1 = CTE.SE_NOVD_OPERATIVA_1&#xA;FROM &#xA;&#x9; TMP.MBCORE_GUIAS TMP  INNER JOIN CTE&#xA;ON&#xA;&#x9;TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\PASO 23 ACTUALIZAR NOVEDADES\PASO 23 03 NOVEDAD OPERATIVA 2"
