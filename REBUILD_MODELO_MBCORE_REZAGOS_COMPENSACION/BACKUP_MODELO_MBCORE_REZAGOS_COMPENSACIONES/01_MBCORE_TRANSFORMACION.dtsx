      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
          SQLTask:SqlStatementSource="WITH CTE_RECAUDOS&#xA;(&#xA;&#x9; G_NUMERO_GUIA&#xA;&#x9;,IR_NUMERO_ORDEN_SERVICIO&#xA;&#x9;,IR_VALOR_X_RECAUDAR&#xA;&#x9;&#xA;)&#xA;AS&#xA;&#x9;(&#xA;&#x9;&#x9;SELECT &#xA;&#x9;&#x9;&#x9; TMP.G_NUMERO_GUIA&#xA;&#x9;&#x9;&#x9;,IR.IR_NUMERO_ORDEN_SERVICIO&#xA;&#x9;&#x9;&#x9;,IR.IR_VALOR_X_RECAUDAR&#xA;&#x9;&#x9;&#x9;&#xA;&#x9;&#x9;FROM &#xA;&#x9;&#x9;&#x9; [TMP].[MBCORE_GUIAS] TMP WITH (NOLOCK)&#xA;&#x9;&#x9;INNER JOIN &#xA;&#x9;&#x9;&#x9;[TMP].[MBCORE_GUIAS_04_GRINFR] IR WITH (NOLOCK)&#xA;&#x9;&#x9;ON &#xA;&#x9;&#x9;&#x9;TMP.G_NUMERO_GUIA = IR.IR_NUMERO_GUIA&#xA;&#x9;)&#xA;UPDATE &#xA;&#x9; TMP&#xA;SET &#xA;&#x9; GRIR_VALOR_RECAUDAR = CTE.IR_VALOR_X_RECAUDAR&#xA;&#x9; ,GRIR_NUMERO_ORDEN_SERVICIO = CTE.IR_NUMERO_ORDEN_SERVICIO&#xA;FROM &#xA;&#x9;[TMP].[MBCORE_GUIAS] TMP WITH (NOLOCK)&#xA;&#x9;INNER JOIN CTE_RECAUDOS CTE&#xA;ON &#xA;&#x9;TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
