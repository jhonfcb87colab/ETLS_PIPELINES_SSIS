      <DTS:Executables>
        <DTS:Executable
          DTS:refId="Package\PASOS 33 34 35\PASO 33 ACTUALIZAR MBCORE CODIGO CUN"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{511AB10A-45D2-4260-B8B9-C84A7762E861}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="PASO 33 ACTUALIZAR MBCORE CODIGO CUN"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="WITH CTE_CODIGO_CUN&#xA;(&#xA;&#x9;NUMERO_GUIA,&#xA;&#x9;CUN&#xA;)AS&#xA;(&#xA;&#x9;SELECT CTE.NUMERO_GUIA, CTE.CUN FROM(&#xA;&#x9;&#x9;&#x9;&#x9;SELECT &#xA;&#x9;&#x9;&#x9;&#x9;ROW_NUMBER ( )   OVER ( PARTITION BY NUMERO_GUIA order by FECHA_MODIFICA desc )  id &#xA;&#x9;&#x9;&#x9;&#x9;,PQR.NUMERO_GUIA&#xA;&#x9;&#x9;&#x9;&#x9;,PQR.CUN&#xA;&#x9;&#x9;&#x9;&#x9;,PQR.FECHA_MODIFICA&#xA;&#x9;&#x9;&#x9;&#x9;FROM/*         */    SIG_COLOMBIA_DW.LOG.[PQR] PQR (NOLOCK) WHERE NUMERO_GUIA IN (SELECT DISTINCT GUI.G_NUMERO_GUIA FROM  TMP.MBCORE_GUIAS GUI (NOLOCK))&#x9;&#x9;&#x9; &#xA;&#x9;&#x9;&#x9;&#x9;) CTE &#xA;&#x9;WHERE CTE.id=1&#xA;)&#xA; --SELECT * FROM  CTE_CODIGO_CUN&#xA;UPDATE &#xA;&#x9;TMP&#xA;SET&#xA;&#x9; CUN = ISNULL (CTE.CUN,-888)&#xA;FROM &#xA;&#x9;TMP.MBCORE_GUIAS TMP WITH (NOLOCK) &#xA;&#x9;INNER JOIN CTE_CODIGO_CUN CTE&#xA;ON &#xA;&#x9;TMP.G_NUMERO_GUIA = CTE.NUMERO_GUIA&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\PASOS 33 34 35\PASO 34 ACTUALIZAR MBCORE Nombre destinatario"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{8FDA32C7-C50D-4845-BB5B-A0642F0CDFCE}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="PASO 34 ACTUALIZAR MBCORE Nombre destinatario"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="WITH CTE_NOMBRE_DESTINA_GUIA&#xA; (&#xA; &#x9;NUMERO_GUIA,&#xA; &#x9;NOMBRE_DESTINA_GUIA&#xA; )AS&#xA; (&#xA; &#x9;SELECT CTE.NUMERO_GUIA, CTE.NOMBRE_DESTINA_GUIA FROM(&#xA; &#x9;&#x9;&#x9;&#x9;SELECT &#xA; &#x9;&#x9;&#x9;&#x9;ROW_NUMBER ( )   OVER ( PARTITION BY G.NUMERO_GUIA  order by G.FECHA_MODIFICACION desc )  id &#xA;&#x9;&#x9;&#x9;&#x9;,G.NUMERO_GUIA &#xA;&#x9;&#x9;&#x9;&#x9;,G.NOMBRE_DESTINA_GUIA &#xA;&#x9;&#x9;&#x9;&#x9;FROM/*         */    SIG_COLOMBIA_DW.LOG.GUIAS  G (NOLOCK) WHERE G.NUMERO_GUIA IN (SELECT DISTINCT GUI.G_NUMERO_GUIA FROM  TMP.MBCORE_GUIAS GUI (NOLOCK))&#x9;&#x9;&#x9; &#xA; &#x9;&#x9;&#x9;&#x9;) CTE &#xA; &#x9;WHERE CTE.id=1&#xA; )&#xA;-- SELECT * FROM  CTE_NOMBRE_DESTINA_GUIA&#xA;&#xA;UPDATE &#xA;&#x9;TMP &#xA;SET&#xA;&#x9; Nombre_destinatario = ISNULL (CTE.NOMBRE_DESTINA_GUIA,'NO DISPONIBLE')&#xA;FROM &#xA;&#x9;TMP.MBCORE_GUIAS TMP WITH (NOLOCK) &#xA;&#x9;INNER JOIN CTE_NOMBRE_DESTINA_GUIA CTE&#xA;ON &#xA;&#x9;TMP.G_NUMERO_GUIA = CTE.NUMERO_GUIA" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\PASOS 33 34 35\PASO 35 ACTUALIZAR MBCORE GUIAS DIGITALIZADAS"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{28D1F28A-A7D5-474F-B8F3-B879AF54E380}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="PASO 35 ACTUALIZAR MBCORE GUIAS DIGITALIZADAS"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="WITH CTE_DIGITALIZADAS&#xA;  (&#xA;  &#x9;&#x9;[NUMERO_GUIA]&#xA;      ,[FECHA_DIGITALIZACION]&#xA;      ,[ID_ESTADOGUIA]&#xA;      ,[ESTADO_GUIA]&#xA;  )&#xA;  AS&#xA;  (&#xA;  SELECT &#xA;&#x9;&#x9;[NUMERO_GUIA]&#xA;      ,[FECHA_DIGITALIZACION]--DATETIME&#xA;      ,[ID_ESTADOGUIA]--INT&#xA;      ,[ESTADO_GUIA]--VARCHAR(40)&#xA;  FROM/*         */    [SIG_CCM_DM].[FAC].[AUDI_DIGIBASE] WITH(NOLOCK)&#xA;  WHERE [NUMERO_GUIA] IN (SELECT G_NUMERO_GUIA FROM SIG_COL_LOGISTICA_DW.TMP.MBCORE_GUIAS (NOLOCK))&#xA;)&#xA;UPDATE &#xA;&#x9;TMP&#xA;SET&#xA;&#x9;[FECHA_DIGITALIZACION] = ISNULL (CTE.[FECHA_DIGITALIZACION],NULL),&#xA;&#x9;[ID_ESTADOGUIA_DIGITALIZACION] = ISNULL (CONVERT(INT,CTE.[ID_ESTADOGUIA]),-888),&#xA;&#x9;[ESTADO_GUIA_DITALIZACION] = ISNULL (CTE.[ESTADO_GUIA],'NO DISPONIBLE')&#xA;FROM &#xA;&#x9;TMP.MBCORE_GUIAS TMP WITH (NOLOCK)   INNER JOIN CTE_DIGITALIZADAS CTE&#xA;ON&#xA;&#x9;TMP.G_NUMERO_GUIA = CTE.NUMERO_GUIA" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
      </DTS:Executables>
