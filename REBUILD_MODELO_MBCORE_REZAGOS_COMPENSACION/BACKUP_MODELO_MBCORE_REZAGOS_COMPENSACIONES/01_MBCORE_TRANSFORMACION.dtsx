                          description="The OLE DB runtime connection used to access the database."
                          name="OleDbConnection" />
                      </connections>
                      <outputs>
                        <output
                          refId="Package\38 ACTUALIZACION UBICACION BODEGA Y REGIONAL INVENATARIOS FISICOS\39 03 ACTUALIZACION BODEGA Y REGIONAL UBICACION INVENARIO FISICO\Paso 39 02 EXTRAE MBCORE BODEGA Y REGIONAL TB LOG\EXTRACCION DE BODEGAS  MOVIMEINTOS.Outputs[OLE DB Source Output]"
                          name="OLE DB Source Output">
                          <outputColumns>
                            <outputColumn
                              refId="Package\38 ACTUALIZACION UBICACION BODEGA Y REGIONAL INVENATARIOS FISICOS\39 03 ACTUALIZACION BODEGA Y REGIONAL UBICACION INVENARIO FISICO\Paso 39 02 EXTRAE MBCORE BODEGA Y REGIONAL TB LOG\EXTRACCION DE BODEGAS  MOVIMEINTOS.Outputs[OLE DB Source Output].Columns[id]"
                              dataType="i8"
                              errorOrTruncationOperation="Conversion"
                              errorRowDisposition="FailComponent"
                              externalMetadataColumnId="Package\38 ACTUALIZACION UBICACION BODEGA Y REGIONAL INVENATARIOS FISICOS\39 03 ACTUALIZACION BODEGA Y REGIONAL UBICACION INVENARIO FISICO\Paso 39 02 EXTRAE MBCORE BODEGA Y REGIONAL TB LOG\EXTRACCION DE BODEGAS  MOVIMEINTOS.Outputs[OLE DB Source Output].ExternalColumns[id]"
