        <SQLTask:SqlTaskData
          SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
          SQLTask:SqlStatementSource="  WITH CTE_ESTADO_PQR&#xA;(&#xA;&#x9; G_NUMERO_GUIA&#xA;&#x9;,MPE_ENVI_PQR&#xA;&#x9;,MPE_ID_ESTADO_PQR&#xA;&#x9;,MPE_ESTADO_PQR&#xA;)&#xA;AS&#xA;(&#xA;SELECT&#xA;&#x9; TMP.G_NUMERO_GUIA&#xA;&#x9;, 'SI' MPE_ENVI_PQR&#xA;&#x9;,TMP12.MPE_ID_ESTADO_PQR&#xA;&#x9;,TMP12.MPE_ESTADO_PQR&#xA;FROM &#xA;&#x9;TMP.MBCORE_GUIAS TMP WITH (NOLOCK)&#xA;INNER JOIN &#xA;&#x9;TMP.MBCORE_GUIAS_12 TMP12 WITH (NOLOCK)&#xA;ON&#xA;&#x9;TMP.G_NUMERO_GUIA = TMP12.NUMERO_GUIA&#xA;)&#xA;UPDATE&#xA;&#x9;TMP&#xA;SET&#xA;&#x9; MPE_ENVI_PQR = CTE.MPE_ENVI_PQR&#xA;&#x9;,MPE_ID_ESTADO_PQR = CTE.MPE_ID_ESTADO_PQR&#xA;&#x9;,MPE_ESTADO_PQR =  CTE.MPE_ESTADO_PQR&#xA;FROM &#xA;&#x9;TMP.MBCORE_GUIAS TMP WITH (NOLOCK) &#xA;&#x9;INNER JOIN  CTE_ESTADO_PQR CTE&#xA;ON&#xA;TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
