            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="&#xA;&#xA;WITH CTE&#xA;(&#xA;&#x9; G_NUMERO_GUIA&#xA;&#x9;,SE_NOVD_OPERATIVA_2&#xA;)&#xA;AS&#xA;(&#xA;SELECT&#xA;&#x9; TMP.G_NUMERO_GUIA&#xA;&#x9;,TMP11.G_NOVEDAD AS  SE_NOVD_OPERATIVA_2&#xA;FROM &#xA;&#x9;TMP.MBCORE_GUIAS TMP WITH(NOLOCK)&#xA;INNER JOIN &#xA;&#x9;TMP.MBCORE_GUIAS_11 TMP11 WITH(NOLOCK)&#xA;ON&#xA;&#x9;TMP.G_NUMERO_GUIA = TMP11.G_NUMERO_GUIA&#xA;WHERE &#xA;&#x9;TMP11.ID = 2 &#xA;)&#xA;UPDATE &#xA;&#x9;TMP.MBCORE_GUIAS&#xA;SET &#xA;&#x9;SE_NOVD_OPERATIVA_2 = CTE.SE_NOVD_OPERATIVA_2&#xA;FROM &#xA;&#x9; TMP.MBCORE_GUIAS TMP INNER JOIN CTE &#xA;&#x9;ON&#xA;&#x9;TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
