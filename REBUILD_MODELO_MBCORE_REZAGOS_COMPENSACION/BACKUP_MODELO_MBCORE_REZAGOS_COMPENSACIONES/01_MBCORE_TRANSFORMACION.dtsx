              SQLTask:SqlStatementSource="WITH CTE_ULT_CONEPTO_LOG&#xA;(&#xA;&#x9; G_NUMERO_GUIA&#xA;&#x9;,NOMBRE_CONCEPTO&#xA;&#x9;&#xA;)&#xA;AS&#xA;&#x9;(&#xA;&#x9;&#x9;SELECT&#xA;&#x9;&#x9;&#x9; TMP.G_NUMERO_GUIA&#xA;&#x9;&#x9;&#x9;,CONC.NOMBRE_CONCEPTO&#xA;&#x9;&#x9;&#x9;&#xA;&#x9;&#x9;FROM &#xA;&#x9;&#x9;&#x9;TMP.MBCORE_GUIAS TMP WITH (NOLOCK)&#xA;&#x9;&#x9;INNER JOIN &#xA;&#x9;&#x9;&#x9;PAR.ITEM_CONCEPTO CONC WITH (NOLOCK)&#xA;&#x9;&#x9;ON&#xA;&#x9;&#x9;&#x9;TMP.SE_ID_PROC_ULTI_MOVI = CONC.ID_PROCESO&#xA;&#x9;&#x9;&#x9;&#xA;&#x9;&#x9;AND&#xA;&#x9;&#x9;&#x9;TMP.SE_ID_CONC_ULTI_MOVI = CONC.ID_CONCEPTO&#xA;&#x9;&#x9;&#xA;&#x9;)&#xA;UPDATE &#xA;&#x9;TMP&#xA;SET&#xA;&#x9; SE_CONC_ULTI_MOVI = ISNULL (CTE.NOMBRE_CONCEPTO,'NO DISPONIBLE')&#xA;&#x9;&#xA;FROM &#xA;&#x9;TMP.MBCORE_GUIAS TMP WITH (NOLOCK) &#xA;&#x9;INNER JOIN CTE_ULT_CONEPTO_LOG  CTE&#xA;ON &#xA;&#x9;TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
