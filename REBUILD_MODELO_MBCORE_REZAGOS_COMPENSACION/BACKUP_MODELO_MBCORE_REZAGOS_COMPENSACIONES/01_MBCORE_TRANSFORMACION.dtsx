        <DTS:Executable
          DTS:refId="Package\PASO 30 ACTUALIZAR CAMPOS NUEVOS MBCORE\PASO 30 07 ACTUALIZAR FECHA_BOD_Rezagos"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{A83D22E3-7102-4C30-AEC3-9D5F9FFCDAC8}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="PASO 30 07 ACTUALIZAR FECHA_BOD_Rezagos"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="WITH CTE_FECHA_BODEGA_REZAGOS&#xA;(&#xA;&#x9;id,&#x9;&#xA;&#x9;NUMERO_GUIA,&#x9;&#xA;&#x9;ID_DIVISION_DESTINO,&#x9;&#xA;&#x9;NOMBRE_DIVISION,&#x9;&#xA;&#x9;FECHA_HORA_MOVIMIENTO&#xA;) AS&#xA;(&#xA;&#x9;SELECT &#xA;&#x9;ROW_NUMBER ( )   OVER ( PARTITION BY &#xA;&#x9;NUMERO_GUIA,ID_DIVISION_DESTINO,NOMBRE_DIVISION&#xA;&#x9;order by FECHA_HORA_MOVIMIENTO desc )  id,&#xA;&#x9;* FROM (&#xA;&#x9;&#x9;&#x9;SELECT &#xA;&#x9;&#x9;&#x9;&#x9;SEG.NUMERO_GUIA,DOC.ID_DIVISION_DESTINO,DIV.NOMBRE_DIVISION, SEG.FECHA_HORA_MOVIMIENTO FROM/*         */    SIG_COLOMBIA_DW.LOG.SEGUIMIENTO_ENVIO  SEG&#xA;&#x9;&#x9;&#x9;INNER JOIN /*         */    SIG_COLOMBIA_DW.log.DOCUMENTOS DOC WITH (NOLOCK) &#xA;&#x9;&#x9;&#x9;ON (DOC.ID_PROCESO=SEG.ID_PROCESO AND DOC.NUMERO_MOVIMI=SEG.NUMERO_MOVIMI  AND  DOC.CONSECUT_MOVIMI=SEG.CONSECUT_MOVIMI)&#xA;&#x9;&#x9;&#x9;INNER JOIN PAR.DIVISIONES DIV WITH (NOLOCK)&#xA;&#x9;&#x9;&#x9;ON DIV.ID_DIVISION=DOC.ID_DIVISION_DESTINO AND DOC.ID_CIUDAD_DESTINO=DIV.ID_CIUDAD &#xA;&#x9;&#x9;&#x9;WHERE SEG.NUMERO_GUIA IN (SELECT DISTINCT GUI.G_NUMERO_GUIA FROM  TMP.MBCORE_GUIAS GUI (NOLOCK))&#xA;&#x9;&#x9;&#x9;AND DIV.NOMBRE_DIVISION LIKE '%REZAGO%'&#xA;&#x9;&#x9;&#x9;AND DOC.ID_PROCESO=8&#xA;&#x9;) CTEDS&#xA;)&#xA;--SELECT * FROM CTE_FECHA_BODEGA_REZAGOS WHERE id=1&#xA;UPDATE &#xA;&#x9;TMP&#xA;SET&#xA;&#x9; FECHA_BOD_Rezagos = ISNULL (CTE.FECHA_HORA_MOVIMIENTO,'1900-01-01')&#xA;FROM &#xA;&#x9;TMP.MBCORE_GUIAS TMP WITH (NOLOCK)&#xA;&#x9;INNER JOIN CTE_FECHA_BODEGA_REZAGOS CTE&#xA;ON &#xA;&#x9;TMP.G_NUMERO_GUIA = CTE.NUMERO_GUIA&#xA;&#x9;AND CTE.id=1&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\PASO 30 ACTUALIZAR CAMPOS NUEVOS MBCORE\PASO 30 08 ACTUALIZAR FECHA_BOD_Compensaciones"
