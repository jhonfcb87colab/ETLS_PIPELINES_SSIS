          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="WITH CTE_ULTIMA_BODEGA_Y_REGIONAL&#xA;(&#xA;id, &#xA;NUMERO_GUIA, &#xA;NOMBRE_DIVISION,&#xA;NOMBRE_REGIONAL&#xA;) AS (&#xA; SELECT [ID]&#xA;    ,[NUMERO_GUIA]&#xA;    ,[NOMBRE_DIVISION]&#xA;    ,[NOMBRE_REGIONAL]&#xA;   FROM [TMP].[MBCORE_GUIAS_25] WITH (NOLOCK)&#xA;) &#xA;--SELECT * FROM CTE WHERE ID=1&#xA;UPDATE TMP&#xA;--SELECT CTE.NUMERO_GUIA,&#xA;SET&#xA;[CR_BODEGA_UBICACION] = ISNULL (CTE.NOMBRE_DIVISION,'NO DISPONIBLE'),&#xA;[CR_REGIONAL_UBICACION] =  ISNULL (CTE.NOMBRE_REGIONAL,'NO DISPONIBLE')&#xA;FROM &#xA; TMP.MBCORE_GUIAS TMP WITH (NOLOCK)&#xA; INNER JOIN CTE_ULTIMA_BODEGA_Y_REGIONAL CTE &#xA; ON TMP.G_NUMERO_GUIA = CTE.NUMERO_GUIA&#xA;WHERE &#xA;  CTE.id=1" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
