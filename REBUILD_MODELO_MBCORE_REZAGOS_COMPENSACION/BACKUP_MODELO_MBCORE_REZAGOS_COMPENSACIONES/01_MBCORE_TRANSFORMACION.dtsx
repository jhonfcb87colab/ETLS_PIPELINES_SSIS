          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="&#xA;&#x9;/*&#x9;&#x9;CREAR UPDATE&#x9;&#x9;*/&#x9;&#xA;&#x9;---&#x9;&#x9;&#x9;USE SIG_COLOMBIA_DW;&#xA;&#x9;WITH CTE_TIEMPO_PROMEDIO_RESPUESTA_TAREA&#xA;(&#xA;&#x9;[ID]&#x9;&#xA;&#x9;,[NUMERO_GUIA]&#xA;&#x9;,[PROM_TIEMPO_RESPUESTA]&#xA;&#x9;,[PROM_TIEMPO_CORRIDO]&#xA;&#x9;,[PROM_TIEMPO_TOTAL]&#xA;&#x9;,[NUM_TAREAS]&#xA;&#x9;,[NUM_TAREAS_CERRADA]&#xA;&#x9;,[NUM_TAREAS_PENDIENTE] &#xA;)AS (&#xA;&#x9;SELECT ROW_NUMBER ( )   OVER ( PARTITION BY [NUMERO_GUIA] order by TIME_ID desc )  [ID]  &#xA;&#x9;&#x9;,[NUMERO_GUIA]&#xA;&#x9;&#x9;,[PROM_TIEMPO_RESPUESTA]&#xA;&#x9;&#x9;,[PROM_TIEMPO_CORRIDO]&#xA;&#x9;&#x9;,[PROM_TIEMPO_TOTAL]&#xA;&#x9;&#x9;,[NUM_TAREAS]&#xA;&#x9;&#x9;,[NUM_TAREAS_CERRADA]&#xA;&#x9;&#x9;,[NUM_TAREAS_PENDIENTE] &#xA;&#x9;FROM   [SIG_COLOMBIA_DW].[TMP].[MBCORE_GUIAS_28] WITH(NOLOCK)&#xA;)&#xA;----SELECT * FROM CTE_TIEMPO_PROMEDIO_RESPUESTA_TAREA&#xA;UPDATE   TMP&#xA;SET &#xA;&#x9;&#x9;[TAR_PROM_TIEMPO_RESPUESTA] = ISNULL([CTE].[PROM_TIEMPO_RESPUESTA],0)&#xA;&#x9;&#x9;,[TAR_PROM_TIEMPO_CORRIDO] = ISNULL([CTE].[PROM_TIEMPO_CORRIDO],0)&#xA;&#x9;&#x9;,[TAR_PROM_TIEMPO_TOTAL] = ISNULL([CTE].[PROM_TIEMPO_TOTAL],0)&#xA;&#x9;&#x9;,[TAR_NUM_TAREAS] = ISNULL([CTE].[NUM_TAREAS],0)&#xA;&#x9;&#x9;,[TAR_NUM_TAREAS_CERRADA] = ISNULL([CTE].[NUM_TAREAS_CERRADA],0)&#xA;&#x9;&#x9;,[TAR_NUM_TAREAS_PENDIENTE] = ISNULL([CTE].[NUM_TAREAS_PENDIENTE],0)&#xA;--= ISNULL(CTE.VALOR_FLETES_GUIAS,0)&#xA;FROM CTE_TIEMPO_PROMEDIO_RESPUESTA_TAREA CTE&#xA;INNER JOIN TMP.MBCORE_GUIAS TMP WITH(NOLOCK) &#xA;ON TMP.[G_NUMERO_GUIA]=CTE.NUMERO_GUIA &#xA;WHERE CTE.ID=1" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
