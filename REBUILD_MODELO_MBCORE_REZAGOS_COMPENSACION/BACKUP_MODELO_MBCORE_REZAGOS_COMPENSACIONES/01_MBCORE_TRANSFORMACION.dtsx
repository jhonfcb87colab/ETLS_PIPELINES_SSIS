                DTS:FilterKind="0" />
              <DTS:ObjectData>
                <pipeline
                  version="1">
                  <components>
                    <component
                      refId="Package\38 ACTUALIZACION UBICACION BODEGA Y REGIONAL INVENATARIOS FISICOS\39 03 ACTUALIZACION BODEGA Y REGIONAL UBICACION INVENARIO FISICO\Paso 39 03 EXTRAE MBCORE BODEGA Y REGIONAL TB DG NOVEDAD\EXTRACCION DE BODEGAS  CON LOS ULTIMOS MOVIMEINTOS"
                      componentClassID="Microsoft.OLEDBSource"
                      contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                      description="OLE DB Source"
                      name="EXTRACCION DE BODEGAS  CON LOS ULTIMOS MOVIMEINTOS"
                      usesDispositions="true"
                      version="7">
                      <properties>
                        <property
                          dataType="System.Int32"
                          description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                          name="CommandTimeout">0</property>
                        <property
                          dataType="System.String"
                          description="Specifies the name of the database object used to open a rowset."
                          name="OpenRowset"></property>
                        <property
                          dataType="System.String"
                          description="Specifies the variable that contains the name of the database object used to open a rowset."
                          name="OpenRowsetVariable"></property>
                        <property
                          dataType="System.String"
                          description="The SQL command to be executed."
                          name="SqlCommand"
                          UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">DECLARE @FECHA_INICIAL DATETIME = CONVERT(DATETIME,CONVERT(DATE,CONVERT(DATETIME,GETDATE()-4)));
DECLARE @FECHA_FINAL DATETIME = CONVERT(DATETIME,CONVERT(DATE,CONVERT(DATETIME,GETDATE()+1)));


--DECLARE @FECHA_INICIAL DATETIME = CONVERT(DATETIME,CONVERT(DATE,CONVERT(DATETIME,'2022-01-01')));
--DECLARE @FECHA_FINAL DATETIME = CONVERT(DATETIME,CONVERT(DATE,CONVERT(DATETIME,'2022-09-02')));



  DECLARE @LOCAL_TABLEVARIABLE_NUMERO_GUIA202208130853 TABLE(NUMERO_GUIA NUMERIC(20,0));

  INSERT INTO @LOCAL_TABLEVARIABLE_NUMERO_GUIA202208130853
  --SELECT * FROM  @LOCAL_TABLEVARIABLE_NUMERO_GUIA202208130853
  	   SELECT DISTINCT
					GUI2.NUMERO_GUIA
					FROM DBO.GUIAS GUI2 WITH(NOLOCK)
						INNER JOIN  DBO.SEGUIMIENTO_ENVIO SEG2 WITH (NOLOCK)
						ON GUI2.NUMERO_GUIA=SEG2.NUMERO_GUIA
						INNER JOIN  DBO.DOCUMENTOS DOC2 WITH (NOLOCK) 
						ON (SEG2.ID_PROCESO=DOC2.ID_PROCESO AND SEG2.NUMERO_MOVIMI=DOC2.NUMERO_MOVIMI AND SEG2.CONSECUT_MOVIMI=DOC2.CONSECUT_MOVIMI)

						WHERE
						GUI2.FECHA_MODIFICACION_DG	
						BETWEEN 
							@FECHA_INICIAL
						AND 
							@FECHA_FINAL
						AND 
						DOC2.ID_DIVISION_DESTINO IN 
							(
							8438,9209,8776,8576,8023,9238,92134,8011,8806,8821,9235,9236,9237,9239,9240,
							9241,19209,91441,94698,8791,8155,8701,8191,8119,8035,8167,8492,8731,8450,8462,
							8107,8095,8203,8716,8131,8408,8179,9265,8143,8047,9959,8059,8071,8510,
							8420,8239,8083,8215,8227
							)


--SELECT * FROM @LOCAL_TABLEVARIABLE_NUMERO_GUIA202208130853

	SELECT ROW_NUMBER ( )   OVER ( PARTITION BY GUI.[NUMERO_GUIA] order by SEG.FECHA_HORA_MOVIMIENTO desc )  id,  
		 DIVISION_DESTINO = DIV.[NOMBRE_DIVISION]
		 ,DIVISION_ORIGEN = DIV2.[NOMBRE_DIVISION]
		,GUI.[NUMERO_GUIA]
		,SEG.FECHA_HORA_MOVIMIENTO
		,GUI.FECHA_MODIFICACION_DG
		,REGIO.NOMBRE_REGIONAL AS REGIONAL_DESTINO
		,REGIO2.NOMBRE_REGIONAL AS REGIONAL_ORIGEN
		,CIUD.NOMBRE_CIUDAD AS CIUDAD_DESTINO
		,CIUD2.NOMBRE_CIUDAD AS CIUDAD_ORIGEN
		,SEG.ID_PROCESO
		,PR.NOMBRE_PROCESO_LOG

		--,SEG.NUMERO_MOVIMI
		--,SEG.CONSECUT_MOVIMI
	FROM DBO.GUIAS GUI WITH(NOLOCK)
	INNER JOIN  DBO.SEGUIMIENTO_ENVIO SEG WITH (NOLOCK)
	ON GUI.NUMERO_GUIA=SEG.NUMERO_GUIA
	INNER JOIN  DBO.DOCUMENTOS DOC WITH (NOLOCK) 
	ON (SEG.ID_PROCESO=DOC.ID_PROCESO AND SEG.NUMERO_MOVIMI=DOC.NUMERO_MOVIMI AND SEG.CONSECUT_MOVIMI=DOC.CONSECUT_MOVIMI)
	INNER JOIN PARAMETROS..DIVISIONES DIV WITH (NOLOCK)
	ON (DIV.ID_DIVISION=DOC.ID_DIVISION_DESTINO AND DOC.ID_CIUDAD_DESTINO=DIV.ID_CIUDAD) 
	INNER JOIN PARAMETROS..DIVISIONES DIV2 WITH (NOLOCK)
	ON (DIV2.ID_DIVISION=DOC.ID_DIVISION_ORIGEN AND DOC.ID_CIUDAD_DIVISION_ORIGEN=DIV2.ID_CIUDAD)
	INNER JOIN PARAMETROS..PROCESOS  PR WITH (NOLOCK) ON (SEG.ID_PROCESO=PR.ID_PROCESO)
	INNER JOIN PARAMETROS..CIUDADES CIUD WITH (NOLOCK) ON (CIUD.ID_CIUDAD=DOC.ID_CIUDAD_DESTINO)
	INNER JOIN PARAMETROS..REGIONALES_PAIS REGIO WITH (NOLOCK) ON (REGIO.ID_REGIONAL=CIUD.ID_REGIONAL)

	INNER JOIN PARAMETROS..CIUDADES CIUD2 WITH (NOLOCK) ON (CIUD2.ID_CIUDAD=DOC.ID_CIUDAD_DIVISION_ORIGEN)
	INNER JOIN PARAMETROS..REGIONALES_PAIS REGIO2 WITH (NOLOCK) ON (REGIO2.ID_REGIONAL=CIUD2.ID_REGIONAL)
	--INNER JOIN @LOCAL_TABLEVARIABLE_NUMERO_GUIA202208130853 AS GTR
	--ON GRT.NUMERO_GUIA=GUI.NUMERO_GUIA
	WHERE 
       GUI.NUMERO_GUIA
	   IN
	   ( 
	     SELECT [NUMERO_GUIA] FROM @LOCAL_TABLEVARIABLE_NUMERO_GUIA202208130853
	   )
















/*
WITH CTE_MBCORE
(
	id,
	DIVISION_DESTINO,
	DIVISION_ORIGEN,
	NUMERO_GUIA,
	FECHA_HORA_MOVIMIENTO,
	FECHA_MODIFICACION_DG,
	REGIONAL_DESTINO,
	REGIONAL_ORIGEN,
	CIUDAD_DESTINO,
	CIUDAD_ORIGEN,
	ID_PROCESO,
	NOMBRE_PROCESO_LOG

		--	,NUMERO_MOVIMI
		--,CONSECUT_MOVIMI
)
AS(
	SELECT ROW_NUMBER ( )   OVER ( PARTITION BY GUI.[NUMERO_GUIA] order by SEG.FECHA_HORA_MOVIMIENTO desc )  id,  
		 DIVISION_DESTINO = DIV.[NOMBRE_DIVISION]
		 ,DIVISION_ORIGEN = DIV2.[NOMBRE_DIVISION]
		,GUI.[NUMERO_GUIA]
		,SEG.FECHA_HORA_MOVIMIENTO
		,GUI.FECHA_MODIFICACION_DG
		,REGIO.NOMBRE_REGIONAL AS REGIONAL_DESTINO
		,REGIO2.NOMBRE_REGIONAL AS REGIONAL_ORIGEN
		,CIUD.NOMBRE_CIUDAD AS CIUDAD_DESTINO
		,CIUD2.NOMBRE_CIUDAD AS CIUDAD_ORIGEN
		,SEG.ID_PROCESO
		,PR.NOMBRE_PROCESO_LOG

		--,SEG.NUMERO_MOVIMI
		--,SEG.CONSECUT_MOVIMI
	FROM DBO.GUIAS GUI WITH(NOLOCK)
	INNER JOIN  DBO.SEGUIMIENTO_ENVIO SEG WITH (NOLOCK)
	ON GUI.NUMERO_GUIA=SEG.NUMERO_GUIA
	INNER JOIN  DBO.DOCUMENTOS DOC WITH (NOLOCK) 
	ON (SEG.ID_PROCESO=DOC.ID_PROCESO AND SEG.NUMERO_MOVIMI=DOC.NUMERO_MOVIMI AND SEG.CONSECUT_MOVIMI=DOC.CONSECUT_MOVIMI)
	INNER JOIN PARAMETROS..DIVISIONES DIV WITH (NOLOCK)
	ON (DIV.ID_DIVISION=DOC.ID_DIVISION_DESTINO AND DOC.ID_CIUDAD_DESTINO=DIV.ID_CIUDAD) 
	INNER JOIN PARAMETROS..DIVISIONES DIV2 WITH (NOLOCK)
	ON (DIV2.ID_DIVISION=DOC.ID_DIVISION_ORIGEN AND DOC.ID_CIUDAD_DIVISION_ORIGEN=DIV2.ID_CIUDAD)
	INNER JOIN PARAMETROS..PROCESOS  PR WITH (NOLOCK) ON (SEG.ID_PROCESO=PR.ID_PROCESO)
	INNER JOIN PARAMETROS..CIUDADES CIUD WITH (NOLOCK) ON (CIUD.ID_CIUDAD=DOC.ID_CIUDAD_DESTINO)
	INNER JOIN PARAMETROS..REGIONALES_PAIS REGIO WITH (NOLOCK) ON (REGIO.ID_REGIONAL=CIUD.ID_REGIONAL)

	INNER JOIN PARAMETROS..CIUDADES CIUD2 WITH (NOLOCK) ON (CIUD2.ID_CIUDAD=DOC.ID_CIUDAD_DIVISION_ORIGEN)
	INNER JOIN PARAMETROS..REGIONALES_PAIS REGIO2 WITH (NOLOCK) ON (REGIO2.ID_REGIONAL=CIUD2.ID_REGIONAL)


	WHERE 
	(DIV2.NOMBRE_DIVISION LIKE '%COMPENSACION%' 
	OR DIV2.NOMBRE_DIVISION LIKE '%REZAGO%'
	OR DIV.NOMBRE_DIVISION LIKE '%COMPENSACION%' 
	OR DIV.NOMBRE_DIVISION LIKE '%REZAGO%')
	AND
    GUI.FECHA_MODIFICACION_DG	
    BETWEEN 
		@FECHA_INICIAL
    AND 
		@FECHA_FINAL
		--AND GUI.NUMERO_GUIA=522681989
)
SELECT 
	id,
	DIVISION_DESTINO,
	DIVISION_ORIGEN,
	NUMERO_GUIA,
	FECHA_HORA_MOVIMIENTO,
	FECHA_MODIFICACION_DG,
	REGIONAL_DESTINO,
	REGIONAL_ORIGEN,
	CIUDAD_DESTINO,
	CIUDAD_ORIGEN,
	ID_PROCESO,
	NOMBRE_PROCESO_LOG
	FROM CTE_MBCORE
WHERE ID =1
*/</property>
