          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="WITH CTE_CANALCORPORATIVO&#xA;(&#xA;&#x9; G_NUMERO_GUIA&#xA;&#x9;,ID_GEOGRAFIA_SERV_ORIG&#xA;&#x9;,ID_GEOGRAFIA_SERV_DEST&#xA;)&#xA;AS&#xA;&#x9;(&#xA;&#x9;&#x9;SELECT&#xA;&#x9;&#x9;&#x9;   TMP.[G_NUMERO_GUIA]&#xA;&#x9;&#x9;&#x9;  ,CASE WHEN [DES_CIUDADREMITENTE] IS NULL THEN -888 ELSE [DES_CIUDADREMITENTE] END ID_GEOGRAFIA_SERV_ORIG&#xA;&#x9;&#x9;&#x9;  ,CASE WHEN [DES_CIUDAD] IS NULL THEN -888 ELSE [DES_CIUDAD] END ID_GEOGRAFIA_SERV_DEST&#xA;&#x9;&#x9;FROM            &#xA;&#x9;&#x9;&#x9;[TMP].[MBCORE_GUIAS] TMP WITH (NOLOCK) &#xA;&#x9;&#x9;INNER JOIN &#xA;&#x9;&#x9;&#x9;[SCN].[SERT_ENVIO] S WITH (NOLOCK)&#xA;&#x9;&#x9;ON &#xA;&#x9;&#x9;&#x9;S.NUM_GUIA = TMP.[G_NUMERO_GUIA]&#xA;&#x9;)&#xA;UPDATE &#xA;&#x9;[TMP].[MBCORE_GUIAS]&#xA;SET &#xA;&#x9;G_CANAL = 'CORPORATIVO'&#xA;&#x9;,G_ID_CIUDAD_CANAL_ORIGEN = ISNULL(CTE.ID_GEOGRAFIA_SERV_ORIG,-888)&#xA;&#x9;,G_ID_CIUDAD_CANAL_DESTINO = ISNULL(CTE.ID_GEOGRAFIA_SERV_DEST,-888)&#xA;FROM &#xA;&#x9;[TMP].[MBCORE_GUIAS] TMP WITH (NOLOCK) &#xA;&#x9;INNER JOIN CTE_CANALCORPORATIVO CTE&#xA;ON &#xA;TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
