          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="PASO 38 00  ACTUALIZAR BODEGA Y REGIONAL ULTIMA UBICACION ESTANDAR REPETIR PASO 16_01"
          DTS:ThreadHint="0">
