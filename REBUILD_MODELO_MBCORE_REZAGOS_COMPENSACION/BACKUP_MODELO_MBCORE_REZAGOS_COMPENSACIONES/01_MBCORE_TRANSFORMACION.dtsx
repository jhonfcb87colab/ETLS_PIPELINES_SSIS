          SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
          SQLTask:SqlStatementSource="WITH CTE_TIPOCOBRO&#xA;(&#xA;&#x9; G_NUMERO_GUIA&#xA;&#x9;,TC_PROCESO&#xA;&#x9;&#xA;)&#xA;AS&#xA;&#x9;(&#xA;&#x9;&#x9;SELECT &#xA;&#x9;&#x9;&#x9; TMP.G_NUMERO_GUIA&#xA;&#x9;&#x9;&#x9;,TC.TC_ID_PROCESO&#xA;&#x9;&#x9;&#x9;&#xA;&#x9;&#x9;FROM &#xA;&#x9;&#x9;&#x9; [TMP].[MBCORE_GUIAS] TMP WITH (NOLOCK)&#xA;&#x9;&#x9;INNER JOIN &#xA;&#x9;&#x9;&#x9;[TMP].[MBCORE_GUIAS_05_INFTBCL] TC WITH (NOLOCK)&#xA;&#x9;&#x9;ON &#xA;&#x9;&#x9;&#x9;TMP.G_NUMERO_GUIA = TC.TC_NUMERO_GUIA&#xA;&#x9;)&#xA;UPDATE &#xA;&#x9; [TMP].[MBCORE_GUIAS]&#xA;SET &#xA;&#x9; TC_PROCESO = CTE.TC_PROCESO&#xA;&#x9; &#xA;&#x9;&#xA;FROM &#xA;&#x9;[TMP].[MBCORE_GUIAS] TMP WITH (NOLOCK) &#xA;&#x9;INNER JOIN CTE_TIPOCOBRO CTE&#xA;ON &#xA;&#x9;TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
