              version="1">
              <components>
                <component
                  refId="Package\41 00 GUIAS EN ATENCION CLIENTE TAREAS\Paso 41 01 Calculo Tiempo Promedio Respuesta Tarea\Consulta SIG_COL_LOGISTICA ATENCION CLIENTE TAREAS"
                  componentClassID="Microsoft.OLEDBSource"
                  contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                  description="OLE DB Source"
                  name="Consulta SIG_COL_LOGISTICA ATENCION CLIENTE TAREAS"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">WITH CTE_PROMEDIO_TIEMPO_RESPUESTA_TAREAS
(
	TIME_ID	
	,NUMERO_GUIA	
	,PROM_TIEMPO_RESPUESTA	
	,PROM_TIEMPO_ASIGNACION	
	,PROM_TIEMPO_MODIFICACION	
	,PROM_TIEMPO_CORRIDO	
	,PROM_TIEMPO_TOTAL	
	,NUM_TAREAS
	,[NUM_TAREAS_CERRADA]
	,[NUM_TAREAS_PENDIENTE]
) AS (
SELECT 
	MIN(TR.[TIME_ID]) [TIME_ID]
	,TR.NUMERO_DOC_PROBLEMA AS NUMERO_GUIA
	,SUM(TR.[TIEMPO_RESPUESTA])/SUM(TR.[NUM_TAREAS]) [PROM_TIEMPO_RESPUESTA]
	,SUM(TR.[TIEMPO_ASIGNACION])/SUM(TR.[NUM_TAREAS]) [PROM_TIEMPO_ASIGNACION]
	,SUM(TR.[TIEMPO_MODIFICACION])/SUM(TR.[NUM_TAREAS]) [PROM_TIEMPO_MODIFICACION]
	,SUM(TR.[TIEMPO_CORRIDO])/SUM(TR.[NUM_TAREAS]) [PROM_TIEMPO_CORRIDO]
	,SUM(TR.[TIEMPO_TOTAL])/SUM(TR.[NUM_TAREAS]) [PROM_TIEMPO_TOTAL]
	,SUM(TR.[NUM_TAREAS]) [NUM_TAREAS]
	,SUM(CASE WHEN TR.[ID_EST_TAREA] = 0 THEN (TR.[NUM_TAREAS]) ELSE 0 END) [NUM_TAREAS_CERRADA]
	,SUM(CASE WHEN TR.[ID_EST_TAREA] = 1 THEN (TR.[NUM_TAREAS]) ELSE 0 END) [NUM_TAREAS_PENDIENTE]
FROM [FAC].[ATENCION_CLIENTE_ESTADO_TAREAS] TR WITH (NOLOCK)
INNER JOIN DIM.ESTADO_RESPUESTA DM WITH (NOLOCK) 
	ON TR.ID_RESPUESTA_TAREA=DM.ID_ESTADO_RESPUESTA
WHERE 	
 ISNUMERIC(NUMERO_DOC_PROBLEMA)=1 AND
SIG_COLOMBIA_DW.[dbo].[Limpiar_Carcateres](NUMERO_DOC_PROBLEMA, '^0-9') 
	in (SELECT convert(varchar,TMPGUI.G_NUMERO_GUIA) G_NUMERO_GUIA FROM TMP.MBCORE_GUIAS TMPGUI WITH (NOLOCK) )  AND
---TR.NUMERO_DOC_PROBLEMA = '3039359950' AND
DM.NOMBRE_ESTADORESPUESTA &lt;&gt; 'CANCELADA'
GROUP BY TR.NUMERO_DOC_PROBLEMA 
)
SELECT
	TIME_ID	
	,CONVERT([numeric](20, 0),SIG_COLOMBIA_DW.[dbo].[Limpiar_Carcateres](NUMERO_GUIA, '^0-9')) NUMERO_GUIA	
	,PROM_TIEMPO_RESPUESTA	
	,PROM_TIEMPO_CORRIDO	
	,PROM_TIEMPO_TOTAL	
	,NUM_TAREAS
	,[NUM_TAREAS_CERRADA]
	,[NUM_TAREAS_PENDIENTE]
	FROM CTE_PROMEDIO_TIEMPO_RESPUESTA_TAREAS</property>
