    <DTS:Executable
      DTS:refId="Package\Paso 40 00 Actualizar Campo Valor del Flete"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{ECE38876-8B10-42CC-A4CC-CE0470798416}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Paso 40 00 Actualizar Campo Valor del Flete"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:LoggingOptions
        DTS:FilterKind="0" />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
          SQLTask:SqlStatementSource="WITH CTE_VALOR_FLETES_GUIAS&#xA;(&#xA;id&#x9;&#xA;,NUMERO_GUIA&#x9;&#xA;,VALOR_FLETES_GUIAS&#xA;)AS (&#xA;&#x9;SELECT ROW_NUMBER ( )   OVER ( PARTITION BY GUI.[NUMERO_GUIA] order by GUI.FECHA_MODIFICACION_DG desc )  id,  &#xA;&#x9;&#x9; TMP.[G_NUMERO_GUIA],&#xA;&#x9;&#x9; GUI.[VALOR_FLETES_GUIAS]&#x9; &#xA;&#x9;&#x9;FROM   SIG_COLOMBIA_DW.LOG.GUIAS  GUI WITH(NOLOCK)&#xA;&#x9;&#x9;INNER JOIN TMP.MBCORE_GUIAS TMP WITH(NOLOCK) ON TMP.[G_NUMERO_GUIA]=GUI.[NUMERO_GUIA] &#xA;)&#xA;UPDATE   TMP&#xA;SET &#xA;VALOR_FLETES_GUIAS = ISNULL(CTE.VALOR_FLETES_GUIAS,0)&#xA;FROM CTE_VALOR_FLETES_GUIAS CTE&#xA;INNER JOIN TMP.MBCORE_GUIAS TMP WITH(NOLOCK) ON TMP.[G_NUMERO_GUIA]=CTE.NUMERO_GUIA &#xA;WHERE id=1" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\PASOS 33 34 35"
      DTS:CreationName="STOCK:SEQUENCE"
      DTS:Description="Sequence Container"
      DTS:DTSID="{248D0E35-9B47-4A1A-93FE-BC4EC329C8AB}"
