	,[TAR_NUM_TAREAS_PENDIENTE] = ISNULL([TAR_NUM_TAREAS_PENDIENTE] ,0)
   ,[G_NOMBRE_REMITENTE] = ISNULL([G_NOMBRE_REMITENTE],'NO DISPONIBLE')
   ,[G_TELEFONO_REMITE_GUIA]  = ISNULL([G_TELEFONO_REMITE_GUIA],'0')
,[G_ID_REMITE] = ISNULL([G_ID_REMITE],'0')
FROM TMP.MBCORE_GUIAS TMP WITH (NOLOCK)</property>
