    ,ID_ESTADO_INDEMNIZACION=ISNULL(ID_ESTADO_INDEMNIZACION,-888)
    ,ESTADO_INDEMNIZACION=ISNULL(ESTADO_INDEMNIZACION,'NO DISPONIBLE')
    ,DURACION_COMPENSACIONES=ISNULL(DURACION_COMPENSACIONES,0)
    ,DURACION_REZAGOS=ISNULL(DURACION_REZAGOS,0)
    ,VALIDACION_SE_FECHA_ULTI_MOVI=SE_FECHA_ULTI_MOVI
    ,VALIDACION_G_ID_FECHA=G_ID_FECHA
	
,VEJEZ = ROUND(CONVERT(FLOAT,CONVERT(DATETIME,
						CASE WHEN SE_FECHA_ULTI_MOVI IS NULL OR SE_FECHA_ULTI_MOVI='' OR LEN(SE_FECHA_ULTI_MOVI)=0 OR SE_FECHA_ULTI_MOVI='NO DISPONIBLE' 
						THEN GETDATE() ELSE SE_FECHA_ULTI_MOVI END
						)
						-CONVERT(DATETIME,IIF(G_ID_FECHA&lt;='1900-01-01',GETDATE(),G_ID_FECHA))),2)

/*    
,VEJEZ=ROUND(CONVERT(FLOAT,CONVERT(DATETIME,SE_FECHA_ULTI_MOVI)-CONVERT(DATETIME,G_ID_FECHA)),2)
*/
    ,CUN=ISNULL(CUN,-888)
    ,Nombre_destinatario=ISNULL(Nombre_destinatario,'NO DISPONIBLE')
    ,TIPO_COBRO	= ISNULL(GR_TIPO_COBRO,'NO DISPONIBLE') 
    ,VALOR_RECAUDAR = ISNULL(GRIR_VALOR_RECAUDAR,0)
