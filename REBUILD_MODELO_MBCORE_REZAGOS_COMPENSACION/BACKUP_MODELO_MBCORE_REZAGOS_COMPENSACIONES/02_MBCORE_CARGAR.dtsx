    ,SE_CANT_SZU=ISNULL(SE_CANT_SZU,0)
    ,SE_ID_FECHA_SZU=CONVERT(INT,CONVERT(DATETIME,CONVERT(DATE,CONVERT(DATETIME,ISNULL(SE_ID_FECHA_SZU,'1900-01-01')))))
    ,SE_FECHA_SZU=ISNULL(SE_FECHA_SZU,'1900-01-01')
    ,SE_ID_CONC_SZU=ISNULL(SE_ID_CONC_SZU,-888)
    ,SE_CONC_SZU=ISNULL(SE_CONC_SZU,'NO DISPONIBLE')
    ,SE_ID_CANT_DZU=ISNULL(SE_ID_CANT_DZU,0)
    ,SE_ID_ULTI=ISNULL(SE_ID_ULTI,-888)
    ,SE_ID_SZU=ISNULL(SE_ID_SZU,'NO DISPONIBLE')
    ,ID_CIUDAD_ULTI_MOVI=ISNULL(DOC_ID_CIUDAD_ULTI_MOVI,-888)
    ,CIUDAD_ULTI_MOVI=ISNULL(DOC_CIUDAD_ULTI_MOVI,'NO DISPONIBLE')
