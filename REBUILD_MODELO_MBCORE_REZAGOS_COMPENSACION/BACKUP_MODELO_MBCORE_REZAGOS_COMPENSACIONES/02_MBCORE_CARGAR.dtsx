    ,NOMBRE_CLIENTE=ISNULL(G_CLIENTE,'NO DISPONIBLE')
    ,ID_ESTADO_ENVIO=ISNULL(G_ID_ESTADO_ENVIO,-888)
    ,ESTADO_ENVIO=ISNULL(G_ESTADO_ENVIO,'NO DISPONIBLE')
    ,ID_PAIS_UBICACION=ISNULL(G_ID_PAIS_UBICACION,-888)
    ,ID_CIUDAD_UBICACION=ISNULL(G_ID_CIUDAD_UBICACION,-888)
    ,ID_DIVISION_UBICACION=ISNULL(G_ID_DIVISION_UBICACION,-888)
    ,VALOR_DECLARADO=ISNULL(G_VALOR_DECLARADO,0)
    ,ID_BODEGA_ULTM_MOVI=ISNULL(G_ID_BODEGA_ULTM_MOVI,'NO DISPONIBLE')
    ,CANAL=ISNULL(G_CANAL,'NO DISPONIBLE')
    ,ID_CIUDAD_CANAL_ORIGEN=ISNULL(G_ID_CIUDAD_CANAL_ORIGEN,-888)
    ,CIUDAD_CANAL_ORIGEN=ISNULL(G_CIUDAD_CANAL_ORIGEN,'NO DISPONIBLE')
    ,DEPARTAMENTO_CANAL_ORIGEN=ISNULL(G_DEPARTAMENTO_CANAL_ORIGEN,'NO DISPONIBLE')
