    ,ESTADOFISICO=ISNULL(ESTADOFISICO,'NO DISPONIBLE')
    ,FECHA_BOD_Rezagos=ISNULL(FECHA_BOD_Rezagos,'1900-01-01')
    ,FECHA_BOD_Compensaciones=ISNULL(FECHA_BOD_Compensaciones,'1900-01-01')
    ,Numero_veces_compensaicones=ISNULL(Numero_veces_compensaicones,0)
    ,Numero_veces_rezagos=ISNULL(Numero_veces_rezagos,0)
    ,Numero_piezas_rezagos=ISNULL(Numero_piezas_rezagos,0)
