                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT 
    GUIA =G_NUMERO_GUIA
    ,TIME_ID =CONVERT(INT,CONVERT(DATETIME,CONVERT(DATE,CONVERT(DATETIME,G_ID_FECHA))))
    ,FECHA_INICIO =G_FECHA
    ,NUMERO_PIEZAS =ISNULL(G_NUMERO_PIEZAS,0)
    ,TIEMPO_ENTREGA =ISNULL(G_ID_TIEMPO_ENTREGA,-888)
    ,NOMBRE_TIEMPO_ENTREGA =ISNULL(G_TIEMPO_ENTREGA,'NO DISPONIBLE')
    ,ID_PRODUCTO =ISNULL(G_ID_PRODUCTO,-888)
    ,PRODUCTO=ISNULL(G_PRODUCTO,'NO DISPONIBLE')
