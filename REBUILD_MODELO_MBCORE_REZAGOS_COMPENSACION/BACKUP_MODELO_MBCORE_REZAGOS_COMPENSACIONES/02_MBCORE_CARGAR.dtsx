    ,ID_CIUDAD_CANAL_DESTINO=ISNULL(G_ID_CIUDAD_CANAL_DESTINO,-888)
    ,CIUDAD_CANAL_DESTINO=ISNULL(G_CIUDAD_CANAL_DESTINO,'NO DISPONIBLE')
    ,DEPARTAMENTO_CANAL_DESTINO=ISNULL(G_DEPARTAMENTO_CANAL_DESTINO,'NO DISPONIBLE')
    ,REGIONAL_CANAL_DESTINO=ISNULL(G_REGIONAL_CANAL_DESTINO,'NO DISPONIBLE')
    ,SE_ID_FECHA_EZU=CONVERT(INT,CONVERT(DATETIME,CONVERT(DATE,CONVERT(DATETIME,ISNULL(SE_ID_FECHA_EZU,'1900-01-01')))))
    ,SE_FECHA_EZU=ISNULL(SE_FECHA_EZU,'NO DISPONIBLE')
