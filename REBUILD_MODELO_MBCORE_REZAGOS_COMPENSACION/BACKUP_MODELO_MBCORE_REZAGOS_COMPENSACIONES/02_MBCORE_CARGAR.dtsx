	,[CR_REGIONAL_UBICACION] = ISNULL([CR_REGIONAL_UBICACION] ,'NO DISPONIBLE')
	
	,[VALOR_FLETES_GUIAS] = ISNULL([VALOR_FLETES_GUIAS] ,0)
	,[CR_ID_APLICA_COMPENSACIONES] = ISNULL([CR_ID_APLICA_COMPENSACIONES] ,0)
