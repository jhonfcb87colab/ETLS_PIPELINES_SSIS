                <component
                  refId="Package\CONTRUCCION DIM PROCESOS DIVISION TAREAS\DIMENSION TAREAS\PROCESOS DIVISION  ATENCION CLIENTE TAERAS SIG COLOGISTICA"
                  componentClassID="Microsoft.OLEDBSource"
                  contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                  description="OLE DB Source"
                  name="PROCESOS DIVISION  ATENCION CLIENTE TAERAS SIG COLOGISTICA"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">WITH CTE_DIM_PROCESO_TAREAS
 (
 ID
 ,FECHA	
 ,NUMERO_GUIA
 ,ID_DIVISION
 ,NOMBRE_DIVISION
 )
 AS (
	 SELECT 
	 ROW_NUMBER ( )   OVER ( PARTITION BY NUMERO_GUIA order by FECHA desc ) ID
	 ,FECHA
	 ,NUMERO_GUIA
	 ,ID_DIVISION
	 ,NOMBRE_DIVISION
		   FROM (
				 SELECT
				 FECHA
						,NUMERO_GUIA = CONVERT([numeric](20, 0),SIG_COLOMBIA_DW.[dbo].[Limpiar_Carcateres](TAR.NUMERO_DOC_PROBLEMA, '^0-9')) 	
						,TAR.ID_DIVISION
						,DV.NOMBRE_DIVISION
				 FROM FAC.ATENCION_CLIENTE_ESTADO_TAREAS TAR WITH(NOLOCK)
				 INNER JOIN DIM.DIVISIONES DV WITH(NOLOCK)
				 ON DV.ID_CIUDAD=TAR.ID_CIUDAD AND DV.ID_DIVISION=TAR.ID_DIVISION
				 WHERE ISNUMERIC(TAR.NUMERO_DOC_PROBLEMA)=1
				 AND CONVERT(DATETIME,TIME_ID)&gt;=DATEADD(yy,-4,DATEADD(yy,DATEDIFF(yy,0,GETDATE()),0))
				 ) AS TABLA
	)
SELECT  
ID
 ,NUMERO_GUIA
 ,ID_DIVISION
 ,NOMBRE_DIVISION
FROM CTE_DIM_PROCESO_TAREAS
WHERE ID=1</property>
