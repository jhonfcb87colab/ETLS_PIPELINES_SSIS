                <SQLTask:SqlTaskData
                  SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
                  SQLTask:SqlStatementSource="TRUNCATE TABLE TMP.MBCORE_GUIAS_09&#xA;&#xA;&#xA;;WITH CTE &#xA;(&#xA;&#x9; ID&#xA;&#x9;,NUMERO_GUIA&#xA;&#x9;,FECHA_CONFIRMACION&#xA;&#x9;,ID_SOLUCION&#xA;)&#xA;AS&#xA;(&#xA;SELECT &#xA;&#x9; ROW_NUMBER() OVER(PARTITION BY NUMERO_GUIA ORDER BY FECHA_CONFIRMACION DESC) ID&#xA;&#x9;,CONF.NUMERO_GUIA&#xA;&#x9;,CONF.FECHA_CONFIRMACION&#xA;&#x9;,CONF.ID_SOLUCION&#xA;FROM &#xA;&#x9;SIG_COLOMBIA_DW.LOG.CONFIRMACIONES CONF WITH (NOLOCK)&#xA;INNER JOIN &#xA;&#x9;TMP.MBCORE_GUIAS TMP WITH (NOLOCK)&#xA;ON &#xA;&#x9;CONF.NUMERO_GUIA = TMP.G_NUMERO_GUIA&#xA;)&#xA;INSERT INTO TMP.MBCORE_GUIAS_09&#xA;(&#xA;&#x9; ID&#xA;&#x9;,G_NUMERO_GUIA&#xA;&#x9;,FECHA_CONFIRMACION&#xA;&#x9;,ID_SOLUCION&#xA;)&#xA;SELECT &#xA;&#x9; CTE.ID&#xA;&#x9;,CTE.NUMERO_GUIA&#xA;&#x9;,CTE.FECHA_CONFIRMACION&#xA;&#x9;,CTE.ID_SOLUCION&#xA;FROM &#xA;&#x9;CTE&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
