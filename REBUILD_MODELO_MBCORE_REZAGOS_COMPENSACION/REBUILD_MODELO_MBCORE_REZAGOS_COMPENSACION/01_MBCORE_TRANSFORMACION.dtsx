            <DTS:Executable
              DTS:refId="Package\PASO 30 ACTUALIZAR CAMPOS NUEVOS MBCORE\PASO 30 05 ACTUALIZAR ESTADO FISICO\PASO 30 05 02"
              DTS:CreationName="Microsoft.ExecuteSQLTask"
              DTS:Description="Execute SQL Task"
              DTS:DTSID="{685CFEB4-C9BC-44D4-8BB8-A49BD139726F}"
              DTS:ExecutableType="Microsoft.ExecuteSQLTask"
              DTS:LocaleID="-1"
              DTS:ObjectName="PASO 30 05 02"
              DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
              DTS:ThreadHint="0">
              <DTS:Variables />
              <DTS:LoggingOptions
                DTS:FilterKind="0" />
              <DTS:ObjectData>
                <SQLTask:SqlTaskData
                  SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
                  SQLTask:SqlStatementSource="UPDATE &#xA;&#x9;TMP&#xA;SET&#xA;&#x9; ESTADOFISICO = ISNULL (TMPESTFI.NOMBRE_ESTA_FISICO,'NO DISPONIBLE')&#xA;&#x9;&#xA;FROM &#xA;&#x9;TMP.MBCORE_GUIAS TMP WITH (NOLOCK) &#xA;&#x9;INNER JOIN [TMP].[MBCORE_GUIAS_21] TMPESTFI WITH (NOLOCK) &#xA;ON&#xA;&#x9;TMP.G_NUMERO_GUIA = TMPESTFI.NUMERO_GUIA" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
              </DTS:ObjectData>
            </DTS:Executable>
          </DTS:Executables>
          <DTS:PrecedenceConstraints>
            <DTS:PrecedenceConstraint
              DTS:refId="Package\PASO 30 ACTUALIZAR CAMPOS NUEVOS MBCORE\PASO 30 05 ACTUALIZAR ESTADO FISICO.PrecedenceConstraints[Constraint 4]"
              DTS:CreationName=""
              DTS:DTSID="{31DF11B2-B048-4021-967A-726FA67E3206}"
              DTS:From="Package\PASO 30 ACTUALIZAR CAMPOS NUEVOS MBCORE\PASO 30 05 ACTUALIZAR ESTADO FISICO\PASO 30 05 01"
              DTS:LogicalAnd="True"
              DTS:ObjectName="Constraint 4"
              DTS:To="Package\PASO 30 ACTUALIZAR CAMPOS NUEVOS MBCORE\PASO 30 05 ACTUALIZAR ESTADO FISICO\PASO 30 05 02" />
          </DTS:PrecedenceConstraints>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\PASO 30 ACTUALIZAR CAMPOS NUEVOS MBCORE\PASO 30 ACTUALIZAR CAMPOS NUEVOS MBCORE PARTE 01"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{DE2E4C2B-FC80-4AE8-95D2-9D967354BBAE}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="PASO 30 ACTUALIZAR CAMPOS NUEVOS MBCORE PARTE 01"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="/*==========================================================================================&#xA;  PASO 30 (01 al 04) - TELEFONO, PESOS FISICOS Y REGIMEN EN TMP.MBCORE_GUIAS&#xA;  ------------------------------------------------------------------------------------------&#xA;  Consolida en UN SOLO UPDATE los 4 UPDATE+CTE originales (Script_02.sql) usando CROSS APPLY.&#xA;&#xA;  Notas de diseno:&#xA;  - Cada CROSS APPLY es un agregado sin GROUP BY (COUNT/MAX), por lo que SIEMPRE devuelve&#xA;    una fila y no descarta guias sin coincidencia.&#xA;  - EXISTE replica el INNER JOIN original: sin coincidencia la columna conserva su valor.&#xA;  - Paso 02 / 03: el ROW_NUMBER() sobre todo el seguimiento se reemplaza por un TOP (1)&#xA;    por guia (ultimo / primer movimiento), resuelto con busqueda indexada por guia.&#xA;  - Paso 04 depende de los pesos de los pasos 02 y 03. En un UPDATE unico el SET lee los&#xA;    valores ANTERIORES de la fila, por eso el CROSS APPLY &quot;NV&quot; calcula los pesos nuevos&#xA;    y el REGIMEN se evalua sobre ellos (mismo resultado que la ejecucion secuencial).&#xA;  - Paso 04 original actualiza todas las guias, por eso este UPDATE no lleva WHERE.&#xA;==========================================================================================*/&#xA;SET NOCOUNT ON;&#xA;&#xA;UPDATE TMP&#xA;SET&#xA;&#x9;----PASO 30 01 TELEFONO DESTINATARIO&#xA;&#x9; TELEFONO_DESTINATARIO = CASE WHEN TEL.EXISTE &gt; 0 THEN ISNULL(TEL.TELEFONO, 'NO DISPONIBLE') ELSE TMP.TELEFONO_DESTINATARIO END&#xA;&#x9;----PASO 30 02 PESO FISICO E (ULTIMO MOVIMIENTO)&#xA;&#x9;,PESO_FISICO_E         = NV.PESO_FISICO_E&#xA;&#x9;----PASO 30 03 PESO FISICO R (PRIMER MOVIMIENTO)&#xA;&#x9;,PESO_FISICO_R         = NV.PESO_FISICO_R&#xA;&#x9;----PASO 30 04 REGIMEN LOGISTICO&#xA;&#x9;,REGIMEN               = RG.REGIMEN&#xA;&#xA;FROM&#xA;&#x9;TMP.MBCORE_GUIAS TMP&#xA;&#xA;&#x9;----PASO 30 01 TELEFONO DESTINATARIO&#xA;&#x9;CROSS APPLY (&#xA;&#x9;&#x9;SELECT COUNT(*) AS EXISTE, MAX(GUI.TELEFONO_DESTINA_GUIA) AS TELEFONO&#xA;&#x9;&#x9;FROM SIG_COLOMBIA_DW.TMP.MBCORE_MECE_LOGISTICO_GUIAS GUI WITH (NOLOCK)&#xA;&#x9;&#x9;WHERE GUI.NUMERO_GUIA = TMP.G_NUMERO_GUIA&#xA;&#x9;) TEL&#xA;&#xA;&#x9;----PASO 30 02 ULTIMO MOVIMIENTO (FECHA DESC)&#xA;&#x9;CROSS APPLY (&#xA;&#x9;&#x9;SELECT COUNT(*) AS EXISTE, MAX(U.PESO_ENVIO) AS PESO&#xA;&#x9;&#x9;FROM (&#xA;&#x9;&#x9;&#x9;SELECT TOP (1) SE.PESO_ENVIO&#xA;&#x9;&#x9;&#x9;FROM SIG_COLOMBIA_DW.TMP.MBCORE_SEGUIMIENTO_ENVIO SE WITH (NOLOCK)&#xA;&#x9;&#x9;&#x9;WHERE SE.NUMERO_GUIA = TMP.G_NUMERO_GUIA&#xA;&#x9;&#x9;&#x9;ORDER BY SE.FECHA_HORA_MOVIMIENTO DESC&#xA;&#x9;&#x9;) U&#xA;&#x9;) PE&#xA;&#xA;&#x9;----PASO 30 03 PRIMER MOVIMIENTO (FECHA ASC)&#xA;&#x9;CROSS APPLY (&#xA;&#x9;&#x9;SELECT COUNT(*) AS EXISTE, MAX(P.PESO_ENVIO) AS PESO&#xA;&#x9;&#x9;FROM (&#xA;&#x9;&#x9;&#x9;SELECT TOP (1) SE.PESO_ENVIO&#xA;&#x9;&#x9;&#x9;FROM SIG_COLOMBIA_DW.TMP.MBCORE_SEGUIMIENTO_ENVIO SE WITH (NOLOCK)&#xA;&#x9;&#x9;&#x9;WHERE SE.NUMERO_GUIA = TMP.G_NUMERO_GUIA&#xA;&#x9;&#x9;&#x9;ORDER BY SE.FECHA_HORA_MOVIMIENTO ASC&#xA;&#x9;&#x9;) P&#xA;&#x9;) PR&#xA;&#xA;&#x9;----VALORES NUEVOS DE PESO (si no hay movimientos se conserva el valor actual)&#xA;&#x9;CROSS APPLY (&#xA;&#x9;&#x9;SELECT&#xA;&#x9;&#x9;&#x9; CASE WHEN PE.EXISTE &gt; 0 THEN PE.PESO ELSE TMP.PESO_FISICO_E END AS PESO_FISICO_E&#xA;&#x9;&#x9;&#x9;,CASE WHEN PR.EXISTE &gt; 0 THEN PR.PESO ELSE TMP.PESO_FISICO_R END AS PESO_FISICO_R&#xA;&#x9;) NV&#xA;&#xA;&#x9;----PASO 30 04 REGIMEN LOGISTICO (sobre los pesos ya actualizados)&#xA;&#x9;CROSS APPLY (&#xA;&#x9;&#x9;SELECT&#xA;&#x9;&#x9;&#x9;CASE WHEN NV.PESO_FISICO_E IS NULL THEN 'NO DISPONIBLE'&#xA;&#x9;&#x9;&#x9;     WHEN NV.PESO_FISICO_R &gt;  5    THEN 'TRANSPORTE CARGA'&#xA;&#x9;&#x9;&#x9;     WHEN NV.PESO_FISICO_R &lt;= 5    THEN 'Mensajería Expresa'&#xA;&#x9;&#x9;&#x9;     ELSE 'NO DISPONIBLE'&#xA;&#x9;&#x9;&#x9;END AS REGIMEN&#xA;&#x9;) RG;&#xA;GO&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\PASO 30 ACTUALIZAR CAMPOS NUEVOS MBCORE\PASO 30 ACTUALIZAR CAMPOS NUEVOS MBCORE PARTE 02"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{0CDBEEB7-464B-42E9-8B97-E45BFBA768ED}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="PASO 30 ACTUALIZAR CAMPOS NUEVOS MBCORE PARTE 02"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="/*==========================================================================================&#xA;  PASO 30 (07 al 13) - BODEGAS REZAGOS / COMPENSACIONES E INDEMNIZACION EN TMP.MBCORE_GUIAS&#xA;  ------------------------------------------------------------------------------------------&#xA;  Version optimizada de Script_03_CROSS_APPLY.sql (mismo resultado, enfoque por conjuntos).&#xA;&#xA;  Problema detectado en el plan de ejecucion:&#xA;  - Todas las tablas fuente son HEAP (Table Scan, sin indices).&#xA;  - Los CROSS APPLY correlacionados se ejecutan como Nested Loops por cada guia (~437 mil):&#xA;      * Pasos 07 / 08: Table Scan de MBCORE_DOCUMENTOS (292.680 filas) y PAR.DIVISIONES&#xA;        (25.096 filas) 436.920 veces cada uno  =&gt; ~280 mil millones de filas leidas.&#xA;      * Pasos 11 / 12 / 13: Table Scan de MBCORE_SEGUIMIENTO_ENVIO (3,8 M) y LOG.PQR (1,6 M)&#xA;        por guia; el optimizador estima solo ~10 ejecuciones (estadisticas desactualizadas).&#xA;&#xA;  Solucion:&#xA;  - Cada tabla grande se lee UNA sola vez, filtrada por las guias a procesar, hacia tablas&#xA;    temporales pequenas e indexadas; se agrega con GROUP BY y se hace un UPDATE final.&#xA;  - Reglas de negocio identicas a Script_03_CROSS_APPLY.sql.&#xA;==========================================================================================*/&#xA;SET NOCOUNT ON;&#xA;&#xA;IF OBJECT_ID('tempdb..#GUIAS')   IS NOT NULL DROP TABLE #GUIAS;&#xA;IF OBJECT_ID('tempdb..#DIV')     IS NOT NULL DROP TABLE #DIV;&#xA;IF OBJECT_ID('tempdb..#MOV')     IS NOT NULL DROP TABLE #MOV;&#xA;IF OBJECT_ID('tempdb..#DEST')    IS NOT NULL DROP TABLE #DEST;&#xA;IF OBJECT_ID('tempdb..#R_BR')    IS NOT NULL DROP TABLE #R_BR;&#xA;IF OBJECT_ID('tempdb..#R_DEST')  IS NOT NULL DROP TABLE #R_DEST;&#xA;IF OBJECT_ID('tempdb..#R_PQR')   IS NOT NULL DROP TABLE #R_PQR;&#xA;&#xA;----------------------------------------------------------------------------------------------&#xA;-- 1. GUIAS A PROCESAR (llave unica para filtrar las tablas grandes)&#xA;----------------------------------------------------------------------------------------------&#xA;SELECT DISTINCT TMP.G_NUMERO_GUIA AS NUMERO_GUIA&#xA;INTO #GUIAS&#xA;FROM TMP.MBCORE_GUIAS TMP WITH (NOLOCK)&#xA;WHERE TMP.G_NUMERO_GUIA IS NOT NULL;&#xA;&#xA;CREATE UNIQUE CLUSTERED INDEX IX_GUIAS ON #GUIAS (NUMERO_GUIA);&#xA;&#xA;----------------------------------------------------------------------------------------------&#xA;-- 2. DIVISIONES DE INTERES (un solo scan de PAR.DIVISIONES; se evalua el LIKE una vez)&#xA;----------------------------------------------------------------------------------------------&#xA;SELECT&#xA;&#x9; DIV.ID_DIVISION&#xA;&#x9;,DIV.ID_CIUDAD&#xA;&#x9;,DIV.NOMBRE_DIVISION&#xA;&#x9;,CASE WHEN DIV.NOMBRE_DIVISION LIKE '%REZAGO%'       THEN 1 ELSE 0 END AS ES_REZAGO&#xA;&#x9;,CASE WHEN DIV.NOMBRE_DIVISION LIKE '%REZAGO%NACIO%' THEN 1 ELSE 0 END AS ES_REZAGO_NAC&#xA;&#x9;,CASE WHEN DIV.NOMBRE_DIVISION LIKE '%COMPENSACION%' THEN 1 ELSE 0 END AS ES_COMPENSACION&#xA;INTO #DIV&#xA;FROM PAR.DIVISIONES DIV WITH (NOLOCK)&#xA;WHERE DIV.NOMBRE_DIVISION LIKE '%REZAGO%'&#xA;   OR DIV.NOMBRE_DIVISION LIKE '%COMPENSACION%';&#xA;&#xA;CREATE CLUSTERED INDEX IX_DIV ON #DIV (ID_DIVISION, ID_CIUDAD);&#xA;&#xA;----------------------------------------------------------------------------------------------&#xA;-- 3. MOVIMIENTOS PROCESO 8 DE LAS GUIAS (un solo scan de SEGUIMIENTO y DOCUMENTOS)&#xA;----------------------------------------------------------------------------------------------&#xA;SELECT&#xA;&#x9; SEG.NUMERO_GUIA&#xA;&#x9;,SEG.FECHA_HORA_MOVIMIENTO&#xA;&#x9;,SEG.NUMERO_PIEZAS&#xA;&#x9;,DOC.ID_DIVISION_DESTINO&#xA;&#x9;,DOC.ID_CIUDAD_DESTINO&#xA;&#x9;,ISNULL(DOC.ID_DIVISION_DESTINO, DOC.ID_DIVISION_ORIGEN)        AS ID_DIVISION_DEST_ORIG&#xA;&#x9;,ISNULL(DOC.ID_CIUDAD_DESTINO, DOC.ID_CIUDAD_DIVISION_ORIGEN)   AS ID_CIUDAD_DEST_ORIG&#xA;INTO #MOV&#xA;FROM SIG_COLOMBIA_DW.TMP.MBCORE_SEGUIMIENTO_ENVIO SEG WITH (NOLOCK)&#xA;INNER JOIN SIG_COLOMBIA_DW.TMP.MBCORE_DOCUMENTOS DOC WITH (NOLOCK)&#xA;&#x9;ON  DOC.ID_PROCESO      = SEG.ID_PROCESO&#xA;&#x9;AND DOC.NUMERO_MOVIMI   = SEG.NUMERO_MOVIMI&#xA;&#x9;AND DOC.CONSECUT_MOVIMI = SEG.CONSECUT_MOVIMI&#xA;WHERE SEG.ID_PROCESO = 8&#xA;  AND DOC.ID_PROCESO = 8&#xA;  AND EXISTS (SELECT 1 FROM #GUIAS G WHERE G.NUMERO_GUIA = SEG.NUMERO_GUIA);&#xA;&#xA;----------------------------------------------------------------------------------------------&#xA;-- 4. PASO 30 07 FECHA_BOD_Rezagos (division destino, o la de origen si destino es NULL)&#xA;----------------------------------------------------------------------------------------------&#xA;SELECT&#xA;&#x9; M.NUMERO_GUIA&#xA;&#x9;,MAX(M.FECHA_HORA_MOVIMIENTO) AS FECHA&#xA;INTO #R_BR&#xA;FROM #MOV M&#xA;INNER JOIN #DIV D&#xA;&#x9;ON  D.ID_DIVISION = M.ID_DIVISION_DEST_ORIG&#xA;&#x9;AND D.ID_CIUDAD   = M.ID_CIUDAD_DEST_ORIG&#xA;WHERE D.ES_REZAGO = 1&#xA;GROUP BY M.NUMERO_GUIA;&#xA;&#xA;CREATE UNIQUE CLUSTERED INDEX IX_R_BR ON #R_BR (NUMERO_GUIA);&#xA;&#xA;----------------------------------------------------------------------------------------------&#xA;-- 5. PASOS 30 08 a 30 12 (division destino): compensaciones y rezagos nacional&#xA;----------------------------------------------------------------------------------------------&#xA;SELECT&#xA;&#x9; M.NUMERO_GUIA&#xA;&#x9;,M.ID_DIVISION_DESTINO&#xA;&#x9;,D.NOMBRE_DIVISION&#xA;&#x9;,M.FECHA_HORA_MOVIMIENTO&#xA;&#x9;,M.NUMERO_PIEZAS&#xA;&#x9;,D.ES_REZAGO_NAC&#xA;&#x9;,D.ES_COMPENSACION&#xA;INTO #DEST&#xA;FROM #MOV M&#xA;INNER JOIN #DIV D&#xA;&#x9;ON  D.ID_DIVISION = M.ID_DIVISION_DESTINO&#xA;&#x9;AND D.ID_CIUDAD   = M.ID_CIUDAD_DESTINO&#xA;WHERE D.ES_REZAGO_NAC = 1&#xA;   OR D.ES_COMPENSACION = 1;&#xA;&#xA;CREATE CLUSTERED INDEX IX_DEST ON #DEST (NUMERO_GUIA);&#xA;&#xA;;WITH&#xA;-- Existencia y fecha mas reciente (paso 08)&#xA;A AS (&#xA;&#x9;SELECT&#xA;&#x9;&#x9; NUMERO_GUIA&#xA;&#x9;&#x9;,COUNT(CASE WHEN ES_COMPENSACION = 1 THEN 1 END)                   AS EXISTE_COMP&#xA;&#x9;&#x9;,MAX(CASE WHEN ES_COMPENSACION = 1 THEN FECHA_HORA_MOVIMIENTO END)  AS FECHA_COMP&#xA;&#x9;&#x9;,COUNT(CASE WHEN ES_REZAGO_NAC = 1 THEN 1 END)                     AS EXISTE_REZ_NAC&#xA;&#x9;FROM #DEST&#xA;&#x9;GROUP BY NUMERO_GUIA&#xA;),&#xA;-- Numero de veces: distintos (division, nombre, fecha)  (pasos 09 y 10)&#xA;V AS (&#xA;&#x9;SELECT&#xA;&#x9;&#x9; NUMERO_GUIA&#xA;&#x9;&#x9;,COUNT(CASE WHEN ES_COMPENSACION = 1 THEN 1 END) AS VECES_COMP&#xA;&#x9;&#x9;,COUNT(CASE WHEN ES_REZAGO_NAC = 1 THEN 1 END)   AS VECES_REZ_NAC&#xA;&#x9;FROM (&#xA;&#x9;&#x9;SELECT DISTINCT NUMERO_GUIA, ID_DIVISION_DESTINO, NOMBRE_DIVISION, FECHA_HORA_MOVIMIENTO, ES_COMPENSACION, ES_REZAGO_NAC&#xA;&#x9;&#x9;FROM #DEST&#xA;&#x9;) X&#xA;&#x9;GROUP BY NUMERO_GUIA&#xA;),&#xA;-- Numero de piezas: distintos (division, nombre, fecha, piezas)  (pasos 11 y 12)&#xA;P AS (&#xA;&#x9;SELECT&#xA;&#x9;&#x9; NUMERO_GUIA&#xA;&#x9;&#x9;,SUM(CASE WHEN ES_COMPENSACION = 1 THEN NUMERO_PIEZAS END) AS PIEZAS_COMP&#xA;&#x9;&#x9;,SUM(CASE WHEN ES_REZAGO_NAC = 1 THEN NUMERO_PIEZAS END)   AS PIEZAS_REZ_NAC&#xA;&#x9;FROM (&#xA;&#x9;&#x9;SELECT DISTINCT NUMERO_GUIA, ID_DIVISION_DESTINO, NOMBRE_DIVISION, FECHA_HORA_MOVIMIENTO, NUMERO_PIEZAS, ES_COMPENSACION, ES_REZAGO_NAC&#xA;&#x9;&#x9;FROM #DEST&#xA;&#x9;) X&#xA;&#x9;GROUP BY NUMERO_GUIA&#xA;)&#xA;SELECT&#xA;&#x9; A.NUMERO_GUIA&#xA;&#x9;,A.EXISTE_COMP&#xA;&#x9;,A.FECHA_COMP&#xA;&#x9;,A.EXISTE_REZ_NAC&#xA;&#x9;,V.VECES_COMP&#xA;&#x9;,V.VECES_REZ_NAC&#xA;&#x9;,P.PIEZAS_COMP&#xA;&#x9;,P.PIEZAS_REZ_NAC&#xA;INTO #R_DEST&#xA;FROM A&#xA;INNER JOIN V ON V.NUMERO_GUIA = A.NUMERO_GUIA&#xA;INNER JOIN P ON P.NUMERO_GUIA = A.NUMERO_GUIA;&#xA;&#xA;CREATE UNIQUE CLUSTERED INDEX IX_R_DEST ON #R_DEST (NUMERO_GUIA);&#xA;&#xA;----------------------------------------------------------------------------------------------&#xA;-- 6. PASO 30 13 ESTADO INDEMNIZACION (PQR mas reciente por guia, un solo scan de LOG.PQR)&#xA;----------------------------------------------------------------------------------------------&#xA;SELECT&#xA;&#x9; X.NUMERO_GUIA&#xA;&#x9;,X.ID_ESTADO_INDEMNIZACION_PQR&#xA;&#x9;,X.NOMBRE_ESTADO_INDEMNIZACION_PQR&#xA;INTO #R_PQR&#xA;FROM (&#xA;&#x9;SELECT&#xA;&#x9;&#x9; PQR.NUMERO_GUIA&#xA;&#x9;&#x9;,IDPQR.ID_ESTADO_INDEMNIZACION_PQR&#xA;&#x9;&#x9;,ESPQR.NOMBRE_ESTADO_INDEMNIZACION_PQR&#xA;&#x9;&#x9;,ROW_NUMBER() OVER (PARTITION BY PQR.NUMERO_GUIA ORDER BY PQR.ID_PQR DESC) AS RN&#xA;&#x9;FROM SIG_COLOMBIA_DW.LOG.[PQR] PQR WITH (NOLOCK)&#xA;&#x9;LEFT JOIN SIG_COLOMBIA_DW.LOG.[INDEMNIZACIONES_PQR] IDPQR WITH (NOLOCK)&#xA;&#x9;&#x9;ON IDPQR.ID_PQR = PQR.ID_PQR&#xA;&#x9;LEFT JOIN [PAR].[ESTADOS_INDEMNIZACION_PQR] ESPQR WITH (NOLOCK)&#xA;&#x9;&#x9;ON ESPQR.ID_ESTADO_INDEMNIZACION_PQR = IDPQR.ID_ESTADO_INDEMNIZACION_PQR&#xA;&#x9;WHERE EXISTS (SELECT 1 FROM #GUIAS G WHERE G.NUMERO_GUIA = PQR.NUMERO_GUIA)&#xA;) X&#xA;WHERE X.RN = 1;&#xA;&#xA;CREATE UNIQUE CLUSTERED INDEX IX_R_PQR ON #R_PQR (NUMERO_GUIA);&#xA;&#xA;----------------------------------------------------------------------------------------------&#xA;-- 7. UPDATE UNICO (solo guias con al menos una coincidencia)&#xA;----------------------------------------------------------------------------------------------&#xA;UPDATE TMP&#xA;SET&#xA;&#x9;----PASO 30 07&#xA;&#x9; FECHA_BOD_Rezagos           = CASE WHEN BR.NUMERO_GUIA IS NOT NULL THEN ISNULL(BR.FECHA, '1900-01-01')      ELSE TMP.FECHA_BOD_Rezagos           END&#xA;&#x9;----PASO 30 08&#xA;&#x9;,FECHA_BOD_Compensaciones    = CASE WHEN DS.EXISTE_COMP    &gt; 0 THEN ISNULL(DS.FECHA_COMP, '1900-01-01')      ELSE TMP.FECHA_BOD_Compensaciones    END&#xA;&#x9;----PASO 30 09&#xA;&#x9;,Numero_veces_compensaicones = CASE WHEN DS.VECES_COMP     &gt; 0 THEN DS.VECES_COMP                            ELSE TMP.Numero_veces_compensaicones END&#xA;&#x9;----PASO 30 10&#xA;&#x9;,Numero_veces_rezagos        = CASE WHEN DS.VECES_REZ_NAC  &gt; 0 THEN DS.VECES_REZ_NAC                         ELSE TMP.Numero_veces_rezagos        END&#xA;&#x9;----PASO 30 11&#xA;&#x9;,Numero_piezas_rezagos       = CASE WHEN DS.EXISTE_REZ_NAC &gt; 0 THEN ISNULL(DS.PIEZAS_REZ_NAC, 0)             ELSE TMP.Numero_piezas_rezagos       END&#xA;&#x9;----PASO 30 12&#xA;&#x9;,Numero_piezas_compensacion  = CASE WHEN DS.EXISTE_COMP    &gt; 0 THEN ISNULL(DS.PIEZAS_COMP, 0)                ELSE TMP.Numero_piezas_compensacion  END&#xA;&#x9;----PASO 30 13&#xA;&#x9;,ID_ESTADO_INDEMNIZACION     = CASE WHEN PQ.NUMERO_GUIA IS NOT NULL THEN ISNULL(CONVERT(INT, PQ.ID_ESTADO_INDEMNIZACION_PQR), -888) ELSE TMP.ID_ESTADO_INDEMNIZACION END&#xA;&#x9;,ESTADO_INDEMNIZACION        = CASE WHEN PQ.NUMERO_GUIA IS NOT NULL THEN ISNULL(PQ.NOMBRE_ESTADO_INDEMNIZACION_PQR, 'NO DISPONIBLE') ELSE TMP.ESTADO_INDEMNIZACION END&#xA;FROM&#xA;&#x9;TMP.MBCORE_GUIAS TMP&#xA;&#x9;LEFT JOIN #R_BR   BR ON BR.NUMERO_GUIA = TMP.G_NUMERO_GUIA&#xA;&#x9;LEFT JOIN #R_DEST DS ON DS.NUMERO_GUIA = TMP.G_NUMERO_GUIA&#xA;&#x9;LEFT JOIN #R_PQR  PQ ON PQ.NUMERO_GUIA = TMP.G_NUMERO_GUIA&#xA;WHERE&#xA;&#x9;   BR.NUMERO_GUIA IS NOT NULL&#xA;&#x9;OR DS.NUMERO_GUIA IS NOT NULL&#xA;&#x9;OR PQ.NUMERO_GUIA IS NOT NULL;&#xA;&#xA;DROP TABLE #GUIAS, #DIV, #MOV, #DEST, #R_BR, #R_DEST, #R_PQR;&#xA;GO&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
      </DTS:Executables>
      <DTS:PrecedenceConstraints>
