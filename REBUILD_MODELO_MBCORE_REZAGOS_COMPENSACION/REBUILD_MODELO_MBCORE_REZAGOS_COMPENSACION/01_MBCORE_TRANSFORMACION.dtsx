                          name="SqlCommand"
                          UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT  SE.*	 
FROM
	Mece_Logistico.[DBO].[SEGUIMIENTO_ENVIO] SE WITH(NOLOCK) 
	INNER JOIN [dbo].[BI_MBCORE_GUIAS_BASE] TMP WITH(NOLOCK)
	ON
	SE.NUMERO_GUIA = TMP.NUMERO_GUIA
OPTION(RECOMPILE)</property>
