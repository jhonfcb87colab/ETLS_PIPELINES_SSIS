        <DTS:Executable
          DTS:refId="Package\CARGA INICIAL OPERADO DE EXTRACCION Y GENERADOR DE FECHAS\PASO 02 QUITAR DUPLICADOS"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{17918df0-49c0-48ef-9b15-a79f317de330}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="PASO 02 QUITAR DUPLICADOS"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="1">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="&#xA;;WITH CTE&#xA;(&#xA;   ID&#xA;   ,[NUMERO_GUIA]&#xA;      ,[NUMERO_PIEZAS]&#xA;      ,[ID_TIEMPO]&#xA;      ,[ID_PRODUCTO]&#xA;      ,[ID_CLIENTE]&#xA;      ,[ID_ESTADOENVIO]&#xA;      ,[ID_CIUDAD_ORIGEN]&#xA;      ,[ID_CIUDAD_DESTINO]&#xA;      ,[FECHA_ENVIO]&#xA;      ,[DIRECCION_DESTINA_GUIA]&#xA;      ,[ID_PAIS_UBICACION]&#xA;      ,[ID_CIUDAD_UBICACION]&#xA;      ,[ID_DIVISION_UBICACION]&#xA;   ,[VALOR_DECLARADO_GUIA]&#xA;   ,[CR_ID_APLICA_COMPENSACIONES]&#xA;   ,[G_NOMBRE_REMITENTE]&#xA;   ,[G_TELEFONO_REMITE_GUIA]&#xA;,[G_ID_REMITE]&#xA;)&#xA;AS&#xA; (&#xA;  SELECT &#xA;    ROW_NUMBER() OVER(PARTITION BY NUMERO_GUIA ORDER BY FECHA_EXTRACCION_DW DESC ) ID&#xA;   ,[NUMERO_GUIA]&#xA;   ,[NUMERO_PIEZAS]&#xA;   ,[ID_TIEMPO]&#xA;   ,[ID_PRODUCTO]&#xA;   ,[ID_CLIENTE]&#xA;   ,[ID_ESTADOENVIO]&#xA;   ,[ID_CIUDAD_ORIGEN]&#xA;   ,[ID_CIUDAD_DESTINO]&#xA;   ,[FECHA_ENVIO]&#xA;   ,[DIRECCION_DESTINA_GUIA]&#xA;   ,[ID_PAIS_UBICACION]&#xA;   ,[ID_CIUDAD_UBICACION]&#xA;   ,[ID_DIVISION_UBICACION]&#xA;   ,[VALOR_DECLARADO_GUIA]&#xA;   ,[CR_ID_APLICA_COMPENSACIONES]&#xA;   ,[G_NOMBRE_REMITENTE]&#xA;   ,[G_TELEFONO_REMITE_GUIA]&#xA;,[G_ID_REMITE]&#xA;  FROM &#xA;   [TMP].[MBCORE_GUIAS_01] G WITH(NOLOCK)&#xA; )&#xA;INSERT INTO &#xA; TMP.MBCORE_GUIAS_02 &#xA;(&#xA;  [NUMERO_GUIA]&#xA; ,[NUMERO_PIEZAS]&#xA; ,[ID_TIEMPO]&#xA; ,[ID_PRODUCTO]&#xA; ,[ID_CLIENTE]&#xA; ,[ID_ESTADOENVIO]&#xA; ,[ID_CIUDAD_ORIGEN]&#xA; ,[ID_CIUDAD_DESTINO]&#xA; ,[FECHA_ENVIO]&#xA; ,[DIRECCION_DESTINA_GUIA]&#xA; ,[ID_PAIS_UBICACION]&#xA; ,[ID_CIUDAD_UBICACION]&#xA; ,[ID_DIVISION_UBICACION]&#xA; ,[VALOR_DECLARADO_GUIA]&#xA;,[CR_ID_APLICA_COMPENSACIONES]&#xA;   ,[G_NOMBRE_REMITENTE]&#xA;   ,[G_TELEFONO_REMITE_GUIA]&#xA;,[G_ID_REMITE]&#xA;)&#xA;SELECT&#xA;  [NUMERO_GUIA]&#xA; ,[NUMERO_PIEZAS]&#xA; ,[ID_TIEMPO]&#xA; ,[ID_PRODUCTO]&#xA; ,[ID_CLIENTE]&#xA; ,[ID_ESTADOENVIO]&#xA; ,[ID_CIUDAD_ORIGEN]&#xA; ,[ID_CIUDAD_DESTINO]&#xA; ,[FECHA_ENVIO]&#xA; ,[DIRECCION_DESTINA_GUIA]&#xA; ,[ID_PAIS_UBICACION]&#xA; ,[ID_CIUDAD_UBICACION]&#xA; ,[ID_DIVISION_UBICACION]&#xA; ,[VALOR_DECLARADO_GUIA]&#xA;,[CR_ID_APLICA_COMPENSACIONES]&#xA;   ,[G_NOMBRE_REMITENTE]&#xA;   ,[G_TELEFONO_REMITE_GUIA]&#xA;,[G_ID_REMITE]&#xA;FROM&#xA; CTE&#xA;WHERE &#xA; ID = 1&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\CARGA INICIAL OPERADO DE EXTRACCION Y GENERADOR DE FECHAS\PASO 03 ARMAR BASE"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{8096a5d8-9142-44dc-a2c2-f526579cf3a7}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="PASO 03 ARMAR BASE"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="1">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="INSERT INTO &#xA; [TMP].[MBCORE_GUIAS]&#xA;(&#xA;  [G_ID_FECHA]&#xA; ,[G_FECHA]&#xA; ,[G_NUMERO_GUIA]&#xA; ,[G_NUMERO_PIEZAS]&#xA; ,[G_ID_TIEMPO_ENTREGA]&#xA; ,[G_ID_PRODUCTO]&#xA; ,[G_DIRE_DESTINO]&#xA;    ,[G_ID_CIUDAD_ORIGEN]&#xA; ,[G_ID_CIUDAD_DESTINO]&#xA; ,[G_ID_CLIENTE]&#xA; ,[G_ID_ESTADO_ENVIO]&#xA; ,[G_ID_PAIS_UBICACION]&#xA;    ,[G_ID_CIUDAD_UBICACION]&#xA;    ,[G_ID_DIVISION_UBICACION]&#xA; ,[G_VALOR_DECLARADO]&#xA; ,[G_ID_BODEGA_ULTM_MOVI]&#xA; ,CR_ID_APLICA_COMPENSACIONES&#xA;   ,[G_NOMBRE_REMITENTE]&#xA;   ,[G_TELEFONO_REMITE_GUIA]&#xA;,[G_ID_REMITE]&#xA;)&#xA;&#xA;SELECT &#xA;    ISNULL([FECHA_ENVIO],'1900-01-01')AS [FECHA_ENVIO]&#xA;   ,ISNULL(CONVERT(VARCHAR, FECHA_ENVIO,21),'NO DISPONIBLE') AS [FECHA]&#xA;   ,[NUMERO_GUIA]&#xA;      ,ISNULL(CASE WHEN [NUMERO_PIEZAS]=0 THEN NULL ELSE [NUMERO_PIEZAS] END,1) AS [NUMERO_PIEZAS]&#xA;      ,ISNULL(CASE WHEN [ID_TIEMPO]=0 THEN NULL ELSE [ID_TIEMPO] END,-888) AS [ID_TIEMPO]&#xA;      ,ISNULL(CASE WHEN [ID_PRODUCTO]=0 THEN NULL ELSE [ID_PRODUCTO] END,-888) AS [ID_PRODUCTO]&#xA;   ,ISNULL(CASE WHEN [DIRECCION_DESTINA_GUIA]='' THEN NULL ELSE [DIRECCION_DESTINA_GUIA] END, 'NO DISPONIBLE') AS [DIRECCION_DESTINA_GUIA]&#xA;      ,ISNULL(CASE WHEN [ID_CIUDAD_ORIGEN]=0 THEN NULL ELSE [ID_CIUDAD_ORIGEN] END, -888) AS [ID_CIUDAD_ORIGEN]&#xA;      ,ISNULL(CASE WHEN [ID_CIUDAD_DESTINO]=0 THEN NULL ELSE [ID_CIUDAD_DESTINO] END, -888) AS [ID_CIUDAD_DESTINO]&#xA;   ,ISNULL(CASE WHEN [ID_CLIENTE]='' THEN NULL ELSE [ID_CLIENTE] END, '-888') AS [ID_CLIENTE]&#xA;      ,ISNULL(CASE WHEN [ID_ESTADOENVIO]=0 THEN NULL ELSE [ID_ESTADOENVIO] END, -888) AS [ID_ESTADOENVIO]&#xA;      ,ISNULL(CASE WHEN [ID_PAIS_UBICACION]=0 THEN NULL ELSE [ID_PAIS_UBICACION] END, -888) AS [ID_PAIS_UBICACION]&#xA;      ,ISNULL(CASE WHEN [ID_CIUDAD_UBICACION]=0 THEN NULL ELSE [ID_CIUDAD_UBICACION] END, -888) AS [ID_CIUDAD_UBICACION]&#xA;      ,ISNULL(CASE WHEN [ID_DIVISION_UBICACION]=0 THEN NULL ELSE [ID_DIVISION_UBICACION] END, -888) AS [ID_DIVISION_UBICACION]&#xA;   ,ISNULL([VALOR_DECLARADO_GUIA],0) AS [VALOR_DECLARADO_GUIA]&#xA;   ,CONVERT(VARCHAR,ISNULL([ID_PAIS_UBICACION],'-888')) + '-' + CONVERT(VARCHAR,ISNULL([ID_CIUDAD_UBICACION],'-888')) + '-' + CONVERT(VARCHAR,ISNULL([ID_DIVISION_UBICACION],'-888')) AS P_ID_BODEGA&#xA; ,CR_ID_APLICA_COMPENSACIONES&#xA;   ,[G_NOMBRE_REMITENTE]&#xA;   ,[G_TELEFONO_REMITE_GUIA]&#xA;,[G_ID_REMITE]&#xA;  FROM [TMP].[MBCORE_GUIAS_02] WITH (NOLOCK)&#xA;GO&#xA;&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
