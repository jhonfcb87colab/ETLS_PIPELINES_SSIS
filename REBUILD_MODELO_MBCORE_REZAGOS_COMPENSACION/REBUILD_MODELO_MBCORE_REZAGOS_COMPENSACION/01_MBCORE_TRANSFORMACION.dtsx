            <DTS:Executable
              DTS:refId="Package\CARGA INICIAL OPERADO DE EXTRACCION Y GENERADOR DE FECHAS\OBTENER TABLA GUIAS MECE LOGISTICO\PREPARACION TABLA GUIAS"
              DTS:CreationName="Microsoft.ExecuteSQLTask"
              DTS:Description="Execute SQL Task"
              DTS:DTSID="{66C3702B-CB8E-4FD5-A966-E6662D1E81AD}"
              DTS:ExecutableType="Microsoft.ExecuteSQLTask"
              DTS:LocaleID="-1"
              DTS:ObjectName="PREPARACION TABLA GUIAS"
              DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
              DTS:ThreadHint="0">
              <DTS:Variables />
              <DTS:ObjectData>
                <SQLTask:SqlTaskData
                  SQLTask:Connection="{DA00E6FB-D0CA-48C7-A7AA-D8AF33BD5BBA}"
                  SQLTask:SqlStatementSource="DROP TABLE IF EXISTS #MBCORE_MECE_LOGISTICO_GUIAS&#xA;SELECT&#xA;ROW_NUMBER() OVER (ORDER BY FECHA_HORA_MOVIMIENTO) AS CONSECUTIVO&#xA;,NUMERO_GUIA&#xA;INTO #MBCORE_MECE_LOGISTICO_GUIAS&#xA;FROM [dbo].[BI_MBCORE_GUIAS_BASE] WITH(NOLOCK)&#xA;&#xA;&#xA;&#xA;&#xA;CREATE NONCLUSTERED INDEX [IX_NUMERO_GUIA_MBCORE02] ON #MBCORE_MECE_LOGISTICO_GUIAS([NUMERO_GUIA] ASC)&#xA;WITH (PAD_INDEX = OFF, STATISTICS_NORECOMPUTE = OFF, SORT_IN_TEMPDB = OFF, &#xA;DROP_EXISTING = OFF, ONLINE = OFF, ALLOW_ROW_LOCKS = ON, ALLOW_PAGE_LOCKS = ON, FILLFACTOR = 80) &#xA;&#xA;/* CREACION DE TABLA&#xA;SELECT TOP 0&#xA;GUI.* &#xA;INTO TMP_BORRAR_LOCAL.DBO.BI_MBCORE_MECE_LOGISTICO_GUIAS&#xA;FROM #MBCORE_MECE_LOGISTICO_GUIAS TMP&#xA;INNER JOIN Mece_Logistico.DBO.GUIAS GUI WITH(NOLOCK)&#xA;ON GUI.NUMERO_GUIA=TMP.NUMERO_GUIA&#xA;*/&#xA;&#xA;&#xA;TRUNCATE TABLE TMP_BORRAR_LOCAL.DBO.BI_MBCORE_MECE_LOGISTICO_GUIAS&#xA;&#xA;-- 3. Bucle de inserción por Lotes basado en ID numérico (Evita borrar/volver a hacer JOINs)&#xA;DECLARE @LOTE INT = 1000; -- Incrementado a 50k para mejor rendimiento E/S&#xA;DECLARE @MIN_ID INT = 1;&#xA;DECLARE @MAX_ID_LOTE INT;&#xA;DECLARE @MAX_ID_TOTAL INT = (SELECT ISNULL(MAX(CONSECUTIVO), 0) FROM #MBCORE_MECE_LOGISTICO_GUIAS);&#xA;&#xA;WHILE @MIN_ID &lt;= @MAX_ID_TOTAL&#xA;BEGIN&#xA;    SET @MAX_ID_LOTE = @MIN_ID + @LOTE - 1;&#xA;&#xA;&#x9;&#x9;INSERT INTO TMP_BORRAR_LOCAL.DBO.BI_MBCORE_MECE_LOGISTICO_GUIAS&#xA;&#x9;&#x9;&#x9;SELECT &#xA;&#x9;&#x9;&#x9;GUI.* &#xA;&#x9;&#x9;&#x9;FROM #MBCORE_MECE_LOGISTICO_GUIAS TMP&#xA;&#x9;&#x9;&#x9;INNER JOIN Mece_Logistico.DBO.GUIAS GUI WITH(NOLOCK)&#xA;&#x9;&#x9;&#x9;ON TMP.NUMERO_GUIA=GUI.NUMERO_GUIA&#xA;&#x9;&#x9;&#x9;WHERE TMP.CONSECUTIVO BETWEEN @MIN_ID AND @MAX_ID_LOTE&#xA;&#x9;&#x9;&#x9;----WHERE PS01.ID BETWEEN 1 AND 1000&#xA;&#x9;&#x9;&#x9;OPTION(RECOMPILE);&#xA;&#x9;PRINT(CONCAT('INSERTCION REALIZADA DESDE - ',@MIN_ID,' / HASTA - ',@MAX_ID_LOTE))&#xA;    SET @MIN_ID = @MAX_ID_LOTE + 1;&#xA;END;&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
              </DTS:ObjectData>
            </DTS:Executable>
          </DTS:Executables>
