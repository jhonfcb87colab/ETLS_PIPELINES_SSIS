      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot;&#xA;TRUNCATE TABLE TMP.MBCORE_GUIAS_DT &#xA;INSERT INTO TMP.MBCORE_GUIAS_DT &#xA;SELECT &#xA; [YYYYMMDD_DTINI] =   '&quot;+ (DT_WSTR,20) @[User::DT_01_FECHAINICIAL]  +&quot;'&#xA; ,[YYYYMMDD_DTFIN] = '&quot;+ (DT_WSTR,20) @[User::DT_02_FECHAFINAL] +&quot;'&#xA; &quot;"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="DT_00_FECHAS">
      <DTS:VariableValue
        DTS:DataType="8">
TRUNCATE TABLE TMP.MBCORE_GUIAS_DT 
INSERT INTO TMP.MBCORE_GUIAS_DT 
SELECT 
 [YYYYMMDD_DTINI] =   '12:00:00 a.m.'
 ,[YYYYMMDD_DTFIN] = '12:00:00 a.m.'
 </DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{C05BECE3-C962-4241-A8A6-8FF21D9467B7}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="(DT_DATE) @[$Project::FULL_FACH_FIN] == (DT_DATE) &quot;1900-01-01&quot;?&#xA;(DT_DATE)((DT_WSTR,4)YEAR(DATEADD(&quot;DD&quot;, 1 ,GETDATE()))+&quot;-&quot;+RIGHT(&quot;0&quot;+(DT_WSTR,2)MONTH(DATEADD(&quot;DD&quot;,1,GETDATE())),2)+&quot;-&quot;+RIGHT(&quot;0&quot;+(DT_WSTR,2)DAY(DATEADD(&quot;DD&quot;,1,GETDATE())),2))&#xA;: (DT_DATE) @[$Project::FULL_FACH_FIN]"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="FechaFin">
      <DTS:VariableValue
        DTS:DataType="7">10/22/2026</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{6B523EDC-A8F4-4360-941C-F97429F46F0F}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="(DT_DATE)   @[$Project::FULL_FACH_INI]    == (DT_DATE) &quot;1900-01-01&quot;? &#xA;(DT_DATE)((DT_WSTR,4)YEAR(DATEADD(&quot;DD&quot;, -@[$Project::DiaIni], GETDATE()))+&quot;-&quot;&#xA;+RIGHT(&quot;0&quot;+(DT_WSTR,2)MONTH(DATEADD(&quot;DD&quot;,-@[$Project::DiaIni],GETDATE() )),2)+&quot;-&quot;&#xA;+RIGHT(&quot;0&quot;+(DT_WSTR,2)DAY(DATEADD(&quot;DD&quot;, -@[$Project::DiaIni],GETDATE() )),2))&#xA;: (DT_DATE) @[$Project::FULL_FACH_INI]"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="FechaIni">
      <DTS:VariableValue
        DTS:DataType="7">10/18/2026</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{B2C1174B-12B2-4E72-A33C-3D5D1D3960FD}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot;&#xA;DECLARE @DATE_INI DATETIME = CONVERT(DATETIME, CONVERT(DATE,CONVERT(DATETIME,'&quot;+@[User::STR_FechaIni] +&quot;'))); &#xA;DECLARE @DATE_FIN DATETIME = CONVERT(DATETIME, CONVERT(DATE,CONVERT(DATETIME,'&quot;+@[User::STR_FechaFin] +&quot;'))); &#xA;&#xA;&#xA;DROP TABLE IF EXISTS #MBCORE_SEGUIMIENTO_ENVIO_01&#xA;SELECT &#xA;*&#xA;INTO #MBCORE_SEGUIMIENTO_ENVIO_01&#xA;FROM Mece_Logistico.DBO.SEGUIMIENTO_ENVIO SEG WITH (NOLOCK)&#xA;WHERE &#x9;(SEG.FECHA_HORA_MOVIMIENTO&#x9;BETWEEN @DATE_INI AND @DATE_FIN )  &#xA;OPTION(RECOMPILE)&#xA;&#xA;INSERT INTO #MBCORE_SEGUIMIENTO_ENVIO_01&#xA;SELECT *&#xA;FROM Mece_Logistico.DBO.SEGUIMIENTO_ENVIO SEG WITH (NOLOCK)&#xA;WHERE &#x9;SEG.FECHA_MODIFICACION&#x9;&gt; DATEADD(DAY,-1,@DATE_FIN )  &#xA;AND SEG.FECHA_MODIFICACION&#x9;&lt; DATEADD(DAY,0,@DATE_FIN )&#xA;OPTION(RECOMPILE)&#xA;&#xA;;WITH CTE_SE AS (&#xA;SELECT &#xA;ROWID = ROW_NUMBER() OVER(PARTITION BY NUMERO_GUIA ORDER BY FECHA_HORA_MOVIMIENTO DESC)&#xA;,*&#xA;FROM #MBCORE_SEGUIMIENTO_ENVIO_01&#xA;)DELETE CTE_SE WHERE ROWID &gt; 1&#xA;&#xA;DELETE #MBCORE_SEGUIMIENTO_ENVIO_01 WHERE ID_PROCESO &lt; 5&#xA;&#xA;&#xA;--SELECT COUNT(1) FROM #MBCORE_SEGUIMIENTO_ENVIO&#xA;--1.459.458&#xA;--308.586&#xA;&#xA;DROP TABLE IF EXISTS #MBCORE_SEGUIMIENTO_ENVIO&#xA;SELECT&#xA;ROW_NUMBER() OVER (ORDER BY FECHA_HORA_MOVIMIENTO) AS CONSECUTIVO,&#xA;*&#xA;INTO #MBCORE_SEGUIMIENTO_ENVIO&#xA;FROM #MBCORE_SEGUIMIENTO_ENVIO_01&#xA;&#xA;DROP TABLE IF EXISTS #MBCORE_SEGUIMIENTO_ENVIO_01&#xA;&#xA;CREATE NONCLUSTERED INDEX [IX_NUMERO_GUIA_MBCORE01] ON #MBCORE_SEGUIMIENTO_ENVIO([NUMERO_GUIA] ASC)&#xA;WITH (PAD_INDEX = OFF, STATISTICS_NORECOMPUTE = OFF, SORT_IN_TEMPDB = OFF, &#xA;DROP_EXISTING = OFF, ONLINE = OFF, ALLOW_ROW_LOCKS = ON, ALLOW_PAGE_LOCKS = ON, FILLFACTOR = 80) &#xA;&#xA;&#xA;&#xA;DROP TABLE IF EXISTS #MBCORE_GUIAS_01&#xA;SELECT TOP 0&#xA;&#x9; GUI.[NUMERO_GUIA]&#xA;&#x9;,GUI.[NUMERO_PIEZAS]&#xA;&#x9;,GUI.[FECHA_ENVIO]&#xA;&#x9;,GUI.[ID_TIEMPO]&#xA;&#x9;,GUI.[ID_PRODUCTO]&#xA;&#x9;,GUI.[DIRECCION_DESTINA_GUIA]&#xA;&#x9;,GUI.[ID_CLIENTE]&#xA;&#x9;,GUI.[ID_CIUDAD_ORIGEN]&#xA;&#x9;,GUI.[ID_CIUDAD_DESTINO]&#xA;&#x9;,GUI.[ID_PAIS_UBICACION]&#xA;&#x9;,GUI.[ID_CIUDAD_UBICACION]&#xA;&#x9;,GUI.[ID_DIVISION_UBICACION]&#xA;&#x9;,GUI.[VALOR_DECLARADO_GUIA]&#xA;&#x9;,[FECHA_EXTRACCION_DW] = GETDATE()&#xA;&#x9;,[CR_ID_APLICA_COMPENSACIONES] =0&#xA;&#x9;,[G_NOMBRE_REMITENTE]=CONCAT(GUI.NOMBRE_REMITE_GUIA,GUI.APELLIDO_REMITE_GUIA)&#xA;&#x9;,[G_TELEFONO_REMITE_GUIA] = GUI.TELEFONO_REMITE_GUIA&#xA;&#x9;,[G_ID_REMITE]=GUI.[ID_REMITE]&#xA;&#x9;,GUI.ID_ESTADOGUIA&#xA;&#x9;,GUI.ID_ESTADOENVIO&#xA;,SEG.ID_PROCESO&#xA;,SEG.CONSECUT_MOVIMI&#xA;,SEG.NUMERO_MOVIMI&#xA;,SEG.FECHA_HORA_MOVIMIENTO&#xA;&#x9;INTO #MBCORE_GUIAS_01&#xA;FROM Mece_Logistico.DBO.GUIAS GUI WITH(NOLOCK INDEX=[UK_GUIA])&#xA;INNER JOIN  #MBCORE_SEGUIMIENTO_ENVIO SEG WITH(NOLOCK INDEX=[IX_NUMERO_GUIA_MBCORE01])&#xA;ON GUI.NUMERO_GUIA=SEG.NUMERO_GUIA&#xA;OPTION(RECOMPILE)&#xA;&#xA;&#xA;&#xA;&#xA;-- 3. Bucle de inserción por Lotes basado en ID numérico (Evita borrar/volver a hacer JOINs)&#xA;DECLARE @LOTE INT = 1000; -- Incrementado a 50k para mejor rendimiento E/S&#xA;DECLARE @MIN_ID INT = 1;&#xA;DECLARE @MAX_ID_LOTE INT;&#xA;DECLARE @MAX_ID_TOTAL INT = (SELECT ISNULL(MAX(CONSECUTIVO), 0) FROM #MBCORE_SEGUIMIENTO_ENVIO);&#xA;&#xA;WHILE @MIN_ID &lt;= @MAX_ID_TOTAL&#xA;BEGIN&#xA;    SET @MAX_ID_LOTE = @MIN_ID + @LOTE - 1;&#xA;&#xA;&#x9;&#x9;INSERT INTO #MBCORE_GUIAS_01&#xA;&#x9;&#x9;&#x9;SELECT &#xA;&#x9;&#x9;&#x9;&#x9; GUI.[NUMERO_GUIA]&#xA;&#x9;&#x9;&#x9;&#x9;,GUI.[NUMERO_PIEZAS]&#xA;&#x9;&#x9;&#x9;&#x9;,GUI.[FECHA_ENVIO]&#xA;&#x9;&#x9;&#x9;&#x9;,GUI.[ID_TIEMPO]&#xA;&#x9;&#x9;&#x9;&#x9;,GUI.[ID_PRODUCTO]&#xA;&#x9;&#x9;&#x9;&#x9;,GUI.[DIRECCION_DESTINA_GUIA]&#xA;&#x9;&#x9;&#x9;&#x9;,GUI.[ID_CLIENTE]&#xA;&#x9;&#x9;&#x9;&#x9;,GUI.[ID_CIUDAD_ORIGEN]&#xA;&#x9;&#x9;&#x9;&#x9;,GUI.[ID_CIUDAD_DESTINO]&#xA;&#x9;&#x9;&#x9;&#x9;,GUI.[ID_PAIS_UBICACION]&#xA;&#x9;&#x9;&#x9;&#x9;,GUI.[ID_CIUDAD_UBICACION]&#xA;&#x9;&#x9;&#x9;&#x9;,GUI.[ID_DIVISION_UBICACION]&#xA;&#x9;&#x9;&#x9;&#x9;,GUI.[VALOR_DECLARADO_GUIA]&#xA;&#x9;&#x9;&#x9;&#x9;,[FECHA_EXTRACCION_DW] = GETDATE()&#xA;&#x9;&#x9;&#x9;&#x9;,[CR_ID_APLICA_COMPENSACIONES] =0&#xA;&#x9;&#x9;&#x9;&#x9;,[G_NOMBRE_REMITENTE]=CONCAT(GUI.NOMBRE_REMITE_GUIA,GUI.APELLIDO_REMITE_GUIA)&#xA;&#x9;&#x9;&#x9;&#x9;,[G_TELEFONO_REMITE_GUIA] = GUI.TELEFONO_REMITE_GUIA&#xA;&#x9;&#x9;&#x9;&#x9;,[G_ID_REMITE]=GUI.[ID_REMITE]&#xA;&#x9;&#x9;&#x9;&#x9;,GUI.ID_ESTADOGUIA&#xA;&#x9;&#x9;&#x9;&#x9;,GUI.ID_ESTADOENVIO&#xA;&#x9;&#x9;&#x9;,SEG.ID_PROCESO&#xA;&#x9;&#x9;&#x9;,SEG.CONSECUT_MOVIMI&#xA;&#x9;&#x9;&#x9;,SEG.NUMERO_MOVIMI&#xA;&#x9;&#x9;&#x9;,SEG.FECHA_HORA_MOVIMIENTO&#xA;&#x9;&#x9;&#x9;FROM Mece_Logistico.DBO.GUIAS GUI WITH(NOLOCK INDEX=[UK_GUIA])&#xA;&#x9;&#x9;&#x9;INNER JOIN  #MBCORE_SEGUIMIENTO_ENVIO SEG WITH(NOLOCK INDEX=[IX_NUMERO_GUIA_MBCORE01])&#xA;&#x9;&#x9;&#x9;ON GUI.NUMERO_GUIA=SEG.NUMERO_GUIA&#xA;&#x9;&#x9;&#x9;WHERE SEG.CONSECUTIVO BETWEEN @MIN_ID AND @MAX_ID_LOTE&#xA;&#x9;&#x9;&#x9;----WHERE PS01.ID BETWEEN 1 AND 1000&#xA;&#x9;&#x9;&#x9;OPTION(RECOMPILE);&#xA;&#x9;PRINT(CONCAT('INSERTCION REALIZADA DESDE - ',@MIN_ID,' / HASTA - ',@MAX_ID_LOTE))&#xA;    SET @MIN_ID = @MAX_ID_LOTE + 1;&#xA;END;&#xA;&#xA;DELETE  #MBCORE_GUIAS_01 WHERE LEN(NUMERO_GUIA)&lt;8&#xA;DELETE #MBCORE_GUIAS_01 WHERE ID_ESTADOGUIA &lt; 3&#xA;&#xA;TRUNCATE TABLE [tmp_borrar_local].[DBO].[BI_MBCORE_GUIAS_BASE]&#xA;&#xA;INSERT INTO [tmp_borrar_local].[DBO].[BI_MBCORE_GUIAS_BASE]&#xA;SELECT * &#xA;------INTO [tmp_borrar_local].[DBO].[BI_MBCORE_GUIAS_BASE]&#xA;FROM #MBCORE_GUIAS_01&#xA;&#xA;&#xA;--SELECT &#xA;--&#x9;NUMERO_GUIA&#x9;&#xA;--&#x9;,NUMERO_PIEZAS&#x9;&#xA;--&#x9;,FECHA_ENVIO&#x9;&#xA;--&#x9;,ID_TIEMPO&#x9;&#xA;--&#x9;,ID_PRODUCTO&#x9;&#xA;--&#x9;,DIRECCION_DESTINA_GUIA&#x9;&#xA;--&#x9;,ID_CLIENTE&#x9;&#xA;--&#x9;,ID_ESTADOENVIO&#x9;&#xA;--&#x9;,ID_CIUDAD_ORIGEN&#x9;&#xA;--&#x9;,ID_CIUDAD_DESTINO&#x9;&#xA;--&#x9;,ID_PAIS_UBICACION&#x9;&#xA;--&#x9;,ID_CIUDAD_UBICACION&#x9;&#xA;--&#x9;,ID_DIVISION_UBICACION&#x9;&#xA;--&#x9;,VALOR_DECLARADO_GUIA&#x9;&#xA;--&#x9;,FECHA_EXTRACCION_DW&#x9;&#xA;--&#x9;,CR_ID_APLICA_COMPENSACIONES&#xA;--    ,[G_NOMBRE_REMITENTE]&#xA;--    ,[G_TELEFONO_REMITE_GUIA]&#xA;--,[G_ID_REMITE]&#xA;--FROM CTE_GUIAS_NO_MBCORE WHERE ID=1&#xA;&quot;"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="SCRIPT_01_EXTRACCION_PRINCIPAL">
      <DTS:VariableValue
        DTS:DataType="8">
DECLARE @DATE_INI DATETIME = CONVERT(DATETIME, CONVERT(DATE,CONVERT(DATETIME,'20261018'))); 
DECLARE @DATE_FIN DATETIME = CONVERT(DATETIME, CONVERT(DATE,CONVERT(DATETIME,'20261022'))); 


DROP TABLE IF EXISTS #MBCORE_SEGUIMIENTO_ENVIO_01
SELECT 
*
INTO #MBCORE_SEGUIMIENTO_ENVIO_01
FROM Mece_Logistico.DBO.SEGUIMIENTO_ENVIO SEG WITH (NOLOCK)
WHERE 	(SEG.FECHA_HORA_MOVIMIENTO	BETWEEN @DATE_INI AND @DATE_FIN )  
OPTION(RECOMPILE)

INSERT INTO #MBCORE_SEGUIMIENTO_ENVIO_01
SELECT *
FROM Mece_Logistico.DBO.SEGUIMIENTO_ENVIO SEG WITH (NOLOCK)
WHERE 	SEG.FECHA_MODIFICACION	&gt; DATEADD(DAY,-1,@DATE_FIN )  
AND SEG.FECHA_MODIFICACION	&lt; DATEADD(DAY,0,@DATE_FIN )
OPTION(RECOMPILE)

;WITH CTE_SE AS (
SELECT 
ROWID = ROW_NUMBER() OVER(PARTITION BY NUMERO_GUIA ORDER BY FECHA_HORA_MOVIMIENTO DESC)
,*
FROM #MBCORE_SEGUIMIENTO_ENVIO_01
)DELETE CTE_SE WHERE ROWID &gt; 1

DELETE #MBCORE_SEGUIMIENTO_ENVIO_01 WHERE ID_PROCESO &lt; 5


--SELECT COUNT(1) FROM #MBCORE_SEGUIMIENTO_ENVIO
--1.459.458
--308.586

DROP TABLE IF EXISTS #MBCORE_SEGUIMIENTO_ENVIO
SELECT
ROW_NUMBER() OVER (ORDER BY FECHA_HORA_MOVIMIENTO) AS CONSECUTIVO,
*
INTO #MBCORE_SEGUIMIENTO_ENVIO
FROM #MBCORE_SEGUIMIENTO_ENVIO_01

DROP TABLE IF EXISTS #MBCORE_SEGUIMIENTO_ENVIO_01

CREATE NONCLUSTERED INDEX [IX_NUMERO_GUIA_MBCORE01] ON #MBCORE_SEGUIMIENTO_ENVIO([NUMERO_GUIA] ASC)
WITH (PAD_INDEX = OFF, STATISTICS_NORECOMPUTE = OFF, SORT_IN_TEMPDB = OFF, 
DROP_EXISTING = OFF, ONLINE = OFF, ALLOW_ROW_LOCKS = ON, ALLOW_PAGE_LOCKS = ON, FILLFACTOR = 80) 



DROP TABLE IF EXISTS #MBCORE_GUIAS_01
SELECT TOP 0
	 GUI.[NUMERO_GUIA]
	,GUI.[NUMERO_PIEZAS]
	,GUI.[FECHA_ENVIO]
	,GUI.[ID_TIEMPO]
	,GUI.[ID_PRODUCTO]
	,GUI.[DIRECCION_DESTINA_GUIA]
	,GUI.[ID_CLIENTE]
	,GUI.[ID_CIUDAD_ORIGEN]
	,GUI.[ID_CIUDAD_DESTINO]
	,GUI.[ID_PAIS_UBICACION]
	,GUI.[ID_CIUDAD_UBICACION]
	,GUI.[ID_DIVISION_UBICACION]
	,GUI.[VALOR_DECLARADO_GUIA]
	,[FECHA_EXTRACCION_DW] = GETDATE()
	,[CR_ID_APLICA_COMPENSACIONES] =0
	,[G_NOMBRE_REMITENTE]=CONCAT(GUI.NOMBRE_REMITE_GUIA,GUI.APELLIDO_REMITE_GUIA)
	,[G_TELEFONO_REMITE_GUIA] = GUI.TELEFONO_REMITE_GUIA
	,[G_ID_REMITE]=GUI.[ID_REMITE]
	,GUI.ID_ESTADOGUIA
	,GUI.ID_ESTADOENVIO
,SEG.ID_PROCESO
,SEG.CONSECUT_MOVIMI
,SEG.NUMERO_MOVIMI
,SEG.FECHA_HORA_MOVIMIENTO
	INTO #MBCORE_GUIAS_01
FROM Mece_Logistico.DBO.GUIAS GUI WITH(NOLOCK INDEX=[UK_GUIA])
INNER JOIN  #MBCORE_SEGUIMIENTO_ENVIO SEG WITH(NOLOCK INDEX=[IX_NUMERO_GUIA_MBCORE01])
ON GUI.NUMERO_GUIA=SEG.NUMERO_GUIA
OPTION(RECOMPILE)




-- 3. Bucle de inserción por Lotes basado en ID numérico (Evita borrar/volver a hacer JOINs)
DECLARE @LOTE INT = 1000; -- Incrementado a 50k para mejor rendimiento E/S
DECLARE @MIN_ID INT = 1;
DECLARE @MAX_ID_LOTE INT;
DECLARE @MAX_ID_TOTAL INT = (SELECT ISNULL(MAX(CONSECUTIVO), 0) FROM #MBCORE_SEGUIMIENTO_ENVIO);

WHILE @MIN_ID &lt;= @MAX_ID_TOTAL
BEGIN
    SET @MAX_ID_LOTE = @MIN_ID + @LOTE - 1;

		INSERT INTO #MBCORE_GUIAS_01
			SELECT 
				 GUI.[NUMERO_GUIA]
				,GUI.[NUMERO_PIEZAS]
				,GUI.[FECHA_ENVIO]
				,GUI.[ID_TIEMPO]
				,GUI.[ID_PRODUCTO]
				,GUI.[DIRECCION_DESTINA_GUIA]
				,GUI.[ID_CLIENTE]
				,GUI.[ID_CIUDAD_ORIGEN]
				,GUI.[ID_CIUDAD_DESTINO]
				,GUI.[ID_PAIS_UBICACION]
				,GUI.[ID_CIUDAD_UBICACION]
				,GUI.[ID_DIVISION_UBICACION]
				,GUI.[VALOR_DECLARADO_GUIA]
				,[FECHA_EXTRACCION_DW] = GETDATE()
				,[CR_ID_APLICA_COMPENSACIONES] =0
				,[G_NOMBRE_REMITENTE]=CONCAT(GUI.NOMBRE_REMITE_GUIA,GUI.APELLIDO_REMITE_GUIA)
				,[G_TELEFONO_REMITE_GUIA] = GUI.TELEFONO_REMITE_GUIA
				,[G_ID_REMITE]=GUI.[ID_REMITE]
				,GUI.ID_ESTADOGUIA
				,GUI.ID_ESTADOENVIO
			,SEG.ID_PROCESO
			,SEG.CONSECUT_MOVIMI
			,SEG.NUMERO_MOVIMI
			,SEG.FECHA_HORA_MOVIMIENTO
			FROM Mece_Logistico.DBO.GUIAS GUI WITH(NOLOCK INDEX=[UK_GUIA])
			INNER JOIN  #MBCORE_SEGUIMIENTO_ENVIO SEG WITH(NOLOCK INDEX=[IX_NUMERO_GUIA_MBCORE01])
			ON GUI.NUMERO_GUIA=SEG.NUMERO_GUIA
			WHERE SEG.CONSECUTIVO BETWEEN @MIN_ID AND @MAX_ID_LOTE
			----WHERE PS01.ID BETWEEN 1 AND 1000
			OPTION(RECOMPILE);
	PRINT(CONCAT('INSERTCION REALIZADA DESDE - ',@MIN_ID,' / HASTA - ',@MAX_ID_LOTE))
    SET @MIN_ID = @MAX_ID_LOTE + 1;
END;

DELETE  #MBCORE_GUIAS_01 WHERE LEN(NUMERO_GUIA)&lt;8
DELETE #MBCORE_GUIAS_01 WHERE ID_ESTADOGUIA &lt; 3

TRUNCATE TABLE [tmp_borrar_local].[DBO].[BI_MBCORE_GUIAS_BASE]

INSERT INTO [tmp_borrar_local].[DBO].[BI_MBCORE_GUIAS_BASE]
SELECT * 
------INTO [tmp_borrar_local].[DBO].[BI_MBCORE_GUIAS_BASE]
FROM #MBCORE_GUIAS_01


