      <DTS:Variables />
      <DTS:Executables>
        <DTS:Executable
          DTS:refId="Package\PASOS 33 34 35 - PASO 37 CLIENTE PROVISION PASO 38 UBICACION PASO 39 BODEGAS\38 ACTUALIZACION UBICACION BODEGA Y REGIONAL INVENATARIOS FISICOS"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{CBCFF5C3-6A82-4A3A-A554-30FE1D50C8E5}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="38 ACTUALIZACION UBICACION BODEGA Y REGIONAL INVENATARIOS FISICOS"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="--38 ACTUALIZACION UBICACION BODEGA Y REGIONAL INVENATARIOS FISICOS&#xA;UPDATE&#xA; TMP.MBCORE_GUIAS&#xA;SET&#xA; [CR_BODEGA_UBICACION] = ISNULL(DIV.[NOMBRE_DIVISION],'NO DISPONIBLE')&#xA;FROM &#xA; TMP.MBCORE_GUIAS TMP&#xA;INNER JOIN  [PAR].[DIVISIONES] DIV WITH(NOLOCK)&#xA;ON  TMP.G_ID_BODEGA_ULTM_MOVI = CONVERT(VARCHAR,DIV.[ID_PAIS]) + '-' + CONVERT(VARCHAR,DIV.[ID_CIUDAD]) + '-' + CONVERT(VARCHAR,DIV.[ID_DIVISION])&#xA;WHERE [CR_BODEGA_UBICACION] IS NULL&#xA;&#xA;&#xA;;WITH CTE_REGIONAL_UBICACION AS(&#xA;&#x9;&#x9;SELECT&#xA;&#x9;&#x9;&#x9; TMP.G_NUMERO_GUIA &#xA;&#x9;&#x9;&#x9;,GEO.REGIONAL&#xA;&#x9;&#x9;&#x9;,GEO.CIUDAD&#xA;&#x9;&#x9;&#x9;,GEO.DEPARTAMENTO&#xA;&#x9;&#x9;FROM TMP.MBCORE_GUIAS TMP WITH (NOLOCK)&#xA;&#x9;&#x9;INNER JOIN  DIM.GEOGRAFIA GEO WITH (NOLOCK)&#xA;&#x9;&#x9;ON TMP.G_ID_CIUDAD_DESTINO = GEO.ID_CIUDAD&#xA;&#x9;)&#xA;UPDATE TMP SET [CR_REGIONAL_UBICACION] = ISNULL(CTE.REGIONAL,'NO DISPONIBLE')&#xA;FROM TMP.MBCORE_GUIAS TMP WITH (NOLOCK) &#xA;INNER JOIN CTE_REGIONAL_UBICACION CTE ON TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA&#xA;WHERE  [CR_REGIONAL_UBICACION]  IS NULL" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\PASOS 33 34 35 - PASO 37 CLIENTE PROVISION PASO 38 UBICACION PASO 39 BODEGAS\39 03 ACTUALIZACION BODEGA Y REGIONAL UBICACION INVENARIO FISICO"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{EBBD1EC8-CCFD-4DED-95C9-EA912CAFCA06}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="39 03 ACTUALIZACION BODEGA Y REGIONAL UBICACION INVENARIO FISICO"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="---39 03 ACTUALIZACION BODEGA Y REGIONAL UBICACION INVENARIO FISICO&#xA;--TRUNCAR TMP BODEGAS Y REGIONALES COMPENSACIONES&#xA;TRUNCATE TABLE [TMP].[MBCORE_GUIAS_26]&#xA;&#xA;INSERT INTO [TMP].[MBCORE_GUIAS_26]&#xA;SELECT * FROM (&#xA;SELECT ROW_NUMBER ( )   OVER ( PARTITION BY GUI.[NUMERO_GUIA] order by SEG.FECHA_HORA_MOVIMIENTO desc )  id,  &#xA;&#x9;&#x9; DIVISION_DESTINO = DIV.[NOMBRE_DIVISION]&#xA;&#x9;&#x9; ,DIVISION_ORIGEN = DIV2.[NOMBRE_DIVISION]&#xA;&#x9;&#x9;,GUI.[NUMERO_GUIA]&#xA;&#x9;&#x9;,SEG.FECHA_HORA_MOVIMIENTO&#xA;&#x9;&#x9;,GUI.FECHA_MODIFICACION_DG&#xA;&#x9;&#x9;,REGIO.NOMBRE_REGIONAL AS REGIONAL_DESTINO&#xA;&#x9;&#x9;,REGIO2.NOMBRE_REGIONAL AS REGIONAL_ORIGEN&#xA;&#x9;&#x9;,CIUD.NOMBRE_CIUDAD AS CIUDAD_DESTINO&#xA;&#x9;&#x9;,CIUD2.NOMBRE_CIUDAD AS CIUDAD_ORIGEN&#xA;&#x9;&#x9;,SEG.ID_PROCESO&#xA;&#x9;&#x9;,PR.NOMBRE_PROCESO_LOG&#xA;&#x9;FROM TMP.MBCORE_GUIAS MBCORE WITH(NOLOCK) &#xA;&#x9;INNER JOIN SIG_COLOMBIA_DW.TMP.MBCORE_MECE_LOGISTICO_GUIAS  GUI WITH(NOLOCK)&#xA;&#x9;ON GUI.NUMERO_GUIA=MBCORE.G_NUMERO_GUIA&#xA;&#x9;INNER JOIN SIG_COLOMBIA_DW.TMP.MBCORE_SEGUIMIENTO_ENVIO SEG WITH (NOLOCK)&#xA;&#x9;ON GUI.NUMERO_GUIA=SEG.NUMERO_GUIA&#xA;&#x9;INNER JOIN SIG_COLOMBIA_DW.TMP.MBCORE_DOCUMENTOS DOC WITH (NOLOCK) &#xA;&#x9;ON (SEG.ID_PROCESO=DOC.ID_PROCESO &#xA;&#x9;AND SEG.NUMERO_MOVIMI=DOC.NUMERO_MOVIMI &#xA;&#x9;AND SEG.CONSECUT_MOVIMI=DOC.CONSECUT_MOVIMI)&#xA;&#x9;INNER JOIN PAR.DIVISIONES DIV WITH (NOLOCK)&#xA;&#x9;ON (DIV.ID_DIVISION=DOC.ID_DIVISION_DESTINO AND DOC.ID_CIUDAD_DESTINO=DIV.ID_CIUDAD) &#xA;&#x9;INNER JOIN PAR.DIVISIONES DIV2 WITH (NOLOCK)&#xA;&#x9;ON (DIV2.ID_DIVISION=DOC.ID_DIVISION_ORIGEN AND DOC.ID_CIUDAD_DIVISION_ORIGEN=DIV2.ID_CIUDAD)&#xA;&#x9;INNER JOIN PAR.PROCESOS  PR WITH (NOLOCK) ON (SEG.ID_PROCESO=PR.ID_PROCESO)&#xA;&#x9;INNER JOIN PAR.CIUDADES CIUD WITH (NOLOCK) ON (CIUD.ID_CIUDAD=DOC.ID_CIUDAD_DESTINO)&#xA;&#x9;INNER JOIN PAR.REGIONALES_PAIS REGIO WITH (NOLOCK) ON (REGIO.ID_REGIONAL=CIUD.ID_REGIONAL)&#xA;&#x9;INNER JOIN PAR.CIUDADES CIUD2 WITH (NOLOCK) ON (CIUD2.ID_CIUDAD=DOC.ID_CIUDAD_DIVISION_ORIGEN)&#xA;&#x9;INNER JOIN PAR.REGIONALES_PAIS REGIO2 WITH (NOLOCK) ON (REGIO2.ID_REGIONAL=CIUD2.ID_REGIONAL)&#xA;) AS T&#xA;WHERE id=1&#xA;&#xA;----Paso 39 04 QUITAR DUPLICADOS Y RE ASIGNACION DE BODEGA Y REGIONAL&#xA;&#xA;TRUNCATE TABLE [TMP].[MBCORE_GUIAS_27];&#xA;;WITH CTE_ULTIMA_BODEGA_COMPENSACIONES AS(&#xA;&#x9;SELECT &#xA;&#x9;&#x9;ROW_NUMBER ( )   OVER ( PARTITION BY NUMERO_GUIA order by FECHA_HORA_MOVIMIENTO desc )  ROW_REPETIDO,  &#xA;&#x9;&#x9;&#x9;DIVISION_DESTINO&#xA;&#x9;&#x9;&#x9;,DIVISION_ORIGEN&#xA;&#x9;&#x9;&#x9;,NUMERO_GUIA&#xA;&#x9;&#x9;&#x9;,FECHA_HORA_MOVIMIENTO&#xA;&#x9;&#x9;&#x9;,FECHA_MODIFICACION_DG&#xA;&#x9;&#x9;&#x9;,REGIONAL_DESTINO&#xA;&#x9;&#x9;&#x9;,REGIONAL_ORIGEN&#xA;&#x9;&#x9;&#x9;,CIUDAD_DESTINO&#xA;&#x9;&#x9;&#x9;,CIUDAD_ORIGEN&#xA;&#x9;&#x9;&#x9;,ID_PROCESO&#xA;&#x9;&#x9;&#x9;,NOMBRE_PROCESO_LOG&#xA;&#x9;&#x9;&#x9;,BODEGA_UBICACION_ENVIO = &#xA;&#x9;&#x9;&#x9;&#x9;CASE &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN DIVISION_DESTINO LIKE '%COMPENSAC%' AND NOMBRE_PROCESO_LOG LIKE '%ENTRA%' THEN  DIVISION_DESTINO&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN DIVISION_DESTINO LIKE '%COMPENSAC%' AND NOMBRE_PROCESO_LOG LIKE '%SALIDA%' THEN DIVISION_ORIGEN &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN DIVISION_ORIGEN LIKE '%COMPENSAC%' AND NOMBRE_PROCESO_LOG LIKE '%SALIDA%' THEN DIVISION_DESTINO&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN DIVISION_DESTINO LIKE '%SIN DEFINIR%' AND NOMBRE_PROCESO_LOG LIKE '%SALIDA%' THEN DIVISION_ORIGEN&#xA;&#xA;&#x9;&#x9;&#x9;&#x9;ELSE  DIVISION_DESTINO END&#xA;&#x9;&#x9;&#x9;,REGIONAL_UBICACION_ENVIO = &#xA;&#x9;&#x9;&#x9;&#x9;CASE &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN DIVISION_DESTINO LIKE '%COMPENSAC%' AND NOMBRE_PROCESO_LOG LIKE '%ENTRADA%' THEN  REGIONAL_DESTINO&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN DIVISION_DESTINO LIKE '%COMPENSAC%' AND NOMBRE_PROCESO_LOG LIKE '%SALIDA%' THEN REGIONAL_ORIGEN &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN DIVISION_ORIGEN LIKE '%COMPENSAC%' AND NOMBRE_PROCESO_LOG LIKE '%SALIDA%' THEN REGIONAL_DESTINO &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN REGIONAL_DESTINO LIKE '%SIN DEFINIR%' AND NOMBRE_PROCESO_LOG LIKE '%SALIDA%' THEN REGIONAL_ORIGEN&#xA;&#x9;&#x9;&#x9;&#x9;ELSE  REGIONAL_DESTINO END&#xA;&#xA;&#x9;FROM &#xA;&#x9;[TMP].[MBCORE_GUIAS_26] WITH (NOLOCK)&#xA;)&#xA;INSERT INTO [TMP].[MBCORE_GUIAS_27]&#xA;SELECT &#xA;&#x9;&#x9;&#x9;DIVISION_DESTINO&#xA;&#x9;&#x9;&#x9;,DIVISION_ORIGEN&#xA;&#x9;&#x9;&#x9;,NUMERO_GUIA&#xA;&#x9;&#x9;&#x9;,FECHA_HORA_MOVIMIENTO&#xA;&#x9;&#x9;&#x9;,FECHA_MODIFICACION_DG&#xA;&#x9;&#x9;&#x9;,REGIONAL_DESTINO&#xA;&#x9;&#x9;&#x9;,REGIONAL_ORIGEN&#xA;&#x9;&#x9;&#x9;,CIUDAD_DESTINO&#xA;&#x9;&#x9;&#x9;,CIUDAD_ORIGEN&#xA;&#x9;&#x9;&#x9;,ID_PROCESO&#xA;&#x9;&#x9;&#x9;,NOMBRE_PROCESO_LOG&#xA;&#x9;&#x9;&#x9;,BODEGA_UBICACION_ENVIO&#xA;&#x9;&#x9;&#x9;,REGIONAL_UBICACION_ENVIO&#xA;&#x9;FROM CTE_ULTIMA_BODEGA_COMPENSACIONES&#xA;&#x9;WHERE ROW_REPETIDO=1&#xA;&#x9;&#xA;;WITH CTE_ULTIMA_BODEGA_Y_REGIONAL AS (&#xA; SELECT &#xA; ROW_NUMBER ( )   OVER ( PARTITION BY NUMERO_GUIA order by FECHA_HORA_MOVIMIENTO desc )  ID, &#xA;&#x9;NUMERO_GUIA, &#xA;&#x9;BODEGA_UBICACION_ENVIO,&#xA;&#x9;REGIONAL_UBICACION_ENVIO&#xA;   FROM [TMP].[MBCORE_GUIAS_27] WITH (NOLOCK)&#xA;) &#xA;UPDATE TMP SET&#xA;[CR_BODEGA_UBICACION] = ISNULL (CTE.BODEGA_UBICACION_ENVIO,'NO DISPONIBLE'),&#xA;[CR_REGIONAL_UBICACION] =  ISNULL (CTE.REGIONAL_UBICACION_ENVIO,'NO DISPONIBLE')&#xA;FROM &#xA; TMP.MBCORE_GUIAS TMP WITH (NOLOCK)&#xA; INNER JOIN CTE_ULTIMA_BODEGA_Y_REGIONAL CTE &#xA; ON TMP.G_NUMERO_GUIA = CTE.NUMERO_GUIA&#xA;WHERE &#xA;  CTE.id=1  AND TMP.CR_ID_APLICA_COMPENSACIONES=1&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\PASOS 33 34 35 - PASO 37 CLIENTE PROVISION PASO 38 UBICACION PASO 39 BODEGAS\MBCORE CODIGO CUN - MBCORE Nombre destinatario - MBCORE CLIENTES PROVISION - CLIENTES PROVISION POR DEFECTO"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{8E8D459F-74A6-47DA-A277-81672CEEACF0}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="MBCORE CODIGO CUN - MBCORE Nombre destinatario - MBCORE CLIENTES PROVISION - CLIENTES PROVISION POR DEFECTO"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="/*==========================================================================================&#xA;  PASOS 33, 34 y 37 - CUN, NOMBRE DESTINATARIO Y CLIENTE PROVISION EN TMP.MBCORE_GUIAS&#xA;  ------------------------------------------------------------------------------------------&#xA;  Consolida los 4 UPDATE originales (Script_06.sql) en UN SOLO UPDATE con CROSS APPLY.&#xA;&#xA;  Notas de diseno:&#xA;  - Leccion del plan de Script_03: un CROSS APPLY correlacionado contra tablas HEAP grandes&#xA;    (LOG.PQR = 1,6 M filas) hace un Table Scan por cada guia. Por eso primero se lee cada&#xA;    tabla fuente UNA sola vez, filtrada por las guias a procesar, hacia temporales indexadas;&#xA;    los CROSS APPLY del UPDATE buscan sobre esas temporales (Index Seek por guia).&#xA;  - Cada CROSS APPLY es un agregado sin GROUP BY sobre un TOP (1), por lo que SIEMPRE devuelve&#xA;    una fila; EXISTE replica el INNER JOIN original (sin coincidencia se conserva el valor).&#xA;  - ROW_NUMBER() ... id = 1  se reemplaza por  TOP (1) ... ORDER BY  (misma regla).&#xA;  - Paso 37: en el original el 37 03 se ejecuta DESPUES del 37 02 y sobrescribe a toda guia&#xA;    que exista en MBCORE_MECE_LOGISTICO_GUIAS. Se conserva esa precedencia:&#xA;        1) MECE_LOGISTICO_GUIAS (37 03)  2) MBCORE_GUIAS_24 / PQR (37 02)  3) valor actual.&#xA;  - TMP.MBCORE_GUIAS_24 se sigue cargando (TRUNCATE + INSERT) por si otros procesos la usan.&#xA;==========================================================================================*/&#xA;SET NOCOUNT ON;&#xA;&#xA;DROP TABLE IF EXISTS #GUIAS;&#xA;DROP TABLE IF EXISTS #PQR;&#xA;DROP TABLE IF EXISTS #MECE;&#xA;DROP TABLE IF EXISTS #PQR_CLIENTES;&#xA;DROP TABLE IF EXISTS #PROV;&#xA;&#xA;----------------------------------------------------------------------------------------------&#xA;-- 1. GUIAS A PROCESAR&#xA;----------------------------------------------------------------------------------------------&#xA;SELECT DISTINCT TMP.G_NUMERO_GUIA AS NUMERO_GUIA&#xA;INTO #GUIAS&#xA;FROM TMP.MBCORE_GUIAS TMP WITH (NOLOCK)&#xA;WHERE TMP.G_NUMERO_GUIA IS NOT NULL;&#xA;&#xA;CREATE UNIQUE CLUSTERED INDEX IX_GUIAS ON #GUIAS (NUMERO_GUIA);&#xA;&#xA;----------------------------------------------------------------------------------------------&#xA;-- 2. PQR DE LAS GUIAS (un solo scan de LOG.PQR; sirve para pasos 33 y 37 01)&#xA;----------------------------------------------------------------------------------------------&#xA;SELECT&#xA;&#x9; PQR.NUMERO_GUIA&#xA;&#x9;,PQR.CUN&#xA;&#x9;,PQR.FECHA_MODIFICA&#xA;&#x9;,PQR.ID_CLIENTE&#xA;INTO #PQR&#xA;FROM SIG_COLOMBIA_DW.LOG.[PQR] PQR WITH (NOLOCK)&#xA;WHERE EXISTS (SELECT 1 FROM #GUIAS G WHERE G.NUMERO_GUIA = PQR.NUMERO_GUIA);&#xA;&#xA;CREATE CLUSTERED INDEX IX_PQR ON #PQR (NUMERO_GUIA, FECHA_MODIFICA);&#xA;&#xA;----------------------------------------------------------------------------------------------&#xA;-- 3. MECE LOGISTICO GUIAS (un solo scan; sirve para pasos 34 y 37 03)&#xA;--    Se resuelve aqui el nombre del cliente para no buscar PAR.CLIENTES por cada guia.&#xA;----------------------------------------------------------------------------------------------&#xA;SELECT&#xA;&#x9; G.NUMERO_GUIA&#xA;&#x9;,G.NOMBRE_DESTINA_GUIA&#xA;&#x9;,G.FECHA_MODIFICACION&#xA;&#x9;,CAST(G.ID_CLIENTE AS VARCHAR(50)) AS ID_CLIENTE&#xA;&#x9;,CLIE.NOMBRE_CLIENTE&#xA;&#x9;,G.FECHA_MODIFICACION_DG&#xA;INTO #MECE&#xA;FROM SIG_COLOMBIA_DW.TMP.MBCORE_MECE_LOGISTICO_GUIAS G WITH (NOLOCK)&#xA;LEFT JOIN PAR.CLIENTES CLIE WITH (NOLOCK)&#xA;&#x9;ON CLIE.ID_CLIENTE = G.ID_CLIENTE&#xA;WHERE EXISTS (SELECT 1 FROM #GUIAS GU WHERE GU.NUMERO_GUIA = G.NUMERO_GUIA);&#xA;&#xA;CREATE CLUSTERED INDEX IX_MECE ON #MECE (NUMERO_GUIA);&#xA;&#xA;----------------------------------------------------------------------------------------------&#xA;-- 4. PASO 37 01 CLIENTES PROVISION (ultimo registro por cliente) y carga de MBCORE_GUIAS_24&#xA;----------------------------------------------------------------------------------------------&#xA;SELECT X.ID_CLIENTE, X.NOMBRE_EMPRESA&#xA;INTO #PQR_CLIENTES&#xA;FROM (&#xA;&#x9;SELECT&#xA;&#x9;&#x9; CAST(PQRCLIE.ID_CLIENTE AS VARCHAR(50))  AS ID_CLIENTE&#xA;&#x9;&#x9;,CAST(PQRCLIE.NOMBRE_EMPRESA AS VARCHAR(100)) AS NOMBRE_EMPRESA&#xA;&#x9;&#x9;,ROW_NUMBER() OVER (PARTITION BY PQRCLIE.ID_CLIENTE ORDER BY PQRCLIE.FECHA_MODIFICA DESC) AS RN&#xA;&#x9;FROM SIG_COL_LOGISTICA_DW.DIM.PQR_CLIENTES PQRCLIE WITH (NOLOCK)&#xA;) X&#xA;WHERE X.RN = 1;&#xA;&#xA;CREATE CLUSTERED INDEX IX_PQR_CLIENTES ON #PQR_CLIENTES (ID_CLIENTE);&#xA;&#xA;SELECT DISTINCT&#xA;&#x9; P.NUMERO_GUIA&#xA;&#x9;,P.ID_CLIENTE&#xA;&#x9;,C.NOMBRE_EMPRESA&#xA;INTO #PROV&#xA;FROM #PQR P&#xA;INNER JOIN #PQR_CLIENTES C&#xA;&#x9;ON C.ID_CLIENTE = P.ID_CLIENTE&#xA;WHERE LEN(P.NUMERO_GUIA) &gt; 1;&#xA;&#xA;CREATE CLUSTERED INDEX IX_PROV ON #PROV (NUMERO_GUIA);&#xA;&#xA;TRUNCATE TABLE TMP.MBCORE_GUIAS_24;&#xA;&#xA;INSERT INTO TMP.MBCORE_GUIAS_24&#xA;SELECT NUMERO_GUIA, ID_CLIENTE, NOMBRE_EMPRESA&#xA;FROM #PROV;&#xA;&#xA;----------------------------------------------------------------------------------------------&#xA;-- 5. UPDATE UNICO CON CROSS APPLY&#xA;----------------------------------------------------------------------------------------------&#xA;UPDATE TMP&#xA;SET&#xA;&#x9;----PASO 33 CODIGO CUN&#xA;&#x9; CUN                      = CASE WHEN CU.EXISTE &gt; 0 THEN ISNULL(CU.CUN, -888) ELSE TMP.CUN END&#xA;&#x9;----PASO 34 NOMBRE DESTINATARIO&#xA;&#x9;,Nombre_destinatario      = CASE WHEN ND.EXISTE &gt; 0 THEN ISNULL(ND.NOMBRE, 'NO DISPONIBLE') ELSE TMP.Nombre_destinatario END&#xA;&#x9;----PASO 37 02 / 37 03 CLIENTE PROVISION (37 03 tiene prioridad, igual que el original)&#xA;&#x9;,ID_CLIENTE_PROVISION     = CASE WHEN DG.EXISTE &gt; 0 THEN ISNULL(DG.ID_CLIENTE, 'NO DISPONIBLE')&#xA;&#x9;                                 WHEN PV.EXISTE &gt; 0 THEN ISNULL(PV.ID_CLIENTE, 'NO DISPONIBLE')&#xA;&#x9;                                 ELSE TMP.ID_CLIENTE_PROVISION END&#xA;&#x9;,NOMBRE_CLIENTE_PROVISION = CASE WHEN DG.EXISTE &gt; 0 THEN ISNULL(DG.NOMBRE_CLIENTE, 'NO DISPONIBLE')&#xA;&#x9;                                 WHEN PV.EXISTE &gt; 0 THEN ISNULL(PV.NOMBRE_EMPRESA, 'NO DISPONIBLE')&#xA;&#x9;                                 ELSE TMP.NOMBRE_CLIENTE_PROVISION END&#xA;&#xA;FROM&#xA;&#x9;TMP.MBCORE_GUIAS TMP&#xA;&#xA;&#x9;----PASO 33 CUN DE LA PQR MAS RECIENTE (FECHA_MODIFICA DESC)&#xA;&#x9;CROSS APPLY (&#xA;&#x9;&#x9;SELECT COUNT(*) AS EXISTE, MAX(X.CUN) AS CUN&#xA;&#x9;&#x9;FROM (&#xA;&#x9;&#x9;&#x9;SELECT TOP (1) P.CUN&#xA;&#x9;&#x9;&#x9;FROM #PQR P&#xA;&#x9;&#x9;&#x9;WHERE P.NUMERO_GUIA = TMP.G_NUMERO_GUIA&#xA;&#x9;&#x9;&#x9;ORDER BY P.FECHA_MODIFICA DESC&#xA;&#x9;&#x9;) X&#xA;&#x9;) CU&#xA;&#xA;&#x9;----PASO 34 NOMBRE DESTINATARIO MAS RECIENTE (FECHA_MODIFICACION DESC)&#xA;&#x9;CROSS APPLY (&#xA;&#x9;&#x9;SELECT COUNT(*) AS EXISTE, MAX(X.NOMBRE_DESTINA_GUIA) AS NOMBRE&#xA;&#x9;&#x9;FROM (&#xA;&#x9;&#x9;&#x9;SELECT TOP (1) M.NOMBRE_DESTINA_GUIA&#xA;&#x9;&#x9;&#x9;FROM #MECE M&#xA;&#x9;&#x9;&#x9;WHERE M.NUMERO_GUIA = TMP.G_NUMERO_GUIA&#xA;&#x9;&#x9;&#x9;ORDER BY M.FECHA_MODIFICACION DESC&#xA;&#x9;&#x9;) X&#xA;&#x9;) ND&#xA;&#xA;&#x9;----PASO 37 02 CLIENTE PROVISION DESDE PQR (MBCORE_GUIAS_24)&#xA;&#x9;CROSS APPLY (&#xA;&#x9;&#x9;SELECT COUNT(*) AS EXISTE, MAX(X.ID_CLIENTE) AS ID_CLIENTE, MAX(X.NOMBRE_EMPRESA) AS NOMBRE_EMPRESA&#xA;&#x9;&#x9;FROM (&#xA;&#x9;&#x9;&#x9;SELECT TOP (1) CAST(PR.ID_CLIENTE AS VARCHAR(50)) AS ID_CLIENTE, PR.NOMBRE_EMPRESA&#xA;&#x9;&#x9;&#x9;FROM #PROV PR&#xA;&#x9;&#x9;&#x9;WHERE PR.NUMERO_GUIA = TMP.G_NUMERO_GUIA&#xA;&#x9;&#x9;&#x9;ORDER BY PR.ID_CLIENTE&#xA;&#x9;&#x9;) X&#xA;&#x9;) PV&#xA;&#xA;&#x9;----PASO 37 03 CLIENTE PROVISION POR DEFECTO (FECHA_MODIFICACION_DG DESC)&#xA;&#x9;CROSS APPLY (&#xA;&#x9;&#x9;SELECT COUNT(*) AS EXISTE, MAX(X.ID_CLIENTE) AS ID_CLIENTE, MAX(X.NOMBRE_CLIENTE) AS NOMBRE_CLIENTE&#xA;&#x9;&#x9;FROM (&#xA;&#x9;&#x9;&#x9;SELECT TOP (1) M.ID_CLIENTE, M.NOMBRE_CLIENTE&#xA;&#x9;&#x9;&#x9;FROM #MECE M&#xA;&#x9;&#x9;&#x9;WHERE M.NUMERO_GUIA = TMP.G_NUMERO_GUIA&#xA;&#x9;&#x9;&#x9;ORDER BY M.FECHA_MODIFICACION_DG DESC&#xA;&#x9;&#x9;) X&#xA;&#x9;) DG&#xA;&#xA;-- Solo se escriben las guias con al menos una coincidencia&#xA;WHERE&#xA;&#x9;   CU.EXISTE &gt; 0&#xA;&#x9;OR ND.EXISTE &gt; 0&#xA;&#x9;OR PV.EXISTE &gt; 0&#xA;&#x9;OR DG.EXISTE &gt; 0;&#xA;&#xA;DROP TABLE IF EXISTS #GUIAS;&#xA;DROP TABLE IF EXISTS #PQR;&#xA;DROP TABLE IF EXISTS #MECE;&#xA;DROP TABLE IF EXISTS #PQR_CLIENTES;&#xA;DROP TABLE IF EXISTS #PROV;&#xA;GO&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\PASOS 33 34 35 - PASO 37 CLIENTE PROVISION PASO 38 UBICACION PASO 39 BODEGAS\Paso 40 00 Actualizar Campo Valor del Flete"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{ECE38876-8B10-42CC-A4CC-CE0470798416}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Paso 40 00 Actualizar Campo Valor del Flete"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="&#xA;WITH CTE_VALOR_FLETES_GUIAS AS (&#xA;&#x9;SELECT ROW_NUMBER ( )   OVER ( PARTITION BY GUI.[NUMERO_GUIA] order by GUI.FECHA_MODIFICACION_DG desc )  id,  &#xA;&#x9;&#x9; TMP.[G_NUMERO_GUIA],&#xA;&#x9;&#x9; GUI.[VALOR_FLETES_GUIAS]&#x9; &#xA;&#x9;&#x9;FROM   SIG_COLOMBIA_DW.TMP.MBCORE_MECE_LOGISTICO_GUIAS  GUI WITH(NOLOCK)&#xA;&#x9;&#x9;INNER JOIN TMP.MBCORE_GUIAS TMP WITH(NOLOCK) &#xA;&#x9;&#x9;ON TMP.[G_NUMERO_GUIA]=GUI.[NUMERO_GUIA] &#xA;)&#xA;UPDATE TMP SET &#xA;VALOR_FLETES_GUIAS = ISNULL(CTE.VALOR_FLETES_GUIAS,0)&#xA;FROM CTE_VALOR_FLETES_GUIAS CTE&#xA;INNER JOIN TMP.MBCORE_GUIAS TMP WITH(NOLOCK) &#xA;ON TMP.[G_NUMERO_GUIA]=CTE.G_NUMERO_GUIA &#xA;WHERE id=1&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
      </DTS:Executables>
      <DTS:PrecedenceConstraints>
