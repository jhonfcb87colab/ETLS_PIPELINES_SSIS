                  <DTS:ObjectData>
                    <SQLTask:SqlTaskData
                      SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
                      SQLTask:SqlStatementSource="WITH CTE &#xA;(&#xA;&#x9; ID&#xA;&#x9;,G_NUMERO_GUIA&#xA;&#x9;,G_NOVEDAD&#xA;&#x9;,G_FECHA_NOVEDAD&#xA;&#x9;&#xA;)&#xA;AS&#xA;(&#xA;SELECT &#xA;&#x9; ROW_NUMBER() OVER(PARTITION BY NOV.G_NUMERO_GUIA ORDER BY NOV.DETND_FECHA_NOVEDAD DESC) ID&#xA;&#x9;,TMP.G_NUMERO_GUIA&#xA;&#x9;,NOV.G_NOVEDAD+' - '+NOV.G_TIPO_NOVEDAD+' - '+NOV.G_SUB_NOVEDAD AS G_NOVEDAD&#xA;&#x9;,NOV.DETND_FECHA_NOVEDAD&#xA;&#x9;&#xA;FROM &#xA;&#x9;TMP.MBCORE_GUIAS_NOVEDADES NOV WITH (NOLOCK)&#xA;INNER JOIN &#xA;&#x9;TMP.MBCORE_GUIAS TMP WITH (NOLOCK)&#xA;ON &#xA;&#x9;NOV.G_NUMERO_GUIA = TMP.G_NUMERO_GUIA&#xA;)&#xA;INSERT INTO TMP.MBCORE_GUIAS_11&#xA;(&#xA;&#x9; ID&#xA;&#x9;,G_NUMERO_GUIA&#xA;&#x9;,G_NOVEDAD&#xA;&#x9;,G_FECHA_NOVEDAD&#xA;)&#xA;SELECT &#xA;&#x9; CTE.ID&#xA;&#x9;,CTE.G_NUMERO_GUIA&#xA;&#x9;,CTE.G_NOVEDAD&#xA;&#x9;,CTE.G_FECHA_NOVEDAD&#xA;FROM &#xA;CTE" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
                  </DTS:ObjectData>
                </DTS:Executable>
