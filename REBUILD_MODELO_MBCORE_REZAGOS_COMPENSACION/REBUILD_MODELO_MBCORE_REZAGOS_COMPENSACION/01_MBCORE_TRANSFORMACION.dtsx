        DTS:FilterKind="0" />
      <DTS:Executables>
        <DTS:Executable
          DTS:refId="Package\CARGA INICIAL OPERADO DE EXTRACCION Y GENERADOR DE FECHAS\Depurar Combinar rezagos y guias del dia"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{DF3163BC-7998-4E5F-8B12-7CEFA3F84601}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Depurar Combinar rezagos y guias del dia"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{DA00E6FB-D0CA-48C7-A7AA-D8AF33BD5BBA}"
              SQLTask:SqlStatementSource="&#xA;&#xA;&#xA;------SELECT T01.NUMERO_GUIA,T02.NUMERO_GUIA,T01.FECHA_HORA_MOVIMIENTO,T02.FECHA_HORA_MOVIMIENTO,T01.ID_PROCESO,T02.ID_PROCESO&#xA;------,DIFERENCIA = DATEDIFF(DAY,T01.FECHA_HORA_MOVIMIENTO,T02.FECHA_HORA_MOVIMIENTO)&#xA;------,APLICA = CASE WHEN T01.FECHA_HORA_MOVIMIENTO = T02.FECHA_HORA_MOVIMIENTO THEN 1&#xA;------&#x9;&#x9;&#x9;WHEN T01.FECHA_HORA_MOVIMIENTO &gt; T02.FECHA_HORA_MOVIMIENTO THEN 2&#xA;------&#x9;&#x9;&#x9;WHEN T01.FECHA_HORA_MOVIMIENTO &lt; T02.FECHA_HORA_MOVIMIENTO THEN 3&#xA;------&#x9;&#x9;&#x9;ELSE 99&#xA;------&#x9;&#x9;&#x9;END&#xA;----FROM [tmp_borrar_local].[dbo].[BI_MBCORE_GUIAS_BASE] T01&#xA;----INNER JOIN  [tmp_borrar_local].[dbo].[BI_MBCORE_GUIAS_BASE_REZAGOS] T02&#xA;------ON T01.NUMERO_GUIA = T02.NUMERO_GUIA&#xA;&#xA;&#xA;&#xA;&#xA;----------------------------------------------------------&#xA;DELETE T02&#xA;FROM [tmp_borrar_local].[dbo].[BI_MBCORE_GUIAS_BASE] T01&#xA;INNER JOIN  [tmp_borrar_local].[dbo].[BI_MBCORE_GUIAS_BASE_REZAGOS] T02&#xA;ON T01.NUMERO_GUIA = T02.NUMERO_GUIA&#xA;WHERE T01.ID_PROCESO=11 AND T02.ID_PROCESO=11&#xA;&#xA;&#xA;&#xA;DELETE T02&#xA;FROM [tmp_borrar_local].[dbo].[BI_MBCORE_GUIAS_BASE] T01&#xA;INNER JOIN  [tmp_borrar_local].[dbo].[BI_MBCORE_GUIAS_BASE_REZAGOS] T02&#xA;ON T01.NUMERO_GUIA = T02.NUMERO_GUIA&#xA;WHERE T01.FECHA_HORA_MOVIMIENTO &gt; T02.FECHA_HORA_MOVIMIENTO&#xA;&#xA;&#xA;&#xA;DELETE T02&#xA;FROM [tmp_borrar_local].[dbo].[BI_MBCORE_GUIAS_BASE] T01&#xA;INNER JOIN  [tmp_borrar_local].[dbo].[BI_MBCORE_GUIAS_BASE_REZAGOS] T02&#xA;ON T01.NUMERO_GUIA = T02.NUMERO_GUIA&#xA;WHERE T01.ID_PROCESO=T02.ID_PROCESO&#xA;AND T01.FECHA_HORA_MOVIMIENTO = T02.FECHA_HORA_MOVIMIENTO&#xA;&#xA;&#xA;DELETE T01&#xA;FROM [tmp_borrar_local].[dbo].[BI_MBCORE_GUIAS_BASE] T01&#xA;INNER JOIN  [tmp_borrar_local].[dbo].[BI_MBCORE_GUIAS_BASE_REZAGOS] T02&#xA;ON T01.NUMERO_GUIA = T02.NUMERO_GUIA&#xA;&#xA;&#xA;INSERT INTO [tmp_borrar_local].[dbo].[BI_MBCORE_GUIAS_BASE]&#xA;SELECT * FROM [tmp_borrar_local].[dbo].[BI_MBCORE_GUIAS_BASE_REZAGOS] &#xA;&#xA;&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
