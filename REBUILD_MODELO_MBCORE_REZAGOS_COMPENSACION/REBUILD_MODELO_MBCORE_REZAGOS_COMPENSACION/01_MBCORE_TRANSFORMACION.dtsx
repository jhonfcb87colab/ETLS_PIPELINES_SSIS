                <SQLTask:SqlTaskData
                  SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
                  SQLTask:SqlStatementSource="INSERT INTO &#xA;&#x9;[TMP].[MBCORE_GUIAS_NOVEDADES]&#xA;(&#xA;&#x9; [G_NUMERO_GUIA]&#xA;&#x9;,[G_TIPO_NOVEDAD]&#xA;&#x9;,[G_NOVEDAD]&#xA;&#x9;,[G_SUB_NOVEDAD]&#xA;&#x9;,[DETND_FECHA_NOVEDAD]&#xA;)&#xA;&#xA;SELECT&#xA;&#x9; TMP.G_NUMERO_GUIA&#x9;&#xA;&#x9;,TIPN.NOMBRE_TIPO_NOVEDAD&#xA;&#x9;,CASE WHEN TIPN.[ES_NOVEDAD_EXTERNA] = 1 THEN 'EXTERNA' ELSE 'INTERNA' END&#x9;&#x9;&#x9;&#xA;&#x9;,ISNULL(PAR.NOMBRE_SUBTIPO_NOVEDAD,'NO DISPONIBLE')&#xA;&#x9;,TMP07.FECHA_HORA_MOVIMIENTO&#xA;FROM&#xA;&#x9;SIG_COLOMBIA_DW.[LOG].[DOCUMENTOS_NOVEDAD_DIARIA] DOCND WITH(NOLOCK)&#xA;INNER JOIN&#xA;&#x9;SIG_COLOMBIA_DW.[LOG].[NOVEDAD_DIARIA] ND WITH(NOLOCK)&#xA;ON&#xA;&#x9;[DOCND].[ID_PAIS_UNO] = [ND].[ID_PAIS_UNO]&#xA;AND&#xA;&#x9;[DOCND].[ID_CIUDAD_UNO] = [ND].[ID_CIUDAD_UNO]&#xA;AND&#xA;&#x9;[DOCND].[FECHA_NOVEDAD] = [ND].[FECHA_NOVEDAD]&#xA;INNER JOIN&#xA;&#x9;[TMP].[MBCORE_GUIAS_07] TMP07 WITH (NOLOCK)&#xA;ON&#xA;&#x9;[DOCND].[ID_PROCESO] = [TMP07].[ID_PROCESO]&#xA;AND &#xA;&#x9;[DOCND].[NUMERO_MOVIMI]  = [TMP07].[NUMERO_MOVIMI]  &#xA;AND&#xA;&#x9;[DOCND].[CONSECUT_MOVIMI] = [TMP07].[CONSECUT_MOVIMI]&#xA;INNER JOIN &#xA;&#x9;[TMP].[MBCORE_GUIAS] TMP WITH (NOLOCK)&#xA;ON &#xA;&#x9;[TMP].[G_NUMERO_GUIA] = [TMP07].[NUMERO_GUIA]&#xA;INNER JOIN &#xA;&#x9;[PAR].[TIPOSNOVEDADESOPERATIVAS] TIPN WITH (NOLOCK)&#xA;ON&#xA;&#x9;[ND].[ID_TIPO_NOVEDAD] = [TIPN].[ID_TIPO_NOVEDAD]&#xA;LEFT JOIN&#xA;&#x9;SIG_COLOMBIA_DW.[LOG].[DETALLE_NOVEDAD_DIARIA] DETND WITH(NOLOCK)&#xA;ON&#xA;&#x9;[DOCND].[ID_PAIS_UNO] = [DETND].[ID_PAIS_UNO]&#xA;AND&#xA;&#x9;[DOCND].[ID_CIUDAD_UNO] = [DETND].[ID_CIUDAD_UNO]&#xA;AND&#xA;&#x9;[DOCND].[FECHA_NOVEDAD] = [DETND].[FECHA_NOVEDAD]&#xA;LEFT JOIN&#xA;&#x9;[PAR].[SUBTIPOS_NOVEDADES_OPERATIVAS] PAR WITH (NOLOCK)&#xA;ON&#xA;&#x9;[TIPN].[ID_TIPO_NOVEDAD] = [PAR].[ID_TIPO_NOVEDAD]&#xA;AND &#xA;&#x9;[DETND].[ID_SUBTIPO_NOVEDAD] = [PAR].[ID_SUBTIPO_NOVEDAD]&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
              </DTS:ObjectData>
            </DTS:Executable>
