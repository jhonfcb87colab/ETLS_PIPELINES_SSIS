    <DTS:Executable
      DTS:refId="Package\Bacups 20261021"
      DTS:CreationName="STOCK:SEQUENCE"
      DTS:Description="Sequence Container"
      DTS:Disabled="True"
      DTS:DTSID="{7C250193-92E3-4DE0-8FB5-EFBE070B7E12}"
      DTS:ExecutableType="STOCK:SEQUENCE"
      DTS:LocaleID="-1"
      DTS:ObjectName="Bacups 20261021">
      <DTS:Variables />
      <DTS:Executables>
        <DTS:Executable
          DTS:refId="Package\Bacups 20261021\ACTUALIZACION CAMPOS FALTANTES"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:Disabled="True"
          DTS:DTSID="{ce4b6853-0e76-4b27-921d-6c78702409cb}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="ACTUALIZACION CAMPOS FALTANTES"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="2">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="DROP TABLE IF EXISTS #GEOGRAFIA&#xA;SELECT&#xA;CD.ID_CIUDAD,&#xA;CD.NOMBRE_CIUDAD,&#xA;RG.ID_REGIONAL,&#xA;RG.NOMBRE_REGIONAL,&#xA;DP.ID_DEPARTAMENTO,&#xA;DP.NOMBRE_DEPARTAMENTO&#xA;INTO #GEOGRAFIA&#xA;FROM PAR.CIUDADES CD WITH(NOLOCK)&#xA;INNER JOIN  PAR.REGIONALES_PAIS RG WITH(NOLOCK)&#xA;ON RG.ID_REGIONAL=CD.ID_REGIONAL&#xA;INNER JOIN PAR.DEPARTAMENTOS DP WITH(NOLOCK)&#xA;ON DP.ID_DEPARTAMENTO=CD.ID_DEPARTAMENTO &#xA;WHERE CD.ID_PAIS=1 AND DP.ID_PAIS=1&#xA;&#xA;&#xA;DROP TABLE IF EXISTS #UBICACIONES_Y_BODEGAS;&#xA;;WITH ULT_MOV AS(&#xA;SELECT TOP 0&#xA; ROWID = ROW_NUMBER() OVER(PARTITION BY SEG.NUMERO_GUIA ORDER BY SEG.FECHA_HORA_MOVIMIENTO DESC)&#xA; ,SEG.NUMERO_GUIA&#xA; ,SEG.FECHA_HORA_MOVIMIENTO&#xA; ,SEG.ID_PROCESO&#xA; ,DOC.ID_CIUDAD_CANAL&#xA; ,DOC.ID_CIUDAD_ZONA_URBA&#xA; ,DOC.ID_CIUDAD_DIVISION_ORIGEN&#xA; ,DOC.ID_CIUDAD_DESTINO&#xA; ,DOC.ID_DIVISION_ORIGEN&#xA; ,DOC.ID_DIVISION_DESTINO&#xA; ,G_ID_CIUDAD_CANAL_ORIGEN = CASE &#xA;        WHEN ISNULL(DOC.ID_CIUDAD_CANAL,0)&lt;&gt;0 THEN DOC.ID_CIUDAD_CANAL&#xA;        WHEN ISNULL(DOC.ID_CIUDAD_CANAL,0)=0 AND ISNULL(DOC.ID_CIUDAD_DIVISION_ORIGEN,0)&lt;&gt;0 THEN DOC.ID_CIUDAD_DIVISION_ORIGEN&#xA;        WHEN ISNULL(DOC.ID_CIUDAD_CANAL,0)=0 AND ISNULL(DOC.ID_CIUDAD_DIVISION_ORIGEN,0)=0 AND ISNULL(DOC.ID_CIUDAD_ZONA_URBA,0)&lt;&gt;0 THEN DOC.ID_CIUDAD_ZONA_URBA&#xA;        WHEN ISNULL(DOC.ID_CIUDAD_CANAL,0)=0 AND ISNULL(DOC.ID_CIUDAD_DIVISION_ORIGEN,0)=0 AND ISNULL(DOC.ID_CIUDAD_ZONA_URBA,0)=0 THEN DOC.ID_DIVISION_DESTINO&#xA;        ELSE DOC.ID_DIVISION_DESTINO END&#xA;FROM TMP.MBCORE_SEGUIMIENTO_ENVIO SEG WITH(NOLOCK)&#xA;INNER JOIN TMP.MBCORE_DOCUMENTOS DOC WITH(NOLOCK)&#xA;ON SEG.ID_PROCESO=DOC.ID_PROCESO &#xA;AND SEG.NUMERO_MOVIMI=DOC.NUMERO_MOVIMI &#xA;AND SEG.CONSECUT_MOVIMI=DOC.CONSECUT_MOVIMI&#xA;)SELECT &#xA;CTE.*&#xA;,G_CIUDAD_CANAL_ORIGEN = GEO.NOMBRE_CIUDAD&#xA;,G_DEPARTAMENTO_CANAL_ORIGEN = GEO.NOMBRE_DEPARTAMENTO &#xA;,G_REGIONAL_CANAL_ORIGEN = GEO.NOMBRE_REGIONAL&#xA;INTO #UBICACIONES_Y_BODEGAS&#xA;FROM ULT_MOV CTE &#xA;INNER JOIN #GEOGRAFIA GEO&#xA;ON GEO.ID_CIUDAD=CTE.G_ID_CIUDAD_CANAL_ORIGEN&#xA;WHERE ROWID=1&#xA;&#xA;CREATE NONCLUSTERED INDEX [IX_NUMERO_GUIA_MBCORE_TMP] ON #UBICACIONES_Y_BODEGAS([NUMERO_GUIA] ASC)&#xA;WITH (PAD_INDEX = OFF, STATISTICS_NORECOMPUTE = OFF, SORT_IN_TEMPDB = OFF, DROP_EXISTING = OFF, ONLINE = OFF, &#xA;ALLOW_ROW_LOCKS = ON, ALLOW_PAGE_LOCKS = ON, FILLFACTOR = 80) &#xA;&#xA;&#xA;;WITH ULT_MOV AS(&#xA;SELECT &#xA; ROWID = ROW_NUMBER() OVER(PARTITION BY SEG.NUMERO_GUIA ORDER BY SEG.FECHA_HORA_MOVIMIENTO DESC)&#xA; ,SEG.NUMERO_GUIA&#xA; ,SEG.FECHA_HORA_MOVIMIENTO&#xA; ,SEG.ID_PROCESO&#xA; ,DOC.ID_CIUDAD_CANAL&#xA; ,DOC.ID_CIUDAD_ZONA_URBA&#xA; ,DOC.ID_CIUDAD_DIVISION_ORIGEN&#xA; ,DOC.ID_CIUDAD_DESTINO&#xA; ,DOC.ID_DIVISION_ORIGEN&#xA; ,DOC.ID_DIVISION_DESTINO&#xA; ,G_ID_CIUDAD_CANAL_ORIGEN = CASE &#xA;        WHEN ISNULL(DOC.ID_CIUDAD_CANAL,0)&lt;&gt;0 THEN DOC.ID_CIUDAD_CANAL&#xA;        WHEN ISNULL(DOC.ID_CIUDAD_CANAL,0)=0 AND ISNULL(DOC.ID_CIUDAD_DIVISION_ORIGEN,0)&lt;&gt;0 THEN DOC.ID_CIUDAD_DIVISION_ORIGEN&#xA;        WHEN ISNULL(DOC.ID_CIUDAD_CANAL,0)=0 AND ISNULL(DOC.ID_CIUDAD_DIVISION_ORIGEN,0)=0 AND ISNULL(DOC.ID_CIUDAD_ZONA_URBA,0)&lt;&gt;0 THEN DOC.ID_CIUDAD_ZONA_URBA&#xA;        WHEN ISNULL(DOC.ID_CIUDAD_CANAL,0)=0 AND ISNULL(DOC.ID_CIUDAD_DIVISION_ORIGEN,0)=0 AND ISNULL(DOC.ID_CIUDAD_ZONA_URBA,0)=0 THEN DOC.ID_DIVISION_DESTINO&#xA;        ELSE DOC.ID_DIVISION_DESTINO END&#xA;FROM TMP.MBCORE_SEGUIMIENTO_ENVIO SEG WITH(NOLOCK)&#xA;INNER JOIN TMP.MBCORE_DOCUMENTOS DOC WITH(NOLOCK)&#xA;ON SEG.ID_PROCESO=DOC.ID_PROCESO &#xA;AND SEG.NUMERO_MOVIMI=DOC.NUMERO_MOVIMI &#xA;AND SEG.CONSECUT_MOVIMI=DOC.CONSECUT_MOVIMI&#xA;)&#xA;insert INTO #UBICACIONES_Y_BODEGAS&#xA;SELECT &#xA;CTE.*&#xA;,G_CIUDAD_CANAL_ORIGEN = GEO.NOMBRE_CIUDAD&#xA;,G_DEPARTAMENTO_CANAL_ORIGEN = GEO.NOMBRE_DEPARTAMENTO &#xA;,G_REGIONAL_CANAL_ORIGEN = GEO.NOMBRE_REGIONAL&#xA;FROM ULT_MOV CTE &#xA;INNER JOIN #GEOGRAFIA GEO&#xA;ON GEO.ID_CIUDAD=CTE.G_ID_CIUDAD_CANAL_ORIGEN&#xA;WHERE ROWID=1&#xA;&#xA;&#xA;&#xA;DROP TABLE IF EXISTS #CONSULTA_FINAL_UPDATE_MBCORE_CANLAES&#xA;SELECT &#xA;ID_ROWCTT = ROW_NUMBER() OVER(ORDER BY GUI.FECHA_ENVIO)&#xA;,MBCORE.G_NUMERO_GUIA&#xA;,G_CIUDAD_DESTINO = GEO.NOMBRE_CIUDAD&#xA;,G_DEPARTAMENTO_DESTINO = GEO.NOMBRE_DEPARTAMENTO&#xA;,G_REGIONAL_DESTINO = GEO.NOMBRE_REGIONAL&#xA;,CR_ID_APLICA_COMPENSACIONES = (CASE WHEN UBIC.ID_DIVISION_ORIGEN IN(/*COMPENSACIONES: */9209,9235,9236,9237,9238,9238,9241,9265,19209,91441,92134,94698,/*REZAGOS: */9239,9240,9241) &#xA;           OR UBIC.ID_DIVISION_DESTINO IN(/*COMPENSACIONES: */9209,9235,9236,9237,9238,9238,9241,9265,19209,91441,92134,94698,/*REZAGOS: */9239,9240,9241)&#xA;            THEN 1 ELSE 0 END)&#xA;,UBIC.G_CIUDAD_CANAL_ORIGEN &#xA;,UBIC.G_DEPARTAMENTO_CANAL_ORIGEN&#xA;,UBIC.G_REGIONAL_CANAL_ORIGEN&#xA;,G_CANAL = CASE WHEN GUI.ID_CLIENTE IS NULL AND ISNULL(GUI.ID_CANAL,'0')&lt;&gt;'0' THEN 'RETAIL'&#xA;      WHEN GUI.ID_CLIENTE IS NOT NULL AND ISNULL(GUI.ID_CANAL,'0')='0' THEN 'CORPORATIVO'&#xA;      ELSE 'OTROS'&#xA;      END&#xA;into #CONSULTA_FINAL_UPDATE_MBCORE_CANLAES&#xA;FROM TMP.MBCORE_MECE_LOGISTICO_GUIAS GUI WITH(NOLOCK)&#xA;INNER JOIN TMP.MBCORE_GUIAS MBCORE WITH(NOLOCK)&#xA;ON MBCORE.G_NUMERO_GUIA=GUI.NUMERO_GUIA&#xA;INNER JOIN #GEOGRAFIA GEO ON GEO.ID_CIUDAD=GUI.ID_CIUDAD_DESTINO&#xA;INNER JOIN #UBICACIONES_Y_BODEGAS UBIC ON MBCORE.G_NUMERO_GUIA=UBIC.NUMERO_GUIA&#xA;&#xA;&#xA;CREATE NONCLUSTERED INDEX [XX_NUMERO_GUIA_MBCORE_TMP] ON #CONSULTA_FINAL_UPDATE_MBCORE_CANLAES([G_NUMERO_GUIA] ASC)&#xA;WITH (PAD_INDEX = OFF, STATISTICS_NORECOMPUTE = OFF, SORT_IN_TEMPDB = OFF, DROP_EXISTING = OFF, ONLINE = OFF, &#xA;ALLOW_ROW_LOCKS = ON, ALLOW_PAGE_LOCKS = ON, FILLFACTOR = 80) &#xA;&#xA;-- 3. Bucle de inserción por Lotes basado en ID numérico (Evita borrar/volver a hacer JOINs)&#xA;DECLARE @LOTE INT = 1000; -- Incrementado a 50k para mejor rendimiento E/S&#xA;DECLARE @MIN_ID INT = 1;&#xA;DECLARE @MAX_ID_LOTE INT;&#xA;DECLARE @MAX_ID_TOTAL INT = (SELECT ISNULL(MAX(ID_ROWCTT), 0) FROM #CONSULTA_FINAL_UPDATE_MBCORE_CANLAES);&#xA;&#xA;WHILE @MIN_ID &lt;= @MAX_ID_TOTAL&#xA;BEGIN&#xA;    SET @MAX_ID_LOTE = @MIN_ID + @LOTE - 1;&#xA;   UPDATE  MBCORE SET&#xA;    G_CIUDAD_DESTINO = TMP.G_CIUDAD_DESTINO&#xA;   ,G_DEPARTAMENTO_DESTINO = TMP.G_DEPARTAMENTO_DESTINO &#xA;   ,G_REGIONAL_DESTINO = TMP.G_REGIONAL_DESTINO &#xA;   ,CR_ID_APLICA_COMPENSACIONES = TMP.CR_ID_APLICA_COMPENSACIONES&#xA;   ,G_CIUDAD_CANAL_ORIGEN = TMP.G_CIUDAD_CANAL_ORIGEN &#xA;   ,G_DEPARTAMENTO_CANAL_ORIGEN = TMP.G_DEPARTAMENTO_CANAL_ORIGEN &#xA;   ,G_REGIONAL_CANAL_ORIGEN = TMP.G_REGIONAL_CANAL_ORIGEN&#xA;   ,G_CANAL = TMP.G_CANAL&#xA;   FROM #CONSULTA_FINAL_UPDATE_MBCORE_CANLAES TMP&#xA;   INNER JOIN TMP.MBCORE_GUIAS MBCORE WITH(NOLOCK)&#xA;   ON MBCORE.G_NUMERO_GUIA=TMP.G_NUMERO_GUIA&#xA;  WHERE TMP.ID_ROWCTT BETWEEN @MIN_ID AND @MAX_ID_LOTE&#xA; PRINT(CONCAT('INSERTION REALIZADA DESDE - ',@MIN_ID,' / HASTA - ',@MAX_ID_LOTE))&#xA;    SET @MIN_ID = @MAX_ID_LOTE + 1;&#xA;END;&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
      </DTS:Executables>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\CARGA INICIAL OPERADO DE EXTRACCION Y GENERADOR DE FECHAS"
      DTS:CreationName="STOCK:SEQUENCE"
