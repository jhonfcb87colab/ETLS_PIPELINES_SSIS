                      SQLTask:SqlStatementSource="WITH CTE_CANT_CONFIRM&#xA;(&#xA;&#x9; G_NUMERO_GUIA&#xA;&#x9;,CNF_CANT_CONF&#xA;)&#xA;AS&#xA;(&#xA;SELECT&#xA;&#x9; TMP.G_NUMERO_GUIA&#xA;&#x9;,COUNT (TMP09.G_NUMERO_GUIA) CNF_CANT_CONF&#xA;FROM &#xA;&#x9;TMP.MBCORE_GUIAS TMP WITH(NOLOCK)&#xA;INNER JOIN &#xA;&#x9;TMP.MBCORE_GUIAS_09 TMP09 WITH(NOLOCK)&#xA;ON&#xA;&#x9;TMP.G_NUMERO_GUIA = TMP09.G_NUMERO_GUIA&#xA;GROUP BY TMP.G_NUMERO_GUIA&#xA;)&#xA;UPDATE &#xA;&#x9;TMP            -----TMP.MBCORE_GUIAS&#xA;SET &#xA;&#x9; CNF_ID_CONFIRMACION = 'SI'&#xA;&#x9;,CNF_CANT_CONFIRMACION = CTE.CNF_CANT_CONF&#xA;FROM &#xA;&#x9; TMP.MBCORE_GUIAS TMP&#xA;&#x9;INNER JOIN CTE_CANT_CONFIRM CTE&#xA;ON&#xA;&#x9;TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA&#xA;GO&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
