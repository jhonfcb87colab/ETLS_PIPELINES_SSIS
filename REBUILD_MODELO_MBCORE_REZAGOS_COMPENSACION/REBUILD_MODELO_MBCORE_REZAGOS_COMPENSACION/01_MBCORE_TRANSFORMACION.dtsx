                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT 
	 PQR.[NUMERO_GUIA]
	,PQR.ID_INDEMNIZAR_PQR /*[ID_ESTADO_PQR]*/  MPE_ID_ESTADO_PQR
	,CASE WHEN PQR.ID_INDEMNIZAR_PQR /*[ID_ESTADO_PQR]*/ = 0 THEN 'PENDIENTE' ELSE 'CERRADO' END AS MPE_ESTADO_PQR
FROM 
	tmp_borrar_local.[DBO].[BI_MBCORE_GUIAS_BASE] MBCORE WITH(NOLOCK)
INNER JOIN Mece_Logistico.PQR.PQR PQR WITH(NOLOCK)
ON MBCORE.NUMERO_GUIA=PQR.NUMERO_GUIA


/*
SELECT 
	 [NUMERO_GUIA]
	,[ID_ESTADO_PQR]  MPE_ID_ESTADO_PQR
	,CASE WHEN [ID_ESTADO_PQR] = 0 THEN 'PENDIENTE' ELSE 'CERRADO' END AS MPE_ESTADO_PQR
FROM 
	/**/ SIG_COL_LOGISTICA_DW.[FAC].[PQR_MOVIMIENTO_POR_ESTADO] WITH(NOLOCK)
WHERE 
[NUMERO_GUIA] IN (SELECT G_NUMERO_GUIA FROM TMP.MBCORE_GUIAS WITH (NOLOCK))
*/</property>
