  <DTS:Executables>
    <DTS:Executable
      DTS:refId="Package\Actualiza procesos Concepto Tipo trayecto"
      DTS:CreationName="STOCK:SEQUENCE"
      DTS:Description="Sequence Container"
      DTS:DTSID="{A5A93834-D6DB-41DD-868C-0C12EC7EE344}"
      DTS:ExecutableType="STOCK:SEQUENCE"
      DTS:LocaleID="-1"
      DTS:ObjectName="Actualiza procesos Concepto Tipo trayecto">
      <DTS:Variables />
      <DTS:Executables>
        <DTS:Executable
          DTS:refId="Package\Actualiza procesos Concepto Tipo trayecto\OPTIMIZADO ZONA - ULT MOV - CONCEPTO"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{A8F8A86A-DF1E-47D9-B3F5-2EB801C78314}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="OPTIMIZADO ZONA - ULT MOV - CONCEPTO"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="&#xA;DROP TABLE IF EXISTS #CIUDAD_REGIONAL_DEPARTAMENTO&#xA;SELECT &#xA;CD.ID_CIUDAD,&#xA;CD.NOMBRE_CIUDAD,&#xA;RG.ID_REGIONAL,&#xA;RG.NOMBRE_REGIONAL,&#xA;DP.ID_DEPARTAMENTO,&#xA;DP.NOMBRE_DEPARTAMENTO&#xA;INTO #CIUDAD_REGIONAL_DEPARTAMENTO&#xA;FROM PAR.CIUDADES CD WITH(NOLOCK)&#xA;INNER JOIN PAR.REGIONALES_PAIS RG WITH(NOLOCK)&#xA;ON CD.ID_REGIONAL= RG.ID_REGIONAL AND RG.ID_PAIS=1&#xA;INNER JOIN PAR.DEPARTAMENTOS DP WITH(NOLOCK)&#xA;ON CD.ID_DEPARTAMENTO = DP.ID_DEPARTAMENTO&#xA;WHERE CD.ID_PAIS=1&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;DROP TABLE IF EXISTS #CTE_PROCESOS &#xA;;WITH CTE AS(&#xA;SELECT &#xA;ROWID = ROW_NUMBER() OVER(PARTITION BY SEG.NUMERO_GUIA ORDER BY SEG.FECHA_HORA_MOVIMIENTO DESC)&#xA;,SEG.NUMERO_GUIA &#xA;,SEG.FECHA_HORA_MOVIMIENTO&#xA;,SEG.ID_PROCESO&#xA;,SEG.ID_CONCEPTO&#xA;,DOC.ID_TIPO_ZONA_URBA&#xA;,DOC.ID_CIUDAD_ZONA_URBA&#xA;,DOC.ID_ZONA_URBA&#xA;,DOC.ID_CIUDAD_DIVISION_ORIGEN&#xA;,DOC.ID_CIUDAD_DESTINO&#xA;,DOC_ID_CIUDAD_ULTI_MOVI = CASE WHEN ISNULL(DOC.ID_CIUDAD_ZONA_URBA,0) &lt;&gt; 0 THEN DOC.ID_CIUDAD_ZONA_URBA&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;ELSE ISNULL(DOC.ID_CIUDAD_DESTINO,DOC.ID_CIUDAD_DIVISION_ORIGEN)&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;END&#xA;,DOC.ID_DIVISION_ORIGEN&#xA;,DOC.ID_DIVISION_DESTINO&#xA;,G_ID_BODEGA_ULTM_MOVI  = CASE WHEN SEG.ID_PROCESO IN(7,9,12) THEN DOC.ID_DIVISION_ORIGEN ELSE ISNULL(DOC.ID_DIVISION_DESTINO,DOC.ID_DIVISION_ORIGEN) END&#xA;FROM TMP.MBCORE_SEGUIMIENTO_ENVIO SEG WITH(NOLOCK)&#xA;INNER JOIN TMP.MBCORE_DOCUMENTOS DOC WITH(NOLOCK)&#xA;ON SEG.ID_PROCESO=DOC.ID_PROCESO AND SEG.NUMERO_MOVIMI=DOC.NUMERO_MOVIMI AND SEG.CONSECUT_MOVIMI=DOC.CONSECUT_MOVIMI&#xA;)SELECT &#xA;ROW_NUMBER() OVER (ORDER BY CT.FECHA_HORA_MOVIMIENTO) AS CONSECUTIVO&#xA;,NUMERO_GUIA &#xA;,SE_ID_PROC_ULTI_MOVI = ISNULL(CONVERT(INT,CT.ID_PROCESO),-888)&#xA;,SE_ID_CONC_ULTI_MOVI = ISNULL(CONVERT(INT,CT.ID_CONCEPTO),-888)&#xA;,DOC_ID_CIUDAD_ULTI_MOVI= CT.DOC_ID_CIUDAD_ULTI_MOVI&#xA;,DOC_CIUDAD_ULTI_MOVI = CDRGDP.NOMBRE_CIUDAD&#xA;,DOC_DEPT_ULTI_MOVI = CDRGDP.NOMBRE_DEPARTAMENTO&#xA;,DOC_REGIONAL_ULTI_MOVI = CDRGDP.NOMBRE_REGIONAL&#xA;,DOC_ID_ZONA = ZU.ID_TIPO_ZONA_URBA&#xA;,DOC_ZONA = ZU.NOMBRE_ZONA_URBA&#xA;,DOC_ID_TIPO_ZONA_URBA = CT.ID_TIPO_ZONA_URBA&#xA;,DOC_ID_DIVISION_ORIGEN = CT.ID_DIVISION_ORIGEN&#xA;,DOC_ID_DIVISION_DESTINO = CT.ID_DIVISION_DESTINO&#xA;,G_ID_BODEGA_ULTM_MOVI  = CT.G_ID_BODEGA_ULTM_MOVI&#xA;,G_BODEGA_ULTM_MOVI&#x9;&#x9;= ISNULL(DV.NOMBRE_DIVISION,'NO DISPONIBLE')&#xA;,CR_BODEGA_UBICACION&#x9;= ISNULL(DV.NOMBRE_DIVISION,'NO DISPONIBLE')&#xA;INTO #CTE_PROCESOS &#xA;FROM CTE CT&#xA;LEFT JOIN PAR.ZONASURBANAS ZU WITH(NOLOCK)&#xA;ON  CT.ID_TIPO_ZONA_URBA    = ZU.ID_TIPO_ZONA_URBA &#xA;AND CT.ID_CIUDAD_ZONA_URBA  = ZU.ID_CIUDAD&#xA;AND CT.ID_ZONA_URBA&#x9;&#x9;&#x9;= ZU.ID_ZONA_URBA&#xA;AND 1 = ZU.ID_PAIS&#xA;LEFT JOIN #CIUDAD_REGIONAL_DEPARTAMENTO CDRGDP WITH(NOLOCK)&#xA;ON CDRGDP.ID_CIUDAD = CT.DOC_ID_CIUDAD_ULTI_MOVI&#xA;LEFT JOIN PAR.DIVISIONES DV WITH(NOLOCK) ON DV.ID_CIUDAD=CT.DOC_ID_CIUDAD_ULTI_MOVI AND CT.G_ID_BODEGA_ULTM_MOVI=DV.ID_DIVISION AND DV.ID_PAIS=1&#xA;WHERE ROWID = 1&#xA;&#xA;&#xA;&#xA;CREATE NONCLUSTERED INDEX [IX_NUMERO_GUIA] ON #CTE_PROCESOS([NUMERO_GUIA] ASC)&#xA;WITH (PAD_INDEX = OFF, STATISTICS_NORECOMPUTE = OFF, SORT_IN_TEMPDB = OFF, DROP_EXISTING = OFF, ONLINE = OFF, &#xA;ALLOW_ROW_LOCKS = ON, ALLOW_PAGE_LOCKS = ON, FILLFACTOR = 80) &#xA;&#xA;&#xA;-- 3. Bucle de inserción por Lotes basado en ID numérico (Evita borrar/volver a hacer JOINs)&#xA;DECLARE @LOTE INT = 1000; -- Incrementado a 50k para mejor rendimiento E/S&#xA;DECLARE @MIN_ID INT = 1;&#xA;DECLARE @MAX_ID_LOTE INT;&#xA;DECLARE @MAX_ID_TOTAL INT = (SELECT ISNULL(MAX(CONSECUTIVO), 0) FROM #CTE_PROCESOS);&#xA;&#xA;WHILE @MIN_ID &lt;= @MAX_ID_TOTAL&#xA;BEGIN&#xA;    SET @MAX_ID_LOTE = @MIN_ID + @LOTE - 1;&#xA;&#x9;UPDATE TMPMBCORE SET&#xA;&#x9;&#x9;DOC_ID_CIUDAD_ULTI_MOVI = CT.DOC_ID_CIUDAD_ULTI_MOVI&#xA;&#x9;&#x9;,DOC_CIUDAD_ULTI_MOVI = CT.DOC_CIUDAD_ULTI_MOVI&#xA;&#x9;&#x9;,DOC_DEPT_ULTI_MOVI = CT.DOC_DEPT_ULTI_MOVI&#xA;&#x9;&#x9;,DOC_REGIONAL_ULTI_MOVI = CT.DOC_REGIONAL_ULTI_MOVI&#xA;&#x9;&#x9;,DOC_ID_ZONA = CT.DOC_ID_ZONA&#xA;&#x9;&#x9;,DOC_ZONA = CT.DOC_ZONA&#xA;&#x9;&#x9;,DOC_ID_TIPO_ZONA_URBA = CT.DOC_ID_TIPO_ZONA_URBA&#xA;&#x9;&#x9;,SE_ID_PROC_ULTI_MOVI = CT.SE_ID_PROC_ULTI_MOVI &#xA;&#x9;&#x9;,SE_ID_CONC_ULTI_MOVI = CT.SE_ID_CONC_ULTI_MOVI &#xA;&#x9;&#x9;,G_ID_BODEGA_ULTM_MOVI  = CT.G_ID_BODEGA_ULTM_MOVI&#xA;&#x9;&#x9;,G_BODEGA_ULTM_MOVI&#x9;&#x9;= CT.G_BODEGA_ULTM_MOVI&#x9;&#xA;&#x9;&#x9;,CR_BODEGA_UBICACION&#x9;= CT.CR_BODEGA_UBICACION&#xA;&#x9;&#x9;,G_ID_CIUDAD_UBICACION = CT.DOC_ID_CIUDAD_ULTI_MOVI&#xA;&#x9;&#x9;,TC_PROCESO = CT.SE_ID_PROC_ULTI_MOVI&#xA;&#x9;&#x9;,[CR_REGIONAL_UBICACION] = CT.DOC_REGIONAL_ULTI_MOVI&#xA;&#x9;&#x9;FROM [TMP].[MBCORE_GUIAS] TMPMBCORE WITH(INDEX(IX_NUMERO_GUIA_MBCORE))&#xA;&#x9;&#x9;INNER JOIN #CTE_PROCESOS CT WITH(INDEX([IX_NUMERO_GUIA])) ON CT.NUMERO_GUIA= TMPMBCORE.G_NUMERO_GUIA&#xA;&#x9;&#x9;WHERE CT.CONSECUTIVO BETWEEN @MIN_ID AND @MAX_ID_LOTE&#xA;&#x9;PRINT(CONCAT('INSERTION REALIZADA DESDE - ',@MIN_ID,' / HASTA - ',@MAX_ID_LOTE))&#xA;    SET @MIN_ID = @MAX_ID_LOTE + 1;&#xA;END;&#xA;&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Actualiza procesos Concepto Tipo trayecto\PASO 10 ACTUALIZAR BASE CON PROCESOS LOGISTICOS"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{4D57B616-4487-47FE-9588-85610650E82B}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="PASO 10 ACTUALIZAR BASE CON PROCESOS LOGISTICOS"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="WITH CTE&#xA;(&#xA;&#x9; G_NUMERO_GUIA&#xA;&#x9;,SE_ID_FECHA_EZU&#xA;&#x9;,SE_FECHA_EZU&#xA;&#x9;,SE_ID_FECHA_ULTI_MOVI&#xA;&#x9;,SE_FECHA_ULTI_MOVI&#xA;&#x9;,SE_CANT_SZU&#xA;&#x9;,SE_ID_FECHA_SZU&#xA;&#x9;,SE_FECHA_SZU&#xA;&#x9;,SE_ID_CONC_SZU&#xA;&#x9;,SE_ID_DZU&#xA;&#x9;,SE_ID_ULTI&#xA;)&#xA;AS&#xA;(&#xA;SELECT &#xA;&#x9; NUMERO_GUIA G_NUMERO_GUIA&#xA;&#x9;,ISNULL(MIN(CASE WHEN ID_PROCESO IN (5,6) THEN FECHA_HORA_MOVIMIENTO ELSE NULL END  ),'1900-01-01' ) SE_ID_FECHA_EZU&#xA;&#x9;,ISNULL(CONVERT(VARCHAR, MIN(CASE WHEN ID_PROCESO IN (5,6) THEN FECHA_HORA_MOVIMIENTO ELSE NULL END  ),21),'NO DISPONIBLE' ) SE_FECHA_EZU&#xA;&#x9;,ISNULL(MAX(FECHA_HORA_MOVIMIENTO),'1900-01-01') SE_ID_FECHA_ULTI_MOVI&#xA;&#x9;,ISNULL(CONVERT(VARCHAR,MAX(FECHA_HORA_MOVIMIENTO),21),'NO DISPONIBLE') SE_FECHA_ULTI_MOVI&#xA;&#x9;,ISNULL(COUNT(CASE WHEN ID_PROCESO = 9 THEN ID_PROCESO ELSE NULL END),0) SE_CANT_SZU&#xA;&#x9;,ISNULL(MAX(CASE WHEN ID_PROCESO = 9 THEN FECHA_HORA_MOVIMIENTO ELSE NULL END  ),'1900-01-01' ) SE_ID_FECHA_SZU&#xA;&#x9;,ISNULL(CONVERT(VARCHAR, MAX(CASE WHEN ID_PROCESO = 9 THEN FECHA_HORA_MOVIMIENTO ELSE NULL END  ),21),'NO DISPONIBLE' ) SE_FECHA_SZU&#xA;&#x9;,ISNULL(MAX(CASE WHEN ID_PROCESO = 9 THEN CONVERT(INT,ID_CONCEPTO) ELSE NULL END  ),-888 ) SE_ID_CONC_SZU&#x9; &#xA;&#x9;,ISNULL(COUNT(CASE WHEN ID_PROCESO = 10 THEN ID_PROCESO ELSE NULL END),0) SE_ID_DZU&#xA;&#x9;---,ISNULL(MAX(ID),-888) SE_ID_ULTI&#xA;&#x9;,0 AS SE_ID_ULTI/**/&#xA;FROM &#xA;&#x9;[TMP].[MBCORE_SEGUIMIENTO_ENVIO] WITH(NOLOCK)&#xA;GROUP BY &#xA;&#x9; NUMERO_GUIA&#xA;)&#xA;UPDATE &#xA;&#x9;[TMP].[MBCORE_GUIAS]&#xA;SET&#xA;&#x9; SE_ID_FECHA_EZU   = CTE.SE_ID_FECHA_EZU&#xA;&#x9;,SE_FECHA_EZU = CTE.SE_FECHA_EZU&#xA;&#x9;,SE_ID_FECHA_ULTI_MOVI   = CTE.SE_ID_FECHA_ULTI_MOVI&#xA;&#x9;,SE_FECHA_ULTI_MOVI = CTE.SE_FECHA_ULTI_MOVI&#xA;&#x9;,SE_CANT_SZU   = CTE.SE_CANT_SZU&#xA;&#x9;,SE_ID_FECHA_SZU = CTE.SE_ID_FECHA_SZU&#xA;&#x9;,SE_FECHA_SZU = CTE.SE_FECHA_SZU&#xA;&#x9;,SE_ID_CONC_SZU = CTE.SE_ID_CONC_SZU&#xA;&#x9;,SE_ID_CANT_DZU = CTE.SE_ID_DZU&#xA;&#x9;,SE_ID_ULTI = CTE.SE_ID_ULTI&#xA;FROM&#xA;&#x9;[TMP].[MBCORE_GUIAS] TMP WITH (NOLOCK), CTE&#xA;WHERE&#xA;&#x9;TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA&#xA;&#xA;GO&#xA;&#xA;&#x9;UPDATE &#xA;&#x9;&#x9;TMP.MBCORE_GUIAS&#xA;&#x9;SET&#xA;&#x9;SE_ID_SZU = CASE WHEN SE_CANT_SZU &gt; 0 THEN 'SI' ELSE SE_ID_SZU END" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Actualiza procesos Concepto Tipo trayecto\PASO 17 ACTUALIZAR TIPO TRAYECTO"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{12296900-243E-4745-87D9-81D8365853DD}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="PASO 17 ACTUALIZAR TIPO TRAYECTO"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="WITH CTE_TIPO_TRAYECTO&#xA;(&#xA;&#x9; G_NUMERO_GUIA&#xA;&#x9;,G_ID_TIPO_TRAYECTO&#xA;&#x9;,G_TIPO_TRAYECTO&#xA;)&#xA;AS&#xA;(&#xA;SELECT&#xA;     TMP.G_NUMERO_GUIA&#xA;&#x9; ,CONVERT(VARCHAR(50),CONVERT(NVARCHAR(10), ID_CIUDAD_ORIGEN) + '-' + CONVERT(NVARCHAR(10), ID_CIUDAD_DESTINO)) G_ID_TIPO_TRAYECTO&#xA;     ,TT.NOMBRE_TIPOTRAY AS G_TIPO_TRAYECTO&#xA;FROM&#xA;    TMP.MBCORE_GUIAS TMP WITH (NOLOCK)&#xA;INNER JOIN &#xA;&#x9;SIG_COLOMBIA_DW.PAR.RED_OPERATIVA_CONSOLIDADA_TRAYECTOS RO WITH(NOLOCK)&#xA;ON &#xA;&#x9;TMP.G_ID_CIUDAD_ORIGEN = RO.ID_CIUDAD_ORIGEN&#xA;AND&#xA;&#x9;TMP.G_ID_CIUDAD_DESTINO = RO.ID_CIUDAD_DESTINO&#xA;INNER JOIN&#xA;    SIG_COLOMBIA_DW.PAR.TIPOTRAYECTO TT WITH(NOLOCK)&#xA;ON&#xA;    RO.ID_TIPOTRAY = TT.ID_TIPOTRAY&#xA;WHERE&#xA;    ID_PAIS_ORIGEN = 1&#xA;AND&#xA;    ID_PAIS_DESTINO = 1&#xA;)&#xA;UPDATE&#xA;&#x9;TMP.MBCORE_GUIAS &#xA;SET &#xA;&#x9; G_ID_TIPO_TRAYECTO = CTE.G_ID_TIPO_TRAYECTO&#xA;&#x9;,G_TIPO_TRAYECTO= CTE.G_TIPO_TRAYECTO&#xA;FROM &#xA;&#x9;TMP.MBCORE_GUIAS TMP WITH (NOLOCK)&#xA;&#x9;INNER JOIN CTE_TIPO_TRAYECTO CTE&#xA;ON &#xA;&#x9;TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
      </DTS:Executables>
      <DTS:PrecedenceConstraints>
        <DTS:PrecedenceConstraint
          DTS:refId="Package\Actualiza procesos Concepto Tipo trayecto.PrecedenceConstraints[Constraint 1]"
