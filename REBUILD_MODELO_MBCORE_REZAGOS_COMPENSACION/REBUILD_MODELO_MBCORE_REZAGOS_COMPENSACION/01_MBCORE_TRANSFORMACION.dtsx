            <DTS:Executable
              DTS:refId="Package\CARGA INICIAL OPERADO DE EXTRACCION Y GENERADOR DE FECHAS\PROCESO DIGITALIZACION\PASO 14 ACTUALIZAR DIGITALIZADA"
              DTS:CreationName="Microsoft.ExecuteSQLTask"
              DTS:Description="Execute SQL Task"
              DTS:DTSID="{5C38C93B-4DA8-4412-8E17-28472210A4B9}"
              DTS:ExecutableType="Microsoft.ExecuteSQLTask"
              DTS:LocaleID="-1"
              DTS:ObjectName="PASO 14 ACTUALIZAR DIGITALIZADA"
              DTS:ThreadHint="1">
              <DTS:Variables />
              <DTS:LoggingOptions
                DTS:FilterKind="0" />
              <DTS:ObjectData>
                <SQLTask:SqlTaskData
                  SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
                  SQLTask:SqlStatementSource="Drop Table if exists #CTE_PROCESOS&#xA;SELECT&#xA;ROW_NUMBER() OVER (ORDER BY TMP.SE_FECHA_ULTI_MOVI) AS CONSECUTIVO&#xA;,TMP.G_NUMERO_GUIA &#xA;,TMP.SE_FECHA_ULTI_MOVI&#xA;,TMP.CR_ID_APLICA_COMPENSACIONES &#xA;into #CTE_PROCESOS&#xA;FROM TMP.MBCORE_GUIAS TMP WITH(NOLOCK)&#xA;&#xA;CREATE NONCLUSTERED INDEX [IX_NUMERO_GUIA] ON #CTE_PROCESOS([G_NUMERO_GUIA] ASC)&#xA;WITH (PAD_INDEX = OFF, STATISTICS_NORECOMPUTE = OFF, SORT_IN_TEMPDB = OFF, DROP_EXISTING = OFF, ONLINE = OFF, &#xA;ALLOW_ROW_LOCKS = ON, ALLOW_PAGE_LOCKS = ON, FILLFACTOR = 80) &#xA;&#xA;-- 3. Bucle de inserción por Lotes basado en ID numérico (Evita borrar/volver a hacer JOINs)&#xA;DECLARE @LOTE INT = 1000; -- Incrementado a 50k para mejor rendimiento E/S&#xA;DECLARE @MIN_ID INT = 1;&#xA;DECLARE @MAX_ID_LOTE INT;&#xA;DECLARE @MAX_ID_TOTAL INT = (SELECT ISNULL(MAX(CONSECUTIVO), 0) FROM #CTE_PROCESOS);&#xA;&#xA;WHILE @MIN_ID &lt;= @MAX_ID_TOTAL&#xA;BEGIN&#xA;    SET @MAX_ID_LOTE = @MIN_ID + @LOTE - 1;&#xA;&#x9;&#x9;;WITH CTE AS (&#xA;&#x9;&#x9;&#x9;SELECT&#xA;&#x9;&#x9;&#x9;&#x9; TMP.G_NUMERO_GUIA&#xA;&#x9;&#x9;&#x9;&#x9;,SE_ID_DIGI&#xA;&#x9;&#x9;&#x9;&#x9;,SE_ID_FECHA_DIG&#xA;&#x9;&#x9;&#x9;&#x9;,SE_FECHA_DIG&#xA;&#x9;&#x9;&#x9;FROM&#xA;&#x9;&#x9;&#x9;&#x9;#CTE_PROCESOS TMP WITH(NOLOCK)&#xA;&#x9;&#x9;&#x9;INNER JOIN&#xA;&#x9;&#x9;&#x9;&#x9;SIG_COLOMBIA_DW.TMP.MBCORE_PRUEBAS_ENTREGA PE WITH(NOLOCK)&#xA;&#x9;&#x9;&#x9;ON&#xA;&#x9;&#x9;&#x9;&#x9;TMP.G_NUMERO_GUIA = PE.G_NUMERO_GUIA&#xA;&#x9;&#x9;&#x9;WHERE TMP.CONSECUTIVO BETWEEN @MIN_ID AND @MAX_ID_LOTE&#xA;&#x9;&#x9;)&#xA;&#x9;&#x9;UPDATE &#xA;&#x9;&#x9;&#x9;TMP.MBCORE_GUIAS&#xA;&#x9;&#x9;SET&#xA;&#x9;&#x9;&#x9; SE_ID_DIGI = CTE.SE_ID_DIGI&#xA;&#x9;&#x9;&#x9;,SE_ID_FECHA_DIGI&#x9;= CTE.SE_ID_FECHA_DIG&#xA;&#x9;&#x9;&#x9;,SE_FECHA_DIGI&#x9;= CTE.SE_FECHA_DIG&#xA;&#x9;&#x9;FROM&#xA;&#x9;&#x9;&#x9;TMP.MBCORE_GUIAS TMP WITH (NOLOCK) &#xA;&#x9;&#x9; INNER JOIN CTE &#xA;&#x9;&#x9;ON TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA&#xA;&#x9;PRINT(CONCAT('INSERTION REALIZADA DESDE - ',@MIN_ID,' / HASTA - ',@MAX_ID_LOTE))&#xA;    SET @MIN_ID = @MAX_ID_LOTE + 1;&#xA;END;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
              </DTS:ObjectData>
            </DTS:Executable>
          </DTS:Executables>
