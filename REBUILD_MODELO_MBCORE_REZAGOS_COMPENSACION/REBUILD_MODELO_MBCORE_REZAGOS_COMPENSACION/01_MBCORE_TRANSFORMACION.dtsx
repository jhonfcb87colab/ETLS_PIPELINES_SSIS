              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="WITH CTE_TIPO_COBRO&#xA;(&#xA;&#x9; G_NUMERO_GUIA&#xA;&#x9;,GR_ID_TIPO_COBRO&#xA;&#x9;&#xA;)&#xA;AS&#xA;&#x9;(&#xA;&#x9;&#x9;SELECT &#xA;&#x9;&#x9;&#x9; TMP.G_NUMERO_GUIA&#xA;&#x9;&#x9;&#x9;,GR.GR_ID_TIPO_COBRO&#xA;&#x9;&#x9;&#x9;&#xA;&#x9;&#x9;FROM &#xA;&#x9;&#x9;&#x9; [TMP].[MBCORE_GUIAS] TMP WITH (NOLOCK)&#xA;&#x9;&#x9;INNER JOIN &#xA;&#x9;&#x9;&#x9;[TMP].[MBCORE_GUIAS_03_GR] GR WITH (NOLOCK)&#xA;&#x9;&#x9;ON &#xA;&#x9;&#x9;&#x9;TMP.G_NUMERO_GUIA = GR.GR_NUMERO_GUIA&#xA;&#x9;)&#xA;UPDATE &#xA;&#x9; TMP&#xA;SET &#xA;&#x9; GR_TIPO_COBRO = CTE.GR_ID_TIPO_COBRO&#xA;&#x9;&#xA;FROM &#xA;&#x9;[TMP].[MBCORE_GUIAS] TMP WITH (NOLOCK)&#xA;&#x9;INNER JOIN CTE_TIPO_COBRO CTE&#xA;ON &#xA;&#x9;TMP.G_NUMERO_GUIA = CTE.G_NUMERO_GUIA" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
