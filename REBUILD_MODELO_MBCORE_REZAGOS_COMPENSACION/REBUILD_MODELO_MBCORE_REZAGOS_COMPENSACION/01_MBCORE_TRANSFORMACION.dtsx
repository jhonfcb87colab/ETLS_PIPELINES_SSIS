--,[G_ID_REMITE]
--FROM CTE_GUIAS_NO_MBCORE WHERE ID=1
</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{92A1727A-C936-42A2-8DE9-0424AD4CEBE8}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot;&#xA;DECLARE @DATE_INI DATETIME = CONVERT(DATETIME, CONVERT(DATE,CONVERT(DATETIME,'&quot;+@[User::STR_FechaIni] +&quot;'))); &#xA;DECLARE @DATE_FIN DATETIME = CONVERT(DATETIME, CONVERT(DATE,CONVERT(DATETIME,'&quot;+@[User::STR_FechaFin] +&quot;'))); &#xA;&#xA;--DECLARE @DATE_INI DATETIME = CONVERT(DATETIME, CONVERT(DATE,CONVERT(DATETIME,'2026-10-12'))); &#xA;--DECLARE @DATE_FIN DATETIME = CONVERT(DATETIME, CONVERT(DATE,CONVERT(DATETIME,'2026-10-14'))); &#xA;&#xA;DROP TABLE IF EXISTS #MBCORE_SEGUIMIENTO_ENVIO&#xA;DROP TABLE IF EXISTS #MBCORE_SEGUIMIENTO_ENVIO_F&#xA;DROP TABLE IF EXISTS #MBCORE_DOCUMENTOS&#xA;&#xA;&#xA;DROP TABLE IF EXISTS #MBCORE_DOCUMENTOS_01&#xA;SELECT &#xA;*&#xA;INTO #MBCORE_DOCUMENTOS_01&#xA;FROM Mece_Logistico.DBO.DOCUMENTOS DOC WITH (NOLOCK)&#xA;WHERE &#x9;(DOC.FECHA_HORA_MOVIMI&#x9;BETWEEN @DATE_INI AND @DATE_FIN )  &#xA;OPTION(RECOMPILE)&#xA;&#xA;INSERT INTO #MBCORE_DOCUMENTOS_01&#xA;SELECT *&#xA;FROM Mece_Logistico.DBO.DOCUMENTOS DOC WITH (NOLOCK)&#xA;WHERE &#x9;DOC.FECHA_MODIFICACION&#x9;&gt; DATEADD(DAY,1,@DATE_FIN )  &#xA;AND DOC.FECHA_MODIFICACION&#x9;&lt; DATEADD(DAY,0,@DATE_FIN )&#xA;OPTION(RECOMPILE)&#xA;&#xA;DELETE  #MBCORE_DOCUMENTOS_01 WHERE ID_DIVISION_ORIGEN NOT IN(9241,9239,9240,9209,9238) AND ID_DIVISION_DESTINO NOT IN(9241,9239,9240,9209,9238)&#xA;&#xA;&#xA;;WITH CTE_SE AS (&#xA;SELECT &#xA;ROWID = ROW_NUMBER() OVER(PARTITION BY NUMERO_MOVIMI,CONSECUT_MOVIMI,ID_PROCESO ORDER BY FECHA_HORA_MOVIMI DESC)&#xA;,*&#xA;FROM #MBCORE_DOCUMENTOS_01&#xA;)DELETE CTE_SE WHERE ROWID &gt; 1&#xA;&#xA;---SELECT COUNT(1) FROM #MBCORE_DOCUMENTOS_01&#xA;&#xA;DROP  TABLE IF EXISTS #MBCORE_DOCUMENTOS&#xA;SELECT &#xA;ROW_NUMBER() OVER (ORDER BY FECHA_HORA_MOVIMI) AS CONSECUTIVO,*&#xA;INTO #MBCORE_DOCUMENTOS &#xA;FROM  #MBCORE_DOCUMENTOS_01 DOC WITH(NOLOCK)&#xA;&#xA;&#xA;ALTER TABLE #MBCORE_DOCUMENTOS ADD  CONSTRAINT [IDX_MANIFIESTOS] UNIQUE NONCLUSTERED &#xA;(&#xA;ID_PROCESO&#x9;ASC&#xA;,NUMERO_MOVIMI&#x9;ASC&#xA;,CONSECUT_MOVIMI ASC)&#xA;WITH (PAD_INDEX = OFF, STATISTICS_NORECOMPUTE = OFF, SORT_IN_TEMPDB = OFF, IGNORE_DUP_KEY = OFF, ONLINE = OFF, ALLOW_ROW_LOCKS = ON, ALLOW_PAGE_LOCKS = ON, FILLFACTOR = 80) ON [PRIMARY]&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;DROP TABLE IF EXISTS #MBCORE_SEGUIMIENTO_ENVIO_01&#xA;SELECT &#xA;SEG.* &#xA;INTO #MBCORE_SEGUIMIENTO_ENVIO_01&#xA;FROM #MBCORE_DOCUMENTOS DOC WITH(NOLOCK INDEX=[IDX_MANIFIESTOS])&#xA;INNER JOIN Mece_Logistico..SEGUIMIENTO_ENVIO SEG WITH(NOLOCK)&#xA;ON &#x9;DOC.NUMERO_MOVIMI&#x9;=  SEG.NUMERO_MOVIMI&#xA;AND DOC.CONSECUT_MOVIMI&#x9;=  SEG.CONSECUT_MOVIMI&#xA;AND DOC.ID_PROCESO&#x9;&#x9;=  SEG.ID_PROCESO&#xA;WHERE DOC.CONSECUTIVO BETWEEN 0 AND 0&#xA;OPTION(RECOMPILE)&#xA;&#xA;&#xA;-- 3. Bucle de inserción por Lotes basado en ID numérico (Evita borrar/volver a hacer JOINs)&#xA;DECLARE @LOTE INT = 1000; -- Incrementado a 50k para mejor rendimiento E/S&#xA;DECLARE @MIN_ID INT = 1;&#xA;DECLARE @MAX_ID_LOTE INT;&#xA;DECLARE @MAX_ID_TOTAL INT = (SELECT ISNULL(MAX(CONSECUTIVO), 0) FROM #MBCORE_DOCUMENTOS);&#xA;&#xA;WHILE @MIN_ID &lt;= @MAX_ID_TOTAL&#xA;BEGIN&#xA;    SET @MAX_ID_LOTE = @MIN_ID + @LOTE - 1;&#xA;&#x9;&#x9;INSERT INTO #MBCORE_SEGUIMIENTO_ENVIO_01&#xA;&#x9;&#x9;SELECT &#xA;&#x9;&#x9;SEG.* &#xA;&#x9;&#x9;FROM #MBCORE_DOCUMENTOS DOC WITH(NOLOCK INDEX=[IDX_MANIFIESTOS])&#xA;&#x9;&#x9;INNER JOIN Mece_Logistico..SEGUIMIENTO_ENVIO SEG WITH(NOLOCK)&#xA;&#x9;&#x9;ON &#x9;DOC.NUMERO_MOVIMI&#x9;=  SEG.NUMERO_MOVIMI&#xA;&#x9;&#x9;AND DOC.CONSECUT_MOVIMI&#x9;=  SEG.CONSECUT_MOVIMI&#xA;&#x9;&#x9;AND DOC.ID_PROCESO&#x9;&#x9;=  SEG.ID_PROCESO&#xA;&#x9;&#x9;WHERE DOC.CONSECUTIVO BETWEEN @MIN_ID AND @MAX_ID_LOTE&#xA;&#x9;&#x9;OPTION(RECOMPILE)&#xA;&#x9;PRINT(CONCAT('INSERTCION REALIZADA DESDE - ',@MIN_ID,' / HASTA - ',@MAX_ID_LOTE))&#xA;    SET @MIN_ID = @MAX_ID_LOTE + 1;&#xA;END;&#xA;&#xA;DROP TABLE IF EXISTS #MBCORE_DOCUMENTOS&#xA;DROP TABLE IF EXISTS #MBCORE_DOCUMENTOS_01&#xA;&#xA;&#xA;DELETE  #MBCORE_SEGUIMIENTO_ENVIO_01 WHERE LEN(NUMERO_GUIA)&lt;8&#xA;DELETE #MBCORE_SEGUIMIENTO_ENVIO_01 WHERE ID_PROCESO &lt; 5&#xA;&#xA;&#xA;&#xA;DROP TABLE IF EXISTS #MBCORE_SEGUIMIENTO_ENVIO_02&#xA;SELECT&#xA;*&#xA;INTO #MBCORE_SEGUIMIENTO_ENVIO_02&#xA;FROM #MBCORE_SEGUIMIENTO_ENVIO_01&#xA;&#xA;DROP TABLE IF EXISTS #MBCORE_SEGUIMIENTO_ENVIO_01&#xA;&#xA;;WITH CTE AS(&#xA;SELECT &#xA;ROW_ID = ROW_NUMBER() OVER (PARTITION BY NUMERO_GUIA ORDER BY FECHA_HORA_MOVIMIENTO DESC),&#xA;* FROM #MBCORE_SEGUIMIENTO_ENVIO_02&#xA;)DELETE CTE WHERE ROW_ID &gt; 1&#xA;&#xA;DROP TABLE IF EXISTS #MBCORE_SEGUIMIENTO_ENVIO_03&#xA;SELECT  &#xA;ROW_NUMBER() OVER (ORDER BY FECHA_HORA_MOVIMIENTO) AS CONSECUTIVO,*&#xA;INTO #MBCORE_SEGUIMIENTO_ENVIO_03&#xA;FROM #MBCORE_SEGUIMIENTO_ENVIO_02&#xA;&#xA;DROP TABLE IF EXISTS #MBCORE_SEGUIMIENTO_ENVIO_02&#xA;&#xA;&#xA;&#xA;CREATE NONCLUSTERED INDEX [IX_NUMERO_GUIA_MBCORE01] ON #MBCORE_SEGUIMIENTO_ENVIO_03([NUMERO_GUIA] ASC)&#xA;WITH (PAD_INDEX = OFF, STATISTICS_NORECOMPUTE = OFF, SORT_IN_TEMPDB = OFF, &#xA;DROP_EXISTING = OFF, ONLINE = OFF, ALLOW_ROW_LOCKS = ON, ALLOW_PAGE_LOCKS = ON, FILLFACTOR = 80) &#xA;&#xA;&#xA;DROP TABLE IF EXISTS #MBCORE_GUIAS_01&#xA;SELECT TOP 0&#xA;&#x9; GUI.[NUMERO_GUIA]&#xA;&#x9;,GUI.[NUMERO_PIEZAS]&#xA;&#x9;,GUI.[FECHA_ENVIO]&#xA;&#x9;,GUI.[ID_TIEMPO]&#xA;&#x9;,GUI.[ID_PRODUCTO]&#xA;&#x9;,GUI.[DIRECCION_DESTINA_GUIA]&#xA;&#x9;,GUI.[ID_CLIENTE]&#xA;&#x9;,GUI.[ID_CIUDAD_ORIGEN]&#xA;&#x9;,GUI.[ID_CIUDAD_DESTINO]&#xA;&#x9;,GUI.[ID_PAIS_UBICACION]&#xA;&#x9;,GUI.[ID_CIUDAD_UBICACION]&#xA;&#x9;,GUI.[ID_DIVISION_UBICACION]&#xA;&#x9;,GUI.[VALOR_DECLARADO_GUIA]&#xA;&#x9;,[FECHA_EXTRACCION_DW] = GETDATE()&#xA;&#x9;,[CR_ID_APLICA_COMPENSACIONES] = 1&#xA;&#x9;,[G_NOMBRE_REMITENTE]=CONCAT(GUI.NOMBRE_REMITE_GUIA,GUI.APELLIDO_REMITE_GUIA)&#xA;&#x9;,[G_TELEFONO_REMITE_GUIA] = GUI.TELEFONO_REMITE_GUIA&#xA;&#x9;,[G_ID_REMITE]=GUI.[ID_REMITE]&#xA;&#x9;,GUI.ID_ESTADOGUIA&#xA;&#x9;,GUI.ID_ESTADOENVIO&#xA;,SEG.ID_PROCESO&#xA;,SEG.CONSECUT_MOVIMI&#xA;,SEG.NUMERO_MOVIMI&#xA;,SEG.FECHA_HORA_MOVIMIENTO&#xA;&#x9;INTO #MBCORE_GUIAS_01&#xA;FROM Mece_Logistico.DBO.GUIAS GUI WITH(NOLOCK INDEX=[UK_GUIA])&#xA;INNER JOIN  #MBCORE_SEGUIMIENTO_ENVIO_03 SEG WITH(NOLOCK INDEX=[IX_NUMERO_GUIA_MBCORE01])&#xA;ON GUI.NUMERO_GUIA=SEG.NUMERO_GUIA&#xA;OPTION(RECOMPILE)&#xA;&#xA;&#xA;-- 3. Bucle de inserción por Lotes basado en ID numérico (Evita borrar/volver a hacer JOINs)&#xA;DECLARE @2LOTE INT = 1000; -- Incrementado a 50k para mejor rendimiento E/S&#xA;DECLARE @2MIN_ID INT = 1;&#xA;DECLARE @2MAX_ID_LOTE INT;&#xA;DECLARE @2MAX_ID_TOTAL INT = (SELECT ISNULL(MAX(CONSECUTIVO), 0) FROM #MBCORE_SEGUIMIENTO_ENVIO_03);&#xA;&#xA;WHILE @2MIN_ID &lt;= @2MAX_ID_TOTAL&#xA;BEGIN&#xA;    SET @2MAX_ID_LOTE = @2MIN_ID + @2LOTE - 1;&#xA;&#xA;&#x9;&#x9;INSERT INTO #MBCORE_GUIAS_01&#xA;&#x9;&#x9;&#x9;SELECT &#xA;&#x9;&#x9;&#x9;&#x9; GUI.[NUMERO_GUIA]&#xA;&#x9;&#x9;&#x9;&#x9;,GUI.[NUMERO_PIEZAS]&#xA;&#x9;&#x9;&#x9;&#x9;,GUI.[FECHA_ENVIO]&#xA;&#x9;&#x9;&#x9;&#x9;,GUI.[ID_TIEMPO]&#xA;&#x9;&#x9;&#x9;&#x9;,GUI.[ID_PRODUCTO]&#xA;&#x9;&#x9;&#x9;&#x9;,GUI.[DIRECCION_DESTINA_GUIA]&#xA;&#x9;&#x9;&#x9;&#x9;,GUI.[ID_CLIENTE]&#xA;&#x9;&#x9;&#x9;&#x9;,GUI.[ID_CIUDAD_ORIGEN]&#xA;&#x9;&#x9;&#x9;&#x9;,GUI.[ID_CIUDAD_DESTINO]&#xA;&#x9;&#x9;&#x9;&#x9;,GUI.[ID_PAIS_UBICACION]&#xA;&#x9;&#x9;&#x9;&#x9;,GUI.[ID_CIUDAD_UBICACION]&#xA;&#x9;&#x9;&#x9;&#x9;,GUI.[ID_DIVISION_UBICACION]&#xA;&#x9;&#x9;&#x9;&#x9;,GUI.[VALOR_DECLARADO_GUIA]&#xA;&#x9;&#x9;&#x9;&#x9;,[FECHA_EXTRACCION_DW] = GETDATE()&#xA;&#x9;&#x9;&#x9;&#x9;,[CR_ID_APLICA_COMPENSACIONES] = 1&#xA;&#x9;&#x9;&#x9;&#x9;,[G_NOMBRE_REMITENTE]=CONCAT(GUI.NOMBRE_REMITE_GUIA,GUI.APELLIDO_REMITE_GUIA)&#xA;&#x9;&#x9;&#x9;&#x9;,[G_TELEFONO_REMITE_GUIA] = GUI.TELEFONO_REMITE_GUIA&#xA;&#x9;&#x9;&#x9;&#x9;,[G_ID_REMITE]=GUI.[ID_REMITE]&#xA;&#x9;&#x9;&#x9;&#x9;,GUI.ID_ESTADOGUIA&#xA;&#x9;&#x9;&#x9;&#x9;,GUI.ID_ESTADOENVIO&#xA;&#x9;&#x9;&#x9;,SEG.ID_PROCESO&#xA;&#x9;&#x9;&#x9;,SEG.CONSECUT_MOVIMI&#xA;&#x9;&#x9;&#x9;,SEG.NUMERO_MOVIMI&#xA;&#x9;&#x9;&#x9;,SEG.FECHA_HORA_MOVIMIENTO&#xA;&#x9;&#x9;&#x9;FROM Mece_Logistico.DBO.GUIAS GUI WITH(NOLOCK INDEX=[UK_GUIA])&#xA;&#x9;&#x9;&#x9;INNER JOIN  #MBCORE_SEGUIMIENTO_ENVIO_03 SEG WITH(NOLOCK INDEX=[IX_NUMERO_GUIA_MBCORE01])&#xA;&#x9;&#x9;&#x9;ON GUI.NUMERO_GUIA=SEG.NUMERO_GUIA&#xA;&#x9;&#x9;&#x9;WHERE SEG.CONSECUTIVO BETWEEN @2MIN_ID AND @2MAX_ID_LOTE&#xA;&#x9;&#x9;&#x9;----WHERE PS01.ID BETWEEN 1 AND 1000&#xA;&#x9;&#x9;&#x9;OPTION(RECOMPILE);&#xA;&#x9;PRINT(CONCAT('INSERTCION REALIZADA DESDE - ',@2MIN_ID,' / HASTA - ',@2MAX_ID_LOTE))&#xA;    SET @2MIN_ID = @2MAX_ID_LOTE + 1;&#xA;END;&#xA;&#xA;DELETE #MBCORE_GUIAS_01 WHERE LEN(NUMERO_GUIA)&lt;8&#xA;DELETE #MBCORE_GUIAS_01 WHERE ID_ESTADOGUIA &lt; 3&#xA;&#xA;TRUNCATE TABLE [tmp_borrar_local].[DBO].[BI_MBCORE_GUIAS_BASE_REZAGOS]&#xA;&#xA;INSERT INTO [tmp_borrar_local].[DBO].[BI_MBCORE_GUIAS_BASE_REZAGOS]&#xA;SELECT * &#xA;------INTO [tmp_borrar_local].[DBO].[BI_MBCORE_GUIAS_BASE_REZAGOS]&#xA;FROM #MBCORE_GUIAS_01&#xA;&#xA;DROP TABLE IF EXISTS #MBCORE_GUIAS_01&#xA;&#xA;&#xA;&#xA;&#xA;&quot;"
