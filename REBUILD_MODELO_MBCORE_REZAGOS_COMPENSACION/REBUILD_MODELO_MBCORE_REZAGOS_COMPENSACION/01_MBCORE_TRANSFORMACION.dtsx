    <DTS:Executable
      DTS:refId="Package\PASO 04 OBTENER PROCESOS Y RECAUDO"
      DTS:CreationName="STOCK:SEQUENCE"
      DTS:Description="Sequence Container"
      DTS:DTSID="{AD90173F-8211-4CB2-B9DD-940E61FBE734}"
      DTS:ExecutableType="STOCK:SEQUENCE"
      DTS:LocaleID="-1"
      DTS:ObjectName="PASO 04 OBTENER PROCESOS Y RECAUDO">
      <DTS:Variables />
      <DTS:LoggingOptions
        DTS:FilterKind="0" />
      <DTS:Executables>
        <DTS:Executable
          DTS:refId="Package\PASO 04 OBTENER PROCESOS Y RECAUDO\PASO 04 01 MBCORE_GUIAS_03_GR"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{05C2EC20-CDC3-423A-A7C7-45AC5D5D242A}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="PASO 04 01 MBCORE_GUIAS_03_GR"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="WITH CTE&#xA;(GR_NUMERO_GUIA&#xA;,ID_TIPO_COBRO&#xA;)AS(&#xA;SELECT &#xA;&#x9; GR.NUMERO_GUIA AS GR_NUMERO_GUIA&#xA;&#x9;,CASE WHEN GR.ID_TIPO_COBRO = 2 THEN 'LPC' ELSE 'COD' END ID_TIPO_COBRO&#xA;FROM &#xA;&#x9;/*         */    SIG_COLOMBIA_DW.[LOG].[GUIA_RECAUDO] GR WITH (NOLOCK)&#xA;INNER JOIN&#xA;&#x9;TMP.MBCORE_GUIAS TMP WITH (NOLOCK)&#xA;on &#xA;GR.NUMERO_GUIA = TMP.G_NUMERO_GUIA&#xA;&#xA;)&#xA;INSERT INTO&#xA;&#x9;TMP.MBCORE_GUIAS_03_GR&#xA;(&#xA;&#x9; [GR_NUMERO_GUIA],&#xA;     [GR_ID_TIPO_COBRO]&#xA;&#xA;)&#xA;SELECT &#xA;&#x9; GR_NUMERO_GUIA&#xA;    ,ID_TIPO_COBRO&#xA;FROM &#xA;CTE&#x9;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\PASO 04 OBTENER PROCESOS Y RECAUDO\PASO 04 02 MBCORE_GUIAS_04_GRINFR"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{8BA77132-F3D5-44A2-BC5A-6781D714BCD3}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="PASO 04 02 MBCORE_GUIAS_04_GRINFR"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="WITH CTE &#xA;(&#xA;&#x9; IR_NUMERO_GUIA&#xA;&#x9;,IR_NUMERO_ORDEN_SERVICIO&#xA;&#x9;,IR_VALOR_X_RECAUDAR&#xA;)&#xA;&#x9;AS&#xA;&#x9;&#x9;( &#xA;&#x9;&#x9;&#x9;SELECT&#xA;&#x9;&#x9;&#x9;&#x9; IR.NUMERO_GUIA IR_NUMERO_GUIA&#xA;&#x9;&#x9;&#x9;&#x9;,ISNULL(CASE WHEN IR.NUMERO_ORDEN_SERVICIO = '' THEN NULL ELSE IR.NUMERO_ORDEN_SERVICIO END,'NO DISPONIBLE') IR_NUMERO_ORDEN_SERVICIO&#xA;&#x9;&#x9;&#x9;&#x9;,ISNULL(IR.VALOR_PRODUCTO,0) IR_VALOR_X_RECAUDAR&#xA;&#x9;&#x9;&#x9;FROM&#xA;&#x9;&#x9;&#x9;&#x9;LOG.GUIA_RECAUDO_INFORMACION_RECAUDO IR WITH(NOLOCK)&#xA;&#x9;&#x9;&#x9;INNER JOIN&#xA;&#x9;&#x9;&#x9;&#x9;TMP.MBCORE_GUIAS MA WITH(NOLOCK)&#xA;&#x9;&#x9;&#x9;ON&#xA;&#x9;&#x9;&#x9;&#x9;IR.NUMERO_GUIA = MA.G_NUMERO_GUIA&#xA;&#x9;&#x9;)&#xA;&#xA;INSERT INTO&#xA;&#x9;TMP.MBCORE_GUIAS_04_GRINFR&#xA;(&#xA;&#x9; IR_NUMERO_GUIA&#xA;&#x9;,IR_NUMERO_ORDEN_SERVICIO&#xA;&#x9;,IR_VALOR_X_RECAUDAR&#xA;&#xA;)&#xA;SELECT &#xA;&#x9; IR_NUMERO_GUIA&#xA;&#x9;,IR_NUMERO_ORDEN_SERVICIO&#xA;&#x9;,IR_VALOR_X_RECAUDAR&#xA;FROM &#xA;&#x9;CTE&#x9;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\PASO 04 OBTENER PROCESOS Y RECAUDO\PASO 04 03 MBCORE_GUIAS_05_INFTBCL"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{D1C10BBF-C94D-40BF-9E3B-143F41A5D3D7}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="PASO 04 03 MBCORE_GUIAS_05_INFTBCL"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:LoggingOptions
            DTS:FilterKind="0" />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="WITH CTE &#xA;(&#xA;&#x9; TC_NUMERO_GUIA&#xA;&#x9;,TC_ID_PROCESO&#xA;)&#xA;&#x9;AS&#xA;&#x9;&#x9;(&#xA;&#x9;&#x9;&#x9;SELECT&#xA;&#x9;&#x9;&#x9;&#x9; TC.NUMERO_GUIA TC_NUMERO_GUIA&#xA;&#x9;&#x9;&#x9;&#x9;,ISNULL(TC.ID_PROCESO,-888) TC_ID_PROCESO&#xA;&#x9;&#x9;&#x9;FROM&#xA;&#x9;&#x9;&#x9;&#x9;LOG.GUIA_INFORMACION_ADICIONAL_TABLERO_CONTROL TC WITH(NOLOCK)&#xA;&#x9;&#x9;&#x9;INNER JOIN&#xA;&#x9;&#x9;&#x9;&#x9;TMP.MBCORE_GUIAS MA  WITH(NOLOCK)&#xA;&#x9;&#x9;&#x9;ON&#xA;&#x9;&#x9;&#x9;&#x9;TC.NUMERO_GUIA = MA.G_NUMERO_GUIA&#xA;&#x9;&#x9;)&#xA;INSERT INTO&#xA;&#x9;TMP.MBCORE_GUIAS_05_INFTBCL&#xA;(&#xA;&#x9; TC_NUMERO_GUIA&#xA;&#x9;,TC_ID_PROCESO&#xA;&#xA;)&#xA;SELECT &#xA;&#x9; TC_NUMERO_GUIA&#xA;&#x9;,TC_ID_PROCESO&#xA;FROM &#xA;&#x9;CTE&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
      </DTS:Executables>
      <DTS:PrecedenceConstraints>
        <DTS:PrecedenceConstraint
          DTS:refId="Package\PASO 04 OBTENER PROCESOS Y RECAUDO.PrecedenceConstraints[Constraint 3]"
          DTS:CreationName=""
          DTS:DTSID="{C5A08065-3082-49CF-B298-68CB1E5243A8}"
          DTS:From="Package\PASO 04 OBTENER PROCESOS Y RECAUDO\PASO 04 03 MBCORE_GUIAS_05_INFTBCL"
          DTS:LogicalAnd="True"
          DTS:ObjectName="Constraint 3"
          DTS:To="Package\PASO 04 OBTENER PROCESOS Y RECAUDO\PASO 04 02 MBCORE_GUIAS_04_GRINFR" />
        <DTS:PrecedenceConstraint
          DTS:refId="Package\PASO 04 OBTENER PROCESOS Y RECAUDO.PrecedenceConstraints[Constraint 4]"
          DTS:CreationName=""
          DTS:DTSID="{C95222B8-3CE3-439E-A476-282F20D05CC9}"
          DTS:From="Package\PASO 04 OBTENER PROCESOS Y RECAUDO\PASO 04 02 MBCORE_GUIAS_04_GRINFR"
          DTS:LogicalAnd="True"
          DTS:ObjectName="Constraint 4"
          DTS:To="Package\PASO 04 OBTENER PROCESOS Y RECAUDO\PASO 04 01 MBCORE_GUIAS_03_GR" />
      </DTS:PrecedenceConstraints>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\PASO 09 ACTUALIZAR CANAL"
      DTS:CreationName="STOCK:SEQUENCE"
      DTS:Description="Sequence Container"
      DTS:DTSID="{EB897F80-B335-4543-B7CB-853A417D27EE}"
      DTS:ExecutableType="STOCK:SEQUENCE"
      DTS:LocaleID="-1"
      DTS:ObjectName="PASO 09 ACTUALIZAR CANAL">
      <DTS:Variables />
      <DTS:LoggingOptions
        DTS:FilterKind="0" />
      <DTS:Executables>
        <DTS:Executable
          DTS:refId="Package\PASO 09 ACTUALIZAR CANAL\ACTUALIZACION CAMPOS FALTANTES"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{10EFB07E-3FCD-410D-94D1-640EED15C178}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="ACTUALIZACION CAMPOS FALTANTES"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="/*==========================================================================================&#xA;  ACTUALIZAR GEOGRAFIA DESTINO, CANAL ORIGEN, COMPENSACIONES Y CANAL EN TMP.MBCORE_GUIAS&#xA;  ------------------------------------------------------------------------------------------&#xA;  Version optimizada de Script_07.sql (mismo resultado), enfocada en reducir ESCRITURA.&#xA;&#xA;  Problemas del original:&#xA;  1. #UBICACIONES_Y_BODEGAS se calculaba sobre TODO MBCORE_SEGUIMIENTO_ENVIO (~3,8 M filas),&#xA;     no solo las guias de MBCORE_GUIAS, y guardaba 13 columnas (la mayoria no se usan).&#xA;  2. El indice de #UBICACIONES_Y_BODEGAS se creaba ANTES del INSERT (TOP 0 + INSERT), con&#xA;     FILLFACTOR 80: cada fila insertada mantenia el indice (mas escritura en tempdb).&#xA;  3. El bucle de 1.000 filas hacia ~440 UPDATE; TMP.MBCORE_GUIAS es HEAP sin indice por&#xA;     G_NUMERO_GUIA, por lo que CADA lote recorria la tabla completa (~440 x 437 mil filas).&#xA;  4. Se reescribian TODAS las guias aunque el valor no cambiara (escritura y log inutiles).&#xA;  5. Si una guia tenia varias filas en MBCORE_MECE_LOGISTICO_GUIAS se actualizaba varias&#xA;     veces (filas duplicadas en la consulta final).&#xA;&#xA;  Optimizaciones:&#xA;  - Se filtra el seguimiento por las guias a procesar y solo se guardan las columnas usadas.&#xA;  - Temporales creadas con SELECT INTO (escritura minima en tempdb) y luego indexadas.&#xA;  - Una fila por guia (la de FECHA_ENVIO mas reciente, que era la que quedaba al final&#xA;    en el original porque los lotes iban en orden de FECHA_ENVIO).&#xA;  - Solo se actualizan las guias cuyo valor CAMBIA (comparacion NULL-safe con EXCEPT).&#xA;  - Lotes por rango de ID sobre una temporal ordenada por guia + indice en la tabla destino:&#xA;    cada lote hace Index Seek en vez de Table Scan, con transacciones cortas (log pequeno).&#xA;==========================================================================================*/&#xA;SET NOCOUNT ON;&#xA;SET XACT_ABORT ON;&#xA;&#xA;--DECLARE @LOTE INT = 25000;   -- Filas por lote. Bajar (10000) si el log/disco sigue saturado.&#xA;&#xA;DROP TABLE IF EXISTS #GEOGRAFIA;&#xA;DROP TABLE IF EXISTS #GUIAS;&#xA;DROP TABLE IF EXISTS #UBICACIONES_Y_BODEGAS;&#xA;DROP TABLE IF EXISTS #CAMBIOS;&#xA;&#xA;----------------------------------------------------------------------------------------------&#xA;-- 1. GEOGRAFIA (Colombia)&#xA;----------------------------------------------------------------------------------------------&#xA;SELECT&#xA;&#x9; CD.ID_CIUDAD&#xA;&#x9;,CD.NOMBRE_CIUDAD&#xA;&#x9;,RG.NOMBRE_REGIONAL&#xA;&#x9;,DP.NOMBRE_DEPARTAMENTO&#xA;INTO #GEOGRAFIA&#xA;FROM PAR.CIUDADES CD WITH (NOLOCK)&#xA;INNER JOIN PAR.REGIONALES_PAIS RG WITH (NOLOCK)&#xA;&#x9;ON RG.ID_REGIONAL = CD.ID_REGIONAL&#xA;INNER JOIN PAR.DEPARTAMENTOS DP WITH (NOLOCK)&#xA;&#x9;ON DP.ID_DEPARTAMENTO = CD.ID_DEPARTAMENTO&#xA;WHERE CD.ID_PAIS = 1&#xA;  AND DP.ID_PAIS = 1;&#xA;&#xA;CREATE CLUSTERED INDEX IX_GEOGRAFIA ON #GEOGRAFIA (ID_CIUDAD);&#xA;&#xA;----------------------------------------------------------------------------------------------&#xA;-- 2. GUIAS A PROCESAR&#xA;----------------------------------------------------------------------------------------------&#xA;SELECT DISTINCT G_NUMERO_GUIA AS NUMERO_GUIA&#xA;INTO #GUIAS&#xA;FROM TMP.MBCORE_GUIAS WITH (NOLOCK)&#xA;WHERE G_NUMERO_GUIA IS NOT NULL;&#xA;&#xA;CREATE UNIQUE CLUSTERED INDEX IX_GUIAS ON #GUIAS (NUMERO_GUIA);&#xA;&#xA;----------------------------------------------------------------------------------------------&#xA;-- 3. ULTIMO MOVIMIENTO POR GUIA + CIUDAD CANAL ORIGEN (solo columnas que se usan)&#xA;----------------------------------------------------------------------------------------------&#xA;SELECT&#xA;&#x9; U.NUMERO_GUIA&#xA;&#x9;,U.ID_DIVISION_ORIGEN&#xA;&#x9;,U.ID_DIVISION_DESTINO&#xA;&#x9;,GEO.NOMBRE_CIUDAD        AS G_CIUDAD_CANAL_ORIGEN&#xA;&#x9;,GEO.NOMBRE_DEPARTAMENTO  AS G_DEPARTAMENTO_CANAL_ORIGEN&#xA;&#x9;,GEO.NOMBRE_REGIONAL      AS G_REGIONAL_CANAL_ORIGEN&#xA;INTO #UBICACIONES_Y_BODEGAS&#xA;FROM (&#xA;&#x9;SELECT&#xA;&#x9;&#x9; ROWID = ROW_NUMBER() OVER (PARTITION BY SEG.NUMERO_GUIA ORDER BY SEG.FECHA_HORA_MOVIMIENTO DESC)&#xA;&#x9;&#x9;,SEG.NUMERO_GUIA&#xA;&#x9;&#x9;,DOC.ID_DIVISION_ORIGEN&#xA;&#x9;&#x9;,DOC.ID_DIVISION_DESTINO&#xA;&#x9;&#x9;-- Misma regla del original, simplificada (primer valor distinto de NULL/0)&#xA;&#x9;&#x9;,G_ID_CIUDAD_CANAL_ORIGEN = CASE&#xA;&#x9;&#x9;&#x9;&#x9;WHEN ISNULL(DOC.ID_CIUDAD_CANAL, 0)           &lt;&gt; 0 THEN DOC.ID_CIUDAD_CANAL&#xA;&#x9;&#x9;&#x9;&#x9;WHEN ISNULL(DOC.ID_CIUDAD_DIVISION_ORIGEN, 0) &lt;&gt; 0 THEN DOC.ID_CIUDAD_DIVISION_ORIGEN&#xA;&#x9;&#x9;&#x9;&#x9;WHEN ISNULL(DOC.ID_CIUDAD_ZONA_URBA, 0)       &lt;&gt; 0 THEN DOC.ID_CIUDAD_ZONA_URBA&#xA;&#x9;&#x9;&#x9;&#x9;ELSE DOC.ID_DIVISION_DESTINO&#xA;&#x9;&#x9;&#x9;END&#xA;&#x9;FROM TMP.MBCORE_SEGUIMIENTO_ENVIO SEG WITH (NOLOCK)&#xA;&#x9;INNER JOIN TMP.MBCORE_DOCUMENTOS DOC WITH (NOLOCK)&#xA;&#x9;&#x9;ON  SEG.ID_PROCESO      = DOC.ID_PROCESO&#xA;&#x9;&#x9;AND SEG.NUMERO_MOVIMI   = DOC.NUMERO_MOVIMI&#xA;&#x9;&#x9;AND SEG.CONSECUT_MOVIMI = DOC.CONSECUT_MOVIMI&#xA;&#x9;WHERE EXISTS (SELECT 1 FROM #GUIAS G WHERE G.NUMERO_GUIA = SEG.NUMERO_GUIA)&#xA;) U&#xA;INNER JOIN #GEOGRAFIA GEO&#xA;&#x9;ON GEO.ID_CIUDAD = U.G_ID_CIUDAD_CANAL_ORIGEN&#xA;WHERE U.ROWID = 1;&#xA;&#xA;CREATE CLUSTERED INDEX IX_UBICACIONES ON #UBICACIONES_Y_BODEGAS (NUMERO_GUIA);&#xA;&#xA;----------------------------------------------------------------------------------------------&#xA;-- 4. VALORES FINALES: una fila por guia y SOLO las guias cuyo valor cambia&#xA;----------------------------------------------------------------------------------------------&#xA;SELECT&#xA;&#x9; ID_ROWCTT = ROW_NUMBER() OVER (ORDER BY S.G_NUMERO_GUIA)&#xA;&#x9;,S.*&#xA;INTO #CAMBIOS&#xA;FROM (&#xA;&#x9;SELECT&#xA;&#x9;&#x9; GUI.NUMERO_GUIA                 AS G_NUMERO_GUIA&#xA;&#x9;&#x9;,GEO.NOMBRE_CIUDAD               AS G_CIUDAD_DESTINO&#xA;&#x9;&#x9;,GEO.NOMBRE_DEPARTAMENTO         AS G_DEPARTAMENTO_DESTINO&#xA;&#x9;&#x9;,GEO.NOMBRE_REGIONAL             AS G_REGIONAL_DESTINO&#xA;&#x9;&#x9;,CR_ID_APLICA_COMPENSACIONES = CASE&#xA;&#x9;&#x9;&#x9;&#x9;WHEN UBIC.ID_DIVISION_ORIGEN  IN (/*COMPENSACIONES:*/ 9209,9235,9236,9237,9238,9241,9265,19209,91441,92134,94698, /*REZAGOS:*/ 9239,9240)&#xA;&#x9;&#x9;&#x9;&#x9;  OR UBIC.ID_DIVISION_DESTINO IN (/*COMPENSACIONES:*/ 9209,9235,9236,9237,9238,9241,9265,19209,91441,92134,94698, /*REZAGOS:*/ 9239,9240)&#xA;&#x9;&#x9;&#x9;&#x9;THEN 1 ELSE 0 END&#xA;&#x9;&#x9;,UBIC.G_CIUDAD_CANAL_ORIGEN&#xA;&#x9;&#x9;,UBIC.G_DEPARTAMENTO_CANAL_ORIGEN&#xA;&#x9;&#x9;,UBIC.G_REGIONAL_CANAL_ORIGEN&#xA;&#x9;&#x9;,G_CANAL = CASE&#xA;&#x9;&#x9;&#x9;&#x9;WHEN GUI.ID_CLIENTE IS NULL     AND ISNULL(GUI.ID_CANAL, '0') &lt;&gt; '0' THEN 'RETAIL'&#xA;&#x9;&#x9;&#x9;&#x9;WHEN GUI.ID_CLIENTE IS NOT NULL AND ISNULL(GUI.ID_CANAL, '0')  = '0' THEN 'CORPORATIVO'&#xA;&#x9;&#x9;&#x9;&#x9;ELSE 'OTROS'&#xA;&#x9;&#x9;&#x9;END&#xA;&#x9;FROM (&#xA;&#x9;&#x9;-- Una fila por guia: la de FECHA_ENVIO mas reciente&#xA;&#x9;&#x9;SELECT&#xA;&#x9;&#x9;&#x9; G.NUMERO_GUIA&#xA;&#x9;&#x9;&#x9;,G.ID_CIUDAD_DESTINO&#xA;&#x9;&#x9;&#x9;,G.ID_CLIENTE&#xA;&#x9;&#x9;&#x9;,G.ID_CANAL&#xA;&#x9;&#x9;&#x9;,RN = ROW_NUMBER() OVER (PARTITION BY G.NUMERO_GUIA ORDER BY G.FECHA_ENVIO DESC)&#xA;&#x9;&#x9;FROM TMP.MBCORE_MECE_LOGISTICO_GUIAS G WITH (NOLOCK)&#xA;&#x9;&#x9;INNER JOIN #GEOGRAFIA GEO2&#xA;&#x9;&#x9;&#x9;ON GEO2.ID_CIUDAD = G.ID_CIUDAD_DESTINO&#xA;&#x9;&#x9;WHERE EXISTS (SELECT 1 FROM #GUIAS X WHERE X.NUMERO_GUIA = G.NUMERO_GUIA)&#xA;&#x9;) GUI&#xA;&#x9;INNER JOIN #GEOGRAFIA GEO&#xA;&#x9;&#x9;ON GEO.ID_CIUDAD = GUI.ID_CIUDAD_DESTINO&#xA;&#x9;INNER JOIN #UBICACIONES_Y_BODEGAS UBIC&#xA;&#x9;&#x9;ON UBIC.NUMERO_GUIA = GUI.NUMERO_GUIA&#xA;&#x9;WHERE GUI.RN = 1&#xA;) S&#xA;-- Descarta guias que ya tienen exactamente esos valores (no se escribe nada para ellas)&#xA;WHERE EXISTS (&#xA;&#x9;SELECT 1&#xA;&#x9;FROM TMP.MBCORE_GUIAS T WITH (NOLOCK)&#xA;&#x9;WHERE T.G_NUMERO_GUIA = S.G_NUMERO_GUIA&#xA;&#x9;  AND EXISTS (&#xA;&#x9;&#x9;&#x9;SELECT T.G_CIUDAD_DESTINO, T.G_DEPARTAMENTO_DESTINO, T.G_REGIONAL_DESTINO, T.CR_ID_APLICA_COMPENSACIONES,&#xA;&#x9;&#x9;&#x9;       T.G_CIUDAD_CANAL_ORIGEN, T.G_DEPARTAMENTO_CANAL_ORIGEN, T.G_REGIONAL_CANAL_ORIGEN, T.G_CANAL&#xA;&#x9;&#x9;&#x9;EXCEPT&#xA;&#x9;&#x9;&#x9;SELECT S.G_CIUDAD_DESTINO, S.G_DEPARTAMENTO_DESTINO, S.G_REGIONAL_DESTINO, S.CR_ID_APLICA_COMPENSACIONES,&#xA;&#x9;&#x9;&#x9;       S.G_CIUDAD_CANAL_ORIGEN, S.G_DEPARTAMENTO_CANAL_ORIGEN, S.G_REGIONAL_CANAL_ORIGEN, S.G_CANAL&#xA;&#x9;&#x9;)&#xA;);&#xA;&#xA;CREATE UNIQUE CLUSTERED INDEX IX_CAMBIOS ON #CAMBIOS (ID_ROWCTT);&#xA;&#xA;----------------------------------------------------------------------------------------------&#xA;-- 5. INDICE EN LA TABLA DESTINO (si no existe uno que empiece por G_NUMERO_GUIA)&#xA;--    Permite que cada lote haga Index Seek en lugar de recorrer todo el HEAP.&#xA;--    No se mantiene durante el UPDATE porque G_NUMERO_GUIA no se modifica.&#xA;----------------------------------------------------------------------------------------------&#xA;IF NOT EXISTS (&#xA;&#x9;SELECT 1&#xA;&#x9;FROM sys.indexes I&#xA;&#x9;INNER JOIN sys.index_columns IC ON IC.object_id = I.object_id AND IC.index_id = I.index_id&#xA;&#x9;INNER JOIN sys.columns C        ON C.object_id = IC.object_id AND C.column_id = IC.column_id&#xA;&#x9;WHERE I.object_id = OBJECT_ID('TMP.MBCORE_GUIAS')&#xA;&#x9;  AND IC.key_ordinal = 1&#xA;&#x9;  AND C.name = 'G_NUMERO_GUIA'&#xA;)&#xA;&#x9;CREATE NONCLUSTERED INDEX IX_MBCORE_GUIAS_G_NUMERO_GUIA ON TMP.MBCORE_GUIAS (G_NUMERO_GUIA);&#xA;&#xA;----------------------------------------------------------------------------------------------&#xA;-- 6. UPDATE POR LOTES (transacciones cortas, solo filas que cambian)&#xA;----------------------------------------------------------------------------------------------&#xA;DECLARE @MIN_ID       INT = 1;&#xA;DECLARE @MAX_ID_LOTE  INT;&#xA;DECLARE @MAX_ID_TOTAL INT = (SELECT ISNULL(MAX(ID_ROWCTT), 0) FROM #CAMBIOS);&#xA;DECLARE @FILAS        INT;&#xA;DECLARE @MSG          NVARCHAR(200);&#xA;&#xA;DECLARE @LOTE INT = 25000; &#xA;&#xA;RAISERROR('Guias a actualizar: %d', 0, 1, @MAX_ID_TOTAL) WITH NOWAIT;&#xA;&#xA;WHILE @MIN_ID &lt;= @MAX_ID_TOTAL&#xA;BEGIN&#xA;&#x9;SET @MAX_ID_LOTE = @MIN_ID + @LOTE - 1;&#xA;&#xA;&#x9;UPDATE MBCORE&#xA;&#x9;SET&#xA;&#x9;&#x9; G_CIUDAD_DESTINO            = C.G_CIUDAD_DESTINO&#xA;&#x9;&#x9;,G_DEPARTAMENTO_DESTINO      = C.G_DEPARTAMENTO_DESTINO&#xA;&#x9;&#x9;,G_REGIONAL_DESTINO          = C.G_REGIONAL_DESTINO&#xA;&#x9;&#x9;,CR_ID_APLICA_COMPENSACIONES = C.CR_ID_APLICA_COMPENSACIONES&#xA;&#x9;&#x9;,G_CIUDAD_CANAL_ORIGEN       = C.G_CIUDAD_CANAL_ORIGEN&#xA;&#x9;&#x9;,G_DEPARTAMENTO_CANAL_ORIGEN = C.G_DEPARTAMENTO_CANAL_ORIGEN&#xA;&#x9;&#x9;,G_REGIONAL_CANAL_ORIGEN     = C.G_REGIONAL_CANAL_ORIGEN&#xA;&#x9;&#x9;,G_CANAL                     = C.G_CANAL&#xA;&#x9;FROM #CAMBIOS C&#xA;&#x9;INNER JOIN TMP.MBCORE_GUIAS MBCORE&#xA;&#x9;&#x9;ON MBCORE.G_NUMERO_GUIA = C.G_NUMERO_GUIA&#xA;&#x9;WHERE C.ID_ROWCTT BETWEEN @MIN_ID AND @MAX_ID_LOTE;&#xA;&#xA;&#x9;SET @FILAS = @@ROWCOUNT;&#xA;&#x9;SET @MSG = CONCAT('Lote ', @MIN_ID, ' - ', @MAX_ID_LOTE, ' : ', @FILAS, ' filas actualizadas');&#xA;&#x9;RAISERROR(@MSG, 0, 1) WITH NOWAIT;&#xA;&#xA;&#x9;SET @MIN_ID = @MAX_ID_LOTE + 1;&#xA;END;&#xA;&#xA;DROP TABLE IF EXISTS #GEOGRAFIA;&#xA;DROP TABLE IF EXISTS #GUIAS;&#xA;DROP TABLE IF EXISTS #UBICACIONES_Y_BODEGAS;&#xA;DROP TABLE IF EXISTS #CAMBIOS;&#xA;GO&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\PASO 09 ACTUALIZAR CANAL\ACTUALIZAR CANAL optimizado"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:Disabled="True"
          DTS:DTSID="{19F79872-0D43-497F-9AEF-18A0E6015DE4}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="ACTUALIZAR CANAL optimizado"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
              SQLTask:SqlStatementSource="&#xA;UPDATE &#xA;&#x9;TMP&#xA;SET &#xA;&#x9;G_CANAL = CASE WHEN GUI.ID_CLIENTE IS NULL AND ISNULL(GUI.ID_CANAL,'0')&lt;&gt;'0' THEN 'RETAIL'&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN GUI.ID_CLIENTE IS NOT NULL AND ISNULL(GUI.ID_CANAL,'0')='0' THEN 'CORPORATIVO'&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;ELSE 'OTROS'&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;END&#xA;&#x9;,G_ID_CIUDAD_CANAL_ORIGEN = ISNULL(GUI.ID_CIUDAD_DESTINO,-888)&#xA;&#x9;,G_ID_CIUDAD_CANAL_DESTINO = ISNULL(GUI.ID_CIUDAD_ORIGEN,-888)&#xA;FROM &#xA;&#x9;[TMP].[MBCORE_GUIAS] TMP WITH (INDEX(IX_NUMERO_GUIA_MBCORE))&#xA;&#x9;INNER JOIN [TMP].[MBCORE_MECE_LOGISTICO_GUIAS] GUI  WITH (NOLOCK INDEX=IX_NUMERO_GUIA_MECE_LOGISTICO_GUIAS) &#xA;ON &#xA;TMP.G_NUMERO_GUIA = GUI.NUMERO_GUIA&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
      </DTS:Executables>
      <DTS:PrecedenceConstraints>
        <DTS:PrecedenceConstraint
          DTS:refId="Package\PASO 09 ACTUALIZAR CANAL.PrecedenceConstraints[Constraint]"
          DTS:CreationName=""
          DTS:DTSID="{C4A88A1F-648C-4A04-91B8-530253FD5150}"
          DTS:From="Package\PASO 09 ACTUALIZAR CANAL\ACTUALIZAR CANAL optimizado"
          DTS:LogicalAnd="True"
          DTS:ObjectName="Constraint"
          DTS:To="Package\PASO 09 ACTUALIZAR CANAL\ACTUALIZACION CAMPOS FALTANTES" />
      </DTS:PrecedenceConstraints>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\PASO 29 ACTUALIZAR DESCRIPTIVOS"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{F6B5DC94-88F1-4353-AF69-AE01DD7F85AA}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="PASO 29 ACTUALIZAR DESCRIPTIVOS"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{2CA48163-F9AB-4DF6-8C7B-4DF2B2F9354C}"
          SQLTask:SqlStatementSource="/*==========================================================================================&#xA;  PASO 29 (01 al 15) - ACTUALIZACION DE DESCRIPCIONES EN TMP.MBCORE_GUIAS&#xA;  ------------------------------------------------------------------------------------------&#xA;  Consolida en UN SOLO UPDATE los 16 UPDATE+CTE originales (Script_01.sql) usando CROSS APPLY.&#xA;&#xA;  Notas de diseno:&#xA;  - Cada CROSS APPLY es un agregado sin GROUP BY (COUNT/MAX), por lo que SIEMPRE devuelve&#xA;    exactamente una fila. Asi el CROSS APPLY nunca descarta guias aunque no exista la&#xA;    llave en la tabla parametrica.&#xA;  - EXISTE replica el INNER JOIN original: si no hay coincidencia (EXISTE = 0) la columna&#xA;    conserva su valor actual; si hay coincidencia se aplica ISNULL(...,'NO DISPONIBLE').&#xA;  - Se elimina la auto-union por G_NUMERO_GUIA de las CTE: la busqueda se hace directa&#xA;    por fila, se lee TMP.MBCORE_GUIAS una sola vez y se escribe una sola vez.&#xA;  - Se quita NOLOCK de la tabla destino del UPDATE (no aplica / no permitido en destino).&#xA;==========================================================================================*/&#xA;SET NOCOUNT ON;&#xA;&#xA;UPDATE TMP&#xA;SET&#xA;&#x9;----PASO 29 01 TIEMPO ENTREGA&#xA;&#x9; G_TIEMPO_ENTREGA              = CASE WHEN TE.EXISTE  &gt; 0 THEN ISNULL(TE.NOMBRE , 'NO DISPONIBLE') ELSE TMP.G_TIEMPO_ENTREGA              END&#xA;&#x9;----PASO 29 02 NOMBRE PRODUCTO&#xA;&#x9;,G_PRODUCTO                    = CASE WHEN PR.EXISTE  &gt; 0 THEN ISNULL(PR.NOMBRE , 'NO DISPONIBLE') ELSE TMP.G_PRODUCTO                    END&#xA;&#x9;----PASO 29 03 GEOGRAFIA ULTIMO MOVIMIENTO&#xA;&#x9;,DOC_CIUDAD_ULTI_MOVI          = CASE WHEN GUM.EXISTE &gt; 0 THEN ISNULL(GUM.CIUDAD      , 'NO DISPONIBLE') ELSE TMP.DOC_CIUDAD_ULTI_MOVI   END&#xA;&#x9;,DOC_DEPT_ULTI_MOVI            = CASE WHEN GUM.EXISTE &gt; 0 THEN ISNULL(GUM.DEPARTAMENTO, 'NO DISPONIBLE') ELSE TMP.DOC_DEPT_ULTI_MOVI     END&#xA;&#x9;,DOC_REGIONAL_ULTI_MOVI        = CASE WHEN GUM.EXISTE &gt; 0 THEN ISNULL(GUM.REGIONAL    , 'NO DISPONIBLE') ELSE TMP.DOC_REGIONAL_ULTI_MOVI END&#xA;&#x9;----PASO 29 03 GEOGRAFIA ORIGEN&#xA;&#x9;,G_CIUDAD_ORIGEN               = CASE WHEN GOR.EXISTE &gt; 0 THEN ISNULL(GOR.CIUDAD      , 'NO DISPONIBLE') ELSE TMP.G_CIUDAD_ORIGEN        END&#xA;&#x9;,G_DEPARTAMENTO_ORIGEN         = CASE WHEN GOR.EXISTE &gt; 0 THEN ISNULL(GOR.DEPARTAMENTO, 'NO DISPONIBLE') ELSE TMP.G_DEPARTAMENTO_ORIGEN  END&#xA;&#x9;,G_REGIONAL_ORIGEN             = CASE WHEN GOR.EXISTE &gt; 0 THEN ISNULL(GOR.REGIONAL    , 'NO DISPONIBLE') ELSE TMP.G_REGIONAL_ORIGEN      END&#xA;&#x9;----PASO 29 04 GEOGRAFIA DESTINO&#xA;&#x9;,G_CIUDAD_CANAL_DESTINO        = CASE WHEN GDE.EXISTE &gt; 0 THEN ISNULL(GDE.CIUDAD      , 'NO DISPONIBLE') ELSE TMP.G_CIUDAD_CANAL_DESTINO        END&#xA;&#x9;,G_DEPARTAMENTO_CANAL_DESTINO  = CASE WHEN GDE.EXISTE &gt; 0 THEN ISNULL(GDE.DEPARTAMENTO, 'NO DISPONIBLE') ELSE TMP.G_DEPARTAMENTO_CANAL_DESTINO  END&#xA;&#x9;,G_REGIONAL_CANAL_DESTINO      = CASE WHEN GDE.EXISTE &gt; 0 THEN ISNULL(GDE.REGIONAL    , 'NO DISPONIBLE') ELSE TMP.G_REGIONAL_CANAL_DESTINO      END&#xA;&#x9;----PASO 29 05 NOMBRE CLIENTE&#xA;&#x9;,G_CLIENTE                     = CASE WHEN CL.EXISTE  &gt; 0 THEN ISNULL(CL.NOMBRE , 'NO DISPONIBLE') ELSE TMP.G_CLIENTE                     END&#xA;&#x9;----PASO 29 06 ESTADO ENVIO&#xA;&#x9;,G_ESTADO_ENVIO                = CASE WHEN EE.EXISTE  &gt; 0 THEN ISNULL(EE.NOMBRE , 'NO DISPONIBLE') ELSE TMP.G_ESTADO_ENVIO                END&#xA;&#x9;----PASO 29 07 ULTIMO PROCESO MOV&#xA;&#x9;,SE_PROC_ULTI_MOVI             = CASE WHEN UP.EXISTE  &gt; 0 THEN ISNULL(UP.NOMBRE , 'NO DISPONIBLE') ELSE TMP.SE_PROC_ULTI_MOVI             END&#xA;&#x9;----PASO 29 08 ULTIMO CONCEPTO MOV&#xA;&#x9;,SE_CONC_ULTI_MOVI             = CASE WHEN UC.EXISTE  &gt; 0 THEN ISNULL(UC.NOMBRE , 'NO DISPONIBLE') ELSE TMP.SE_CONC_ULTI_MOVI             END&#xA;&#x9;----PASO 29 09 / 10 / 11 DZU 1, 2, 3&#xA;&#x9;,SE_CONP_DZU_1                 = CASE WHEN D1.EXISTE  &gt; 0 THEN ISNULL(D1.NOMBRE , 'NO DISPONIBLE') ELSE TMP.SE_CONP_DZU_1                 END&#xA;&#x9;,SE_CONP_DZU_2                 = CASE WHEN D2.EXISTE  &gt; 0 THEN ISNULL(D2.NOMBRE , 'NO DISPONIBLE') ELSE TMP.SE_CONP_DZU_2                 END&#xA;&#x9;,SE_CONP_DZU_3                 = CASE WHEN D3.EXISTE  &gt; 0 THEN ISNULL(D3.NOMBRE , 'NO DISPONIBLE') ELSE TMP.SE_CONP_DZU_3                 END&#xA;&#x9;----PASO 29 12 / 13 / 14 SOLUCION 1, 2, 3&#xA;&#x9;,CNF_SOLUCION_1                = CASE WHEN S1.EXISTE  &gt; 0 THEN ISNULL(S1.NOMBRE , 'NO DISPONIBLE') ELSE TMP.CNF_SOLUCION_1                END&#xA;&#x9;,CNF_SOLUCION_2                = CASE WHEN S2.EXISTE  &gt; 0 THEN ISNULL(S2.NOMBRE , 'NO DISPONIBLE') ELSE TMP.CNF_SOLUCION_2                END&#xA;&#x9;,CNF_SOLUCION_3                = CASE WHEN S3.EXISTE  &gt; 0 THEN ISNULL(S3.NOMBRE , 'NO DISPONIBLE') ELSE TMP.CNF_SOLUCION_3                END&#xA;&#x9;----PASO 29 15 CONCEPTO SZU&#xA;&#x9;,SE_CONC_SZU                   = CASE WHEN SZ.EXISTE  &gt; 0 THEN ISNULL(SZ.NOMBRE , 'NO DISPONIBLE') ELSE TMP.SE_CONC_SZU                   END&#xA;&#xA;FROM&#xA;&#x9;TMP.MBCORE_GUIAS TMP&#xA;&#xA;&#x9;----PASO 29 01 TIEMPO ENTREGA&#xA;&#x9;CROSS APPLY (&#xA;&#x9;&#x9;SELECT COUNT(*) AS EXISTE, MAX(TI.NOMBRE_TIEMPO) AS NOMBRE&#xA;&#x9;&#x9;FROM PAR.TIEMPOSENTREGA TI WITH (NOLOCK)&#xA;&#x9;&#x9;WHERE TI.ID_TIEMPO = TMP.G_ID_TIEMPO_ENTREGA&#xA;&#x9;) TE&#xA;&#xA;&#x9;----PASO 29 02 NOMBRE PRODUCTO&#xA;&#x9;CROSS APPLY (&#xA;&#x9;&#x9;SELECT COUNT(*) AS EXISTE, MAX(PRO.NOMBRE_PRODUCTO) AS NOMBRE&#xA;&#x9;&#x9;FROM PAR.PRODUCTOS PRO WITH (NOLOCK)&#xA;&#x9;&#x9;WHERE PRO.ID_PRODUCTO = TMP.G_ID_PRODUCTO&#xA;&#x9;) PR&#xA;&#xA;&#x9;----PASO 29 03 GEOGRAFIA ULTIMO MOVIMIENTO&#xA;&#x9;CROSS APPLY (&#xA;&#x9;&#x9;SELECT COUNT(*) AS EXISTE, MAX(GEO.REGIONAL) AS REGIONAL, MAX(GEO.CIUDAD) AS CIUDAD, MAX(GEO.DEPARTAMENTO) AS DEPARTAMENTO&#xA;&#x9;&#x9;FROM DIM.GEOGRAFIA GEO WITH (NOLOCK)&#xA;&#x9;&#x9;WHERE GEO.ID_CIUDAD = TMP.DOC_ID_CIUDAD_ULTI_MOVI&#xA;&#x9;) GUM&#xA;&#xA;&#x9;----PASO 29 03 GEOGRAFIA ORIGEN&#xA;&#x9;CROSS APPLY (&#xA;&#x9;&#x9;SELECT COUNT(*) AS EXISTE, MAX(GEO.REGIONAL) AS REGIONAL, MAX(GEO.CIUDAD) AS CIUDAD, MAX(GEO.DEPARTAMENTO) AS DEPARTAMENTO&#xA;&#x9;&#x9;FROM DIM.GEOGRAFIA GEO WITH (NOLOCK)&#xA;&#x9;&#x9;WHERE GEO.ID_CIUDAD = TMP.G_ID_CIUDAD_ORIGEN&#xA;&#x9;) GOR&#xA;&#xA;&#x9;----PASO 29 04 GEOGRAFIA DESTINO&#xA;&#x9;CROSS APPLY (&#xA;&#x9;&#x9;SELECT COUNT(*) AS EXISTE, MAX(GEO.REGIONAL) AS REGIONAL, MAX(GEO.CIUDAD) AS CIUDAD, MAX(GEO.DEPARTAMENTO) AS DEPARTAMENTO&#xA;&#x9;&#x9;FROM DIM.GEOGRAFIA GEO WITH (NOLOCK)&#xA;&#x9;&#x9;WHERE GEO.ID_CIUDAD = TMP.G_ID_CIUDAD_CANAL_DESTINO&#xA;&#x9;) GDE&#xA;&#xA;&#x9;----PASO 29 05 NOMBRE CLIENTE (cadena vacia se trata como NULL -&gt; 'NO DISPONIBLE')&#xA;&#x9;CROSS APPLY (&#xA;&#x9;&#x9;SELECT COUNT(*) AS EXISTE, MAX(NULLIF(CLI.RAZON_SOCIAL_CORTA, '')) AS NOMBRE&#xA;&#x9;&#x9;FROM PAR.CLIENTES CLI WITH (NOLOCK)&#xA;&#x9;&#x9;WHERE CLI.ID_CLIENTE = TMP.G_ID_CLIENTE&#xA;&#x9;) CL&#xA;&#xA;&#x9;----PASO 29 06 ESTADO ENVIO&#xA;&#x9;CROSS APPLY (&#xA;&#x9;&#x9;SELECT COUNT(*) AS EXISTE, MAX(EST.NOMBRE_ESTADOENVIO) AS NOMBRE&#xA;&#x9;&#x9;FROM PAR.ESTADOSENVIO EST WITH (NOLOCK)&#xA;&#x9;&#x9;WHERE EST.ID_ESTADOENVIO = TMP.G_ID_ESTADO_ENVIO&#xA;&#x9;) EE&#xA;&#xA;&#x9;----PASO 29 07 ULTIMO PROCESO MOV&#xA;&#x9;CROSS APPLY (&#xA;&#x9;&#x9;SELECT COUNT(*) AS EXISTE, MAX(PRO.NOMBRE_PROCESO_LOG) AS NOMBRE&#xA;&#x9;&#x9;FROM PAR.PROCESOS PRO WITH (NOLOCK)&#xA;&#x9;&#x9;WHERE PRO.ID_PROCESO = TMP.SE_ID_PROC_ULTI_MOVI&#xA;&#x9;) UP&#xA;&#xA;&#x9;----PASO 29 08 ULTIMO CONCEPTO MOV&#xA;&#x9;CROSS APPLY (&#xA;&#x9;&#x9;SELECT COUNT(*) AS EXISTE, MAX(CONC.NOMBRE_CONCEPTO) AS NOMBRE&#xA;&#x9;&#x9;FROM PAR.ITEM_CONCEPTO CONC WITH (NOLOCK)&#xA;&#x9;&#x9;WHERE CONC.ID_PROCESO  = TMP.SE_ID_PROC_ULTI_MOVI&#xA;&#x9;&#x9;  AND CONC.ID_CONCEPTO = TMP.SE_ID_CONC_ULTI_MOVI&#xA;&#x9;) UC&#xA;&#xA;&#x9;----PASO 29 09 DZU 1&#xA;&#x9;CROSS APPLY (&#xA;&#x9;&#x9;SELECT COUNT(*) AS EXISTE, MAX(CONC.NOMBRE_CONCEPTO) AS NOMBRE&#xA;&#x9;&#x9;FROM PAR.ITEM_CONCEPTO CONC WITH (NOLOCK)&#xA;&#x9;&#x9;WHERE CONC.ID_PROCESO  = 10&#xA;&#x9;&#x9;  AND CONC.ID_CONCEPTO = TMP.SE_ID_CONP_DZU_1&#xA;&#x9;) D1&#xA;&#xA;&#x9;----PASO 29 10 DZU 2&#xA;&#x9;CROSS APPLY (&#xA;&#x9;&#x9;SELECT COUNT(*) AS EXISTE, MAX(CONC.NOMBRE_CONCEPTO) AS NOMBRE&#xA;&#x9;&#x9;FROM PAR.ITEM_CONCEPTO CONC WITH (NOLOCK)&#xA;&#x9;&#x9;WHERE CONC.ID_PROCESO  = 10&#xA;&#x9;&#x9;  AND CONC.ID_CONCEPTO = TMP.SE_ID_CONP_DZU_2&#xA;&#x9;) D2&#xA;&#xA;&#x9;----PASO 29 11 DZU 3&#xA;&#x9;CROSS APPLY (&#xA;&#x9;&#x9;SELECT COUNT(*) AS EXISTE, MAX(CONC.NOMBRE_CONCEPTO) AS NOMBRE&#xA;&#x9;&#x9;FROM PAR.ITEM_CONCEPTO CONC WITH (NOLOCK)&#xA;&#x9;&#x9;WHERE CONC.ID_PROCESO  = 10&#xA;&#x9;&#x9;  AND CONC.ID_CONCEPTO = TMP.SE_ID_CONP_DZU_3&#xA;&#x9;) D3&#xA;&#xA;&#x9;----PASO 29 12 SOLUCION 1&#xA;&#x9;CROSS APPLY (&#xA;&#x9;&#x9;SELECT COUNT(*) AS EXISTE, MAX(SOLU.NOMBRE_SOLUCION) AS NOMBRE&#xA;&#x9;&#x9;FROM PAR.SOLUCIONESCONFIRMACIONES SOLU WITH (NOLOCK)&#xA;&#x9;&#x9;WHERE SOLU.ID_SOLUCION = TMP.CNF_ID_SOLUCION_1&#xA;&#x9;) S1&#xA;&#xA;&#x9;----PASO 29 13 SOLUCION 2&#xA;&#x9;CROSS APPLY (&#xA;&#x9;&#x9;SELECT COUNT(*) AS EXISTE, MAX(SOLU.NOMBRE_SOLUCION) AS NOMBRE&#xA;&#x9;&#x9;FROM PAR.SOLUCIONESCONFIRMACIONES SOLU WITH (NOLOCK)&#xA;&#x9;&#x9;WHERE SOLU.ID_SOLUCION = TMP.CNF_ID_SOLUCION_2&#xA;&#x9;) S2&#xA;&#xA;&#x9;----PASO 29 14 SOLUCION 3&#xA;&#x9;CROSS APPLY (&#xA;&#x9;&#x9;SELECT COUNT(*) AS EXISTE, MAX(SOLU.NOMBRE_SOLUCION) AS NOMBRE&#xA;&#x9;&#x9;FROM PAR.SOLUCIONESCONFIRMACIONES SOLU WITH (NOLOCK)&#xA;&#x9;&#x9;WHERE SOLU.ID_SOLUCION = TMP.CNF_ID_SOLUCION_3&#xA;&#x9;) S3&#xA;&#xA;&#x9;----PASO 29 15 CONCEPTO SZU&#xA;&#x9;CROSS APPLY (&#xA;&#x9;&#x9;SELECT COUNT(*) AS EXISTE, MAX(CONC.NOMBRE_CONCEPTO) AS NOMBRE&#xA;&#x9;&#x9;FROM PAR.ITEM_CONCEPTO CONC WITH (NOLOCK)&#xA;&#x9;&#x9;WHERE CONC.ID_PROCESO  = 9&#xA;&#x9;&#x9;  AND CONC.ID_CONCEPTO = TMP.SE_ID_CONC_SZU&#xA;&#x9;) SZ&#xA;&#xA;-- Solo se escriben las guias con al menos una coincidencia (menos escritura en log)&#xA;WHERE&#xA;&#x9;   TE.EXISTE  &gt; 0 OR PR.EXISTE  &gt; 0&#xA;&#x9;OR GUM.EXISTE &gt; 0 OR GOR.EXISTE &gt; 0 OR GDE.EXISTE &gt; 0&#xA;&#x9;OR CL.EXISTE  &gt; 0 OR EE.EXISTE  &gt; 0&#xA;&#x9;OR UP.EXISTE  &gt; 0 OR UC.EXISTE  &gt; 0&#xA;&#x9;OR D1.EXISTE  &gt; 0 OR D2.EXISTE  &gt; 0 OR D3.EXISTE  &gt; 0&#xA;&#x9;OR S1.EXISTE  &gt; 0 OR S2.EXISTE  &gt; 0 OR S3.EXISTE  &gt; 0&#xA;&#x9;OR SZ.EXISTE  &gt; 0;&#xA;GO&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
