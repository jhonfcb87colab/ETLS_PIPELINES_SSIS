                          description="The SQL command to be executed."
                          name="SqlCommand"
                          UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT
TMP.NUMERO_GUIA AS G_NUMERO_GUIA
,'SI' AS SE_ID_DIGI
,ISNULL(PE.FECHA_DIGITALIZACION,'1900-01-01') SE_ID_FECHA_DIG
,ISNULL(CONVERT(VARCHAR,PE.FECHA_DIGITALIZACION,21),'NO DISPONIBLE') SE_FECHA_DIG
,PE.TIPO_PRUEBA_ENTREGA
FROM tmp_borrar_local.DBO.PRUEBAS_ENTREGA_BI PE WITH(NOLOCK)
INNER JOIN tmp_borrar_local.DBO.BI_MBCORE_GUIAS_BASE TMP WITH(NOLOCK)
ON TMP.NUMERO_GUIA=PE.NUMERO_GUIA</property>
