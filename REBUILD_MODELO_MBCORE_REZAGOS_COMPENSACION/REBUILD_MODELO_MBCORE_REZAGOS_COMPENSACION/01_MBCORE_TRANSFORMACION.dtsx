                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT
     G.NUMERO_GUIA
	,T.ID_EST_TAREA AS TAR_ID_ESTADO_TAREA
    ,CASE WHEN T.ID_EST_TAREA = 1 THEN 'ABIERTA' ELSE 'CERRADA' END TAR_ESTADO_TAREA
FROM
    [tmp_borrar_local].[dbo].[BI_MBCORE_GUIAS_BASE] G WITH(NOLOCK)
INNER JOIN
    Mece_Logistico.DBO.TAREAS T WITH(NOLOCK)
ON
    CONVERT(CHAR(20),G.NUMERO_GUIA) = T.NUMERO_DOCPROBLEMA</property>
